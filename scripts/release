#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/release — land-to-prod in one command: cut at main SHA S, wait for CI, deploy.

`/go` lands its change to main (`scripts/ship --quick`), then runs this. It
freezes S (default: origin/main) as a release branch, waits for GitHub CI on
exactly that head, and deploys it. Later pushes to main never affect it.

All lifecycle logic stays in `scripts/round` (open, close, cut, gate, deploy
and their guards); this is a thin orchestrator that calls it as a subprocess
and never bypasses a refusal.

  scripts/release [--sha S] [--ci-timeout MIN]
                  [--poll SEC] [--dry-run] [--adopt]

Steps, in order:
  1. fetch origin main/prod; S = --sha or origin/main; S must sit on
     origin/main's first-parent line (else exit 1).
  2. S already in origin/prod: "already live", exit 0.
  3. A release in flight (a live round.json record or an unrecorded origin
     `release/*`):
     - this worktree owns the record (`.release-owner` marker at the worktree
       root, written at cut, matching the recorded branch + base; round.json
       is shared by every worktree, so "recorded" is not "mine"): resume
       (6-7). `--adopt` takes ownership of a recorded release whose cutting
       session died (prints a warning);
     - the open release's (or the deploying one's, or an unrecorded
       branch's) head contains S: "riding release ...", exit 0;
     - otherwise exit 0: S "rides the next cut". No queueing (release-train
       §5): the next cut is made at deploy start by the driver.
  4. Round: open one if none; close + reopen one that already deployed.
  5. `round cut --sha S` (its stdout, incl. `late:` and `fleet say`, passes
     through). Losing a race to a sibling cut goes back to 3.
  6. Poll `round gate --json` until the candidate equals the release head.
     Early red comes from the head's check-runs (sha-keyed REST `gh api`, never
     `gh run list`: stale cache, see scripts/last-gated-main-sha): a completed
     `lint` / `test-linux*` run that is not success/skipped/neutral exits 2
     with job names, URLs and the `scripts/ci-failed` line. The release
     branch stays; fix via `scripts/ship --release` or `round cut --abandon`.
     --ci-timeout also exits 2. Either verdict (green or red, with the run id)
     is recorded in prod before any deploy as a row of the `release.ci_verdicts`
     setting, `{sha, range: '<prev_prod>..<sha>', verdict, run_id, at}`
     (best-effort, through scripts/prod-precis); the plan gate `tests-green`
     reads it first (src/precis/plans/gates.py).
  7. `round deploy`, output streamed. Exit 3 (rollout done, runtime pending)
     prints the `next:` confirm line and exits 3. The deploy playbook's last
     gate (deploy/redeploy-precis.yml, "Verify every managed precis venv")
     fails the run unless the running precis-web reports the pinned sha in
     /healthz's X-Precis-Boot-Sha header, so a web left on the previous build
     (gr496849) is a failed deploy, not a green one. After a rollout (exit 0
     or 3) the deployed head is recorded in prod as the `release.prod_head`
     setting, `{head, deployed_at, landed}` (best-effort, through
     scripts/prod-precis); the plan gates `sha-in-prod` / `tests-green` read
     it (src/precis/plans/gates.py). Then scripts/gripe-validate flips every
     STATUS:verify gripe whose resolved sha is now on origin/prod to done
     (gr541800; best-effort).

Re-running after any partial state resumes: a recorded release containing S
skips the cut (owner only; the marker is removed after `round close`
succeeds or once the recorded release is gone; a re-run retries a close that
failed); a journal with rollout done prints the `next:` line at once.

--dry-run only reads; it prints the plan and passes --dry-run to round cut and
round deploy where they apply.

Exit codes: 0 live / riding / next-cut / done; 1 refused; 2 CI red or
timeout; 3 runtime confirmation pending; any other = `round deploy`'s.

PRECIS_ROUND_ROOT selects the checkout (as for scripts/round).
"""

from __future__ import annotations

import argparse
import json
import math
import os
import re
import shlex
import signal
import subprocess
import sys
import time
from collections.abc import Callable
from datetime import UTC, datetime
from pathlib import Path
from typing import Any

HERE = Path(__file__).resolve().parent
ROUND = HERE / "round"
OK_CONCLUSIONS = ("success", "skipped", "neutral")
OPEN_STATES = ("cut", "gating", "fixing", "green")
DEPLOYING_STATES = ("deploying", "deployed")
TERMINAL_STATES = ("confirmed", "superseded", "abandoned")
_JQ = (
    '.check_runs[] | [.name, .status, (.conclusion // ""), .html_url,'
    ' (.details_url // ""), .id] | @tsv'
)
MAX_CUT_RACES = 5


def _root() -> Path:
    override = os.environ.get("PRECIS_ROUND_ROOT", "").strip()
    return Path(override) if override else HERE.parent


ROOT = _root()


def say(msg: str) -> None:
    print(msg, flush=True)


def git(*args: str) -> str | None:
    try:
        cp = subprocess.run(
            ["git", "-C", str(ROOT), *args],
            capture_output=True,
            text=True,
            encoding="utf-8",
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return cp.stdout.strip() if cp.returncode == 0 else None


def ancestor(older: str, newer: str) -> bool:
    cp = subprocess.run(
        ["git", "-C", str(ROOT), "merge-base", "--is-ancestor", older, newer],
        capture_output=True,
        check=False,
    )
    return cp.returncode == 0


def rev(name: str) -> str:
    return git("rev-parse", "--verify", "--quiet", f"{name}^{{commit}}") or ""


def remote(ref: str) -> str | None:
    """None = unreadable, empty = absent."""
    out = git("ls-remote", "origin", ref)
    if out is None:
        return None
    return next((ln.split()[0] for ln in out.splitlines() if ln.split()[1] == ref), "")


def release_branches() -> list[str] | None:
    out = git("ls-remote", "--heads", "origin", "release/*")
    if out is None:
        return None
    return [ln.split("refs/heads/", 1)[1] for ln in out.splitlines() if "\trefs/" in ln]


def rnd(*args: str, stream: bool = False) -> subprocess.CompletedProcess[str]:
    argv = [str(ROUND), *args]
    if stream:
        return subprocess.run(argv, cwd=ROOT, check=False, text=True, encoding="utf-8")
    return subprocess.run(
        argv,
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
    )


def die(code: int, msg: str) -> int:
    print(msg, file=sys.stderr, flush=True)
    return code


def fetch() -> None:
    if git("fetch", "-q", "origin", "main", "prod") is not None:
        return
    for ref in ("main", "prod"):  # a ref absent on origin fails the combined fetch
        git("fetch", "-q", "origin", ref)


def round_state() -> dict[str, Any] | None:
    cp = rnd("status", "--json")
    try:
        data = json.loads(cp.stdout)
        cur = data["round"]
    except (ValueError, KeyError, TypeError):
        return None
    return cur if cp.returncode == 0 and isinstance(cur, dict) else None


def head_containing(sha: str, branch: str, base: str) -> tuple[str, bool]:
    """(head or base of a release, whether it contains sha)."""
    head = remote(f"refs/heads/{branch}") or ""
    if head and not rev(head):
        git("fetch", "-q", "origin", f"refs/heads/{branch}")
    tip = head or base
    return tip, bool(tip and rev(tip) and ancestor(sha, tip))


def _run_id(row: list[str]) -> int:
    try:
        return int(row[5])
    except (IndexError, ValueError):
        return 0


def _row_run_id(row: list[str]) -> int:
    """Workflow-run id a check-run row belongs to, from its job urls."""
    for u in row[3:5]:
        m = re.search(r"/actions/runs/(\d+)", u)
        if m:
            return int(m.group(1))
    return 0


def ci_red(head: str) -> dict[str, Any] | bool | None:
    """False = gh unreadable; None = no completed red; else the failing jobs."""
    try:
        cp = subprocess.run(
            [
                "gh",
                "api",
                f"repos/{{owner}}/{{repo}}/commits/{head}/check-runs",
                "--paginate",
                "--jq",
                _JQ,
            ],
            cwd=ROOT,
            capture_output=True,
            text=True,
            encoding="utf-8",
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.SubprocessError):
        return False
    if cp.returncode != 0:
        return False
    rows = [ln.split("\t") for ln in cp.stdout.splitlines() if ln.count("\t") >= 3]
    # gr504329: check-runs are sha-keyed, so rows span every workflow run
    # ever made on this sha — a cancelled job from a superseded run
    # poisoned a fresh release's verdict while the new run had not yet
    # produced its own check-run for that name (r84, 2026-10-22). Scope
    # the verdict to the CURRENT run: the newest check.yml run id
    # `gh run list` reports, else the newest run id the rows' urls carry.
    # A job name absent from the current run is pending, not red. A row
    # with no parseable run id stays — a red we cannot date is still a
    # red worth seeing.
    current_run = 0
    rid = _regate_run_id(head)
    if rid.isdigit():
        current_run = int(rid)
    if not current_run:
        current_run = max((_row_run_id(r) for r in rows), default=0)
    if current_run:
        rows = [r for r in rows if _row_run_id(r) in (0, current_run)]
    # A rerun adds a newer check-run of the same name: only the latest counts,
    # and a latest that is still running is not red yet.
    latest: dict[str, list[str]] = {}
    for r in rows:
        # failed-first counts as the release's red even though every shard
        # it gated then reads `skipped` (release train §3).
        if r[0] not in ("lint", "failed-first") and not r[0].startswith("test-linux"):
            continue
        old = latest.get(r[0])
        if old is None or _run_id(r) >= _run_id(old):
            latest[r[0]] = r
    bad = [
        r for r in latest.values() if r[1] == "completed" and r[2] not in OK_CONCLUSIONS
    ]
    if not bad:
        return None
    urls: list[str] = []
    for r in bad:
        for u in (r[3], r[4] if len(r) > 4 else ""):
            if u and u not in urls:
                urls.append(u)
    run_id = ""
    for u in urls:
        m = re.search(r"/actions/runs/(\d+)", u)
        if m:
            run_id = m.group(1)
            break
    return {"jobs": [r[0] for r in bad], "urls": urls, "run_id": run_id}


def marker_path() -> Path:
    """`.release-owner` at THIS worktree's root (round.json is shared by all)."""
    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    ).stdout.strip()
    return Path(top or Path.cwd()) / ".release-owner"


def read_owner() -> dict[str, Any]:
    try:
        data = json.loads(marker_path().read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def write_owner(branch: str, base: str, cut_at: str) -> None:
    path = marker_path()
    data = {
        "branch": branch,
        "base": base,
        "cut_at": cut_at,
        "worktree": str(path.parent),
    }
    path.write_text(json.dumps(data, indent=1) + "\n", encoding="utf-8")


def clear_owner() -> None:
    marker_path().unlink(missing_ok=True)


def owns(rel: dict[str, Any]) -> bool:
    """This worktree cut the recorded release (marker matches branch + base)."""
    mark = read_owner()
    return bool(
        rel
        and mark.get("branch") == rel.get("branch")
        and mark.get("base") == rel.get("base")
    )


def gate_facts() -> dict[str, Any]:
    cp = rnd("gate", "--json")
    try:
        data = json.loads(cp.stdout)
    except ValueError:
        return {}
    return data if isinstance(data, dict) else {}


def _max_candidate_hours() -> float:
    """Mirror scripts/round's PRECIS_ROUND_MAX_CANDIDATE_HOURS (default 6h).

    Round deploy owns the refusal; this is only the staleness pre-check that
    decides whether a CI re-run is worth triggering first. An unreadable or
    non-positive setting defers to the default, same as the guard.
    """
    try:
        v = float(os.environ.get("PRECIS_ROUND_MAX_CANDIDATE_HOURS", "") or 6.0)
    except ValueError:
        return 6.0
    return v if math.isfinite(v) and v > 0 else 6.0


def _regate_run_id(sha: str) -> str:
    """Newest check.yml run id on `sha`; '' when gh or the run is unreadable."""
    try:
        cp = subprocess.run(
            [
                "gh",
                "run",
                "list",
                "--commit",
                sha,
                "--workflow",
                "check.yml",
                "--limit",
                "1",
                "--json",
                "databaseId",
                "--jq",
                ".[0].databaseId",
            ],
            cwd=ROOT,
            capture_output=True,
            text=True,
            encoding="utf-8",
            check=False,
            timeout=120,
        )
    except (OSError, subprocess.SubprocessError):
        return ""
    return cp.stdout.strip() if cp.returncode == 0 else ""


def _wait_fresh_verdict(head: str, args: argparse.Namespace) -> int:
    """Wait for a re-run verdict on `head` that is green AND inside the age
    limit. 2 on red; 0 on green or on timeout (the deploy then re-checks and
    keeps its own refusal path, same as before this existed)."""
    deadline = time.monotonic() + args.ci_timeout * 60
    limit = _max_candidate_hours()
    say(f"waiting for the re-run verdict on {head[:9]}")
    while True:
        facts = gate_facts()
        cand = str(facts.get("candidate") or "")
        age = facts.get("age_hours")
        if (
            cand == head
            and isinstance(age, (int, float))
            and math.isfinite(age)
            and 0 <= age <= limit
        ):
            say(f"verdict fresh on {head[:9]} ({age:.1f}h)")
            return 0
        red = ci_red(head)
        if isinstance(red, dict):
            print(
                f"re-run CI on {head[:9]} went red — failing: {', '.join(red['jobs'])}",
                file=sys.stderr,
            )
            for u in red["urls"]:
                print(f"  {u}", file=sys.stderr)
            return 2
        if time.monotonic() >= deadline:
            say(
                f"re-run verdict not green within {args.ci_timeout:g} min — "
                "deploy will apply its own verdict-age refusal if still stale"
            )
            return 0
        time.sleep(args.poll)


def _regate_if_stale(args: argparse.Namespace) -> int:
    """When the release head's CI verdict is older than the deploy guard's
    limit, re-run CI on the same sha and wait for a fresh verdict instead of
    letting `round deploy` refuse (the r33 resume that died on age alone).
    0 = proceed to deploy; 2 = the re-run went red."""
    facts = gate_facts()
    cand = str(facts.get("candidate") or "")
    head = str(facts.get("release_head") or "")
    if not cand or not head or cand != head:
        return 0  # not an exact-green release head; deploy's own guards decide
    age = facts.get("age_hours")
    if not isinstance(age, (int, float)) or not math.isfinite(age) or age < 0:
        return 0  # unknown age keeps the existing refusal path
    limit = _max_candidate_hours()
    if age <= limit:
        return 0
    say(
        f"verdict for {cand[:9]} is {age:.1f}h old (limit {limit:g}h) — "
        "re-running CI on the same sha instead of refusing"
    )
    run_id = _regate_run_id(cand)
    if not run_id:
        say(
            "no check.yml run found on that sha to re-run — deploy proceeds to its own verdict check"
        )
        return 0
    cp = subprocess.run(
        ["gh", "run", "rerun", run_id],
        cwd=ROOT,
        check=False,
        capture_output=True,
        text=True,
        encoding="utf-8",
        timeout=120,
    )
    if cp.returncode != 0:
        say(
            f"gh run rerun {run_id} failed ({cp.stderr.strip() or cp.returncode}) — deploy proceeds to its own verdict check"
        )
        return 0
    say(f"re-ran check.yml run {run_id} on {cand[:9]}")
    return _wait_fresh_verdict(head, args)


def next_line(sha: str) -> str:
    return (
        f"next: verify runtime, then scripts/round deploy --confirm-runtime {sha} "
        "--runtime-evidence '<observed services/boot SHAs/readiness/session MCP>' "
        "&& scripts/round close"
    )


def live_releases(state: dict[str, Any]) -> list[dict[str, Any]]:
    return [
        r
        for r in (state.get("releases") or [])
        if r.get("state") not in TERMINAL_STATES
    ]


def _release_by_state(state: dict[str, Any], states: tuple[str, ...]) -> dict[str, Any]:
    return next((r for r in live_releases(state) if r.get("state") in states), {})


def release_label(state: dict[str, Any]) -> str:
    """``r<N>`` from the recorded release branch, else the round number."""
    rel = _release_by_state(state, DEPLOYING_STATES) or _release_by_state(
        state, OPEN_STATES
    )
    branch = str(rel.get("branch") or "")
    return branch.rsplit("/", 1)[-1] if branch else f"r{state.get('n')}"


#: Longest the deploy path waits on scripts/gripe-note (its own prod call
#: is capped at 25 s); past this the note is abandoned, the deploy goes on.
NOTE_TIMEOUT_S = 30.0


def note_gripes(prev: str, head: str, text: str) -> None:
    """Comment each gripe a commit in prev..head fixes (scripts/gripe-note).

    Best-effort: the rollout already happened, so nothing here fails or
    holds the deploy past :data:`NOTE_TIMEOUT_S`.
    """
    if not head or prev == head:
        return
    rng = f"{prev}..{head}" if prev else head
    # Own process group: gripe-note runs under `uv run`, whose python child
    # would outlive a kill of the direct child and keep the pipe open.
    try:
        proc = subprocess.Popen(
            [str(HERE / "gripe-note"), "--rev", rng, "--text", text],
            cwd=str(ROOT),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            start_new_session=True,
        )
    except OSError as e:
        say(f"gripe-note: {type(e).__name__} — no deploy comments posted")
        return
    try:
        out, _ = proc.communicate(timeout=NOTE_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        say(
            f"gripe-note: TimeoutExpired after {NOTE_TIMEOUT_S:g}s — no deploy comments"
        )
        return
    if out.strip():
        say(out.strip())


#: The prod record of the deployed head: an ``app_settings`` row, registered
#: in ``precis.settings.REGISTRY`` (this script cannot import precis; a test
#: pins the two literals equal). ``precis.plans.gates`` reads it for the
#: ``sha-in-prod`` / ``tests-green`` gates — the server has no git.
PROD_HEAD_KEY = "release.prod_head"
#: Abbreviation length of the recorded ``landed`` shas (gates match by prefix).
LANDED_SHA_LEN = 12
#: Most shas kept in ``landed``; the oldest fall off first. 2000 x 12 chars is
#: about 26 KB, comfortably inside an argv slot.
MAX_LANDED = 2000
#: Cap on each of the two prod calls (read the old record, write the new).
RECORD_TIMEOUT_S = 40.0

#: Runs ``scripts/prod-precis <args>``; returns (returncode, stdout, stderr).
#: Tests pass a fake; a real call raises OSError/TimeoutExpired.
Transport = Callable[[list[str]], tuple[int, str, str]]


def _prod_precis(args: list[str]) -> tuple[int, str, str]:
    """The real transport: scripts/prod-precis from a tree that may write.

    A deploy moves origin/prod past this checkout, and prod-precis refuses a
    write from a tree behind it, so reuse scripts/gripe-note's tree choice
    (this one, else the prod clone) and its process-group-safe timeout.
    """
    import importlib.machinery
    import importlib.util

    path = HERE / "gripe-note"
    loader = importlib.machinery.SourceFileLoader("gripe_note", str(path))
    spec = importlib.util.spec_from_loader("gripe_note", loader)
    if spec is None:
        raise OSError("cannot load scripts/gripe-note")
    gn = importlib.util.module_from_spec(spec)
    exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), gn.__dict__)
    cli = os.environ.get("PRECIS_GRIPE_NOTE_CLI", "").strip()
    base = (
        shlex.split(cli)
        if cli
        else [str(gn.write_tree(HERE.parent) / "scripts" / "prod-precis")]
    )
    cp = gn.run_capped([*base, *args], RECORD_TIMEOUT_S)
    return cp.returncode, cp.stdout, cp.stderr


def _record_skip_reason() -> str | None:
    """Why the real transport must not run, or None. Same seams as
    scripts/gripe-note: PRECIS_GRIPE_NOTE=0, no prod DSN on this host
    (PRECIS_GRIPE_NOTE_CLI replaces the check). A PRECIS_ROUND_ROOT override
    means a test rig or a foreign checkout, never the repo that deploys."""
    if os.environ.get("PRECIS_GRIPE_NOTE", "1") == "0":
        return "PRECIS_GRIPE_NOTE=0"
    if HERE.parent != ROOT:
        return "PRECIS_ROUND_ROOT names another checkout"
    dsn = Path.home() / ".secrets" / "pw" / "PRECIS_DATABASE_URL"
    if not os.environ.get("PRECIS_GRIPE_NOTE_CLI", "").strip() and not dsn.is_file():
        return "no prod DSN on this host"
    return None


def landed_shas(prev: str, head: str) -> list[str]:
    """Abbreviated shas in ``prev..head`` (``head`` alone with no ``prev``),
    newest first; empty when git cannot read the range."""
    rng = f"{prev}..{head}" if prev else head
    out = git("rev-list", "--abbrev-commit", f"--abbrev={LANDED_SHA_LEN}", rng)
    return [s[:LANDED_SHA_LEN] for s in (out or "").split()]


_GET_RE = re.compile(
    rf"^{re.escape(PROD_HEAD_KEY)} = (.*) \(layer=(\w+)\)$", re.MULTILINE
)


def parse_prod_head(stdout: str) -> dict[str, Any] | None:
    """The record from ``precis settings get`` output, or None (unset,
    unparsable, not the DB layer)."""
    m = _GET_RE.search(stdout)
    if m is None or m.group(2) != "db":
        return None
    try:
        rec = json.loads(m.group(1))
    except ValueError:
        return None
    return rec if isinstance(rec, dict) else None


def prod_head_record(
    head: str,
    landed: list[str],
    previous: dict[str, Any] | None,
    now: datetime,
) -> dict[str, Any]:
    """``{head, deployed_at (UTC Z), landed}``; ``landed`` is this deploy's
    shas, then the previous record's head and landed (so a sha that rode an
    earlier release still reads as in prod), deduped and capped. A rollback
    keeps the rolled-back-over shas; only a new deploy ever trims."""
    merged: list[str] = []
    seen: set[str] = set()
    old = [str(previous["head"])[:LANDED_SHA_LEN]] if previous else []
    old += [str(s) for s in (previous or {}).get("landed") or []]
    for s in [*landed, *old]:
        key = s[:LANDED_SHA_LEN]
        if key and key not in seen:
            seen.add(key)
            merged.append(key)
    return {
        "head": head,
        "deployed_at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
        "landed": merged[:MAX_LANDED],
    }


def record_prod_head(
    prev: str,
    head: str,
    *,
    transport: Transport | None = None,
    now: datetime | None = None,
    landed: list[str] | None = None,
) -> str:
    """Write the deployed-head record into prod; returns one status line.

    ``prev`` is origin/prod before the deploy. Reads the old record through
    the same ``scripts/prod-precis settings get`` call path, merges, and
    writes with ``settings set``. Best-effort like :func:`note_gripes`: the
    rollout already happened, so any fault is reported, never raised.
    """
    if not head:
        return "prod head not recorded: no head sha"
    if transport is None and (why := _record_skip_reason()):
        return f"prod head not recorded: {why}"
    send = transport or _prod_precis
    when = now or datetime.now(UTC)
    shas = landed if landed is not None else landed_shas(prev, head)
    try:
        rc, out, _err = send(["settings", "get", PROD_HEAD_KEY])
        previous = parse_prod_head(out) if rc == 0 else None
        rec = prod_head_record(head, shas, previous, when)
        value = json.dumps(rec, separators=(",", ":"))
        rc, _out, err = send(["settings", "set", PROD_HEAD_KEY, value])
    except (OSError, subprocess.SubprocessError) as e:
        return f"prod head not recorded: {type(e).__name__}"
    if rc != 0:
        tail = re.sub(r"[a-z]+://\S+", "<url>", (err.strip().splitlines() or [""])[-1])
        return f"prod head not recorded (exit {rc}): {tail[:200]}"
    return f"prod head recorded: {head[:9]} (+{len(shas)} landed)"


#: The prod record of CI verdicts on release candidates (``app_settings``,
#: registered in ``precis.settings.REGISTRY``; a test pins the literals
#: equal). ``precis.plans.gates`` reads it first for ``tests-green`` — the
#: verdict is known here before the deploy, which is the whole point.
CI_VERDICTS_KEY = "release.ci_verdicts"
#: Most verdict rows kept; the oldest fall off first. Rows hold abbreviated
#: shas (~130 bytes each), so 500 stay near 65 KB, inside one 128 KB argv slot.
MAX_CI_VERDICTS = 500

_VERDICTS_GET_RE = re.compile(
    rf"^{re.escape(CI_VERDICTS_KEY)} = (.*) \(layer=(\w+)\)$", re.MULTILINE
)


def parse_ci_verdicts(stdout: str) -> list[dict[str, Any]]:
    """The rows from ``precis settings get`` output; ``[]`` when unset,
    unparsable or not the DB layer."""
    m = _VERDICTS_GET_RE.search(stdout)
    if m is None or m.group(2) != "db":
        return []
    try:
        rows = json.loads(m.group(1))
    except ValueError:
        return []
    return [r for r in rows if isinstance(r, dict)] if isinstance(rows, list) else []


def ci_verdict_rows(
    sha: str,
    rng: str,
    verdict: str,
    run_id: str,
    previous: list[dict[str, Any]],
    now: datetime,
) -> list[dict[str, Any]]:
    """``previous`` plus ``{sha, range, verdict, run_id, at (UTC Z)}``,
    deduped by sha keeping the newest, capped at :data:`MAX_CI_VERDICTS`.
    Shas are abbreviated to :data:`LANDED_SHA_LEN` (gates match by prefix)."""
    row = {
        "sha": sha[:LANDED_SHA_LEN],
        "range": rng,
        "verdict": verdict,
        "run_id": str(run_id or ""),
        "at": now.strftime("%Y-%m-%dT%H:%M:%SZ"),
    }
    kept = [r for r in previous if str(r.get("sha", ""))[:LANDED_SHA_LEN] != row["sha"]]
    return [*kept, row][-MAX_CI_VERDICTS:]


def record_ci_verdict(
    sha: str,
    rng: str,
    verdict: str,
    run_id: str = "",
    *,
    transport: Transport | None = None,
    now: datetime | None = None,
) -> str:
    """Append a CI verdict for candidate ``sha`` to prod; returns one status
    line. ``rng`` is ``<prev_prod>..<sha>``; ``verdict`` is ``green`` or
    ``red``. Same path and skip reasons as :func:`record_prod_head`, and the
    same best-effort contract: a fault is reported, never raised.
    """
    if not sha:
        return "ci verdict not recorded: no sha"
    if verdict not in ("green", "red"):
        return f"ci verdict not recorded: verdict {verdict!r} is not green|red"
    if transport is None and (why := _record_skip_reason()):
        return f"ci verdict not recorded: {why}"
    send = transport or _prod_precis
    when = now or datetime.now(UTC)
    try:
        rc, out, _err = send(["settings", "get", CI_VERDICTS_KEY])
        previous = parse_ci_verdicts(out) if rc == 0 else []
        rows = ci_verdict_rows(sha, rng, verdict, run_id, previous, when)
        value = json.dumps(rows, separators=(",", ":"))
        rc, _out, err = send(["settings", "set", CI_VERDICTS_KEY, value])
    except (OSError, subprocess.SubprocessError) as e:
        return f"ci verdict not recorded: {type(e).__name__}"
    if rc != 0:
        tail = re.sub(r"[a-z]+://\S+", "<url>", (err.strip().splitlines() or [""])[-1])
        return f"ci verdict not recorded (exit {rc}): {tail[:200]}"
    return f"ci verdict recorded: {sha[:9]} {verdict}"


def note_ci_verdict(head: str, verdict: str, run_id: str = "") -> None:
    """Record the verdict on release head ``head`` against origin/prod and
    say the status line. Best-effort: never raises."""
    prev = rev("origin/prod")
    rng = f"{prev[:LANDED_SHA_LEN]}..{head[:LANDED_SHA_LEN]}" if prev else head
    try:
        say(record_ci_verdict(head, rng, verdict, run_id))
    except Exception as e:  # the gate step must not die on bookkeeping
        say(f"ci verdict not recorded: {type(e).__name__}")


#: Longest the deploy path waits on scripts/gripe-validate (two prod calls,
#: each capped at 90 s); past this it is abandoned, the release goes on.
VALIDATE_TIMEOUT_S = 200.0


def validate_gripes() -> None:
    """Flip verify gripes whose sha is now on origin/prod to done
    (scripts/gripe-validate, gr541800). Best-effort like :func:`note_gripes`:
    the rollout already happened, nothing here fails the release."""
    script = HERE / "gripe-validate"
    if not script.exists() or HERE.parent != ROOT:
        return  # a test rig / foreign checkout (PRECIS_ROUND_ROOT) never writes
    try:
        proc = subprocess.Popen(
            [str(script)],
            cwd=str(ROOT),
            stdout=subprocess.PIPE,
            stderr=subprocess.DEVNULL,
            text=True,
            encoding="utf-8",
            start_new_session=True,
        )
    except OSError as e:
        say(f"gripe-validate: {type(e).__name__} — no gripes validated")
        return
    try:
        out, _ = proc.communicate(timeout=VALIDATE_TIMEOUT_S)
    except subprocess.TimeoutExpired:
        os.killpg(proc.pid, signal.SIGKILL)
        proc.communicate()
        say(f"gripe-validate: TimeoutExpired after {VALIDATE_TIMEOUT_S:g}s")
        return
    if out.strip():
        say(out.strip())


def pending_sha(rel: dict[str, Any], default: str) -> str:
    dep = rel.get("deployment") or {}
    return str(dep.get("sha") or default)


#: The post-migration probe shells out to scripts/prod-precis (git fetch +
#: uv run + one prod query); cap the whole call well above that.
POST_MIGRATION_CHECK_TIMEOUT_S = 180.0


def warn_post_migration() -> None:
    """Name pending post-migration steps after the deploy's migrate play.

    The assert itself is `precis post-migration-check` — read-only, listing
    NOT VALID constraints and missing per-kind ANN indexes with the command
    that clears each — run against prod through scripts/prod-precis. The
    health-digest ``post_migration_steps`` row reports the same probe
    continuously (gr514955; prod ran weeks on the global-index fallback
    before anyone noticed, gr513663). Best-effort: a missing wrapper or an
    unreadable prod never fails a deploy.
    """
    wrapper = ROOT / "scripts" / "prod-precis"
    if not wrapper.exists():
        say("post-migration check skipped: scripts/prod-precis not in this checkout")
        return
    try:
        cp = subprocess.run(
            [str(wrapper), "post-migration-check"],
            cwd=ROOT,
            check=False,
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=POST_MIGRATION_CHECK_TIMEOUT_S,
        )
    except (OSError, subprocess.SubprocessError) as e:
        say(f"post-migration check skipped: {type(e).__name__}")
        return
    if cp.returncode == 0:
        for line in cp.stdout.strip().splitlines():
            say(line)
        return
    tail = (cp.stderr or "").strip().splitlines()
    say(
        f"post-migration check unreadable (rc {cp.returncode}): "
        f"{tail[-1][:200] if tail else 'no output'}"
    )


def warn_hook_drift() -> None:
    """Report drifted live copies of scripts/hooks/* at release time.

    The ~/.claude/hooks globals are hand copies of scripts/hooks/* and the
    user settings' `cmp -s` shims run the GLOBAL whenever it differs — a
    stale global silently serves old code (gr516942). scripts/hook-sync
    only reports (the exact `cp` per drifted file); never fails a release.
    """
    script = ROOT / "scripts" / "hook-sync"
    if not script.exists():
        return
    try:
        cp = subprocess.run(
            ["bash", str(script)],
            cwd=ROOT,
            check=False,
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError) as e:
        say(f"hook-sync check skipped: {type(e).__name__}")
        return
    for line in cp.stdout.strip().splitlines():
        say(line)


def wait_ci(branch: str, args: argparse.Namespace) -> int:
    """0 = release head is green; else the exit code to return."""
    deadline = time.monotonic() + args.ci_timeout * 60
    warned = False
    say(f"waiting for CI on {branch}")
    while True:
        facts = gate_facts()
        head = str(facts.get("release_head") or "")
        cand = str(facts.get("candidate") or "")
        rbranch = str(facts.get("release_branch") or "")
        if facts.get("candidate_state") == "release_missing" and rbranch == branch:
            return die(1, f"release {branch} is missing on origin — investigate")
        if head and cand == head and rbranch == branch:
            say(f"CI green on {branch} at {head[:9]}")
            note_ci_verdict(head, "green", _regate_run_id(head))
            return 0
        if head and rbranch == branch:
            red = ci_red(head)
            if red is False:
                if not warned:
                    say("gh unreadable: polling `round gate` only (no early red)")
                    warned = True
            elif isinstance(red, dict):
                # `gh run rerun` can lag the old failure: confirm one poll later
                time.sleep(args.poll)
                red = ci_red(head)
            if isinstance(red, dict):
                note_ci_verdict(head, "red", red["run_id"])
                print(
                    f"CI red on {branch} at {head[:9]} — failing: {', '.join(red['jobs'])}",
                    file=sys.stderr,
                )
                for u in red["urls"]:
                    print(f"  {u}", file=sys.stderr)
                if red["run_id"]:
                    print(f"  scripts/ci-failed {red['run_id']}", file=sys.stderr)
                print(
                    f"{branch} left in place: fix via scripts/ship --release, "
                    "or abandon with scripts/round cut --abandon",
                    file=sys.stderr,
                    flush=True,
                )
                return 2
        if time.monotonic() >= deadline:
            return die(
                2,
                f"CI not green after {args.ci_timeout:g} min on {branch} (left in place)",
            )
        time.sleep(args.poll)


def deploy_and_close(args: argparse.Namespace, sha: str) -> int:
    stale_rc = _regate_if_stale(args)
    if stale_rc:
        return stale_rc
    label = release_label(round_state() or {})
    prev = rev("origin/prod")
    rc = rnd("deploy", stream=True).returncode
    if rc in (0, 3):
        # The rollout ran, so its migrate play did too — name whatever
        # post-migration steps it left pending (gr514955). Best-effort.
        warn_post_migration()
        # Tell prod what is deployed (the server has no git): the
        # sha-in-prod / tests-green gates read this. Best-effort.
        cur = round_state() or {}
        head = pending_sha(_release_by_state(cur, DEPLOYING_STATES), sha)
        say(record_prod_head(prev, head))
    if rc == 3:
        # The release owner's path: rollout done, runtime confirmed later by
        # `scripts/round deploy --confirm-runtime`. The deploy note posts
        # here, the one exit of this script a deploy takes in practice.
        note_gripes(
            prev, head, f"deployed {label} ({{sha}}); runtime confirmation pending"
        )
        validate_gripes()
        say(next_line(head))
        return 3
    if rc != 0:
        return die(
            rc,
            "deploy failed — the release pin is retained; fix and re-run "
            "scripts/release (it resumes) or scripts/round deploy",
        )
    validate_gripes()
    cur = round_state() or {}
    if cur.get("open") and cur.get("deployed") and not live_releases(cur):
        if rnd("close", stream=True).returncode:
            return 0  # deployed; keep the marker, a re-run retries the close
    clear_owner()
    return 0


def run(args: argparse.Namespace) -> int:
    warn_hook_drift()  # gr516942: report (never write) ~/.claude hook drift
    races = 0
    while True:
        fetch()
        if args.sha:
            s = rev(args.sha)
            if not s:
                return die(1, f"scripts/release: {args.sha} is not a commit here")
        else:
            s = rev("origin/main")
            if not s:
                return die(1, "scripts/release: cannot resolve origin/main")
        s9 = s[:9]
        line = (
            git("rev-list", "--first-parent", "refs/remotes/origin/main") or ""
        ).split()
        if s not in line:
            return die(
                1, f"scripts/release: {s9} is not on origin/main's first-parent line"
            )
        cur = round_state()
        if cur is None:
            return die(1, "scripts/release: cannot read `scripts/round status --json`")
        live = live_releases(cur)
        open_rel = next((r for r in live if r.get("state") in OPEN_STATES), None)
        dep_rel = next((r for r in live if r.get("state") in DEPLOYING_STATES), None)
        owned = next((r for r in live if owns(r)), None)
        rel = owned or open_rel or dep_rel or {}
        mine = owned is not None
        if args.adopt and rel and not args.dry_run and not mine:
            print(
                f"warning: adopting release {rel.get('branch')} cut elsewhere — "
                "the cutting session must not also deploy it",
                file=sys.stderr,
                flush=True,
            )
            write_owner(
                str(rel.get("branch")), str(rel.get("base")), str(rel.get("cut_at"))
            )
            mine = True
        owner = read_owner()
        deployed = cur.get("deployed") or {}
        closing = bool(
            cur.get("open")
            and deployed
            and not live
            and owner.get("branch")
            and owner.get("branch") == deployed.get("branch")
        )
        if closing and not args.dry_run:
            # we deployed this round and its close never landed: retry it
            cp = rnd("close")
            sys.stdout.write(cp.stdout)
            if cp.returncode:
                sys.stderr.write(cp.stderr)
                print("warning: `round close` failed; re-run retries", file=sys.stderr)
            else:
                clear_owner()
                cur = round_state() or cur
        elif owner and not mine and not args.dry_run:
            clear_owner()  # recorded release is gone/retired or someone else's
        dep = rel.get("deployment") or {}
        dsha = str(dep.get("sha") or "")
        if (
            mine
            and dep.get("rollout_at")
            and not dep.get("runtime_confirmed_at")
            and rev(dsha)
            and ancestor(s, dsha)
        ):
            # prod already holds it, but the coordinator has not confirmed runtime
            say(f"resuming release {rel.get('branch')}: rollout done, {s9} pinned")
            say(next_line(dsha))
            return 3
        prod = remote("refs/heads/prod") or ""
        if prod and not rev(prod):
            git("fetch", "-q", "origin", "prod")
        if prod and rev(prod) and ancestor(s, prod):
            say(f"already live: {s9} is in origin/prod {prod[:9]}")
            return 0

        branches = release_branches()
        if branches is None:
            return die(1, "scripts/release: cannot read origin's branches")
        recorded = {r["branch"] for r in live}
        foreign = [b for b in branches if b not in recorded]

        if live or foreign:
            if rel and mine:
                tip, has = head_containing(s, rel["branch"], rel.get("base", ""))
                return resume(args, s, rel, tip, has)
            for r in (open_rel, dep_rel):
                if not r or r.get("cut_pending"):
                    continue
                tip, has = head_containing(s, r["branch"], r.get("base", ""))
                if has:
                    say(f"riding release {r['branch']} at {tip[:9]}: it ships {s9}")
                    return 0
            for b in foreign:
                tip, has = head_containing(s, b, "")
                if has:
                    say(f"riding release {b} at {tip[:9]}: it ships {s9}")
                    return 0
            say(f"{s9} rides the next cut")
            return 0

        # Nothing in flight: prepare the round, then cut.
        n = int(cur.get("n", 0) or 0)
        is_open = bool(cur.get("open"))
        if is_open and cur.get("deployed"):
            if args.dry_run:
                say(f"would close round {n} (deployed) and open round {n + 1}")
                n += 1
            else:
                for verb in ("close", "open"):
                    cp = rnd(verb)
                    sys.stdout.write(cp.stdout)
                    if cp.returncode:
                        sys.stderr.write(cp.stderr)
                        return 1
        elif not is_open:
            if args.dry_run:
                say(f"would open round {n + 1}")
                n += 1
            else:
                cp = rnd("open")
                sys.stdout.write(cp.stdout)
                if cp.returncode:
                    sys.stderr.write(cp.stderr)
                    return 1
        if args.dry_run:
            return dry_run_plan(s, n, is_open and not cur.get("deployed"))

        rc = cut_and_finish(args, s)
        if rc == -1:  # lost a cut race
            races += 1
            if races > MAX_CUT_RACES:
                return die(1, "scripts/release: gave up after repeated cut races")
            continue
        return rc


def dry_run_plan(s: str, n: int, can_ask_cut: bool) -> int:
    if can_ask_cut:  # `round cut` refuses without an open round
        cp = rnd("cut", "--sha", s, "--dry-run")
        sys.stdout.write(cp.stdout)
        if cp.returncode:
            sys.stderr.write(cp.stderr)
    say(f"would cut release/r{n} at {s[:9]}")
    say("would wait for CI")
    say("would deploy")
    return 0


def cut_and_finish(args: argparse.Namespace, s: str, branch: str = "") -> int:
    """Cut (or reconcile our own pending cut), wait for CI, deploy. -1 = not ours."""
    n = (round_state() or {}).get("n")
    branch = branch or f"release/r{n}"
    pre = read_owner()
    preowned = pre.get("branch") == branch and pre.get("base") == s
    stamp = datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    # Marker first: a crash between cut and marker must still resume as ours.
    write_owner(branch, s, stamp)
    cp = rnd("cut", "--sha", s)
    sys.stdout.write(cp.stdout)
    sys.stdout.flush()
    if cp.returncode:
        err = cp.stderr
        if "is already tagged on origin" in err:
            clear_owner()  # stale round number: nothing recorded by us
            return die(1, err.rstrip())
        if "exists on origin" in err or "already records an open release" in err:
            clear_owner()  # lost the race: nothing recorded by us
            sys.stderr.write(err)
            return -1
        # Anything else may leave our cut_pending intent recorded: keep ownership.
        return die(1, err.rstrip())
    fresh = f" cut at {s[:9]}" in cp.stdout
    if not (fresh or preowned or args.adopt):
        clear_owner()  # reconciled someone else's pending cut: not ours
        return -1
    rel = _release_by_state(round_state() or {}, OPEN_STATES)
    if rel:
        write_owner(str(rel["branch"]), str(rel["base"]), str(rel.get("cut_at", "")))
    return finish(args, s)


def finish(args: argparse.Namespace, s: str) -> int:
    cur = round_state() or {}
    rel = _release_by_state(cur, OPEN_STATES)
    branch = str(rel.get("branch") or f"release/r{cur.get('n')}")
    rc = wait_ci(branch, args)
    if rc:
        return rc
    return deploy_and_close(args, s)


def resume(
    args: argparse.Namespace, s: str, rel: dict[str, Any], tip: str, has: bool
) -> int:
    """Act on our own release first; S not in it rides the next release."""
    branch = str(rel["branch"])
    dep = rel.get("deployment") or {}
    if rel.get("cut_pending"):
        say(f"resuming: {branch} has a pending cut — reconciling")
        if args.dry_run:
            say("would reconcile the cut, wait for CI, deploy")
            return 0
        # the recorded base, not S: cut refuses a different pending SHA
        rc = cut_and_finish(args, str(rel["base"]), branch)
        return die(1, "scripts/release: lost the pending cut") if rc == -1 else rc
    if has:
        say(f"resuming release {branch} at {tip[:9]}: it ships {s[:9]}")
    else:
        say(
            f"resuming release {branch} at {tip[:9]}: {s[:9]} is not in it "
            "and rides the next release"
        )
    if dep.get("rollout_at") and not dep.get("runtime_confirmed_at"):
        say(next_line(pending_sha(rel, s)))
        return 3
    if args.dry_run:
        say("would wait for CI")
        rc = rnd("deploy", "--dry-run", stream=True).returncode
        if rc:
            say(f"(round deploy --dry-run: exit {rc} — expected until CI is green)")
        return 0
    facts = gate_facts()
    head = str(facts.get("release_head") or "")
    ours = facts.get("release_branch") == branch
    if not (head and ours and facts.get("candidate") == head):
        rc = wait_ci(branch, args)
        if rc:
            return rc
    return deploy_and_close(args, s)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(
        prog="scripts/release",
        description="Cut a release at main SHA S, wait for CI, deploy it.",
    )
    ap.add_argument("--sha", default="", help="commit on origin/main (default: tip)")
    ap.add_argument(
        "--queue-timeout",
        type=float,
        default=0.0,
        metavar="MIN",
        help=argparse.SUPPRESS,  # removed: step 3 no longer queues (release-train §5)
    )
    ap.add_argument("--ci-timeout", type=float, default=90.0, metavar="MIN")
    ap.add_argument("--poll", type=float, default=60.0, metavar="SEC")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument(
        "--adopt",
        action="store_true",
        help="take ownership of the recorded release (its cutting session died)",
    )
    return run(ap.parse_args(argv))


if __name__ == "__main__":
    sys.exit(main())

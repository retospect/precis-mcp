#!/usr/bin/env bash
# scripts/neb-seed-trust-drylist — READ-ONLY dry-run of the seed-independence
# gate (gr517804) over stored pathways.
#
# Replays the ruling — a neb-tier run needs ≥2 distinct seeds at its own
# autocatpath_version in the union pooled across its ready siblings — and
# lists every pathway that would fire, flagging those whose candidate still
# carries barrier_trusted=true. SELECT only, through `scripts/prod-psql --ro`;
# never writes.
#
# Usage:
#   scripts/neb-seed-trust-drylist                 # all pathways, flips only
#   scripts/neb-seed-trust-drylist --all-fires     # every firing pathway
#   scripts/neb-seed-trust-drylist --ref 515950    # just this pathway
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run python scripts/_neb_seed_trust_drylist.py "$@"

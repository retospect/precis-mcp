#!/usr/bin/env bash
# scripts/backlog-lint — flag DONE-marked items still sitting in docs/backlog/.
#
# The backlog is ACTIVE work only; a shipped/done item is gunk (git log holds
# the record — delete-on-ship, docs/README.md). "Done" is a judgment (some
# items say "SHIPPED" but keep an open remainder), so this only SURFACES
# candidates — a file whose title/headings carry an explicit done-marker —
# it never deletes. Prune on completion; this catches the stragglers. Advisory
# (exit 0) like docs-orphans / memory-lint — except the prior-art section:
# a resolver-verified or malformed handle there exits nonzero (gr610793).
# Bunched into /whatneedsdoing.
set -euo pipefail
# An explicit relative arg is relative to the CALLER's cwd: this script can
# be reached through another checkout's scripts/ on PATH, and a path that
# silently resolved under the script's own root then lints the wrong tree
# (gr514451). The no-arg default stays the script's own backlog.
CALLER_PWD="$PWD"
cd "$(dirname "$0")/.."
case "${1:-}" in
    "") D="docs/backlog" ;;
    /*) D="$1" ;;
    *) D="$CALLER_PWD/$1" ;;
esac

# Title-level done-markers: a heading, or a list item whose bold title / leading
# clause carries DONE/RESOLVED/RETIRED/✅/[x]/"SHIPPED + …".
MARK='(DONE|RESOLVED|RETIRED|✅|\[x\]|SHIPPED \+|— *SHIPPED)'
# Exclude partially-open items — a shipped sub-part under still-open work —
# and definition bullets ("**DONE** → x" maps a state name, claims nothing).
OPEN='(still (open|unverified|pending)|remain|NEXT =|Phase-2|un(shipped|deployed)|not deployed|NOT deployed|slices? .*remain|round-trip|\*\* *→)'

hits="$(grep -rnE "^(#{1,6} .*${MARK}|- .*${MARK})" "$D" --include='*.md' 2>/dev/null | grep -v "$D/README.md" | grep -viE "$OPEN" || true)"

# Two buckets. The OPEN regex above only sees ONE line, so it cannot catch the
# commonest shape by far: a full spec — still open by construction — whose
# decisions log reports a RESOLVED sub-part. Those tripped the headline count
# every session and cost a re-verification each time. A file carrying
# "## Acceptance criteria" IS a full spec, so only a done-marker on its H1
# title claims the whole item is done; inner markers are sub-part reports.
# Nothing is dropped — sub-part hits still print, they just don't drive the
# count (an all-done spec whose H1 was never annotated lands there too).
loud=''
quiet=''
while IFS= read -r line; do
    [[ -z "$line" ]] && continue
    file="${line%%:*}"
    text="${line#*:*:}"
    # Open by construction: an Acceptance-criteria spec, or any item whose own
    # front-matter status: says it is not finished (idea/draft/ready/in-progress).
    st="$(awk 'NR==1 && $0!="---"{exit} NR>1 && $0=="---"{exit} /^status: */{sub(/^status: */,""); print; exit}' "$file" 2>/dev/null)"
    if { grep -qE '^## Acceptance criteria' "$file" 2>/dev/null \
         || [[ "$st" =~ ^(idea|draft|ready|in-progress)$ ]]; } \
       && [[ "$text" != '# '* ]]; then
        quiet+="$line"$'\n'
    else
        loud+="$line"$'\n'
    fi
done <<< "$hits"

fmt() { printf '%s' "$1" | sed -E 's/^([^:]+):([0-9]+):(.{0,72}).*/  \1:\2  \3/'; }
n="$(printf '%s' "$loud" | grep -c . || true)"
q="$(printf '%s' "$quiet" | grep -c . || true)"

if [[ "$n" -eq 0 ]]; then
    echo "backlog-lint: ✓ no done-marked gunk in $D"
else
    echo "backlog-lint: $n item(s) marked done but still in $D — verify shipped, then DELETE (git log keeps it). Listed because the file has no open-spec signal (## Acceptance criteria, or front-matter status: idea/draft/ready/in-progress) or the marker is on an H1:"
    fmt "$loud"
fi
if [[ "$q" -ne 0 ]]; then
    echo "  ($q done-marked sub-part(s) inside still-open specs — normal, not gunk)"
fi

# --- front-matter hygiene -------------------------------------------------
# Every item carries `status:` and `pillar:` in closed sets. Absent front
# matter is not neutral: scripts/docs-index renders such a file as `idea`, so
# an untyped item silently claims a readiness nobody chose. Rules taken from
# the abandoned 2026-09-23 compaction tree at the 2026-09-30 product-plan
# review; the sweep that applied them ran the same day. `parked` (Reto
# 2026-10-24) is a deliberately shelved item — out of the pick order until
# reopened, never rendered as done.
ALLOWED='idea|draft|ready|in-progress|canonical|parked'
PILLARS='memory-graph|3d-design|local-compute|personal|operations|quests|platform'
bare=''
badstatus=''
badpillar=''
for f in "$D"/*.md; do
    b="$(basename "$f")"
    [[ "$b" == INDEX.md || "$b" == README.md || "$b" == TEMPLATE.md ]] && continue
    s="$(sed -n 's/^status: *//p' "$f" | head -1)"
    if [[ -z "$s" ]]; then
        bare+="  $f  (no status:)"$'\n'
    elif ! [[ "$s" =~ ^(${ALLOWED})$ ]]; then
        badstatus+="  $f  status: $s"$'\n'
    fi
    p="$(sed -n 's/^pillar: *//p' "$f" | head -1)"
    if [[ -z "$p" ]]; then
        badpillar+="  $f  (no pillar:)"$'\n'
    elif ! [[ "$p" =~ ^(${PILLARS})$ ]]; then
        badpillar+="  $f  pillar: $p"$'\n'
    fi
done
if [[ -n "$bare" ]]; then
    echo "backlog-lint: $(printf '%s' "$bare" | grep -c .) item(s) with no front-matter status: (docs-index will call them 'idea'):"
    printf '%s' "$bare"
fi
if [[ -n "$badstatus" ]]; then
    echo "backlog-lint: status must be one of ${ALLOWED//|/ / }:"
    printf '%s' "$badstatus"
fi
if [[ -n "$badpillar" ]]; then
    echo "backlog-lint: $(printf '%s' "$badpillar" | grep -c .) item(s) with no or unknown pillar: (one of ${PILLARS//|/ / }; docs/roadmap.md):"
    printf '%s' "$badpillar"
fi

# --- prior-art ---------------------------------------------------------------
# A `prior-art:` value names the external source(s) an item was taken from —
# comma/space-separated decimal handles (`pa57193`, `me563920`, `web:608520`) —
# either as a front-matter field (covers the whole item) or as a `prior-art:`
# line inside one `##` section (covers that section — the umbrella form,
# capability-landscape-steals.md). A 'Steal identified' / 'Adapted from'
# sentence covered by neither is a source named in prose only: a renamed or
# retired handle there rots silently (gr610793).
#
# Existence resolution goes through scripts/backlog-handles — one prod read
# via scripts/prod-psql --ro, best-effort like docs-index's gripe read.
# PRECIS_BACKLOG_RESOLVER overrides the resolver command (tests inject a stub),
# `off`/`0` skips; resolution is on by default, CI included — a skipped check
# is how broken handles stayed green. A resolver-verified dead or mistyped
# handle, a malformed entry, or a handle the resolver gave no verdict for
# FAILS the lint (exit 1); an unreachable resolver is a quiet note (exit 0).
pa_handles=''
pa_cites=''
pa_malformed=''
pa_prose=''
for f in "$D"/*.md; do
    b="$(basename "$f")"
    [[ "$b" == INDEX.md || "$b" == README.md || "$b" == TEMPLATE.md ]] && continue
    scan="$(awk '
        NR == 1 && /^---[ \t]*$/ { fm = 1; next }
        fm == 1 && /^---[ \t]*$/ { fm = 0; next }
        /^```/ { fence = !fence; next }
        fence == 1 { next }
        fm == 0 && /^## / { sec++; secname[sec] = $0; secpa[sec] = 0; steal[sec] = 0 }
        /^prior-art:[ \t]*/ {
            line = $0; sub(/^prior-art:[ \t]*/, "", line); gsub(/[][(),\t]/, " ", line)
            n = split(line, a, /[ \t]+/); cnt = 0
            for (i = 1; i <= n; i++) if (a[i] != "") {
                printf "HANDLE%c%s%c%d%c%s\n", 31, FILENAME, 31, NR, 31, a[i]; cnt++
            }
            if (cnt == 0) printf "PAEMPTY%c%s%c%d\n", 31, FILENAME, 31, NR
            if (fm == 1) fmp = 1; else if (sec == 0) pre_pa = 1; else secpa[sec] = 1
            next
        }
        tolower($0) ~ /steal identified|adapted from/ {
            if (sec == 0) pre_steal = 1; else steal[sec] = 1
        }
        END {
            if (pre_steal && !fmp && !pre_pa)
                printf "PROSEWARN%c%s%c%s\n", 31, FILENAME, 31, "(before the first ## section)"
            for (s = 1; s <= sec; s++) if (steal[s] && !fmp && !secpa[s])
                printf "PROSEWARN%c%s%c%s\n", 31, FILENAME, 31, secname[s]
        }' "$f")"
    while IFS="$(printf '\037')" read -r tag c2 c3 c4; do
        case "$tag" in
            HANDLE)
                if [[ "$c4" =~ ^([a-z]{2}[0-9]+|[a-z][a-z0-9-]*:[0-9]+)$ ]]; then
                    if ! printf '%s\n' "$pa_handles" | grep -qxF "$c4"; then
                        pa_handles+="$c4"$'\n'
                        pa_cites+="$c4"$'\t'"$c2:$c3"$'\n'
                    fi
                else
                    pa_malformed+="  $c2:$c3  $c4"$'\n'
                fi ;;
            PAEMPTY) pa_malformed+="  $c2:$c3  (empty prior-art: list)"$'\n' ;;
            PROSEWARN) pa_prose+="  $c2  $c3"$'\n' ;;
        esac
    done <<< "$scan"
done

pa_missing=''
pa_note=''
RESOLVER="${PRECIS_BACKLOG_RESOLVER:-scripts/backlog-handles}"
if [[ -n "$pa_handles" ]]; then
    if [[ "$RESOLVER" == off || "$RESOLVER" == 0 ]]; then
        pa_note="prior-art resolution off (PRECIS_BACKLOG_RESOLVER=$RESOLVER)"
    else
        hs=()
        while IFS= read -r h; do
            [[ -n "$h" ]] && hs+=("$h")
        done <<< "$pa_handles"
        pa_out="$("$RESOLVER" ${hs[@]+"${hs[@]}"} 2>&1)" && rc=0 || rc=$?
        if [[ "$rc" -ne 0 ]]; then
            pa_note="prior-art resolution unavailable ($(printf '%s\n' "$pa_out" | tail -1 | cut -c1-120))"
        else
            pa_seen=''
            while IFS= read -r line; do
                [[ "$line" == *$'\t'* ]] || continue
                h="${line%%$'\t'*}"
                rest="${line#*$'\t'}"
                verdict="${rest%%$'\t'*}"
                detail="${rest#*$'\t'}"
                case "$verdict" in
                    resolved | missing | malformed) : ;;
                    *) continue ;;
                esac
                pa_seen+="$h"$'\n'
                [[ "$verdict" == resolved ]] && continue
                cite="$(printf '%s\n' "$pa_cites" | grep -F "$h"$'\t' | head -1)"
                pa_missing+="  ${cite#*$'\t'}  $h — $detail"$'\n'
            done <<< "$pa_out"
            # A handle the resolver gave no verdict for is not resolved —
            # a short-printing resolver must not silently green the list.
            while IFS= read -r h; do
                [[ -n "$h" ]] || continue
                if ! printf '%s\n' "$pa_seen" | grep -qxF "$h"; then
                    cite="$(printf '%s\n' "$pa_cites" | grep -F "$h"$'\t' | head -1)"
                    pa_missing+="  ${cite#*$'\t'}  $h — resolver gave no verdict"$'\n'
                fi
            done <<< "$pa_handles"
        fi
    fi
fi
if [[ -n "$pa_missing" ]]; then
    echo "backlog-lint: $(printf '%s' "$pa_missing" | grep -c .) prior-art handle(s) do not resolve:"
    printf '%s' "$pa_missing"
fi
if [[ -n "$pa_malformed" ]]; then
    echo "backlog-lint: malformed prior-art: entries (want decimal handles — <code><digits> like pa57193, or <kind>:<digits> like web:608520):"
    printf '%s' "$pa_malformed"
fi
if [[ -n "$pa_prose" ]]; then
    echo "backlog-lint: $(printf '%s' "$pa_prose" | grep -c .) place(s) name a source in prose only — 'Steal identified'/'Adapted from' without a prior-art: list covering it (front matter covers the whole item; a line inside a ## section covers that section):"
    printf '%s' "$pa_prose"
fi
if [[ -n "$pa_note" ]]; then
    echo "  ($pa_note)"
fi

# --- prefix crowding ------------------------------------------------------
# A family of >8 files sharing a leading token is the merge signal: it means
# one subject got filed N times instead of once with N sections.
# docs/backlog/lint-baseline.txt records reviewed families (`prefix count`);
# a family warns only when it first crosses 8 or grows past its recorded
# count, so new crowding is never lost in standing noise. Bump the file when
# the family is reviewed and kept as-is (or after it shrinks).
crowd="$(ls "$D"/*.md 2>/dev/null | sed -E 's|.*/||; s/-.*//' | sort | uniq -c)"
base="$D/lint-baseline.txt"
if [[ -f "$base" ]]; then
    crowd="$(printf '%s\n' "$crowd" | awk '
        NR==FNR { if ($1 !~ /^#/ && NF >= 2) known[$1] = $2; next }
        $1 > 8 && $1 > known[$2] + 0 { printf "  %s-*  %d files\n", $2, $1 }
    ' "$base" -)"
else
    crowd="$(printf '%s\n' "$crowd" | awk \
        '$1 > 8 {printf "  %s-*  %d files\n", $2, $1}')"
fi
if [[ -n "$crowd" ]]; then
    echo "backlog-lint: crowded prefixes — candidates for one umbrella item (grew past lint-baseline.txt):"
    printf '%s\n' "$crowd"
fi

# Prior-art is the one non-advisory section: a verified-dead or malformed
# handle is a broken cite, and a lint that cannot go red on it is no check
# at all (gr610793). Everything else above stays advisory.
[[ -n "$pa_missing$pa_malformed" ]] && exit 1
exit 0

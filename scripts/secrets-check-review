#!/usr/bin/env bash
# scripts/secrets-check-review — advisory 7-day cadence nudge for the weekly
# external-credential check. Mirrors gripe-gc-review: it does NOT probe the
# credentials (that is `scripts/prod-precis secret check`, run by the
# /whatneedsdoing step), it only tells you WHEN a check is due. Always exits 0.
#
# Why this exists: an expired or revoked API key otherwise surfaces only when a
# job fails (pourbaix_bulk failing failure_class=config, gr496305).
# Procedure:
#   docs/runbooks/secrets-check.md
# The clock is ~/.cache/precis/secrets-check-review.log, written by
#   scripts/secrets-check-review --stamp "<note>"   (see scripts/cadence-lib.sh)
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/cadence-lib.sh

cadence_init secrets-check-review 7 docs/runbooks/secrets-check.md "$@"

cadence_check check "run scripts/prod-precis secret check, queue each failed/missing credential for the owner with its key URL" || true
exit 0

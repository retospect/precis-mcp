#!/usr/bin/env bash
# scripts/secrets-check-review — advisory 7-day cadence nudge for the weekly
# external-credential check. Mirrors gripe-gc-review: it does NOT probe the
# credentials (that is `scripts/prod-precis secret check`, run by the
# /whatneedsdoing step), it only tells you WHEN a check is due. Always exits 0.
#
# Why this exists: an expired or revoked API key otherwise surfaces only when a
# job fails (pourbaix_bulk failing failure_class=config, gr496305).
# Procedure + dated log:
#   docs/runbooks/secrets-check.md   (the `## Log` section is the clock)
set -euo pipefail
cd "$(dirname "$0")/.."

LOG="docs/runbooks/secrets-check.md"
WINDOW_DAYS=7

if [[ ! -f "$LOG" ]]; then
    echo "secrets-check-review: DUE (no runbook at $LOG)"; exit 0
fi

# newest dated line in the `## Log` section (any order — sort -r picks the newest date)
last=$(awk '/^## Log/{f=1;next} f' "$LOG" \
    | grep -oE '\*\*[0-9]{4}-[0-9]{2}-[0-9]{2}\*\*' | sort -r | head -1 | tr -d '*' || true)

if [[ -z "$last" ]]; then
    echo "secrets-check-review: DUE (no dated entry in $LOG '## Log')"; exit 0
fi

# portable YYYY-MM-DD -> epoch seconds (BSD date on macOS, GNU date on CI/Linux)
epoch_of() { date -u -j -f "%Y-%m-%d" "$1" +%s 2>/dev/null || date -u -d "$1" +%s 2>/dev/null; }
last_e=$(epoch_of "$last" || true)
now_e=$(date +%s)

if [[ -z "$last_e" ]]; then
    echo "secrets-check-review: last entry '$last' unparseable — check $LOG"; exit 0
fi

days=$(( (now_e - last_e) / 86400 ))
if (( days > WINDOW_DAYS )); then
    echo "secrets-check-review: DUE (last check $last, ${days}d ago > ${WINDOW_DAYS}d) — run scripts/prod-precis secret check, queue each failed/missing credential for the owner with its key URL, append a dated line to $LOG. See the runbook."
else
    echo "secrets-check-review: ok (last check $last, ${days}d ago; due in $(( WINDOW_DAYS - days ))d)"
fi
exit 0

#!/usr/bin/env bash
# scripts/mcp-loadtest — ramp N concurrent MCP clients at a live `precis serve`
# and report which of the two concurrency walls you hit.
#
# The standing guidance is a 2-3 MCP-heavy-agent ceiling (memory
# `mcp-fleet-concurrency-limit`). The serving plan wants ~24. This measures
# the gap instead of assuming it, and its output names the binding constraint
# rather than leaving "calls hang" to be re-diagnosed by hand.
#
# Usage:
#   scripts/mcp-loadtest                          # default ramp 1..32, 20s/step
#   scripts/mcp-loadtest --ramp 1,4,8 --duration 10
#   scripts/mcp-loadtest --smoke                  # 1,2 at 5s — wiring check
#   scripts/mcp-loadtest --servers 3              # multi-process arm
#   scripts/mcp-loadtest --db precis_dev          # run against a seeded DB
#       (scripts/dev seed-prod-shaped, then drain the embed queue); the
#       harness refuses to start unless the target already holds a corpus.
#
# The --url mode for a live server (Reto's prod run) runs harness.py on the
# host instead; the exact command is in docs/backlog/mcp-concurrency-load-test.md.
#
# Env:
#   PRECIS_EMBEDDER_INTERACTIVE_MAX_CONCURRENCY   the interactive embed budget
#   PRECIS_MCP_TOOL_CONCURRENCY                   tool-dispatch semaphore
#       (default 4 permits process-wide). Passed through so a control run
#       can raise it and tell the deliberate cap apart from a resource wall.
#   PRECIS_COMPOSE                                override the compose file
#   PRECIS_LOADTEST_PTRACE=1                      add CAP_SYS_PTRACE and a
#       stable container name so py-spy can attach to `precis serve` mid-run:
#         docker exec -u root mcp-lt-<project> uvx py-spy record \
#           --pid "$(docker exec mcp-lt-<project> pgrep -f 'cli.main serve')" …
#       (the container runs uid 501 under yama=1, so a same-uid sibling can't
#       trace; root exec inherits the bounding set). Attach-only profiling —
#       py-spy record's own output window covers the ramp step it samples.
#
# DEV DB ONLY. By default it creates and migrates its own `precis_loadtest`
# database on the dev Postgres, so a run cannot disturb the test DB a sibling
# gate is using, and never touches prod. `--db NAME` instead targets a
# prepared database on the same dev Postgres — `precis_dev` after
# `scripts/dev seed-prod-shaped` — so the ramp measures a prod-shaped corpus
# rather than an empty schema.
#
# Output lands in scripts/mcp_loadtest/out/<stamp>-report.md (plus raw JSON
# and the server log, which is where a crashed server explains itself).
set -euo pipefail

cd "$(dirname "$0")/.."
WORKTREE="$PWD"

DB="precis_loadtest"
ARGS=()
while (($#)); do
    case "$1" in
        --smoke)
            ARGS+=(--ramp 1,2 --duration 5)
            ;;
        --db)
            DB="${2:?--db needs a database name}"
            ARGS+=(--require-seeded)
            shift
            ;;
        --db=*)
            DB="${1#--db=}"
            ARGS+=(--require-seeded)
            ;;
        *)
            ARGS+=("$1")
            ;;
    esac
    shift
done

# The name interpolates into the DSN and a CREATE DATABASE below.
[[ "${DB}" =~ ^[a-zA-Z_][a-zA-Z0-9_]*$ ]] || {
    echo "ERR: --db '${DB}' is not a safe database name" >&2
    exit 1
}

INFRA_COMPOSE="${PRECIS_COMPOSE:-${PWD}/docker/dev/compose.yaml}"
[[ -f "$INFRA_COMPOSE" ]] || {
    echo "ERR: compose file not found at ${INFRA_COMPOSE} (set PRECIS_COMPOSE)" >&2
    exit 1
}

source "${WORKTREE}/scripts/lib/compose-project.sh"
COMPOSE_PROJECT="$(compose_project_for "$WORKTREE")"
compose() {
    env UID="$(id -u)" GID="$(id -g)" \
        docker compose -f "$INFRA_COMPOSE" -p "$COMPOSE_PROJECT" --profile dev "$@"
}

echo "▶ bringing up the dev Postgres"
compose up -d --wait precis-test-db >/dev/null

DSN="postgresql://postgres@precis-test-db:5432/${DB}"
ADMIN="postgresql://postgres@precis-test-db:5432/postgres"

# One BLAS thread per process, same reasoning as scripts/test: an uncapped
# torch pool on a many-core container turns the embedder into the bottleneck
# and we would measure that instead of the MCP surface.
#
# It is also a confound, because it caps the one component that could
# otherwise use more than a core. Set PRECIS_LOADTEST_NO_THREAD_CAP=1 to
# run the control and confirm a ceiling is not an artefact of this.
THREAD_CAP=(
    -e OMP_NUM_THREADS=1 -e MKL_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1
    -e NUMEXPR_NUM_THREADS=1 -e VECLIB_MAXIMUM_THREADS=1
)
if [[ "${PRECIS_LOADTEST_NO_THREAD_CAP:-0}" == "1" ]]; then
    THREAD_CAP=()
    echo "▶ thread cap OFF (control run)"
fi

PTRACE_ARGS=()
if [[ "${PRECIS_LOADTEST_PTRACE:-0}" == "1" ]]; then
    PTRACE_ARGS=(--cap-add SYS_PTRACE --name "mcp-lt-${COMPOSE_PROJECT}")
fi

# Control-run knob: raise the tool-dispatch semaphore inside the container to
# tell the deliberate cap (default 4) apart from a resource wall.
TCAP_ENV=()
if [[ -n "${PRECIS_MCP_TOOL_CONCURRENCY:-}" ]]; then
    TCAP_ENV=(-e "PRECIS_MCP_TOOL_CONCURRENCY=${PRECIS_MCP_TOOL_CONCURRENCY}")
    echo "▶ tool-dispatch semaphore = ${PRECIS_MCP_TOOL_CONCURRENCY} (control run)"
fi

compose run --rm --no-deps ${PTRACE_ARGS[@]+"${PTRACE_ARGS[@]}"} -v "${WORKTREE}":/app \
    ${THREAD_CAP[@]+"${THREAD_CAP[@]}"} \
    ${TCAP_ENV[@]+"${TCAP_ENV[@]}"} \
    -e "PRECIS_DATABASE_URL=${DSN}" \
    -e "LOADTEST_DB=${DB}" \
    precis-dev bash -lc '
set -euo pipefail
uv run --no-sync python - <<PY
import os
import psycopg
from psycopg import sql
db = os.environ["LOADTEST_DB"]
with psycopg.connect("'"${ADMIN}"'", autocommit=True) as c, c.cursor() as cur:
    cur.execute("SELECT 1 FROM pg_database WHERE datname = %s", (db,))
    if not cur.fetchone():
        cur.execute(sql.SQL("CREATE DATABASE {}").format(sql.Identifier(db)))
        print(f"created {db}")
    else:
        print(f"reusing {db}")
PY
echo "▶ applying migrations"
uv run --no-sync precis migrate >/dev/null
echo "▶ ramping"
uv run --no-sync python scripts/mcp_loadtest/harness.py "$@"
' _ "${ARGS[@]}"

#!/usr/bin/env bash
# scripts/search-floor-calibrate — compare fixed semantic-only floors and
# query-relative gap cuts (gr514956, gr548264). READ-ONLY: every statement
# is a SELECT; it reports measurements, never changes search settings.
#
# Usage:
#   scripts/_prod-run scripts/search-floor-calibrate    # against PROD
#   scripts/search-floor-calibrate                      # dev DB, all kinds
#   scripts/search-floor-calibrate --kind paper --sample 40
#   scripts/search-floor-calibrate --help               # all flags
#
# Database: PRECIS_DATABASE_URL (dev DB by default; scripts/_prod-run
# exports prod's). Never a literal in the repo.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run python scripts/_search_floor_calibrate.py "$@"

#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/select-tests — the checked-gate test selection (gr485791).

One place decides which tests a diff must run for the middle landing mode
(`scripts/ship --checked`, `scripts/test --selected`): cheap enough for a
burst of worktrees, wider than `--quick`'s lint-only pass. Three sources:

- CONTRACT — the fast repo-invariant tests that always run: the audited
  tables and closed sets, the ratchets, the doc/secret/vocab scans. They
  assert over the whole tree, so a data or config change can red them with
  no import edge at all.
- PATH_MAP — explicit (glob -> pytest targets) for couplings the static
  scans cannot see: handler mode/arg vocab vs the audited parity table,
  reviewed-blob pins, migrations.
- corpus refs — every test (and src module) is scanned for repo paths it
  reads: string literals, `Path(__file__)`-anchored joins,
  `importlib.resources.files("<pkg>")`, dir enumerations. A changed path
  selects every test whose refs cover it, plus the direct test importers
  of src modules whose refs cover it (that's how `_list_skills()`-style
  enumeration of `src/precis/data/skills` reaches tests that name no
  literal). `tests/test_select_tests.py` enforces this: every detected
  corpus-coupled test must be selectable, and every map entry non-stale.

Python changes add, on top: `pytest --testmon` when the worktree has a
.testmondata map (the precise path), else the tests that *directly* import
the changed modules (a static ast scan — transitive reachability is one
component of ~all tests, measured). A changed test file always selects
itself. Never falls back to the full suite.

Output protocol (stdout): line 1 `testmon=0|1`, then one pytest target
(file or file::node) per line — the "static" half that always runs. With
testmon=1 the caller should additionally run `pytest --testmon` (which
does its own affected-test selection over the suite).

Usage:
  scripts/select-tests                 # worktree diff: merge-base..HEAD + dirty files
  scripts/select-tests --files a b c   # explicit changed paths (repo-relative)
  scripts/select-tests --stdin         # changed paths on stdin, one per line
  scripts/select-tests --list-contract # print the CONTRACT + PATH_MAP tables
"""

from __future__ import annotations

import ast
import fnmatch
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent

# ── CONTRACT: repo-wide invariants, always selected ──────────────────────
# The pre-qland hygiene set + the --impacted unconditional set + the audited
# tables. Keep it to things that take seconds; anything heavy belongs in the
# map or the import scan instead.
CONTRACT: list[str] = [
    # qland hygiene: doc pointers, skill prose, the public-tree secret scan,
    # vocabulary lint — every one of these has reddened main from a lint-only
    # land before (gr458977, the 2026-10-03 cluster).
    "tests/test_doc_pointers.py",
    "tests/test_skill_prose.py",
    "tests/test_deploy_tree_no_secrets.py",
    "tests/test_vocab_lint.py",
    # code hygiene: ratchets and text-walk guards
    "tests/test_type_ignore_ratchet.py",
    "tests/test_posix_only_guards.py",
    "tests/test_text_io_encoding.py",
    "tests/test_extra_only_import_guards.py",
    "tests/test_store_mixin_guard.py",
    "tests/test_utc_time_convention.py",
    "tests/test_skill_ingest.py::test_shipped_skill_corpus_has_zero_gate_findings",
    # schema/migration invariants (testmon has no edge to them — glob-driven)
    "tests/test_migration_numbering.py",
    "tests/test_schema_baseline.py",
    "tests/test_schema_design.py",
    # cross-cutting wire-shape guards (gr277298 — a mid-red map drops the edge)
    "tests/test_token_budget.py",
    "tests/test_mcp_verb_kwarg_parity.py",
    # audited per-kind mode table + closed skill-family set
    "tests/test_mode_spec_parity.py",
    "tests/test_skill_refs.py::test_families_are_a_closed_set_with_real_groups",
]

# ── PATH_MAP: explicit couplings the corpus scanner cannot see ───────────
# (glob, [pytest targets]). A changed path selects the union of targets of
# every pattern covering it. Literal couplings (a test that reads the file)
# are detected by the corpus scan and do NOT need entries here — this table
# is for *semantic* couplings only. Every pattern must match ≥1 live repo
# path and every target must exist (tests/test_select_tests.py enforces).
PATH_MAP: list[tuple[str, list[str]]] = [
    # Handler mode/arg vocab: the audited parity table asserts what handlers
    # declare vs. what they actually branch on — a memory edit-mode added in
    # handlers/memory.py broke test_mode_spec_parity in r35. Semantic
    # coupling, not an import or literal edge.
    (
        "src/precis/handlers/*.py",
        [
            "tests/test_mode_spec_parity.py",
            "tests/test_mcp_verb_kwarg_parity.py",
        ],
    ),
    # Reviewed-blob pins: the mirror acceptance test pins git blob shas of
    # these files (MIRROR_BLOBS) — an edit reds it. The literal is detected
    # by the corpus scan too; listed so the coupling survives a literal-free
    # refactor of the test.
    ("src/precis/utils/text.py", ["tests/test_memory_mirror_acceptance.py"]),
    ("src/precis/cli/memory.py", ["tests/test_memory_mirror_acceptance.py"]),
    ("src/precis/cli/memory_mirror.py", ["tests/test_memory_mirror_acceptance.py"]),
    # New SQL migrations: the qgo guard + ship tests scan migrations dirs by
    # name convention, and numbering/baseline/design are CONTRACT already.
    (
        "**/migrations/**",
        [
            "tests/test_qgo_guard.py",
            "tests/test_secret_hint_migration.py",
        ],
    ),
    # Skill corpus: the family closed set + registry/ingest assertions are
    # largely _list_skills()-mediated (importlib.resources, no literal in the
    # test). The corpus scan picks that up via the handler module's
    # resources.files() ref; the entry keeps the coupling independent of it.
    (
        "src/precis/data/skills/**",
        [
            "tests/test_skill.py",
            "tests/test_skill_refs.py",
            "tests/test_skill_ingest.py",
            "tests/test_skill_plugin_group.py",
        ],
    ),
    # hexfold examples: the snapshot tables enumerate hexfold/examples/*.hx.
    # A .hx added anywhere is corpus, not just under examples/.
    (
        "**/*.hx",
        [
            "tests/hexfold/test_seam.py",
            "tests/hexfold/test_rebuild_idempotent.py",
        ],
    ),
]

# Repo prefixes that are never corpus coupling (git internals are not
# committable input).
_IGNORED_REF_PREFIXES = (".git",)


# ── module/import machinery ──────────────────────────────────────────────


def _module_name(rel: str) -> str | None:
    """Repo-relative path -> importable module name, or None."""
    if not rel.endswith(".py"):
        return None
    parts = rel.split("/")
    if parts[0] == "src":
        mod = ".".join(parts[1:])[:-3]
    elif parts[0] == "tests":
        mod = ".".join(parts)[:-3]
    else:
        return None
    if mod.endswith(".__init__"):
        mod = mod[: -len(".__init__")]
    return mod or None


def _imports(path: Path) -> set[str]:
    """Module names a file imports (static ast scan; both `import a.b` and
    `from a import b` forms — the latter also emits `a.b` unconditionally:
    it is either a submodule or a name; matching against `affected` decides.
    Unfiltered on purpose — a *deleted* module's name must still match so its
    importers get selected."""
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError):
        return set()
    out: set[str] = set()
    for node in ast.walk(tree):
        if isinstance(node, ast.Import):
            out.update(a.name for a in node.names)
        elif isinstance(node, ast.ImportFrom) and node.module:
            out.add(node.module)
            out.update(f"{node.module}.{a.name}" for a in node.names)
    return out


# ── corpus-ref scanner ───────────────────────────────────────────────────
# Statically resolve the repo paths a file reads: string literals,
# Path(__file__)-anchored joins, and importlib.resources.files("<pkg>")
# (which is how src reaches src/precis/data/* — dotted package names, not
# path literals). A ref is the longest existing repo prefix of whatever the
# expression resolves to. Best-effort by design: dynamic paths resolve to an
# ancestor dir or are dropped; the checker test asserts every detected ref
# is covered, so coverage can tighten but never silently escapes.


def _eval_path(
    node: ast.AST, consts: dict[str, Path], file: Path, repo: Path
) -> Path | str | None:
    if isinstance(node, ast.Constant) and isinstance(node.value, str):
        return node.value
    if isinstance(node, ast.Name):
        return consts.get(node.id)
    if isinstance(node, ast.BinOp) and isinstance(node.op, ast.Div):
        base = _eval_path(node.left, consts, file, repo)
        part = _eval_path(node.right, consts, file, repo)
        if isinstance(base, Path) and isinstance(part, str):
            return base / part
        return None
    if isinstance(node, ast.JoinedStr):
        parts = [v.value for v in node.values if isinstance(v, ast.Constant)]
        return "".join(parts) or None
    if isinstance(node, ast.Attribute):
        if node.attr == "parent":
            base = _eval_path(node.value, consts, file, repo)
            return base.parent if isinstance(base, Path) else None
        return None
    if (
        isinstance(node, ast.Subscript)
        and isinstance(node.slice, ast.Constant)
        and isinstance(node.slice.value, int)
        and isinstance(node.value, ast.Attribute)
        and node.value.attr == "parents"
    ):
        v = _eval_path(node.value.value, consts, file, repo)
        if isinstance(v, Path):
            for _ in range(node.slice.value + 1):
                v = v.parent
            return v
        return None
    if isinstance(node, ast.Call):
        fn = node.func
        name = (
            fn.id
            if isinstance(fn, ast.Name)
            else fn.attr
            if isinstance(fn, ast.Attribute)
            else None
        )
        if name == "Path" and node.args:
            if (
                isinstance(node.args[0], ast.Name)
                and node.args[0].id == "__file__"
            ):
                return file
            v = _eval_path(node.args[0], consts, file, repo)
            return Path(v) if isinstance(v, str) else v
        if name == "str" and node.args:
            return _eval_path(node.args[0], consts, file, repo)
        if name in ("resolve", "joinpath") and isinstance(fn, ast.Attribute):
            base = _eval_path(fn.value, consts, file, repo)
            if not isinstance(base, Path):
                return None
            if name == "resolve":
                return base.resolve()
            part = _eval_path(node.args[0], consts, file, repo) if node.args else None
            return base / part if isinstance(part, str) else None
        # importlib.resources.files("precis.data.skills") -> src/precis/data/skills
        if name == "files" and node.args:
            recv = fn.value if isinstance(fn, ast.Attribute) else None
            dotted = ""
            while isinstance(recv, ast.Attribute):
                dotted = "." + recv.attr + dotted
                recv = recv.value
            if isinstance(recv, ast.Name):
                dotted = recv.id + dotted
            if dotted in ("resources", "importlib.resources"):
                v = _eval_path(node.args[0], consts, file, repo)
                if isinstance(v, str):
                    return repo / "src" / Path(*v.split("."))
        return None
    return None


def corpus_refs(path: Path, repo: Path = REPO) -> set[str]:
    """Repo-relative paths (existing files or dirs) a py file reads — its
    data corpus. Anything outside the repo or unresolvable to an existing
    prefix is dropped."""
    try:
        tree = ast.parse(path.read_text(encoding="utf-8"))
    except (OSError, SyntaxError, ValueError):
        return set()
    consts: dict[str, Path] = {}
    for _ in range(2):  # constant order doesn't matter
        for stmt in tree.body:
            if (
                isinstance(stmt, ast.Assign)
                and len(stmt.targets) == 1
                and isinstance(stmt.targets[0], ast.Name)
            ):
                v = _eval_path(stmt.value, consts, path, repo)
                if isinstance(v, Path):
                    consts[stmt.targets[0].id] = v
    refs: set[str] = set()
    for node in ast.walk(tree):
        v = _eval_path(node, consts, path, repo)
        cand: Path | None = None
        if isinstance(v, Path):
            cand = v if v.is_absolute() else repo / v
        elif (
            isinstance(v, str)
            and "/" in v
            and "\n" not in v
            and len(v) < 200
            and not v.startswith(("http", "{", "*", " "))
        ):
            cand = repo / v
        if cand is None:
            continue
        try:
            while not cand.exists() and cand != cand.parent:
                cand = cand.parent
            exists = cand.exists()
        except OSError:
            continue
        if not exists:
            continue
        try:
            rel = str(cand.relative_to(repo))
        except ValueError:
            continue
        if rel in (".", "") or rel.startswith(_IGNORED_REF_PREFIXES):
            continue
        refs.add(rel)
    return refs


def _covers(ref: str, changed: str) -> bool:
    """Whether corpus ref `ref` is affected by changed path `changed` — the
    ref itself changed, or the change is a file under a ref dir."""
    return changed == ref or changed.startswith(ref + "/")


def _pattern_covers(pattern: str, path: str) -> bool:
    if fnmatch.fnmatch(path, pattern):
        return True
    # a changed dir itself ("src/precis/data/skills") matches "**"-patterns
    # anchored above it even though fnmatch needs a file under it
    return fnmatch.fnmatch(path + "/x", pattern)


def map_targets(changed: str) -> set[str]:
    out: set[str] = set()
    for pat, targets in PATH_MAP:
        if _pattern_covers(pat, changed):
            out.update(targets)
    return out


# ── changed-file discovery ───────────────────────────────────────────────


def default_changed(repo: Path = REPO) -> list[str]:
    """The selection-relevant diff: branch commits vs origin/main (or main)
    plus working-tree dirty/untracked files."""
    base = "origin/main"
    chk = subprocess.run(
        ["git", "rev-parse", "--verify", "-q", "origin/main"],
        cwd=repo,
        capture_output=True,
    )
    if chk.returncode != 0:
        base = "main"
    mb = subprocess.run(
        ["git", "merge-base", base, "HEAD"],
        cwd=repo,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.strip()
    out = subprocess.run(
        ["git", "diff", "--name-only", mb, "HEAD"],
        cwd=repo,
        capture_output=True,
        text=True,
        check=True,
    ).stdout.split()
    dirty = subprocess.run(
        ["git", "status", "--porcelain=v1", "-z", "--untracked-files=normal"],
        cwd=repo,
        capture_output=True,
        text=True,
        check=True,
    ).stdout
    for rec in dirty.split("\0"):
        if not rec:
            continue
        name = rec[3:]
        if " -> " in name:
            name = name.split(" -> ", 1)[1]
        out.append(name.strip('"'))
    return sorted(set(out))


# ── selection ────────────────────────────────────────────────────────────


class Selector:
    """Precomputed maps so the checker test (and a batch of `select` calls)
    doesn't rescan the tree per query."""

    def __init__(self, repo: Path = REPO):
        self.repo = repo
        self.mod2file: dict[str, Path] = {}
        for root in ("src", "tests"):
            for p in (repo / root).rglob("*.py"):
                m = _module_name(str(p.relative_to(repo)))
                if m:
                    self.mod2file[m] = p
        self._corpus_built = False
        self.src_refs: dict[str, set[str]] = {}
        self.test_refs: dict[Path, set[str]] = {}
        self.test_imports: dict[Path, set[str]] = {}

    def build_corpus(self) -> None:
        if self._corpus_built:
            return
        self._corpus_built = True
        for mod, p in self.mod2file.items():
            refs = corpus_refs(p, self.repo)
            if mod.startswith("tests."):
                if refs:
                    self.test_refs[p] = refs
            elif refs:
                self.src_refs[mod] = refs

    def build_imports(self) -> None:
        if self.test_imports:
            return
        for mod, p in self.mod2file.items():
            if mod.startswith("tests."):
                self.test_imports[p] = _imports(p)

    def select(self, changed: list[str]) -> tuple[list[str], bool]:
        """-> (pytest targets, run_testmon)."""
        targets = set(CONTRACT)
        affected: set[str] = set()  # changed or corpus-coupled modules
        # Always build the corpus map when anything changed: a .py file can
        # be a *literal* pin in a test (safe_fetch.py in the qgo guard) as
        # well as a module, and literal pins only show up here.
        needs_corpus = bool(changed)
        if needs_corpus:
            self.build_corpus()
        for f in changed:
            targets.update(map_targets(f))
            m = _module_name(f)
            if m:
                # deleted module: not in mod2file anymore, but still affected —
                # its former importers break at import time
                affected.add(m)
                if m in self.mod2file and m.startswith("tests."):
                    targets.add(str(self.mod2file[m].relative_to(self.repo)))
            if needs_corpus:
                for t, refs in self.test_refs.items():
                    if any(_covers(r, f) for r in refs):
                        targets.add(str(t.relative_to(self.repo)))
                # A src module's corpus reads only matter for data changes:
                # for .py changes the import scan already covers the changed
                # module itself — letting a reader module go "affected" here
                # would fan a leaf edit out to every importer of e.g.
                # dispatch (which enumerates handlers/ as data).
                if m not in self.mod2file:
                    for mod, refs in self.src_refs.items():
                        if any(_covers(r, f) for r in refs):
                            affected.add(mod)

        testmon = bool(affected) and (self.repo / ".testmondata").exists()
        if affected and not testmon:
            # No map: tests that directly import an affected module (or a
            # descendant module when the changed file is a package __init__).
            self.build_imports()
            for p, imps in self.test_imports.items():
                if any(i == a or i.startswith(a + ".") for a in affected for i in imps):
                    targets.add(str(p.relative_to(self.repo)))
        return sorted(targets), testmon


def select(changed: list[str], repo: Path = REPO) -> tuple[list[str], bool]:
    return Selector(repo).select(
        [f.lstrip("./") if f.startswith("./") else f for f in changed]
    )


def main(argv: list[str]) -> int:
    args = list(argv)
    if "--list-contract" in args:
        print("# CONTRACT")
        for t in CONTRACT:
            print(t)
        print("\n# PATH_MAP")
        for pat, targets in PATH_MAP:
            print(pat)
            for t in targets:
                print(f"    {t}")
        return 0
    files: list[str] | None = None
    if "--stdin" in args:
        files = [ln.strip() for ln in sys.stdin.read().splitlines() if ln.strip()]
    elif "--files" in args:
        files = args[args.index("--files") + 1 :]
    if files is None:
        files = default_changed()
    files = [f[2:] if f.startswith("./") else f for f in files]
    targets, testmon = Selector().select(files)
    print(f"testmon={int(testmon)}")
    for t in targets:
        print(t)
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))

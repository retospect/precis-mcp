#!/usr/bin/env bash
# scripts/surface-review — advisory 14-day cadence nudge for the MCP
# surface review. Mirrors token-review / skill-search-review / db-thrash-review:
# it does NOT do the review (that's a judgment session — see the runbook), it
# only tells you WHEN one is due. Surfaced in `/whatneedsdoing`; always exits 0.
#
# The review mines recent agent sessions (local .jsonl + the prod tool_calls
# ledger + llm_call_log) for where the precis MCP surface confused an agent,
# cost more tokens than it should, or was missing a capability — then turns
# findings into evidence on an existing backlog item, or a gripe. The
# extraction is code (`scripts/mine-sessions/`); the judging is the pass.
# Procedure:
#   docs/runbooks/surface-review.md
# The clock is ~/.cache/precis/surface-review.log, written by
#   scripts/surface-review --stamp "<note>"     (see scripts/cadence-lib.sh)
#
# Remit boundary, so the three transcript passes don't collide:
#   surface-review      the precis MCP surface (verbs, errors, renders, vocab)
#   token-review        harness/agent behaviour (delegation tier, rtk, bloat)
#   skill-search-review skill discovery ranking
set -euo pipefail
cd "$(dirname "$0")/.."
source scripts/cadence-lib.sh

cadence_init surface-review 14 docs/runbooks/surface-review.md "$@"

cadence_check pass "run /surface-review: mine the window, judge the cards, attach evidence to existing items or file a gripe" || true
exit 0

#!/usr/bin/env bash
# scripts/dev — run a command inside the precis-dev container.
#
# Host has Git + Docker + the IDE. Every other dev tool (pytest, ruff,
# mypy, uv, plantuml, psql, …) lives inside the precis-dev container.
# This wrapper is the standard way to invoke them.
#
# Usage:
#   scripts/dev                         # interactive bash shell
#   scripts/dev pytest tests/           # run a single tool
#   scripts/dev uv run ruff check .     # uv-driven invocation
#   scripts/dev bash -lc 'ruff && mypy && pytest'   # compound check
#   scripts/dev db-up                   # start precis-test-db, create+migrate precis_dev
#   scripts/dev seed-prod-shaped        # anonymized prod slice -> precis_dev
#
# The container bind-mounts this repo at /app, so file edits on the host
# are visible inside the container immediately (no rebuild needed).
#
# Env crossing the boundary: PRECIS_DATABASE_URL defaults to this
# worktree's dev DB (precis_dev on precis-test-db, gr514999) so
# `scripts/dev uv run precis …` works after `db-up`; an explicit host
# value wins and is named on stderr. PRECIS_DEV_ENV="NAME=value …"
# forwards other host vars, mirroring scripts/test's PRECIS_TEST_ENV
# (gr513868); an exported NANO_*/ESP32C3_*/PRECIS_PCB_* var that is not
# forwarded is named once on stderr.
#
# See: docs/decisions/0009-dockerfile-relocation-container-first.md
set -euo pipefail

cd "$(dirname "$0")/.."
WORKTREE="$PWD"

INFRA_COMPOSE="${PRECIS_COMPOSE:-${PWD}/docker/dev/compose.yaml}"
if [[ ! -f "${INFRA_COMPOSE}" ]]; then
    echo "ERR: compose file not found at ${INFRA_COMPOSE}" >&2
    echo "     set PRECIS_COMPOSE=/path/to/compose.yaml to override" >&2
    exit 1
fi

# Per-worktree compose project so this worktree's one-off run doesn't collide
# with every sibling's on the default project name `dev` (gr176375's fix for
# scripts/test/scripts/ship, extended here — gr311857). See
# scripts/lib/compose-project.sh.
source "${WORKTREE}/scripts/lib/compose-project.sh"
COMPOSE_PROJECT="$(compose_project_for "$WORKTREE")"

# scripts/dev db-up — start this worktree's dev Postgres (`precis-test-db`),
# create `precis_dev` when missing and bring it to the packaged schema.
# Idempotent and prod-free — the empty-DB path for write-path testing;
# `seed-prod-shaped` fills the same DSN when a bug needs real data shapes
# (gr513761).
if [[ "${1:-}" == "db-up" ]]; then
    DEV_DSN="postgresql://postgres@precis-test-db:5432/precis_dev"
    docker compose -f "${INFRA_COMPOSE}" -p "${COMPOSE_PROJECT}" --profile dev \
        up -d --wait precis-test-db >/dev/null
    docker compose -f "${INFRA_COMPOSE}" -p "${COMPOSE_PROJECT}" --profile dev \
        run --rm --no-deps -v "${WORKTREE}":/app precis-dev \
        uv run --no-sync python scripts/_seed_prod_shaped.py ensure --dsn "$DEV_DSN"
    echo "dev DB ready: scripts/dev exports PRECIS_DATABASE_URL=${DEV_DSN} by default — e.g. scripts/dev uv run --no-sync precis …"
    exit 0
fi

# scripts/dev seed-prod-shaped [--per-kind N] — fill the dev DB (`precis_dev`
# on this worktree's precis-test-db) with an anonymized prod slice. The
# extract runs on the host (it needs scripts/prod-psql --ro, read-only on
# prod) and writes only the anonymized slice to .scratch/dev-seed/; the load
# runs in the container. Re-running replaces the slice. See
# scripts/_seed_prod_shaped.py and docs/setup-single-machine.md.
if [[ "${1:-}" == "seed-prod-shaped" ]]; then
    shift
    SLICE=".scratch/dev-seed/slice.jsonl"
    DEV_DSN="postgresql://postgres@precis-test-db:5432/precis_dev"
    uv run --frozen python scripts/_seed_prod_shaped.py extract --out "$SLICE" "$@"
    docker compose -f "${INFRA_COMPOSE}" -p "${COMPOSE_PROJECT}" --profile dev \
        up -d --wait precis-test-db >/dev/null
    docker compose -f "${INFRA_COMPOSE}" -p "${COMPOSE_PROJECT}" --profile dev \
        run --rm --no-deps -v "${WORKTREE}":/app precis-dev \
        uv run --no-sync python scripts/_seed_prod_shaped.py load --slice "$SLICE" --dsn "$DEV_DSN"
    echo "dev DB ready: scripts/dev exports PRECIS_DATABASE_URL=${DEV_DSN} by default — e.g. scripts/dev uv run --no-sync precis …"
    exit 0
fi

# Env that crosses the container boundary has to be named — a host export
# silently stops at `compose run` (gr513868's NANO_SEEDS run). The dev DSN
# is deterministic per worktree (one precis-test-db service per compose
# project), so PRECIS_DATABASE_URL defaults to precis_dev: `scripts/dev uv
# run precis …` then finds the dev DB the way tests find precis_test
# (gr514999). An explicit host value wins — forwarding it is the caller's
# choice, so name the override on stderr rather than silently replacing
# the dev default.
DEV_DB_DSN="postgresql://postgres@precis-test-db:5432/precis_dev"
if [[ -n "${PRECIS_DATABASE_URL:-}" && "${PRECIS_DATABASE_URL}" != "${DEV_DB_DSN}" ]]; then
    echo "scripts/dev: forwarding host PRECIS_DATABASE_URL; the dev default would be ${DEV_DB_DSN}" >&2
fi
DEV_ENV=(-e "PRECIS_DATABASE_URL=${PRECIS_DATABASE_URL:-${DEV_DB_DSN}}")
_FORWARDED_ENV=" PRECIS_DATABASE_URL"

# PRECIS_DEV_ENV="NAME=value …" — the opt-in for anything else, same rules
# as scripts/test's PRECIS_TEST_ENV: names match ^[A-Z][A-Z0-9_]*$, may not
# shadow container/runtime internals, values carry no whitespace.
for _kv in ${PRECIS_DEV_ENV:-}; do
    _env_name="${_kv%%=*}"
    if [[ "$_kv" != *=* || ! "$_env_name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
        echo "ERR: PRECIS_DEV_ENV entry '${_kv}' is not NAME=value (name must match ^[A-Z][A-Z0-9_]*$)" >&2
        exit 1
    fi
    case "$_env_name" in
        PATH|HOME|PYTHON*|DATABASE*|PG*)
            echo "ERR: PRECIS_DEV_ENV may not forward ${_env_name} (container/runtime internal)" >&2
            exit 1
            ;;
    esac
    DEV_ENV+=(-e "$_kv")
    _FORWARDED_ENV="$_FORWARDED_ENV $_env_name"
done

# A tuning variable exported on the host but not forwarded reads as "set"
# to the author and is silently absent inside the container — name it
# once on stderr so the run isn't wasted guessing why it was ignored.
while IFS= read -r _host_var; do
    case "$_host_var" in
        NANO_*|ESP32C3_*|PRECIS_PCB_*)
            case " $_FORWARDED_ENV " in
                *" $_host_var "*) ;;
                *)
                    printf 'scripts/dev: %s is set but not forwarded into the container; use PRECIS_DEV_ENV="%s=%s"\n' \
                        "$_host_var" "$_host_var" "${!_host_var:-}" >&2
                    ;;
            esac
            ;;
    esac
done < <(compgen -e)

# `--no-deps` skips bringing up any depends_on services. precis-dev has
# none right now, but make it explicit so we never accidentally spin up
# heavier siblings (acatome-watch, corpus-server).
exec docker compose -f "${INFRA_COMPOSE}" -p "${COMPOSE_PROJECT}" --profile dev run --rm --no-deps "${DEV_ENV[@]}" -v "${WORKTREE}":/app precis-dev "$@"

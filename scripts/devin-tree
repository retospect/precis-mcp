#!/usr/bin/env bash
# Launch Devin CLI in its own task worktree (here, or in a tmux window).
#
#   scripts/devin-tree NAME [--purpose TEXT] [--prompt-file FILE]
#                           [--model ID] [--permission-mode MODE]
#                           [--tmux [SESSION]] [--dry-run]
#
# Mirrors `claude -w NAME` and scripts/kimi-tree: worktree
# .claude/worktrees/NAME on branch worktree-NAME, cut from origin/main (an
# existing tree/branch is reused, never reset). The tree is locked `pid <N>`
# to the Devin process, which is what scripts/inflight and the reaper read as
# liveness; when Devin exits the lock goes dead and a merged+clean tree
# auto-reaps like any Claude tree.
# By default Devin takes over this terminal. --tmux opens window devin-NAME in
# SESSION (default: the current tmux session) instead; --session SESSION is
# the old spelling of --tmux SESSION (scripts/fleet-wave passes --tmux).
# `ln -s <main checkout>/scripts/devin-tree ~/.local/bin/devin-wt` gives the
# same entry point as kimi-wt.
# --purpose writes .claude/purpose (the inflight table's PURPOSE column).
# Before launch the repo's .claude/worktrees directory is added to Devin's
# trusted_workspaces.json (scripts/lib/devin_trust.py; Devin trusts
# subfolders of a listed parent, so one entry covers every tree) — without
# it Devin stops at the directory-trust prompt. DEVIN_TRUSTED_WORKSPACES
# points the write at a different file (tests).
# --model takes an id from `devin models list` (default: Devin's own, SWE-2
# High; all SWE-2 tiers are free). --permission-mode defaults to `dangerous`
# (Devin's autonomous mode — Reto's "always bypass" ruling for builder
# waves, me499092 2026-10-12/19); pass `--permission-mode auto` for the old
# read-only-auto-approved behaviour. Under `auto` the first call to each MCP
# tool still asks — allow get/search/more for read-only work, never
# "all tools" unless the task writes to precis (the session MCP is PROD).
#
# Internal: `--exec TREE [DEVIN ARGS]` re-locks TREE to its own pid, then
# execs Devin under that same pid.
set -euo pipefail

at_label=devin
. "$(dirname "$(realpath "$0")")/lib/agent-tree.sh"
at_init
self=$(realpath "$0")

if [[ ${1:-} == --exec ]]; then
	tree=$2
	shift 2
	at_exec_relock "$tree"
	# tmux windows do not inherit the login PATH; the Devin CLI lives in ~/.local/bin.
	export PATH="$HOME/.local/bin:$PATH"
	# Read-only gits in the lane (and in the hooks Devin spawns) skip the
	# index refresh, so a killed status/diff leaves no stale index.lock
	# (gr541144). Commits/adds still take the locks they must.
	export GIT_OPTIONAL_LOCKS=0
	exec devin "$@"
fi

usage() { sed -n '4,6p' "$0" | sed 's/^# *//' >&2; exit 2; }
[[ $# -ge 1 && ${1:0:1} != - ]] || usage
name=$1
shift
at_check_name "$name"
purpose="" prompt_file="" model="" tmux_session="" use_tmux=0 dry_run=0 perm=dangerous
while [[ $# -gt 0 ]]; do
	case $1 in
	--purpose) purpose=$2; shift 2 ;;
	--prompt-file) prompt_file=$(realpath "$2"); shift 2 ;;
	--model) model=$2; shift 2 ;;
	--permission-mode) perm=$2; shift 2 ;;
	--tmux)
		use_tmux=1
		if [[ ${2:-} && ${2:0:1} != - ]]; then tmux_session=$2; shift; fi
		shift ;;
	--session) use_tmux=1; tmux_session=$2; shift 2 ;;
	--dry-run) dry_run=1; shift ;;
	*) usage ;;
	esac
done
((use_tmux)) && tmux_session=$(at_resolve_tmux "$tmux_session")
tree=$at_root/.claude/worktrees/$name
branch=worktree-$name
devin_args=(--permission-mode "$perm")
[[ -n $model ]] && devin_args+=(--model "$model")
[[ -n $prompt_file ]] && devin_args+=(--prompt-file "$prompt_file")

if ((dry_run)); then
	printf 'tree=%s branch=%s tmux=%s devin=%s\n' "$tree" "$branch" "${tmux_session:--}" \
		"devin ${devin_args[*]:-}"
	exit 0
fi

at_ensure_tree "$name" "$tree" "$branch" "$purpose"

# Trust failure must not abort the launch — Devin just asks at its prompt.
"$at_here/lib/devin_trust.py" "$at_root/.claude/worktrees" ||
	echo "devin-tree: trust step failed; Devin may ask to trust the directory" >&2

at_launch "$self" "$name" "$tree" "$use_tmux" "$tmux_session" "${devin_args[@]}"

#!/usr/bin/env bash
# scripts/inflight — a live table of every worktree + branch in flight on THIS machine.
#
# Everything here is DERIVED from git at call time (never a stored cache; the
# one exception is the trailing gripe line, see gripe_line), so it
# cannot drift: worktrees appear/vanish between ships and the table is still
# correct the instant you run it. The one thing git can't derive — what a
# random-codenamed worktree is actually *about* — is read from a per-worktree
# `.claude/purpose` one-liner (gitignored; self-cleaning, dies with the worktree).
#
# Speed shape (gr514898 — >10 s before output and a 140+ row wall of text on a
# fleet box): the old version ran ~8 git subprocesses per worktree, serially.
# Now the per-BRANCH facts that needed those calls come from ONE
# `git for-each-ref` pass (ahead/behind vs $BASE, tip date + subject,
# checked-out path), and the remaining per-tree work — one `git status`
# plus, only for branches ahead of $BASE, `git cherry`/`git merge-tree` —
# runs in parallel probe subshells that write one result file each. The
# parent only reads files afterwards, so its own git calls are O(1).
#
# Columns:
#   WORKTREE   basename ( * = the one you're in; "main" = the primary checkout )
#   SESSION    live#<pid>  — a Claude session holds the worktree lock and is alive
#              live-task#<id> — a Claude subagent task is active in this worktree
#              dead-lock#<pid> — locked by a pid that is gone (safe to reap)
#              —           — no lock
#   DIRTY      count of tracked-modified files (+N = untracked), or "clean"
#   VS-MAIN    merged        — tip is an ancestor of main (shipped & reset, or ff)
#              in-main↓B     — all commits already in main via squash; B behind
#              ↑U↓B          — U commits unique to the branch, B behind main
#   PURPOSE    .claude/purpose  →  else newest branch-unique commit subject
#              →  else "(editing <files>…)"  →  else "(no purpose set)"
#   LAST       relative date + subject of the worktree's HEAD commit
#
# The footer lists REMOVABLE candidates (merged + clean + no live session) — it
# only *reports* them; removal stays a deliberate, confirmed act (a locked live
# session, uncommitted WIP, or salvageable docs must never be auto-nuked).
#
# Usage:
#   scripts/inflight            # the table: this tree, then live/overlapping
#                               #   rows, then the quiet tail capped at
#                               #   INFLIGHT_MAX_ROWS (default 40) with a
#                               #   "+N more" line — every live/dirty/ahead row
#                               #   is always shown, the cap only hides the tail
#   scripts/inflight --all      # the uncapped table, porcelain order
#   scripts/inflight --for-hook # one counts line + pointer (gr499042); always exits 0
#                               # (wired as a SessionStart hook in .claude/settings.json).
#                               # Implies --skip-branch-probes (gr541365).
#   scripts/inflight --json     # structured form for /workspace-cleanup: each
#                               # worktree gets a `bucket` verdict —
#                               #   base            the primary branch, not a candidate
#                               #   self            the worktree you're calling from
#                               #   live_session    a claude session still holds the lock
#                               #   live_subagent   a subagent task is active in this worktree
#                               #   needs_judgment  dirty tree (capped diffstat), or a lock with no
#                               #                   parseable `pid <N>`, or an untracked agent tree
#                               #   safe_remove     clean + fully merged (ancestor or squash-absorbed)
#                               #   has_unmerged_work  real commits ahead of base, informational
#                               # plus a repo-wide stashCount (stash is one ref shared by every
#                               # worktree, so it's reported once, not per-row) and a per-row
#                               # `purpose` (the full, untruncated first purpose line — the
#                               # fixer's claim check reads it; the table shows it at 58).
#   --skip-branch-probes        # with --json or --for-hook: a branch checked out
#                               # nowhere pays no verdict calls (git cherry /
#                               # merge-tree / its purpose `git log -1`) — the free
#                               # ahead-behind pair decides: ahead=0 → `safe_remove`,
#                               # anything else → `stranded` (report-only, never
#                               # reaped). The for-hook reapers' mode; a squash-
#                               # landed branchless branch reads stranded until a
#                               # full run re-verifies it.
#
# Cache (gr541365): `--for-hook` and `--json --skip-branch-probes` — the shapes
# every SessionStart hook asks for — are served from ONE shared scan
# (scripts/lib/inflight_cache.py): scans serialize on a lock and the result is
# reused for INFLIGHT_CACHE_TTL seconds (default 45) by all sessions. The table,
# `--all` and a plain `--json` always scan live. Set INFLIGHT_NO_CACHE=1 for a
# live read of a hook shape (a destructive recheck should).
#
# Env: INFLIGHT_MAX_ROWS  default-table row cap (0/unset → 40)
#      INFLIGHT_JOBS      probe fan-out width (default 12, capped at the CPU count)
#      INFLIGHT_CACHE_TTL cache lifetime in seconds for the shapes above (default 45)
#      INFLIGHT_NO_CACHE  non-empty → never read or write the shared cache
#      INFLIGHT_NEUTRAL   non-empty → caller-neutral scan (no `*`/`self`); set by the cache helper
#
# See: CLAUDE.md / "Session workflow" (the .claude/purpose protocol).
set -uo pipefail

FOR_HOOK=0
JSON_MODE=0
SHOW_ALL=0
SKIP_BP=0
for arg in "$@"; do
  case "$arg" in
    --for-hook) FOR_HOOK=1 ;;
    --json)     JSON_MODE=1 ;;
    --all)      SHOW_ALL=1 ;;
    --skip-branch-probes) SKIP_BP=1 ;;
  esac
done
# --for-hook prints only counts, so the branchless-branch verdict work
# (git cherry / merge-tree / a `git log -1` per stranded pin) is wasted
# there — the for-hook reapers ask for the same skip on their --json runs.
[ "$FOR_HOOK" = 1 ] && SKIP_BP=1

# Not a git repo (or git absent) → say nothing, never block a session start.
command -v git >/dev/null 2>&1 || exit 0
git rev-parse --git-dir >/dev/null 2>&1 || exit 0

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

# Hook-mode shapes share ONE scan across every concurrent SessionStart
# (gr541365; scripts/lib/inflight_cache.py). The helper runs this script back
# with INFLIGHT_NO_CACHE=1 to scan, so it never recurses. A helper that fails
# falls through to the live scan below — a broken cache never costs an answer.
if [ -z "${INFLIGHT_NO_CACHE:-}" ] && [ "$SHOW_ALL" = 0 ] \
   && [ -f "$SCRIPT_DIR/lib/inflight_cache.py" ] && command -v python3 >/dev/null 2>&1; then
  if [ "$FOR_HOOK" = 1 ] && [ "$JSON_MODE" = 0 ]; then
    python3 "$SCRIPT_DIR/lib/inflight_cache.py" hook "$SCRIPT_DIR/inflight" && exit 0
  elif [ "$FOR_HOOK" = 0 ] && [ "$JSON_MODE" = 1 ] && [ "$SKIP_BP" = 1 ]; then
    python3 "$SCRIPT_DIR/lib/inflight_cache.py" json "$SCRIPT_DIR/inflight" && exit 0
  fi
fi

# Pick the primary branch: prefer main, fall back to master.
BASE=main
git show-ref --verify --quiet refs/heads/main || BASE=master

HERE=$(git rev-parse --show-toplevel 2>/dev/null || echo "")
# The PRIMARY (main) working tree is the first `git worktree list` entry.
# Identify it by POSITION, never by its branch: a primary drifted onto a
# feature branch is still the primary and must never be bucketed removable
# (git refuses to `worktree remove` it anyway, but the reaper/cleanup must not
# even try — and its dry-run must not list it).
PRIMARY=$(git worktree list --porcelain 2>/dev/null | awk 'NR == 1 {print $2}')
# The tree oid $BASE's squash_absorbed compares against — resolved once here
# instead of a `rev-parse` per unmerged branch.
BASE_TREE=$(git rev-parse "$BASE^{tree}" 2>/dev/null || echo "")
MAIN_ROOT="$(dirname "$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" 2>/dev/null)"
# The tree the caller stands in (marked `*`, bucketed `self`, never removable).
# A cacheable scan is taken caller-neutral (INFLIGHT_NEUTRAL=1): the cache is
# shared by every worktree, so lib/inflight_cache.py applies `self` on read.
SELF_PATH=$HERE
[ -n "${INFLIGHT_NEUTRAL:-}" ] && SELF_PATH=''

MAX_ROWS=${INFLIGHT_MAX_ROWS:-40}
case $MAX_ROWS in ''|*[!0-9]*) MAX_ROWS=40 ;; esac
PARALLEL=${INFLIGHT_JOBS:-12}
case $PARALLEL in ''|*[!0-9]*) PARALLEL=12 ;; esac
[ "$PARALLEL" -lt 1 ] && PARALLEL=1
# ... and never wider than the CPU count (gr541365): past it the extra probe
# subshells only queue on fork/exec — concurrent SessionStarts stacked to
# load 60+ on a 24-core box.
NCPU=$(getconf _NPROCESSORS_ONLN 2>/dev/null || sysctl -n hw.ncpu 2>/dev/null || echo 0)
case $NCPU in ''|*[!0-9]*) NCPU=0 ;; esac
if [ "$NCPU" -ge 1 ] && [ "$PARALLEL" -gt "$NCPU" ]; then PARALLEL=$NCPU; fi

# Live subagent-task markers, once for the whole table (gr513174: markers
# are per-TREE — a task in tree A must not mark tree B live). Each line is
# `agent_id<TAB>cwd<TAB>pid`; stale markers (old shape, dead pid, older than
# the helper's bound) are pruned by the helper itself on the way out.
TASK_IDS=() TASK_CWDS=() TASK_PIDS=()
if [ -f "$SCRIPT_DIR/hooks/subagent-task-state.py" ]; then
  while IFS=$'\t' read -r _tid _tcwd _tpid; do
    [ -z "$_tid" ] && continue
    TASK_IDS+=("$_tid"); TASK_CWDS+=("$_tcwd"); TASK_PIDS+=("$_tpid")
  done < <(python3 "$SCRIPT_DIR/hooks/subagent-task-state.py" list "$HERE" 2>/dev/null || true)
fi

# task_for <path> <lock-reason> — the marker matching check's scope: a task
# belongs to the worktree its session runs in, and to a tree that session's
# pid holds the `git worktree lock` on (a worktree-isolated agent child is
# locked "claude agent <id> (pid <parent-pid>)"). Prints the first match.
task_for() {
  local p=$1 locked=$2 lpid='' i
  [[ "$locked" =~ pid[[:space:]]+([0-9]+) ]] && lpid="${BASH_REMATCH[1]}"
  for i in "${!TASK_IDS[@]}"; do
    [ -z "${TASK_IDS[$i]:-}" ] && continue
    if [ "${TASK_CWDS[$i]:-}" = "$p" ]; then
      printf '%s' "${TASK_IDS[$i]}"; return
    fi
    if [ -n "$lpid" ] && [ "${TASK_PIDS[$i]:-}" = "$lpid" ]; then
      printf '%s' "${TASK_IDS[$i]}"; return
    fi
  done
}

trunc() { # trunc <string> <max>
  local s=$1 n=$2
  if [ "${#s}" -gt "$n" ]; then printf '%s…' "${s:0:$((n-1))}"; else printf '%s' "$s"; fi
}

pid_alive() { # pid_alive <pid> — exists, whoever owns it. A bare `kill -0`
  # fails with EPERM on another user's live pid (deploys run as `deploy` too),
  # which would bucket that user's locked tree dead-lock → removable.
  local err
  err="$(export LC_ALL=C; kill -0 "$1" 2>&1)" && return 0
  [[ "$err" == *"not permitted"* ]]
}

session_field() { # session_field <locked-reason>
  local locked=$1 pid=""
  [[ "$locked" =~ pid[[:space:]]+([0-9]+) ]] && pid="${BASH_REMATCH[1]}"
  if [ -n "$pid" ]; then
    if pid_alive "$pid"; then printf 'live#%s' "$pid"; else printf 'dead-lock#%s' "$pid"; fi
  elif [ -n "$locked" ]; then printf 'locked'
  else printf '—'; fi
}

squash_absorbed() { # squash_absorbed <head> — true (0) when every change
  # <head> ever made is already present in $BASE's tree, even though `git
  # cherry`'s per-commit patch-id matching can't see it. That per-commit
  # matching is blind to a worktree with MULTIPLE local commits whose
  # cumulative diff was squash-merged as a single commit on $BASE: none of
  # the individual commits' patch-ids ever match the one squash commit, so
  # `git cherry` reports them unmerged forever (gr331378).
  #
  # `git merge-tree --write-tree $BASE <head>` performs that merge without
  # touching the index/worktree and prints the resulting tree oid as its
  # first line; if that tree is bit-for-bit identical to $BASE's own tree,
  # <head> contributes nothing beyond what $BASE already has — content
  # equality, not per-commit history. Requires git >= 2.38 (the
  # --write-tree mode); an older git errors on the flag, and any conflict
  # (exit 1) or hard error (exit 2) both fall through the same way — verdict
  # stays exactly what `git cherry` already decided, unchanged from before.
  local head=$1 merged_tree
  merged_tree=$(git merge-tree --write-tree "$BASE" "$head" 2>/dev/null) || return 1
  merged_tree=${merged_tree%%$'\n'*}   # a conflicted merge appends more sections after a blank line
  [ -n "$merged_tree" ] && [ -n "$BASE_TREE" ] && [ "$merged_tree" = "$BASE_TREE" ]
}

# --- batched branch facts --------------------------------------------------
# One for-each-ref pass replaces a merge-base + rev-list + log -1 per branch:
# %(ahead-behind:$BASE) gives the two counts the verdict prints (ahead=0 is
# exactly "tip is an ancestor of $BASE" = merged), %(committerdate:relative)
# + %(subject) are the LAST column, and %(worktreepath) powers the
# branchless-branch pass below — the same atom the old code already used.
# The ahead-behind atom needs git >= 2.41; when it is absent we leave
# AHEAD/BEHIND empty and verdict_compute falls back to the per-head calls.
HAVE_AB=1
REFDATA=$(
  git for-each-ref refs/heads \
    --format='%(refname:short)%09%(objectname)%09%(worktreepath)%09%(ahead-behind:'"$BASE"')%09%(committerdate:relative)%09%(subject)' \
    2>/dev/null
) || REFDATA=''
if [ -z "$REFDATA" ]; then
  HAVE_AB=0
  REFDATA=$(
    git for-each-ref refs/heads \
      --format='%(refname:short)%09%(objectname)%09%(worktreepath)%09%(committerdate:relative)%09%(subject)' \
      2>/dev/null
  ) || REFDATA=''
fi

# Parse into parallel arrays (bash 3.2 has no assoc arrays). Tab-splitting
# goes through parameter expansion, NOT `IFS=$'\t' read` — read treats tab
# as IFS whitespace and collapses the empty %(worktreepath) field of a
# branchless branch, shifting every later field. The subject is last, so a
# tab inside a commit subject stays inside BR_SUBJ.
BR_NAME=() BR_HEAD=() BR_WTPATH=() BR_AHEAD=() BR_BEHIND=() BR_REL=() BR_SUBJ=()
{
  while IFS= read -r _line; do
    [ -z "$_line" ] && continue
    _bn=${_line%%$'\t'*}; _r=${_line#*$'\t'}
    _bh=${_r%%$'\t'*};      _r=${_r#*$'\t'}
    _bw=${_r%%$'\t'*};      _r=${_r#*$'\t'}
    if [ "$HAVE_AB" = 1 ]; then
      _bab=${_r%%$'\t'*};   _r=${_r#*$'\t'}
    else
      _bab=' '
    fi
    _brel=${_r%%$'\t'*};    _bsubj=${_r#*$'\t'}
    BR_NAME+=("$_bn"); BR_HEAD+=("$_bh"); BR_WTPATH+=("$_bw")
    BR_AHEAD+=("${_bab%% *}"); BR_BEHIND+=("${_bab##* }")
    BR_REL+=("$_brel"); BR_SUBJ+=("$_bsubj")
  done <<< "$REFDATA"
}

# br_index <branch> — index into the BR_* arrays, empty when unknown.
br_index() {
  local b=$1 j
  for j in "${!BR_NAME[@]}"; do
    [ "${BR_NAME[$j]}" = "$b" ] && { printf '%s' "$j"; return; }
  done
}

# --- porcelain parse ---------------------------------------------------------
# Walk the porcelain records into parallel arrays first; probing happens in
# the fan-out below. A worktree record is `worktree <path>` / `HEAD <sha>` /
# `branch refs/heads/<b>` (or bare `detached`) / `locked <reason>`, blank-line
# separated.
WT_PATH=() WT_HEAD=() WT_BRANCH=() WT_LOCKED=()
LIVE_BRANCHES=$'\n'"$BASE"$'\n'
_push_wt() {
  [ -z "$path" ] && return
  WT_PATH+=("$path"); WT_HEAD+=("$head"); WT_BRANCH+=("$branch"); WT_LOCKED+=("$locked")
  case "$branch" in ''|'(detached)') ;; *) LIVE_BRANCHES="${LIVE_BRANCHES}${branch}"$'\n' ;; esac
}
path='' head='' branch='' locked=''
while IFS= read -r wt_line; do
  key=${wt_line%% *}; rest=${wt_line#* }
  [ "$wt_line" = "$key" ] && rest=''   # keyword-only line (e.g. "locked", "detached")
  case "$key" in
    worktree) path=$rest ;;
    HEAD)     head=$rest ;;
    branch)   branch=${rest#refs/heads/} ;;
    detached) branch='(detached)' ;;
    locked)   locked=$rest ;;
    '')       _push_wt; path='' head='' branch='' locked='' ;;
  esac
done < <(git worktree list --porcelain 2>/dev/null)
_push_wt   # trailing record with no blank after it

# A worktree whose git admin entry exists but whose %(worktreepath) comes
# back empty slips both checks — belt and braces: read each
# .claude/worktrees/<dir> HEAD through the .git pointer file (two reads, no
# subprocess — the old symbolic-ref per dir was itself a scaling item).
if [ -n "$MAIN_ROOT" ] && [ -d "$MAIN_ROOT/.claude/worktrees" ]; then
  for wt in "$MAIN_ROOT"/.claude/worktrees/*; do
    [ -d "$wt" ] && [ -f "$wt/.git" ] || continue
    _gd=$(<"$wt/.git"); _gd=${_gd#gitdir: }
    [ -f "$_gd/HEAD" ] || continue
    _h=$(<"$_gd/HEAD")
    case "$_h" in ref:\ refs/heads/*) LIVE_BRANCHES="${LIVE_BRANCHES}${_h#ref: refs/heads/}"$'\n' ;; esac
  done
fi

# First output immediately (gr514898): the scan itself takes a beat, so the
# human run announces what it is doing on stderr — the table/--json/--for-hook
# stdout contract stays clean.
if [ "$JSON_MODE" = 0 ] && [ "$FOR_HOOK" = 0 ]; then
  printf '… scanning %d worktrees (parallel probes) — output follows\n' "${#WT_PATH[@]}" >&2
fi

# --- per-tree probes ---------------------------------------------------------
# The helpers below stay fork-free where they can: every $(git …) and every
# `tr`/`grep`/`head` inside a probe is one spawn, paid once per worktree —
# at fleet size the spawn count itself was most of the >10 s (gr514898).

# clean_f <string> — strip the three chars that would corrupt a \x1f-joined
# probe record (newline, \x1e, \x1f); parameter expansion, no `tr` spawn.
clean_f() {
  local s=${1//$'\n'/ }
  s=${s//$'\036'/ }; s=${s//$'\037'/ }
  printf '%s' "$s"
}

# unmerged_count <rev> — `git cherry $BASE <rev>` without the `grep -c`
# spawn: count the '+' (patch-id absent from $BASE) lines in bash.
unmerged_count() {
  local n=0 l
  while IFS= read -r l; do
    case "$l" in +*) n=$((n+1)) ;; esac
  done < <(git cherry "$BASE" "$1" 2>/dev/null)
  printf '%s' "$n"
}

# verdict_compute <head> <branch> — sets VERD plus ANCESTOR (1 when <head> is
# reachable from $BASE, what purpose_field's "skip the unique-subject lookup"
# check needs) and AHEAD/BEHIND. The ahead/behind values normally arrive free
# from the batched for-each-ref pass; the per-head calls remain only for a
# detached HEAD, a branch the batch missed, or a git without %(ahead-behind:).
verdict_compute() {
  local head=$1 branch=$2 lr unmerged
  VERD='—'; ANCESTOR=1; AHEAD=''; BEHIND=''
  [ "$branch" = "$BASE" ] && return
  ANCESTOR=0
  if [ "$branch" != '(detached)' ]; then
    local j; j=$(br_index "$branch")
    if [ -n "$j" ]; then AHEAD=${BR_AHEAD[$j]}; BEHIND=${BR_BEHIND[$j]}; fi
  fi
  if [ -z "$AHEAD" ]; then
    if git merge-base --is-ancestor "$head" "$BASE" 2>/dev/null; then
      ANCESTOR=1; VERD='merged'; return
    fi
    BEHIND=$(git rev-list --count "$head".."$BASE" 2>/dev/null || echo '?')
    unmerged=$(unmerged_count "$head")
    if [ "$unmerged" != 0 ] && squash_absorbed "$head"; then unmerged=0; fi
    if [ "$unmerged" = 0 ]; then VERD="in-main↓${BEHIND}"; else VERD="↑${unmerged}↓${BEHIND}"; fi
    return
  fi
  if [ "$AHEAD" = 0 ]; then ANCESTOR=1; VERD='merged'; return; fi
  unmerged=$(unmerged_count "$branch")
  # git cherry says unmerged commits remain — before believing it, check
  # whether the branch is squash-absorbed by content (see squash_absorbed).
  if [ "$unmerged" != 0 ] && squash_absorbed "$head"; then unmerged=0; fi
  if [ "$unmerged" = 0 ]; then VERD="in-main↓${BEHIND}"; else VERD="↑${unmerged}↓${BEHIND}"; fi
}

# purpose_field <path> <branch> <ancestor> <file1> <file2> [max] — display
# purpose, truncated to <max> (default 58; --json asks for the full line
# so a claim check sees a slug anywhere in it). <file1>/<file2> are the first
# two edited basenames from the probe's single `git status` (the old code
# paid a second status call here).
purpose_field() {
  local path=$1 branch=$2 ancestor=$3 fa=$4 fb=$5 max=${6:-58}
  local pf line s files
  pf="$path/.claude/purpose"
  if [ -s "$pf" ]; then
    while IFS= read -r line; do
      if [ -n "${line//[[:space:]]/}" ]; then trunc "$line" "$max"; return; fi
    done < "$pf"
  fi
  if [ "$branch" != "$BASE" ] && [ "$branch" != '(detached)' ] && [ "$ancestor" = 0 ]; then
    s=$(git log -1 --no-merges --format='%s' "$BASE..$branch" 2>/dev/null)
    [ -n "$s" ] && { trunc "$s" "$max"; return; }
  fi
  if [ -n "$fa" ]; then
    files=$fa; [ -n "$fb" ] && files="${fa},${fb}"
    trunc "(editing ${files}…)" "$max"; return
  fi
  [ "$branch" = "$BASE" ] && { printf '—'; return; }
  printf '(no purpose set)'
}

# probe_worktree <i> — everything one worktree row needs that the batched
# passes could not supply, run inside a `&` subshell and printed as ONE
# \x1f-joined record on stdout (the parent redirects it to a result file):
#   row | show | removable-name | bucket | name | path | branch | sess |
#   dirtyf | verd | purpose(full)
# with the optional --json diffstat appended after a newline. Per-tree git
# calls: one `git status` (whose ?? lines also give the untracked count and
# the "(editing …)" basenames), plus the verdict/purpose calls only when the
# branch is actually ahead — a merged+clean tree costs exactly one.
probe_worktree() {
  local i=$1
  local path=${WT_PATH[$i]} head=${WT_HEAD[$i]} branch=${WT_BRANCH[$i]} locked=${WT_LOCKED[$i]}
  local name sess dirtyf='clean' verd purp purpj last mark task_id agent_tree j
  local show=0 rem='' bucket='' ds='' row
  local dirty=0 untr=0 fa='' fb='' line base

  if [ "$branch" = "$BASE" ]; then name=$BASE; else name=${path##*/}; fi
  mark=' '; [ "$path" = "$SELF_PATH" ] && mark='*'
  sess=$(session_field "$locked")
  # Canonicalize like the marker's `cwd` (Path.resolve()) so the compare is
  # not fooled by a symlinked parent (e.g. /var -> /private/var on macOS).
  # `cd -P` inside the probe subshell makes $PWD physical — no fork.
  local canon
  if cd -P "$path" 2>/dev/null; then canon=$PWD; else canon=$path; fi
  task_id=$(task_for "$canon" "$locked")
  [ -n "$task_id" ] && sess="live-task#${task_id}"
  agent_tree=0
  case "$name:$branch" in
    agent-*:*) agent_tree=1 ;;
    *:worktree-agent-*) agent_tree=1 ;;
  esac

  # One status call for both counts (the old code paid this plus an
  # `ls-files --others` plus a second identical status inside purpose).
  local st
  st=$(git --no-optional-locks -C "$path" status --porcelain --untracked-files=all 2>/dev/null)
  while IFS= read -r line; do
    [ -z "$line" ] && continue
    case "$line" in
      '?? '*) untr=$((untr+1)) ;;
      *)      dirty=$((dirty+1))
              if [ -z "$fa" ]; then fa=${line##* }; fa=${fa##*/}
              elif [ -z "$fb" ]; then fb=${line##* }; fb=${fb##*/}; fi ;;
    esac
  done <<< "$st"
  if [ "$dirty" = 0 ] && [ "$untr" = 0 ]; then dirtyf='clean'
  else
    dirtyf=''
    [ "$dirty" != 0 ] && dirtyf="$dirty"
    [ "$untr" != 0 ] && dirtyf="${dirtyf}+${untr}u"
  fi

  verdict_compute "$head" "$branch"; verd=$VERD

  if [ "$FOR_HOOK" = 1 ]; then
    # The hook prints counts, not columns — purpose's `$BASE..$branch` log
    # and a detached HEAD's `log -1` are per-tree spawns nothing reads
    # (gr541365).
    purpj=''; last=''
  else
    # Full-length purpose once, truncated only for the table — --json carries
    # the whole first line (a claim check needs the slug wherever it sits).
    purp=$(purpose_field "$path" "$branch" "$ANCESTOR" "$fa" "$fb" 4000)
    # \x1f/\x1e/newline in a purpose line would corrupt the record framing.
    purpj=$(clean_f "$purp")

    # LAST comes free from the for-each-ref pass for a branch checkout; a
    # detached HEAD is the only row that still pays `git log -1`.
    j=''; [ "$branch" != '(detached)' ] && j=$(br_index "$branch")
    if [ -n "$j" ]; then
      last=$(trunc "$(clean_f "${BR_REL[$j]} — ${BR_SUBJ[$j]}")" 46)
    else
      last=$(trunc "$(clean_f "$(git -C "$path" log -1 --format='%cr — %s' 2>/dev/null)")" 46)
    fi
  fi

  # overlap-relevant: current tree, live session/task, dirty, or ahead of main
  if [ "$mark" = '*' ] || [[ "$sess" == live#* || "$sess" == live-task#* ]] \
     || [ "$dirtyf" != 'clean' ] || [[ "$verd" == ↑* ]]
  then show=1; fi

  # An unknown agent-tree liveness state is not proof that its task has ended.
  # A lock whose reason carries no `pid <N>` (sess = `locked`) was placed by hand
  # or by older code; reap must not guess it dead (incident 2026-08-15,
  # defect 2 — a recovery lock "live session 22516 …" was reaped as unlocked).
  if [ "$verd" = 'merged' ] && [ "$dirtyf" = 'clean' ] \
     && [[ "$sess" != live#* && "$sess" != live-task#* ]] \
     && [ "$sess" != 'locked' ] && [ "$agent_tree" = 0 ] \
     && [ "$path" != "$SELF_PATH" ] && [ "$path" != "$PRIMARY" ]; then
    rem=$name
  fi

  if [ "$JSON_MODE" = 1 ]; then
    if [ "$path" = "$PRIMARY" ] || [ "$branch" = "$BASE" ]; then bucket='base'
    elif [ "$path" = "$SELF_PATH" ]; then bucket='self'
    elif [[ "$sess" == live-task#* ]]; then bucket='live_subagent'
    elif [[ "$sess" == live#* ]]; then bucket='live_session'
    elif [ "$sess" = 'locked' ]; then bucket='needs_judgment'
    elif [ "$agent_tree" = 1 ]; then bucket='needs_judgment'
    elif [ "$dirtyf" != 'clean' ]; then
      bucket='needs_judgment'
      ds=$(git --no-optional-locks -C "$path" diff --stat 2>/dev/null | head -10)
      ds=${ds//$'\036'/ }; ds=${ds//$'\037'/ }
    elif [ "$verd" = 'merged' ] || [[ "$verd" == in-main* ]]; then bucket='safe_remove'
    else bucket='has_unmerged_work'
    fi
  fi

  row="${mark}${name}|${sess}|${dirtyf}|${verd}|$(trunc "$purpj" 58)|${last}"
  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' \
    "$row" "$show" "$rem" "$bucket" "$name" "$path" "$branch" "$sess" "$dirtyf" "$verd" "$purpj"
  [ -n "$ds" ] && printf '\n%s' "$ds"
  return 0
}

# probe_branch <j> — a local branch git's own worktree admin reports as
# checked out NOWHERE (empty %(worktreepath)). Invisible to the worktree
# list, so an unmerged one sat with no session, no purpose line, and no
# reap advisory (docs/backlog/inflight-sessionless-branches.md). SESSION is
# always "—" (no worktree, no lock possible); the verdict reuses
# verdict_compute — BR_* carries its ahead/behind and the squash-absorbed
# content-equality fallback still applies. PURPOSE goes straight to the
# newest branch-unique commit subject (no path to read .claude/purpose
# from). Same result-file contract as probe_worktree.
probe_branch() {
  local j=$1
  local branch=${BR_NAME[$j]} head=${BR_HEAD[$j]}
  local verd purp purpj last show=0 bucket ds='' row

  verdict_compute "$head" "$branch"; verd=$VERD
  purp=$(git log -1 --no-merges --format='%s' "$BASE..$branch" 2>/dev/null)
  [ -z "$purp" ] && purp='(no purpose set)'
  purpj=$(clean_f "$purp")
  last=$(trunc "$(clean_f "${BR_REL[$j]} — ${BR_SUBJ[$j]}")" 46)

  row="(no worktree) ${branch}|—|—|${verd}|$(trunc "$purpj" 58)|${last}"
  [[ "$verd" == ↑* ]] && show=1
  # 0 unmerged commits vs $BASE = safe to `git branch -D`; anything else is
  # real stranded work reap-worktrees must only ever report, never delete.
  if [[ "$verd" == ↑* ]]; then bucket='stranded'; else bucket='safe_remove'; fi

  printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s\x1f%s' \
    "$row" "$show" "" "$bucket" "$branch" "" "$branch" "—" "—" "$verd" "$purpj"
  return 0
}

# --- fan-out -----------------------------------------------------------------
PROBE_DIR=$(mktemp -d "${TMPDIR:-/tmp}/inflight.XXXXXX") || exit 0
trap 'rm -rf "$PROBE_DIR"' EXIT

_spawned=0
BJ_LIST=()
for i in "${!WT_PATH[@]}"; do
  ( probe_worktree "$i" ) >"$PROBE_DIR/w${i}.res" 2>/dev/null &
  _spawned=$((_spawned+1))
  [ $((_spawned % PARALLEL)) -eq 0 ] && wait
done
for j in "${!BR_NAME[@]}"; do
  case "${BR_NAME[$j]}" in
    ci/*) continue ;;
    "$BASE") continue ;;
  esac
  [ -n "${BR_WTPATH[$j]}" ] && continue
  case $LIVE_BRANCHES in *$'\n'"${BR_NAME[$j]}"$'\n'*) continue ;; esac
  BJ_LIST+=("$j")
  # Skip-mode: no probe at all — the record is built from the batched
  # for-each-ref pass in the collect loop below (gr541365).
  [ "$SKIP_BP" = 1 ] && continue
  ( probe_branch "$j" ) >"$PROBE_DIR/b${j}.res" 2>/dev/null &
  _spawned=$((_spawned+1))
  [ $((_spawned % PARALLEL)) -eq 0 ] && wait
done
wait

# --- assemble (original ordering: worktrees, then branchless branches) -------
ROWS=()          # emitted, |-delimited
SHOW=()          # parallel to ROWS: 1 = matters for overlap (--for-hook prints only these)
REMOVABLE=()     # names safe to reap (merged + clean + no live session)
JSONROWS=()      # --json only: \x1f-delimited records, joined \x1e at render time

read_result() { # read_result <file> — sets R_* fields from a probe record
  local f=$1 content headline
  R_DS=''
  content=$(<"$f")
  if [[ "$content" == *$'\n'* ]]; then
    headline=${content%%$'\n'*}; R_DS=${content#*$'\n'}
  else
    headline=$content
  fi
  IFS=$'\x1f' read -r R_ROW R_SHOW R_REM R_BUCKET R_NAME R_PATH R_BRANCH \
    R_SESS R_DIRTYF R_VERD R_PURPJ <<<"$headline"
}

collect_result() { # collect_result <file> — append one probe record to the
  # shared arrays; a probe that died before writing still gets a row so a
  # missing result can never silently shrink the table.
  local f=$1 stub=$2
  if [ ! -s "$f" ]; then
    ROWS+=(" ${stub}|?|?|?|(probe failed)|"); SHOW+=(1)
    [ "$JSON_MODE" = 1 ] && JSONROWS+=("${stub}"$'\x1f\x1f'"${stub}"$'\x1f'"needs_judgment"$'\x1f—\x1f—\x1f?\x1f\x1f(probe failed)')
    return
  fi
  read_result "$f"
  ROWS+=("$R_ROW"); SHOW+=("$R_SHOW")
  [ -n "$R_REM" ] && REMOVABLE+=("$R_REM")
  if [ "$JSON_MODE" = 1 ]; then
    JSONROWS+=("${R_NAME}"$'\x1f'"${R_PATH}"$'\x1f'"${R_BRANCH}"$'\x1f'"${R_BUCKET}"$'\x1f'"${R_SESS}"$'\x1f'"${R_DIRTYF}"$'\x1f'"${R_VERD}"$'\x1f'"${R_DS}"$'\x1f'"${R_PURPJ}")
  fi
}

for i in "${!WT_PATH[@]}"; do
  collect_result "$PROBE_DIR/w${i}.res" "${WT_PATH[$i]##*/}"
done
for j in "${BJ_LIST[@]+"${BJ_LIST[@]}"}"; do
  if [ "$SKIP_BP" = 1 ]; then
    # Cheap stand-in for probe_branch's result file — no git ran for this
    # branch. Buckets stay conservative: a squash-landed branchless branch
    # (ahead>0 but content on $BASE) reads `stranded` here — report-only,
    # never deleted — until a full run re-verifies it (gr541365). With no
    # %(ahead-behind:) support the verdict is unknown, so report-only too.
    case "${BR_AHEAD[$j]}" in
      0)  _bverd='merged'; _bbucket='safe_remove' ;;
      '') _bverd='—'; _bbucket='stranded' ;;
      *)  _bverd="↑${BR_AHEAD[$j]}↓${BR_BEHIND[$j]}"; _bbucket='stranded' ;;
    esac
    _blast=$(trunc "$(clean_f "${BR_REL[$j]} — ${BR_SUBJ[$j]}")" 46)
    ROWS+=("(no worktree) ${BR_NAME[$j]}|—|—|${_bverd}||${_blast}")
    SHOW+=(0)
    if [ "$JSON_MODE" = 1 ]; then
      JSONROWS+=("${BR_NAME[$j]}"$'\x1f\x1f'"${BR_NAME[$j]}"$'\x1f'"${_bbucket}"$'\x1f—\x1f—\x1f'"${_bverd}"$'\x1f\x1f')
    fi
    continue
  fi
  collect_result "$PROBE_DIR/b${j}.res" "(no worktree) ${BR_NAME[$j]}"
done

# --- render ---------------------------------------------------------------
if [ "$JSON_MODE" = 1 ]; then
  STASH_COUNT=$(git stash list 2>/dev/null | grep -c .)
  BLOB=$(IFS=$'\x1e'; printf '%s' "${JSONROWS[*]:-}")
  printf '%s' "$BLOB" | BASE="$BASE" STASH_COUNT="$STASH_COUNT" python3 -c '
import json
import os
import sys

base = os.environ["BASE"]
stash_count = int(os.environ["STASH_COUNT"])
raw = sys.stdin.read()
worktrees = []
for rec in raw.split("\x1e") if raw else []:
    fields = rec.split("\x1f")
    fields += [""] * (9 - len(fields))
    name, path, branch, bucket, session, dirty, verdict, diffstat, purpose = fields[:9]
    entry = {
        "name": name,
        "path": path,
        "branch": branch,
        "bucket": bucket,
        "session": session,
        "dirty": dirty,
        "verdict": verdict,
        # additive: a branchless branch (emit_branch) always carries "" for
        # path (no worktree to have one); every real worktree rows own path
        # doubles as its "worktree" value. null is the sole "no worktree" tell.
        "worktree": path or None,
        # additive: the full first purpose line (untruncated; the table
        # shows the same text clipped to 58). Fixer-claim checks read this.
        "purpose": purpose,
    }
    if diffstat:
        entry["diffstat"] = diffstat
    worktrees.append(entry)
print(json.dumps({"base": base, "stashCount": stash_count, "worktrees": worktrees}, indent=2))
'
  exit 0
fi

# The open-gripe line (`gripes: N open · M older than 3d · oldest grX`) from
# the session-start memory hook's saved render — the one cached fact here,
# shown with its timestamp; inflight itself never queries prod.
gripe_line() {
  local c="${PRECIS_MEMORY_CACHE:-${XDG_CACHE_HOME:-$HOME/.cache}/precis/memory-index.md}" l
  [ -s "$c" ] || return 0
  l="$(grep -m1 '^gripes: ' "$c")" || return 0
  echo "$l (as of $(date -u -r "$c" +%Y-%m-%dT%H:%MZ))"
}

if [ "$FOR_HOOK" = 1 ]; then
  # One line, not the table (gr499042): the hook's output is injected once
  # and then carried every later turn of the session, so the overlap scan
  # is on-demand now — a session that needs it runs scripts/inflight.
  LIVE=0; DIRTYF=0; AHEAD=0; TASK_COUNTED=0
  for i in "${!ROWS[@]}"; do
    [ "${SHOW[$i]}" = 1 ] || continue
    IFS='|' read -r _c1 _sess _dirtyf _verd _p _l <<<"${ROWS[$i]}"
    if [[ "$_sess" == live#* ]]; then
      LIVE=$((LIVE+1))
    elif [[ "$_sess" == live-task#* ]] && [ "$TASK_COUNTED" = 0 ]; then
      LIVE=$((LIVE+1)); TASK_COUNTED=1
    fi
    [ "$_dirtyf" != 'clean' ] && DIRTYF=$((DIRTYF+1))
    [[ "$_verd" == ↑* ]] && AHEAD=$((AHEAD+1))
  done
  # gr499042, second cut: one counts line only. The purpose nudge is already
  # in CLAUDE.md; "N removable" pre-announces what reap-worktrees' own
  # SessionStart run then reports as "reaped N"; the gripe digest prints from
  # session-start-memory.sh anyway — fresh there, a session stale here.
  # Branchless branches are their own segment (gr541365): the counts above
  # describe worktrees, and skip-mode branch rows keep SHOW=0 out of them.
  EXTRA=''
  if [ "${#BJ_LIST[@]}" -gt 0 ]; then
    _bw='branches'; [ "${#BJ_LIST[@]}" = 1 ] && _bw='branch'
    EXTRA=" · ${#BJ_LIST[@]} worktree-less ${_bw}"
  fi
  echo "🌳 ${#ROWS[@]} trees in flight ($LIVE live, $DIRTYF dirty, $AHEAD ahead of $BASE$EXTRA) — scripts/inflight for the overlap table"
  exit 0
fi

# Display order (gr514898): this tree, then every overlap-relevant row (live
# session/task, dirty, ahead of $BASE), then the quiet tail — capped at
# MAX_ROWS so a fleet-size listing stays a table, not a scroll. Every
# overlap row is always shown even past the cap; --all opts out entirely.
ORDERED=()
SELF_I=-1
for i in "${!ROWS[@]}"; do
  if [ "${ROWS[$i]:0:1}" = '*' ]; then SELF_I=$i; ORDERED+=("$i"); break; fi
done
for i in "${!ROWS[@]}"; do
  [ "$i" = "$SELF_I" ] && continue
  [ "${SHOW[$i]}" = 1 ] && ORDERED+=("$i")
done
SIGNAL=${#ORDERED[@]}
for i in "${!ROWS[@]}"; do
  [ "$i" = "$SELF_I" ] && continue
  [ "${SHOW[$i]}" = 0 ] && ORDERED+=("$i")
done

TOTAL=${#ORDERED[@]}
LIMIT=$TOTAL
if [ "$SHOW_ALL" = 0 ] && [ "$TOTAL" -gt "$MAX_ROWS" ]; then
  LIMIT=$SIGNAL; [ "$LIMIT" -lt "$MAX_ROWS" ] && LIMIT=$MAX_ROWS
  [ "$LIMIT" -gt "$TOTAL" ] && LIMIT=$TOTAL
fi
HIDDEN=$((TOTAL - LIMIT))

# Aligned in-shell, not `column -t`: column is absent on some images the
# script lands in (the dev container, where --json consumers don't care but
# a human run prints an empty table), and the shown rows are already in
# memory, so widths are a free second pass. '|' inside a subject spills
# into the last column — same split column -s '|' made.
_W1=0; _W2=0; _W3=0; _W4=0; _W5=0
_SHOWN=("WORKTREE|SESSION|DIRTY|VS-${BASE}|PURPOSE|LAST")
for k in "${ORDERED[@]:0:$LIMIT}"; do
  _SHOWN+=("${ROWS[$k]}")
done
for r in "${_SHOWN[@]}"; do
  IFS='|' read -r _a _b _c _d _e _f <<<"$r"
  [ "${#_a}" -gt "$_W1" ] && _W1=${#_a}
  [ "${#_b}" -gt "$_W2" ] && _W2=${#_b}
  [ "${#_c}" -gt "$_W3" ] && _W3=${#_c}
  [ "${#_d}" -gt "$_W4" ] && _W4=${#_d}
  [ "${#_e}" -gt "$_W5" ] && _W5=${#_e}
done
for r in "${_SHOWN[@]}"; do
  IFS='|' read -r _a _b _c _d _e _f <<<"$r"
  printf '%-*s %-*s %-*s %-*s %-*s %s\n' "$_W1" "$_a" "$_W2" "$_b" "$_W3" "$_c" "$_W4" "$_d" "$_W5" "$_e" "$_f"
done

if [ "$HIDDEN" -gt 0 ]; then
  echo "… +${HIDDEN} more quiet trees — scripts/inflight --all for the full list"
fi

if [ "${#REMOVABLE[@]}" -gt 0 ]; then
  RMAX=20
  [ "$SHOW_ALL" = 1 ] && RMAX=${#REMOVABLE[@]}
  echo
  if [ "${#REMOVABLE[@]}" -gt "$RMAX" ]; then
    echo "Removable (merged + clean + no live session): ${REMOVABLE[*]:0:$RMAX} … +$(( ${#REMOVABLE[@]} - RMAX )) more"
  else
    echo "Removable (merged + clean + no live session): ${REMOVABLE[*]}"
  fi
  echo "  → review, then: git worktree remove <name> && git branch -d worktree-<name>"
fi
gripe_line
exit 0

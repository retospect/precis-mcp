#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/fleet-wave — the coordinator kit for a builder wave in tmux.

A wave is a set of builder sessions, one tmux window each: ``claude-NAME``
(``claude -w NAME``) or ``devin-NAME`` (``scripts/devin-tree NAME``). This
tool launches them, reads their panes, types into them and closes them.
The thread-session fleet (one window per roadmap thread) is
``scripts/fleet``; this is the per-wave kit beside it. Runbook: the
``gripe-fleet`` skill (.claude/skills/gripe-fleet/SKILL.md).

    fleet-wave launch NAME --brief FILE [--tier R|W] [--devin]
    fleet-wave launch NAME --batch SLUG [--tier R|W] [--devin|--codex]
                                        brief = the batch dossier rendered from
                                        the gripes (precis gripe-fix brief); the
                                        launch records host/session/tree on them
    fleet-wave reassign NAME --batch SLUG|--brief FILE
                                        /clear a builder, point it at a new brief,
                                        record it on the batch
    fleet-wave handoff-wait NAME...     when a pane shows a bare DONE-HANDOFF,
                                        /clear it and send the resume line
    fleet-wave cites ID...              unlanded branch commits naming gr<ID>
    fleet-wave peek [WIN...] [-n N]     last N non-empty lines per window
    fleet-wave ctx                      context % per agent pane
    fleet-wave prompts                  panes at a dialog: window, type, command
    fleet-wave send-line WIN TEXT       type TEXT + Enter; refuses unsent input,
                                        waits out a compacting pane, retries a
                                        swallowed Enter (gr515698), and refuses
                                        fresh instructions past the ctx ceiling
    fleet-wave watch-done NAME...       emit when <tree>/.claude/purpose finishes
    fleet-wave stuck-watch [NAME...]    emit on prompt / quiet / done / gone
                                        (done carries the finish line, so it
                                        also covers watch-done); batched
    fleet-wave event-watch [NAME...]    board + pane events: the script runs
                                        reflexes for routine cases (quota →
                                        /model swe-2-high, DONE-HANDOFF →
                                        /clear + resume, idle hot pane →
                                        /compact) and prints only what needs
                                        the coordinator's judgment
    fleet-wave ctx-guard [NAME...]      send the WIP+handoff instruction once
                                        when a pane's ctx hits --ceiling
                                        (default 70%), re-arm below --rearm;
                                        FORCED HANDOFF line at --hard (85%);
                                        --compact sends /compact instead;
                                        --tokens N triggers on N context
                                        tokens (bare flag 120k, env
                                        FLEET_COMPACT_TOKENS), idle panes
                                        only — the peer main-loop form
    fleet-wave close NAME...            kill window, remove tree, drop branch;
                                        refuses a tree with unlanded commits
    fleet-wave land TREE [--checked|--quick|--remote] [-m MSG]
                                        run TREE's own scripts/ship (default
                                        --checked; --quick is lint only, no
                                        pytest) in TREE; coordinator tree
                                        only; refuses a live session
    fleet-wave approve TREE SHA[,SHA...] [--note ".."]   grant landing these shas
    fleet-wave approve --list [TREE]    print the approval ledger
    fleet-wave approve --revoke TREE SHA[,SHA...]        append a revoke line
    fleet-wave approved TREE SHA[,SHA...]  exit 0 iff all approved, none revoked

WIN is a window name (``claude-x``) or a wave NAME (resolved to its
``claude-``/``devin-`` window). tmux is always called with an argument
list, never a shell string. Nothing is stored in the repo except the
spec-claim commit described next.

Spec claims (gr509461). ``ready`` in docs/backlog means *unclaimed*, so
``launch`` enforces the convention where the fleet starts work: every
``docs/backlog/<slug>.md`` the brief names and whose front matter is
still ``status: ready`` is flipped to ``status: in-progress`` +
``claimed-by: <name>``, committed on main in the primary checkout and
pushed — the laptop fixer reads those files on this machine. The new
tree's ``.claude/purpose`` is seeded with the claim so ``inflight``'s
PURPOSE column shows it before the builder writes its own line. The
claim history is an append-only TSV at ``$FLEET_STATE/claims.tsv``.
``close`` releases: a removed tree's claimed specs flip back to
``ready`` the same way (also when the tree is already gone — the
abandoned/reaped-unmerged path). A spec that is dirty in the primary,
not ``ready``, or claimed by another tree is left alone; a flip that
can't be pushed is rolled back rather than left diverging local main.
``launch`` also warns (never blocks) when the brief cites a commit that
is not an ancestor of ``origin/main`` — a cite of unlanded or
squash-landed work (gr515489, gr515506).

``ctx-guard`` (gr515267) enforces the context ceiling briefs ask for but
builders ignore: it polls each named wave window (every ``claude-`` /
``devin-`` window when no names are given) and, once a pane's context
fill reaches ``--ceiling`` (default 70%), sends the WIP+handoff
instruction one time through the same machinery as ``send-line``
(compaction wait, dialog/unsent-input refusal, Enter retry) and marks it
sent under ``$FLEET_STATE/ctx-guard/``. A pane that drops below
``--rearm`` (default 40% — i.e. after a ``/clear``) re-arms its marker.
At or above ``--hard`` (default 85% — where ``send-line`` refuses fresh
instructions) the guard also prints one FORCED HANDOFF line per episode
for the coordinator; that marker re-arms on the same ``--rearm`` drop.
``--message`` / ``--message-file`` override the default instruction;
``{name}`` inside it fills with the wave name. ``--compact`` sends
``/compact`` instead and re-arms at half the ceiling: the orchestrator
main loops (any window name, not only ``claude-``/``devin-``) cost most
in cache reads past ~120k tokens (gr515153). ``--tokens`` is the
peer-loop form: it implies ``--compact`` and triggers on the absolute
context size a pane prints — Devin's ``Context: N / M tokens``, Claude's
``/clear to save N tokens`` — with a bare flag meaning 120k and
``FLEET_COMPACT_TOKENS``/``--tokens N`` retuning (k/M suffixes). A
compact never fires mid-turn: a busy pane is skipped and retried on the
next poll, and a pane that prints no token figure is left alone.

Watcher output is Monitor input, and every line wakes the coordinator at
full context (gr515152: 70% of GRIPE_FIX's Opus calls). So
``stuck-watch``/``watch-done`` print only real changes: a changed state
must hold ``--settle`` polls, a quiet pane repeats every ``--requiet-min``
(not every ten minutes), and non-urgent lines wait up to ``--digest-sec``
to leave in one write; only a permission prompt flushes at once.

``event-watch`` (td570414) is the reflexed form: where ``stuck-watch``
reports every changed state for the coordinator to act on, ``event-watch``
handles the routine ones itself and logs them to
``$FLEET_STATE/event-watch.log`` — a devin pane dead on a quota-exhausted
banner gets ``/model swe-2-high`` plus the resume line (once per pane per
``--cooldown-min``, default 30; a pane already on swe-2-high is printed
for judgment instead), a bare DONE-HANDOFF gets handoff-wait's ``/clear``
+ resume, and an idle pane over the ctx threshold (``--ceiling`` % or
``--tokens`` tokens — ctx-guard's rules: never mid-turn, never under a
live subagent task) gets ``/compact``. Only judgment events print: board
done/red/blocked/wedged lines from the watched trees (the watcher's own
``board.pos`` byte cursor — seeded at EOF on the first run, no history
replay — plus ``board.pending`` for alert lines not yet printed or from
a tree whose window is not up yet; a line leaves pending only by
printing), a permission ``prompt``, an ``error`` the reflexes did not
clear within ``--settle`` polls, ``frozen``, ``gone``, a dead agent
(``done``) and a reflex that failed; lines batch up to ``--digest-sec``
(default 30 s). ``--triage`` is the reserved hook for a cheap-model first
pass (e.g. haiku) that would vet borderline lines before they print —
not implemented.

Launch tiers are authority v2's R and W (.claude/fleet/authority.md);
``readonly`` and ``qland`` are aliases for R and W. Launch creates the
worktree first (as ``claude -w``/devin-tree would; both reuse it), runs
``scripts/fleet-authority apply --tier T --to TREE --yes`` so the tree's
.claude/settings.local.json and .devin/config.json carry the tier's
permissions, and prints the tier's Codex flags. The prompt footer is
.claude/fleet/generated/footer-<T>.txt plus .claude/fleet/builder-workflow.txt
with ``{coordinator}`` and ``{release_owner}`` filled. FLEET_LEGACY_FOOTERS=1
restores the pre-v2 launch for one release: footers/<readonly|qland>.txt
(which also needs ``{approval}``) and no apply.

Landing (``land``). A branch lands only by ship run in its own tree, so
a tier-R builder's work is landed by ``fleet-wave land TREE``, which runs
``TREE/scripts/ship`` in one of its gate modes — ``--checked`` (the
default), ``--quick`` (lint only, no pytest) or ``--remote`` (harness
diffs) — with cwd=TREE and the
output in ``$FLEET_STATE/land/<tree>-<stamp>.log``; it prints the log path
and ship's exit code and returns it. It never cherry-picks or creates a
branch (a copy leaves the builder's branch looking unmerged forever), and
refuses a tree whose lock names a live session pid or that has an active
subagent task, and any run outside ``FLEET_COORDINATOR_TREE``.

The approval ledger lives in ``$FLEET_STATE/approvals/<tree>.tsv`` (never
the repo: its lines carry user and session ids, and the repo is public).
It is append-only TSV — stamp, action, shas, note, approver — and revoke
is a later line, never an edit. ``approve``/``--revoke`` run only from
the coordinator tree (``FLEET_COORDINATOR_TREE``; refused when unset):
the grant is typed by the user in the coordinator window, never relayed
through a session message. This is a convention-level guard — anything
with shell access could append to the file directly. It holds because
the coordinator session's own rules forbid it writing a grant the user
did not type, and the coordinator transcript shows which lines the user
typed; .claude/fleet/authority.md still governs.

Batch launches (gr519361). ``--batch SLUG`` takes the brief from the DB:
``scripts/prod-precis gripe-fix brief SLUG --out <state>/<win>.brief.md``
renders the batch dossier (the brief in force plus every member gripe's
body and comments — what a builder without MCP access gets), and after
the window is up ``gripe-fix assign SLUG --host <this host> --session
<vendor>:<win> --tree NAME`` records who builds it on every gripe of the
batch. ``FLEET_GRIPE_FIX_CMD`` overrides the command prefix (tests point
it at a fake). A failed assign is reported, never fatal to the launch.
The session recorded is ``<vendor>:<window>`` (``claude:claude-NAME``,
``devin:devin-NAME``, ``codex:codex-NAME``) — the one handle every
vendor has at launch time.

``--codex`` launches a Codex builder: a LOCKED worktree (the reaper
deletes unlocked sessionless trees; unlock with ``git worktree unlock``),
the prompt copied to ``<tree>/scratch/codex-brief.md`` with a no-MCP
note appended, and window ``codex-NAME`` running ``codex`` with exactly
the tier's flags from ``scripts/fleet-authority`` (``codex-flags:``) —
nothing added or overridden: what a tier grants is authority. Tier R is
refused for ``--codex`` (its ``--sandbox read-only`` cannot commit);
``--tier W`` is the lane. Launch waits ``--settle`` seconds and refuses
(no "launched", no assign) when the window is already gone — codex
exits at once on a bad flag set.

``reassign``, ``handoff-wait`` and ``cites`` replace the GRIPE_FIX
coordinator's scratch scripts (reassign.sh, handoff-wait.sh,
dupcheck.sh): a builder re-pointed at a new batch, a Devin that printed
``DONE-HANDOFF`` at its context ceiling resumed after ``/clear``, and a
check whether some unlanded branch already names a gripe.

Configuration (env, or the matching flag before the subcommand):
  FLEET_TMUX_SESSION  --session   tmux session (default: the current one)
  FLEET_TMUX_SOCKET   --socket    private tmux server (tmux -L), tests
  FLEET_WORKTREES     --worktrees worktree root (default <main>/.claude/worktrees)
  FLEET_MODEL         --model     builder model (default opus)
  FLEET_STATE                     watcher state + close log + approvals/
                                  (default ~/.claude/fleet-wave)
  FLEET_COORDINATOR_TREE          absolute path of the coordinator tree;
                                  approve/--revoke/land refuse anywhere else
  FLEET_COORDINATOR, FLEET_RELEASE_OWNER, FLEET_APPROVAL   footer fills
  FLEET_LEGACY_FOOTERS=1          pre-v2 footers, no apply (one release)
  FLEET_COMPACT_TOKENS            ctx-guard's peer-loop compact threshold
                                  (default of --tokens; bare flag = 120k)
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import itertools
import os
import re
import shlex
import socket
import subprocess
import sys
import time
from collections.abc import Callable, Iterable, Sequence
from datetime import UTC, datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent))
# The pane parsers live in scripts/fleet_panes.py (shared with
# scripts/fleet-panes); the names stay re-exported here for the tests and
# for the small fleet-wave-only helpers built on them.
from fleet_panes import (
    ANSI_RE,
    BUSY_RE,
    LAUNCH_PERMISSION_MODE,
    PaneReport,
    compacting,
    ctx_percent,
    ctx_tokens,
    detect_agent,
    devin_model,
    dialog_command,
    dialog_type,
    nonempty_tail,
    pane_report,
    quota_banner,
    unsent_input,
)

#: Above this length, or with a newline, text goes in as one bracketed
#: paste (typed text loses its head in a Claude pane; see scripts/fleet).
PASTE_MIN = 200
PREFIXES = ("claude-", "devin-", "codex-")

#: The wave's context refuse line in % used (gr515267). Brief text alone
#: did not hold the 70% handoff ceiling — five builders ran to 85-99% on
#: 2026-10-24. At/above CTX_HARD send-line refuses fresh instructions —
#: slash commands (/compact, /clear are the remediation) and --force
#: pass — and ctx-guard prints FORCED HANDOFF for the coordinator.
CTX_HARD = 85
SCRIPTS = Path(__file__).resolve().parent
sys.path.insert(0, str(SCRIPTS))
try:
    from branch_audit import Auditor
except ImportError:  # a staged copy without scripts/lib — close falls back
    Auditor = None  # type: ignore[assignment, misc]
#: Authority v2 tiers; readonly/qland are the pre-v2 names, kept as aliases.
TIER_ALIASES = {"readonly": "R", "qland": "W"}
LEGACY_FOOTER = {"R": "readonly", "W": "qland"}
PLACEHOLDER_RE = re.compile(r"\{(coordinator|release_owner|approval)\}")


def utc_stamp() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


class Fleet:
    def __init__(self, args: argparse.Namespace) -> None:
        self.session: str = args.session or os.environ.get("FLEET_TMUX_SESSION", "")
        self.socket: str = args.socket or os.environ.get("FLEET_TMUX_SOCKET", "")
        # Explicit choice only: the "opus" default is a claude alias, which
        # devin-tree would reject, so Devin launches pass --model only when set.
        self.model_set: str = args.model or os.environ.get("FLEET_MODEL", "")
        self.model: str = self.model_set or "opus"
        self.repo = Path(
            git("rev-parse", "--show-toplevel", cwd=Path.cwd()).strip() or "."
        )
        common = git("rev-parse", "--path-format=absolute", "--git-common-dir")
        self.main = Path(common.strip()).parent if common.strip() else self.repo
        wt = args.worktrees or os.environ.get("FLEET_WORKTREES", "")
        self.worktrees = Path(wt) if wt else self.main / ".claude" / "worktrees"
        st = os.environ.get("FLEET_STATE", "")
        self.state = Path(st) if st else Path.home() / ".claude" / "fleet-wave"

    # --- tmux ---------------------------------------------------------------

    def tmux(self, *argv: str, check: bool = True) -> str:
        cmd = ["tmux", *(["-L", self.socket] if self.socket else []), *argv]
        proc = subprocess.run(
            cmd, capture_output=True, text=True, encoding="utf-8", check=False
        )
        if check and proc.returncode:
            raise SystemExit(f"fleet-wave: {' '.join(cmd[:4])}…: {proc.stderr.strip()}")
        return proc.stdout

    def target(self, win: str) -> str:
        # A %N pane id is already a global target — wrapping it in
        # "=<session>:" makes tmux look for a window literally named %N
        # (gr515267: `fleet-wave ctx` printed nothing at all under
        # FLEET_TMUX_SESSION because every capture used =session:%N).
        if win.startswith("%"):
            return win
        return f"={self.session}:{win}" if self.session else win

    def windows(self) -> list[str]:
        argv = ["list-windows", "-F", "#{window_name}"]
        if self.session:
            argv[1:1] = ["-t", f"={self.session}"]
        return [w for w in self.tmux(*argv).splitlines() if w]

    def resolve(self, name: str) -> str | None:
        wins = self.windows()
        if name in wins:
            return name
        for p in PREFIXES:
            if p + name in wins:
                return p + name
        return None

    def capture(self, win: str, *, escapes: bool = False) -> str | None:
        argv = ["capture-pane", "-p", "-J", "-t", self.target(win)]
        if escapes:
            argv.insert(2, "-e")
        cmd = ["tmux", *(["-L", self.socket] if self.socket else []), *argv]
        proc = subprocess.run(
            cmd, capture_output=True, text=True, encoding="utf-8", check=False
        )
        return None if proc.returncode else proc.stdout

    def wave_windows(self) -> list[str]:
        return [w for w in self.windows() if w.startswith(PREFIXES)]

    def pane_facts(self, win: str) -> tuple[str, bool]:
        """``(pane_current_command, pane_dead)`` for a window.

        ``("", False)`` when tmux cannot say — the caller then treats the
        pane as alive and falls back to the window name for the agent.
        """
        out = self.tmux(
            "display-message",
            "-p",
            "-t",
            self.target(win),
            "#{pane_current_command}\t#{pane_dead}",
            check=False,
        )
        cmd, _, dead = out.partition("\t")
        return cmd.strip(), dead.strip() == "1"


def git(*argv: str, cwd: Path | None = None) -> str:
    proc = subprocess.run(
        ["git", *argv],
        capture_output=True,
        text=True,
        encoding="utf-8",
        cwd=cwd,
        check=False,
    )
    return proc.stdout if proc.returncode == 0 else ""


# --- approval ledger -----------------------------------------------------------


def _tsv(text: str) -> str:
    """One field: tabs and newlines would break the TSV line."""
    return re.sub(r"[\t\r\n]+", " ", text).strip()


def _ledger_path(f: Fleet, tree: str) -> Path:
    return f.state / "approvals" / f"{tree}.tsv"


def _ledger_entries(path: Path) -> list[tuple[str, str, list[str], str, str]]:
    """(stamp, action, shas, note, approver) per line; malformed lines skip."""
    try:
        text = path.read_text(encoding="utf-8")
    except OSError:
        return []
    out = []
    for ln in text.splitlines():
        fields = ln.split("\t")
        if len(fields) < 4 or fields[1] not in ("approve", "revoke"):
            continue
        out.append(
            (
                fields[0],
                fields[1],
                [s for s in fields[2].split(",") if s],
                fields[3],
                fields[4] if len(fields) > 4 else "",
            )
        )
    return out


def _coordinator_refusal() -> str | None:
    """Refusal reason for a ledger write, or None. Convention-level only:
    shell access beats the check — it holds because the coordinator
    session's rules forbid it writing a grant the user did not type, and
    .claude/fleet/authority.md governs."""
    coord = os.environ.get("FLEET_COORDINATOR_TREE", "")
    if not coord or not Path(coord).is_absolute():
        return "FLEET_COORDINATOR_TREE is unset or not an absolute path"
    if Path.cwd().resolve() != Path(coord).resolve():
        return f"not the coordinator tree ({coord})"
    return None


def _full_sha(want: str) -> str:
    """The full commit sha for ``want``, or "" when it does not resolve."""
    return git("rev-parse", "--verify", f"{want}^{{commit}}").strip()


def _bad_tree(tree: str) -> bool:
    return not re.fullmatch(r"[A-Za-z0-9._-]+", tree) or ".." in tree


def _active_subagent_task(tree: Path) -> str:
    helper = SCRIPTS / "hooks" / "subagent-task-state.py"
    if not helper.is_file():
        return "state-check-unavailable"
    proc = subprocess.run(
        ["python3", str(helper), "check", str(tree)],
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if proc.returncode == 0:
        return proc.stdout.strip() or "unknown"
    return "" if proc.returncode == 1 else "state-check-unavailable"


def cmd_approve(f: Fleet, a: argparse.Namespace) -> int:
    if a.list:
        paths = (
            sorted((f.state / "approvals").glob("*.tsv"))
            if a.tree is None
            else [_ledger_path(f, a.tree)]
        )
        rc = 0
        for p in paths:
            if a.tree is None:
                print(f"--- {p.stem}")
            try:
                print(p.read_text(encoding="utf-8"), end="")
            except OSError:
                print(f"(no ledger for {p.stem})")
                rc = 1
        return rc
    if not a.tree or not a.shas:
        print(
            "fleet-wave: approve needs <tree> <sha>[,<sha>...] (or --list)",
            file=sys.stderr,
        )
        return 2
    if _bad_tree(a.tree):
        print(f"fleet-wave: bad tree name {a.tree!r}", file=sys.stderr)
        return 2
    if why := _coordinator_refusal():
        print(f"fleet-wave: REFUSED: {why}", file=sys.stderr)
        return 3
    full = []
    for s in a.shas.split(","):
        s = s.strip()
        if not (sha := _full_sha(s)):
            print(f"fleet-wave: unknown sha {s!r}", file=sys.stderr)
            return 2
        full.append(sha)
    action = "revoke" if a.revoke else "approve"
    path = _ledger_path(f, a.tree)
    path.parent.mkdir(parents=True, exist_ok=True)
    approver = _tsv(
        f"{os.environ.get('USER', '?')}+{os.environ.get('CLAUDE_SESSION_ID', 'tty')}"
    )
    line = "\t".join(
        [utc_stamp(), action, ",".join(full), _tsv(a.note or ""), approver]
    )
    with path.open("a", encoding="utf-8") as fh:
        fh.write(line + "\n")
    print(f"{action}d {a.tree} {','.join(full)}")
    return 0


def _sha_match(stored: str, want: str, full: str) -> bool:
    """A ledger sha covers ``want``: exact, the rev-parse'd form, or a
    7+-char short sha."""
    return stored in (want, full) or (len(want) >= 7 and stored.startswith(want))


def cmd_approved(f: Fleet, a: argparse.Namespace) -> int:
    entries = _ledger_entries(_ledger_path(f, a.tree))
    rc = 0
    for want in a.shas.split(","):
        want = want.strip()
        if not want:
            continue
        full = _full_sha(want)
        last = ""
        for _stamp, action, shas, _note, _who in entries:
            if any(_sha_match(s, want, full) for s in shas):
                last = action
        if last == "approve":
            continue
        print(f"{'revoked' if last else 'missing'}: {want}")
        rc = 1
    if rc == 0:
        print(f"approved {a.tree} {a.shas}")
    return rc


# --- subcommands --------------------------------------------------------------


def cmd_peek(f: Fleet, a: argparse.Namespace) -> int:
    rc = 0
    for name in a.win or f.wave_windows():
        win = f.resolve(name)
        pane = f.capture(win) if win else None
        print(f"--- {win or name}")
        if pane is None:
            print("(no such window)")
            rc = 1
            continue
        for ln in nonempty_tail(pane, a.n):
            print(ln)
    return rc


def cmd_ctx(f: Fleet, _a: argparse.Namespace) -> int:
    out = f.tmux("list-panes", "-a", "-F", "#{pane_id}\t#{session_name}:#{window_name}")
    for line in out.splitlines():
        pane_id, _, label = line.partition("\t")
        if f.session and not label.startswith(f.session + ":"):
            continue
        pane = f.capture(pane_id)
        pct = ctx_percent(pane or "")
        if pct is not None:
            print(f"{label}\t{pct}%")
    return 0


def cmd_prompts(f: Fleet, _a: argparse.Namespace) -> int:
    for win in f.windows():
        pane = f.capture(win)
        kind = dialog_type(pane or "")
        if kind:
            print(f"{win}\t{kind}\t{dialog_command(pane or '')}")
    return 0


def _wait_out_compaction(
    f: Fleet, win: str, wait: float, poll: float
) -> tuple[str | None, bool]:
    """Latest pane capture once the pane stops compacting.

    ``(None, False)`` when the pane cannot be captured; ``(pane, True)``
    when ``wait`` expired with the compaction banner still up."""
    deadline = time.monotonic() + wait
    while True:
        pane = f.capture(win, escapes=True)
        if pane is None or not compacting(ANSI_RE.sub("", pane)):
            return pane, False
        if time.monotonic() >= deadline:
            return pane, True
        time.sleep(poll)


def _send_text(
    f: Fleet,
    win: str,
    text: str,
    *,
    wait: float,
    poll: float,
    retries: int,
    pause: float,
    refuse_ctx: int | None = None,
) -> tuple[int, str]:
    """Type ``text`` + Enter into ``win``; return ``(rc, note)``.

    rc 0 — sent (note ``sent`` or ``sent (retried Enter)``); 2 — the pane
    cannot be read; 3 — refused before typing (note is the reason:
    compacting, dialog open, unsent input, past ``refuse_ctx`` % ctx);
    4 — typed but the Enter could not be verified. Shared by
    ``send-line`` (which prints and passes ``refuse_ctx``) and
    ``ctx-guard`` (which acts on the rc and is never ceiling-gated — its
    send is the remediation).
    """
    # An Enter sent while the pane is compacting is swallowed — the text
    # lands in the input box but never submits (gr515698: a brief sat
    # idle ~30 min that way). Wait the compaction out before typing.
    pane, still = _wait_out_compaction(f, win, wait, poll)
    if pane is None:
        return 2, "cannot read pane"
    if still:
        return 3, f"still compacting after {wait:g}s"
    plain = ANSI_RE.sub("", pane)
    if dialog_type(plain):
        return 3, f"a dialog is open ({dialog_command(plain)})"
    if pending := unsent_input(pane):
        return 3, f"input box holds unsent text: {pending[:60]}"
    # Fresh instructions do not belong in a pane already at/past the ctx
    # ceiling (gr515267). Slash commands (/compact, /clear) are the
    # remediation and pass the gate.
    pct = ctx_percent(plain)
    if (
        refuse_ctx is not None
        and pct is not None
        and pct >= refuse_ctx
        and not text.lstrip().startswith("/")
    ):
        return (
            3,
            f"{pct}% ctx — at/past the {refuse_ctx}% ceiling; hand it the "
            "WIP+handoff with --force (/compact and /clear pass the gate)",
        )
    t = f.target(win)
    if len(text) > PASTE_MIN or "\n" in text:
        buf = f"fleet-wave-{os.getpid()}"
        f.tmux("set-buffer", "-b", buf, "--", text)
        f.tmux("paste-buffer", "-p", "-d", "-b", buf, "-t", t)
    else:
        f.tmux("send-keys", "-t", t, "-l", "--", text)
    # An Enter arriving with the text is swallowed by the paste: pause first.
    time.sleep(pause)
    f.tmux("send-keys", "-t", t, "Enter")
    # A compaction can also start between the check above and the Enter —
    # verify the box cleared and retry Enter a bounded number of times. A
    # busy pane or an open dialog means the agent took it (text typed on a
    # busy pane queues — Devin's `○` list, not the ❭ box — so a second
    # Enter would flush the queue early, not re-submit).
    note = "sent"
    for attempt in range(1 + retries):
        time.sleep(pause)
        pane, still = _wait_out_compaction(f, win, wait, poll)
        if pane is None or still:
            break  # cannot verify — window gone or compaction outlived --wait
        plain = ANSI_RE.sub("", pane)
        if not unsent_input(pane) or BUSY_RE.search(plain) or dialog_type(plain):
            return 0, note
        if attempt < retries:
            f.tmux("send-keys", "-t", t, "Enter")
            note = "sent (retried Enter)"
    return 4, "cannot confirm the Enter landed"


def cmd_send_line(f: Fleet, a: argparse.Namespace) -> int:
    win = f.resolve(a.win)
    if not win:
        print(f"fleet-wave: no window {a.win}", file=sys.stderr)
        return 2
    rc, note = _send_text(
        f,
        win,
        a.text,
        wait=a.wait,
        poll=a.poll,
        retries=a.retries,
        pause=a.pause,
        # --force is how the handoff instruction itself is delivered
        # through this command once a pane is over the ceiling.
        # Namespaces built in code (reassign, handoff-wait) carry no force.
        refuse_ctx=None if getattr(a, "force", False) else CTX_HARD,
    )
    if rc == 0:
        print(f"{note}: {win}")
    elif rc == 2:
        print(f"fleet-wave: cannot read {win}", file=sys.stderr)
    elif rc == 3:
        print(f"REFUSED {win}: {note}")
    else:
        print(
            f"UNVERIFIED {win}: {note} — check the "
            "window and submit it by hand if the text still sits in the box",
            file=sys.stderr,
        )
    return rc


def _fill_footer(text: str, fills: dict[str, str]) -> str:
    missing = sorted({m for m in PLACEHOLDER_RE.findall(text) if not fills.get(m)})
    if missing:
        raise SystemExit(
            "fleet-wave: footer placeholders unfilled: "
            + ", ".join(missing)
            + " (flags --coordinator/--release-owner/--approval or FLEET_* env)"
        )
    return PLACEHOLDER_RE.sub(lambda m: fills[m.group(1)], text)


def _legacy_footers() -> bool:
    return os.environ.get("FLEET_LEGACY_FOOTERS", "") == "1"


def _footer_template(f: Fleet, tier: str) -> str:
    """Generated tier footer plus the builder workflow; the pre-v2
    footers/<readonly|qland>.txt under FLEET_LEGACY_FOOTERS=1."""
    fleet = f.repo / ".claude" / "fleet"
    if _legacy_footers():
        legacy = fleet / "footers" / f"{LEGACY_FOOTER[tier]}.txt"
        return legacy.read_text(encoding="utf-8")
    gen = (fleet / "generated" / f"footer-{tier}.txt").read_text(encoding="utf-8")
    body = [ln for ln in gen.splitlines() if not ln.startswith("# GENERATED")]
    workflow = (fleet / "builder-workflow.txt").read_text(encoding="utf-8")
    return "\n".join(body) + "\n" + workflow


def _ensure_tree(f: Fleet, name: str) -> Path:
    """Create the builder worktree before the agent starts, the way
    ``claude -w`` and scripts/devin-tree would (both reuse an existing
    tree), so its permission files are in place at session start."""
    tree = f.worktrees / name
    if tree.is_dir():
        return tree
    branch = f"worktree-{name}"
    git("fetch", "-q", "origin", "main", cwd=f.main)
    has_branch = subprocess.run(
        ["git", "show-ref", "-q", "--verify", f"refs/heads/{branch}"],
        cwd=f.main,
        check=False,
    )
    add = ["git", "worktree", "add", "-q"]
    add += (
        [str(tree), branch]
        if has_branch.returncode == 0
        else ["-b", branch, str(tree), "origin/main"]
    )
    proc = subprocess.run(
        add, cwd=f.main, capture_output=True, text=True, encoding="utf-8", check=False
    )
    if proc.returncode:
        raise SystemExit(f"fleet-wave: worktree add {name}: {proc.stderr.strip()}")
    # Seed .venv from the main checkout so a builder's first `uv run`
    # reuses it instead of installing ~160 packages mid-task (gr514738).
    seed = subprocess.run(
        [str(SCRIPTS / "seed-worktree-venv"), str(tree), str(f.main)],
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if seed.returncode:
        print(
            f"fleet-wave: venv seed for {name} failed; first uv run builds it: "
            f"{seed.stderr.strip()}"
        )
    return tree


def _apply_authority(tier: str, tree: Path) -> str:
    """Run scripts/fleet-authority apply on ``tree``; return its Codex flags."""
    argv = [str(SCRIPTS / "fleet-authority"), "apply", "--tier", tier]
    argv += ["--to", str(tree), "--yes"]
    proc = subprocess.run(
        argv,
        cwd=SCRIPTS.parent,
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if proc.returncode:
        raise SystemExit(f"fleet-wave: authority apply refused: {proc.stderr.strip()}")
    flags = [ln for ln in proc.stdout.splitlines() if ln.startswith("codex-flags: ")]
    return flags[-1].removeprefix("codex-flags: ") if flags else ""


# --- spec claims (gr509461) ------------------------------------------------

#: ``docs/backlog/<slug>.md`` mentions in a brief — direct children only:
#: ``threads/`` files sequence work, they are never a builder's spec.
_SPEC_REF_RE = re.compile(r"docs/backlog/([A-Za-z0-9][A-Za-z0-9._-]*)\.md")
#: Sha-shaped tokens in a brief (7–40 hex chars, at least one digit). One
#: that resolves to a commit but is not an ancestor of origin/main cites
#: unlanded or squash-landed work (gr515489, gr515506); launch warns.
_BRIEF_SHA_RE = re.compile(r"\b(?=[0-9a-f]*[0-9])[0-9a-f]{7,40}\b")
_BRIEF_SHA_MAX = 20
_NON_SPEC_STEMS = frozenset({"readme", "template", "index"})
#: Leading ``--- … ---`` front-matter block (same shape as the fixer's
#: intake parser — kept local, fleet-wave is a standalone script).
_FM_RE = re.compile(r"\A(---\s*\n)(.*?)(\n---\s*\n)", re.DOTALL)


def _git_rc(*argv: str, cwd: Path) -> int:
    """rc-only git call — :func:`git` can't tell empty stdout from failure."""
    return subprocess.run(
        ["git", *argv],
        capture_output=True,
        text=True,
        encoding="utf-8",
        cwd=cwd,
        check=False,
    ).returncode


def _spec_slugs(brief: str) -> list[str]:
    """docs/backlog spec slugs a brief names, deduped in mention order."""
    out: list[str] = []
    for m in _SPEC_REF_RE.finditer(brief):
        slug = m.group(1)
        if slug.lower() not in _NON_SPEC_STEMS and slug not in out:
            out.append(slug)
    return out


def _warn_brief_shas(f: Fleet, brief: str) -> None:
    """Warn (never block) on brief-cited commits not on origin/main."""
    if not git("rev-parse", "--verify", "-q", "origin/main", cwd=f.main).strip():
        return
    seen: set[str] = set()
    for tok in _BRIEF_SHA_RE.findall(brief):
        if tok in seen:
            continue
        seen.add(tok)
        if len(seen) > _BRIEF_SHA_MAX:
            break
        rev = git(
            "rev-parse", "--verify", "-q", f"{tok}^{{commit}}", cwd=f.main
        ).strip()
        if not rev:
            continue
        if _git_rc("merge-base", "--is-ancestor", rev, "origin/main", cwd=f.main):
            print(
                f"fleet-wave: brief cites {tok} — not on origin/main "
                "(unlanded or squash-landed); cite landed commits and "
                "base the builder on origin/main",
                file=sys.stderr,
            )


def _claimed_by(text: str) -> str | None:
    """The ``claimed-by:`` front-matter value, or None."""
    m = _FM_RE.match(text)
    if not m:
        return None
    for ln in m.group(2).splitlines():
        key, _, value = ln.partition(":")
        if key.strip().lower() == "claimed-by":
            return value.strip() or None
    return None


def _flip_spec(text: str, name: str, *, claim: bool) -> str | None:
    """Rewrite a spec's front matter for a claim (or unclaim); None if n/a.

    Claim: ``status: ready`` → ``status: in-progress`` with a
    ``claimed-by: <name>`` line right under it — the file is the claim's
    source of truth (the claims.tsv ledger is history only). Unclaim:
    only when ``status: in-progress`` AND ``claimed-by: <name>`` both
    hold — a spec re-claimed to someone else, re-stated by hand, or
    otherwise touched is left exactly as found.
    """
    m = _FM_RE.match(text)
    if not m:
        return None
    lines = m.group(2).splitlines()
    status_i = next(
        (i for i, ln in enumerate(lines) if ln.split(":")[0].strip() == "status"),
        -1,
    )
    if status_i < 0:
        return None
    status = lines[status_i].split(":", 1)[1].strip().strip("'\"")
    if claim:
        if status != "ready":
            return None
        lines[status_i] = "status: in-progress"
        lines.insert(status_i + 1, f"claimed-by: {name}")
    else:
        claimed_i = next(
            (
                i
                for i, ln in enumerate(lines)
                if ln.partition(":")[0].strip().lower() == "claimed-by"
                and ln.partition(":")[2].strip() == name
            ),
            -1,
        )
        if status != "in-progress" or claimed_i < 0:
            return None
        lines[status_i] = "status: ready"
        del lines[claimed_i]
    return m.group(1) + "\n".join(lines) + m.group(3) + text[m.end() :]


def _claims_ledger(f: Fleet) -> Path:
    return f.state / "claims.tsv"


def _ledger_append(f: Fleet, action: str, name: str, slug: str) -> None:
    path = _claims_ledger(f)
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fh.write(
            "\t".join([utc_stamp(), action, _tsv(name), f"docs/backlog/{slug}.md"])
            + "\n"
        )


def _sync_main(f: Fleet, what: str) -> bool:
    """Bring the primary's local main forward to origin/main; False if unsafe.

    Claim commits must be cut on the current tip — committing on a stale
    local main could revert upstream edits to the same spec, and pushing
    would carry any unpushed local commits along.
    """
    main = f.main
    if git("symbolic-ref", "--quiet", "--short", "HEAD", cwd=main).strip() != "main":
        print(f"fleet-wave: primary not on main — {what} skipped", file=sys.stderr)
        return False
    _git_rc("fetch", "-q", "origin", "main", cwd=main)
    if not git("rev-parse", "--verify", "-q", "origin/main", cwd=main).strip():
        return True  # no origin/main ref (a remote-less repo): local main is the tip
    if _git_rc("merge", "--ff-only", "-q", "origin/main", cwd=main) != 0:
        print(
            f"fleet-wave: local main not fast-forwardable — {what} skipped",
            file=sys.stderr,
        )
        return False
    if git("rev-list", "--count", "origin/main..HEAD", cwd=main).strip() != "0":
        print(
            f"fleet-wave: local main has unpushed commits — {what} skipped",
            file=sys.stderr,
        )
        return False
    return True


def _commit_to_main(f: Fleet, rel_paths: list[str], msg: str) -> bool:
    """Stage ``rel_paths`` in the primary checkout, commit on main, push.

    The flip must reach origin/main: left unpushed it would diverge local
    main (breaking scripts/ship's ``merge --ff-only`` sync) and stay
    invisible to other checkouts. Local-only when no ``origin`` remote is
    configured (tests). A push that loses a race gets one fetch + rebase
    + retry; on failure the commit AND the worktree edits are rolled
    back — local main is never left ahead or dirty from a claim.
    """
    main = f.main
    if (
        _git_rc("add", "--", *rel_paths, cwd=main) != 0
        or _git_rc("commit", "-q", "-m", msg, cwd=main) != 0
    ):
        print(f"fleet-wave: nothing committed for {msg!r}", file=sys.stderr)
        return False
    if not git("remote", "get-url", "origin", cwd=main).strip():
        return True
    if _git_rc("push", "-q", "origin", "HEAD:main", cwd=main) == 0:
        return True
    if (
        _git_rc("fetch", "-q", "origin", "main", cwd=main) == 0
        and _git_rc("rebase", "-q", "origin/main", cwd=main) == 0
        and _git_rc("push", "-q", "origin", "HEAD:main", cwd=main) == 0
    ):
        return True
    _git_rc("rebase", "--abort", cwd=main)
    _git_rc("reset", "-q", "--mixed", "HEAD~1", cwd=main)
    _git_rc("checkout", "-q", "--", *rel_paths, cwd=main)
    print(f"fleet-wave: push to main failed — {msg!r} rolled back", file=sys.stderr)
    return False


def _claim_specs(f: Fleet, name: str, brief: str) -> list[str]:
    """Flip brief-named ``ready`` specs to ``in-progress`` + ``claimed-by``.

    One commit on main per launch (pushed), plus claims.tsv rows. A spec
    that is missing, not ``ready``, or dirty in the primary checkout is
    skipped — a failed claim warns but never blocks the launch (the
    inflight purpose/branch check in the fixer still covers the tree).
    """
    if not _sync_main(f, "spec claim"):
        return []
    flips: list[tuple[str, str, str]] = []  # (slug, rel path, new text)
    for slug in _spec_slugs(brief):
        rel = f"docs/backlog/{slug}.md"
        path = f.main / "docs" / "backlog" / f"{slug}.md"
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        flipped = _flip_spec(text, name, claim=True)
        if flipped is None:
            continue
        if git("status", "--porcelain", "--", rel, cwd=f.main).strip():
            print(f"fleet-wave: {rel} dirty in primary — not claimed", file=sys.stderr)
            continue
        flips.append((slug, rel, flipped))
    if not flips:
        return []
    for slug, rel, flipped in flips:
        (f.main / "docs" / "backlog" / f"{slug}.md").write_text(
            flipped, encoding="utf-8"
        )
    rels = [rel for _slug, rel, _flipped in flips]
    msg = f"chore(backlog): claim {', '.join(s for s, _r, _f in flips)} for {name}"
    if not _commit_to_main(f, rels, msg):
        _git_rc("checkout", "-q", "--", *rels, cwd=f.main)
        return []
    for slug, _rel, _flipped in flips:
        _ledger_append(f, "claim", name, slug)
    print(f"claimed for {name}: {', '.join(s for s, _r, _f in flips)}")
    return [s for s, _r, _f in flips]


def _release_claims(f: Fleet, name: str) -> list[str]:
    """Flip ``name``'s claimed specs back to ``ready``; the un-claim half.

    Driven by the files themselves (``claimed-by: <name>`` + still
    ``in-progress``), not the ledger — a spec that shipped (deleted) or
    moved on is simply absent. Called from ``close`` on both removal
    paths: the tree got reaped by hand (``no tree``) or was just removed
    here (an abandoned builder lands nothing, so its claim must not
    starve the fixer and later waves forever).
    """
    if not _sync_main(f, "spec unclaim"):
        return []
    flips: list[tuple[str, str, str]] = []
    for path in sorted((f.main / "docs" / "backlog").glob("*.md")):
        try:
            text = path.read_text(encoding="utf-8")
        except OSError:
            continue
        if _claimed_by(text) != name:
            continue
        flipped = _flip_spec(text, name, claim=False)
        if flipped is None:
            continue
        rel = f"docs/backlog/{path.name}"
        if git("status", "--porcelain", "--", rel, cwd=f.main).strip():
            print(f"fleet-wave: {rel} dirty in primary — not released", file=sys.stderr)
            continue
        flips.append((path.stem, rel, flipped))
    if not flips:
        return []
    for _slug, rel, flipped in flips:
        (f.main / rel).write_text(flipped, encoding="utf-8")
    rels = [rel for _slug, rel, _flipped in flips]
    slugs = [s for s, _r, _f in flips]
    msg = f"chore(backlog): unclaim {', '.join(slugs)} ({name} closed)"
    if not _commit_to_main(f, rels, msg):
        _git_rc("checkout", "-q", "--", *rels, cwd=f.main)
        return []
    for slug in slugs:
        _ledger_append(f, "release", name, slug)
    print(f"unclaimed {name}: {', '.join(slugs)}")
    return slugs


def _mark_claim_purpose(f: Fleet, name: str, claimed: list[str]) -> None:
    """Seed the new tree's ``.claude/purpose`` with the claim.

    The inflight PURPOSE column — and through it the fixer's claim check
    — sees the claim from the moment the tree exists, before the builder
    writes its own purpose line. Never overwrites an existing purpose
    (a reused tree's own line wins); a tree that doesn't exist yet
    (legacy-footer launches) is skipped.
    """
    if not claimed:
        return
    tree = f.worktrees / name
    purpose = tree / ".claude" / "purpose"
    if not tree.is_dir() or purpose.exists():
        return
    purpose.parent.mkdir(parents=True, exist_ok=True)
    specs = ", ".join(f"docs/backlog/{s}.md" for s in claimed)
    purpose.write_text(
        f"{name}: building {specs} (fleet-wave claim)\n", encoding="utf-8"
    )


def _gripe_fix_cmd() -> list[str]:
    """The ``precis gripe-fix`` command prefix: prod by default (the loop's
    state is on the prod gripes), ``FLEET_GRIPE_FIX_CMD`` for a test fake."""
    override = os.environ.get("FLEET_GRIPE_FIX_CMD", "")
    if override:
        return shlex.split(override)
    return [str(SCRIPTS / "prod-precis"), "gripe-fix"]


def _render_batch_brief(f: Fleet, slug: str, win: str) -> Path:
    """Write the batch dossier to ``<state>/<win>.brief.md`` and return it."""
    if not re.fullmatch(r"[a-z0-9][a-z0-9._-]{0,63}", slug):
        raise SystemExit(f"fleet-wave: bad batch slug {slug!r}")
    f.state.mkdir(parents=True, exist_ok=True)
    out = f.state / f"{win}.brief.md"
    proc = subprocess.run(
        [*_gripe_fix_cmd(), "brief", slug, "--out", str(out)],
        capture_output=True,
        text=True,
        encoding="utf-8",
        check=False,
    )
    if proc.returncode or not out.is_file():
        raise SystemExit(
            f"fleet-wave: gripe-fix brief {slug} failed: "
            f"{(proc.stderr or proc.stdout).strip()[:200]}"
        )
    return out


def _assign_batch(slug: str, *, win: str, name: str, vendor: str) -> None:
    """Record host/session/tree on the batch's gripes; a refusal is reported."""
    host = socket.gethostname().split(".")[0]
    argv = [*_gripe_fix_cmd(), "assign", slug, "--host", host]
    argv += ["--session", f"{vendor}:{win}", "--tree", name]
    proc = subprocess.run(
        argv, capture_output=True, text=True, encoding="utf-8", check=False
    )
    if proc.returncode:
        print(
            f"fleet-wave: assign {slug} not recorded: "
            f"{(proc.stderr or proc.stdout).strip()[:200]}",
            file=sys.stderr,
        )
    else:
        print(f"assigned batch {slug}: {proc.stdout.strip().splitlines()[0][:120]}")


def cmd_launch(f: Fleet, a: argparse.Namespace) -> int:
    name = a.name
    if not re.fullmatch(r"[A-Za-z0-9._-]+", name):
        print(f"fleet-wave: bad tree name {name!r}", file=sys.stderr)
        return 2
    if bool(a.brief) == bool(a.batch):
        print(
            "fleet-wave: launch takes exactly one of --brief FILE / --batch SLUG",
            file=sys.stderr,
        )
        return 2
    if a.devin and a.codex:
        print("fleet-wave: --devin and --codex are exclusive", file=sys.stderr)
        return 2
    vendor = "devin" if a.devin else "codex" if a.codex else "claude"
    win = f"{vendor}-{name}"
    if win in f.windows():
        print(f"exists: {win}")
        return 0
    if a.batch:
        if a.dry_run:
            print(
                " ".join(
                    [
                        *_gripe_fix_cmd(),
                        "brief",
                        a.batch,
                        "--out",
                        "<state>/" + win + ".brief.md",
                    ]
                )
            )
            print(
                " ".join(
                    [
                        *_gripe_fix_cmd(),
                        "assign",
                        a.batch,
                        "--host",
                        "<host>",
                        "--session",
                        f"{vendor}:{win}",
                        "--tree",
                        name,
                    ]
                )
            )
        else:
            a.brief = str(_render_batch_brief(f, a.batch, win))
    tier = TIER_ALIASES.get(a.tier, a.tier)
    if a.codex and tier != "W":
        print(
            f"fleet-wave: REFUSED --codex at tier {tier}: its codex flags are a "
            "read-only sandbox, which cannot commit. next: fleet-wave launch "
            f"{name} --codex --tier W ...",
            file=sys.stderr,
        )
        return 2
    fills = {
        "coordinator": a.coordinator or os.environ.get("FLEET_COORDINATOR", ""),
        "release_owner": a.release_owner or os.environ.get("FLEET_RELEASE_OWNER", ""),
        "approval": a.approval or os.environ.get("FLEET_APPROVAL", ""),
    }
    footer = _fill_footer(_footer_template(f, tier), fills)
    brief = (
        Path(a.brief).read_text(encoding="utf-8").rstrip("\n")
        if a.brief
        else f"<batch {a.batch} dossier, rendered at launch>"
    )
    _warn_brief_shas(f, brief)
    text = f"{brief}\n{footer}"
    f.state.mkdir(parents=True, exist_ok=True)
    prompt_file = f.state / f"{win}.prompt"
    prompt_file.write_text(text, encoding="utf-8")
    codex = ""
    if a.dry_run:
        print(f"fleet-authority apply --tier {tier} --to {f.worktrees / name} --yes")
    elif not _legacy_footers():
        codex = _apply_authority(tier, _ensure_tree(f, name))
    if not a.dry_run:
        _mark_claim_purpose(f, name, _claim_specs(f, name, brief))
    if a.devin:
        argv = [
            str(f.repo / "scripts" / "devin-tree"),
            name,
            "--prompt-file",
            str(prompt_file),
            # Reto ruling me499092: wave Devins always launch in bypass.
            "--permission-mode",
            LAUNCH_PERMISSION_MODE["devin"],
        ]
        # Fleet waves always get a tmux window; devin-tree defaults to
        # running in the calling terminal.
        argv += ["--tmux"] + ([f.session] if f.session else [])
        if f.model_set:
            argv += ["--model", f.model_set]
        if a.dry_run:
            print(" ".join(argv))
            return 0
        rc = subprocess.run(argv, check=False).returncode
        if rc == 0 and a.batch:
            _assign_batch(a.batch, win=win, name=name, vendor=vendor)
        return rc
    if a.codex:
        return _launch_codex(
            f, a, name=name, win=win, tier=tier, text=text, codex_flags=codex
        )
    # -e lands in the pane env, so the agent AND the hook processes it
    # spawns inherit: lane read-only gits skip the index refresh (gr541144).
    tmux_argv = [
        "new-window",
        "-d",
        "-n",
        win,
        "-c",
        str(f.main),
        "-e",
        "GIT_OPTIONAL_LOCKS=0",
    ]
    if f.session:
        tmux_argv[2:2] = ["-t", f"={f.session}:"]
    claude = [
        "claude",
        "-w",
        name,
        "--model",
        f.model,
        "--permission-mode",
        LAUNCH_PERMISSION_MODE["claude"],
        text,
    ]
    if a.dry_run:
        print(" ".join([*tmux_argv, "--", *claude[:-1], f"<{len(text)} chars>"]))
        return 0
    f.tmux(*tmux_argv, "--", *claude)
    print(f"launched {win} ({f.model}, tier {tier}, prompt {prompt_file})")
    if codex:
        print(f"codex flags for tier {tier}: {codex}")
    if a.batch:
        _assign_batch(a.batch, win=win, name=name, vendor=vendor)
    return 0


_CODEX_NOTE = (
    "\n\nYou have NO precis MCP access in this session (approval=never refuses "
    "it), and your sandbox writes only inside this tree — scripts/board, "
    "scripts/fleet panes, gh and git add/commit all fail; do not call them "
    "(read-only git status/diff/log is fine). Do not try MCP tools; use the "
    "repo, scripts/ and git only. Report status with one line in "
    ".claude/purpose plus details in scratch/handoff.txt — the coordinator "
    "relays status, fetches CI logs and commits. Use "
    "UV_CACHE_DIR=/tmp/codex-uv-{name} for every uv/scripts call; never put a "
    "cache inside the tree. Do not run scripts/test; write tests and run "
    "ruff, the coordinator runs the tests.\n"
)


def _launch_codex(
    f: Fleet,
    a: argparse.Namespace,
    *,
    name: str,
    win: str,
    tier: str,
    text: str,
    codex_flags: str,
) -> int:
    """Window ``codex-NAME`` over a locked worktree reading
    ``scratch/codex-brief.md`` (the launch-codex.sh recipe)."""
    tree = f.worktrees / name
    # Same pane-env export as the claude lane above (gr541144).
    tmux_argv = [
        "new-window",
        "-d",
        "-n",
        win,
        "-c",
        str(tree),
        "-e",
        "GIT_OPTIONAL_LOCKS=0",
    ]
    if f.session:
        tmux_argv[2:2] = ["-t", f"={f.session}:"]
    if a.dry_run:
        flags = codex_flags or f"<codex-flags for tier {tier}>"
        print(" ".join([*tmux_argv, _codex_cmd(flags)]))
        return 0
    # The legacy-footer path skips the authority apply in cmd_launch; the
    # tree and the tier's flags are needed here either way.
    _ensure_tree(f, name)
    if not codex_flags:
        codex_flags = _apply_authority(tier, tree)
    if not codex_flags:
        print(
            f"fleet-wave: REFUSED {win}: no codex flags for tier {tier}",
            file=sys.stderr,
        )
        return 3
    _git_rc("worktree", "lock", "--reason", f"codex builder {name} (fleet-wave)",
            str(tree), cwd=f.main)  # fmt: skip
    if not _tree_locked(f, tree):
        print(
            f"fleet-wave: REFUSED {win}: could not lock {tree} (the reaper deletes "
            "an unlocked sessionless tree); git worktree lock it and relaunch",
            file=sys.stderr,
        )
        return 3
    (tree / "scratch").mkdir(parents=True, exist_ok=True)
    (tree / "scratch" / "codex-brief.md").write_text(
        text + _CODEX_NOTE.format(win=win, name=name), encoding="utf-8"
    )
    f.tmux(*tmux_argv, _codex_cmd(codex_flags))
    # codex exits at once on a flag it rejects; the window dies with it.
    # Say "launched" and record the builder only for a window still up.
    time.sleep(a.settle)
    if f.capture(win) is None:
        print(
            f"fleet-wave: REFUSED {win}: window gone within {a.settle:g}s — codex "
            f"exited (flags: {codex_flags}); run the command by hand to see why",
            file=sys.stderr,
        )
        return 3
    print(f"launched {win} (codex, tier {tier}, locked tree {tree})")
    if a.batch:
        _assign_batch(a.batch, win=win, name=name, vendor="codex")
    return 0


def _codex_cmd(flags: str) -> str:
    return f"codex {flags} 'Read scratch/codex-brief.md and do exactly what it says.'"


def _tree_locked(f: Fleet, tree: Path) -> bool:
    """Whether ``git worktree list --porcelain`` shows ``tree`` locked."""
    cur = ""
    for ln in git("worktree", "list", "--porcelain", cwd=f.main).splitlines():
        if ln.startswith("worktree "):
            cur = ln[len("worktree ") :]
        elif ln.startswith("locked") and Path(cur).resolve() == tree.resolve():
            return True
    return False


def _send(f: Fleet, win: str, text: str, *, pause: float = 1.0) -> int:
    """``send-line`` as a call: the same checks (dialog, unsent text,
    compaction) and the same swallowed-Enter retry."""
    ns = argparse.Namespace(
        win=win, text=text, wait=90.0, poll=2.0, retries=2, pause=pause
    )
    return cmd_send_line(f, ns)


_HANDOFF_RE = re.compile(r"^\s*[⏺•]?\s*DONE-HANDOFF\s*$", re.MULTILINE)
_RESUME_TEXT = (
    "Resume your batch in this tree. Read your handoff first (the gripes' "
    "view='fix', or the handoff file you wrote), then the brief for the rules "
    "and the finish-message format. Don't redo anything the handoff marks "
    "done. Commit each piece as soon as it is green. Use scripts/test, never "
    "bare pytest. Stop at 70% context with a commit and a handoff."
)


def cmd_handoff_wait(f: Fleet, a: argparse.Namespace) -> int:
    """One line per builder resumed (``/clear`` + the resume line once its
    pane shows a bare ``DONE-HANDOFF`` and no spinner) or timed out."""
    pending = list(a.names)
    start = time.monotonic()
    resume = a.resume or _RESUME_TEXT
    for k, _ in enumerate(_ticks(a)):
        if k:
            time.sleep(a.interval)
        if not pending:
            break
        left: list[str] = []
        for name in pending:
            win = f.resolve(name)
            pane = f.capture(win) if win else None
            if pane is None:
                print(f"GONE {name}")
                continue
            tail = "\n".join(nonempty_tail(pane, 15))
            if _HANDOFF_RE.search(tail) and not BUSY_RE.search(tail):
                assert win is not None
                if _send(f, win, "/clear", pause=a.pause) != 0:
                    # send-line printed why (dialog open, unsent text,
                    # compacting); the resume line waits for the next tick.
                    print(f"HELD {name}: /clear not sent; retrying next tick")
                    left.append(name)
                    continue
                time.sleep(a.pause)
                if _send(f, win, resume, pause=a.pause) != 0:
                    print(f"HELD {name}: cleared but the resume line was not sent")
                    left.append(name)
                    continue
                print(f"resumed {name} from handoff")
            elif time.monotonic() - start > a.timeout_min * 60:
                print(f"TIMEOUT {name}: no DONE-HANDOFF after {a.timeout_min} min")
            else:
                left.append(name)
        pending = left
    return 0


def cmd_reassign(f: Fleet, a: argparse.Namespace) -> int:
    """``/clear`` a builder and point it at a new brief or batch."""
    if bool(a.brief) == bool(a.batch):
        print("fleet-wave: reassign takes exactly one of --brief FILE / --batch SLUG",
              file=sys.stderr)  # fmt: skip
        return 2
    win = f.resolve(a.name)
    if not win:
        print(f"fleet-wave: no window {a.name}", file=sys.stderr)
        return 2
    vendor = win.split("-", 1)[0]
    name = win.split("-", 1)[1]
    brief = a.brief or str(_render_batch_brief(f, a.batch, win))
    if rc := _send(f, win, "/clear", pause=a.pause):
        return rc
    time.sleep(a.pause)
    if rc := _send(f, win, f"Read {brief} and do it.", pause=a.pause):
        return rc
    if a.batch:
        _assign_batch(a.batch, win=win, name=name, vendor=vendor)
    print(f"reassigned {win} -> {brief}")
    return 0


def cmd_cites(f: Fleet, a: argparse.Namespace) -> int:
    """Unlanded branch commits (not on origin/main) naming each gripe id —
    is it already built somewhere before a new builder starts on it?"""
    for gid in a.ids:
        gid = gid.strip().removeprefix("gr")
        hits = git(
            "log", "--branches", "--not", "origin/main", "--oneline",
            f"--grep={gid}", cwd=f.main,
        ).splitlines()[:5]  # fmt: skip
        print(f"== gr{gid}")
        for h in hits:
            print(h)
        if not hits:
            print("none")
    return 0


def _finish_line(f: Fleet, name: str) -> str:
    purpose = f.worktrees / name / ".claude" / "purpose"
    try:
        lines = purpose.read_text(encoding="utf-8").splitlines()
    except OSError:
        return ""
    hits = [ln for ln in lines if ln.startswith(f"{name} at ")]
    return hits[-1] if hits else ""


def _ticks(a: argparse.Namespace) -> Iterable[int]:
    return range(a.ticks) if a.ticks else itertools.count()


class _Digest:
    """Coalesce watcher events into one write (gr515152).

    Every stdout line a Monitor sees wakes the coordinator loop at full
    context, so a watcher holds non-urgent events until ``hold_s`` has
    passed since the first held one and prints them together; an urgent
    event (a permission prompt) flushes everything held at once. A later
    event for the same key replaces the held one, and ``drop`` removes it
    (the state flapped back before anything was printed). ``commit`` runs
    only once the line is out, so a killed watcher re-reports what it
    never printed.
    """

    def __init__(self, hold_s: float) -> None:
        self.hold_s = hold_s
        self.held: dict[str, tuple[str, bool, Callable[[], object]]] = {}
        self.since = 0.0

    def add(
        self, key: str, line: str, urgent: bool, commit: Callable[[], object]
    ) -> None:
        if not self.held:
            self.since = time.monotonic()
        self.held[key] = (line, urgent, commit)

    def drop(self, key: str) -> None:
        self.held.pop(key, None)

    def flush(self, *, final: bool = False) -> None:
        if not self.held:
            return
        urgent = any(u for _, u, _ in self.held.values())
        if not (final or urgent or time.monotonic() - self.since >= self.hold_s):
            return
        items, self.held = list(self.held.values()), {}
        print("\n".join(line for line, _, _ in items), flush=True)
        for _, _, commit in items:
            commit()


def cmd_watch_done(f: Fleet, a: argparse.Namespace) -> int:
    seen_dir = f.state / "watch-seen"
    seen_dir.mkdir(parents=True, exist_ok=True)
    digest = _Digest(a.digest_sec)
    for k, _ in enumerate(_ticks(a)):
        if k:
            time.sleep(a.interval)
        for name in a.names:
            line = _finish_line(f, name)
            seen = seen_dir / name
            old = seen.read_text(encoding="utf-8") if seen.exists() else ""
            if line and line != old:
                digest.add(
                    name,
                    f"DONE {utc_stamp()} {line[:160]}",
                    False,
                    lambda s=seen, ln=line: s.write_text(ln, encoding="utf-8"),
                )
            else:
                digest.drop(name)
        digest.flush()
    digest.flush(final=True)
    return 0


def _stuck_state(
    f: Fleet, name: str, win: str | None, quiet_s: int, requiet_s: int = 0
) -> tuple[str, str]:
    """``(key, text)``: the key decides whether the state changed, the text
    is what gets printed. A quiet pane keeps one key per ``requiet_s``
    bucket, so it is reported once and again only that much later — not
    every ten minutes (gr515152)."""
    pane = f.capture(win) if win else None
    if pane is None:
        return "gone", "gone"
    st_dir = f.state / "stuck-seen"
    digest = hashlib.sha256(pane.encode("utf-8")).hexdigest()[:12]
    hfile, tfile = st_dir / f"{name}.hash", st_dir / f"{name}.t"
    now = int(time.time())
    if not hfile.exists() or hfile.read_text(encoding="utf-8") != digest:
        hfile.write_text(digest, encoding="utf-8")
        tfile.write_text(str(now), encoding="utf-8")
    since = int(tfile.read_text(encoding="utf-8") or now) if tfile.exists() else now
    age = now - since
    if dialog_type(pane):
        cmd = "prompt: " + dialog_command(pane)[:80]
        return cmd, cmd
    if finish := _finish_line(f, name):
        return f"done {finish}", f"done: {finish[:160]}"
    if age > quiet_s:
        bucket = age // requiet_s if requiet_s else 0
        return f"quiet#{bucket}", f"quiet {age // 60}m"
    return "ok", "ok"


def cmd_stuck_watch(f: Fleet, a: argparse.Namespace) -> int:
    """One line per real change, batched: a state must hold for ``--settle``
    polls before it counts, quiet panes repeat only every ``--requiet-min``,
    and everything but a prompt waits up to ``--digest-sec`` to ride in one
    write with the others. ``done`` already carries the finish line, so
    this watcher alone covers ``watch-done``."""
    st_dir = f.state / "stuck-seen"
    st_dir.mkdir(parents=True, exist_ok=True)
    digest = _Digest(a.digest_sec)
    cand: dict[str, tuple[str, int]] = {}
    for k, _ in enumerate(_ticks(a)):
        if k:
            time.sleep(a.interval)
        names = a.names or [w.split("-", 1)[1] for w in f.wave_windows()]
        for name in names:
            win = f.resolve(name)
            key, text = _stuck_state(f, name, win, a.quiet_min * 60, a.requiet_min * 60)
            sfile = st_dir / f"{name}.st"
            old = sfile.read_text(encoding="utf-8") if sfile.exists() else ""
            if key == old:
                cand.pop(name, None)
                digest.drop(name)
                continue
            prev = cand.get(name)
            n = prev[1] + 1 if prev and prev[0] == key else 1
            cand[name] = (key, n)
            if n < a.settle:
                continue
            if key == "ok":
                sfile.write_text(key, encoding="utf-8")
                digest.drop(name)
                continue
            digest.add(
                name,
                f"{utc_stamp()} {win or name} {text}",
                key.startswith("prompt"),
                lambda s=sfile, v=key: s.write_text(v, encoding="utf-8"),
            )
        digest.flush()
    digest.flush(final=True)
    return 0


#: The instruction ctx-guard sends when --message/--message-file is not
#: given — the same three steps the GRIPE_FIX stopgap used (gr515267).
_CTX_GUARD_MESSAGE = (
    "You are past the context ceiling. Stop feature work now. Do only "
    "these three things, briefly:\n"
    "1. Commit the files you changed (wip(scope): <what>, naming the gripe).\n"
    "2. Write your handoff file: what is done and tested, what remains in "
    "order, failing tests and their causes.\n"
    "3. Reply DONE-HANDOFF.\n"
    "Do not run tests and do not read more files."
)


def _token_amount(s: str) -> int:
    """``120k``/``1.5M``/``120000`` → tokens; bad input is a usage error."""
    m = re.fullmatch(r"(\d+(?:\.\d+)?)\s*([kKmM]?)", s.strip())
    if not m:
        raise SystemExit(f"fleet-wave: bad token amount {s!r} (e.g. 120k)")
    mult = {"": 1, "k": 1_000, "m": 1_000_000}[m.group(2).lower()]
    return round(float(m.group(1)) * mult)


def _ctx_guard_message(a: argparse.Namespace) -> str:
    if a.message_file:
        return Path(a.message_file).read_text(encoding="utf-8").rstrip("\n")
    return a.message or ("/compact" if a.compact else _CTX_GUARD_MESSAGE)


def cmd_ctx_guard(f: Fleet, a: argparse.Namespace) -> int:
    """Nudge each watched pane once when its ctx reaches ``--ceiling``.

    The marker lives in ``$FLEET_STATE/ctx-guard/<name>`` — a successful
    send writes it; a pane that drops below ``--rearm`` (after a /clear)
    loses it and is armed again. A refused send retries on the next poll
    and reports each time: a guard that cannot deliver is itself worth a
    line. ``{name}`` in the message fills with the wave name.

    ``--tokens`` switches the trigger (and ``--rearm``) from ctx % to the
    absolute context size the pane prints (gr515153) and implies
    ``--compact``; a pane that prints no token figure is skipped.

    At or above ``--hard`` — the same line where send-line refuses fresh
    instructions — a ``<name>.hard`` marker makes the guard print one
    FORCED HANDOFF line per episode for the coordinator; it re-arms on
    the same ``--rearm`` drop. A pane that jumps straight past the
    ceiling still gets the instruction through ``_send_text``.
    """
    if a.tokens:
        a.tokens = _token_amount(a.tokens)
        a.compact = True
    trigger = a.tokens or a.ceiling
    if a.rearm is None:
        a.rearm = trigger // 2 if a.compact else 40
    if a.rearm >= trigger:
        print(
            f"fleet-wave: --rearm ({a.rearm}) must be below the trigger "
            f"({trigger}); the guard would oscillate",
            file=sys.stderr,
        )
        return 2
    st_dir = f.state / "ctx-guard"
    st_dir.mkdir(parents=True, exist_ok=True)
    text = _ctx_guard_message(a)
    said: dict[str, str] = {}
    for k, _ in enumerate(_ticks(a)):
        if k:
            time.sleep(a.interval)
        names = a.names or [w.split("-", 1)[1] for w in f.wave_windows()]
        for name in names:
            win = f.resolve(name)
            pane = f.capture(win) if win else None
            if pane is None:
                continue
            plain = ANSI_RE.sub("", pane)
            pct = ctx_percent(plain)
            fill = ctx_tokens(plain) if a.tokens else pct
            if fill is None:
                continue
            marker = st_dir / name
            hard = st_dir / f"{name}.hard"
            if fill < a.rearm:
                said.pop(name, None)
                marker.unlink(missing_ok=True)
                hard.unlink(missing_ok=True)
                continue
            if fill >= trigger and not marker.exists():
                tree = f.worktrees / name
                if a.compact:
                    if tree.is_dir() and _active_subagent_task(tree):
                        # /compact under a live subagent loses its result
                        continue
                    if BUSY_RE.search(plain):
                        # never /compact mid-turn (gr515153): the send
                        # would queue and fire at an arbitrary later
                        # point — retry on the next poll instead
                        continue
                rc, note = _send_text(
                    f,
                    win,
                    text.replace("{name}", name),
                    wait=a.wait,
                    poll=a.poll,
                    retries=2,
                    pause=a.pause,
                )
                # rc 4: text typed, Enter unconfirmed — count it as sent so
                # the guard neither resends nor nags every poll.
                if rc in (0, 4):
                    marker.write_text(f"{fill} {utc_stamp()}\n", encoding="utf-8")
                what = "/compact" if a.compact else "WIP+handoff"
                if rc == 0:
                    outcome = f"sent {what}"
                elif rc == 4:
                    outcome = f"sent {what}, UNVERIFIED ({note})"
                else:
                    outcome = f"send refused ({note})"
                level = f"{fill / 1000:g}k tokens" if a.tokens else f"{fill}%"
                # A refusal retries every poll; say it once per distinct
                # reason, not once per minute (gr515152).
                if rc in (0, 4) or said.get(name) != outcome:
                    print(
                        f"{utc_stamp()} ctx-guard: {win} at {level} — {outcome}",
                        flush=True,
                    )
                said[name] = outcome
            if pct is not None and pct >= a.hard and not hard.exists():
                hard.write_text(f"{pct} {utc_stamp()}\n", encoding="utf-8")
                print(
                    f"{utc_stamp()} ctx-guard: {win} at {pct}% — FORCED "
                    "HANDOFF — send-line refuses new instructions",
                    flush=True,
                )
    return 0


# --- event-watch (td570414) ---------------------------------------------------
#
# The reflexed watcher: routine pane events are handled by the script and
# logged to $FLEET_STATE/event-watch.log; only what needs the
# coordinator's judgment reaches stdout (and a Monitor wake-up).

#: Board states that always need judgment. Routine ones (landed, green,
#: waiting) stay silent — the coordinator already reads the board each
#: sweep. ``wedged`` rides with ``red``: a wedged builder is never routine.
_EW_ALERT_STATES = frozenset({"done", "red", "blocked", "wedged"})

#: Lines hashed for the frozen detector (same tail shape as
#: scripts/fleet-panes' FROZEN check).
_EW_TAIL_LINES = 12


def _resolve_in(wins: list[str], name: str) -> str | None:
    """``Fleet.resolve`` against an already-fetched window list."""
    if name in wins:
        return name
    return next((p + name for p in PREFIXES if p + name in wins), None)


#: The reflex log is rotated once past this size (one .1 generation).
_EW_LOG_MAX = 512_000


def _ew_log(
    f: Fleet,
    said: dict[tuple[str, str], str],
    name: str,
    reflex: str,
    detail: str,
) -> None:
    """One reflex action on the event-watch log — never on stdout, and
    only when the reason changed: a refused reflex retries every poll
    (ctx-guard's once-per-distinct-reason rule)."""
    if said.get((name, reflex)) == detail:
        return
    said[(name, reflex)] = detail
    path = f.state / "event-watch.log"
    path.parent.mkdir(parents=True, exist_ok=True)
    try:
        if path.stat().st_size > _EW_LOG_MAX:
            path.replace(path.with_name("event-watch.log.1"))
    except OSError:
        pass
    with path.open("a", encoding="utf-8") as fh:
        fh.write(f"{utc_stamp()}\t{name}\t{reflex}\t{_tsv(detail)}\n")


def _ew_mark_fresh(path: Path, cool_s: float) -> bool:
    """True while a per-pane reflex marker is younger than ``cool_s``."""
    try:
        stamp = path.read_text(encoding="utf-8").split()[-1]
        return time.time() - float(stamp) < cool_s
    except (OSError, ValueError, IndexError):
        return False


def _ew_mark_write(path: Path, stage: str) -> None:
    path.write_text(f"{stage} {int(time.time())}\n", encoding="utf-8")


def _ew_emit(
    name: str,
    win: str | None,
    st_dir: Path,
    digest: _Digest,
    key: str,
    text: str,
    *,
    urgent: bool = False,
) -> None:
    """Queue the pane's line for the batch. The ``<name>.st`` marker
    dedupes an unchanged event across polls and across restarts — the
    commit lands only once the line is actually out."""
    stfile = st_dir / f"{name}.st"
    old = stfile.read_text(encoding="utf-8").strip() if stfile.exists() else ""
    if key == old:
        return
    digest.add(
        name,
        f"{utc_stamp()} {win or name} {text}",
        urgent,
        lambda s=stfile, k=key: s.write_text(k + "\n", encoding="utf-8"),
    )


def _ew_calm(name: str, st_dir: Path, digest: _Digest) -> None:
    """No event this poll: drop a held line whose state flapped back
    before it printed (stuck-watch's rule) and reset the dedup key so the
    next episode fires."""
    digest.drop(name)
    stfile = st_dir / f"{name}.st"
    if stfile.exists():
        stfile.write_text("ok\n", encoding="utf-8")


# --- event-watch board source -------------------------------------------------
# The watcher's own byte cursor plus a pending file — `board read --new`
# advances on read, which loses held lines on a restart inside the digest
# window.


def _ew_board_path(f: Fleet) -> Path:
    """The board log — PRECIS_BOARD (tests), else the shared
    ``.claude/fleet/board.log`` of the main checkout, resolved the way
    scripts/board resolves it."""
    override = os.environ.get("PRECIS_BOARD", "").strip()
    return Path(override) if override else f.main / ".claude" / "fleet" / "board.log"


def _ew_board_new(f: Fleet, st_dir: Path) -> tuple[list[str], int | None]:
    """New whole board lines plus the offset they end at — ``board.pos``
    is the caller's to write *after* ``board.pending`` is saved, so a
    kill between the two cannot lose a line (None = board unreadable,
    nothing to write).

    The cursor is seeded at EOF on the first run (no history replay),
    reset to 0 on truncation (``scripts/board clear`` — board's own rule)
    and skipped to the next newline when it lands mid-line.
    """
    path = _ew_board_path(f)
    posfile = st_dir / "board.pos"
    try:
        size = path.stat().st_size
    except OSError:
        return [], None
    try:
        pos = int(posfile.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        pos = size
    if pos > size:
        pos = 0
    with path.open("rb") as fh:
        if pos:
            fh.seek(pos - 1)
            if fh.read(1) != b"\n":  # mid-line offset: skip to the next \n
                fh.seek(pos)
                nl = fh.read().find(b"\n")
                pos = size if nl < 0 else pos + nl + 1
        fh.seek(pos)
        data = fh.read()
    cut = data.rfind(b"\n") + 1  # a partial tail line waits for next poll
    return data[:cut].decode("utf-8", "replace").splitlines(), pos + cut


#: Held board lines age out after this many seconds or past this many
#: lines, whichever comes first — a poster that never surfaces is not
#: hoarded forever.
_EW_PENDING_AGE = 30 * 60
_EW_PENDING_MAX = 200


def _ew_pending_prune(
    f: Fleet,
    said: dict[tuple[str, str], str],
    keep: list[str],
) -> list[str]:
    """Drop held lines that will never match — older than their own
    timestamp plus ``_EW_PENDING_AGE``, or the oldest past the
    ``_EW_PENDING_MAX`` cap. Each drop is one line on the reflex log."""
    now = time.time()
    out = []
    for ln in keep:
        try:
            ts = datetime.fromisoformat(
                ln.partition("\t")[0].replace("Z", "+00:00")
            ).timestamp()
            old = now - ts > _EW_PENDING_AGE
        except ValueError:
            old = False
        if old:
            _ew_log(f, said, "board", "pending", f"aged out: {ln[:80]}")
        else:
            out.append(ln)
    for ln in out[:-_EW_PENDING_MAX] if len(out) > _EW_PENDING_MAX else []:
        _ew_log(f, said, "board", "pending", f"over cap: {ln[:80]}")
    return out[-_EW_PENDING_MAX:]


def _ew_pending(st_dir: Path) -> list[str]:
    try:
        return [
            ln
            for ln in (st_dir / "board.pending")
            .read_text(encoding="utf-8")
            .splitlines()
            if ln.strip()
        ]
    except OSError:
        return []


def _ew_pending_save(st_dir: Path, lines: list[str]) -> None:
    (st_dir / "board.pending").write_text(
        "".join(ln + "\n" for ln in lines), encoding="utf-8"
    )


def _ew_pending_drop(st_dir: Path, line: str) -> None:
    """The digest commit for a board line: it leaves pending only by
    actually printing."""
    _ew_pending_save(st_dir, [ln for ln in _ew_pending(st_dir) if ln != line])


def _ew_seen(st_dir: Path, bare: set[str]) -> set[str]:
    """Bare names a board poster can mean — every wave window seen while
    this watcher runs (a window that died keeps its board lines watched:
    its done/red is exactly what must not drop)."""
    path = st_dir / "seen.txt"
    try:
        seen = set(path.read_text(encoding="utf-8").split())
    except OSError:
        seen = set()
    if bare - seen:
        seen |= bare
        path.write_text(" ".join(sorted(seen)) + "\n", encoding="utf-8")
    return seen


def _ew_bare(poster: str) -> str:
    """A board poster's wave name: ``claude-x``/``devin-x``/``codex-x``
    strip to the bare tree name."""
    for p in PREFIXES:
        if poster.startswith(p):
            return poster[len(p) :]
    return poster


def _ew_board_poll(
    f: Fleet,
    st_dir: Path,
    watched: list[str],
    auto: bool,
    bare_wins: set[str],
    digest: _Digest,
    said: dict[tuple[str, str], str],
) -> None:
    """One board pass: consume new lines, queue alert lines from watched
    trees for the batch, hold the rest pending.

    With explicit NAMES only those posters match; auto mode matches every
    window the watcher has ever seen. Pending is saved before ``pos`` so
    a kill between the two re-reads the same bytes — deduped here — and
    a line still prints exactly once.
    """
    lines, new_pos = _ew_board_new(f, st_dir)
    known = _ew_seen(st_dir, bare_wins) if auto else set(watched)
    queue, keep, seen_ln = [], [], set()
    for ln in _ew_pending(st_dir) + lines:
        if ln in seen_ln:
            continue
        seen_ln.add(ln)
        _, _, rest = ln.partition("\t")
        poster, _, text = rest.partition("\t")
        words = text.split()
        if not (words and words[0] in _EW_ALERT_STATES):
            continue  # a routine line is consumed for good
        if _ew_bare(poster) in known:
            queue.append((poster, text, ln))
        elif auto:
            # Maybe a tree whose window is not up yet — hold it.
            keep.append(ln)
    # Pending = unprinted alert lines: the held queue plus what could not
    # be attributed. A printed line is dropped by its digest commit.
    keep = _ew_pending_prune(f, said, keep)
    _ew_pending_save(st_dir, keep + [ln for _, _, ln in queue])
    if new_pos is not None:
        (st_dir / "board.pos").write_text(str(new_pos), encoding="utf-8")
    for poster, text, ln in queue:
        digest.add(
            f"board:{ln}",
            f"{utc_stamp()} {poster} board: {text}",
            False,
            lambda ln=ln: _ew_pending_drop(st_dir, ln),
        )


def _ew_tail_age(name: str, pane: str, st_dir: Path) -> int:
    """Seconds since the pane's 12-line tail last changed (the
    fleet-panes frozen detector, kept per watcher under
    ``$FLEET_STATE/event-watch/``)."""
    tail = [ln for ln in pane.splitlines() if ln.strip()][-_EW_TAIL_LINES:]
    digest = hashlib.sha256("\n".join(tail).encode("utf-8")).hexdigest()[:12]
    hfile, tfile = st_dir / f"{name}.hash", st_dir / f"{name}.t"
    now = int(time.time())
    try:
        prev = hfile.read_text(encoding="utf-8")
    except OSError:
        prev = ""
    if prev != digest:
        hfile.write_text(digest, encoding="utf-8")
        tfile.write_text(str(now), encoding="utf-8")
        return 0
    try:
        return max(0, now - int(tfile.read_text(encoding="utf-8").strip()))
    except (OSError, ValueError):
        return 0


def _ew_send(f: Fleet, win: str, text: str, a: argparse.Namespace) -> tuple[int, str]:
    """A reflex's send: send-line's machinery (compaction wait, dialog and
    unsent-input refusal, Enter retry) without its printing."""
    return _send_text(f, win, text, wait=a.wait, poll=a.poll, retries=2, pause=a.pause)


def _ew_error(
    f: Fleet,
    a: argparse.Namespace,
    name: str,
    win: str,
    agent: str,
    plain: str,
    rep: PaneReport,
    st_dir: Path,
    digest: _Digest,
    err_n: dict[str, int],
    cool_s: float,
    said: dict[tuple[str, str], str],
) -> None:
    """An error pane: the devin quota reflex where it applies, else count
    polls and print once the reflexes have failed to clear it.

    A fresh marker only caps resends — it does not hide the error: the
    count keeps running and the pane still prints at ``--settle`` when
    the banner has not cleared. The marker records the stage (``model``
    = /model landed, ``done`` = resume landed) so a refused resume is
    retried on the next poll instead of re-sending /model.
    """
    if agent == "devin" and quota_banner(plain):
        marker = st_dir / f"quota-{name}"
        fresh = _ew_mark_fresh(marker, cool_s)
        stage = ""
        if fresh:
            stage = marker.read_text(encoding="utf-8").split()[0]
        on_high = devin_model(plain) == "swe-2-high"
        if not on_high:
            if fresh and stage == "model":
                owed = [a.resume]  # /model landed; the resume is still owed
            elif fresh:
                owed = []  # episode complete; only the cap is in force
            else:
                owed = ["/model swe-2-high", a.resume]
            for text in owed:
                rc, note = _ew_send(f, win, text, a)
                if rc not in (0, 4):
                    _ew_log(f, said, name, "quota", f"send refused ({note})")
                    _ew_emit(
                        name,
                        win,
                        st_dir,
                        digest,
                        f"reflex-fail:quota:{note}",
                        f"reflex failed: quota send refused ({note})",
                        urgent=True,
                    )
                    return
                stage = "model" if text.startswith("/") else "done"
                _ew_mark_write(marker, stage)
                _ew_log(
                    f,
                    said,
                    name,
                    "quota",
                    f"sent {text if text.startswith('/') else 'resume'}",
                )
                time.sleep(a.pause)
            if owed:
                # The send poll does not count — "uncleared within
                # --settle polls" means --settle polls after the send.
                return
        detail = (
            "quota exhausted (already swe-2-high)"
            if on_high
            else "quota exhausted (model switch sent)"
            if fresh
            else "quota exhausted"
        )
    else:
        detail = (rep.last or "error").strip()
    err_n[name] = err_n.get(name, 0) + 1
    if err_n[name] >= a.settle:
        _ew_emit(name, win, st_dir, digest, "error", f"error: {detail[:90]}")


def _ew_handoff(
    f: Fleet,
    a: argparse.Namespace,
    name: str,
    win: str,
    st_dir: Path,
    cool_s: float,
    said: dict[tuple[str, str], str],
) -> str:
    """``sent`` / ``cooldown`` / a failure note — the handoff-wait reflex.

    A bare DONE-HANDOFF gets ``/clear`` + the resume line through
    send-line's machinery. The marker caps it at once per pane per
    cooldown — the scrollback line outlives the episode, and a fresh
    DONE-HANDOFF needs a full context refill after the /clear anyway.
    """
    marker = st_dir / f"handoff-{name}"
    if _ew_mark_fresh(marker, cool_s):
        return "cooldown"
    for text in ("/clear", a.resume):
        rc, note = _ew_send(f, win, text, a)
        if rc not in (0, 4):
            _ew_log(f, said, name, "handoff", f"send refused ({note})")
            return note
        time.sleep(a.pause)
    _ew_mark_write(marker, "done")
    _ew_log(f, said, name, "handoff", "sent /clear + resume")
    return "sent"


def _ew_compact(
    f: Fleet,
    a: argparse.Namespace,
    name: str,
    win: str,
    rep: PaneReport,
    plain: str,
    st_dir: Path,
    digest: _Digest,
    said: dict[tuple[str, str], str],
) -> bool:
    """ctx-guard's /compact as a reflex: once per episode on an idle pane
    over the ctx threshold, never mid-turn, never under a live subagent
    task, re-armed below half the trigger. ctx-guard's own trigger: the
    token figure when ``--tokens`` is set, else the ceiling %; a pane
    printing no figure in that unit is left alone.

    True when a reflex-failure line was queued for the coordinator.
    """
    fill = ctx_tokens(plain) if a.tokens else rep.ctx
    if fill is None:
        return False
    trigger = a.tokens or a.ceiling
    marker = st_dir / f"compact-{name}"
    if fill < trigger // 2:
        marker.unlink(missing_ok=True)
        return False
    if fill < trigger or marker.exists():
        return False
    tree = f.worktrees / name
    if tree.is_dir() and _active_subagent_task(tree):
        # /compact under a live subagent loses its result.
        return False
    rc, note = _ew_send(f, win, "/compact", a)
    if rc in (0, 4):
        marker.write_text(f"{fill} {utc_stamp()}\n", encoding="utf-8")
        level = f"{fill / 1000:g}k tokens" if a.tokens else f"{fill}%"
        _ew_log(f, said, name, "compact", f"sent /compact at {level}")
        return False
    _ew_log(f, said, name, "compact", f"send refused ({note})")
    _ew_emit(
        name,
        win,
        st_dir,
        digest,
        f"reflex-fail:compact:{note}",
        f"reflex failed: compact send refused ({note})",
        urgent=True,
    )
    return True


def _ew_pane(
    f: Fleet,
    a: argparse.Namespace,
    name: str,
    win: str | None,
    st_dir: Path,
    digest: _Digest,
    err_n: dict[str, int],
    said: dict[tuple[str, str], str],
) -> None:
    """One watched pane per poll: run the routine reflexes silently, then
    queue the one line (if any) that needs the coordinator."""
    pane = f.capture(win) if win else None
    if pane is None:
        _ew_emit(name, win, st_dir, digest, "gone", "gone")
        return
    plain = ANSI_RE.sub("", pane)
    assert win is not None
    cmd, dead = f.pane_facts(win)
    agent = detect_agent(cmd, win)
    age = _ew_tail_age(name, plain, st_dir)
    rep = pane_report(
        agent, plain, command_running=not dead, frozen=age >= a.frozen_min * 60
    )
    cool_s = a.cooldown_min * 60
    if rep.dialog:
        _ew_emit(
            name,
            win,
            st_dir,
            digest,
            f"prompt:{rep.dialog}:{rep.command}",
            f"prompt ({rep.dialog}) {rep.command[:80]}",
            urgent=True,
        )
        return
    if rep.state == "error":
        _ew_error(
            f, a, name, win, agent, plain, rep, st_dir, digest, err_n, cool_s, said
        )
        return
    err_n.pop(name, None)
    if rep.state == "done":
        _ew_emit(name, win, st_dir, digest, "done", "done: agent exited")
        return
    tail = "\n".join(nonempty_tail(plain, 15))
    handoff_cool = False
    if _HANDOFF_RE.search(tail) and not BUSY_RE.search(tail):
        r = _ew_handoff(f, a, name, win, st_dir, cool_s, said)
        if r == "sent":
            _ew_calm(name, st_dir, digest)
            return
        if r == "cooldown":
            handoff_cool = True  # resumed already; still judge a wedge
        else:
            _ew_emit(
                name,
                win,
                st_dir,
                digest,
                f"reflex-fail:handoff:{r}",
                f"reflex failed: handoff send refused ({r})",
                urgent=True,
            )
            return
    if rep.state == "frozen":
        _ew_emit(name, win, st_dir, digest, "frozen", f"frozen {age // 60}m")
        return
    if rep.state == "idle" and not handoff_cool:
        if _ew_compact(f, a, name, win, rep, plain, st_dir, digest, said):
            return  # a failed reflex is already queued for the coordinator
    _ew_calm(name, st_dir, digest)


def cmd_event_watch(f: Fleet, a: argparse.Namespace) -> int:
    """Routine reflexes on the script, judgment events on stdout.

    Sources: unread board lines from the watched trees (the watcher's own
    ``board.pos`` byte cursor plus a ``board.pending`` file for alert
    lines not yet printed — the cursor seeds at EOF on the first run and
    a line leaves pending only by printing) and a ``fleet_panes``
    classification every ``--interval`` s — no LLM anywhere.

    Reflexes, each logged to ``$FLEET_STATE/event-watch.log`` and never
    printed:

    - a devin ``error`` on a quota-exhausted banner → ``/model
      swe-2-high`` + the resume line, once per pane per ``--cooldown-min``
      (a pane already on swe-2-high becomes an ordinary error event);
    - a bare DONE-HANDOFF → ``/clear`` + the resume line, the same
      once-per rule (handoff-wait's move);
    - an idle pane over the ctx threshold → ``/compact`` (ctx-guard's
      rules and trigger: the token figure when ``--tokens`` is set, else
      the ceiling %; never mid-turn, never under a live subagent task,
      re-armed below half the trigger).

    Printed — the Monitor lines that wake the coordinator — only: board
    done/red/blocked/wedged lines from the watched trees, a permission
    ``prompt``, an ``error`` the reflexes did not clear within
    ``--settle`` polls, ``frozen``, ``gone``, a dead agent (``done``) and
    a reflex that failed. Non-urgent lines batch up to ``--digest-sec``
    (default 30 s); a prompt or a failed reflex flushes at once.
    ``--triage`` is the hook point for a cheap-model first pass (e.g.
    haiku) vetting borderline lines before they print — not implemented.
    """
    a.resume = a.resume or _RESUME_TEXT
    a.tokens = _token_amount(a.tokens) if a.tokens else None
    st_dir = f.state / "event-watch"
    st_dir.mkdir(parents=True, exist_ok=True)
    # One watcher per state dir: the lock is held for the whole run.
    lock_fd = os.open(f.state / "event-watch.lock", os.O_RDWR | os.O_CREAT, 0o600)
    try:
        fcntl.flock(lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except OSError:
        os.close(lock_fd)
        print(
            "event-watch: another watcher already holds "
            f"{f.state}/event-watch.lock",
            file=sys.stderr,
        )
        return 1
    digest = _Digest(a.digest_sec)
    err_n: dict[str, int] = {}
    said: dict[tuple[str, str], str] = {}
    for k, _ in enumerate(_ticks(a)):
        if k:
            time.sleep(a.interval)
        wins = f.windows()
        wave = [w for w in wins if w.startswith(PREFIXES)]
        watched = a.names or [w.split("-", 1)[1] for w in wave]
        _ew_board_poll(
            f,
            st_dir,
            watched,
            auto=not a.names,
            bare_wins={w.split("-", 1)[1] for w in wave},
            digest=digest,
            said=said,
        )
        for name in watched:
            _ew_pane(f, a, name, _resolve_in(wins, name), st_dir, digest, err_n, said)
        # --triage hook point: a cheap model would vet held lines here
        # before the flush prints them.
        digest.flush()
    digest.flush(final=True)
    return 0


def cmd_close(f: Fleet, a: argparse.Namespace) -> int:
    log = f.state / "dropped-branches.log"
    f.state.mkdir(parents=True, exist_ok=True)
    rc = 0
    wins = f.windows()
    # Best effort: a stale origin/main only errs towards refusing.
    git("fetch", "origin", cwd=f.main)
    for name in a.names:
        tree = f.worktrees / name
        if not tree.is_dir():
            for p in PREFIXES:
                if p + name in wins:
                    f.tmux("kill-window", "-t", f.target(p + name), check=False)
                    print(f"window closed: {p}{name}")
            print(f"no tree: {name}")
            # Gone by hand or reaped unmerged — free any spec it claimed.
            _release_claims(f, name)
            continue
        if task_id := _active_subagent_task(tree):
            print(f"REFUSED {name}: active subagent task {task_id}; tree kept")
            rc = 1
            continue
        if not git("rev-parse", "--verify", "origin/main", cwd=tree).strip():
            print(f"REFUSED {name}: origin/main does not resolve; kept")
            rc = 1
            continue
        # Landed = the scripts/branch-audit test (gr497896): ancestry, an
        # empty tree diff against origin/main, per-commit patch equivalence,
        # a squash-subject match, or a clean reverse-apply. A multi-commit
        # squash-land trips the plain `git cherry` check that used to gate
        # this, so a landed tree looked unlanded.
        if Auditor is not None:
            audit = Auditor(tree).audit("HEAD")
            landed = audit.verdict == "landed"
        else:
            cherry = git("cherry", "origin/main", "HEAD", cwd=tree).splitlines()
            landed = all(ln.startswith("-") for ln in cherry)
        if not landed:
            print(f"REFUSED {name}: unlanded commits; window, tree, branch kept")
            print(git("log", "--oneline", "origin/main..HEAD", cwd=tree), end="")
            rc = 1
            continue
        if task_id := _active_subagent_task(tree):
            print(f"REFUSED {name}: active subagent task {task_id}; tree kept")
            rc = 1
            continue
        for p in PREFIXES:
            if p + name in wins:
                f.tmux("kill-window", "-t", f.target(p + name), check=False)
                print(f"window closed: {p}{name}")
        branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=tree).strip()
        sha = git("rev-parse", "--short", "HEAD", cwd=tree).strip()
        git("worktree", "unlock", str(tree), cwd=f.main)
        proc = subprocess.run(
            ["git", "worktree", "remove", str(tree)],
            cwd=f.main,
            capture_output=True,
            text=True,
            encoding="utf-8",
            check=False,
        )
        if proc.returncode:
            print(f"KEPT (dirty or busy): {name}: {proc.stderr.strip()[:120]}")
            rc = 1
            continue
        dropped = ""
        if branch and branch != "HEAD":
            d = subprocess.run(
                ["git", "branch", "-d", branch],
                cwd=f.main,
                capture_output=True,
                text=True,
                encoding="utf-8",
                check=False,
            )
            # -d proves ancestry only; a squash- or patch-landed branch still
            # fails it, and the audit above already proved the work is on main.
            if d.returncode:
                d = subprocess.run(
                    ["git", "branch", "-D", branch],
                    cwd=f.main,
                    capture_output=True,
                    text=True,
                    encoding="utf-8",
                    check=False,
                )
            dropped = branch if d.returncode == 0 else ""
        with log.open("a", encoding="utf-8") as fh:
            fh.write(f"{utc_stamp()} {name} {branch} {sha} removed\n")
        print(
            f"removed: {name} at {sha}"
            + (f"; branch deleted: {dropped}" if dropped else "")
        )
        _release_claims(f, name)
    return rc


# --- land ------------------------------------------------------------------------


def _resolve_tree(f: Fleet, ref: str) -> Path | None:
    """A builder tree from a wave NAME (under the worktrees root) or a path."""
    named = f.worktrees / ref
    if not _bad_tree(ref) and named.is_dir():
        return named.resolve()
    p = Path(ref).expanduser()
    return p.resolve() if p.is_absolute() and p.is_dir() else None


def _registered_trees(f: Fleet) -> dict[Path, str]:
    """Registered worktree path -> its ``locked`` reason ('' when unlocked,
    ``locked`` alone when the lock carries no reason), via
    ``git worktree list --porcelain``."""
    out: dict[Path, str] = {}
    cur: Path | None = None
    for ln in git("worktree", "list", "--porcelain", cwd=f.main).splitlines():
        if ln.startswith("worktree "):
            cur = Path(ln[len("worktree ") :]).resolve()
            out[cur] = ""
        elif ln.startswith("locked") and cur is not None:
            out[cur] = ln[len("locked") :].strip() or "locked"
    return out


def _pid_alive(pid: int) -> bool:
    """scripts/inflight's pid_alive: EPERM (another user's live pid) is alive."""
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return False
    except PermissionError:
        return True
    return True


def _live_session(reason: str) -> str:
    """The live-session marker for a worktree lock reason, or "". Same test
    as scripts/inflight's session_field: ``pid N`` in the lock reason with N
    alive. A lock with no pid (a Codex tree) or a dead pid is not a session."""
    m = re.search(r"pid\s+(\d+)", reason)
    return f"live#{m.group(1)}" if m and _pid_alive(int(m.group(1))) else ""


def cmd_land(f: Fleet, a: argparse.Namespace) -> int:
    """Land a builder tree's own branch by running ship in that tree.

    No cherry-pick, no new branch: a branch lands only by ship run in its
    own tree, so the builder's branch is the thing that becomes merged.
    """
    if why := _coordinator_refusal():
        print(f"fleet-wave: REFUSED: {why}", file=sys.stderr)
        return 3
    tree = _resolve_tree(f, a.tree)
    if tree is None:
        print(f"fleet-wave: no such tree {a.tree!r}", file=sys.stderr)
        return 2
    trees = _registered_trees(f)
    if tree not in trees:
        print(f"fleet-wave: {tree} is not a registered worktree", file=sys.stderr)
        return 2
    if tree == f.main.resolve() or tree == Path.cwd().resolve():
        print(
            f"fleet-wave: REFUSED: {tree} is the primary or coordinator tree, "
            "not a builder tree",
            file=sys.stderr,
        )
        return 3
    if live := _live_session(trees[tree]):
        print(
            f"fleet-wave: REFUSED {a.tree}: live session {live} holds the tree; "
            "let the builder exit first",
            file=sys.stderr,
        )
        return 3
    if task_id := _active_subagent_task(tree):
        print(
            f"fleet-wave: REFUSED {a.tree}: active subagent task {task_id}",
            file=sys.stderr,
        )
        return 3
    ship = tree / "scripts" / "ship"
    if not ship.is_file():
        print(f"fleet-wave: {ship} not found", file=sys.stderr)
        return 2
    mode = "--checked"
    if a.remote:
        mode = "--remote"
    elif a.quick:
        mode = "--quick"
    argv = [str(ship), mode, *(["-m", a.message] if a.message else [])]
    logdir = f.state / "land"
    logdir.mkdir(parents=True, exist_ok=True)
    log = logdir / f"{tree.name}-{utc_stamp().replace(':', '')}.log"
    with log.open("w", encoding="utf-8") as fh:
        proc = subprocess.run(
            argv,
            cwd=tree,
            stdin=subprocess.DEVNULL,
            stdout=fh,
            stderr=subprocess.STDOUT,
            check=False,
        )
    print(f"log: {log}")
    print(f"exit: {proc.returncode}")
    return proc.returncode


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="fleet-wave",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    p.add_argument("--session", default="")
    p.add_argument("--socket", default="")
    p.add_argument("--worktrees", default="")
    p.add_argument("--model", default="")
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser("launch", help="start a builder window")
    s.add_argument("name")
    s.add_argument("--brief", default="", help="brief file (one-off task)")
    s.add_argument(
        "--batch",
        default="",
        help="gripe batch slug: brief rendered from the gripes, builder recorded on them",
    )
    s.add_argument("--tier", choices=("R", "W", *TIER_ALIASES), default="R")
    s.add_argument("--devin", action="store_true")
    s.add_argument("--codex", action="store_true", help="a Codex builder (locked tree)")
    s.add_argument("--settle", type=float, default=3.0, help=argparse.SUPPRESS)
    s.add_argument("--coordinator", default="")
    s.add_argument("--release-owner", default="")
    s.add_argument("--approval", default="")
    s.add_argument("--dry-run", action="store_true")
    s.set_defaults(fn=cmd_launch)

    s = sub.add_parser("peek", help="last lines of each window")
    s.add_argument("win", nargs="*")
    s.add_argument("-n", type=int, default=int(os.environ.get("PEEK_N", "6")))
    s.set_defaults(fn=cmd_peek)

    sub.add_parser("ctx", help="context %% per Claude pane").set_defaults(fn=cmd_ctx)
    sub.add_parser("prompts", help="panes at a dialog").set_defaults(fn=cmd_prompts)

    s = sub.add_parser(
        "send-line",
        help="type TEXT and press Enter; waits out a compacting pane "
        "and retries a swallowed Enter",
    )
    s.add_argument("win")
    s.add_argument("text")
    s.add_argument(
        "--wait",
        type=float,
        default=90.0,
        help="seconds to wait out a compacting pane (default 90)",
    )
    s.add_argument("--poll", type=float, default=2.0, help=argparse.SUPPRESS)
    s.add_argument(
        "--retries",
        type=int,
        default=2,
        help="extra Enter attempts when the first was swallowed",
    )
    s.add_argument("--pause", type=float, default=1.0, help=argparse.SUPPRESS)
    s.add_argument(
        "--force",
        action="store_true",
        help=f"send even past the {CTX_HARD}%% ctx ceiling (the handoff itself)",
    )
    s.set_defaults(fn=cmd_send_line)

    for cmd, fn, nargs in (
        ("watch-done", cmd_watch_done, "+"),
        ("stuck-watch", cmd_stuck_watch, "*"),
    ):
        s = sub.add_parser(cmd)
        s.add_argument("names", nargs=nargs)
        s.add_argument("--interval", type=float, default=60.0)
        s.add_argument("--ticks", type=int, default=0, help="stop after N polls")
        s.add_argument(
            "--digest-sec",
            type=float,
            default=300.0,
            help="hold non-urgent lines up to this long and print them in one "
            "write (a prompt flushes at once; 0 = no holding; default 300)",
        )
        if cmd == "stuck-watch":
            s.add_argument("--quiet-min", type=int, default=20)
            s.add_argument(
                "--requiet-min",
                type=int,
                default=60,
                help="repeat a still-quiet pane's line this often (0 = never; "
                "default 60)",
            )
            s.add_argument(
                "--settle",
                type=int,
                default=2,
                help="polls a changed state must hold before it is reported "
                "(default 2; 1 = report at once)",
            )
        s.set_defaults(fn=fn)

    s = sub.add_parser("reassign", help="/clear a builder and point it at a new brief")
    s.add_argument("name")
    s.add_argument("--brief", default="")
    s.add_argument("--batch", default="")
    s.add_argument("--pause", type=float, default=6.0, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_reassign)

    s = sub.add_parser("handoff-wait", help="resume builders that printed DONE-HANDOFF")
    s.add_argument("names", nargs="+")
    s.add_argument("--resume", default="", help="the resume line (default built in)")
    s.add_argument("--timeout-min", type=float, default=15.0)
    s.add_argument("--interval", type=float, default=20.0)
    s.add_argument("--ticks", type=int, default=0, help="stop after N polls")
    s.add_argument("--pause", type=float, default=5.0, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_handoff_wait)

    s = sub.add_parser(
        "event-watch",
        help="board + pane events: the script handles routine ones "
        "(quota→/model, DONE-HANDOFF→resume, idle→/compact) and prints "
        "only what needs the coordinator's judgment",
    )
    s.add_argument("names", nargs="*", help="wave names; default: every wave window")
    s.add_argument("--interval", type=float, default=20.0, help="seconds between polls")
    s.add_argument("--ticks", type=int, default=0, help="stop after N polls")
    s.add_argument(
        "--digest-sec",
        type=float,
        default=30.0,
        help="hold non-urgent lines up to this long and print them in one "
        "write (a prompt or failed reflex flushes at once; default 30)",
    )
    s.add_argument(
        "--settle",
        type=int,
        default=2,
        help="polls an unhandled error must hold before it prints (default 2)",
    )
    s.add_argument(
        "--frozen-min",
        type=int,
        default=int(os.environ.get("FLEET_PANES_FROZEN_MIN", "25")),
        help="minutes an unchanged pane tail counts as frozen "
        "(default 25, env FLEET_PANES_FROZEN_MIN)",
    )
    s.add_argument(
        "--cooldown-min",
        type=float,
        default=30.0,
        help="per-pane cap on the quota and handoff reflexes (default 30)",
    )
    s.add_argument(
        "--ceiling",
        type=int,
        default=70,
        help="ctx %% at or above which an idle pane is compacted (default 70)",
    )
    s.add_argument(
        "--tokens",
        nargs="?",
        const="120k",
        default=os.environ.get("FLEET_COMPACT_TOKENS") or None,
        metavar="N",
        help="compact an idle pane whose printed context exceeds N tokens "
        "(k/M suffixes; bare --tokens is 120k, env FLEET_COMPACT_TOKENS; "
        "when set it replaces --ceiling — a pane printing no token "
        "figure is left alone)",
    )
    s.add_argument("--resume", default="", help="the resume line (default built in)")
    s.add_argument(
        "--triage",
        default="",
        metavar="MODEL",
        help="reserved: a cheap-model first pass over borderline lines "
        "(e.g. haiku); not implemented",
    )
    s.add_argument("--wait", type=float, default=30.0, help=argparse.SUPPRESS)
    s.add_argument("--poll", type=float, default=2.0, help=argparse.SUPPRESS)
    s.add_argument("--pause", type=float, default=1.0, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_event_watch)

    s = sub.add_parser("cites", help="unlanded branch commits naming gr<ID>")
    s.add_argument("ids", nargs="+")
    s.set_defaults(fn=cmd_cites)

    s = sub.add_parser(
        "ctx-guard",
        help="send the WIP+handoff instruction once when a pane's ctx "
        "reaches --ceiling; re-arms below --rearm",
    )
    s.add_argument("names", nargs="*")
    s.add_argument("--interval", type=float, default=60.0)
    s.add_argument("--ticks", type=int, default=0, help="stop after N polls")
    s.add_argument(
        "--ceiling",
        type=int,
        default=70,
        help="context %% at or above which the pane is nudged (default 70)",
    )
    s.add_argument(
        "--rearm",
        type=int,
        default=None,
        help="level below which a nudged pane re-arms, in the trigger's "
        "unit (default 40; half of --ceiling/--tokens with --compact)",
    )
    s.add_argument(
        "--compact",
        action="store_true",
        help="send /compact instead of the WIP+handoff text, never "
        "mid-turn (a busy pane is skipped to the next poll); skipped "
        "while the window's tree has a live subagent task",
    )
    s.add_argument(
        "--tokens",
        nargs="?",
        const="120k",
        default=os.environ.get("FLEET_COMPACT_TOKENS") or None,
        metavar="N",
        help="compact when the pane's printed context exceeds N tokens "
        "(k/M suffixes) — the peer main-loop threshold (gr515153); bare "
        "--tokens is 120k, env FLEET_COMPACT_TOKENS; implies --compact; "
        "a pane that prints no token figure is skipped",
    )
    s.add_argument(
        "--hard",
        type=int,
        default=CTX_HARD,
        help="context %% at or above which the guard prints FORCED "
        "HANDOFF for the coordinator (default 85)",
    )
    s.add_argument(
        "--message",
        default="",
        help="instruction to send; {name} fills with the wave name",
    )
    s.add_argument(
        "--message-file",
        default="",
        help="file to read the instruction from (overrides --message)",
    )
    s.add_argument(
        "--wait",
        type=float,
        default=30.0,
        help="seconds to wait out a compacting pane before sending",
    )
    s.add_argument("--poll", type=float, default=2.0, help=argparse.SUPPRESS)
    s.add_argument("--pause", type=float, default=1.0, help=argparse.SUPPRESS)
    s.set_defaults(fn=cmd_ctx_guard)

    s = sub.add_parser(
        "close",
        help="kill window, remove tree, drop branch; refuses unlanded work",
    )
    s.add_argument("names", nargs="+")
    s.set_defaults(fn=cmd_close)

    s = sub.add_parser(
        "land",
        help="land a builder tree's own branch: run its scripts/ship in it "
        "(coordinator tree only; --checked default, --quick lint-only, "
        "--remote for harness diffs; no cherry-pick, no new branch)",
    )
    s.add_argument("tree", help="wave NAME under the worktrees root, or a path")
    mode = s.add_mutually_exclusive_group()
    mode.add_argument(
        "--checked", action="store_true", help="scripts/ship --checked (default)"
    )
    mode.add_argument(
        "--quick",
        action="store_true",
        help="scripts/ship --quick (lint only, no pytest — the qland lane)",
    )
    mode.add_argument(
        "--remote",
        action="store_true",
        help="scripts/ship --remote (harness diffs; GitHub check.yml gate)",
    )
    s.add_argument("-m", "--message", default="", help="commit subject for ship")
    s.set_defaults(fn=cmd_land)

    s = sub.add_parser(
        "approve",
        help="append a grant to the approval ledger (coordinator tree only)",
        description="Append a grant (or, with --revoke, a revoke) to "
        "$FLEET_STATE/approvals/<tree>.tsv. Refuses unless run from "
        "FLEET_COORDINATOR_TREE — a convention-level guard; anyone with "
        "shell access could append directly, so it holds because the "
        "coordinator session's own rules forbid it writing a grant the "
        "user did not type (the coordinator transcript shows which lines "
        "the user typed). A grant relayed in a session message is not an "
        "approval; .claude/fleet/authority.md still governs.",
    )
    s.add_argument("tree", nargs="?")
    s.add_argument("shas", nargs="?")
    s.add_argument("--note", default="")
    s.add_argument("--list", action="store_true", help="print the ledger")
    s.add_argument("--revoke", action="store_true", help="append a revoke line")
    s.set_defaults(fn=cmd_approve)

    s = sub.add_parser(
        "approved",
        help="exit 0 iff every sha has a grant and no later revoke",
    )
    s.add_argument("tree")
    s.add_argument("shas")
    s.set_defaults(fn=cmd_approved)
    return p


def main(argv: Sequence[str] | None = None) -> int:
    a = parser().parse_args(argv)
    return int(a.fn(Fleet(a), a))


if __name__ == "__main__":
    sys.exit(main())

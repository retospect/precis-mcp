#!/usr/bin/env bash
# scripts/pcb-loop — the local PCB dev loop: import an .epro2 into this
# worktree's dev DB, topo-place it, run DRC and write summary.md +
# metrics.json + SVG renders. No prod, no MCP, no deploy — the PCB
# lane's iteration command. Route is topo slice 2 output (lands with
# topo-2b); until then the loop reports placement metrics, topo
# crossings and the realized via count — vroute is gone, topo is the
# only router.
#
# Usage:
#   scripts/pcb-loop [--board <epro2>] [--seed N] [--effort N]
#                    [--skip-place] [--out DIR]
#
# Defaults: --board ~/taz15.epro2 (READ-ONLY: copied into .scratch first;
# the file is never moved or rewritten), --out /tmp/pcb-topo/loop/<n>
# with n the next free integer. The driver is
# tests/fixtures/pcb/pcb_loop.py, run via scripts/dev — per-stage wall
# times and metrics land under <out>/.
set -euo pipefail

board="${HOME}/taz15.epro2"
# The default board's project carries 6 PCB documents; this is the
# 2026-08-20 TAZ Control Board V1.15, the current one.
board_uuid=""
seed=1
effort=20000
out=""
extra=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --board) board="$2"; shift 2 ;;
        --board-uuid) board_uuid="$2"; shift 2 ;;
        --seed) seed="$2"; shift 2 ;;
        --effort) effort="$2"; shift 2 ;;
        --skip-place) extra+=(--skip-place); shift ;;
        --force) extra+=(--force); shift ;;
        --out) out="$2"; shift 2 ;;
        *) echo "ERR: unknown flag $1" >&2; exit 64 ;;
    esac
done

if [[ -z "$board_uuid" && "$board" == "${HOME}/taz15.epro2" ]]; then
    board_uuid="858a5f81603d1987"
fi

here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"

if [[ ! -f "$board" ]]; then
    echo "ERR: board not found: $board" >&2
    exit 66
fi

if [[ -z "$out" ]]; then
    base=/tmp/pcb-topo/loop
    mkdir -p "$base"
    n=1
    for d in "$base"/*/; do
        b="$(basename "$d")"
        [[ "$b" =~ ^[0-9]+$ ]] && (( b >= n )) && n=$(( b + 1 ))
    done
    out="${base}/${n}"
else
    mkdir -p "$out"
fi

stage=".scratch/pcb-loop/$(basename "$out")"
mkdir -p "$stage"
cp "$board" "${stage}/input.epro2"

scripts/dev db-up >/dev/null

if [[ -n "$board_uuid" ]]; then extra+=(--board-uuid "$board_uuid"); fi

sha="$(git rev-parse --short HEAD)"
git diff --quiet HEAD -- || sha="${sha}+dirty"

# The driver's exit is nonzero on a refused/failed stage — that is a
# result, not a crash: copy the outputs to $out either way, then exit
# with it so callers can still tell iterations apart.
set +e
scripts/dev uv run --no-sync python -m tests.fixtures.pcb.pcb_loop \
    --board "${stage}/input.epro2" \
    --slug "pcb-loop-$(basename "$out")" \
    --out "$stage" \
    --seed "$seed" --effort "$effort" "${extra[@]+"${extra[@]}"}"
rc=$?
set -e
cp -a "${stage}/." "$out/"

python3 - "$out/metrics.json" "$sha" <<'PY'
import json, sys
try:
    m = json.load(open(sys.argv[1], encoding="utf-8"))
except (OSError, json.JSONDecodeError):
    sys.exit(0)
r = m.get("route") or {}
p = m.get("place") or {}
d = m.get("drc") or {}
v = m.get("vias") or {}
n = m.get("slug", "?")
x = f"{r.get('crossings_start')}→{r.get('crossings')}"
shove = (
    f" shove {p['shove_mm']}mm/{p['shove_rounds']}r"
    if p.get("shove_mm") is not None
    else ""
)
leg = (
    f" leg {p['legalize_mm']}mm/left{p['legalize_left']}"
    if p.get("legalize_mm") is not None
    else ""
)
print(
    f"LOOP {n} crossings {x} evals/s {p.get('evals_per_s')} "
    f"drc {d.get('errors')} ov {d.get('overlap_errors')} "
    f"vias {v.get('total')}{shove}{leg} wall {m.get('total_s')}s {sys.argv[2]}"
)
PY
echo "loop out: $out"
exit $rc

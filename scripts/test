#!/usr/bin/env bash
# Must run under stock macOS bash 3.2 — no declare -A, mapfile, ${x,,},
# &>, |&, coproc or globstar (tests/test_bash32_gotchas.py ratchets this).
# scripts/test — run the suite (or a subset) in the precis-dev container
# against THIS worktree, with the RAM test DB wired, and terse "token-killer"
# output (warnings suppressed, short tracebacks). The canonical way to check
# tests while iterating.
#
# Why a wrapper: the host venv is torch-free, so a bare `uv run pytest` on the
# host fails with spurious ModuleNotFoundError; and `scripts/dev` bind-mounts
# MAIN, not your worktree, so it can't see your edits. This runs in the
# container over a bind-mount of the CURRENT worktree, exactly like the
# scripts/ship gate — so it tests what you're actually editing.
#
# The ship gate (scripts/ship, run by /land and /go) is still the
# authoritative pre-merge run; this is the fast iteration loop.
#
# Usage:
#   scripts/test                              # full suite (-n6)
#   scripts/test tests/test_foo.py            # one file
#   scripts/test -k "registry or env"         # a -k expression
#   scripts/test tests/test_foo.py::test_bar -x
#   scripts/test --fast                       # no-DB fast set (-m 'not db')
#   scripts/test --skills                     # every tests/test_skill*.py —
#                                             # the skill-only change's selector
#   scripts/test --coverage [pytest args…]    # opt-in: run under pytest-cov with
#                                             # per-test contexts, leaving
#                                             # .coverage + .coverage.precis.json
#                                             # at the worktree root (feeds the
#                                             # python `tests` view's measured tier)
#   scripts/test --impacted                   # ONLY tests your changes affect
#   scripts/test --selected                   # the --checked selection: contract
#                                             # invariants + corpus/import map
#                                             # (testmon when a map exists)
#   scripts/test --selected --list            # preview only: prints the computed
#                                             # selection (or FULL), runs nothing
#   scripts/test --typecheck                  # `uv run mypy src tests` in the container
#   scripts/test --random [pytest args…]      # order-dependence probe: bridges
#                                             # pytest-randomly on the fly; the
#                                             # plugin prints its seed.
#                                             # PRECIS_RANDOM_SEED=N pins the
#                                             # order (--randomly-seed) and
#                                             # implies --random on its own
#   scripts/test --bg <args…>                 # detach the run; prints an --await line
#   scripts/test --await <run-id>             # bounded wait: exits with the run's
#                                             # code, or 124 = still running (re-run)
#
# Refuses with exit 3 (named message) when the docker VM disk is nearly
# full — the disk knobs are in the `--help` Env block below.
#
# Everything after the script name is passed straight to pytest. Default
# parallelism is -n6 (the measured sweet spot) — except a selection whose
# positional args are all test files or node ids: then the container counts
# the collected items first and runs -n0 at ≤500 (PRECIS_AUTO_N_MAX), because
# xdist worker bring-up (~4.8 s no-DB, ~24 s DB) outweighs the tests at that
# size. Directories and bare -k/-m selections keep -n6 with no count pass;
# a caller-supplied -nN always wins. ``--serial`` is the documented
# single-process mode (-n0 — for pdb/-s debugging, gr514400); a caller's
# ``-p no:xdist`` works too: the script withholds its -n6 and conftest's
# xdist-shim swallows addopts' -n auto so the run parses and goes serial.
#
# The four stale-baked-venv preflight checks (see below) are cached
# per-worktree: a stamp at ./.precis-preflight keyed on the image id +
# uv.lock + pyproject.toml + UV_WITH skips them on a hit (~6 s saved per
# run); any failure or entry-points heal leaves no stamp.
#
# Env knobs are documented ONCE, in the `--help` Env block — do not repeat
# the list here (gr514431). The comments at each use site keep only the
# why: agent_db_teardown's docker-network-pool story, the gr513868
# silently-dropped host var behind the unforwarded-name warning, and so on.
#
# --impacted (-i): impact selection via pytest-testmon. Runs only the tests
# affected by your working-tree changes — the inner-loop accelerator when the
# full 140s suite is mostly per-worker DB-clone setup for tests you didn't
# touch. The FIRST run builds the test↔code map (a full run); after that each
# run selects just the affected tests (sub-second when nothing changed). Forces
# -n0 (testmon is per-process) and keeps a per-worktree map at ./.testmondata
# (gitignored). Still not authoritative — scripts/ship runs the full gate.
#
# NOTE: the dev image bakes all extras, so you never need `--with`/`--extra`
# here — that's only for the torch-free host (and the testmon and
# pytest-randomly plugins, which --impacted and --random pull in on the fly
# so no image rebuild is needed).
#
# --typecheck : the gate's mypy check (`uv run mypy src tests`), through the
# same container path as pytest — same compose project, same worktree bind
# mount — so it sees the SAME tree the rest of this script tests, and the
# baked-image extras (fastapi/rdkit/torch) that a bare host `uv run mypy`
# lacks. Skips the DB startup and the gate-slot wait: mypy touches no
# service and is light next to a full pytest run, so it doesn't need to
# queue behind the shared-VM gate-slot cap (gr202193/gr339251). Optional
# trailing args override the default `src tests` target.
set -euo pipefail
cd "$(dirname "$0")/.."
WORKTREE="$PWD"

# --help / -h : print usage and exit BEFORE any side effect (gr343798). This
# must stay the first thing checked — no gate slot, no tmpfs test-db, no
# container, no lock — so `scripts/test --help` is instant and never touches
# the fleet-wide gate.
usage() {
    cat <<'USAGE'
scripts/test — run the suite (or a subset) in the precis-dev container
against THIS worktree, with the RAM test DB wired.

Usage:
  scripts/test                              # full suite (-n6)
  scripts/test tests/test_foo.py            # one file
  scripts/test -k "registry or env"         # a -k expression
  scripts/test tests/test_foo.py::test_bar -x
  scripts/test --serial tests/test_foo.py   # single process (-n0), for pdb/-s
  scripts/test --co tests/test_foo.py       # collection list only: serial, no
                                            # test DB, no gate slot (gr515705)
  scripts/test --fast | -f                  # no-DB fast set (-m 'not db and not slow')
  scripts/test --skills                     # every tests/test_skill*.py —
                                            # the skill-only change's selector
  scripts/test --coverage [pytest args…]    # per-test .coverage + manifest
  scripts/test --impacted | -i              # ONLY tests your changes affect (testmon)
  scripts/test --selected                   # the ship --checked selection locally:
                                            # contract invariants + corpus/map +
                                            # import-scan (testmon if a map exists)
  scripts/test --selected --list            # preview only: prints the computed
                                            # selection (or FULL), runs nothing —
                                            # no container, no gate slot
  scripts/test --random [pytest args…]      # shuffled order (pytest-randomly,
                                            # seed printed); PRECIS_RANDOM_SEED=N
                                            # reproduces an order, implies --random
  scripts/test --typecheck [targets…]       # `uv run mypy src tests` in the
                                            # container; trailing args replace
                                            # the src tests targets
  scripts/test --bg <args…>                 # detach the run; prints an --await line
  scripts/test --await <run-id>             # bounded wait: exits with the run's
                                             # code, or 124 = still running (re-run)
  scripts/test --help | -h                  # this message; no gate slot, no container

Everything after the script name (other than the flags above) is passed
straight to pytest. Default parallelism is -n6; pass your own -n0/-nN to
override for a single fast test, or --serial for the documented
single-process mode (-p no:xdist also works — the conftest shim absorbs
addopts' -n). A positional arg naming a path that does
not exist is refused up front, before any container starts (gr514948).

Env — every knob is documented here, and only here (gr514431):
  PRECIS_TEST_ENV="NAME=value …"  extra vars forwarded into the test
        container, space-separated (names match ^[A-Z][A-Z0-9_]*$;
        PATH/HOME/PYTHON*/DATABASE*/PG* refused). Only a fixed allowlist
        crosses otherwise; an unforwarded NANO_/ESP32C3_/PRECIS_PCB_ var
        warns once on stderr (gr513868).
  PRECIS_TEST_KEEP_DB=1           keep the test-db up after the run; without
        it a subagent worktree (basename agent-*) tears its compose project
        down at exit.
  PRECIS_TEST_AWAIT_BUDGET=<s>    --await's per-call wait cap (default 480).
  UV_WITH="--with dep …"          extra uv packages for this run — the
        escape hatch for a dep the baked image lacks (--impacted uses it
        for pytest-testmon + pytest-timeout).
  PRECIS_IMPACTED_TEST_TIMEOUT=<s>  per-test timeout under --impacted
        (default 900).
  PRECIS_STRICT_LOCK_CHECK=1      refuse, not just warn, when an installed
        package differs from uv.lock.
  PRECIS_DOCKER_MIN_FREE_GB=<n>   refuse when the docker VM has less free
        (default 10).
  PRECIS_DOCKER_DISK_CHECK=0      skip that disk preflight.
  PRECIS_GATE_SLOTS=<n>           fleet-wide concurrent container cap
        (default 3; queued runs wait).
  PRECIS_GATE_WAIT_MAX_S=<s>      gate-queue wait bound (default 1800;
        0 waits unbounded). On expiry the run refuses, naming the holders.
  PRECIS_COMPOSE=<path>           alternate compose file (default
        docker/dev/compose.yaml).
  KEEP_TESTMON_LOG=1              keep the captured --impacted run log.
  PRECIS_TEST_PASSENV=FOO,BAR     forward the named host env vars into the
        container by inheritance (`-e NAME`; values are never printed or put
        in argv — they may be secrets; gr514238). Names are validated.
  PRECIS_TEST_AUTOBRIDGE=0        do NOT auto-bridge deps the baked image
        lacks. Default ON (gr525770): a stale image's missing deps are
        detected in-container and added to the run's uv env alongside any
        operator UV_WITH — loudly, one stderr line. Durable fix: an image
        rebuild by the release owner.
  PRECIS_RANDOM_SEED=N            reproduce a --random order (implies --random).

Every var that crosses uses compose's explicit `-e NAME=value` form —
never the bare `-e NAME`, which copies whatever value the host happens to
have set (the silent-passthrough trap behind gr513868) — except
PRECIS_TEST_PASSENV, below.

Two-call background protocol for capped foreground shells: `--bg <args>`
detaches the run and prints its run-id; poll with `--await <run-id>`
repeatedly (each call blocks up to PRECIS_TEST_AWAIT_BUDGET seconds and
exits 124 while still running — re-run the same command until it returns
the run's real exit code).

See the header comment in this script for the full rationale (why the
wrapper exists, --impacted/testmon details).
USAGE
}
if [[ "${1:-}" == "--help" || "${1:-}" == "-h" ]]; then
    usage
    exit 0
fi

# --bg / --await : two-call protocol for agent harnesses whose foreground
# shell calls are hard-capped (~10 min). A gate-congested run can't fit one
# call, and the cap KILLS the run mid-flight (a re-run starts over at the
# back of the gate queue) — which is what pushed subagents onto background-
# task notifications and the park-mid-verification stall. --bg detaches the
# run into its own session (survives the caller's shell exiting; the gate
# slot self-heals via the pid-dead steal if the run is abandoned); --await
# blocks in chunks that fit under the cap, so a long run is a sequence of
# short foreground calls with the agent active throughout. One run at a
# time — a second --bg queues behind the same gate slots and doubles load.
RUNS_DIR="${TMPDIR:-/tmp}/precis-test-runs"
if [[ "${1:-}" == "--bg" ]]; then
    shift
    mkdir -p "$RUNS_DIR"
    RUN_ID="$(date -u +%Y%m%d-%H%M%S)-$$"
    python3 - "$0" "${RUNS_DIR}/${RUN_ID}" "$@" <<'PY'
import os
import subprocess
import sys

script, base = sys.argv[1:3]
args = sys.argv[3:]
if os.fork() == 0:
    os.setsid()
    # Detach from the caller's stdio: the forked child inherits the
    # parent's fds, so a piped invocation (`--bg ... | tail`) would
    # otherwise never see EOF until the whole run finished.
    devnull = os.open(os.devnull, os.O_RDWR)
    for fd in (0, 1, 2):
        os.dup2(devnull, fd)
    with open(f"{base}.log", "wb") as out:
        try:
            rc = subprocess.call(
                [script, *args],
                stdin=subprocess.DEVNULL,
                stdout=out,
                stderr=subprocess.STDOUT,
            )
        except Exception:
            rc = 127
    with open(f"{base}.exit", "w", encoding="utf-8") as f:
        f.write(f"{rc}\n")
    os._exit(0)
PY
    echo "test run ${RUN_ID} detached (log: ${RUNS_DIR}/${RUN_ID}.log)"
    echo "poll it with:  scripts/test --await ${RUN_ID}"
    exit 0
fi
if [[ "${1:-}" == "--await" ]]; then
    RUN_ID="${2:?usage: scripts/test --await <run-id>}"
    LOG="${RUNS_DIR}/${RUN_ID}.log"
    EXITF="${RUNS_DIR}/${RUN_ID}.exit"
    [[ -f "$LOG" ]] || { echo "ERR: no such test run ${RUN_ID} (no log at ${LOG})" >&2; exit 1; }
    BUDGET="${PRECIS_TEST_AWAIT_BUDGET:-480}"
    START=$SECONDS
    while (( SECONDS - START < BUDGET )); do
        if [[ -f "$EXITF" ]]; then
            rc="$(tr -dc '0-9' <"$EXITF")"
            echo "── last 40 log lines (full log: ${LOG}) ──"
            tail -n 40 "$LOG"
            echo "test run ${RUN_ID} finished — exit ${rc:-1}"
            exit "${rc:-1}"
        fi
        sleep 5
    done
    echo "test run ${RUN_ID} STILL RUNNING after ${BUDGET}s — poll again with the same command:"
    echo "  scripts/test --await ${RUN_ID}"
    tail -n 2 "$LOG" 2>/dev/null || true
    exit 124
fi

# --impacted / -i : testmon impact-selection mode (see header). Strip the
# sentinel before the rest is forwarded to pytest.
# --fast / -f : the fast set — `-m 'not db and not slow'`: skips every test that
# needs Postgres (auto-marked `db` in tests/conftest.py) AND the heavy `slow`
# compute cluster. No Postgres is started, so it runs in seconds and is
# independent of the test DB — and it takes no gate slot, so it never queues
# behind a sibling's full run (gr514466). The right gate for pure-logic /
# docs / config changes; NOT authoritative before a deploy (/go still runs
# the full suite).
IMPACTED=0
FAST=0
# --skills (gr514383): a skill-only change's selector — every
# tests/test_skill*.py, expanded to a real file list below so the
# missing-path preflight, the auto -n0 count and the DB bring-up see the
# same selection a hand-typed file list would.
SKILLS=0
# --selected : the `scripts/ship --checked` selection, run locally — the
# CONTRACT invariant tests + PATH_MAP/corpus-coupled tests + python impact
# (testmon when ./.testmondata exists, else the index's static evidence).
# Selection is computed host-side by scripts/impacted-tests (one selector,
# shared with the release lane). A harness/schema diff answers FULL → the
# whole suite runs. -m 'not slow' applies, same as --impacted.
SELECTED=0
# --coverage : opt-in per-test-context coverage (NOT the default; the ship
# gate keeps its own coverage path). Passes pytest-cov's
# `--cov=src --cov-context=test` (dynamic_context=test_function under the
# hood) so .coverage gains a per-test context dimension, then writes
# .coverage.precis.json — a sha256-per-measured-file manifest the python
# `tests` view verifies against indexed bytes before trusting the DB.
COVERAGE=0
RANDOM_ORDER=0
SERIAL=0
LIST_ONLY=0
# Leading flags combine in any order (a loop, not a single pass): with
# single-pass ifs `scripts/test --random --fast` would hand `--fast` to
# pytest unparsed.
while :; do
    case "${1:-}" in
        --coverage) COVERAGE=1; shift ;;
        --impacted|-i) IMPACTED=1; shift ;;
        --fast|-f) FAST=1; shift ;;
        --skills) SKILLS=1; shift ;;
        --selected) SELECTED=1; shift ;;
        # --serial : the documented single-process mode (gr514400) — -n0,
        # for pdb/-s debugging where xdist workers swallow output. A
        # caller's -p no:xdist works too (NO_XDIST below).
        --serial) SERIAL=1; shift ;;
        # --random : order-dependence probe (test-loop-speed Decision 6).
        # Bridges pytest-randomly through UV_WITH below (same on-the-fly
        # shape as testmon — no image rebuild); the plugin prints its seed.
        --random) RANDOM_ORDER=1; shift ;;
        # --list : --selected's preview (gr515640): print the computed
        # selection host-side and exit — no container, no gate slot, no
        # accidental full-suite run when the diff answers FULL.
        --list) LIST_ONLY=1; shift ;;
        *) break ;;
    esac
done
if [[ "$SKILLS" == 1 ]]; then
    _skill_files=(tests/test_skill*.py)
    if [[ ! -e "${_skill_files[0]}" ]]; then
        echo "ERR: --skills matched no tests/test_skill*.py files under ${WORKTREE}" >&2
        exit 2
    fi
    set -- "${_skill_files[@]}" "$@"
fi
if [[ "$LIST_ONLY" == 1 && "$SELECTED" != 1 ]]; then
    echo "ERR: --list only previews the --selected selection — usage: scripts/test --selected --list" >&2
    exit 2
fi

# --co/--collect-only is a pure collection probe (gr515705): no test runs,
# so no test DB and no gate slot are needed, and the auto -n0 count pass
# would only repeat the collection the caller asked to see. Runs serial so
# the printed order is the order pytest will use.
COLLECT_ONLY=0
for _a in "$@"; do
    [[ "$_a" == "--co" || "$_a" == "--collect-only" ]] && COLLECT_ONLY=1
done
# PRECIS_RANDOM_SEED=N pins the order via --randomly-seed=N and implies
# --random on its own — that is the reproduce-an-order path.
if [[ -n "${PRECIS_RANDOM_SEED:-}" ]]; then RANDOM_ORDER=1; fi

# Missing-path preflight (gr514948): one bad filename used to reach pytest
# as a green-looking "no tests ran" (exit 5) that voided the whole run.
# Refuse before the disk probe, test-db and container start, naming every
# positional arg that is not an existing path (a 'path::node' id checks its
# path part). Args following a value-taking flag (-k/-m expressions,
# --junitxml's not-yet-written output, …) are skipped, so pytest's own
# arguments keep working; --typecheck's mypy targets are its own errors.
if [[ "${1:-}" != "--typecheck" ]]; then
    MISSING_PATHS=()
    _consumes_next=0
    for _arg in "$@"; do
        if [[ "$_consumes_next" == 1 ]]; then
            _consumes_next=0
            continue
        fi
        if [[ "$_arg" == -* ]]; then
            case "${_arg}" in
                *=*) ;;  # --flag=value carries its own argument
                -k|-m|-n|-p|-o|-c|-r|-W|\
                --deselect|--ignore|--ignore-glob|--collect-glob|--rootdir|\
                --basetemp|--confcutdir|--junitxml|--junit-prefix|--resultlog|\
                --lfnames|--maxfail|--durations|--durations-min|--tb|--capture|\
                --color|--code-highlight|--pastebin|--verbosity|--doctest-report|\
                --doctest-glob|--timeout|--timeout-method|--timeout_method|\
                --numprocesses|--max-worker-restart|--dist|--tx|--rsyncdir|\
                --cov|--cov-report|--cov-context|--cov-config|--cov-fail-under|\
                --cov-precision|--shard)
                    _consumes_next=1 ;;
            esac
            continue
        fi
        _path="${_arg%%::*}"
        [[ -n "$_path" && -e "$_path" ]] || MISSING_PATHS+=("$_arg")
    done
    if [[ ${#MISSING_PATHS[@]} -gt 0 ]]; then
        printf 'ERR: test path not found: %s\n' ${MISSING_PATHS[@]+"${MISSING_PATHS[@]}"} >&2
        echo "check the name — node ids (tests/test_x.py::test_y) and -k/-m expressions still work" >&2
        exit 2
    fi
fi

# --selected: compute the checked-gate selection host-side (no container
# needed). testmon=1 means a ./.testmondata map exists
# for this worktree — reuse the --impacted plumbing for the python half and
# add the static (contract + map + corpus) half on top.
SEL_ARGS=()
if [[ "$SELECTED" == 1 ]]; then
    _sel_out="$(scripts/impacted-tests)" || { echo "ERR: scripts/impacted-tests failed" >&2; exit 1; }
    if [[ "$LIST_ONLY" == 1 ]]; then
        echo "checked selection (preview — nothing runs; drop --list to run it):" >&2
        echo "$_sel_out"
        exit 0
    fi
    if [[ "$_sel_out" == "FULL" ]]; then
        # Harness/schema touched — the honest selection IS the suite.
        echo "checked selection: FULL (harness/schema change) — running the whole suite" >&2
        SELECTED=0
    else
        _sel_first="${_sel_out%%$'\n'*}"
        while IFS= read -r _l; do [[ -n "$_l" ]] && SEL_ARGS+=("$_l"); done <<< "$(tail -n +2 <<<"$_sel_out")"
        if [[ "$_sel_first" == "testmon=1" ]]; then IMPACTED=1; fi
    fi
fi

# PRECIS_TEST_PASSENV (gr514238): comma-separated env var NAMES forwarded
# into the container as `-e NAME` — docker inherits each value from this
# shell's environment, so a value never reaches argv or a log (the vars may
# be secrets). Validated here, before any docker call, so a bad name refuses
# instantly instead of after the gate-slot wait. A named var that is unset
# warns (names only) — silently not forwarding it is the failure this fixes.
PASSENV=()
if [[ -n "${PRECIS_TEST_PASSENV:-}" ]]; then
    IFS=',' read -ra _passenv_names <<< "$PRECIS_TEST_PASSENV"
    for _passenv_name in ${_passenv_names[@]+"${_passenv_names[@]}"}; do
        [[ -z "$_passenv_name" ]] && continue
        if [[ ! "$_passenv_name" =~ ^[A-Za-z_][A-Za-z0-9_]*$ ]]; then
            echo "ERR: PRECIS_TEST_PASSENV entry '${_passenv_name}' is not a valid env var name" >&2
            echo "next: comma-separate bare NAMEs only (no values, no spaces) — e.g. PRECIS_TEST_PASSENV=FOO,BAR scripts/test" >&2
            exit 1
        fi
        PASSENV+=(-e "$_passenv_name")
        [[ -z "${!_passenv_name+x}" ]] && echo "WARNING: PRECIS_TEST_PASSENV names ${_passenv_name}, which is not set in this shell — export it first (NAME=... scripts/test)" >&2
    done
fi

INFRA_COMPOSE="${PRECIS_COMPOSE:-${PWD}/docker/dev/compose.yaml}"
[[ -f "$INFRA_COMPOSE" ]] || {
    echo "ERR: compose file not found at ${INFRA_COMPOSE} (set PRECIS_COMPOSE)" >&2
    exit 1
}
# Per-worktree compose project so this worktree's precis-test-db is isolated
# from every sibling's, instead of all colliding on the default project `dev`
# (gr176375). See scripts/lib/compose-project.sh.
source "${WORKTREE}/scripts/lib/compose-project.sh"
COMPOSE_PROJECT="$(compose_project_for "$WORKTREE")"
# Repo-git inside the container (gr515188): a linked worktree's .git FILE
# points at the host git-common dir, which the /app bind-mount does not
# cover — every `git` call in-container then dies "not a git repository"
# and repo-git tests (check-ignore, ls-files) can't run. Mounting the
# common dir at its own absolute path makes the .git file's `gitdir:`
# resolve unchanged inside the container. Absent git metadata (the gate
# container) just adds no mount.
GIT_DIR_MOUNT=()
_git_common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
[[ -n "$_git_common" && -d "$_git_common" ]] \
    && GIT_DIR_MOUNT=(-v "${_git_common}:${_git_common}")
# Gate-slot admission (gr202193): the test container runs on one shared
# Docker VM with every sibling worktree's — cap concurrency so runs queue
# briefly instead of OOM-killing each other at random. A runaway's own
# container now OOMs alone at its mem_limit (exit 137; gate_oom_note names
# it — sourced with the lib).
source "${WORKTREE}/scripts/lib/gate-slot.sh"
# Disk preflight: a docker VM disk near full dies later as a raw ENOSPC with no
# test output, which reads as a red run. Refuse now (exit 3), before any compose
# call, naming the cause. Unknown free space only warns; PRECIS_DOCKER_DISK_CHECK=0
# skips. --typecheck is checked too (mypy writes caches).
source "${WORKTREE}/scripts/lib/docker-disk.sh"
docker_disk_preflight "scripts/test" || exit $?
# TESTMON_LOG stays empty outside --impacted mode; cleanup() no-ops on it
# then (see the testmon-exit-guard block near the bottom for why impacted
# mode captures pytest's output to a file instead of streaming it raw).
TESTMON_LOG=""
# The stderr fifo + filter pid for run_pytest (gr513886 review): a fifo
# plus a real background job gives a waitable pid — a process
# substitution's is not reliably waitable on bash 3.2.
ERR_FIFO=""
ERR_FILTER_PID=""
# Subagent trees (basename `agent-*`, the key compose-project.sh uses) never
# resume, and every compose project holds one docker network address pool
# (~31 on this host) for as long as its test-db exists — idle subagent dbs ran
# the pool dry fleet-wide on 2026-10-03. So tear the project down at exit
# unless PRECIS_TEST_KEEP_DB=1 (keep the warm db) or another container of the
# project (a concurrent scripts/test run, a gate) is still RUNNING — the same
# guard scripts/reap-test-dbs uses. Best-effort: never fails, and cleanup()
# re-raises the script's real exit status around it.
#
# A running container alone misses a second run of the same tree that is
# between `compose up --wait precis-test-db` and starting its own container
# (round-3 review of ae5084ae3): `down -v` would delete the db under it. So a
# db-using run leaves a pid marker in the tree's git dir BEFORE it brings the
# db up, and the teardown also stands down while any other marker's pid is
# alive (EPERM from kill -0 = alive). The marker scan runs last, right before
# the `down`, which leaves only that gap open.
RUN_MARKER_DIR=""
RUN_MARKER=""
run_marker_write() {
    case "${WORKTREE##*/}" in agent-*) ;; *) return 0 ;; esac
    local gd
    gd="$(git -C "$WORKTREE" rev-parse --absolute-git-dir 2>/dev/null)" || return 0
    RUN_MARKER_DIR="$gd/precis-test-runs"
    mkdir -p "$RUN_MARKER_DIR" 2>/dev/null || return 0
    RUN_MARKER="$RUN_MARKER_DIR/$$"
    : >"$RUN_MARKER" 2>/dev/null || RUN_MARKER=""
}
pid_alive() {
    local err
    kill -0 "$1" 2>/dev/null && return 0
    err="$(kill -0 "$1" 2>&1)"
    [[ "$err" == *"ermitted"* ]]
}
other_run_alive() {
    [[ -n "$RUN_MARKER_DIR" && -d "$RUN_MARKER_DIR" ]] || return 1
    local m pid
    for m in "$RUN_MARKER_DIR"/*; do
        [[ -e "$m" ]] || continue
        pid="${m##*/}"
        [[ "$pid" == "$$" ]] && continue
        case "$pid" in ''|*[!0-9]*) continue ;; esac
        if pid_alive "$pid"; then return 0; fi
        rm -f "$m"
    done
    return 1
}
agent_db_teardown() {
    [[ -n "$RUN_MARKER" ]] && rm -f "$RUN_MARKER"
    [[ "$FAST" == "1" || "$COLLECT_ONLY" == "1" ]] && return 0
    [[ -n "${PRECIS_TEST_KEEP_DB:-}" ]] && return 0
    case "${WORKTREE##*/}" in agent-*) ;; *) return 0 ;; esac
    local svc services
    services="$(docker ps --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}" \
        --format '{{.Label "com.docker.compose.service"}}' 2>/dev/null)" || return 0
    while IFS= read -r svc; do
        [[ -z "$svc" || "$svc" == "precis-test-db" ]] && continue
        return 0
    done <<<"$services"
    other_run_alive && return 0
    env UID="$(id -u)" GID="$(id -g)" docker compose -f "$INFRA_COMPOSE" \
        -p "$COMPOSE_PROJECT" --profile dev down -v >>"${RUN_LOG:-/dev/null}" 2>&1 || true
    return 0
}
cleanup() {
    # Capture the real exit status up front and re-raise it at the end: the
    # best-effort teardown below must never change what the caller sees.
    local rc=$?
    # --coverage: fingerprint the measured bytes alongside the DB so the
    # python `tests` view can verify the DB against its index. Best-effort,
    # host-side (stdlib only); a failed write just means the view reports
    # the DB as unverifiable instead of measured.
    if [[ "$COVERAGE" == "1" && -f .coverage ]]; then
        python3 "${WORKTREE}/scripts/lib/coverage_manifest.py" .coverage \
            || echo "WARNING: .coverage.precis.json not written — the tests view will report the DB as unverified" >&2
    fi
    gate_slot_release
    # `if`, not `[[ ]] && …`: an EXIT trap's own exit status becomes the
    # script's exit status, and `&&` on a false test would silently turn
    # every non-impacted (TESTMON_LOG unset) run's real 0 into a bogus 1.
    if [[ -n "$TESTMON_LOG" && "${KEEP_TESTMON_LOG:-0}" != "1" ]]; then
        rm -f "$TESTMON_LOG"
    fi
    hb_stop
    agent_db_teardown || true
    # A leftover stderr filter (interrupt path; run_pytest waits it out on
    # the normal one) must be gone before the verdict — nothing may print
    # after it. Kill first: a writer still holding the fifo would make a
    # bare wait block.
    if [[ -n "$ERR_FILTER_PID" ]]; then
        kill "$ERR_FILTER_PID" 2>/dev/null || true
        wait "$ERR_FILTER_PID" 2>/dev/null || true
        ERR_FILTER_PID=""
    fi
    if [[ -n "$ERR_FIFO" ]]; then
        rm -f "$ERR_FIFO"
        ERR_FIFO=""
    fi
    # The one-line verdict, LAST (gr513886): PASS/FAIL, pytest's own counts
    # line and the run's wall duration. Nothing prints after it. A green
    # run's transcript has no reader — delete the log and drop its path
    # (they piled up in TMPDIR on every run otherwise). A red run keeps
    # the log, names it, and prunes kept logs older than a day.
    if [[ -n "${RUN_LOG:-}" ]]; then
        local _verdict _counts
        _verdict="PASS"
        [[ "$rc" == 0 ]] || _verdict="FAIL (rc ${rc})"
        _counts="$(grep -E '[0-9]+ (passed|failed|skipped|xfailed|xpassed|deselected|errors?|warnings?|tests? collected)|no tests ran' "$RUN_LOG" 2>/dev/null \
            | tail -1 | sed -e 's/^=\+[[:space:]]*//' -e 's/[[:space:]]*=\+[[:space:]]*$//' || true)"
        if [[ "$rc" == 0 ]]; then
            rm -f "$RUN_LOG"
            if [[ -n "$_counts" ]]; then
                printf 'scripts/test: %s — %s | %ss\n' \
                    "$_verdict" "$_counts" "$((SECONDS - RUN_T0))"
            else
                printf 'scripts/test: %s — no pytest summary | %ss\n' \
                    "$_verdict" "$((SECONDS - RUN_T0))"
            fi
        else
            find "${TMPDIR:-/tmp}" -maxdepth 1 -name 'precis-test-run.*' -mtime +1 -delete 2>/dev/null || true
            if [[ -n "$_counts" ]]; then
                printf 'scripts/test: %s — %s | %ss | log %s\n' \
                    "$_verdict" "$_counts" "$((SECONDS - RUN_T0))" "$RUN_LOG"
            else
                printf 'scripts/test: %s — no pytest summary | %ss | log %s\n' \
                    "$_verdict" "$((SECONDS - RUN_T0))" "$RUN_LOG"
            fi
        fi
    fi
    exit "$rc"
}
trap cleanup EXIT
# --progress quiet (gr515155): compose otherwise prints its "Container …
# Creating/Created/Started" lifecycle lines above every result, which the
# terse-output contract promises away. Errors still print; this only drops
# the progress reporter.
compose() { env UID="$(id -u)" GID="$(id -g)" docker compose --progress quiet -f "$INFRA_COMPOSE" -p "$COMPOSE_PROJECT" --profile dev "$@"; }

# Terminal-noise filters (gr513886): noise that can't be silenced at the
# source is appended to the per-run log ($RUN_LOG) instead of the
# terminal. Patterns are deliberately narrow — docker/compose lifecycle
# lines and pysbd's compile-time SyntaxWarnings — so real signal still
# shows. awk, not grep -v: grep exits 1 when it selects no lines, which
# pipefail would read as a failed run; awk exits 0 after processing input
# so the pipeline status stays compose's own (same reasoning as the sed
# it replaces, gr514615). fflush() keeps the stream live.
#
# Why not PYTHONWARNINGS=ignore::SyntaxWarning:pysbd (the fix the gripe
# names): on Python 3.13 a compile-time warning is emitted with NO module
# name, so a module-scoped filter can never match it — verified against
# the container's interpreter, where even `.*` as the module field fails.
# `ignore:invalid escape:SyntaxWarning` does match (message-scoped) but
# hides the same warning in FIRST-party code too, which the gripe
# forbids. The prewarm .pyc (pytest-inner.sh) is the source-level fix;
# these filters are the backstop for a path it can't reach (unwritable
# site-packages, a UV_WITH overlay env).
_out_filter() {
    awk -v logf="${RUN_LOG:-/dev/null}" '
        /pysbd\/[^:]*\.py:[0-9]+: SyntaxWarning:/ { print >> logf; skip=1; next }
        skip { print >> logf; skip=0; next }
        /^bringing up nodes/ { print >> logf; next }
        { print; fflush() }
    '
}
# compose's stderr carries BOTH the container's stderr and docker's own
# lifecycle chatter — indistinguishable except by line shape, so only
# unmistakable compose/daemon shapes are diverted to the log; everything
# else reaches the terminal's stderr as before.
_err_filter() {
    awk -v logf="${RUN_LOG:-/dev/null}" '
        /pysbd\/[^:]*\.py:[0-9]+: SyntaxWarning:/ { print >> logf; skip=1; next }
        skip { print >> logf; skip=0; next }
        /^(Container|Volume|Network) [^ ]+ +(Attaching|Attached|Creating|Created|Starting|Started|Restarting|Restarted|Stopping|Stopped|Killing|Killed|Removing|Removed|Waiting|Healthy|Unhealthy|Running|Exiting|Exited|Exists|Recreating|Recreated)/ { print >> logf; next }
        /^\[\+\]|^[[:space:]]*(✔|✓|⠿|⠋|⠙|⠹|⠸|⠼|⠴|⠦|⠧|⠇|⠏)/ { print >> logf; next }
        /^WARN\[[0-9]+\]|^time="/ { print >> logf; next }
        { print; fflush() }
    '
}

# Heartbeat (gr514502): a run that goes quiet — xdist's ~25 s "bringing up
# nodes", a congested gate queue — reads as wedged and gets backgrounded or
# killed by the harness. A subshell prints the current phase every 10 s on
# stderr until hb_stop; cleanup() kills it so nothing prints after exit.
HB_PID=""
hb_stop() {
    if [[ -n "$HB_PID" ]]; then
        kill "$HB_PID" 2>/dev/null || true
        wait "$HB_PID" 2>/dev/null || true
        HB_PID=""
    fi
}
hb_start() {
    local phase="$1" t0=$SECONDS
    hb_stop
    (
        while :; do
            # >/dev/null on the sleep is load-bearing: an orphaned sleep
            # would otherwise keep the caller's stdout/stderr pipes open
            # ~10 s past exit, and subprocess.run-style harnesses block on
            # pipe EOF (every env-test _run took +10 s before this).
            sleep "${PRECIS_TEST_HEARTBEAT_S:-10}" >/dev/null 2>&1
            printf 'scripts/test: %s … %ss\n' "$phase" "$((SECONDS - t0))" >&2
        done
    ) &
    HB_PID=$!
}

# --typecheck : reuses the compose project/mount above but skips the test-db
# startup and the gate-slot wait entirely (see header) — runs mypy and exits
# with its status, never falling through to the pytest path below.
if [[ "${1:-}" == "--typecheck" ]]; then
    shift
    MYPY_ARGS=("$@")
    [[ ${#MYPY_ARGS[@]} -eq 0 ]] && MYPY_ARGS=(src tests)
    # Say what is being checked (gr515825): a builder couldn't tell whether
    # tests/ were included and re-ran host mypy on the new test file to
    # satisfy the gate rule. Default target list covers BOTH src/ and tests/.
    echo "scripts/test --typecheck: uv run mypy ${MYPY_ARGS[*]} (the gate's mypy — BOTH src/ and tests/ by default)" >&2
    # One retry on 137 (gr515811): the first-run OOM is sibling pressure on
    # the shared VM, not the diff — the gripe's "first run SIGKILLed, re-run
    # green" should not cost the caller a second invocation.
    rc=0
    for _tc_attempt in 1 2; do
        rc=0
        compose run --rm --no-deps "${GIT_DIR_MOUNT[@]+"${GIT_DIR_MOUNT[@]}"}" \
            -v "${WORKTREE}":/app precis-dev \
            bash -lc 'uv run --no-sync mypy "$@"' _ "${MYPY_ARGS[@]}" || rc=$?
        [[ "$rc" == 137 ]] || break
        gate_oom_note "$rc" "the mypy container"
        echo "scripts/test: retrying --typecheck once — a lone 137 is usually a sibling OOM spike" >&2
    done
    gate_oom_note "$rc" "the mypy container"
    exit "$rc"
fi

# Co-located RAM test DB (the same service scripts/ship's gate uses). If it
# can't start, fall back to whatever PRECIS_TEST_PG_URL the container carries.
# --fast runs `-m 'not db'`, so no DB test is selected — skip the DB startup
# entirely (a real time saver and it makes the fast path Docker-DB-independent).
# One BLAS/OpenMP thread per xdist worker. Uncapped, every worker that
# touches torch/numpy sizes its pool to all container cores (15 on the M-series
# hosts), so `-n 6` runs ~190 runnable threads on 15 cores and a torch test
# that takes seconds alone crawls for tens of minutes under coverage tracing —
# the "wedged gate" that never names a wedged test (gr345784). Set here, in
# the container env, so every runtime (libgomp, OpenBLAS, MKL, numexpr) reads
# it at load, before any test module imports torch. The same keys sit on the
# warm precis-gate service in docker/dev/compose.yaml.
THREAD_CAP_ENV=(
    -e OMP_NUM_THREADS=1 -e MKL_NUM_THREADS=1 -e OPENBLAS_NUM_THREADS=1
    -e NUMEXPR_NUM_THREADS=1 -e VECLIB_MAXIMUM_THREADS=1
)

# One run log per invocation (gr513886): docker/compose lifecycle chatter
# (test-db up/down, compose-side stderr noise) and any residual pysbd
# SyntaxWarnings are appended here instead of the terminal — the filtered
# pytest stream is tee'd in too, so the file is the full transcript.
# cleanup() deletes it on a green run and names it on a red one.
RUN_LOG="$(mktemp "${TMPDIR:-/tmp}/precis-test-run.XXXXXX")"
RUN_T0=$SECONDS

# Take a fleet-wide gate slot before any heavyweight container work — BEFORE
# the tmpfs test-db below, so a queued run waits empty-handed rather than
# holding a live Postgres for the length of its wait (gr514466). --fast
# selected only no-DB tests (`-m 'not db and not slow'`), so it skips the
# queue too — no Postgres, no slot.
#
# The whole suite (or a --selected that resolved FULL above) is the run that
# outlives a ~10 min foreground shell cap — point at --bg once, before the
# wait starts (gr515646). A chained `scripts/test --typecheck && scripts/test`
# hits the cap the same way; --bg is the documented escape.
if [[ $# -eq 0 && "$IMPACTED" != 1 && "$SELECTED" != 1 && "$FAST" != 1 && "$COLLECT_ONLY" != 1 ]]; then
    echo "scripts/test: full suite — a foreground shell capped ~10 min should detach: scripts/test --bg, then poll with scripts/test --await <run-id>" >&2
fi
if [[ "$FAST" != "1" && "$COLLECT_ONLY" != "1" ]]; then
    hb_start "gate-slot wait"
    gate_slot_acquire
    hb_stop
fi

TEST_DB_ENV=()
if [[ "$FAST" == "1" || "$COLLECT_ONLY" == "1" ]]; then
    :  # no DB tests selected — don't pay for Postgres
elif hb_start "test db up" && run_marker_write && compose up -d --wait precis-test-db >>"$RUN_LOG" 2>&1; then
    TEST_DB_ENV=(-e "PRECIS_TEST_PG_URL=postgresql://postgres@precis-test-db:5432/precis_test")
else
    echo "WARNING: precis-test-db didn't start — falling back to the container's default test DB" >&2
    # Every worktree's project owns one compose network; idle ones used up
    # docker's address pools on 2026-10-03 and failed every scripts/test in the
    # fleet with only this compose error. Name the remedy.
    if grep -q 'fully subnetted' "$RUN_LOG"; then
        echo "docker is out of network address pools (idle worktree test-dbs hold them): run scripts/reap-test-dbs; PRECIS_REAP_DB_MIN_AGE_SECONDS=7200 widens it to thread trees idle 2 h" >&2
    else
        tail -n 5 "$RUN_LOG" >&2
    fi
    echo "scripts/test: the test-db startup output is in the run log: $RUN_LOG" >&2
fi
hb_stop

# Parallelism: a caller-supplied -nN always wins. Otherwise default -n6 —
# except a selection whose positional args are all test files / node ids
# (test-loop-speed Decision 1): then PRECIS_AUTO_N=1 asks the container to
# count collected items first and run -n0 at ≤500, because xdist worker
# bring-up (~4.8 s no-DB, ~24 s DB) outweighs the tests at that size.
# Directories and bare -k/-m selections keep -n6 with no count pass —
# collecting the whole suite to classify it would cost ~95 s.
AUTO_N=0
CALLER_N=0
for a in "$@"; do [[ "$a" == -n* ]] && CALLER_N=1; done
# -p no:xdist unloads the plugin, so the script must not inject its own -n6
# either (gr514400): conftest's shim swallows addopts' -n auto and the run
# goes serial. -p no:xdist / -pno:xdist are the two disable spellings.
NO_XDIST=0
_prev_p=0
for a in "$@"; do
    if [[ "$_prev_p" == 1 ]]; then
        _prev_p=0
        [[ "$a" == "no:xdist" ]] && NO_XDIST=1
        continue
    fi
    [[ "$a" == "-p" ]] && _prev_p=1
    [[ "$a" == "-pno:xdist" ]] && NO_XDIST=1
done
NPROC=(-n6)
if [[ "$CALLER_N" == 1 || "$NO_XDIST" == 1 ]]; then
    NPROC=()
elif [[ "$SERIAL" == 1 || "$COLLECT_ONLY" == 1 ]]; then
    NPROC=(-n0)
elif [[ "$IMPACTED" != "1" && "$SELECTED" != "1" ]]; then
    _auto_any=0
    _auto_files=1
    for a in "$@"; do
        case "$a" in
            -*) ;;
            *)
                _auto_any=1
                if [[ "$a" == */ || ! -f "${a%%::*}" ]]; then
                    _auto_files=0
                fi
                ;;
        esac
    done
    if [[ "$_auto_any" == 1 && "$_auto_files" == 1 ]]; then
        AUTO_N=1
        NPROC=()
    fi
fi

# Default -q unless the caller set their own verbosity — same convention
# as NPROC (gr514718): the -q used to live in the fixed pytest command,
# so `scripts/test x.py -q` compounded into -qq, which drops even the
# "N passed" summary — bare dots with nothing confirming the tests ran.
VERBOSITY=(-q)
for a in "$@"; do
    [[ "$a" =~ ^-[qv]+$ || "$a" == "--quiet" || "$a" == "--verbose" ]] && VERBOSITY=()
done

# Impacted mode: pull in the testmon plugin on the fly (no image rebuild),
# enable selection, force -n0 (testmon is per-process — xdist fragments the
# map), and persist the map per-worktree at /app/.testmondata (the bind-mount,
# so it survives on the host between runs). UV_WITH is expanded unquoted inside
# the container so an empty value adds nothing in normal mode.
#
# A caller-set UV_WITH passes through — the escape hatch for a worktree that
# ADDS a core dependency the baked image doesn't have yet:
#   UV_WITH="--with newdep" scripts/test tests/test_newdep.py
# (the ship gate itself runs `uv run` WITH sync, so it resolves new deps from
# uv.lock without an image rebuild; this passthrough gives the fast loop the
# same reach). Autobridge (gr513760, made the DEFAULT by gr525770 — a stale
# image otherwise fails every run until the operator remembers the
# UV_WITH="--with <dep>" bridge) does the same without naming the deps:
# inside the container a --with-flags pre-pass on check-core-deps.py AND
# check-dev-deps.py (gr519535: the dev-group gap is bridgeable the same way)
# computes the missing deps and EXTENDS the uv run flags — an operator-set
# UV_WITH is kept, never overwritten. It stays loud (one stderr line naming
# the bridged deps) and PRECIS_TEST_AUTOBRIDGE=0 opts out, because bridging
# is a visible workaround and the durable fix (scripts/build-image precis-dev)
# belongs to the release owner. The pre-pass is skipped on a
# .precis-preflight stamp hit — the stamp already proves every dep was
# importable under this exact image+lock+pyproject+UV_WITH key — so
# steady-state runs pay nothing for it.
UV_WITH="${UV_WITH:-}"
AUTOBRIDGE="${PRECIS_TEST_AUTOBRIDGE:-1}"
# --coverage: no report artifacts (just the sqlite DB + manifest); pytest-cov
# is a baked dev dep. Works with or without --impacted.
COV_ARGS=()
if [[ "$COVERAGE" == "1" ]]; then
    COV_ARGS=(--cov=src "--cov-context=test" "--cov-report=")
fi
TESTMON_ARGS=()
TESTMON_ENV=()
if [[ "$IMPACTED" == "1" ]]; then
    # gr451018: a first-time map build runs the whole suite serial under
    # tracing and has wedged for hours with no test name. pytest-timeout's
    # thread method (signal can't interrupt threaded tests) dumps every
    # thread's stack + the test id, then exits non-zero — a real failure to
    # testmon-exit-guard (no INTERNALERROR, so no rc-75 plain re-run).
    UV_WITH="${UV_WITH:+${UV_WITH} }--with pytest-testmon --with pytest-timeout"
    TESTMON_ARGS=(--testmon "--timeout=${PRECIS_IMPACTED_TEST_TIMEOUT:-900}" --timeout_method=thread)
    TESTMON_ENV=(-e "TESTMON_DATAFILE=/app/.testmondata")
    NPROC=(-n0)
    # pytest-testmon's own bookkeeping can INTERNALERROR on an extensionless
    # file that reached its fingerprint set (get_file, testmon_core.py ~93)
    # — sometimes AFTER pytest already printed a clean "N passed" summary,
    # so the raw exit code stops meaning "tests failed" (gr450298, gr449802).
    # Capture the run to a file (still streamed live via tee) so
    # testmon-exit-guard.py can tell a real failure from testmon's own crash.
    TESTMON_LOG="$(mktemp "${TMPDIR:-/tmp}/precis-test-testmon.XXXXXX")"
fi

# --random: pin the plugin version so the bridge resolves identically on
# every host. The seed arg only exists once the plugin is loaded, so it is
# added here (never bare): RANDOM_ORDER already covers a seed set without
# the flag.
RANDOM_ARGS=()
if [[ "$RANDOM_ORDER" == "1" ]]; then
    UV_WITH="${UV_WITH:+${UV_WITH} }--with pytest-randomly==3.16.0"
    if [[ -n "${PRECIS_RANDOM_SEED:-}" ]]; then
        RANDOM_ARGS=("--randomly-seed=${PRECIS_RANDOM_SEED}")
    fi
fi

# Fast mode: deselect the whole DB suite (auto-applied `db` marker) AND the
# heavy `slow` cluster. Both matter: the slowest two tests in the suite are
# no-DB compute tests in the `slow` pathway file, so `not db` alone would let
# them leak into the "fast" set. See docs/conventions/testing.md.
FAST_ARGS=()
if [[ "$FAST" == "1" ]]; then FAST_ARGS=(-m "not db and not slow"); fi

# gr261537: testmon's affected-tests selection doesn't know about the `slow`
# marker at all — a central-module diff can pull the 81 heavy real-EMT
# autocatpath sim tests (tests/test_pathway_plugin.py, already marked `slow`)
# into a selection that's ALSO forced to -n0, so impacted mode ends up slower
# than a plain full `scripts/test -n6`. Exclude `slow` by default under
# --testmon, same as --fast does, unless the caller passed their own `-m`
# (checked the same way NPROC checks for a caller-supplied `-n` above) or is
# already running --fast (whose `-m` already excludes `slow`).
TESTMON_MARKER_ARGS=()
if [[ "$IMPACTED" == "1" && "$FAST" != "1" ]]; then
    HAS_CALLER_MARKER=0
    for a in "$@"; do [[ "$a" == -m* ]] && HAS_CALLER_MARKER=1; done
    if [[ "$HAS_CALLER_MARKER" == "0" ]]; then
        TESTMON_MARKER_ARGS=(-m "not slow")
    fi
fi

# Preflight cache key (gr514478): the four stale-baked-venv checks run
# when this changes, skip on a hit (see pytest-inner.sh). Covers exactly
# the drift the checks guard: the baked image (id), deps (uv.lock,
# pyproject.toml) and the UV_WITH bridge. Empty when no sha256 tool —
# the inner then runs the checks every time, as before.
_sha256() {
    if command -v shasum >/dev/null 2>&1; then shasum -a 256 "$@"
    elif command -v sha256sum >/dev/null 2>&1; then sha256sum "$@"
    else return 1; fi
}
PRECIS_PREFLIGHT_KEY=""
if command -v shasum >/dev/null 2>&1 || command -v sha256sum >/dev/null 2>&1; then
    _img="$(docker image inspect precis-dev --format '{{.Id}}' 2>/dev/null || true)"
    _lock_sha="$(_sha256 uv.lock 2>/dev/null | cut -d' ' -f1 || true)"
    _py_sha="$(_sha256 pyproject.toml 2>/dev/null | cut -d' ' -f1 || true)"
    PRECIS_PREFLIGHT_KEY="$(printf '%s' "${_img:-noimg}|${_lock_sha:-nolock}|${_py_sha:-nopy}|${UV_WITH:-}" | _sha256 | cut -d' ' -f1)"
fi

# Artifact-writing tests (the PCB fab render, chiefly) need to be TOLD where to
# put their output, and nothing but UV_WITH used to cross the container
# boundary — so producing a board to look at meant hand-editing a default path
# into the test and reverting it afterwards. The path is interpreted INSIDE the
# container, where this worktree is mounted at /app, so a repo-relative path
# lands on the host.
ARTIFACT_ENV=()
# Space-delimited list of every name forwarded below — the unforwarded-
# name warning reads it (a plain string, not an assoc array: this script
# must still run on the stock bash 3.2 macOS ships).
_FORWARDED_ENV=""
for _render_var in PRECIS_PCB_RENDER_OUT PRECIS_PCB_RENDER_SEED PRECIS_PCB_RENDER_FIXTURE PRECIS_PCB_RENDER_ITERS PRECIS_WATCH_SEED PRECIS_UPDATE_KINETICS_GOLDEN PRECIS_UPDATE_EXPORT_GOLDEN PRECIS_UPDATE_HEXFOLD_GOLDENS PRECIS_EPRO_FIXTURE PRECIS_PCB_REPLAY_FIXTURE PRECIS_PCB_BENCH_OUT PRECIS_PCB_BENCH_TAZ15; do
    if [[ -n "${!_render_var:-}" ]]; then
        ARTIFACT_ENV+=(-e "${_render_var}=${!_render_var}")
        _FORWARDED_ENV="$_FORWARDED_ENV $_render_var"
    fi
done

# PRECIS_TEST_ENV — the opt-in for everything the fixed list above does
# NOT cover (gr513868: NANO_SEEDS was exported on the host, silently
# dropped at the container boundary, and a 4-minute seed-iteration run
# measured seed 1). Syntax and the refused-name list are documented once,
# in the --help Env block; the loop below enforces them.
for _kv in ${PRECIS_TEST_ENV:-}; do
    _env_name="${_kv%%=*}"
    if [[ "$_kv" != *=* || ! "$_env_name" =~ ^[A-Z][A-Z0-9_]*$ ]]; then
        echo "ERR: PRECIS_TEST_ENV entry '${_kv}' is not NAME=value (name must match ^[A-Z][A-Z0-9_]*$)" >&2
        exit 1
    fi
    case "$_env_name" in
        PATH|HOME|PYTHON*|DATABASE*|PG*)
            echo "ERR: PRECIS_TEST_ENV may not forward ${_env_name} (container/runtime internal)" >&2
            exit 1
            ;;
    esac
    ARTIFACT_ENV+=(-e "$_kv")
    _FORWARDED_ENV="$_FORWARDED_ENV $_env_name"
done

# A test-tuning variable exported on the host but not forwarded reads as
# "set" to the author and silently absent inside the container — name it
# once on stderr so the run isn't wasted guessing why it was ignored.
while IFS= read -r _host_var; do
    case "$_host_var" in
        NANO_*|ESP32C3_*|PRECIS_PCB_*)
            case " $_FORWARDED_ENV " in
                *" $_host_var "*) ;;
                *)
                    printf 'scripts/test: %s is set but not forwarded into the container; use PRECIS_TEST_ENV="%s=%s"\n' \
                        "$_host_var" "$_host_var" "${!_host_var:-}" >&2
                    ;;
            esac
            ;;
    esac
done < <(compgen -e)

# --no-sync: the image already bakes the venv and installs /app editable, so
# the bind-mounted source is live without a per-run reinstall (that reinstall
# was pure noise + latency — the reason sessions hand-rolled `--no-sync`).
# -p no:warnings drops the warnings summary (noise while iterating); --tb=short
# keeps tracebacks compact; the -q is a positional arg (VERBOSITY) so a
# caller-supplied -v/-q can replace it. Pass pytest args as inner
# positional params ("$@") so no cross-shell re-quoting is needed.
#
# Preflight (gr286507): a stale baked venv (new core dep promoted, image not
# yet rebuilt) otherwise surfaces as ModuleNotFoundError red tests in whatever
# file pytest collects first — unrelated to the change under test, and
# expensive to root-cause from cold. check-core-deps.py imports every
# `[project] dependencies` entry under the SAME `uv run --no-sync ${UV_WITH}`
# prefix as pytest (so a UV_WITH bridge is honoured here too) and fails loud,
# before pytest starts, naming the missing module(s) and the fix. One extra
# `uv run` in the same container — no second container spin-up.
#
# check-dev-deps.py (gr519535) is the dev-group sibling: a dep added to
# [dependency-groups] dev after the image bake is absent under --no-sync,
# and its tests quiet-skip via importorskip instead of going red — the gap
# is invisible until you look for it. It compares the container's installed
# distributions against uv.lock's [package.dev-dependencies] (presence, not
# import — the types-*/stubs entries ship no module) and refuses with the
# same bridge + rebuild exits. A bridged pass must never write the
# preflight stamp: it proves the --with overlay, not the base venv — the
# exported AUTO_WITH tells pytest-inner.sh not to stamp (gr519535).
#
# check-lock-pins.py (gr494988) is the version-drift sibling: an installed
# package whose version/git commit differs from uv.lock (image built before the
# lock moved) warns, naming the stale packages and the rebuild command; it only
# refuses under PRECIS_STRICT_LOCK_CHECK=1.
#
# check-entry-points.py (gr453828) is its sibling for the same stale-baked-venv
# failure mode: `importlib.metadata.entry_points()` reads the STATIC
# `entry_points.txt` baked into the venv at image-build time, which the
# source-only bind-mount + `--no-sync` never regenerate. An image built before
# an entry-points change (e.g. the nm->se merge) hands wrong answers to any
# test reading the real `entry_points(group="precis.handlers")` while every
# import still succeeds — no red module error to point at. It diffs the
# worktree's `[project.entry-points.*]` against the installed dist-info;
# `--heal` reinstalls into this run's throwaway container (~3 s) and fails
# loud only if drift survives that. UV_WITH can't bridge metadata.
# All three steps run inside ONE `uv run` (gr462134): with UV_WITH set,
# every `uv run --with` builds a fresh overlay env, so a heal in its own
# `uv run` patched an env pytest never saw and plugin migrations (se)
# silently went undiscovered. `-P` keeps `-m` from prepending the cwd
# (/app) to sys.path, so imports resolve exactly as bare `pytest`'s did;
# bare `pytest` itself would run the base venv's interpreter, not the
# healed overlay.
# prewarm-pycache.py (gr514615): pysbd emits a SyntaxWarning at compile
# time, and the image's PYTHONDONTWRITEBYTECODE=1 means no .pyc is ever
# cached — so every process that imports it recompiles and re-prints the
# warnings above the result. Compiling the package once here writes the
# .pyc that all later imports read. It runs FIRST in the chain because
# check-core-deps.py's own `import pysbd` would otherwise emit the same
# warnings before pytest ever started.
#
# One pytest container run. $1 = "testmon" adds the testmon args, anything
# else runs plain (the gr471933 fallback); remaining args are the caller's.
run_pytest() {
    local mode="$1"; shift
    local -a tm_args=()
    if [[ "$mode" == "testmon" ]]; then
        tm_args=("${TESTMON_ARGS[@]+"${TESTMON_ARGS[@]}"}")
    fi
    local rc=0
    # The stdout filter (_out_filter) drops xdist's "bringing up nodes..."
    # status line — printed for non-tty runs whenever verbosity < 0 (i.e.
    # our -q), with no upstream off switch (xdist/dsession.py getstatus) —
    # and any residual pysbd SyntaxWarning pair into the run log; the
    # stderr filter (_err_filter) sends docker/compose lifecycle chatter
    # the same way (gr513886). The tee appends the filtered stream to the
    # log so the file is the full transcript.
    #
    # The stderr filter drains a fifo as a real background job — a process
    # substitution's pid isn't waitable on bash 3.2, so a late crash
    # traceback could still print after the verdict. The fifo's opens pair
    # (reader below, compose's fd 2 next); when compose exits the reader
    # sees EOF and exits, and `wait` returns before the run continues —
    # cleanup()'s verdict is then genuinely the last line.
    ERR_FIFO="$(mktemp -u "${TMPDIR:-/tmp}/precis-test-err.XXXXXX")"
    mkfifo "$ERR_FIFO"
    _err_filter >&2 <"$ERR_FIFO" &
    ERR_FILTER_PID=$!
    compose run --rm --no-deps -e UV_LINK_MODE=copy -e UV_WITH="$UV_WITH" \
        -e PRECIS_STRICT_LOCK_CHECK="${PRECIS_STRICT_LOCK_CHECK:-}" \
        -e PRECIS_TEST_AUTOBRIDGE="$AUTOBRIDGE" \
        -e PRECIS_AUTO_N="$AUTO_N" \
        -e PRECIS_PREFLIGHT_KEY="$PRECIS_PREFLIGHT_KEY" \
        "${GIT_DIR_MOUNT[@]+"${GIT_DIR_MOUNT[@]}"}" \
        "${THREAD_CAP_ENV[@]}" \
        "${TEST_DB_ENV[@]+"${TEST_DB_ENV[@]}"}" "${TESTMON_ENV[@]+"${TESTMON_ENV[@]}"}" \
        "${ARTIFACT_ENV[@]+"${ARTIFACT_ENV[@]}"}" \
        "${PASSENV[@]+"${PASSENV[@]}"}" \
        -v "${WORKTREE}":/app precis-dev \
        bash -lc 'CORE_FLAGS=""; DEV_FLAGS=""; AUTO_WITH=""; export AUTO_WITH; if [ "${PRECIS_TEST_AUTOBRIDGE}" != "0" ]; then _STAMP="${PRECIS_PREFLIGHT_STAMP:-/app/.precis-preflight}"; _STAMP_HIT=""; if [ -n "${PRECIS_PREFLIGHT_KEY:-}" ] && [ -f "$_STAMP" ] && [ "$(cat "$_STAMP" 2>/dev/null)" = "${PRECIS_PREFLIGHT_KEY}" ]; then _STAMP_HIT=1; fi; if [ -z "$_STAMP_HIT" ]; then CORE_FLAGS="$(uv run --no-sync ${UV_WITH} python3 scripts/lib/check-core-deps.py --with-flags 2>/dev/null || true)"; DEV_FLAGS="$(uv run --no-sync ${UV_WITH} python3 scripts/lib/check-dev-deps.py --with-flags 2>/dev/null || true)"; AUTO_WITH="${CORE_FLAGS:+${CORE_FLAGS} }${DEV_FLAGS}"; if [ -n "$AUTO_WITH" ]; then echo "scripts/test: stale precis-dev image — auto-bridging missing dep(s) for this run: ${AUTO_WITH} (durable fix: scripts/build-image precis-dev; opt out: PRECIS_TEST_AUTOBRIDGE=0)" >&2; fi; fi; fi; uv run --no-sync ${UV_WITH} ${AUTO_WITH} bash scripts/lib/pytest-inner.sh "$@"' \
        _ "${VERBOSITY[@]+"${VERBOSITY[@]}"}" "${NPROC[@]+"${NPROC[@]}"}" "${tm_args[@]+"${tm_args[@]}"}" \
        "${FAST_ARGS[@]+"${FAST_ARGS[@]}"}" "${TESTMON_MARKER_ARGS[@]+"${TESTMON_MARKER_ARGS[@]}"}" \
        "${RANDOM_ARGS[@]+"${RANDOM_ARGS[@]}"}" \
        "${COV_ARGS[@]+"${COV_ARGS[@]}"}" "$@" \
        2>"$ERR_FIFO" | _out_filter | tee -a "$RUN_LOG" || rc=$?
    wait "$ERR_FILTER_PID" 2>/dev/null || true
    ERR_FILTER_PID=""
    rm -f "$ERR_FIFO"
    ERR_FIFO=""
    # Exit 137 = the container's own OOM kill (mem_limit in compose.yaml) —
    # name it as such rather than a silent red run (gate-slot.sh).
    gate_oom_note "$rc" "the pytest container"
    return "$rc"
}

# --selected: the static half (contract + map + corpus-coupled + direct
# importers when no map) runs first as a normal -n6 run; when a testmon map
# exists the impacted half falls through to the captured --testmon run below.
if [[ "$SELECTED" == 1 ]]; then
    echo "checked selection: ${#SEL_ARGS[@]} static targets$([[ "$IMPACTED" == 1 ]] && echo ' + testmon set')"
    if [[ ${#SEL_ARGS[@]} -gt 0 ]]; then
        SEL_MARK=(-m "not slow")
        for a in "$@"; do [[ "$a" == -m* ]] && SEL_MARK=(); done
        hb_start "pytest"
        run_pytest plain -n6 "${SEL_MARK[@]+"${SEL_MARK[@]}"}" "${SEL_ARGS[@]+"${SEL_ARGS[@]}"}" "$@" || exit $?
        hb_stop
    fi
    # No map → the static list was the whole selection; a map → testmon run below.
    [[ "$IMPACTED" == 1 ]] || exit 0
fi

hb_start "pytest"
if [[ -n "$TESTMON_LOG" ]]; then
    # --impacted: stream to the terminal AND capture, so a post-run guard can
    # see the same text a human would tail (see the TESTMON_LOG comment
    # above). set +e/-e brackets the pipeline: `pipefail` makes a nonzero
    # pytest exit fail the whole statement, which would otherwise trip
    # `set -e` before PYTEST_RC is read.
    set +e
    run_pytest testmon "$@" 2>&1 | tee "$TESTMON_LOG"
    PYTEST_RC=${PIPESTATUS[0]}
    python3 "${WORKTREE}/scripts/lib/testmon-exit-guard.py" "$TESTMON_LOG" "$PYTEST_RC" "$WORKTREE"
    GUARD_RC=$?
    set -e
    # gr471933: rc 75 = testmon crashed with no pytest summary (the guard has
    # already printed the traceback tail + log path; keep that log). Degrade
    # to a plain run of the same files in this call when the caller named
    # any; otherwise say how.
    if [[ "$GUARD_RC" == "75" ]]; then
        KEEP_TESTMON_LOG=1
        HAS_PATHS=0
        for a in "$@"; do
            if [[ "$a" != -* && ( "$a" == *.py* || "$a" == *::* || -e "$a" ) ]]; then HAS_PATHS=1; fi
        done
        if [[ "$HAS_PATHS" == "1" ]]; then
            echo "testmon crashed; re-running the same tests once WITHOUT --testmon (plain mode)" >&2
            set +e
            run_pytest plain "$@"
            GUARD_RC=$?
            set -e
        else
            echo "testmon crashed and no test paths were given; run the fallback yourself: scripts/test <test files>   (or plain, no impact selection: scripts/test)" >&2
        fi
    fi
    exit "$GUARD_RC"
else
    run_pytest testmon "$@"
fi
hb_stop

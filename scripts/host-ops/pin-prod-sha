#!/usr/bin/env bash
# Pin the prod watched checkout at ONE sha — the fixed helper the factory's
# deploy leg runs as the checkout's owner (gr685985). Two invocation shapes,
# neither takes anything but the sha:
#
#   pin-prod-sha <sha>                          (the owner runs it)
#   sudo -n -u <owner> pin-prod-sha <sha>       (the factory's worker user)
#
# The sudo shape is the whole point: the checkout belongs to the MCP's user,
# the factory must move it for the CheckoutWatchdog to restart the server
# onto the release, and a one-line sudoers grant on THIS script (nothing
# else — no env passing, no shell) is the narrowest safe bridge. Sudo
# scrubs the environment. The target is always <main-checkout>-prod,
# derived from the Git common directory of this helper, never environment or HOME.
#
# Does only the pin: resolve the checkout, fetch if the sha is unknown
# there, detach HEAD at the sha, print one line. Anything that is not
# exactly one well-formed sha is refused with exit 2; a well-formed sha
# that names no commit in the checkout is exit 1.
#
# The root-owned install and the matching sudoers grant are host ops, done
# by hand — see pin-prod-sha.sudoers next to this script.
set -euo pipefail

usage() {
  cat <<'EOF'
usage: pin-prod-sha <sha>

Detach the prod watched checkout (the session MCP's clone, resolved like
<main-checkout>-prod) at <sha>, a hex sha of 7-40 characters. Exactly
one argument; anything else is refused. Prints the pinned sha on success.
EOF
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
esac
if [[ $# -ne 1 || ! "$1" =~ ^[0-9a-f]{7,40}$ ]]; then
  usage >&2
  exit 2
fi
SHA="$1"

# Self-contained on purpose: when run under sudo this file is the installed
# root-owned copy, so it sources nothing from a repo checkout (a file the
# factory user can write would run as the owner). The prod checkout is the
# single `PROD_CHECKOUT=<abs path>` line of the root-owned `<helper>.conf`
# beside the installed copy (read with sed, never sourced); a repo copy with
# no conf derives <main-checkout>-prod from its own Git common directory.
# Caller environment overrides are ignored either way.
unset PRECIS_PROD_CHECKOUT PROD_CHECKOUT
_self="${BASH_SOURCE[0]}"
PROD_CHECKOUT=""
if [[ -f "${_self}.conf" ]]; then
  PROD_CHECKOUT="$(sed -n 's/^PROD_CHECKOUT=\(\/[^[:space:]]*\)$/\1/p' "${_self}.conf" | head -n1)"
else
  REPO="$(cd "$(dirname "$_self")/../.." && pwd)"
  _common="$(git -C "$REPO" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
  PROD_CHECKOUT="$(dirname "${_common:-$REPO/.git}")-prod"
fi
[[ -n "$PROD_CHECKOUT" && -f "${PROD_CHECKOUT}/.git/HEAD" ]] || {
  echo "no prod checkout at ${PROD_CHECKOUT:-<unresolved>} (installed copy: PROD_CHECKOUT=<abs path> in ${_self}.conf)" >&2; exit 1; }
if ! git -C "$PROD_CHECKOUT" cat-file -e "${SHA}^{commit}" 2>/dev/null; then
  git -C "$PROD_CHECKOUT" fetch -q origin || {
    echo "fetch origin failed in ${PROD_CHECKOUT}" >&2; exit 1; }
fi
FULL="$(git -C "$PROD_CHECKOUT" rev-parse --verify --quiet "${SHA}^{commit}")" || {
  echo "${SHA} is not a commit in ${PROD_CHECKOUT} (fetched origin; still unknown)" >&2; exit 1; }
git -C "$PROD_CHECKOUT" checkout -q --detach "$FULL" || {
  echo "prod clone ${PROD_CHECKOUT} not moved to ${FULL:0:8} (local edits?)" >&2; exit 1; }
echo "precis-mcp-prod at $(git -C "$PROD_CHECKOUT" rev-parse --short HEAD) (${PROD_CHECKOUT})"

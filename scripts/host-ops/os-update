#!/usr/bin/env bash
# Rolling OS + firmware update for ONE GB10 host (Reto approved 2026-10-15
# ~16:40Z; ported from a /tmp/gripe-fleet os-update script). Run once per
# host, in this order, only after the previous host came back clean:
#     scripts/host-ops/os-update --host <canary-node>    # idle canary GPU node, no LLM
#     scripts/host-ops/os-update --host <science-node>   # science lanes
#     scripts/host-ops/os-update --host <serving-node>   # the LLM host
#   (LLM down for the reboot plus ~2 min model load: SGLang, measured 2026-11-10)
#
# What was pending (read-only apt/fwupd check, 2026-10-15 ~16:45Z):
#   * NVIDIA driver 580.173.02 (serving and science nodes) / 580.159.03 (canary
#     node) -> 580.178.04. Same R580 branch (CUDA 13.0 driver API): no new driver
#     major and no new CUDA major. cuda-toolkit-13-0 (13.0.3) is not upgraded;
#     only the cuda-toolkit*-config-common metapackages move 13.3 -> 13.4.
#   * Kernel: linux-nvidia-hwe-24.04 6.17.0 -> 7.0.0-1019 (a kernel MAJOR
#     jump), with the matching prebuilt linux-modules-nvidia-580-open. This is
#     the item to watch: the canary run proves the driver loads on 7.0.
#   * nvidia-container-toolkit libs 1.19.1/1.20.0 -> 1.20.1 (docker --gpus path).
#   * linux-firmware, nvidia-ai-workbench (serving and science nodes); ~286-350
#     packages total.
#   * fwupd: the science node lists GB10 USB-C PD controller firmware
#     (capsule on disk, applied at reboot); the serving and canary nodes report
#     nothing pending.
#   The serving container (SGLang since 2026-10-16; vLLM before; own CUDA
#   userspace), MACE (torch 2.13 cu13) and the tblite
#   wheel (CPU) depend on the driver branch, not the kernel: no rebuild
#   expected. The post-reboot checks below prove the GPU path on each host.
#
# Per-host settings come from the gitignored cluster overlay, as host keys read
# with resolve_node_var (scripts/lib/node-host.sh):
#   os_update_units  comma-separated systemd units to check after the reboot,
#                    e.g. `sglang,precis-worker`; a unit list containing
#                    `sglang` (or `vllm`; first match) also gets the LLM
#                    health wait. Required.
#   os_update_peer   the node that runs the precis reserve CLI while HOST
#                    reboots (a peer that keeps running). Required unless
#                    RUN_ON is set.
#
# Per host: reserve (no new heavy claims) -> wait for running compute to drain
# -> apt full-upgrade -> fwupd update -> reboot -> wait for ssh -> check
# kernel, nvidia-smi, docker GPU, precis units -> release the reserve.
# Needs: ssh as a sudo-capable user on the host; RUN_ON (default: the host's
# os_update_peer overlay key) for the precis CLI reserve/release.
#
# Flags: --host <node> (required; any node with os_update_units); --dry-run (print the plan);
#        --drain-timeout <min> (default 240); --force-drain (reboot even if
#        compute is still running after the timeout).
set -euo pipefail

_HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=scripts/lib/node-host.sh
. "${_HERE}/../lib/node-host.sh"

usage() {
  cat <<'EOF'
usage: os-update --host <node> [--dry-run] [--drain-timeout MIN]
                 [--force-drain]

Rolling OS + firmware update for ONE GB10 host: reserve -> drain ->
apt/dpkg lock check -> apt full-upgrade -> fwupd -> reboot -> checks ->
release. Run order: the idle canary GPU node, then the science node, then
the serving node — one host at a time, only after the previous host's
checks are all active. The unit list (os_update_units) and the peer that
runs the precis reserve CLI (os_update_peer, or RUN_ON) are per-host keys
in the cluster overlay (deploy/inventory/hosts.yml).
EOF
}

HOST=""; DRY=0; DRAIN_MIN=240; FORCE=0
while [[ $# -gt 0 ]]; do
  case "$1" in
    --host) HOST="$2"; shift 2 ;;
    --dry-run) DRY=1; shift ;;
    --drain-timeout) DRAIN_MIN="$2"; shift 2 ;;
    --force-drain) FORCE=1; shift ;;
    --help|-h) usage; exit 0 ;;
    *) echo "unknown flag $1 (try --help)" >&2; exit 2 ;;
  esac
done
[[ -n "$HOST" ]] || { echo "--host <node> required (try --help)" >&2; exit 2; }
# Per-host units (comma-separated in the overlay) and the reserve-CLI peer.
UNITS="$(resolve_node_var "$HOST" os_update_units 2>/dev/null || true)"
if [[ -z "$UNITS" ]]; then
  echo "os-update: no os_update_units for '$HOST' in the cluster overlay" \
       "(deploy/inventory/hosts.yml): add the key to that host's block," \
       "e.g. os_update_units: sglang,precis-worker" >&2
  exit 2
fi
UNITS="${UNITS//,/ }"
# The precis CLI runs on a peer that keeps running while HOST reboots.
if [[ -z "${RUN_ON:-}" ]]; then
  RUN_ON="$(resolve_node_var "$HOST" os_update_peer 2>/dev/null || true)"
  if [[ -z "$RUN_ON" ]]; then
    echo "os-update: no os_update_peer for '$HOST' in the cluster overlay" \
         "(deploy/inventory/hosts.yml) and RUN_ON unset: add the key or" \
         "export RUN_ON=<node>" >&2
    exit 2
  fi
fi
ACTOR="os-update-$(date -u +%Y%m%dT%H%MZ)"
SSH=(ssh -o BatchMode=yes -o ConnectTimeout=10)
say() { echo "[$(date -u +%H:%M:%SZ)] $HOST: $*"; }
run() { if (( DRY )); then echo "DRY: $*"; else "$@"; fi; }

precis_cli() {
  # shellcheck disable=SC2029
  "${SSH[@]}" "$RUN_ON" "
    dsn=\$(systemctl show precis-worker -p Environment --value | tr ' ' '\n' | sed -n 's/^PRECIS_DATABASE_URL=//p')
    sudo -u deploy -H env PGPASSFILE=/home/deploy/.pgpass /opt/precis/venv/bin/precis service $* --database-url \"\$dsn\""
}

say "1/7 reserve (CLI on $RUN_ON): no new heavy (ssh_node/claude_docker) claims for 6 h"
run precis_cli reserve --host "$HOST" --hours 6 --actor "$ACTOR"

say "2/7 drain: wait for autocatpath seeds and job containers to finish (<= ${DRAIN_MIN} min)"
# One busy check for this script and the weekly guard the hardening role
# installs (gr491172): piped over ssh, so it needs nothing deployed first.
HOST_BUSY="$(dirname "${BASH_SOURCE[0]}")/../../deploy/roles/hardening/files/host-busy"
busy() {
  "${SSH[@]}" "$HOST" 'bash -s' <"$HOST_BUSY" || true
}
if (( ! DRY )); then
  deadline=$(( $(date +%s) + DRAIN_MIN * 60 ))
  while :; do
    b=$(busy); [[ "$b" == 0 ]] && break
    [[ "$b" =~ ^[0-9]+$ ]] || { say "host-busy unreadable (${b:-no output}); fix ssh/docker access and rerun"; exit 1; }
    if (( $(date +%s) > deadline )); then
      (( FORCE )) || { say "still $b compute process(es)/container(s) after ${DRAIN_MIN} min; rerun with --force-drain or wait"; exit 1; }
      say "forcing reboot with $b still running (--force-drain)"; break
    fi
    say "  $b still running; next check in 5 min"; sleep 300
  done
fi

say "2b/7 apt/dpkg lock check (refuse on a holder older than 1 h)"
# 2026-10-15: the canary node had an `apt update` from dgx-dashboard-admin hung since Sep 24
# (fetchers idle, sockets CLOSE-WAIT) holding /var/lib/apt/lists/lock. Never kill
# it from here; print the holder and the exact kill line for Reto.
# shellcheck disable=SC2016  # the script body runs on the remote host
stale=$("${SSH[@]}" "$HOST" '
  for l in /var/lib/apt/lists/lock /var/lib/dpkg/lock /var/lib/dpkg/lock-frontend /var/cache/apt/archives/lock; do
    for p in $(sudo -n fuser "$l" 2>/dev/null); do
      age=$(ps -o etimes= -p "$p" | tr -d " ")
      [ -n "$age" ] && [ "$age" -gt 3600 ] && echo "$p $age $l $(ps -o args= -p "$p" | cut -c1-80)"
    done
  done | sort -u' || true)
if [[ -n "$stale" ]]; then
  say "REFUSE: stale apt/dpkg lock holder(s) (pid age_s lock cmd):"
  echo "$stale"
  pids=$(awk '{print $1}' <<<"$stale" | sort -u | tr '\n' ' ')
  say "if they are hung (idle fetchers, CLOSE-WAIT sockets), Reto runs:"
  echo "  ssh $HOST 'for p in $pids; do sudo pkill -P \$p; sudo kill \$p; done; sleep 5; sudo fuser -v /var/lib/apt/lists/lock /var/lib/dpkg/lock-frontend; sudo dpkg --audit && echo dpkg-clean'"
  say "then rerun this script (the reserve is still set)"
  exit 1
fi

say "3/7 apt full-upgrade"
run "${SSH[@]}" "$HOST" 'sudo apt-get update -q && sudo DEBIAN_FRONTEND=noninteractive apt-get -y -q -o Dpkg::Options::=--force-confold full-upgrade'

say "4/7 firmware (capsule-on-disk updates apply during the reboot)"
run "${SSH[@]}" "$HOST" 'sudo fwupdmgr refresh --force >/dev/null || true; sudo fwupdmgr update -y --no-reboot-check || true'

say "5/7 reboot"
run "${SSH[@]}" "$HOST" 'sudo systemctl reboot' || true

if (( ! DRY )); then
  sleep 60
  say "6/7 wait for ssh (<= 25 min; firmware capsules lengthen the boot)"
  for _ in $(seq 1 50); do
    "${SSH[@]}" "$HOST" true 2>/dev/null && break
    sleep 30
  done
  "${SSH[@]}" "$HOST" true || { say "NOT BACK after 25 min: check the console"; exit 1; }
fi

say "7/7 checks"
run "${SSH[@]}" "$HOST" "
  set -e
  echo kernel: \$(uname -r)
  nvidia-smi --query-gpu=name,driver_version --format=csv,noheader
  sudo docker run --rm --gpus all nvidia/cuda:12.6.1-base-ubuntu22.04 nvidia-smi -L 2>/dev/null \
    || echo 'WARN docker --gpus smoke failed (image absent? check nvidia-container-toolkit)'
  for u in $UNITS \$(systemctl list-units --no-legend 'precis-*' | awk '{print \$1}'); do
    printf '%-34s %s\n' \"\$u\" \"\$(systemctl is-active \"\$u\")\"
  done
  systemctl --failed --no-legend
"
# The serving unit in the list (first match: sglang, then vllm) gets the health wait.
LLM_UNIT=""
for _u in sglang vllm; do
  case " $UNITS " in *" $_u "*) LLM_UNIT="$_u"; break ;; esac
done
if [[ -n "$LLM_UNIT" && $DRY == 0 ]] && \
   [[ "$("${SSH[@]}" "$HOST" "systemctl is-enabled $LLM_UNIT 2>/dev/null" || true)" != enabled ]]; then
  say "$LLM_UNIT disabled, skipping health wait"   # vllm stopped 18:44Z 2026-10-15 (gr489474)
elif [[ -n "$LLM_UNIT" && $DRY == 0 ]]; then
  say "waiting for $LLM_UNIT health (model load ~2 min on SGLang; cap 20 min)"
  for _ in $(seq 1 40); do
    "${SSH[@]}" "$HOST" 'curl -sf localhost:8000/health' >/dev/null 2>&1 && { say "$LLM_UNIT healthy"; break; }
    sleep 30
  done
fi

say "release the reserve"
run precis_cli release --host "$HOST"
say "done: confirm the unit list above is all active before the next host"

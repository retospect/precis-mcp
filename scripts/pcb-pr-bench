#!/usr/bin/env bash
# scripts/pcb-pr-bench — the slice-2 place-and-route bench: every bench
# board routed by the production vector router and by the pcb.pr v1 engine
# from the same job placement, one table (docs/backlog/pcb-place-route-
# datamodel.md §Slice 2 results; the boards: tests/fixtures/pcb/pr_bench.py).
#
# Usage:
#   scripts/pcb-pr-bench [OUT.md]            # default .scratch/pcb-pr-bench/bench.md
#   PRECIS_PCB_PR_BENCH_BOARDS=nano,qfp-plaza scripts/pcb-pr-bench   # a subset
#
# DB-free (the boards are built from their design dicts and placed with the
# place job's own call), run through scripts/test for the torch-bearing
# container; CPU only — no GPU host is reachable from a worktree. Opt-in:
# nothing here runs in default CI.
set -euo pipefail

out="${1:-.scratch/pcb-pr-bench/bench.md}"
here="$(cd "$(dirname "$0")/.." && pwd)"
cd "$here"

PRECIS_PCB_PR_BENCH_OUT="$out" scripts/test -n0 -s \
    tests/test_pcb_pr_bench.py::test_slice2_bench_table
echo "table: $out"

#!/usr/bin/env bash
# Launch Kimi Code in its own task worktree (here, or in a tmux window).
#
#   scripts/kimi-tree NAME [--purpose TEXT] [--prompt TEXT] [--model ALIAS]
#                          [--mode yolo|auto|manual] [--tmux [SESSION]]
#                          [--dry-run]
#
# Mirrors `claude -w NAME` and scripts/devin-tree: worktree
# .claude/worktrees/NAME on branch worktree-NAME, cut from origin/main (an
# existing tree/branch is reused, never reset), .venv seeded from main. The
# tree is locked `pid <N>` to the Kimi process — scripts/inflight and the
# reaper read that as liveness (session-start-lock.sh only finds Claude), so
# a merged+clean tree auto-reaps after Kimi exits.
# Runs scripts/kimi-setup first (precis MCP entry, hook adapter, skills).
# --mode: yolo (default; Kimi's "Ask When Needed", the analogue of Claude's
# auto mode), auto (Never Ask, builder waves), manual. --prompt runs one
# prompt non-interactively (`kimi -p`; --mode is ignored). --tmux opens a window in SESSION
# (default: the current one) instead of taking over this terminal.
# PRECIS_CO_AUTHOR is exported so scripts/ship's fallback footer names Kimi.
# An interactive launch without a tty is refused: kimi has no trust flag
# (2.3.3 `kimi --help`), so an untrusted folder's "Trust this folder?"
# prompt would read a stdin that can never answer and hang forever
# (gr537789). `kimi -p` never shows the prompt, so --prompt launches still
# run — bounded by KIMI_TREE_TIMEOUT seconds (default 1800) when timeout/
# gtimeout is on PATH.
#
# Internal: `--exec TREE [KIMI ARGS]` re-locks TREE to its own pid, then
# execs Kimi under that same pid.
set -euo pipefail

at_label=kimi
. "$(dirname "$(realpath "$0")")/lib/agent-tree.sh"
at_init
self=$(realpath "$0")

# Refuse an interactive launch kimi could never get past: the trust
# prompt reads stdin, and with no tty nothing can answer it. Prints the
# manual equivalent so a background caller knows how to validate by hand.
kimi_tree_no_tty() {
	local tree=$1
	shift
	echo "kimi-tree: stdin is not a tty — kimi's 'Trust this folder?'" >&2
	echo "  prompt would wait forever; skipping the launch." >&2
	echo "  To validate by hand, from a terminal:" >&2
	printf '    cd %q && kimi' "$tree" >&2
	if (($#)); then printf ' %q' "$@" >&2; fi
	printf '\n' >&2
	exit 1
}

if [[ ${1:-} == --exec ]]; then
	tree=$2
	shift 2
	at_exec_relock "$tree"
	export PATH="$HOME/.kimi-code/bin:$HOME/.local/bin:$PATH"
	export PRECIS_CO_AUTHOR="${PRECIS_CO_AUTHOR:-Kimi Code <noreply@moonshot.ai>}"
	prompt_mode=0
	for a in "$@"; do case $a in -p | --prompt) prompt_mode=1 ;; esac; done
	if ((!prompt_mode)) && [[ ! -t 0 ]]; then
		# Under --tmux this runs inside the window, where stdin is the
		# pty — only a direct no-tty launch lands here.
		kimi_tree_no_tty "$tree" "$@"
	fi
	runner=()
	if ((prompt_mode)); then
		# A one-shot launch gets a bounded run: even without a trust
		# prompt it must not outlive the caller that spawned it.
		if command -v timeout >/dev/null 2>&1; then
			runner=(timeout "${KIMI_TREE_TIMEOUT:-1800}")
		elif command -v gtimeout >/dev/null 2>&1; then
			runner=(gtimeout "${KIMI_TREE_TIMEOUT:-1800}")
		fi
	fi
	exec ${runner[@]+"${runner[@]}"} kimi "$@"
fi

usage() { sed -n '4,6p' "$0" | sed 's/^# *//' >&2; exit 2; }
[[ $# -ge 1 && ${1:0:1} != - ]] || usage
name=$1
shift
at_check_name "$name"
purpose="" prompt="" model="" mode=yolo tmux_session="" use_tmux=0 dry_run=0
while [[ $# -gt 0 ]]; do
	case $1 in
	--purpose) purpose=$2; shift 2 ;;
	--prompt) prompt=$2; shift 2 ;;
	--model) model=$2; shift 2 ;;
	--mode) mode=$2; shift 2 ;;
	--tmux)
		use_tmux=1
		if [[ ${2:-} && ${2:0:1} != - ]]; then tmux_session=$2; shift; fi
		shift ;;
	--dry-run) dry_run=1; shift ;;
	*) usage ;;
	esac
done
case $mode in
yolo) kimi_args=(--yolo) ;;
auto) kimi_args=(--auto) ;;
manual) kimi_args=() ;;
*) echo "kimi-tree: --mode must be yolo|auto|manual" >&2; exit 2 ;;
esac
# `kimi -p` refuses a mode flag ("Cannot combine --prompt with --yolo").
[[ -n $prompt ]] && kimi_args=(--prompt "$prompt")
[[ -n $model ]] && kimi_args+=(--model "$model")
((use_tmux)) && tmux_session=$(at_resolve_tmux "$tmux_session")
tree=$at_root/.claude/worktrees/$name
branch=worktree-$name

if ((dry_run)); then
	printf 'tree=%s branch=%s tmux=%s kimi=%s\n' "$tree" "$branch" "${tmux_session:--}" \
		"kimi ${kimi_args[*]:-}"
	exit 0
fi

# Fail before cutting a tree an interactive launch could never use;
# --tmux is exempt (kimi gets the window's pty), as is --prompt.
if ((!use_tmux)) && [[ -z $prompt ]] && [[ ! -t 0 ]]; then
	kimi_tree_no_tty "$tree" ${kimi_args[@]+"${kimi_args[@]}"}
fi

"$at_here/kimi-setup" || { echo "kimi-tree: kimi-setup failed; fix it first" >&2; exit 1; }

at_ensure_tree "$name" "$tree" "$branch" "$purpose"
at_launch "$self" "$name" "$tree" "$use_tmux" "$tmux_session" ${kimi_args[@]+"${kimi_args[@]}"}

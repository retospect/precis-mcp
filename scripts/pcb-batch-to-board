#!/usr/bin/env -S uv run python
"""scripts/pcb-batch-to-board — a pcb batch dict (the ``put(kind='pcb')``
payload) -> an ``examples/boards/<name>/main.py``-style workspace script
that rebuilds it through ``precis_geom.pcb``. Thin CLI over
:mod:`precis.pcb.board_script` (gr514048).

Usage::

    scripts/pcb-batch-to-board SOURCE SLUG OUT_DIR
    scripts/pcb-batch-to-board --epro FILE.epro2 SLUG OUT_DIR
    scripts/pcb-batch-to-board --catalog-footprints FOOTPRINTS.json SOURCE SLUG OUT_DIR

``SOURCE`` is a ``.json`` file holding the batch dict, or
``path/to/module.py:callable`` returning it. ``--epro`` instead imports
the ``.epro2`` into the dev DB (:func:`precis.ingest.pcb_epro.import_epro`,
``PRECIS_DATABASE_URL`` via ``resolve_dsn``), reads the stored board back
with :func:`board_batch`, and emits that — annotations (``pn<id>``
handles) included. After writing, the script re-imports the result and
refuses (exit 1) unless ``build().to_batch()`` equals the source batch —
skipped when the emitter reported dropped keys (``--allow-loss``).

Not a runtime path: nothing imports this.
"""

from __future__ import annotations

import importlib.util
import json
import os
import subprocess
import sys
from pathlib import Path
from typing import Any


def _load_source(spec: str) -> dict[str, Any]:
    if spec.endswith(".json"):
        return json.loads(Path(spec).read_text(encoding="utf-8"))
    path, _, func = spec.partition(":")
    mod_spec = importlib.util.spec_from_file_location("_pcb_source", path)
    assert mod_spec and mod_spec.loader
    mod = importlib.util.module_from_spec(mod_spec)
    mod_spec.loader.exec_module(mod)
    return getattr(mod, func or "build_design")()


def _verify(main_py: Path, expected: dict[str, Any]) -> bool:
    spec = importlib.util.spec_from_file_location("_pcb_main", main_py)
    assert spec and spec.loader
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    got = mod.build().to_batch()
    if got == expected and json.dumps(got, sort_keys=True) == json.dumps(
        expected, sort_keys=True
    ):
        return True
    for key in sorted(set(got) | set(expected)):
        if got.get(key) != expected.get(key):
            print(f"mismatch in {key!r}", file=sys.stderr)
            if isinstance(expected.get(key), list):
                for i, (a, e) in enumerate(zip(got.get(key, []), expected[key])):
                    if a != e:
                        print(f"  [{i}] got {a!r}\n      want {e!r}", file=sys.stderr)
                        break
    return False


def main(argv: list[str]) -> int:
    from precis.pcb.board_script import BoardScriptError, board_batch, emit

    allow_loss = "--allow-loss" in argv
    argv = [a for a in argv if a != "--allow-loss"]
    catalog: Path | None = None
    if "--catalog-footprints" in argv:
        i = argv.index("--catalog-footprints")
        catalog = Path(argv[i + 1])
        argv = argv[:i] + argv[i + 2 :]
    annotations: dict[str, Any] = {}
    if "--epro" in argv:
        i = argv.index("--epro")
        epro_path = Path(argv[i + 1])
        argv = argv[:i] + argv[i + 2 :]
        if len(argv) != 3:
            print(__doc__, file=sys.stderr)
            return 2
        slug, out_dir = argv[1:]
        from precis.cli._common import resolve_dsn
        from precis.ingest.pcb_epro import import_epro
        from precis.store import Store

        store = Store.connect(resolve_dsn(None))
        try:
            result = import_epro(
                store, epro_path.read_bytes(), slug=slug, source_name=epro_path.name
            )
            for w in result.warnings:
                print(f"import warn: {w}", file=sys.stderr)
            batch, annotations = board_batch(store, slug)
        finally:
            store.close()
        source = str(epro_path)
    else:
        if len(argv) != 4:
            print(__doc__, file=sys.stderr)
            return 2
        source, slug, out_dir = argv[1:]
        batch = _load_source(source)
    dest = Path(out_dir)
    dest.mkdir(parents=True, exist_ok=True)
    main_py = dest / "main.py"
    try:
        text = emit(
            batch,
            slug,
            source,
            annotations=annotations,
            allow_loss=allow_loss,
            catalog_cache=catalog,
            catalog_relative_path=(
                os.path.relpath(catalog.resolve(), dest.resolve())
                if catalog
                else None
            ),
        )
    except BoardScriptError as exc:
        print(f"{main_py}: {exc}", file=sys.stderr)
        return 1
    main_py.write_text(text, encoding="utf-8")
    subprocess.run(["uv", "run", "ruff", "format", "-q", str(main_py)], check=True)
    if "dropped keys" not in text and not _verify(main_py, batch):
        print(f"{main_py}: to_batch() differs from {source}", file=sys.stderr)
        return 1
    print(f"wrote {main_py} ({len(batch['components'])} parts, byte-equal)")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))

#!/usr/bin/env bash
# scripts/gen-devin-hooks — regenerate .devin/hooks.v1.json from
# .claude/settings.json (Devin's hook allow-list is narrower than Claude's;
# see scripts/lib/devin_hooks.py).
#
#   scripts/gen-devin-hooks render   # write .devin/hooks.v1.json
#   scripts/gen-devin-hooks render --check   # diff only, nothing written —
#                                          # the --quick ship lint's form
#   scripts/gen-devin-hooks check    # same verdict (kept spelling)
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
exec uv run --frozen python "$here/lib/devin_hooks.py" "$@"

#!/usr/bin/env python3
"""scripts/last-gated-main-sha — newest main sha that actually got a 6-shard verdict.

check.yml's `plan` job scopes a main push to its own delta
(`github.event.before..HEAD`), which is right in isolation: each push gets
gated on its own change. It stops being right once the *previous* push's run
never finished. The concurrency group cancels superseded main runs, so a
`/qland` burst pushes main five times in minutes and cancels four of the five
runs; `conclusion: cancelled` is not a failure, so nothing surfaces. If the
surviving push happens to be docs-only it takes the docs lane and main goes
green while carrying src no shard ever ran (observed 2026-09-26 on a 35-line
`_pcb_ops.py` change, and four consecutive times over 2026-09-29/30).

This walks main's first-parent history back from a starting sha and prints the
newest one whose `test-linux` check-runs are *all* successful — the last sha
with a real shard verdict. `plan` uses it as the range start, so a docs-only
push sitting on ungated src inherits the full lane instead of the docs one.
The range can only ever widen, so the only failure direction is over-gating.

Deliberately sha-keyed (`/commits/<sha>/check-runs`), not `gh run list`: the
run-list page and the `/actions/runs` endpoint both serve a cache that has
been weeks stale, which is the whole substance of gr456236. The sha-keyed
endpoint has not shown that behaviour.

  scripts/last-gated-main-sha [--start <ref>] [--limit N]

Advisory: always exits 0, prints nothing when it cannot tell (no `gh`, no
auth, nothing gated inside the window). An empty answer means "gate fully".
"""

from __future__ import annotations

import json
import os
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

# How far back to look. A burst is a handful of commits; past ~25 the cost of
# the walk exceeds the cost of just running the full gate once.
DEFAULT_LIMIT = 25


def _run(*args: str) -> str | None:
    try:
        cp = subprocess.run(
            args,
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=30,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    return cp.stdout if cp.returncode == 0 else None


def first_parent_shas(start: str, limit: int) -> list[str]:
    out = _run("git", "rev-list", "--first-parent", f"-n{limit}", start)
    return out.split() if out else []


def has_shard_verdict(sha: str) -> bool:
    """True when every `test-linux` check-run at `sha` concluded success.

    All, not any: a partially-cancelled matrix leaves one green shard next to
    five cancelled ones, and that is exactly the state this exists to refuse
    to count. `filter=latest` (the endpoint default) collapses re-runs, so a
    re-run to green supersedes the cancelled attempt.
    """
    out = _run(
        "gh",
        "api",
        f"repos/{{owner}}/{{repo}}/commits/{sha}/check-runs",
        "--jq",
        '[.check_runs[] | select(.name | startswith("test-linux")) | .conclusion]',
    )
    if not out:
        return False
    try:
        conclusions = json.loads(out)
    except ValueError:
        return False
    return bool(conclusions) and all(c == "success" for c in conclusions)


def main(argv: list[str]) -> int:
    start = "HEAD"
    limit = DEFAULT_LIMIT
    for i, arg in enumerate(argv):
        if arg == "--start" and i + 1 < len(argv):
            start = argv[i + 1]
        elif arg == "--limit" and i + 1 < len(argv):
            limit = int(argv[i + 1])
    for sha in first_parent_shas(start, limit):
        if has_shard_verdict(sha):
            print(sha)
            return 0
    return 0


if __name__ == "__main__":
    os.chdir(ROOT)
    sys.exit(main(sys.argv[1:]))

#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/last-gated-main-sha — newest main sha that actually got a 6-shard verdict.

Thin shim: the implementation and the usage doc live in
``scripts/lib/last_gated_main_sha.py`` next to this file, exec'd in place
(same convention as ``scripts/fleet-authority``). The split exists so tests
import a ``.py`` module — testmon fingerprints every file a test touches
and IndexErrors on a dotless name, which INTERNALERROR'd a green
``ship --checked`` run (gr550044).
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

_HERE = Path(__file__).resolve().parent

# ``lib/`` beside this file in place; ``../scripts/lib/`` covers a standalone
# copy materialised one level under a checkout (land_slice's drift preflight
# writes main's copy to ``tree/scratch/``).
for _candidate in (_HERE / "lib", _HERE.parent / "scripts" / "lib"):
    _MODULE = _candidate / "last_gated_main_sha.py"
    if _MODULE.is_file():
        break
else:
    sys.exit(f"last-gated-main-sha: last_gated_main_sha.py not found near {_HERE}")

if __name__ == "__main__":
    os.execv(sys.executable, [sys.executable, str(_MODULE), *sys.argv[1:]])

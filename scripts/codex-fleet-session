#!/usr/bin/env python3
"""Load an explicitly selected MCP credential into the child environment only.

tmux and the shared Codex daemon can predate credential environment changes.
The pane-local bootstrap reads the file immediately before replacing itself;
an embedded Codex server inherits it without putting token values in arguments,
configuration, tmux server environment, state files or launcher output.
"""

from __future__ import annotations

import argparse
import os
import sys
from pathlib import Path


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--token-file", type=Path)
    parser.add_argument("command", nargs=argparse.REMAINDER)
    args = parser.parse_args()
    command = args.command[1:] if args.command[:1] == ["--"] else args.command
    if not command or command[0] != "--no-daemon":
        parser.error("Codex arguments must start with --no-daemon")
    environment = os.environ.copy()
    if args.token_file:
        try:
            token = args.token_file.read_text(encoding="utf-8").strip()
        except (OSError, UnicodeError):
            print("codex-fleet-session: cannot read token file", file=sys.stderr)
            return 2
        if not token or any(
            character.isspace() or character == "\0" for character in token
        ):
            print("codex-fleet-session: invalid token file", file=sys.stderr)
            return 2
        environment["PRECIS_MCP_TOKEN"] = token
    try:
        os.execvpe("codex", ["codex", *command], environment)
    except OSError:
        print("codex-fleet-session: cannot execute codex", file=sys.stderr)
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

#!/usr/bin/env bash
# scripts/reap-worktrees — SessionStart backstop that removes worktrees
# already safe to remove, so a shipped worktree never lingers forever.
#
# The leak this closes: scripts/ship (steps 5-6) resets the branch to shipped
# main and ff's the primary, but can't remove the worktree it's running
# FROM — that has to happen from outside it, on a later session. This walks
# `scripts/inflight --json` (the single source of truth for liveness/merge
# bucketing — never reimplemented here) and removes every worktree whose
# `bucket` is exactly `safe_remove` (merged + clean + no live session/task).
# Every other bucket (`self`, `live_session`, `live_subagent`,
# `needs_judgment`, `has_unmerged_work`, `base`) is left untouched.
# `safe_remove` also covers a `dead-lock#<pid>`
# session (crashed without a clean SessionEnd, so its SessionStart lock —
# scripts/hooks/session-start-lock.sh — was never released): `git worktree
# remove` unconditionally refuses a locked worktree, so this unlocks first.
#
# Two belt-and-braces guards around that bucketing, both mechanical fallout
# of gr260192 / docs/backlog/reaper-removed-live-session-worktree.md
# (proposals 1+2 — proposal 3, ship re-asserting its own lock, already
# shipped) and docs/backlog/reaper-liveness-race.md: a lockless+clean+merged
# tree is `safe_remove` even when its session is mid-turn (a dropped lock, a
# ship that just landed), so the bucket alone is not proof nothing is using
# the tree.
#
#   1. Grace-period re-verify: right before removing a `safe_remove` tree,
#      re-run the FULL bucket check a second time after a shared sleep
#      (PRECIS_REAP_GRACE_SECONDS, default 60s — one sleep total, not one per
#      tree). A tree whose re-check comes back anything other than
#      `safe_remove` (a lock/task appeared, the tree went dirty, it's gone
#      already) is skipped with a log line instead of removed.
#   2. Fresh-purpose tripwire: a `.claude/purpose` file newer than
#      PRECIS_REAP_PURPOSE_FRESH_SECONDS (default 6h) demotes `safe_remove` to
#      not-removed — sessions write purpose at task start and a clean
#      SessionEnd deletes it with the tree, so a fresh purpose surviving in an
#      otherwise-removable tree means a live or very recent session. Checked
#      both up front and again after the grace sleep (a session can start its
#      task, and write purpose, DURING the sleep).
#
# Neither guard changes what `scripts/inflight` computes — they only decide
# whether THIS reaper acts on a `safe_remove` verdict right now.
#
# Second job, same "regular cleaning" lane: ORPHANED REMOTE GATE REFS.
# `scripts/ship --remote` pushes the tree to a throwaway `ci/<branch>` for
# check.yml to gate, and deletes it again on a completed ship (scripts/ship,
# step 4) — but only on that path. A red gate the session then /qland's, a
# ship killed mid-run, an abandoned --remote attempt: each leaks the ref, and
# nothing else on this machine ever looks at it. They accumulated to 12 stale
# ci/* refs before anyone noticed. `sweep_ci_refs` below deletes a ci/<X>
# once BOTH hold: no local branch <X> exists (so no tree is still working on
# it), and the ref is older than PRECIS_CI_REF_MAX_AGE_SECONDS (default 24h).
# The age floor is what makes this safe against a gate that is still running:
# a check.yml run takes ~12 min, and a tree whose work a sibling qlanded can
# be reaped while its own gate is still in flight — deleting that ref would
# kill the run. 24h is far clear of both.
#
# Escape hatches: PRECIS_NO_AUTOREAP=1 → no-op. PRECIS_NO_CI_REF_REAP=1 →
# worktrees still reaped, remote refs left alone (also the switch for a
# machine that should never touch the remote).
# Usage: scripts/reap-worktrees [--dry-run] [--for-hook] [--report] [--full]
#
# --report is the READ-ONLY census /workspace-cleanup runs first: it prints
# the buckets below with counts plus name lists (first 8, then "+N more";
# --report --full prints every name) and exits. It never removes, unlocks,
# prunes or deletes anything, never waits out the grace period, and ignores
# PRECIS_NO_AUTOREAP (that hatch gates reaping, not reading).
#
#   Worktrees (primary excluded):
#     missing dir (prunable)   the git admin entry outlives its checkout
#     locked (holder live)     session field live#<pid>/live-task#<id>, or a
#                              lock with no parseable `pid <N>` — never
#                              assumed dead (incident 2026-08-15, defect 2)
#     locked (holder dead)     dead-lock#<pid>
#     dirty                    tracked changes, or untracked files only —
#                              either way content dies with the tree
#     dirty (<runbook> only)   every TRACKED change is the shared runbook
#                              docs/runbooks/memory-sibling-repos.md, which
#                              every session edits locally; untracked files
#                              do not disqualify
#     clean+merged             head is an ancestor of origin/main, PLUS a
#                              `landed` sub-count (below)
#     clean+unmerged           real commits not yet on origin/main
#   Branches with no worktree:
#     merged                   tip is an ancestor of origin/main
#     landed                   the squash-landed case (below)
#     unique                   real unlanded commits
#
# `landed` is what a plain ancestor or `git cherry` check cannot see: a
# squash-merged branch is no ancestor, and cherry's per-commit patch-ids
# never match one multi-commit squash. It is tested in two tiers. First,
# `git merge-tree --write-tree origin/main <rev>` yielding exactly
# origin/main's tree (the same content-equality test inflight's
# squash_absorbed uses). That fails — with a conflict, not a different
# tree — the moment main touches one of the squashed files again, so a
# second tier runs `git diff --raw <merge-base> <rev>` and counts the head
# landed when every changed path proves landed: its dst blob exists in
# origin/main's history at that path, or — the squash-time-fixup case, a
# landing that adapted a file — the base touched the same path in the
# window (at least one exact blob match required). Deletions require the
# path absent from the base tree; an empty diff is merged. Blob-matched
# heads print as their own
# sub-count, "landed (content on main, since overtaken)". For clean
# worktrees both landed tiers count inside clean+merged; for branchless
# branches each is its own bucket.
#
# Cost shape (the >10 min scratch classifier this replaces): ONE
# `scripts/inflight --json` for every tree's dirty/lock/liveness AND every
# head's landed verdict (never a git status per tree — only the handful of
# tracked-dirty trees get one, for the runbook-only check), ONE `git branch
# --merged origin/main` for the whole ancestor set, and merge-tree only
# when the local base tree differs from origin/main's (or a verdict is
# missing) — a rare path, run in a parallel pool of 12. The report's wall
# time is then essentially inflight's own scan.
#
# Wired in .claude/settings.json (SessionStart), after `inflight --for-hook`.
set -uo pipefail

DRY_RUN=0
FOR_HOOK=0
REPORT=0
FULL=0
for a in "$@"; do
    case "$a" in
        --dry-run) DRY_RUN=1 ;;
        # gr499042: SessionStart output is carried every turn — a reaper that
        # found nothing prints nothing under --for-hook.
        --for-hook) FOR_HOOK=1 ;;
        # Read-only census (see header): no removal, no grace sleep, and the
        # autoreap escape hatch does not gate it.
        --report) REPORT=1 ;;
        --full) FULL=1 ;;
    esac
done

[ -n "${PRECIS_NO_AUTOREAP:-}" ] && [ "$REPORT" = 0 ] && exit 0

GRACE_SECONDS="${PRECIS_REAP_GRACE_SECONDS:-60}"
PURPOSE_FRESH_SECONDS="${PRECIS_REAP_PURPOSE_FRESH_SECONDS:-21600}"  # 6h
CI_REF_MAX_AGE_SECONDS="${PRECIS_CI_REF_MAX_AGE_SECONDS:-86400}"  # 24h

cd "$(dirname "$0")/.." || exit 0
command -v git >/dev/null 2>&1 || exit 0
git rev-parse --git-dir >/dev/null 2>&1 || exit 0
[ -x scripts/inflight ] || exit 0

# This runs as a SessionStart hook and can be killed mid-scan; every git
# below (incl. the embedded-Python report pass and `worktree remove`'s
# internal clean check) must not leave a stale index.lock (gr541144).
# Mandatory locks — fetch, branch -D, worktree lock/remove — are unaffected.
export GIT_OPTIONAL_LOCKS=0

# Per-worktree compose-project teardown (gr176375): each worktree runs its gate
# against its OWN precis-test-db project; reaping the tree must also tear that
# project down or the container/volume leaks. Guarded — an older checkout
# without this helper simply skips the teardown below.
[ -f scripts/lib/compose-project.sh ] && source scripts/lib/compose-project.sh
# other_session_in (gr474985): guarded like the line above; absent → the
# process-table check below is skipped and the lock-based buckets decide.
[ -f scripts/lib/session-lock.sh ] && source scripts/lib/session-lock.sh

# `timeout` is not on a stock macOS; use it when present (coreutils, or
# gtimeout via brew). The +expansion form keeps an empty array a no-op under
# `set -u` on bash 3.2. Bounds the per-tree wt-mcp teardown below.
TIMEOUT_RUNNER=()
if command -v timeout >/dev/null 2>&1; then
    TIMEOUT_RUNNER=(timeout 240)
elif command -v gtimeout >/dev/null 2>&1; then
    TIMEOUT_RUNNER=(gtimeout 240)
fi

# Defense in depth: never remove the PRIMARY working tree, whatever bucket it
# lands in (inflight already buckets it `base`, but a destructive op earns its
# own guard — git refuses anyway, we just don't rely on that).
PRIMARY=$(git worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')

# report — the read-only census the header documents. One inflight --json
# supplies every tree's session/dirty state AND the branchless-branch list
# (worktree: null); `git branch --merged origin/<base>` supplies the whole
# ancestor set in one call; merge-tree runs only for heads still
# unresolved, in a parallel pool. Prints and exits — nothing is removed,
# unlocked, pruned or deleted and the grace period is never slept through.
report() {
    local json
    json=$(scripts/inflight --json 2>/dev/null) || return 0
    [ -z "$json" ] && return 0
    printf '%s' "$json" | PRIMARY="$PRIMARY" REPORT_FULL="$FULL" python3 -c '
import json
import os
import subprocess
import sys
from concurrent.futures import ThreadPoolExecutor

PRIMARY = os.environ.get("PRIMARY", "")
CAP = None if os.environ.get("REPORT_FULL") == "1" else 8
RUNBOOK = "docs/runbooks/memory-sibling-repos.md"
POOL = 12


def g(*args, cwd=None):
    return subprocess.run(
        ["git", *args], cwd=cwd,
        capture_output=True, text=True, encoding="utf-8")


def gout(*args, cwd=None):
    return g(*args, cwd=cwd).stdout.strip()


data = json.load(sys.stdin)
base = data.get("base", "main")
ref = "origin/" + base
base_tree = gout("rev-parse", ref + "^{tree}")
if not base_tree:
    print("reap-worktrees --report: no " + ref + " ref, landed checks "
          "skipped", file=sys.stderr)

# The inflight verdict already encodes the merge-tree landed test against the
# LOCAL base (merged / in-main / up-arrows). When local base and <ref> have
# the same tree — the normal state after a fetch — that verdict IS the
# answer against <ref> too, and no merge-tree call is needed. Only when the
# trees differ (or a verdict is absent/unknown) does the merge-tree pool
# below run, once per still-unresolved head.
same_tree = bool(base_tree) and gout("rev-parse", base + "^{tree}") == base_tree

merged = set()
for ln in gout("branch", "--merged", ref,
               "--format=%(refname:short)").splitlines():
    ln = ln.strip().lstrip("*+").strip()
    if ln:
        merged.add(ln)

missing, lk_live, lk_dead = [], [], []
dirty, dirty_rb = [], []
clean_anc, clean_landed, clean_blob, clean_unmerged = [], [], [], []
br_merged, br_landed, br_blob, br_unique = [], [], [], []
mt_rev, mt_kind, mt_name = [], [], []
dirty_pending = []
blob_rev, blob_kind, blob_name = [], [], []


def enqueue(rev, kind, name):
    mt_rev.append(rev)
    mt_kind.append(kind)
    mt_name.append(name)


def enqueue_blob(rev, kind, name):
    blob_rev.append(rev)
    blob_kind.append(kind)
    blob_name.append(name)


def landed_bucket(kind):
    return clean_landed if kind == "w" else br_landed


def classify(rev, kind, name, verdict):
    # Route a non-ancestor head toward merged vs unique. With same-tree
    # bases the inflight verdict is authoritative and free: merged/in-main
    # means merge-tree-equal (landed); up-arrows means merge-tree differs
    # and the head goes straight to the blob-history test (a squash land
    # that main later touched conflicts in merge-tree but still counts —
    # see blob_set below). Else merge-tree decides first.
    if same_tree:
        if verdict == "merged" or verdict.startswith("in-main"):
            landed_bucket(kind).append(name)
            return
        if verdict.startswith("↑"):
            enqueue_blob(rev, kind, name)
            return
    enqueue(rev, kind, name)


for w in data.get("worktrees", []):
    if not w.get("worktree"):
        # Branchless branch: inflight already filtered out base, ci/* and
        # anything checked out anywhere (worktree: null is the tell).
        b = w.get("branch") or w.get("name") or ""
        if not b:
            continue
        if b in merged:
            br_merged.append(b)
        else:
            classify(b, "b", b, w.get("verdict") or "")
        continue
    path = w.get("path") or ""
    name = w.get("name") or os.path.basename(path)
    if w.get("bucket") == "base" or path == PRIMARY:
        continue
    if not os.path.isdir(path):
        missing.append(name)
        continue
    sess = w.get("session") or "—"
    if sess.startswith("dead-lock"):
        lk_dead.append(name)
        continue
    if sess == "locked" or sess.startswith("live"):
        lk_live.append(name)
        continue
    dirtyf = w.get("dirty") or ""
    if dirtyf != "clean":
        # Tracked count is the leading number before any "+<N>u"; empty
        # means untracked-only, which is plain dirty (cannot be runbook) —
        # skip the status call entirely there. Tracked-dirty trees queue
        # for the parallel status pass after the loop.
        tracked = dirtyf.split("+", 1)[0]
        if not tracked:
            dirty.append(name)
        else:
            dirty_pending.append((name, path))
        continue
    branch = w.get("branch") or ""
    verdict = w.get("verdict") or ""
    if branch and branch != "(detached)":
        if branch in merged:
            clean_anc.append(name)
        else:
            classify(branch, "w", name, verdict)
        continue
    # Detached head: no branch name to look up in the merged set.
    if g("merge-base", "--is-ancestor", "HEAD", ref,
         cwd=path).returncode == 0:
        clean_anc.append(name)
        continue
    head = gout("rev-parse", "HEAD", cwd=path)
    if head:
        classify(head, "w", name, verdict)
    else:
        clean_unmerged.append(name)


def dirty_files(item):
    # Raw stdout, not gout: a porcelain line leads with its status column
    # (" M path"), so stripping the whole output would eat the leading
    # status chars of the first entry and corrupt its path.
    name, path = item
    st = g("status", "--porcelain", "--untracked-files=no",
           cwd=path).stdout
    return name, [l[3:] for l in st.splitlines() if l.strip()]


def absorbed(rev):
    # Landed = merging <rev> into <ref> produces exactly the tree <ref> has,
    # i.e. <rev> contributes no content the base lacks (squash_absorbed in
    # inflight, same test). Exit 1 is a conflicted merge — the printed tree
    # still cannot equal the base tree, so one read covers both exits.
    if not base_tree:
        return False
    r = subprocess.run(
        ["git", "merge-tree", "--write-tree", ref, rev],
        capture_output=True, text=True, encoding="utf-8")
    if r.returncode not in (0, 1):
        return False
    return r.stdout.split("\n", 1)[0].strip() == base_tree


if dirty_pending:
    with ThreadPoolExecutor(max_workers=POOL) as pool:
        for name, paths in pool.map(dirty_files, dirty_pending):
            if paths and all(p == RUNBOOK for p in paths):
                dirty_rb.append(name)
            else:
                dirty.append(name)

flags = []
if mt_rev:
    with ThreadPoolExecutor(max_workers=POOL) as pool:
        flags = list(pool.map(absorbed, mt_rev))
for rev, kind, name, ok in zip(mt_rev, mt_kind, mt_name, flags):
    if ok:
        landed_bucket(kind).append(name)
    else:
        # Not merge-tree-equal — the branch may still be a squash land that
        # main has since touched (merge-tree conflicts then). Blob history
        # decides.
        enqueue_blob(rev, kind, name)

# --- blob-history landed test -------------------------------------------
# A squash-landed branch stops being merge-tree-equal the moment main
# touches one of its files again (land-wu1-paging: squash 26eab85d4, main
# changed src/precis/tools/core.py after -> merge-tree conflicts). What
# still holds: every blob the branch leaves at a path exists in the
# base history at that path (written by the squash commit). So: every
# (path, dst-blob) in `git diff --raw <merge-base> <head>` must appear in
# the base history; a deletion (all-zero dst) must leave the path absent
# from the base tree; an empty diff is merged.
ZERO = "0" * 40
blob_items = []          # (rev, kind, name, merge-base)
if blob_rev:
    with ThreadPoolExecutor(max_workers=POOL) as pool:
        mbs = list(pool.map(lambda r: gout("merge-base", ref, r), blob_rev))
    for rev, kind, name, mb in zip(blob_rev, blob_kind, blob_name, mbs):
        if mb:
            blob_items.append((rev, kind, name, mb))
        else:
            (clean_unmerged if kind == "w" else br_unique).append(name)

blob_set = set()
history_paths = set()
base_paths = set()
if blob_items:
    dates = gout("show", "-s", "--format=%ct",
                 *[mb for *_, mb in blob_items]).split()
    since = min((int(d) for d in dates if d.isdigit()), default=0)
    # A squash commit could carry a date older than the merge-base (clock
    # skew, a rebased landing) — a day of margin keeps the bound cheap
    # without losing it.
    if since:
        since -= 86400
        for ln in g("log", ref, "--since=@" + str(since), "--format=",
                    "--raw", "--no-abbrev", "--no-renames").stdout.splitlines():
            if not ln.startswith(":"):
                continue
            meta, _, p = ln.partition("\t")
            f = meta.split()
            if len(f) >= 5:
                history_paths.add(p)
                if f[3] != ZERO:
                    blob_set.add((p, f[3]))
    base_paths = set(
        gout("ls-tree", "-r", ref, "--name-only").splitlines())


def blob_landed(item):
    rev, kind, name, mb = item
    st = g("diff", "--raw", "--no-abbrev", "--no-renames", mb,
           rev).stdout
    lines = [l for l in st.splitlines() if l.startswith(":")]
    if not lines:
        return "merged"
    # A path proves landed two ways: its dst blob is in the base history at
    # that path (the squash wrote the content verbatim), or — the
    # squash-time-fixup case, e.g. land-wu1-paging where the landing adapted
    # dispatch.py / precis-youtube-help.md — the same path was at least
    # touched by the base in the window. Proofs need at least one exact
    # match, else a branch that merely touched a hot file would pass.
    exact = 0
    for l in lines:
        meta, _, p = l.partition("\t")
        f = meta.split()
        if len(f) < 5:
            return "unique"
        dst = f[3]
        if dst == ZERO:
            if p in base_paths:
                return "unique"
            exact += 1
        elif (p, dst) in blob_set:
            exact += 1
        elif p not in history_paths:
            return "unique"
    return "landed" if exact else "unique"


if blob_items:
    with ThreadPoolExecutor(max_workers=POOL) as pool:
        verdicts = list(pool.map(blob_landed, blob_items))
    for (rev, kind, name, mb), v in zip(blob_items, verdicts):
        if v == "merged":
            (clean_anc if kind == "w" else br_merged).append(name)
        elif v == "landed":
            (clean_blob if kind == "w" else br_blob).append(name)
        else:
            (clean_unmerged if kind == "w" else br_unique).append(name)


def shown(names):
    names = sorted(names)
    if CAP is None or len(names) <= CAP:
        return ", ".join(names)
    return ", ".join(names[:CAP]) + " +" + str(len(names) - CAP) + " more"


def line(label, names, indent="    "):
    print(indent + str(len(names)) + "  " + label
          + (": " + shown(names) if names else ""))


merged_wt = len(clean_anc) + len(clean_landed) + len(clean_blob)
total_wt = (len(missing) + len(lk_live) + len(lk_dead) + len(dirty)
            + len(dirty_rb) + merged_wt + len(clean_unmerged))
print("worktrees (excl. primary): " + str(total_wt))
line("missing dir (prunable)", missing)
line("locked (holder live)", lk_live)
line("locked (holder dead)", lk_dead)
line("dirty", dirty)
line("dirty (" + RUNBOOK + " only)", dirty_rb)
print("    " + str(merged_wt) + "  clean+merged"
      + (": " + shown(clean_anc + clean_landed + clean_blob)
         if merged_wt else ""))
line("of which landed (tree == " + ref + ")", clean_landed, "       ")
line("of which landed (content on main, since overtaken)",
     clean_blob, "       ")
line("clean+unmerged", clean_unmerged)
print("branches with no worktree: "
      + str(len(br_merged) + len(br_landed) + len(br_blob)
              + len(br_unique)))
line("merged (ancestor of " + ref + ")", br_merged)
line("landed (merge-tree == " + ref + ")", br_landed)
line("landed (content on main, since overtaken)", br_blob)
line("unique", br_unique)
'
}

if [ "$REPORT" = 1 ]; then
    report
    exit 0
fi

# fresh_purpose <path> — true (exit 0) if <path>/.claude/purpose exists and
# its mtime is younger than PURPOSE_FRESH_SECONDS. Proposal 2: a fresh
# purpose file is a tripwire for "a session recently started work here",
# independent of whatever the lock says.
fresh_purpose() {
    python3 - "$1/.claude/purpose" "$PURPOSE_FRESH_SECONDS" <<'PY'
import os
import sys
import time

pf, threshold = sys.argv[1], float(sys.argv[2])
try:
    age = time.time() - os.path.getmtime(pf)
except OSError:
    sys.exit(1)
sys.exit(0 if age < threshold else 1)
PY
}

# bucket_for <json-blob> <path> — prints the `bucket` field of the
# `scripts/inflight --json` entry matching <path> (realpath-compared), empty
# if the tree isn't in the blob at all (already gone). Used for proposal 1's
# second look, immediately before removal.
bucket_for() {
    printf '%s' "$1" | TARGET="$2" python3 -c '
import json, os, sys

try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
target = os.path.realpath(os.environ["TARGET"])
for wt in data.get("worktrees", []):
    if os.path.realpath(wt.get("path", "")) == target:
        print(wt.get("bucket", ""))
        break
'
}

# sweep_ci_refs — delete remote gate refs nothing is using any more (see the
# header). Deliberately independent of the worktree bucketing above: by the
# time a ci/<X> is orphaned, the tree that pushed it is usually long gone, so
# there is no bucket left to hang the decision on. Two conditions, both
# required, both cheap to state: no local branch <X>, and the ref older than
# CI_REF_MAX_AGE_SECONDS.
#
# Network-guarded throughout. A SessionStart hook must never hang or fail on
# a machine that is offline, unauthenticated, or behind a dead remote: the
# fetch runs under a timeout when one is available and every failure path is
# a silent return, leaving the refs for the next session.
sweep_ci_refs() {
    [ -n "${PRECIS_NO_CI_REF_REAP:-}" ] && return 0
    git remote get-url origin >/dev/null 2>&1 || return 0

    # `timeout` is not on a stock macOS; use it when present (coreutils, or
    # gtimeout via brew) and accept the git default otherwise.
    local runner=()
    if command -v timeout >/dev/null 2>&1; then
        runner=(timeout 30)
    elif command -v gtimeout >/dev/null 2>&1; then
        runner=(gtimeout 30)
    fi
    # `${runner[@]}` alone is an unbound-variable error under `set -u` on
    # bash 3.2 (stock macOS) when the array is empty — the +expansion form is
    # what makes "no timeout available" a no-op instead of a hook crash.
    "${runner[@]+"${runner[@]}"}" git fetch -q --prune origin \
        "+refs/heads/ci/*:refs/remotes/origin/ci/*" 2>/dev/null || return 0

    local now deleted=() ref ts branch age
    now=$(date -u +%s)
    while IFS=$'\t' read -r ref ts; do
        [ -z "$ref" ] && continue
        [ -z "$ts" ] && continue
        branch="${ref#origin/ci/}"
        # A live local branch means a tree is still on this work and its gate
        # may be queued or running — never touch that ref.
        git show-ref --verify --quiet "refs/heads/${branch}" && continue
        age=$(( now - ts ))
        [ "$age" -lt "$CI_REF_MAX_AGE_SECONDS" ] && continue
        if [ "$DRY_RUN" = 1 ]; then
            deleted+=("ci/${branch}")
        elif git push -q origin --delete "ci/${branch}" 2>/dev/null; then
            deleted+=("ci/${branch}")
        fi
    done < <(git for-each-ref \
        --format='%(refname:short)'$'\t''%(committerdate:unix)' \
        refs/remotes/origin/ci)

    [ "${#deleted[@]}" -eq 0 ] && return 0
    if [ "$DRY_RUN" = 1 ]; then
        echo "reap-worktrees --dry-run: would delete ${#deleted[@]} orphaned gate ref(s): ${deleted[*]}"
    else
        echo "reap-worktrees: deleted ${#deleted[@]} orphaned gate ref(s): ${deleted[*]}"
    fi
}

# reap_branchless_branches — a local branch scripts/inflight's own
# %(worktreepath) reports as checked out NOWHERE (docs/backlog/
# inflight-sessionless-branches.md): no worktree means no lock, no
# .claude/purpose, no live session possible, so none of the grace-period /
# fresh-purpose guards above have anything to protect against — a
# `safe_remove` verdict there is immediately safe to `git branch -D`. Any
# other bucket (currently only `stranded`: real unmerged commits with no
# worktree left to reclaim them from) is reported and never touched.
reap_branchless_branches() {
    local name branch bucket verdict base
    while IFS=$'\t' read -r name branch bucket verdict base; do
        [ -z "$branch" ] && continue
        case "$bucket" in
            safe_remove)
                if [ "$DRY_RUN" = 1 ]; then
                    echo "reap-worktrees --dry-run: would delete branchless branch ${branch} (0 unmerged commits vs ${base}, no worktree)"
                elif git branch -D "$branch" >/dev/null 2>&1; then
                    echo "reap-worktrees: deleted branchless branch ${branch} (0 unmerged commits vs ${base}, no worktree)"
                fi
                ;;
            stranded)
                echo "reap-worktrees: stranded: ${branch} (${verdict} vs ${base}) — no worktree, not removing"
                ;;
        esac
    done < <(printf '%s' "$JSON" | python3 -c '
import json, sys
data = json.load(sys.stdin)
base = data.get("base", "main")
for wt in data.get("worktrees", []):
    if wt.get("worktree") is None and wt.get("branch"):
        print("\t".join([wt.get("name", ""), wt.get("branch", ""), wt.get("bucket", ""), wt.get("verdict", ""), base]))
')
}

JSON=$(scripts/inflight --json 2>/dev/null) || exit 0
[ -z "$JSON" ] && exit 0

# First pass: every worktree the bucketing currently calls safe_remove.
CANDIDATES=()
while IFS=$'\t' read -r name path branch; do
    [ -z "$path" ] && continue
    [ "$path" = "$PRIMARY" ] && continue
    CANDIDATES+=("${name}"$'\t'"${path}"$'\t'"${branch}")
done < <(printf '%s' "$JSON" | python3 -c '
import json, sys
data = json.load(sys.stdin)
for wt in data.get("worktrees", []):
    # wt.get("worktree") filters out a branchless branch (worktree: null,
    # emit_branch) explicitly, in Python where the field is unambiguous --
    # tab is IFS whitespace, and bash read collapses a run of adjacent
    # IFS-whitespace delimiters into one no matter how IFS is set, so an
    # empty path field here would not reliably land in path on the bash side.
    if wt.get("bucket") == "safe_remove" and wt.get("worktree"):
        print("\t".join([wt.get("name", ""), wt.get("path", ""), wt.get("branch", "")]))
')

# Proposal 2, up front: drop anything with a fresh .claude/purpose before
# even considering the grace period — no point sleeping on a tree we already
# know not to touch.
FILTERED=()
for rec in "${CANDIDATES[@]:-}"; do
    [ -z "$rec" ] && continue
    IFS=$'\t' read -r name path branch <<<"$rec"
    if fresh_purpose "$path"; then
        echo "reap-worktrees: $name has a fresh .claude/purpose (< ${PURPOSE_FRESH_SECONDS}s old) — skipping, likely a live or very recent session (gr260192 proposal 2)"
        continue
    fi
    FILTERED+=("$rec")
done

REAPED=()
if [ "$DRY_RUN" = 1 ]; then
    # Dry-run never removes anything, so there's nothing for the grace-period
    # re-check to protect against — report the purpose-filtered set as-is.
    for rec in "${FILTERED[@]:-}"; do
        [ -z "$rec" ] && continue
        IFS=$'\t' read -r name _path _branch <<<"$rec"
        REAPED+=("$name")
    done
else
    # Proposal 1: one shared sleep for however many candidates survived the
    # purpose filter, then re-verify EACH individually right before removal —
    # never a sleep per tree, but also never skip the re-check.
    JSON2=""
    if [ "${#FILTERED[@]}" -gt 0 ]; then
        sleep "$GRACE_SECONDS"
        JSON2=$(scripts/inflight --json 2>/dev/null) || JSON2=""
    fi
    for rec in "${FILTERED[@]:-}"; do
        [ -z "$rec" ] && continue
        IFS=$'\t' read -r name path branch <<<"$rec"

        recheck=$(bucket_for "$JSON2" "$path")
        if [ "$recheck" != "safe_remove" ]; then
            echo "reap-worktrees: $name no longer safe_remove after ${GRACE_SECONDS}s grace period (now '${recheck:-gone}') — skipping (gr260192 proposal 1)"
            continue
        fi
        # A purpose file can appear DURING the sleep (a session starting its
        # task right in the window) — re-check, don't just trust the first pass.
        if fresh_purpose "$path"; then
            echo "reap-worktrees: $name grew a fresh .claude/purpose during the grace period — skipping (gr260192 proposal 2)"
            continue
        fi
        # gr474985: a dead lock only proves the session that TOOK it is gone.
        # A second session that started in the tree while it was held never
        # got the lock, so ask the process table; relock to it if found.
        if command -v other_session_in >/dev/null 2>&1 \
            && holder=$(other_session_in "$path" ""); then
            echo "reap-worktrees: $name has a live session in it (${holder:-cwd unreadable}) despite its lock — skipping (gr474985)"
            if [ -n "$holder" ]; then
                git worktree unlock "$path" >/dev/null 2>&1 || true
                git worktree lock "$path" --reason "pid $holder" >/dev/null 2>&1 || true
            fi
            continue
        fi

        # gr514254: gitignored scratch/ and .claude/ content (dogfood
        # fixtures, handoffs, ship logs) dies with the tree — unrecoverable
        # artifacts have been lost this way. Archive both to
        # PRECIS_REAPED_SCRATCH_DIR (default ~/.claude/reaped-scratch/<tree>)
        # before removal; if an archive can't complete, keep the tree — the
        # artifact is the whole point.
        keep_tree=0
        for keep_dir in scratch .claude; do
            [ -d "$path/$keep_dir" ] || continue
            keep_dest="${PRECIS_REAPED_SCRATCH_DIR:-$HOME/.claude/reaped-scratch}/$name/$keep_dir"
            if mkdir -p "$keep_dest" 2>/dev/null \
                && cp -Rp "$path/$keep_dir/." "$keep_dest/" 2>/dev/null; then
                echo "reap-worktrees: archived $name/$keep_dir -> $keep_dest"
            else
                echo "reap-worktrees: $name: $keep_dir archive to $keep_dest failed — NOT removing the tree"
                keep_tree=1
                break
            fi
        done
        [ "$keep_tree" = 1 ] && continue
        # `safe_remove` includes the dead-lock case (a session that crashed
        # without a clean SessionEnd never released its SessionStart lock) —
        # `git worktree remove` unconditionally refuses a locked worktree, so
        # unlock first. Harmless no-op (swallowed) if it was never locked.
        git worktree unlock "$path" >/dev/null 2>&1 || true
        # A per-worktree MCP server (scripts/wt-mcp, dev-loop-scratch D1) is
        # a prod read-write container outside the tree. Tear it down by
        # name from THIS checkout's script (never the tree's own), bounded
        # by a timeout, and if that fails keep the tree: an orphaned server
        # must never outlive the tree that can still find it. `--if-present`
        # makes a tree that never ran a server a quick no-op.
        if [ -x scripts/wt-mcp ] && ! "${TIMEOUT_RUNNER[@]+"${TIMEOUT_RUNNER[@]}"}" \
                scripts/wt-mcp down --root "$path" --if-present >/dev/null 2>&1; then
            echo "reap-worktrees: $name: wt-mcp down --root failed or timed out — NOT removing the tree (a precis-wt-${name} server may still be up; run scripts/wt-mcp down --root $path)"
            continue
        fi
        if git worktree remove "$path" 2>/dev/null; then
            # safe_remove already means the bucket vetted mergedness (either a
            # true ancestor merge or squash-absorbed); -D deletes both, -d would
            # refuse the squash case despite it being safe.
            git branch -D "$branch" >/dev/null 2>&1 || true
            # Reclaim this worktree's isolated test-DB project (container + volume)
            # now the tree is gone — `down -p <name>` finds it by label, no compose
            # file needed (gr176375). Only after a successful removal, so a
            # still-wanted tree never loses its DB. Best-effort: missing docker / an
            # already-gone project must never break the reap.
            if command -v docker >/dev/null 2>&1 && command -v compose_project_for >/dev/null 2>&1; then
                proj="$(compose_project_for "$path" 2>/dev/null || true)"
                [ -n "$proj" ] && env UID="$(id -u)" GID="$(id -g)" \
                    docker compose -p "$proj" down -v >/dev/null 2>&1 || true
            fi
            REAPED+=("$name")
        fi
    done
fi

sweep_ci_refs
reap_branchless_branches
# Kimi Code keeps its own workspace list; drop entries for trees now gone
# (any removal path, not just this run's). No Kimi install → silent no-op.
if [ -x scripts/reap-kimi-workspaces ]; then
    KIMI_ARGS=(--for-hook)
    [ "$DRY_RUN" = 1 ] && KIMI_ARGS+=(--dry-run)
    scripts/reap-kimi-workspaces "${KIMI_ARGS[@]}" 2>/dev/null || true
fi

if [ "${#REAPED[@]}" -eq 0 ]; then
    [ "$FOR_HOOK" = 1 ] || echo "reap-worktrees: nothing to reap"
elif [ "$DRY_RUN" = 1 ]; then
    echo "reap-worktrees --dry-run: would reap ${#REAPED[@]}: ${REAPED[*]}"
else
    echo "reap-worktrees: reaped ${#REAPED[@]}: ${REAPED[*]}"
fi
exit 0

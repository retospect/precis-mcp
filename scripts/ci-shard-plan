#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""The ship gate's test-linux shard count: derived from the account's
runner pool, not a bare literal (gr702666); evaluates to 10 today.

The count is the largest N whose cohabitation budgets all fit the
account's concurrent-job cap (GitHub Pro: 40 standard-runner jobs — a
named setting below, not an API lookup):

- two concurrent gates plus both soaks plus main's check lane:
  scripts/ship caps in-flight ci/* gates at 2 and a release gate can
  overlap them, each gate blocks on GATE_FIXED_JOBS + N jobs, each soak
  runs at most SOAK_PARALLEL legs, and main's lane takes MAIN_LANE_JOBS
  (slim plan+lint, or the 4-job docs lane):
      2 * (GATE_FIXED_JOBS + N) + 2 * SOAK_PARALLEL + MAIN_LANE_JOBS
- the nightly full matrix beside one gate: its non-matrix jobs are
  NIGHTLY_FIXED_JOBS, its test-linux legs are capped at
  NIGHTLY_MATRIX_PARALLEL in flight, and one gate blocks at
  GATE_FIXED_JOBS + N:
      min(2N, NIGHTLY_MATRIX_PARALLEL) + NIGHTLY_FIXED_JOBS
          + GATE_FIXED_JOBS + N

Both budgets bind at N = 10 (two-gates-plus-main gives 10, nightly 11);
the floor is Reto 2026-10-23: "10 is fine, we don't need 40. But no
fewer" (me692603). A wider count is bought only by raising the account
cap or dropping a cohabitant — and the workflow's own job-budget comment
must be re-done in that same change.

Prints ``n=<N>``, ``list=<[1..N]>`` and ``shard_files={"1": […], …}`` for
$GITHUB_OUTPUT. check.yml's `plan` job runs it once per run; the shard
matrix follows ``list``, ``--shard K/N``'s denominator follows ``n``, and
`test-linux` hands each shard its own file list (``shard_files``) to
collect — one shard's ~250 files, not every xdist worker collecting the
whole suite.

``--files K/N`` prints shard K's file list, newline-separated, for local
inspection; it is the same file-level partition conftest's --shard applies
(scripts/lib/shard_partition.py, loaded via runpy so tests can stage a .py
copy of this script beside a lib/ dir).

Not 6 or 8: measured shards ran 32-40 min (6) and 32-36 min (8) of the 40 min
timeout, no headroom. Not the load-based 12 of gr492653 either: every shard
repeats its setup, so wider gates raise job-minutes per landing ~35% for
little wall (e94cfe674, reverted 94df07003).

FORCE_SHARDS (the workflow_dispatch `shards` input) still overrides for
measuring another width; the floor is SHARDS.

The count's weights table lives in tests/shard_weights.json; a second count
needs a table there, GATE_SHARD_COUNTS in scripts/lib/last_gated_main_sha.py, and
the budget arithmetic in tests/test_ci_shards.py.
"""

from __future__ import annotations

import json
import os
import re
import runpy
import subprocess
import sys
from pathlib import Path

#: Reto 2026-10-23: "10 is fine, we don't need 40. But no fewer"
#: (me692603) — the derivation below cannot go below this.
SHARDS_FLOOR = 10
#: The account's GitHub standard-runner concurrency (GitHub Pro: 40
#: concurrent jobs). Not exposed by any API; a named setting.
ACCOUNT_CONCURRENT_JOBS = 40
#: Blocking jobs of one gate besides the shards: `plan` + `lint`.
GATE_FIXED_JOBS = 2
#: One gate's soak runs at most this many legs at once (check.yml's
#: test-linux max-parallel on the gate shape).
SOAK_PARALLEL = 5
#: Main's check lane can run beside a gate: the slim lane is plan+lint,
#: a docs-only push takes the 4-job docs lane instead — size for both.
MAIN_LANE_JOBS = 2 + 4
#: scripts/ship caps concurrent ci/* gates at two; a release gate can
#: overlap them, so two gates is the sizing case.
CONCURRENT_GATES = 2
#: The nightly's non-matrix jobs (plan + lint + coverage-db + the four
#: test-other legs) and the in-flight cap on its test-linux matrix.
NIGHTLY_FIXED_JOBS = 7
NIGHTLY_MATRIX_PARALLEL = 20


def derived_shards() -> int:
    """The largest N satisfying every cohabitation budget, floored at
    SHARDS_FLOOR (the budgets' constants are the module docstring's
    arithmetic, in code so tests can pin them)."""
    two_gates_main = (
        ACCOUNT_CONCURRENT_JOBS - MAIN_LANE_JOBS
    ) // CONCURRENT_GATES - GATE_FIXED_JOBS - SOAK_PARALLEL
    nightly_gate = max(
        n
        for n in range(1, ACCOUNT_CONCURRENT_JOBS)
        if min(2 * n, NIGHTLY_MATRIX_PARALLEL)
        + NIGHTLY_FIXED_JOBS
        + GATE_FIXED_JOBS
        + n
        <= ACCOUNT_CONCURRENT_JOBS
    )
    return max(SHARDS_FLOOR, min(two_gates_main, nightly_gate))


SHARDS = derived_shards()
ROOT = Path(__file__).resolve().parents[1]
_SP = runpy.run_path(str(Path(__file__).resolve().parent / "lib" / "shard_partition.py"))
load_pins = _SP["load_pins"]
shard_index = _SP["shard_index"]

#: pytest's default ``python_files`` (no pyproject override) under
#: ``testpaths = ["tests"]``: ``test_*.py`` and ``*_test.py`` at any depth.
TEST_FILE = re.compile(r"(^|/)(test_[^/]*|[^/]*_test)\.py$")


def test_files() -> list[str]:
    """Every file pytest collects under tests/, sorted — the universe the
    ``n`` shards partition."""
    try:
        out = subprocess.run(
            ["git", "ls-files", "-z", "--", "tests"],
            cwd=ROOT,
            check=True,
            capture_output=True,
            encoding="utf-8",
        ).stdout
    except (subprocess.CalledProcessError, OSError):
        # Inside the `scripts/ship --checked` container the tree is a
        # bind-mounted worktree whose `.git` file points at a gitdir outside
        # the mount, so git exits 128. Walk the filesystem instead; CI (a real
        # checkout) never lands here and keeps the tracked set.
        found: list[str] = []
        for dirpath, dirnames, filenames in os.walk(ROOT / "tests"):
            dirnames[:] = [
                d for d in dirnames if d != "__pycache__" and not d.startswith(".")
            ]
            for name in filenames:
                rel = (Path(dirpath) / name).relative_to(ROOT).as_posix()
                if TEST_FILE.search(rel):
                    found.append(rel)
        return sorted(found)
    return sorted(p for p in out.split("\0") if TEST_FILE.search(p))


def shard_files(n: int) -> dict[str, list[str]]:
    """``{"1": [files…], …, "n": […]}`` — the file-level partition at ``n``."""
    pins = load_pins()
    buckets: dict[str, list[str]] = {str(k): [] for k in range(1, n + 1)}
    for f in test_files():
        buckets[str(shard_index(f, n, pins) + 1)].append(f)
    return buckets


def main(argv: list[str] | None = None) -> int:
    argv = sys.argv if argv is None else argv
    if len(argv) > 1 and argv[1] == "--files":
        spec = argv[2] if len(argv) > 2 else ""
        k_s, _, n_s = spec.partition("/")
        if not (k_s.isdigit() and n_s.isdigit() and 1 <= int(k_s) <= int(n_s)):
            print(f"--files expects K/N (1 <= K <= N), got {spec!r}", file=sys.stderr)
            return 2
        for f in shard_files(int(n_s))[k_s]:
            print(f)
        return 0
    forced = os.environ.get("FORCE_SHARDS", "")
    n = int(forced) if forced.isdigit() else SHARDS
    n = max(n, SHARDS)
    files = shard_files(n)
    sizes = [len(v) for v in files.values()]
    print(
        f"shard plan: n={n} (forced={forced or '-'}) "
        f"files per shard {min(sizes)}..{max(sizes)}",
        file=sys.stderr,
    )
    print(f"n={n}")
    print(f"list={json.dumps(list(range(1, n + 1)))}")
    print(f"shard_files={json.dumps(files, separators=(',', ':'))}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

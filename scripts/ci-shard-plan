#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""The ship gate's test-linux shard count: fixed 10 (Reto 2026-10-23 —
"10 is fine, we don't need 40. But no fewer"; docs/backlog/release-train.md).

Prints ``n=<N>`` and ``list=<[1..N]>`` for $GITHUB_OUTPUT. check.yml's `plan`
job runs it once per run and the shard matrix, ``pytest --shard K/N`` and
max-parallel all follow it.

Not 6 or 8: measured shards ran 32-40 min (6) and 32-36 min (8) of the 40 min
timeout, no headroom. Not the load-based 12 of gr492653 either: a 10-shard
gate is 12 jobs, so three fit the 40-job Pro cap; every shard repeats its
setup, so wider gates raise job-minutes per landing ~35% for little wall.

FORCE_SHARDS (the workflow_dispatch `shards` input) still overrides for
measuring another width; the floor is SHARDS.

The count's weights table lives in tests/shard_weights.json; a second count
needs a table there, GATE_SHARD_COUNTS in scripts/last-gated-main-sha, and
the budget arithmetic in tests/test_ci_shards.py.
"""

from __future__ import annotations

import json
import os
import sys

SHARDS = 10


def main() -> int:
    forced = os.environ.get("FORCE_SHARDS", "")
    n = int(forced) if forced.isdigit() else SHARDS
    n = max(n, SHARDS)
    print(f"shard plan: n={n} (forced={forced or '-'})", file=sys.stderr)
    print(f"n={n}")
    print(f"list={json.dumps(list(range(1, n + 1)))}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())

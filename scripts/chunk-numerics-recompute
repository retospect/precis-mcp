#!/usr/bin/env bash
# scripts/chunk-numerics-recompute — refill chunks.numerics with extract_numerics_wide
# (list heads, thousands/p.p.m., PDF math ±, micro units, range ends, table-header
# units). Dry run by default; --apply writes. Derived metadata: body text untouched.
# Database: PRECIS_DATABASE_URL (default dev DB); prod via the gitignored overlay.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run python scripts/_chunk_numerics_recompute.py "$@"

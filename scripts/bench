#!/usr/bin/env bash
# scripts/bench — memory-ablation benchmark entry point (thin wrapper).
#
# Usage:
#   scripts/bench ingest --set quick|full [--chunker sentence-pysbd|section|fixed-<N>]
#                                           # fetch (pinned) + ingest the QASPER fixture into the DEV db
#   scripts/bench variant <arm> [--set S]   # provision a re-ingest arm's own throwaway DB
#                                           # (chunk-sentence-pysbd|chunk-fixed-512|chunk-section|no-links|distractor-<N>);
#                                           # `run` provisions on its own — this is for a separate
#                                           # pg_dump/warmup step before a long run
#   scripts/bench manifest [--check]        # maintainers: rebuild/verify bench/corpus/manifest.json
#   scripts/bench tasks --set quick|full    # extract the QASPER span-gold tasks -> bench/tasks/qasper-<set>.jsonl
#                                           # (+ yield table; --check verifies the file on disk; full is gitignored)
#   scripts/bench fill [--embedder bge-m3|mock]
#                                           # free local derived passes on the dev DB: chunk embeddings
#                                           # + per-chunk keywords (no LLM: summaries, categorizer tags
#                                           # and edges stay empty; `run` reports their coverage)
#   scripts/bench run --set quick [--caller triage|rowkw|ladder] [--arms a,b] [--seed N] [--out F] [--planted N] [--budget T]
#                                           # scripted-caller ablation matrix -> bench/results/<date>Z-<sha>-quick-<caller>.json;
#                                           # re-ingest arms in --arms provision + run their own DB (header.worlds)
#   scripts/bench sweep [--caller triage|rowkw] [--seeds 1,2,3]   # pick the triage threshold on planted dev seeds (throwaway DB of its own:
#                                           # PRECIS_DATABASE_URL=...precis_dev_sweep; never the reported seed, never QASPER)
#   scripts/bench report <results.json>... [--figure out.svg|png]
#                                           # markdown table per arm (+ delta vs all-on); >1 file also side by side;
#                                           # --figure: recall@k vs median tokens-to-gold, per arm
#   scripts/bench raw <results.json> [--arm A]… [--task T] [--source S] [--offset N] [--limit M]
#                                           # the raw log in bounded slices: one block per task x arm
#                                           # row with its per-call token log; the Next: line names the next slice
#   scripts/bench index [--match X] [--offset N] [--limit M]
#                                           # one line per held run (stem, dates, set, caller, counts,
#                                           # td<id> launched under); --match filters by substring over
#                                           # the line or the file text (a date, a caller, a td<id>)
#
# Everything runs inside the precis-dev container via scripts/dev, which points
# PRECIS_DATABASE_URL at this worktree's precis_dev; the loader refuses any
# database not named precis_dev*/precis_test*/precis_bench*, so prod is never
# reachable. `ingest` brings the dev DB up first (idempotent). The pinned
# archive is cached under PRECIS_BENCH_CACHE (a path inside the container;
# default /app/.scratch/bench-cache, i.e. the gitignored .scratch/ of this
# checkout). Embeddings are the worker's job:
#   scripts/dev uv run --no-sync precis worker --only embed --embedder mock
#
# Design: memory graph hub me621608; slices: todo tree under td604839
set -euo pipefail

cd "$(dirname "$0")/.."

if [[ "${1:-}" == "ingest" || "${1:-}" == "variant" ]]; then
    scripts/dev db-up
fi

# The container cannot read this worktree's git dir, so the host pins the sha
# the results header records (PRECIS_BENCH_GIT_DIRTY = changed-path count).
# PRECIS_CURRENT_TODO is forwarded too: a run launched under a todo records it
# in header.todo, which the bench:index search-by-todo-reference matches.
BENCH_SHA="$(git rev-parse HEAD)"
BENCH_DIRTY="$(git status --porcelain | wc -l | tr -d ' ')"
export PRECIS_DEV_ENV="${PRECIS_DEV_ENV:-} PRECIS_BENCH_CACHE=${PRECIS_BENCH_CACHE:-/app/.scratch/bench-cache} HF_HOME=${HF_HOME:-/app/.scratch/hf-cache} PRECIS_BENCH_GIT_SHA=${BENCH_SHA} PRECIS_BENCH_GIT_DIRTY=${BENCH_DIRTY} PRECIS_CURRENT_TODO=${PRECIS_CURRENT_TODO:-}"
exec scripts/dev uv run --no-sync python -m precis.bench "$@"

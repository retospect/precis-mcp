#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""Regenerate tests/shard_weights.json from a pytest junit-xml full-suite run.

    scripts/test --bg --junitxml=.scratch/junit.xml -q    # full suite
    scripts/shard-weights .scratch/junit.xml [more-runs.xml ...]

Tests that took >= HEAVY seconds are pinned to shards by greedy
longest-first packing on top of the crc32 load of all the light tests;
everything else (and any test added later) keeps hashing, so the partition
stays exact (tests/conftest.py shard_index). One table per shard count scripts/ci-shard-plan can pick. Re-run when a
shard drifts past ~30 min in check.yml.

``seconds`` records the averaged junit time of every test >= RECORD seconds;
tests/test_ci_shards.py caps it, so one test can't eat a shard's budget.
"""

from __future__ import annotations

import json
import sys
import xml.etree.ElementTree as ET
import zlib
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
OUT = ROOT / "tests" / "shard_weights.json"
NS = (10, 12)  # scripts/ci-shard-plan's LOADED, IDLE
HEAVY = 1.0
RECORD = 60.0


def nodeid(classname: str, name: str) -> str | None:
    parts = [p for p in classname.split(".") if p]
    for i in range(len(parts), 0, -1):
        path = Path(*parts[:i]).with_suffix(".py")
        if (ROOT / path).exists():
            return "::".join([str(path), *parts[i:], name])
    return None


def pack(times: dict[str, float], n: int) -> tuple[dict[str, int], list[float]]:
    load = [0.0] * n
    heavy: list[tuple[float, str]] = []
    for nid, t in times.items():
        if t >= HEAVY:
            heavy.append((t, nid))
        else:
            load[zlib.crc32(nid.encode("utf-8")) % n] += t
    pinned: dict[str, int] = {}
    for t, nid in sorted(heavy, key=lambda x: (-x[0], x[1])):
        k = min(range(n), key=lambda i: (load[i], i))
        load[k] += t
        pinned[nid] = k
    return dict(sorted(pinned.items())), load


def main(argv: list[str]) -> int:
    # Several junit files (one per run, or one per shard of a run) are merged;
    # a test seen in k RUNS is averaged over them, which damps runner-speed noise.
    per_run: dict[str, list[float]] = {}
    for path in argv[1:]:
        seen: dict[str, float] = {}
        for tc in ET.parse(path).getroot().iter("testcase"):
            nid = nodeid(tc.get("classname", ""), tc.get("name", ""))
            if nid:
                seen[nid] = seen.get(nid, 0.0) + float(tc.get("time", 0))
        for nid, t in seen.items():
            per_run.setdefault(nid, []).append(t)
    times = {nid: sum(v) / len(v) for nid, v in per_run.items()}
    tables: dict[str, dict[str, int]] = {}
    for n in NS:
        pinned, load = pack(times, n)
        tables[str(n)] = pinned
        print(
            f"estimated shard load N={n} (junit-minutes):",
            [round(x / 60, 1) for x in load],
        )
    seconds = {nid: round(t) for nid, t in sorted(times.items()) if t >= RECORD}
    OUT.write_text(
        json.dumps({"tables": tables, "seconds": seconds}, indent=0) + "\n",
        encoding="utf-8",
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))

#!/usr/bin/env -S uv run --no-project --with tomlkit>=0.13 --python >=3.12 python
"""Install this repo's agent setup into Kimi Code's user config.

    scripts/kimi-setup            write ~/.kimi-code/{mcp.json,config.toml}
    scripts/kimi-setup --check    report drift only; exit 1 when stale

Idempotent; scripts/kimi-tree runs it before every launch, so a rotated
precis token reaches Kimi the next time a tree starts.

- mcp.json: the `precis` server, copied from the user-scope entry in
  ~/.claude.json (same URL; a `Bearer` Authorization header is converted —
  the token is written to ~/.secrets/pw/PRECIS_MCP_TOKEN, mode 600, and
  the entry carries `bearerTokenEnvVar` instead, so no credential sits in
  mcp.json itself). Other servers are left alone.
- config.toml: merged structurally (tomlkit), never by comment markers —
  Kimi re-serializes the file on its own saves and drops comments, so
  marker-delimited blocks were lost and re-appended as duplicate keys.
  Managed entries are recognised by content: a top-level
  `extra_skill_dirs` (Kimi loads `.claude/skills/` and the
  flat `.claude/commands/*.md` from the project root, so /skill:land,
  /skill:qland, /skill:go, /skill:bug ... resolve),
  one `[[hooks]]` entry per event calling scripts/hooks/kimi-adapt.py
  (which dispatches to `.claude/settings.json`'s hooks), a `PreToolUse`
  hook on Grep/Bash calling scripts/hooks/kimi-grep-python-kind.py
  (mirrors ripgrep patterns through the precis python kind, advisory),
  plus `default_permission_mode = "yolo"` and Claude's Bash/MCP allow
  list as `[[permission.rules]]`. An `[mcp]` table sets
  `startup_timeout_ms` so a slow-starting precis server outlives the
  client's default patience. Hooks are user-level in Kimi, so each
  command no-ops outside a precis-mcp tree.

Project instructions need no install: Kimi reads AGENTS.md and
.kimi-code/AGENTS.md from the tree. KIMI_CODE_HOME and CLAUDE_JSON
override the paths (tests).
"""

import json
import os
import re
import sys
from pathlib import Path

import tomlkit

HOME = Path(os.environ.get("KIMI_CODE_HOME", Path.home() / ".kimi-code"))
CLAUDE_JSON = Path(os.environ.get("CLAUDE_JSON", Path.home() / ".claude.json"))

# Comment markers written by earlier versions; stripped on sight.
LEGACY_MARKER = re.compile(r"^# (>>>|<<<) precis-mcp kimi-setup: .*\n?", re.M)
MANAGED_HOOK = "scripts/hooks/kimi-"
RULE_REASON = "mirrors the Claude Code allow list"
SKILL_DIRS = [".claude/skills", ".claude/commands"]

#: How long the client waits for an MCP server to come up before giving
#: up, ms. The precis dev server is a local uvicorn that can sit behind a
#: cold venv for longer than the client's default patience — a reconnect
#: then fails 2-3 quick tries and leaves the session without precis
#: until a manual restart (Reto 2026-10-27: don't give up before ~10 s).
MCP_STARTUP_TIMEOUT_MS = 30_000

HOOK_CMD = (
    'f=scripts/hooks/kimi-adapt.py; [ -x "$f" ] || exit 0; '
    "git rev-parse --path-format=absolute --git-common-dir 2>/dev/null "
    "| grep -q precis-mcp || exit 0; "
    'exec "$f" {event}'
)
# The ripgrep→python-kind nudge: a Grep tool call or a bare rg/grep Bash
# inside a precis-mcp checkout gets the same pattern mirrored through
# search(kind='python', mode='pattern') on the local MCP, advisory-only
# (exit 0 — the call still runs; the python-kind digest rides as context).
PYKIND_HOOK_CMD = (
    'f=scripts/hooks/kimi-grep-python-kind.py; [ -x "$f" ] || exit 0; '
    "git rev-parse --path-format=absolute --git-common-dir 2>/dev/null "
    "| grep -q precis-mcp || exit 0; "
    'exec "$f"'
)
EVENTS = (("PreToolUse", 60), ("PostToolUse", 60), ("SessionStart", 300))
ROOT = Path(__file__).resolve().parent.parent
CLAUDE_SETTINGS = Path(
    os.environ.get("CLAUDE_SETTINGS", Path.home() / ".claude" / "settings.json")
)


def claude_allow_patterns() -> list[str]:
    """Claude's allow list (project + user settings) in Kimi pattern syntax.

    `Bash(git:*)` → `Bash(git*)`; bare tool names (`mcp__precis__get`) pass
    through. Kimi matches MCP tools by name only, so an MCP entry with an
    argument pattern is dropped.
    """
    out: list[str] = []
    for path in (ROOT / ".claude" / "settings.json", CLAUDE_SETTINGS):
        try:
            allow = json.loads(path.read_text(encoding="utf-8"))["permissions"]["allow"]
        except (OSError, ValueError, KeyError, TypeError):
            continue
        for rule in allow:
            m = re.fullmatch(r"Bash\((.*?)(?::\*)?\)", rule)
            if m:
                pat = f"Bash({m.group(1)}*)" if rule.endswith(":*)") else rule
            elif re.fullmatch(r"mcp__[\w-]+__[\w-]+", rule):
                pat = rule
            else:
                continue
            if pat not in out:
                out.append(pat)
    return out


def managed_hooks() -> list[dict]:
    hooks = [
        {"event": event, "command": HOOK_CMD.format(event=event), "timeout": timeout}
        for event, timeout in EVENTS
    ]
    hooks.append(
        {
            "event": "PreToolUse",
            "matcher": "^(Grep|Bash)$",
            "command": PYKIND_HOOK_CMD,
            "timeout": 30,
        }
    )
    return hooks


def _merge_aot(parent: dict, key: str, ours: list[dict], is_ours) -> None:
    """Replace our entries in the array of tables ``parent[key]``, keeping
    the user's own entries (and their order) ahead of ours. Untouched when
    already right, so a synced file round-trips byte for byte."""
    current = [t.unwrap() for t in parent.get(key, [])]
    want = [t for t in current if not is_ours(t)] + ours
    if current == want:
        return
    aot = tomlkit.aot()
    for entry in want:
        aot.append(tomlkit.item(entry))
    parent.pop(key, None)
    parent[key] = aot


def _set(parent: dict, key: str, value) -> None:
    if key not in parent or parent[key].unwrap() != value:
        parent[key] = value


def render_config(text: str) -> str:
    text = LEGACY_MARKER.sub("", text)
    try:
        doc = tomlkit.parse(text)
    except tomlkit.exceptions.ParseError as exc:
        sys.exit(
            f"kimi-setup: {HOME / 'config.toml'} is not valid TOML ({exc}); "
            "next= fix the reported line (a duplicated key from an older "
            "kimi-setup: delete the second copy), then re-run kimi-setup"
        )
    # .claude/commands/*.md are flat skill files to Kimi (name = filename),
    # so /land, /qland, /go ... load as /skill:land etc.
    _set(doc, "extra_skill_dirs", SKILL_DIRS)
    # Claude runs `defaultMode: auto`; Kimi's analogue is yolo ("Ask When
    # Needed": routine edits and commands run, risky ones still ask). A mode
    # the user set by hand wins.
    if "default_permission_mode" not in doc:
        doc["default_permission_mode"] = "yolo"
    if "mcp" not in doc:
        doc["mcp"] = tomlkit.table()
    _set(doc["mcp"], "startup_timeout_ms", MCP_STARTUP_TIMEOUT_MS)
    _merge_aot(
        doc,
        "hooks",
        managed_hooks(),
        lambda t: MANAGED_HOOK in str(t.get("command", "")),
    )
    if "permission" not in doc:
        doc["permission"] = tomlkit.table()
    _merge_aot(
        doc["permission"],
        "rules",
        [
            {"decision": "allow", "pattern": pat, "reason": RULE_REASON}
            for pat in claude_allow_patterns()
        ],
        lambda t: t.get("reason") == RULE_REASON,
    )
    return tomlkit.dumps(doc)


def _secrets_token(token: str) -> None:
    """Write the bearer token to the user's secrets file (mode 600) when
    it is missing or stale — the same ``~/.secrets/pw/PRECIS_MCP_TOKEN``
    the shell's export sources, so the env var the config names actually
    exists. No-op when the file already holds the token."""
    path = Path.home() / ".secrets" / "pw" / "PRECIS_MCP_TOKEN"
    try:
        if path.read_text(encoding="utf-8").strip() == token:
            return
    except OSError:
        pass
    if not path.parent.exists():
        path.parent.mkdir(parents=True)
        os.chmod(path.parent, 0o700)
    path.write_text(token + "\n", encoding="utf-8")
    os.chmod(path, 0o600)


def precis_entry() -> dict:
    try:
        servers = json.loads(CLAUDE_JSON.read_text(encoding="utf-8"))["mcpServers"]
        src = servers["precis"]
    except (OSError, ValueError, KeyError) as exc:
        sys.exit(
            f"kimi-setup: no user-scope `precis` MCP entry in {CLAUDE_JSON} ({exc}); "
            "next= run scripts/mcp-entry-preflight, then re-run kimi-setup"
        )
    entry = {"url": src["url"]}
    bearer_env = src.get("bearerTokenEnvVar")
    auth = (src.get("headers") or {}).get("Authorization", "")
    if bearer_env:
        entry["bearerTokenEnvVar"] = bearer_env
    elif auth.startswith("Bearer "):
        # Secret-clean output: the token moves to the user's secrets
        # file and the entry references it by env var — the same
        # Authorization header on the wire, nothing credentialled in
        # mcp.json itself (kimi-setup rewrites it on every tree launch,
        # so an inline token would live forever on disk).
        _secrets_token(auth.removeprefix("Bearer ").strip())
        entry["bearerTokenEnvVar"] = "PRECIS_MCP_TOKEN"
    elif src.get("headers"):
        entry["headers"] = src["headers"]
    return entry


def render_mcp(text: str) -> str:
    try:
        data = json.loads(text) if text.strip() else {}
    except ValueError:
        sys.exit(f"kimi-setup: {HOME / 'mcp.json'} is not valid JSON; fix or remove it")
    data.setdefault("mcpServers", {})["precis"] = precis_entry()
    return json.dumps(data, indent=2) + "\n"


def main() -> int:
    check = sys.argv[1:] == ["--check"]
    if sys.argv[1:] not in ([], ["--check"]):
        print(__doc__.split("\n\n")[1], file=sys.stderr)
        return 2
    stale = []
    for name, render, mode in (
        ("mcp.json", render_mcp, 0o600),
        ("config.toml", render_config, None),
    ):
        path = HOME / name
        old = path.read_text(encoding="utf-8") if path.exists() else ""
        new = render(old)
        if new == old:
            continue
        stale.append(name)
        if check:
            continue
        HOME.mkdir(parents=True, exist_ok=True)
        targets = [(path, new)]
        if old:
            targets.insert(0, (path.with_name(name + ".bak"), old))
        for p, body in targets:
            p.write_text(body, encoding="utf-8")
            if mode is not None:
                p.chmod(mode)
    if check:
        print(
            f"kimi-setup: stale: {', '.join(stale)}" if stale else "kimi-setup: in sync"
        )
        return 1 if stale else 0
    print(f"kimi-setup: wrote {', '.join(stale)}" if stale else "kimi-setup: in sync")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# scripts/onto-repoint — re-point live measures, then merge/retire the
# ontology-v2 Q8 taxa. Dry run by default; --apply writes. Needs migration
# 0234 on the target DB (the precis.allow_measurand_repoint door).
# Database: PRECIS_DATABASE_URL (default dev DB); prod via scripts/_prod-run.
set -euo pipefail
cd "$(dirname "$0")/.."
exec uv run python scripts/_onto_repoint.py "$@"

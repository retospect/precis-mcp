#!/usr/bin/env bash
# scripts/fleet — bring up and drive the thread-session fleet in tmux.
#
# One tmux window per active thread (`claude -w <slug>`), plus a `review`
# window at index 1 that walks Reto through what the sessions need from him.
# The orchestrator session (`/fleet`) runs this; nothing here lands or
# deploys. State is derived from tmux at call time; the only stored input is
# `.claude/fleet/threads.tsv` (slug, effort, design-review flag), which
# follows the active set in `docs/roadmap.md`.
#
#   scripts/fleet up [--stagger N]   create every missing window (idempotent)
#   scripts/fleet status             window · index · ctx% · busy/idle/dialog
#   scripts/fleet say <file> [win…]  send one message; skips open dialogs
#   scripts/fleet effort             send each window its /effort level
#   scripts/fleet watch-ctx          emit a line as a window crosses 30/40/50/…% ctx (PRECIS_FLEET_CTX_FLOOR)
#   scripts/fleet queue-dir          print the review-queue directory
set -euo pipefail

common=$(git rev-parse --path-format=absolute --git-common-dir)
root=$(dirname "$common")
conf="$(git rev-parse --show-toplevel)/.claude/fleet"
table="$conf/threads.tsv"
# Outside any worktree, so a reaped tree cannot take the queue with it.
state="$HOME/.claude/projects/$(printf '%s' "$root" | tr '/.' '--')"
queue="$state/review-queue"
reviews="$state/reviews"
model="${PRECIS_FLEET_MODEL:-opus}"

threads() { grep -v -e '^#' -e '^[[:space:]]*$' "$table"; }
windows() { tmux list-windows -F '#{window_name}'; }
has_window() { windows | grep -q -x -- "$1"; }
has_dialog() { tmux capture-pane -p -t "$1" | grep -q -e 'Enter to select' -e 'Do you want to'; }
need_tmux() { [ -n "${TMUX:-}" ] || { echo "scripts/fleet: run inside tmux" >&2; exit 2; }; }

fill() { # substitute {slug} {queue} {reviews} in a message file, one line out
  sed -e "s|{slug}|$2|g" -e "s|{queue}|$queue|g" -e "s|{reviews}|$reviews|g" "$1" | tr '\n' ' '
}

send() { # send <window> <text>; refuses a window with a dialog open
  if has_dialog "$1"; then echo "SKIPPED (dialog open): $1"; return 0; fi
  tmux send-keys -t "$1" -l "$2"
  # An Enter that arrives with the text is taken as part of the paste and
  # the message sits unsent in the box: pause, submit, then check.
  sleep 1
  tmux send-keys -t "$1" Enter
  sleep 1
  local pane; pane=$(tmux capture-pane -p -t "$1")
  # A busy session shows the queued text too; only an idle one needs the retry.
  if ! printf '%s\n' "$pane" | grep -q -E '… \([0-9]+' && ! has_dialog "$1" &&
     printf '%s\n' "$pane" | grep -A1 '^❯' | grep -q -F -- "${2:0:40}"; then
    tmux send-keys -t "$1" Enter
    echo "sent (second Enter): $1"
  else
    echo "sent: $1"
  fi
}

# A session connects to the shared MCP server once, at start, and gives up for
# its whole life after ~7 s of refused connects (3 retries at 1, 2, 4 s). After
# a reboot the server is minutes away, so a window created first never has
# precis (gr460711: the orchestrator, 2026-10-02 11:34Z). Start the server and
# wait for a real HTTP answer — the supervisor accepts connects during its
# prepare step, so a bare TCP connect is not ready.
wait_mcp() {
  local ensure="${PRECIS_MCP_ENSURE:-$HOME/work/infrastructure/precis-mcp/scripts/precis-mcp-http-ensure.sh}"
  local port="${PRECIS_MCP_HTTP_PORT:-8765}" limit="${PRECIS_FLEET_MCP_WAIT:-600}"
  local start=$SECONDS said=""
  [ -x "$ensure" ] && [ "$limit" != 0 ] || return 0
  bash "$ensure" || true
  until [ "$(curl -s -o /dev/null -m 5 -w '%{http_code}' -X POST "http://127.0.0.1:$port/mcp")" != 000 ]; do
    if [ $((SECONDS - start)) -ge "$limit" ]; then
      echo "scripts/fleet: no answer from the session MCP server on :$port after ${limit}s;" \
        "starting windows anyway — run /mcp in each once it is up" >&2
      return 0
    fi
    [ -n "$said" ] || { echo "waiting for the session MCP server on :$port (up to ${limit}s)"; said=1; }
    sleep 5
  done
}

cmd_up() {
  need_tmux
  local stagger=10
  [ "${1:-}" = "--stagger" ] && stagger="$2"
  wait_mcp
  mkdir -p "$queue/open" "$queue/answered" "$reviews"
  if ! has_window review; then
    local prompt="You are the review session. Read $conf/review-protocol.md and follow it; the queue directory is $queue. Start with the gather step, then give Reto the status board and the first cluster."
    if tmux list-windows -F '#{window_index}' | grep -q -x 1; then
      tmux new-window -d -b -t 1 -n review -c "$root" "claude --model $model '$prompt'"
    else
      tmux new-window -d -t 1 -n review -c "$root" "claude --model $model '$prompt'"
    fi
    echo "created: review"
  fi
  threads | while IFS=$'\t' read -r slug _effort _review; do
    if has_window "$slug"; then echo "exists: $slug"; continue; fi
    tmux new-window -d -n "$slug" -c "$root" \
      "claude -w $slug --model $model 'Resume the work on $slug'"
    echo "created: $slug"
    sleep "$stagger"
  done
}

cmd_status() {
  need_tmux
  # precis MCP per pane: a session that gave up on it is otherwise silent
  # (gr462596) — DOWN means run /mcp → precis → Reconnect in that window.
  # The helper sits beside this script; a copy run from elsewhere (an
  # unsynced tree, `git show origin/main:scripts/fleet`) falls back to the
  # main checkout's. No helper or a failed one prints `?`, never `-`, which
  # means "no MCP events yet".
  local mcp="" unknown="?" helper="$(dirname "$0")/lib/fleet_mcp_state.py"
  [ -f "$helper" ] || helper="$root/scripts/lib/fleet_mcp_state.py"
  if [ ! -f "$helper" ]; then
    echo "scripts/fleet: no fleet_mcp_state.py beside this script or in $root — mcp column unknown" >&2
  elif mcp=$(python3 "$helper"); then
    unknown="-"
  else
    echo "scripts/fleet: $helper failed — mcp column unknown" >&2
  fi
  printf '%-3s %-28s %-8s %-7s %s\n' "#" window ctx state mcp
  tmux list-windows -F '#{window_index} #{window_name} #{pane_id}' | while read -r idx w pid; do
    pane=$(tmux capture-pane -p -t "$w" 2>/dev/null) || continue
    pct=$(printf '%s\n' "$pane" | grep -o '[0-9]*% ctx' | tail -1 || true)
    if printf '%s\n' "$pane" | grep -q -e 'Enter to select' -e 'Do you want to'; then st=DIALOG
    elif printf '%s\n' "$pane" | grep -q -E '… \([0-9]+'; then st=busy
    else st=idle; fi
    m=$(printf '%s\n' "$mcp" | awk -v p="$pid" '$1 == p {print $2; exit}')
    printf '%-3s %-28s %-8s %-7s %s\n' "$idx" "$w" "${pct:--}" "$st" "${m:-$unknown}"
  done
}

cmd_say() {
  need_tmux
  local file="$1"; shift
  # An unreadable file would send an empty message, i.e. a bare Enter.
  [ -s "$file" ] || { echo "scripts/fleet say: no such message file: $file" >&2; exit 2; }
  local wins
  if [ $# -gt 0 ]; then wins="$*"; else wins=$(threads | cut -f1); fi
  for w in $wins; do
    has_window "$w" || { echo "no window: $w"; continue; }
    send "$w" "$(fill "$file" "$w")"
  done
}

cmd_effort() {
  need_tmux
  # `/effort` saves its level as the default for new sessions, last write
  # wins: send medium first so the saved default ends on high.
  for level in medium high; do
    threads | while IFS=$'\t' read -r slug effort _review; do
      [ "$effort" = "$level" ] || continue
      has_window "$slug" && send "$slug" "/effort $level"
    done
  done
}

cmd_watch_ctx() {
  need_tmux
  local seen="" w pane pct bucket st
  while true; do
    for w in $(windows | grep -v -x -e organizer -e presentation); do
      pane=$(tmux capture-pane -p -t "$w" 2>/dev/null) || continue
      pct=$(printf '%s\n' "$pane" | grep -o '[0-9]*% ctx' | tail -1 | grep -o '^[0-9]*' || true)
      [ -z "$pct" ] && continue
      [ "$pct" -lt "${PRECIS_FLEET_CTX_FLOOR:-30}" ] && continue
      bucket=$((pct / 10 * 10))
      case "$seen" in *" $w:$bucket"*) continue ;; esac
      seen="$seen $w:$bucket"
      if printf '%s\n' "$pane" | grep -q -E '… \([0-9]+'; then st=busy; else st=idle; fi
      echo "ctx $w ${pct}% $st"
    done
    sleep 60
  done
}

case "${1:-}" in
  up) shift; cmd_up "$@" ;;
  status) cmd_status ;;
  say) shift; cmd_say "$@" ;;
  effort) cmd_effort ;;
  watch-ctx) cmd_watch_ctx ;;
  queue-dir) echo "$queue" ;;
  *) sed -n '2,16p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac

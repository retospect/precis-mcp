#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/docs-index — regenerate the gitignored doc indexes.

Five standalone generated files, one script, run by the SessionStart
hook (each worktree regenerates its own copies; nothing is committed —
the files are gitignored, so they never churn or conflict):

  docs/backlog/INDEX.md    one line per work item: slug — status — summary
  docs/runbooks/INDEX.md   one line per runbook: slug — summary
  docs/codebase-map.md     package map: import path — docstring first line
  docs/backlog/threads/PRIORITIES.md  activity + bounded Resume fields,
                           then each thread's open gripes (gripes tagged
                           thread:<slug>, read from prod best-effort via
                           scripts/prod-psql --ro; off with
                           PRECIS_DOCS_INDEX_GRIPES=0 and under CI)
  docs/repo-dev-start-page.md  cold-start fallback: the repo-dev start
                           page and the soul index embedded verbatim
                           from their canonical skill files (rev-stamped,
                           never a maintained copy) plus the
                           missing-MCP pointers — checkout files only,
                           no database needed

The summary for a markdown file is its first non-heading, non-front-matter
prose line; `status:` is read from front-matter (backlog only, defaults to
`idea`). The backlog index is grouped by `pillar:` (docs/roadmap.md), one
H2 per pillar in the roadmap's order, unpillared items last so the lint
line and the index agree on what is missing. The package map walks src/*/**/__init__.py and takes each module
docstring's first line (PEP 257) — a package without a docstring is listed
as such, which is the nudge to write one.

`scripts/docs-index --lint` writes nothing; it checks the docstring layer
(exit 1 on any finding, one `docs-index: ...` line each on stderr):
  - ceiling: a package docstring over DOCSTRING_WORD_CEILING words — split it
    by subpackage/module; the narrowest package owns each fact;
  - restatement: a package docstring that copies a run of >= RESTATE_MIN_WORDS
    consecutive words from a doc under docs/ or a skill (the match unit is an
    8-word window; a copied sentence is a run of windows). One owner per fact:
    the docstring owns subsystem truth and docs/skills point at it, or the
    reverse for agent-facing contract — never both. docs/backlog/ and
    generated files are exempt.

Stdlib-only on purpose: hooks and inline commands run it with a bare
`python3`, no uv/container. Idempotent; exits non-zero only on I/O
errors, invalid thread navigation or (with --lint) a docstring finding.
"""

from __future__ import annotations

import ast
import hashlib
import os
import re
import subprocess
import sys
from datetime import UTC, datetime
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent

HEADER = (
    "<!-- GENERATED by scripts/docs-index — do not edit; gitignored, "
    "regenerated at session start. -->"
)


def front_matter(text: str) -> tuple[dict[str, str], str]:
    """Parse a simple `key: value` front-matter block; return (fm, body)."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end < 0:
        return {}, text
    fm: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" in line:
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()
    return fm, text[end + 4 :]


def summary_line(body: str) -> str:
    """First non-heading, non-blockquote prose line, tidied."""
    for line in body.splitlines():
        s = line.strip()
        if s and not s.startswith(("#", ">", "---", "<!--", "|", "```", "-")):
            return re.sub(r"\s+", " ", s)
    return ""


# Backlog priority buckets → sort rank (high first). Unset/unknown = normal.
_PRIO_RANK = {"high": 0, "normal": 1, "low": 2}

# Pillar order for the backlog index — docs/roadmap.md's order, then the two
# non-pillar buckets, then whatever has no pillar yet.
_PILLAR_ORDER = [
    "memory-graph",
    "3d-design",
    "local-compute",
    "personal",
    "operations",
    "quests",
    "platform",
]
_NO_PILLAR = "(no pillar — add `pillar:` per docs/roadmap.md)"


def md_index(directory: Path, with_status: bool) -> list[str]:
    # (pillar, rank, filename, row): the backlog groups by pillar, then sorts
    # high-priority first, then filename for a stable order within a bucket.
    # Runbooks (with_status=False) have no pillar and all get rank 0, so they
    # stay in pure filename order as before.
    entries: list[tuple[str, int, str, str]] = []
    for f in sorted(directory.glob("*.md")):
        if f.name in ("README.md", "INDEX.md", "TEMPLATE.md"):
            continue
        fm, body = front_matter(f.read_text(encoding="utf-8"))
        summary = fm.get("summary") or summary_line(body)
        if with_status:
            status = fm.get("status", "idea")
            prio = (fm.get("prio") or "normal").lower()
            marker = f" ·{prio}·" if prio in ("high", "low") else ""
            row = f"- [`{f.stem}`](./{f.name}) **{status}**{marker} — {summary}"
            pillar = fm.get("pillar") or _NO_PILLAR
            entries.append((pillar, _PRIO_RANK.get(prio, 1), f.name, row))
        else:
            entries.append(("", 0, f.name, f"- [`{f.stem}`](./{f.name}) — {summary}"))
    if not with_status:
        entries.sort(key=lambda e: (e[1], e[2]))
        return [row for _, _, _, row in entries]
    known = {p: i for i, p in enumerate(_PILLAR_ORDER)}

    def pillar_rank(p: str) -> tuple[int, str]:
        return (known.get(p, len(known) + (1 if p == _NO_PILLAR else 0)), p)

    entries.sort(key=lambda e: (pillar_rank(e[0]), e[1], e[2]))
    rows: list[str] = []
    current = None
    for pillar, _, _, row in entries:
        if pillar != current:
            n = sum(1 for e in entries if e[0] == pillar)
            rows.extend(["", f"## {pillar} ({n})", ""])
            current = pillar
        rows.append(row)
    return rows[1:] if rows and rows[0] == "" else rows


def docstring_first_line(init: Path) -> str | None:
    """First line of the module docstring, or None if absent."""
    text = init.read_text(encoding="utf-8", errors="replace")
    m = re.match(r'\s*(?:#[^\n]*\n\s*)*("""|\'\'\')(.*?)\1', text, re.DOTALL)
    if not m:
        return None
    first = m.group(2).strip().splitlines()
    return re.sub(r"\s+", " ", first[0]).strip() if first else None


def package_map() -> list[str]:
    rows = []
    for init in (ROOT / "src").glob("**/__init__.py"):
        rel = init.relative_to(ROOT / "src").parent
        if any(p.startswith((".", "_")) or p == "__pycache__" for p in rel.parts):
            continue
        if "data" in rel.parts[:-1]:  # resource dirs under a data/ package
            continue
        mod = ".".join(rel.parts)
        line = docstring_first_line(init)
        rows.append(f"- `{mod}` — {line or '*(no package docstring yet)*'}")
    return sorted(rows)


DOCSTRING_WORD_CEILING = 1500
RESTATE_WINDOW = 8  # words per match window
RESTATE_MIN_WORDS = 16  # shortest copied run reported (a full sentence)
_LINT_SKIP_DOCS = ("docs/backlog/", "docs/codebase-map.md", "docs/reference/schema.md")


def _words(text: str) -> list[str]:
    return re.findall(r"[a-z0-9_]+", text.lower())


def package_docstrings() -> dict[str, str]:
    """Package `__init__.py` docstring text (same package set as the map)."""
    out: dict[str, str] = {}
    for init in sorted((ROOT / "src").glob("**/__init__.py")):
        rel = init.relative_to(ROOT / "src").parent
        if any(p.startswith((".", "_")) or p == "__pycache__" for p in rel.parts):
            continue
        if "data" in rel.parts[:-1]:
            continue
        try:
            tree = ast.parse(init.read_text(encoding="utf-8"))
        except SyntaxError:
            continue
        doc = ast.get_docstring(tree)
        if doc:
            out[init.relative_to(ROOT).as_posix()] = doc
    return out


def lint_docstrings() -> list[str]:
    """Findings for the docstring layer: size ceiling + doc/skill restatement."""
    docs = package_docstrings()
    findings = [
        f"{path}: package docstring is {len(doc.split())} words "
        f"(ceiling {DOCSTRING_WORD_CEILING}) — split it by subpackage/module"
        for path, doc in docs.items()
        if len(doc.split()) > DOCSTRING_WORD_CEILING
    ]
    win = RESTATE_WINDOW
    index: dict[tuple[str, ...], set[str]] = {}
    sources = [
        *sorted((ROOT / "docs").glob("**/*.md")),
        *sorted((ROOT / "src/precis/data/skills").glob("**/*.md")),
    ]
    for f in sources:
        rel = f.relative_to(ROOT).as_posix()
        if rel.startswith(_LINT_SKIP_DOCS):
            continue
        text = f.read_text(encoding="utf-8")
        if HEADER[:24] in text[:200]:  # generated file
            continue
        ws = _words(text)
        for i in range(len(ws) - win + 1):
            index.setdefault(tuple(ws[i : i + win]), set()).add(rel)
    need = RESTATE_MIN_WORDS - win + 1  # consecutive matching windows
    for path, doc in docs.items():
        ws = _words(doc)
        runs: dict[str, list[int]] = {}  # file -> [current run, best run]
        last: dict[str, int] = {}
        for i in range(len(ws) - win + 1):
            for rel in index.get(tuple(ws[i : i + win]), ()):
                cur = runs.setdefault(rel, [0, 0])
                cur[0] = cur[0] + 1 if last.get(rel) == i - 1 else 1
                cur[1] = max(cur[1], cur[0])
                last[rel] = i
        for rel, (_, best) in sorted(runs.items()):
            if best >= need:
                findings.append(
                    f"{path} <-> {rel}: {best + win - 1} consecutive words "
                    "restated — one owner: keep it in one place, point from the other"
                )
    return findings


def write_generated(target: Path, title: str, rows: list[str]) -> bool:
    new = "\n".join([f"# {title}", "", HEADER, "", *rows, ""])
    return write_generated_text(target, new)


def write_generated_text(target: Path, new: str) -> bool:
    if target.exists() and target.read_text(encoding="utf-8") == new:
        return False
    target.write_text(new, encoding="utf-8")
    return True


# ── docs/repo-dev-start-page.md — the generated cold-start fallback ──────

#: Sources embedded verbatim, in order: the repo-dev start page, then the
#: soul conduct-layer index. Each section names its file and stamps the
#: file's sha8 — the "generated from the same canonical source with its
#: revision" half of gr564575; no independently maintained copy exists.
START_PAGE_SOURCES = (
    "src/precis/data/skills/precis-repo-dev-start-help.md",
    "src/precis/data/skills/soul.md",
)
START_PAGE_TARGET = "docs/repo-dev-start-page.md"


def _git(root: Path, *args: str) -> str | None:
    """Best-effort one-shot git call in ``root``; None on any failure."""
    try:
        cp = subprocess.run(
            ["git", "--no-optional-locks", "-C", str(root), *args],
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=5,
            check=False,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if cp.returncode != 0 or not cp.stdout.strip():
        return None
    return cp.stdout.strip()


def shared_memory_dir(root: Path) -> str:
    """``~/.claude/projects/<escaped main checkout>/memory`` — the shared
    bootstrap dir. Same derivation as
    ``scripts/hooks/session-start-memory.sh`` and ``scripts/memory-lint``:
    a worktree lands on the main checkout's dir via ``--git-common-dir``,
    so a parent session and its child worktrees share one address."""
    common = _git(root, "rev-parse", "--path-format=absolute", "--git-common-dir")
    if common is None:
        return "~/.claude/projects/<escaped-main-checkout>/memory"
    main_root = str(Path(common).parent)
    return str(
        Path.home() / ".claude" / "projects" / main_root.replace("/", "-") / "memory"
    )


def _nodes_cache_dir() -> Path:
    """The SessionStart node-export dir (``PRECIS_MEMORY_NODES`` override,
    else ``$XDG_CACHE_HOME/precis/memory-nodes``) — same default as
    ``scripts/hooks/session-start-memory.sh``."""
    override = os.environ.get("PRECIS_MEMORY_NODES")
    if override:
        return Path(override)
    return (
        Path(os.environ.get("XDG_CACHE_HOME", Path.home() / ".cache"))
        / "precis"
        / "memory-nodes"
    )


def start_page_text(root: Path) -> str:
    """The whole ``docs/repo-dev-start-page.md`` render.

    Every embedded section is verbatim from its named source file — the
    ``rev`` trailer carries each source's sha8 so a stale render is
    detectable by hashing the file, and no copy is independently
    maintained. The stamp is the newest *source* mtime, not the wall
    clock: regeneration stays idempotent like the other four files (no
    churn, no rewrite when inputs are unchanged). Inputs are checkout
    files and the harness cache paths only — no database, no network,
    so the page renders outage-safe by construction.
    """
    parts: list[tuple[str, str, str]] = []
    newest = 0.0
    for rel in START_PAGE_SOURCES:
        src = root / rel
        text = src.read_text(encoding="utf-8")
        newest = max(newest, src.stat().st_mtime)
        _fm, body = front_matter(text)
        parts.append(
            (rel, hashlib.sha256(text.encode("utf-8")).hexdigest()[:8], body.strip())
        )
    stamp = datetime.fromtimestamp(newest, UTC).strftime("%Y-%m-%dT%H:%M:%SZ")
    revs = " · ".join(f"{rel} {rev}" for rel, rev, _body in parts)
    head = _git(root, "rev-parse", "--short", "HEAD") or "?"
    nodes = _nodes_cache_dir()
    memdir = shared_memory_dir(root)
    out = [
        "# Repo-dev start page",
        "",
        HEADER,
        f"<!-- rev: {revs} · head {head} · sources as of {stamp} -->",
        "",
        "Cold-start, MCP-optional copy of the repo-dev start page and the",
        "soul conduct-layer index — each embedded verbatim from its named",
        "canonical file, never a maintained copy. The checkout",
        "(`AGENTS.md`, `CLAUDE.md`, `docs/`, `scripts/`) and current user",
        "rulings are the authority; this file is a dated mirror, not",
        "permission.",
        "",
        "## If the precis MCP or the memory graph is unreachable",
        "",
        "- Skill bodies: `src/precis/data/skills/<slug>.md` — what",
        "  `get(kind='skill', id='<slug>')` serves, minus the chrome.",
        f"- Memory nodes: `{nodes}/` — `<handle>.md` is `# title` plus",
        "  body, `_sections.tsv` the manifest; stale scratch that the",
        "  next good export overwrites — read it, never edit it as",
        "  memory (rotations beside it: `memory-nodes.<UTC stamp>`).",
        "- Keep a fact: append `## <UTC stamp> <session>` plus the fact",
        f"  to `{memdir}/outage-memory.md`; the SessionStart hook flags",
        "  it for integration once the graph returns. No other memory",
        "  writes during an outage.",
        "- The outage contract — the MCP-down rule, verifying",
        "  unconfirmed writes, the get() ModuleNotFoundError signature:",
        "  `src/precis/data/skills/mcp-down.md`.",
        "- Restore: `docs/runbooks/memory-restore.md`.",
    ]
    for rel, rev, body in parts:
        out += ["", f"## `{rel}` (file rev {rev})", "", body]
    return "\n".join(out) + "\n"


RESUME_FIELDS = (
    "Next",
    "Blocked by",
    "Unblocks",
    "Acceptance",
    "Worktree",
    "Builds",
    "Detail",
)

# Thread front matter: the fleet roster lives in each thread file (no
# separate table). `design-review` is optional and only ever `yes`.
ROSTER_VALUES = ("active", "dormant")
EFFORT_VALUES = ("low", "medium", "high")


def thread_priorities(root: Path) -> list[str]:
    """Render declared activity; reject ambiguous or unreachable entry points.

    Resume fields stay with ranked work so owners update one handoff. Each
    thread file's front matter (`roster`, `pillar`, `effort`) declares
    activity; generated views never infer live processes.
    """
    directory = root / "docs/backlog/threads"
    entries = []
    for path in sorted(directory.glob("*.md")):
        if path.name in ("README.md", "INDEX.md", "PRIORITIES.md"):
            continue
        fm, text = front_matter(path.read_text(encoding="utf-8"))
        roster = fm.get("roster", "")
        if roster not in ROSTER_VALUES:
            raise ValueError(f"{path.name}: roster must be active or dormant")
        pillar = fm.get("pillar", "")
        if pillar not in _PILLAR_ORDER:
            raise ValueError(f"{path.name}: unknown pillar {pillar!r}")
        if fm.get("effort", "") not in EFFORT_VALUES:
            raise ValueError(f"{path.name}: effort must be low, medium or high")
        if fm.get("design-review", "yes") != "yes":
            raise ValueError(f"{path.name}: design-review is yes or absent")
        blocks = re.findall(r"^## Resume\n(.*?)(?=^## |\Z)", text, re.M | re.S)
        if len(blocks) != 1:
            raise ValueError(f"{path.name}: expected one Resume section")
        block = blocks[0]
        fields = re.findall(r"^- \*\*([^:]+):\*\* (.+)$", block, re.M)
        values = dict(fields)
        if len(fields) != len(RESUME_FIELDS) or set(values) != set(RESUME_FIELDS):
            raise ValueError(f"{path.name}: expected Resume fields {RESUME_FIELDS}")
        if len(block.split()) > 350:
            raise ValueError(f"{path.name}: Resume exceeds 350 words")
        for target in re.findall(r"\]\(([^)]+)\)", block):
            if "://" in target:
                continue
            filename, _, anchor = target.partition("#")
            linked = path.parent / filename if filename else path
            if not linked.is_file():
                raise ValueError(f"{path.name}: missing Resume link {target}")
            if anchor:
                headings = re.findall(
                    r"^#+ (.+)$", linked.read_text(encoding="utf-8"), re.M
                )
                anchors = {
                    re.sub(r"[^\w -]", "", h.lower()).replace(" ", "-")
                    for h in headings
                }
                if anchor not in anchors:
                    raise ValueError(f"{path.name}: missing Resume anchor {target}")
        cells = [f"[{path.stem}]({path.name}#resume)", pillar, roster]
        # The table lives beside the thread, so relative file links keep
        # their base but fragment-only links must name the source thread.
        cells.extend(
            re.sub(r"\]\((#[^)]+)\)", rf"]({path.name}\1)", values[key])
            for key in ("Next", "Blocked by", "Unblocks", "Builds")
        )
        entries.append(
            (
                roster != "active",
                _PILLAR_ORDER.index(pillar),
                path.stem,
                "| " + " | ".join(c.replace("|", "\\|") for c in cells) + " |",
            )
        )
    return [
        "Activity is declared by each thread's `roster:` front matter, not "
        "observed live. "
        "Check `scripts/inflight` before resuming. Owners maintain Resume fields; "
        "this table does not re-rank threads.",
        "",
        "[Allocation priorities](../../roadmap.md#allocation-priorities) · "
        "[Programme seams](INDEX.md) · [Thread contract](README.md)",
        "",
        "| Thread | Pillar | Activity | Next action | Blocked by | Unblocks | Builds |",
        "|---|---|---|---|---|---|---|",
        *(entry[3] for entry in sorted(entries)),
    ]


#: Open gripes per thread, from the gripe -> thread link (the
#: ``thread:<slug>`` tag, gripe system batch F slice 5). Read-only role.
_THREAD_GRIPES_SQL = (
    "SELECT concat_ws(chr(31), substr(t.value, 8), r.ref_id, "
    "coalesce(r.prio, 5), "
    "left(regexp_replace(coalesce(r.title, ''), '\\s+', ' ', 'g'), 90)) "
    "FROM refs r "
    "JOIN ref_tags rt ON rt.ref_id = r.ref_id "
    "JOIN tags t ON t.tag_id = rt.tag_id "
    "AND t.namespace = 'OPEN' AND t.value LIKE 'thread:%' "
    "JOIN ref_tags st ON st.ref_id = r.ref_id "
    "JOIN tags s ON s.tag_id = st.tag_id "
    "AND s.namespace = 'STATUS' AND s.value = 'open' "
    "WHERE r.kind = 'gripe' AND r.retired_at IS NULL "
    "ORDER BY substr(t.value, 8), coalesce(r.prio, 5), r.created_at"
)
#: The prod read never holds the SessionStart hook longer than this.
_THREAD_GRIPES_TIMEOUT_S = 5


def thread_gripes(root: Path) -> dict[str, list[str]] | str:
    """``{slug: ['gr12 (P5) title', ...]}`` for open gripes tagged
    ``thread:<slug>``, read from prod via ``scripts/prod-psql --ro``, or a
    one-line reason it is unavailable. Best-effort: off with
    ``PRECIS_DOCS_INDEX_GRIPES=0`` and under CI; an outage, a missing prod
    overlay or a timeout returns the reason, never raises."""
    if os.environ.get("PRECIS_DOCS_INDEX_GRIPES") == "0":
        return "off (PRECIS_DOCS_INDEX_GRIPES=0)"
    if os.environ.get("CI"):
        return "off under CI"
    env = {**os.environ, "PRECIS_PROD_PSQL_OPTS": "-At"}
    try:
        cp = subprocess.run(
            [str(root / "scripts/prod-psql"), "--ro", _THREAD_GRIPES_SQL],
            capture_output=True,
            text=True,
            encoding="utf-8",
            timeout=_THREAD_GRIPES_TIMEOUT_S,
            env=env,
            check=False,
        )
    except subprocess.TimeoutExpired:
        return f"unavailable (prod read timed out after {_THREAD_GRIPES_TIMEOUT_S}s)"
    except OSError as error:
        return f"unavailable ({error.__class__.__name__})"
    if cp.returncode != 0:
        tail = (cp.stderr.strip().splitlines() or ["no stderr"])[-1][:120]
        return f"unavailable (prod-psql exit {cp.returncode}: {tail})"
    out: dict[str, list[str]] = {}
    for line in cp.stdout.splitlines():
        parts = line.split("\x1f")
        if len(parts) != 4:
            continue
        slug, ref_id, prio, title = parts
        out.setdefault(slug, []).append(f"gr{ref_id} (P{prio}) {title}")
    return out


def render_thread_gripes(root: Path, gripes: dict[str, list[str]] | str) -> list[str]:
    """The generated ``## Gripes in each thread`` section of PRIORITIES.md."""
    rows = [
        "",
        "## Gripes in each thread",
        "",
        "Open gripes tagged `thread:<slug>`, read from prod when this file "
        "was generated. Tag a gripe to list it here.",
        "",
    ]
    if isinstance(gripes, str):
        return [*rows, f"Gripe list {gripes}."]
    slugs = sorted(
        p.stem
        for p in (root / "docs/backlog/threads").glob("*.md")
        if p.name not in ("README.md", "INDEX.md", "PRIORITIES.md")
    )
    for slug in slugs:
        items = gripes.get(slug, [])
        rows.append(f"- **{slug}** ({len(items)}): " + ("; ".join(items) or "none"))
    unknown = sorted(set(gripes) - set(slugs))
    if unknown:
        rows.append(f"- tagged with no thread file: {', '.join(unknown)}")
    return rows


def main() -> int:
    if "--lint" in sys.argv[1:]:
        problems = lint_docstrings()
        for line in problems:
            print(f"docs-index: {line}", file=sys.stderr)
        return 1 if problems else 0
    changed = []
    try:
        priorities = thread_priorities(ROOT)
    except ValueError as error:
        print(f"docs-index: {error}", file=sys.stderr)
        return 1
    priorities += render_thread_gripes(ROOT, thread_gripes(ROOT))
    if write_generated(
        ROOT / "docs/backlog/threads/PRIORITIES.md", "Thread priorities", priorities
    ):
        changed.append("docs/backlog/threads/PRIORITIES.md")
    backlog = ROOT / "docs" / "backlog"
    if backlog.is_dir() and write_generated(
        backlog / "INDEX.md", "Backlog index", md_index(backlog, with_status=True)
    ):
        changed.append("docs/backlog/INDEX.md")
    runbooks = ROOT / "docs" / "runbooks"
    if runbooks.is_dir() and write_generated(
        runbooks / "INDEX.md", "Runbook index", md_index(runbooks, with_status=False)
    ):
        changed.append("docs/runbooks/INDEX.md")
    if write_generated(ROOT / "docs" / "codebase-map.md", "Package map", package_map()):
        changed.append("docs/codebase-map.md")
    start_page = ROOT / START_PAGE_TARGET
    try:
        new_start_page = start_page_text(ROOT)
    except OSError as error:
        # A missing skill source must not take the other four files down.
        print(f"docs-index: start page skipped ({error})", file=sys.stderr)
    else:
        if write_generated_text(start_page, new_start_page):
            changed.append(START_PAGE_TARGET)
    for c in changed:
        print(f"→ {c}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env python3
"""scripts/docs-index — regenerate the generated index blocks in docs.

Three surfaces, one script, run by `scripts/ship` before the WIP commit
(same pattern as the Tailwind prebuild: derived artifacts regenerate at
ship time; never hand-edit inside the markers).

  docs/backlog/README.md   one line per work item: slug — status — summary
  docs/runbooks/README.md  one line per runbook: slug — summary
  docs/codebase.md         package map: import path — docstring first line

The summary for a markdown file is its first non-heading, non-front-matter
prose line; `status:` is read from front-matter (backlog only, defaults to
`idea`). The package map walks src/*/**/__init__.py and takes each module
docstring's first line (PEP 257) — a package without a docstring is listed
as such, which is the nudge to write one.

Blocks are rewritten between `<!-- docs-index:begin -->` and
`<!-- docs-index:end -->` markers; a README that doesn't exist yet is
created with just the markers. Idempotent; exits non-zero only on I/O
errors, never on content.
"""

from __future__ import annotations

import re
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
BEGIN, END = "<!-- docs-index:begin -->", "<!-- docs-index:end -->"


def front_matter(text: str) -> tuple[dict[str, str], str]:
    """Parse a simple `key: value` front-matter block; return (fm, body)."""
    if not text.startswith("---\n"):
        return {}, text
    end = text.find("\n---", 4)
    if end < 0:
        return {}, text
    fm: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" in line:
            k, _, v = line.partition(":")
            fm[k.strip()] = v.strip()
    return fm, text[end + 4 :]


def summary_line(body: str) -> str:
    """First non-heading, non-blockquote prose line, tidied."""
    for line in body.splitlines():
        s = line.strip()
        if s and not s.startswith(("#", ">", "---", "<!--", "|", "```", "-")):
            return re.sub(r"\s+", " ", s)
    return ""


def md_index(directory: Path, with_status: bool) -> list[str]:
    rows = []
    for f in sorted(directory.glob("*.md")):
        if f.name in ("README.md", "TEMPLATE.md"):
            continue
        fm, body = front_matter(f.read_text(encoding="utf-8"))
        summary = fm.get("summary") or summary_line(body)
        if with_status:
            status = fm.get("status", "idea")
            rows.append(f"- [`{f.stem}`](./{f.name}) **{status}** — {summary}")
        else:
            rows.append(f"- [`{f.stem}`](./{f.name}) — {summary}")
    return rows


def docstring_first_line(init: Path) -> str | None:
    """First line of the module docstring, or None if absent."""
    text = init.read_text(encoding="utf-8", errors="replace")
    m = re.match(r'\s*(?:#[^\n]*\n\s*)*("""|\'\'\')(.*?)\1', text, re.DOTALL)
    if not m:
        return None
    first = m.group(2).strip().splitlines()
    return re.sub(r"\s+", " ", first[0]).strip() if first else None


def package_map() -> list[str]:
    rows = []
    for init in (ROOT / "src").glob("**/__init__.py"):
        rel = init.relative_to(ROOT / "src").parent
        if any(p.startswith((".", "_")) or p == "__pycache__" for p in rel.parts):
            continue
        if "data" in rel.parts[:-1]:  # resource dirs under a data/ package
            continue
        mod = ".".join(rel.parts)
        line = docstring_first_line(init)
        rows.append(f"- `{mod}` — {line or '*(no package docstring yet)*'}")
    return sorted(rows)


def splice(target: Path, rows: list[str], title: str) -> bool:
    block = "\n".join([BEGIN, "", *rows, "", END])
    if target.exists():
        text = target.read_text(encoding="utf-8")
        if BEGIN in text and END in text:
            pre, _, rest = text.partition(BEGIN)
            _, _, post = rest.partition(END)
            new = pre + block + post
        else:
            new = text.rstrip() + "\n\n" + block + "\n"
        if text == new:
            return False
    else:
        new = f"# {title}\n\n{block}\n"
    target.write_text(new, encoding="utf-8")
    return True


def main() -> int:
    changed = []
    backlog = ROOT / "docs" / "backlog"
    if backlog.is_dir() and splice(
        backlog / "README.md", md_index(backlog, with_status=True), "Backlog"
    ):
        changed.append("docs/backlog/README.md")
    runbooks = ROOT / "docs" / "runbooks"
    if runbooks.is_dir() and splice(
        runbooks / "README.md", md_index(runbooks, with_status=False), "Runbooks"
    ):
        changed.append("docs/runbooks/README.md")
    codebase = ROOT / "docs" / "codebase.md"
    if codebase.exists() and BEGIN in codebase.read_text(encoding="utf-8"):
        if splice(codebase, package_map(), "Codebase"):
            changed.append("docs/codebase.md")
    for c in changed:
        print(f"→ {c}")
    return 0


if __name__ == "__main__":
    sys.exit(main())

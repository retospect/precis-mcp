#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/board — the fleet status board: routine one-line status posts.

Routine status (landed, red, waiting, done) goes on the board — a line
costs nothing and wakes nobody. SendMessage stays for things that need
action NOW (gr515152): every message wakes a whole session at full
context. The coordinator reads the board each sweep instead of polling
panes.

  scripts/board post <window> [--state S] <one line>
  scripts/board read [--since <ts>] [-n N]
  scripts/board read --new --as <reader>   only what that reader hasn't seen
  scripts/board watch [-n N]               live view for a tmux window
  scripts/board clear                      empty the board

The board is one append-only file, <main checkout>/.claude/fleet/board.log
(gitignored). It is resolved through the common git dir, so every worktree
of this checkout posts to the same board. PRECIS_BOARD overrides the path
(tests). Each line: <UTC ISO Z>\\t<window>\\t<text>. post takes an exclusive
flock and writes the whole line in one call — a burst of builders cannot
interleave a line.

A status line's text is `<state> <sha?> <gripe ids?> <short note>`, state
one of landed|red|green|done|waiting|blocked|wedged — `post --state`
validates and puts it first. Without --state the text is free-form (old
lines read fine). A posted line over 120 chars is refused: shorten it and
put the detail in a handoff or gripe.

`read --new --as <reader>` prints only lines after that reader's cursor
in .claude/fleet/board.cursor.<reader> (a byte offset, gitignored) and
then advances it to EOF; a cursor past EOF (rotation, clear) resets to 0
with a note on stderr. `read` without --new prints everything.

`watch` follows the log (tail -f semantics), one aligned line per post
(time, poster, state, note), coloured by leading state: landed/green →
green, red/wedged → red, blocked/waiting → yellow, done → cyan, anything
else default. NO_COLOR disables colour; Ctrl-C exits cleanly.
"""

from __future__ import annotations

import argparse
import fcntl
import os
import re
import subprocess
import sys
import time
from datetime import UTC, datetime
from pathlib import Path

STATES = ("landed", "red", "green", "done", "waiting", "blocked", "wedged")
MAX_LINE = 120

_STATE_COLOR = {
    "landed": "32",
    "green": "32",
    "red": "31",
    "wedged": "31",
    "blocked": "33",
    "waiting": "33",
    "done": "36",
}


def _git(*args: str) -> str | None:
    try:
        cp = subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            encoding="utf-8",
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return cp.stdout.strip() if cp.returncode == 0 else None


def _board_path() -> Path:
    override = os.environ.get("PRECIS_BOARD", "").strip()
    if override:
        return Path(override)
    common = _git("rev-parse", "--path-format=absolute", "--git-common-dir")
    if not common:
        sys.exit("scripts/board: not inside a git checkout")
    return Path(common.strip()).parent / ".claude" / "fleet" / "board.log"


def _cursor_path(reader: str) -> Path:
    name = re.sub(r"[^A-Za-z0-9._-]+", "_", _tsv(reader)).lstrip(".")
    if not name:
        sys.exit("scripts/board: --as needs a usable reader name")
    return _board_path().parent / f"board.cursor.{name}"


def _now() -> str:
    return datetime.now(UTC).strftime("%Y-%m-%dT%H:%M:%SZ")


def _tsv(text: str) -> str:
    """One field: tabs and newlines would break the line format."""
    return " ".join(text.split())


def cmd_post(a: argparse.Namespace) -> int:
    text = _tsv(" ".join(a.text))
    if a.state:
        text = f"{a.state} {text}".rstrip()
    if not text:
        print("scripts/board: post needs a non-empty line", file=sys.stderr)
        return 2
    line = f"{_now()}\t{_tsv(a.window)}\t{text}\n"
    if len(line) - 1 > MAX_LINE:
        print(
            f"scripts/board: post line is {len(line) - 1} chars (max {MAX_LINE}) "
            "— shorten it; put the detail in a handoff or gripe",
            file=sys.stderr,
        )
        return 2
    path = _board_path()
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("a", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.write(line)
        fh.flush()
    print(line, end="")
    return 0


def _unread(path: Path, cursor: Path) -> list[str]:
    try:
        pos = int(cursor.read_text(encoding="utf-8").strip())
    except (OSError, ValueError):
        pos = 0
    try:
        data = path.read_bytes()
    except OSError:
        data = b""
    if pos > len(data):
        print(
            "scripts/board: cursor past EOF (log rotated or truncated) "
            "— resetting to the top",
            file=sys.stderr,
        )
        pos = 0
    try:
        cursor.parent.mkdir(parents=True, exist_ok=True)
        cursor.write_text(str(len(data)), encoding="utf-8")
    except OSError:
        pass
    return data[pos:].decode("utf-8", "replace").splitlines()


def cmd_read(a: argparse.Namespace) -> int:
    if a.new:
        if not a.reader:
            print("scripts/board: read --new needs --as <reader>", file=sys.stderr)
            return 2
        lines = _unread(_board_path(), _cursor_path(a.reader))
    else:
        try:
            lines = _board_path().read_text(encoding="utf-8").splitlines()
        except OSError:
            lines = []
    since = a.since.strip()
    if since:
        lines = [ln for ln in lines if ln.split("\t", 1)[0] >= since]
    if a.number is not None:
        lines = lines[-a.number :] if a.number > 0 else []
    for ln in lines:
        print(ln)
    return 0


def format_line(line: str, *, color: bool) -> str:
    """One board line → aligned watch row: time  poster  state  note."""
    parts = line.rstrip("\n").split("\t", 2)
    if len(parts) < 3:
        return line.rstrip("\n")
    ts, poster, text = parts
    words = text.split(None, 1)
    state = words[0] if words and words[0] in STATES else ""
    rest = (words[1] if len(words) > 1 else "") if state else text
    clock = ts[11:19] if len(ts) >= 19 else ts
    out = f"{clock}  {poster:<14.14}  {state:<7}  {rest}"
    code = _STATE_COLOR.get(state, "")
    return f"\x1b[{code}m{out}\x1b[0m" if color and code else out


def _watch_emit(data: bytes, color: bool) -> None:
    for raw in data.splitlines():
        sys.stdout.write(
            format_line(raw.decode("utf-8", "replace"), color=color) + "\n"
        )
    sys.stdout.flush()


def cmd_watch(a: argparse.Namespace) -> int:
    color = sys.stdout.isatty() and "NO_COLOR" not in os.environ
    path = _board_path()
    pos = -1  # -1: history not yet printed for the current file generation
    try:
        while True:
            try:
                size = path.stat().st_size
            except OSError:
                pos = -1
                time.sleep(0.4)
                continue
            if pos < 0:
                lines = path.read_bytes().splitlines()
                tail = b"\n".join(lines[-a.tail :] if a.tail > 0 else [])
                _watch_emit(tail + b"\n" if tail else b"", color)
                pos = size
            elif pos > size:
                pos = -1  # rotated or cleared: show the new tail
            elif pos < size:
                with path.open("rb") as fh:
                    fh.seek(pos)
                    data = fh.read()
                if data.endswith(b"\n"):
                    pos = size
                else:  # partial write in flight: hold the incomplete tail
                    cut = data.rfind(b"\n") + 1
                    pos += cut
                    data = data[:cut]
                _watch_emit(data, color)
            time.sleep(0.4)
    except KeyboardInterrupt:
        return 0


def cmd_clear(a: argparse.Namespace) -> int:
    path = _board_path()
    n = 0
    try:
        n = len(path.read_text(encoding="utf-8").splitlines())
    except OSError:
        pass
    path.parent.mkdir(parents=True, exist_ok=True)
    with path.open("w", encoding="utf-8") as fh:
        fcntl.flock(fh, fcntl.LOCK_EX)
        fh.truncate()
    print(f"board cleared ({n} line{'s' if n != 1 else ''} dropped)")
    return 0


def parser() -> argparse.ArgumentParser:
    p = argparse.ArgumentParser(
        prog="board",
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    s = sub.add_parser(
        "post",
        help="append one status line",
        epilog="line format: <state> <sha?> <gripe ids?> <short note> — state one of "
        + "|".join(STATES)
        + ". --state validates and puts it first; without it the text is free-form.",
    )
    s.add_argument("window", help="your window or tree name")
    s.add_argument(
        "--state",
        choices=STATES,
        help="status keyword, written first in the line",
    )
    s.add_argument("text", nargs="*", help="the one-line status")
    s.set_defaults(fn=cmd_post)

    s = sub.add_parser("read", help="print board lines")
    s.add_argument(
        "--since",
        default="",
        metavar="TS",
        help="only lines stamped at/after TS (ISO prefix compare)",
    )
    s.add_argument(
        "-n",
        dest="number",
        type=int,
        metavar="N",
        help="only the last N lines",
    )
    s.add_argument(
        "--new",
        action="store_true",
        help="only lines after --as reader's cursor; advances the cursor",
    )
    s.add_argument(
        "--as",
        dest="reader",
        metavar="READER",
        help="reader name for --new (cursor: board.cursor.<reader>)",
    )
    s.set_defaults(fn=cmd_read)

    s = sub.add_parser("watch", help="live view: follow the board, coloured by state")
    s.add_argument(
        "-n",
        "--tail",
        type=int,
        default=20,
        metavar="N",
        help="print the last N lines before following (default 20)",
    )
    s.set_defaults(fn=cmd_watch)

    sub.add_parser("clear", help="empty the board").set_defaults(fn=cmd_clear)
    return p


def main(argv: list[str] | None = None) -> int:
    a = parser().parse_args(argv)
    return int(a.fn(a))


if __name__ == "__main__":
    sys.exit(main())

#!/usr/bin/env bash
# scripts/reap-test-dbs — SessionStart sweep that removes per-worktree
# `precis-test-*` compose projects whose worktree no longer exists.
#
# The leak this closes: teardown already exists and is correct —
# scripts/hooks/session-end-reap.sh (the primary) and scripts/reap-worktrees
# (its SessionStart backstop) both `down -v` the project as they remove a
# tree. But both are COUPLED TO A REMOVAL PATH they control. Every other way
# a worktree dies — the ExitWorktree tool, the housekeeper agent, a hand-run
# `git worktree remove`, an `rm -rf` + prune, or either reaper's own
# best-effort `docker compose down` failing transiently
# (it is `|| true`) — takes the tree and strands the Postgres. And because the
# teardown only ever fires at the instant of removal, a miss is PERMANENT:
# nothing reconciles afterwards. Stranded test DBs are not free — each is a
# live postgres on the 8GB colima VM, and that contention is the documented
# cause of the silent gate OOM-137 reds (see auto-memory `gate-oom-silent-death`,
# gr176231).
#
# Chasing each removal path with its own hook is open-ended. This is
# state-based instead: it asks "does this project's worktree still exist?" and
# converges, whatever removed the tree.
#
# How orphan-ness is decided: compose already stamps every container with
#     com.docker.compose.project.config_files
#       = <worktree>/docker/dev/compose.yaml
# so the worktree path is a FACT READ OFF THE CONTAINER, not inferred from the
# project name. That matters — `compose_project_for` (scripts/lib/
# compose-project.sh) sanitises the basename and is deliberately not
# injective, so a project name cannot be mapped back to a path at all.
# Reading the label also makes this robust across clones: a second checkout's
# projects carry their own root and are judged on their own terms.
#
# Safety: a tree that still EXISTS is never REMOVED by this sweep — the
# criterion is absence of the bind-mount source, and a gate cannot run
# without it. Present-tree projects are handed to the idle-stack stop pass
# below (gr544054), which only ever `compose stop`s them: containers, db
# and volumes survive, so a parked session's stack is back one `compose
# up` later. That pass needs a liveness judgment — but a cheap one (run
# markers, the ship lock, execs and mtimes), not scripts/inflight.
#
# A live SubagentStart marker suppresses the sweeps FOR THE TREE IT SCOPES TO
# (gr513859): an isolation worktree can disappear while its task falls back to
# the parent tree, so a missing mount path alone is not proof the task has
# ended — but a task in some other tree must not freeze the whole run either.
#
# Network-only sweep (gr311857): the container-label reconciliation above
# needs a container to read the worktree path off. A project that never has
# one left (a bare `docker network create`, or the last container gone via
# some path other than `down -v`) leaves an orphaned `precis-test-*_default`
# network sitting on the Docker daemon's address-pool ceiling forever — the
# structural cause of gr311857 (fresh worktrees locked out of minting their
# first network once the fleet's pool fills up). Since a network carries no
# path label to reconcile against, that half instead asks the inverse
# question — "does any CURRENT git worktree still mint this project name?" —
# via the same `compose_project_for` every caller uses, so it can never
# disagree with what scripts/test/scripts/dev/scripts/ship would create next.
#
# Note on volumes: docker/dev/compose.yaml declares no named volumes (pgdata
# lives on the container overlay), so `down -v` is belt-and-braces — there is
# no dangling-volume population for this to miss.
#
# Abandoned-but-present carve-out (gr331378): both sweeps above are still
# COUPLED TO A REMOVAL PATH — the worktree DIRECTORY has to be gone. But
# `scripts/inflight`'s VS-MAIN bucketing has its own gap (a worktree with
# several local commits whose cumulative diff was squash-merged as ONE
# commit on main gets stuck `has_unmerged_work` forever — per-commit
# patch-id matching never sees it), so a genuinely-abandoned subagent
# worktree can sit there, directory intact, never reaped, its
# `precis-test-<name>` project's db container running for days. This third
# pass reaps a project whose worktree is STILL PRESENT, but only when ALL
# of the following hold, each independently conservative:
#   1. no active subagent task marker scoped to THIS tree in the shared git
#      directory (markers are per-worktree — gr513174).
#   2. no live session lock on the worktree — read off the exact `session`
#      field `scripts/inflight --json` already computes.
#   3. `.claude/purpose` is absent or older than
#      PRECIS_REAP_DB_PURPOSE_FRESH_SECONDS (default 6h) — same tripwire
#      `scripts/reap-worktrees` uses for the analogous worktree-removal case.
#   4. the project has no RUNNING container other than the test-db service
#      (a `precis-gate` or `run --rm` container means a gate is actually
#      in flight right now — never touch that).
#   5. the test-db container itself has been running for at least
#      PRECIS_REAP_DB_MIN_AGE_SECONDS (default 48h) — a fresh test-db is
#      almost certainly mid-use; a multi-day-old one with nothing else
#      running and no recent purpose is not. An `agent-*` worktree uses
#      PRECIS_REAP_AGENT_DB_MIN_AGE_SECONDS (default 2h) instead.
#      2026-10-03 ~14:40Z: 7 idle agent test-dbs 3-27 h old held
#      enough compose networks that docker ran out of address pools ("all
#      predefined address pools have been fully subnetted") and every
#      scripts/test in the fleet failed before its first test.
#      scripts/test now tears an agent tree's project down itself at exit
#      (unless PRECIS_TEST_KEEP_DB=1), so this 2 h reap is the backstop.
# All five together are meant to be far more conservative than "would
# scripts/inflight call this safe_remove" — this sweep never removes the
# worktree itself, only its docker footprint, so a false negative (leaving a
# leaked project alone) is free while a false positive (downing an
# in-progress session's db) is not. Skips outright if `scripts/inflight` is
# missing/non-executable: no session-liveness signal, no reap.
#
# Idle gate-stack stop (gr544054): scripts/ship leaves a warm precis-gate
# (`sleep infinity`) and the co-located precis-test-db RUNNING in the tree's
# project after the gate finishes, and nothing above can touch them — the
# tree exists, the session may even be live, only the WORK has gone quiet.
# On 2026-10-31 ~139 such projects held ~70 GB and hundreds of live
# processes. The stop pass below `compose stop`s a present-tree project
# whose every signal says idle for PRECIS_REAP_IDLE_STACK_SECONDS (default
# 2h) — never down/-v, so the db and gate-cache volume survive. Because a
# stopped db-only project no longer shows up in `docker ps`, the
# abandoned-but-present sweep reads `ps -a` and takes such a project by
# container age regardless of state.
#
# Build cache: also prunes BuildKit's cache to PRECIS_BUILD_CACHE_KEEP_GB (30)
# at most hourly — see prune_build_cache below.
#
# Escape hatch: PRECIS_NO_AUTOREAP=1 → no-op (shared with reap-worktrees).
# Usage: scripts/reap-test-dbs [--dry-run] [--for-hook]
#
# Wired in .claude/settings.json (SessionStart), after `reap-worktrees` — so
# the eager teardown gets first refusal and this only sees what it missed.
set -uo pipefail

[ -n "${PRECIS_NO_AUTOREAP:-}" ] && exit 0

DRY_RUN=0
FOR_HOOK=0
for a in "$@"; do
    case "$a" in
        --dry-run) DRY_RUN=1 ;;
        # gr499042: SessionStart output is carried every turn — a reaper that
        # found nothing prints nothing under --for-hook.
        --for-hook) FOR_HOOK=1 ;;
    esac
done

command -v docker >/dev/null 2>&1 || exit 0
# A stopped colima / unreachable daemon must never make a SessionStart hook
# noisy or slow — `docker ps` blocks on the socket, so bail on any failure.
docker ps -a --format '{{.Names}}' >/dev/null 2>&1 || exit 0

ROOT="$(cd "$(dirname "$0")/.." 2>/dev/null && pwd -P || true)"
TASK_HELPER="$ROOT/scripts/hooks/subagent-task-state.py"
active_task_id=""
# subagent_task_clear <worktree-path> — true (0) when no live task marker is
# scoped to THAT tree (gr513859: the old whole-run `check "$ROOT"` kept every
# project whenever the tree the reaper ran from had any task at all). $ROOT
# goes along as the repo context, so the check still finds the shared state
# dir when <worktree-path> itself is already gone.
subagent_task_clear() {
    [ -f "$TASK_HELPER" ] || return 0
    local task_id task_rc
    task_id="$(python3 "$TASK_HELPER" check "$1" "$ROOT" 2>/dev/null)"
    task_rc=$?
    if [ "$task_rc" -eq 1 ]; then
        active_task_id=""
        return 0
    fi
    active_task_id="${task_id:-unknown}"
    return 1
}

REAPED=()
STOPPED=()
SEEN=""
PRESENT=""

while IFS='|' read -r proj cfg; do
    [ -z "$proj" ] && continue
    case "$proj" in
        precis-test-*) ;;
        *) continue ;;
    esac
    # One project has many containers (db + each `run --rm` that outlived its
    # exit); judge each project once.
    case " $SEEN " in *" $proj "*) continue ;; esac
    SEEN="$SEEN $proj"

    # config_files is comma-separated when compose was given several -f flags;
    # the dev loop passes exactly one, and the first is the anchor either way.
    cfg="${cfg%%,*}"
    [ -z "$cfg" ] && continue

    # Derive the worktree root by stripping the known suffix. If the label does
    # not end in it, the project came from some other layout — leave it alone
    # rather than guess at a path we would then delete on.
    root="${cfg%/docker/dev/compose.yaml}"
    [ "$root" = "$cfg" ] && continue
    # Refuse to act on a degenerate root: `[ -d / ]` is true so it would be
    # kept, but an empty one would test false and reap. Guard explicitly.
    [ -z "$root" ] && continue

    if [ -d "$root" ]; then
        # Tree still there — not this sweep's business. It goes on the
        # idle-stack list judged after the removal passes (gr544054).
        PRESENT="${PRESENT}${proj}|${root}
"
        continue
    fi

    if ! subagent_task_clear "$root"; then
        [ "$FOR_HOOK" = 1 ] || echo "reap-test-dbs: active subagent task $active_task_id — keeping $proj"
        continue
    fi
    if [ "$DRY_RUN" = 1 ]; then
        REAPED+=("$proj")
        continue
    fi
    # `down -p <name>` finds the project by label, so no compose file is
    # needed — which is the point, the file went with the tree. Best-effort:
    # a concurrent session reaping the same project, or a half-removed one,
    # must never fail the hook.
    if env UID="$(id -u)" GID="$(id -g)" \
        docker compose -p "$proj" down -v >/dev/null 2>&1; then
        REAPED+=("$proj")
    fi
done < <(docker ps -a --format \
    '{{.Label "com.docker.compose.project"}}|{{.Label "com.docker.compose.project.config_files"}}' \
    2>/dev/null)

# Network-only sweep (gr311857): `docker compose up -d` mints the project's
# ONE network for its whole lifetime, but a `run --rm` container (scripts/
# test's/scripts/dev's test/tool invocations) never sticks around, and even
# the persistent `precis-test-db` container can go missing without the
# network following it (a half-finished `compose down`, a manual `docker rm`,
# `docker container prune`, …). Those networks are invisible to the
# container-label sweep above (SEEN only ever holds projects that still have
# AT LEAST ONE container) — and they still count against the Docker daemon's
# address-pool ceiling (gr311857: observed pegged at the ~32-network cap,
# starving new worktrees of their first network). So: also look at bare
# networks and, for any `precis-test-*` project with NO container at all
# (not in SEEN), tear it down UNLESS a currently-existing git worktree would
# still mint that exact project name — computed the same way scripts/test/
# scripts/dev/scripts/ship do, via compose_project_for, never by trying to
# invert the (deliberately non-injective) project name back into a path.
# Best-effort throughout: a missing git/compose-project.sh, or a `docker
# network rm` racing a concurrent reaper, must never fail this hook.
if [ -n "$ROOT" ] && [ -f "$ROOT/scripts/lib/compose-project.sh" ] \
    && git -C "$ROOT" rev-parse --git-dir >/dev/null 2>&1; then
    source "$ROOT/scripts/lib/compose-project.sh"
    LIVE_PROJECTS=""
    while IFS= read -r wt_path; do
        [ -z "$wt_path" ] && continue
        p="$(compose_project_for "$wt_path" 2>/dev/null || true)"
        [ -n "$p" ] && LIVE_PROJECTS="$LIVE_PROJECTS $p"
    done < <(git -C "$ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')

    # Live task markers also protect bare networks: the tree a marker
    # scopes to can be gone already (the task fell back to the parent), so
    # it is not in LIVE_PROJECTS — compose each marker's cwd forward into
    # the project name it minted instead (gr513859).
    TASK_PROJECTS=""
    if [ -f "$TASK_HELPER" ]; then
        while IFS=$'\t' read -r _mtid _mcwd _mpid; do
            [ -z "${_mcwd:-}" ] && continue
            _mproj="$(compose_project_for "$_mcwd" 2>/dev/null || true)"
            [ -n "$_mproj" ] && TASK_PROJECTS="$TASK_PROJECTS $_mproj"
        done < <(python3 "$TASK_HELPER" list "$ROOT" 2>/dev/null || true)
    fi

    while IFS='|' read -r net proj; do
        [ -z "$net" ] && continue
        case "$proj" in
            precis-test-*) ;;
            *) continue ;;
        esac
        case " $SEEN " in *" $proj "*) continue ;; esac   # has a container — handled above
        case " $LIVE_PROJECTS " in *" $proj "*) continue ;; esac   # a live worktree still owns this name
        case " $TASK_PROJECTS " in *" $proj "*)
            # A live task marker scopes to a (possibly gone) tree that
            # minted this name — same protection the label sweep's
            # per-path `check` gives, composed forwards since a project
            # name cannot be inverted back to a path.
            [ "$FOR_HOOK" = 1 ] || echo "reap-test-dbs: active subagent task — keeping $net"
            continue
            ;;
        esac
        if [ "$DRY_RUN" = 1 ]; then
            REAPED+=("$net")
            continue
        fi
        if docker network rm "$net" >/dev/null 2>&1; then
            REAPED+=("$net")
        fi
    done < <(docker network ls --format '{{.Name}}|{{.Label "com.docker.compose.project"}}' 2>/dev/null)

    # Abandoned-but-present sweep (gr331378) — see the header comment for the
    # four-way guard this implements. Only reachable when the block above's
    # own preconditions held (ROOT resolved, compose-project.sh sourced, a
    # readable git repo) — folded into the same `if`, and additionally gated
    # on `scripts/inflight` existing, since criterion 1 reads its `session`
    # field verbatim and there is no safe way to guess sessionlessness
    # without it.
    # SEEN empty means no precis-test-* project has any container, so no
    # worktree below can pass the `proj in SEEN` gate — skip the sweep AND
    # the fleet-wide inflight --json scan it pays for (gr541365).
    if [ -x "$ROOT/scripts/inflight" ] && [ -n "$SEEN" ]; then
        DB_MIN_AGE_SECONDS="${PRECIS_REAP_DB_MIN_AGE_SECONDS:-172800}"        # 48h
        AGENT_DB_MIN_AGE_SECONDS="${PRECIS_REAP_AGENT_DB_MIN_AGE_SECONDS:-7200}"  # 2h
        DB_PURPOSE_FRESH_SECONDS="${PRECIS_REAP_DB_PURPOSE_FRESH_SECONDS:-21600}"  # 6h
        PRIMARY_WT="$(git -C "$ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')"
        # Only the per-worktree `session` field is read below — under
        # --for-hook the branchless-branch verdict work (a git cherry /
        # merge-tree per stranded pin) is wasted spend (gr541365).
        INFLIGHT_ARGS=(--json)
        [ "$FOR_HOOK" = 1 ] && INFLIGHT_ARGS+=(--skip-branch-probes)
        # The `session` field guards a destructive stop, so a shared scan may
        # be at most 10 s old here (default 45): a lock taken by a session that
        # started just before this one is still seen, yet a burst of starts
        # still coalesces onto one scan.
        INFLIGHT_JSON="$(INFLIGHT_CACHE_TTL=10 "$ROOT/scripts/inflight" "${INFLIGHT_ARGS[@]}" 2>/dev/null || true)"

        # session_for <path> — the exact `session` field scripts/inflight
        # --json computed for <path> (live#<pid> / dead-lock#<pid> / locked /
        # —), empty if the worktree isn't in the blob at all.
        session_for() {
            [ -z "$INFLIGHT_JSON" ] && return 0
            printf '%s' "$INFLIGHT_JSON" | TARGET="$1" python3 -c '
import json, os, sys
try:
    data = json.load(sys.stdin)
except ValueError:
    sys.exit(0)
target = os.path.realpath(os.environ["TARGET"])
for wt in data.get("worktrees", []):
    if os.path.realpath(wt.get("path", "")) == target:
        print(wt.get("session", ""))
        break
'
        }

        # stale_or_absent_purpose <path> — true (0) when <path>/.claude/purpose
        # is missing or its mtime is at least DB_PURPOSE_FRESH_SECONDS old.
        stale_or_absent_purpose() {
            python3 - "$1/.claude/purpose" "$DB_PURPOSE_FRESH_SECONDS" <<'PY'
import os
import sys
import time

pf, threshold = sys.argv[1], float(sys.argv[2])
try:
    age = time.time() - os.path.getmtime(pf)
except OSError:
    sys.exit(0)  # no purpose file at all -> counts as stale
sys.exit(0 if age >= threshold else 1)
PY
        }

        # container_old_enough <container-id> <seconds> — true (0) when the
        # container's `Created` timestamp is at least <seconds> old.
        container_old_enough() {
            local cid=$1 min_age=$2 created
            created="$(docker inspect -f '{{.Created}}' "$cid" 2>/dev/null)" || return 1
            [ -z "$created" ] && return 1
            python3 - "$created" "$min_age" <<'PY'
import datetime
import sys

ts, threshold = sys.argv[1], float(sys.argv[2])
ts = ts.strip()
if ts.endswith("Z"):
    ts = ts[:-1]
ts = ts.split(".")[0]  # drop fractional seconds; keeps this parseable pre-3.11 too
try:
    created = datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S").replace(
        tzinfo=datetime.timezone.utc
    )
except ValueError:
    sys.exit(1)
age = (datetime.datetime.now(datetime.timezone.utc) - created).total_seconds()
sys.exit(0 if age >= threshold else 1)
PY
        }

        while IFS= read -r wt_path; do
            [ -z "$wt_path" ] && continue
            [ "$wt_path" = "$PRIMARY_WT" ] && continue
            [ -d "$wt_path" ] || continue   # gone already -- the label sweep above owns that case

            proj="$(compose_project_for "$wt_path" 2>/dev/null || true)"
            case "$proj" in precis-test-*) ;; *) continue ;; esac
            # Only a project that already has a container (SEEN, from the
            # label sweep above) has a db container to judge an age against.
            case " $SEEN " in *" $proj "*) ;; *) continue ;; esac

            # (1) no live session or subagent task owns this checkout.
            if ! subagent_task_clear "$wt_path"; then
                continue
            elif [ ! -f "$TASK_HELPER" ] && [[ "$(basename "$wt_path")" == agent-* ]]; then
                # An untracked harness agent has no reliable session lock.
                continue
            fi

            # (2) no live session lock on the worktree.
            sess="$(session_for "$wt_path")"
            case "$sess" in live#*) continue ;; esac

            # (3) .claude/purpose absent or stale.
            stale_or_absent_purpose "$wt_path" || continue

            # (4) no RUNNING container in this project other than the
            # test-db service — a gate or `run --rm` container in flight
            # means real work is happening right now. Read `ps -a` (not
            # `ps`): a stack the idle-stop pass below stopped still has to
            # reach this `down -v` when it later qualifies, and a stopped
            # non-db container is no proof of work (gr544054).
            other_running=0
            db_cid=""
            while IFS='|' read -r cid svc cstate; do
                [ -z "$cid" ] && continue
                if [ "$svc" = "precis-test-db" ]; then
                    db_cid="$cid"
                elif [ "$cstate" = "running" ]; then
                    other_running=1
                fi
            done < <(docker ps -a --filter "label=com.docker.compose.project=$proj" \
                --format '{{.ID}}|{{.Label "com.docker.compose.service"}}|{{.State}}' 2>/dev/null)
            [ "$other_running" = 1 ] && continue
            [ -z "$db_cid" ] && continue   # no db container at all -- nothing to reap here

            # (5) the db container has been up at least DB_MIN_AGE_SECONDS
            # (AGENT_DB_MIN_AGE_SECONDS for a subagent's `agent-*` tree).
            min_age="$DB_MIN_AGE_SECONDS"
            case "$(basename "$wt_path")" in agent-*) min_age="$AGENT_DB_MIN_AGE_SECONDS" ;; esac
            container_old_enough "$db_cid" "$min_age" || continue

            if [ "$DRY_RUN" = 1 ]; then
                REAPED+=("$proj")
                continue
            fi
            if env UID="$(id -u)" GID="$(id -g)" \
                docker compose -p "$proj" down -v >/dev/null 2>&1; then
                REAPED+=("$proj")
            fi
        done < <(git -C "$ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2}')
    fi
fi

# Idle gate-stack stop (gr544054) — see the header comment for the why.
# PRESENT holds "<proj>|<tree>" for every precis-test-* project whose tree
# still exists, collected by the label sweep above. A project is `compose
# stop`ped — never down/-v, so its db, volumes and warm gate-cache survive
# for the next run — only when ALL of:
#   1. at least one container is RUNNING (an all-stopped project needs no
#      stop; the carve-out above owns its removal), and every running
#      container is the precis-test-db or precis-gate service — a live
#      `run --rm` pytest (precis-dev) or dev stack means work in flight;
#   2. no running container has an exec attached (a gate `compose exec` is
#      a gate actually running);
#   3. no live subagent task marker scopes to the tree;
#   4. the tree's git dir carries neither a live scripts/test run marker
#      ($gd/precis-test-runs/<pid>) nor a live scripts/ship worktree lock
#      ($gd/precis-ship-worktree.lock.d holder pid on THIS host) — a run
#      in its container-less phase (slot wait, lint, sync) is still a
#      live process and must hold its stack;
#   5. every readable activity signal — newest container StartedAt, the
#      git index/HEAD/reflog mtimes, .claude/purpose, the marker/lock
#      mtimes — is at least PRECIS_REAP_IDLE_STACK_SECONDS old (default
#      2h).
# The primary checkout is never touched (same rule as the carve-out). The
# liveness helpers come from scripts/lib/lock-holder.sh; without it there
# is no safe pid judgment, so the pass skips outright.
IDLE_STACK_SECONDS="${PRECIS_REAP_IDLE_STACK_SECONDS:-7200}"
case "$IDLE_STACK_SECONDS" in '' | *[!0-9]*) IDLE_STACK_SECONDS=7200 ;; esac

_stack_mtime() {  # <path> -> mtime epoch seconds, or nothing (GNU then BSD)
    stat -c %Y "$1" 2>/dev/null || stat -f %m "$1" 2>/dev/null
}

_stack_ts_epoch() {  # docker RFC3339 -> epoch seconds, or nothing
    python3 - "$1" <<'PY'
import datetime
import sys

ts = sys.argv[1].strip()
if ts.endswith("Z"):
    ts = ts[:-1]
ts = ts.split(".")[0]
try:
    print(int(datetime.datetime.strptime(ts, "%Y-%m-%dT%H:%M:%S")
              .replace(tzinfo=datetime.timezone.utc).timestamp()))
except ValueError:
    pass
PY
}

if [ -n "$PRESENT" ] && [ -f "$ROOT/scripts/lib/lock-holder.sh" ]; then
    # shellcheck source=scripts/lib/lock-holder.sh
    source "$ROOT/scripts/lib/lock-holder.sh"
    PRIMARY_WT="$(git -C "$ROOT" worktree list --porcelain 2>/dev/null \
        | awk '/^worktree /{print $2; exit}')"
    NOW_S="$(date +%s)"
    while IFS='|' read -r proj root; do
        [ -z "$proj" ] && continue
        [ -n "$PRIMARY_WT" ] && [ "$root" = "$PRIMARY_WT" ] && continue

        # (1) running services limited to the db/gate pair.
        running=0
        other_running=0
        pair_cids=""
        while IFS='|' read -r cid svc cstate; do
            [ -z "$cid" ] && continue
            [ "$cstate" = "running" ] || continue
            running=1
            case "$svc" in
                precis-test-db|precis-gate) pair_cids="$pair_cids $cid" ;;
                *) other_running=1 ;;
            esac
        done < <(docker ps -a --filter "label=com.docker.compose.project=$proj" \
            --format '{{.ID}}|{{.Label "com.docker.compose.service"}}|{{.State}}' \
            2>/dev/null)
        [ "$other_running" = 1 ] && continue
        [ "$running" = 0 ] && continue

        # (2) no exec in flight; newest StartedAt is the docker-side
        # activity signal.
        newest=0
        exec_live=0
        for cid in $pair_cids; do
            info="$(docker inspect -f \
                '{{.State.StartedAt}}|{{len .ExecIDs}}' "$cid" 2>/dev/null)"
            [ -n "$info" ] || continue
            case "${info##*|}" in '' | 0) ;; *) exec_live=1 ;; esac
            ep="$(_stack_ts_epoch "${info%%|*}")"
            [ -n "$ep" ] && [ "$ep" -gt "$newest" ] && newest="$ep"
        done
        [ "$exec_live" = 1 ] && continue

        # (3) a task marker scoped to this tree.
        subagent_task_clear "$root" || continue

        # (4) no live scripts/ship or scripts/test process for the tree.
        gd="$(git -C "$root" rev-parse --absolute-git-dir 2>/dev/null)"
        [ -n "$gd" ] && [ -d "$gd" ] || continue
        lockdir="$gd/precis-ship-worktree.lock.d"
        if [ -d "$lockdir" ]; then
            hpid="$(lock_holder_pid "$lockdir")"
            hhost="$(lock_holder_host "$lockdir")"
            if [ -n "$hhost" ] && [ "$hhost" != "$(lock_holder_hostname)" ]; then
                continue   # a ship on another host: its pid is unknowable here
            fi
            if [ -n "$hpid" ] && lock_pid_alive "$hpid"; then
                continue
            fi
        fi
        markerdir="$gd/precis-test-runs"
        if [ -d "$markerdir" ]; then
            live_marker=0
            for m in "$markerdir"/*; do
                [ -e "$m" ] || continue
                mp="${m##*/}"
                case "$mp" in '' | *[!0-9]*) continue ;; esac
                if lock_pid_alive "$mp"; then
                    live_marker=1
                    break
                fi
                # A dead marker is stale evidence, not cleanup business —
                # it stays (scripts/test's own scan removes it next run).
                # Removing it here would bump the dir mtime into "recent
                # activity" and delay the stop for no gain.
            done
            [ "$live_marker" = 1 ] && continue
        fi

        # (5) every signal older than the TTL.
        for p in "$gd/index" "$gd/HEAD" "$gd/logs/HEAD" \
            "$root/.claude/purpose" "$markerdir" "$lockdir"; do
            mt="$(_stack_mtime "$p")"
            [ -n "$mt" ] && [ "$mt" -gt "$newest" ] && newest="$mt"
        done
        idle=$((NOW_S - newest))
        [ "$idle" -lt "$IDLE_STACK_SECONDS" ] && continue

        if [ "$DRY_RUN" = 1 ]; then
            STOPPED+=("$proj")
            continue
        fi
        compose_file=()
        [ -f "$root/docker/dev/compose.yaml" ] && \
            compose_file=(-f "$root/docker/dev/compose.yaml")
        if env UID="$(id -u)" GID="$(id -g)" \
            docker compose ${compose_file[@]+"${compose_file[@]}"} \
            -p "$proj" stop >/dev/null 2>&1; then
            STOPPED+=("$proj")
            echo "reap-test-dbs: stopped idle stack $proj (idle $((idle / 3600))h$(((idle % 3600) / 60))m)"
        fi
    done <<<"$PRESENT"
fi

# Build-cache cap. Nothing else bounds BuildKit's cache: on 2026-10-03 it had
# grown to 90 GB (40 GB unused) and filled the VM disk, so every lint, gate and
# scripts/test died on ENOSPC. Prune down to PRECIS_BUILD_CACHE_KEEP_GB (default
# 30) at most once an hour, guarded by a stamp in the git common dir (shared by
# every worktree, so sibling sessions' SessionStart hooks don't each prune).
# The stamp is claimed BEFORE pruning so two concurrent hooks run it once.
#
# Why this used to reclaim 0B (gr544054): `docker builder prune` IS
# `docker buildx prune` on modern docker, and a keep-policy flag
# (--max-used-space, or --keep-storage/--reserved-space on older dockers)
# caps only the records BuildKit counts as its own — non-shared cache.
# Records shared with images still in the store, and internal/frontend
# records, are skipped by a policy prune entirely, while `docker system
# df`'s Build Cache row counts them as reclaimable. On this host ~76 GB of
# the 75.7 GB shown sat behind images, so the policy prune had almost
# nothing to delete and "reclaimed 0B" while the cap did nothing.
#
# So: measure the cap against `docker system df`, not the prune's own
# "Total:" line, and prune with --all when offered (so the policy sees the
# shared records too). If the cache still sits over the cap afterwards the
# excess is pinned behind images — say so in one line and stop. Wiping the
# whole cache (`docker buildx prune -a`, the only call that reaches those
# records) is an operator decision, not a SessionStart hook's. --dry-run
# never prunes.

_df_build_cache() {  # raw SIZE token of `docker system df`'s Build Cache row
    ${BOUND_DF[@]+"${BOUND_DF[@]}"} docker system df 2>/dev/null \
        | awk '/^Build Cache/ {print $5}'
}

_human_bytes() {  # "75.7GB"|"233.5kB"|"0B" -> bytes; empty on failure
    python3 - "$1" <<'PY'
import re
import sys

m = re.fullmatch(r"([0-9]+(?:\.[0-9]+)?)\s*([A-Za-z]*)", sys.argv[1].strip())
if not m:
    sys.exit(1)
mult = {
    "b": 1, "kb": 1e3, "mb": 1e6, "gb": 1e9, "tb": 1e12,
    "kib": 2**10, "mib": 2**20, "gib": 2**30, "tib": 2**40,
}.get((m.group(2) or "b").lower())
if mult is None:
    sys.exit(1)
print(int(float(m.group(1)) * mult))
PY
}

_bytes_human() {  # bytes -> "45.7GB"; empty on failure
    python3 - "$1" <<'PY'
import sys

n = int(sys.argv[1])
for unit, mult in (("TB", 1e12), ("GB", 1e9), ("MB", 1e6), ("kB", 1e3)):
    if n >= mult:
        print(f"{n / mult:.1f}{unit}")
        break
else:
    print(f"{n}B")
PY
}

prune_build_cache() {
    [ "$DRY_RUN" = 1 ] && return 0
    local keep="${PRECIS_BUILD_CACHE_KEEP_GB:-30}" \
        gitdir stamp help flag f out aflag reclaimed \
        before before_b after after_b keep_b
    case "$keep" in '' | *[!0-9]*) keep=30 ;; esac
    gitdir="$(git -C "$(dirname "$0")/.." rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" || return 0
    [ -n "$gitdir" ] && [ -d "$gitdir" ] || return 0
    stamp="$gitdir/precis-build-cache-prune.stamp"
    if [ -f "$stamp" ] && [ -n "$(find "$stamp" -mmin -60 2>/dev/null)" ]; then
        return 0
    fi
    : >"$stamp" 2>/dev/null || return 0
    help="$(docker builder prune --help 2>&1)" || true
    flag=""
    for f in --max-used-space --keep-storage --reserved-space; do
        case "$help" in *"$f"*) flag="$f"; break ;; esac
    done
    if [ -z "$flag" ]; then
        echo "reap-test-dbs: build-cache prune skipped: this docker has no --max-used-space, --keep-storage or --reserved-space"
        return 0
    fi
    aflag=""
    case "$help" in *"--all"*) aflag="--all" ;; esac
    # Bounded: a prune of tens of GB takes a while, a wedged daemon must not
    # hold the SessionStart hook forever. macOS ships no `timeout`; perl does.
    # The df probes get their own shorter bound — a 10-15s answer on a loaded
    # daemon is normal, a hang is not worth 5 minutes.
    local bound=()
    command -v perl >/dev/null 2>&1 && bound=(perl -e 'alarm shift; exec @ARGV' "${PRECIS_BUILD_CACHE_PRUNE_TIMEOUT:-300}")
    BOUND_DF=()
    command -v perl >/dev/null 2>&1 && BOUND_DF=(perl -e 'alarm shift; exec @ARGV' "${PRECIS_BUILD_CACHE_DF_TIMEOUT:-60}")
    keep_b="$(_human_bytes "${keep}GB" 2>/dev/null || true)"
    before="$(_df_build_cache)"
    before_b="$(_human_bytes "$before" 2>/dev/null || true)"
    if [ -n "$before_b" ] && [ -n "$keep_b" ] && [ "$before_b" -le "$keep_b" ]; then
        [ "$FOR_HOOK" = 1 ] || \
            echo "reap-test-dbs: build cache $before is already under the ${keep}GB cap"
        return 0
    fi
    if ! out="$(${bound[@]+"${bound[@]}"} docker builder prune -f ${aflag:+$aflag} "$flag" "${keep}GB" 2>&1)"; then
        echo "reap-test-dbs: build-cache prune failed (docker builder prune -f${aflag:+ $aflag} $flag ${keep}GB)"
        return 0
    fi
    after="$(_df_build_cache)"
    after_b="$(_human_bytes "$after" 2>/dev/null || true)"
    if [ -n "$after_b" ] && [ -n "$keep_b" ] && [ "$after_b" -gt "$keep_b" ]; then
        # Still over the cap: the excess sits in records pinned behind
        # images (shared/internal), which a keep-policy can never reach.
        # Report it and stop — a bare `docker buildx prune -a` wipes the
        # whole cache, and that is the operator's call, not a hook's.
        over="$(_bytes_human "$((after_b - keep_b))" 2>/dev/null || true)"
        echo "reap-test-dbs: build cache still $after after the ${keep}GB-cap prune — ${over:-over} over cap is pinned behind images; needs a deliberate 'docker buildx prune -a', not this sweep"
    fi
    if [ -n "$before" ] && [ -n "$after" ]; then
        echo "reap-test-dbs: build cache ${before} -> ${after} after pruning to a ${keep}GB cap"
    else
        reclaimed="$(printf '%s\n' "$out" | awk '/^Total:/ { print $2 }' | tail -n 1)"
        echo "reap-test-dbs: build cache pruned to a ${keep}GB cap, reclaimed ${reclaimed:-0B}"
    fi
}
prune_build_cache

if [ "${#REAPED[@]}" -eq 0 ] && [ "${#STOPPED[@]}" -eq 0 ]; then
    [ "$FOR_HOOK" = 1 ] || echo "reap-test-dbs: nothing to reap"
elif [ "$DRY_RUN" = 1 ]; then
    [ "${#REAPED[@]}" -gt 0 ] && \
        echo "reap-test-dbs --dry-run: would reap ${#REAPED[@]}: ${REAPED[*]}"
    [ "${#STOPPED[@]}" -gt 0 ] && \
        echo "reap-test-dbs --dry-run: would stop ${#STOPPED[@]} idle stack(s): ${STOPPED[*]}"
else
    [ "${#REAPED[@]}" -gt 0 ] && \
        echo "reap-test-dbs: reaped ${#REAPED[@]}: ${REAPED[*]}"
    [ "${#STOPPED[@]}" -gt 0 ] && \
        echo "reap-test-dbs: stopped ${#STOPPED[@]} idle stack(s): ${STOPPED[*]}"
fi
exit 0

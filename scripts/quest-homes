    "ephemeral-potentials-": "qu500066",
    "surface-pourbaix-": "qu500066",
    "hexfold-": "qu347422",
}

#: Gripe ``cluster:`` prefixes that name a quest's subject. Unmatched
#: precis clusters fall to "Gripe fixes" (under qu540835).
CLUSTER_PREFIX_QUESTS = {
    "pcb-": "qu570323",
    "topo-": "qu570323",
    "geom-": "qu686092",

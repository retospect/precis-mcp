#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/quest-homes — quest-rollup slice 0 (td681396), DRY RUN: propose a
home quest for every live backlog spec and every live gripe, as TSV.

Rules are me691000 "Homes", first match wins.

Specs (``draft``/``ready``/``in-progress``):
  front-matter  ``quest: quNNN`` in the spec
  thread        the quest serving the thread file that links the spec
                (``THREAD_QUESTS`` below; a thread with no quest falls through)
  prefix        a slug prefix naming the subject's quest (``PREFIX_QUESTS``)
  cites         a 3d-design spec citing exactly one quest takes that quest
                (a proposal for a rule-1 ``quest:`` line: review it)
  pillar        the spec's ``pillar:`` default quest (``PILLAR_QUESTS``)
Each spec row also lists the other quests its text cites (``cites``), the
review hint for a rule-1 ``quest:`` line, and the live project todo naming
the doc, if any (``todo``, prod only).

Gripes (not ``STATUS:done``/``wontfix``):
  serves        an existing gripe → quest ``serves`` link
  fix-todo     the quest its ``fixes`` todo resolves to (parent chain, serves)
  spec          a ``spec:<slug>`` tag, or ``cluster:<x>`` equal to a live
                spec slug or thread name → that spec/thread's home
  title-cites   the one quest the title names
  cluster       a ``cluster:`` prefix naming the subject (``CLUSTER_PREFIX_QUESTS``)
  pillar        a ``pillar:<p>`` tag → the pillar default
  project       a ``project:`` with a subject quest (``PROJECT_QUESTS``)
  gripe-fixes   a platform-project gripe with no better home (the "Gripe
                fixes" quest qu686227)
  catch-all     everything else

Usage:
  scripts/quest-homes --no-db                 # specs only, no prod read
  scripts/quest-homes --out /tmp/homes.tsv    # specs + gripes (prod, read-only)
  scripts/quest-homes --summary               # counts per quest and rule

  scripts/quest-homes --apply                 # WRITE (Reto approved 2026-11-15)

Prod reads go through ``scripts/prod-psql --ro``. ``--apply`` writes the
``quest:`` front-matter lines locally, then through ``scripts/prod-precis
tools`` (the MCP handlers): one project todo per unplaced spec (tagged
``spec:<slug>``, ``backlog-spec``, ``hold:no-dispatch`` so no lane builds
it), a ``serves`` link for an existing unplaced root todo, and a gripe →
quest ``serves`` link per gripe. Idempotent: a re-run sees the todos and
links it made and skips them.
"""

from __future__ import annotations

import argparse
import collections
import csv
import io
import os
import re
import subprocess
import sys
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
BACKLOG = REPO / "docs" / "backlog"
LIVE_STATUSES = ("draft", "ready", "in-progress")

#: Pillar default quests, Reto 2026-11-15 (quest-rollup.md, Homes).
PILLAR_QUESTS = {
    "platform": "qu540835",
    "memory-graph": "qu635085",
    "local-compute": "qu635084",
    "quests": "qu540835",
    "3d-design": "qu686092",
    "personal": "qu686093",
    "operations": "qu540835",
}

#: Threads whose work serves one quest (thread:<name> tag on the quest, or
#: the thread's own subject). Threads not listed fall through to pillar.
THREAD_QUESTS = {
    "catalysis-selectivity": "qu202467",
    "hexfold-toolkit": "qu347422",
    "pcb-platform": "qu570323",
    "pcb-easyeda-round-trip": "qu570323",
    "ewod-pcb": "qu570323",
    "nanobuds-paper": "qu459585",
    "se-machine-design": "qu686092",
    "se-3d-viewer": "qu686092",
    "se-nucleic-chain": "qu686092",
    "multiscale-design-core": "qu686092",
    "factory": "qu540835",
    "local-compute": "qu635084",
    "knowledge-mesh": "qu635085",
    "task-scratch-memory": "qu635085",
}

#: Spec slug prefixes that name their subject's quest: boards go to the PCB
#: quest, the pathway/kinetics engine to the surface-kinetics quest.
PREFIX_QUESTS = {
    "pcb-": "qu570323",
    "topo-": "qu570323",
    "ewod-": "qu570323",
    "digikey-": "qu570323",
    "pathway-": "qu500066",

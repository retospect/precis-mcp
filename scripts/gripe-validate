#!/usr/bin/env -S uv run --no-project --python >=3.12 python
"""scripts/gripe-validate — flip STATUS:verify gripes to done once their sha is live.

    scripts/gripe-validate [--dry-run] [--prod-ref REF]

The last rung of the gripe status ladder (gr541800, td541978): open →
triaged → fixing (claimed) → verify (on main; scripts/ship wrote
``resolved: <sha> (main, release pending)``) → done (that sha reached
origin/prod) | wontfix.

Two prod calls through scripts/prod-precis:

1. ``gripes --verify-list`` — one JSON line ``{id, sha}`` per live verify
   gripe; sha is from its newest ``resolved: <sha>`` / ``fix-sha: <sha>``
   comment.
2. ``gripes --verify-done TEXT --ids …`` — for the gripes whose sha is an
   ancestor of origin/prod (``git merge-base --is-ancestor``, after a
   fetch), comment ``resolved: <sha> (on prod <prod9>) — …`` and tag
   STATUS:done. A gripe that left verify meanwhile is skipped.

``--dry-run`` reads only: it lists what would flip and why the rest stay
(not on prod yet, no sha, sha unknown to this clone). ``--prod-ref``
overrides the ref (default origin/prod, fetched first).

scripts/release runs it after the deploy step; it is idempotent and
non-interactive, so a recurring job (precis schedule, cron) can run it
too. Best-effort by contract: always exits 0 and prints one summary line;
a missing DSN, a refusal or a timeout is reported, not retried; it skips
when PRECIS_GRIPE_VALIDATE=0. Writes run
from the first tree that contains origin/prod (scripts/gripe-note's
``write_tree``).

Test seams: PRECIS_GRIPE_VALIDATE_CLI replaces the prod-precis command
(and skips the DSN check); PRECIS_GRIPE_VALIDATE_TIMEOUT overrides
TIMEOUT_S.
"""

from __future__ import annotations

import argparse
import importlib.machinery
import importlib.util
import json
import os
import re
import shlex
import subprocess
import sys
from pathlib import Path
from types import ModuleType

HERE = Path(__file__).resolve().parent
DSN_FILE = Path.home() / ".secrets" / "pw" / "PRECIS_DATABASE_URL"
#: One prod call's ceiling (`uv run` start + one query or a few writes).
TIMEOUT_S = 90.0
#: One run closes at most this many; the rest wait for the next run.
MAX_IDS = 60


def _gripe_note() -> ModuleType:
    """scripts/gripe-note as a module — its ``write_tree`` / ``run_capped``."""
    path = HERE / "gripe-note"
    loader = importlib.machinery.SourceFileLoader("_gripe_note", str(path))
    spec = importlib.util.spec_from_loader("_gripe_note", loader)
    assert spec is not None
    mod = importlib.util.module_from_spec(spec)
    exec(compile(path.read_text(encoding="utf-8"), str(path), "exec"), mod.__dict__)
    return mod


def _git(*args: str) -> subprocess.CompletedProcess[str] | None:
    try:
        return subprocess.run(
            ["git", *args],
            capture_output=True,
            text=True,
            encoding="utf-8",
            check=False,
            timeout=30,
        )
    except (OSError, subprocess.TimeoutExpired):
        return None


#: Statuses the auto-close leg manages — ``verify`` is the legacy
#: spelling of ``auto_verify`` (gr543584). ``user_verify`` waits on a
#: human (the --verify-ask sync); ``needs_spec`` waits on a spec.
_AUTO_STATUSES = frozenset({"verify", "auto_verify"})


def parse_verify_list(out: str) -> list[tuple[int, str, str | None]]:
    """``[(id, status, sha|None)]`` from ``gripes --verify-list`` JSON
    lines; any non-JSON line (a deprecation notice, a warning) is
    skipped. A row with no ``status`` reads as ``verify``."""
    rows: list[tuple[int, str, str | None]] = []
    for line in out.splitlines():
        line = line.strip()
        if not line.startswith("{"):
            continue
        try:
            obj = json.loads(line)
        except json.JSONDecodeError:
            continue
        sha = obj.get("sha")
        rows.append(
            (
                int(obj["id"]),
                str(obj.get("status") or "verify"),
                str(sha) if sha else None,
            )
        )
    return rows


def classify(
    rows: list[tuple[int, str, str | None]], prod: str
) -> dict[str, list[tuple[int, str | None]]]:
    """Split auto-cohort verify gripes by their sha's relation to ``prod``."""
    out: dict[str, list[tuple[int, str | None]]] = {
        "live": [],
        "pending": [],
        "no sha": [],
        "unknown sha": [],
    }
    for gid, sha in rows:
        if not sha:
            out["no sha"].append((gid, sha))
            continue
        known = _git("cat-file", "-e", f"{sha}^{{commit}}")
        if known is None or known.returncode != 0:
            out["unknown sha"].append((gid, sha))
            continue
        cp = _git("merge-base", "--is-ancestor", sha, prod)
        on_prod = cp is not None and cp.returncode == 0
        out["live" if on_prod else "pending"].append((gid, sha))
    return out


def spec_close(rows: list[int], prod: str) -> dict[int, str]:
    """``{gripe_id: close text}`` for needs_spec gripes a prod spec names.

    gr543698: a docs/backlog/*.md file on prod containing ``gr<id>``
    (the ``Source gripes:`` convention), or a ``docs(...)`` commit
    subject naming it, means the spec exists — the gripe closes.
    """
    if not rows:
        return {}
    files: dict[int, str] = {}
    for gid in rows:
        cp = _git("grep", "-l", "-w", f"gr{gid}", prod, "--", "docs/backlog")
        if cp is not None and cp.returncode == 0 and cp.stdout.strip():
            path = cp.stdout.splitlines()[0].split(":", 1)[-1]
            files[gid] = path
    out: dict[int, str] = {}
    for gid, path in files.items():
        cp = _git("log", "-1", "--format=%H", prod, "--", path)
        sha = cp.stdout.strip()[:9] if cp is not None and cp.returncode == 0 else "?"
        out[gid] = f"resolved: specced in {path} ({sha})"
    rest = [g for g in rows if g not in files]
    if rest:
        cp = _git("log", "--format=%H%x09%s", "-n", "500", prod)
        subjects = [
            (ln.split("\t", 1)[0], ln.split("\t", 1)[1])
            for ln in (cp.stdout.splitlines() if cp is not None else [])
            if "\t" in ln
        ]
        for gid in rest:
            hit = next(
                (
                    (sha, subj)
                    for sha, subj in subjects
                    if subj.lower().startswith("docs(")
                    and re.search(rf"\bgr{gid}\b", subj)
                ),
                None,
            )
            if hit is not None:
                out[gid] = (
                    f"resolved: specced in docs commit {hit[0][:9]} ({hit[1][:60]})"
                )
    return out


def _named(items: list[tuple[int, str | None]]) -> str:
    return " ".join(f"gr{g}" + (f"@{s[:9]}" if s else "") for g, s in items)


def main(argv: list[str] | None = None) -> int:
    ap = argparse.ArgumentParser(prog="scripts/gripe-validate", description=__doc__)
    ap.add_argument("--dry-run", action="store_true", help="list, do not write")
    ap.add_argument(
        "--prod-ref", default="", help="ref to test (default: origin/prod, fetched)"
    )
    args = ap.parse_args(argv)

    ref = args.prod_ref
    if not ref:
        _git("fetch", "--quiet", "origin", "prod", "main")
        ref = "origin/prod"
    cp = _git("rev-parse", "--verify", "--quiet", f"{ref}^{{commit}}")
    prod = cp.stdout.strip() if cp is not None and cp.returncode == 0 else ""
    if not prod:
        print(f"gripe-validate: cannot resolve {ref} — nothing checked")
        return 0

    if os.environ.get("PRECIS_GRIPE_VALIDATE", "1") == "0":
        print("gripe-validate: PRECIS_GRIPE_VALIDATE=0 — skipped")
        return 0
    cli = os.environ.get("PRECIS_GRIPE_VALIDATE_CLI", "").strip()
    if not cli and not DSN_FILE.is_file():
        print("gripe-validate: no prod DSN on this host — nothing checked")
        return 0
    timeout = float(os.environ.get("PRECIS_GRIPE_VALIDATE_TIMEOUT") or TIMEOUT_S)
    try:
        note = _gripe_note()
        base = (
            shlex.split(cli)
            if cli
            else [str(note.write_tree(HERE.parent) / "scripts" / "prod-precis")]
        )
        listed = note.run_capped([*base, "gripes", "--verify-list"], timeout)
    except Exception as e:  # best-effort: never fail the caller
        print(f"gripe-validate: {type(e).__name__} listing verify gripes")
        return 0
    if listed.returncode != 0:
        err = (listed.stderr.strip().splitlines() or [""])[-1]
        err = re.sub(r"[a-z]+://\S+", "<url>", err)[:200]
        print(f"gripe-validate: listing failed (exit {listed.returncode}): {err}")
        return 0

    rows = parse_verify_list(listed.stdout)
    auto = [(g, s) for g, st, s in rows if st in _AUTO_STATUSES]
    users = [g for g, st, _s in rows if st == "user_verify"]
    groups = classify(auto, prod)
    live = groups["live"][:MAX_IDS]
    rest = [
        f"{label}: {_named(items)}"
        for label, items in groups.items()
        if label != "live" and items
    ]
    if len(groups["live"]) > MAX_IDS:
        rest.append(f"+{len(groups['live']) - MAX_IDS} live next run")
    tail = (" · " + " · ".join(rest)) if rest else ""
    head = f"gripe-validate ({ref} {prod[:9]})"

    def _finish(line: str) -> int:
        # user_verify: one ask-user todo per deploy (gr519676); the sync
        # also closes covered gripes once the ask is answered.
        if users:
            try:
                cp = note.run_capped([*base, "gripes", "--verify-ask"], timeout)
                if cp.returncode == 0:
                    line += f" · user-verify: {(cp.stdout.strip().splitlines() or [''])[-1]}"
                else:
                    line += " · user-verify: ask sync failed"
            except Exception:
                line += " · user-verify: ask sync failed"
        # needs_spec (gr543698): close the ones a prod spec names.
        try:
            spec_rows = note.run_capped([*base, "gripes", "--spec-list"], timeout)
            spec_ids = [int(x) for x in spec_rows.stdout.split() if x.strip().isdigit()]
        except Exception:
            spec_ids = []
        closers = spec_close(spec_ids, prod)
        if closers:
            if args.dry_run:
                line += " · would spec-close: " + " ".join(f"gr{g}" for g in closers)
            else:
                # --spec-done takes ONE text; per-gripe texts go one call each.
                ok: list[str] = []
                for gid, text in closers.items():
                    try:
                        cp = note.run_capped(
                            [*base, "gripes", "--spec-done", text, "--ids", str(gid)],
                            timeout,
                        )
                        if cp is not None and cp.returncode == 0:
                            ok.append(f"gr{gid}")
                    except Exception:
                        continue
                if ok:
                    line += " · spec-closed: " + " ".join(ok)
        print(line)
        return 0

    if not live:
        return _finish(f"{head}: none on prod{tail}")
    if args.dry_run:
        return _finish(f"{head}: would flip verify → done: {_named(live)}{tail}")
    text = (
        f"resolved: {{sha}} (on prod {prod[:9]}) — auto-verified after "
        "deploy: the sha is an ancestor of origin/prod"
    )
    ids = ",".join(str(g) for g, _ in live)
    try:
        done = note.run_capped(
            [*base, "gripes", "--verify-done", text, "--ids", ids], timeout
        )
    except Exception as e:
        print(f"{head}: {type(e).__name__} closing {_named(live)} — not retried")
        return 0
    if done.returncode != 0:
        err = (done.stderr.strip().splitlines() or [""])[-1]
        err = re.sub(r"[a-z]+://\S+", "<url>", err)[:200]
        print(f"{head}: closing failed (exit {done.returncode}): {err}")
        return 0
    out = (done.stdout.strip().splitlines() or [""])[-1]
    return _finish(f"{head}: {out}{tail}")


if __name__ == "__main__":
    sys.exit(main())

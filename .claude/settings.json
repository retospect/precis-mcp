{
  "disableWorkflows": true,
  "env": {
    "ENABLE_TOOL_SEARCH": "auto:20"
  },
  "enabledMcpjsonServers": [
    "claude-context"
  ],
  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(scripts/ship:*)",
      "Bash(scripts/deploy:*)",
      "Bash(scripts/dev:*)",
      "Bash(git:*)",
      "Bash(docker:*)",
      "Bash(uv:*)",
      "Bash(ansible-playbook:*)",
      "Bash(ansible:*)",
      "Bash(scripts/test:*)",
      "Bash(scripts/coderef:*)",
      "Bash(scripts/inflight:*)",
      "Bash(scripts/memory-lint:*)",
      "Bash(scripts/backlog-lint:*)",
      "Bash(rtk grep:*)",
      "Bash(rtk tail:*)",
      "Bash(rtk head:*)",
      "Bash(rtk ls:*)",
      "Bash(rtk cat:*)",
      "Bash(rtk git:*)",
      "Bash(rtk scripts/ship:*)",
      "mcp__claude-context",
      "mcp__precis__get",
      "mcp__precis__search",
      "mcp__precis__more"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-start-lock.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/inflight\" --for-hook"
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/reap-worktrees\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/reap-test-dbs\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/reap-stale-serves\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/heal-primary-branch.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/code-search-up.sh\""
          },
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/memory-nudge.sh\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/docs-index\" || true"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "S=\"$CLAUDE_PROJECT_DIR/scripts/hooks/session-end-reap.sh\"; [ -f \"$S\" ] && bash \"$S\" || true"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-worktree-path.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-sealed-migration.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/rca-triage-nudge.py\""
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-secret-read.py\""
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-secret-read.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-commit-on-main.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-git-stash.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-prod-psql.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-checkout-in-primary.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-cd-to-primary.py\""
          },
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/bash-reflex-nudge.py\""
          }
        ]
      },
      {
        "matcher": "Grep",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/coderef-nudge.py\""
          }
        ]
      },
      {
        "matcher": "mcp__precis__put|mcp__precis__edit|mcp__precis__delete|mcp__precis__tag",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/guard-prod-write.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/map-staleness-reminder.py\""
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/hooks/session-size-nudge.py\""
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/hooks/precompact-persist.sh\""
          }
        ]
      }
    ]
  },
  "disableArtifact": true
}

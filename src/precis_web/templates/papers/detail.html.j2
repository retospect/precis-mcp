{% extends "base.html.j2" %}
{% block title %}{{ paper.title }}{% endblock %}
{# Full-bleed: the two-pane reader owns the whole width so the PDF pane can
   grow with the window (base.html.j2's default max-w-6xl would cap it). #}
{% block main_class %}px-4 py-6{% endblock %}
{% block content %}
{# The two-pane reader (header + Navigate/Jump tabs + PDF pane) is shared
   with the pres slide-deck editor via _reader/reader.html.j2. This page
   supplies the ``doc`` context (built in papers._render_detail) and the
   paper-specific Meta panel (doc.meta_panel = papers/_meta_panel.html.j2),
   which still reads the paper detail context (paper, pa_handle, tags, …). #}
{% include "_reader/reader.html.j2" %}
{# The typed-link ring sits below the reader — the same shared mount the
   generic ref detail uses, so a paper's cites/establishes neighbourhood
   is one click away from its page (web-graph-navigation.md slice 2). #}
<div class="mx-auto max-w-6xl">
  {% from "graph/_panel_mount.html.j2" import panel_mount %}
  {{ panel_mount('paper', paper.id) }}
</div>
{% endblock %}

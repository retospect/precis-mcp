{# Metadata edit / triage / delete affordances for the paper detail
   sidebar. Split out of detail.html.j2 so the two-pane layout stays
   readable; relies on the detail context (paper, prefill, is_triage,
   triage_msg, slug_default, suggested_slug, author_lines, author_rows,
   abstract, journal, entry_type, entry_type_choices, entry_type_is_known). #}

{% if is_triage %}
<div class="rounded-lg border border-warning-strong bg-warning-subtle p-3 text-xs">
  <p class="font-medium text-warning-deep">Needs triage — metadata couldn't be recovered automatically.</p>
  {% if triage_msg %}<p class="mt-1 text-warning-deep">{{ triage_msg }}</p>{% endif %}
  <form method="post" action="/papers/{{ paper.id }}/triage-lookup" class="mt-2 space-y-2">
    <label class="block">
      <span class="text-warning-strong">Paste the paper's real title</span>
      <input name="title" value="{{ prefill.title if prefill else '' }}"
             placeholder="e.g. Ballistic carbon nanotube field-effect transistors"
             class="w-full rounded border border-warning-strong px-2 py-1" />
    </label>
    <button type="submit" class="rounded bg-warning-solid px-3 py-1.5 text-on-solid hover:bg-warning-solid-strong">
      Look up on Semantic Scholar
    </button>
  </form>
  <form method="post" action="/papers/{{ paper.id }}/untriage" class="mt-2 border-t border-warning pt-2">
    <input type="hidden" name="return_to" value="/papers/triage" />
    <button type="submit" class="rounded border border-warning-emphasis px-2 py-1 text-warning-deep hover:bg-warning-muted">
      ✓ Looks fine — remove needs-triage
    </button>
  </form>
</div>
{% endif %}

<div class="border-t border-line-subtle pt-2 text-xs" x-data="{ editing: {{ 'true' if prefill else 'false' }} }">
  <div class="flex items-center gap-2">
    <button type="button" @click="editing = !editing"
            class="rounded border border-line-strong px-2 py-1 hover:bg-surface-subtle">
      <span x-show="!editing">✎ Edit metadata</span>
      <span x-show="editing" x-cloak>Cancel</span>
    </button>
    {% if not is_triage %}
    <form method="post" action="/papers/{{ paper.id }}/retriage" class="inline">
      <button type="submit"
              class="rounded border border-warning-strong bg-warning-subtle px-2 py-1 text-warning-deep hover:bg-warning-muted"
              title="re-add needs-triage — send this paper back to the review queue">
        ⚑ Mark for review
      </button>
    </form>
    {% endif %}
    <form method="post" action="/papers/{{ paper.id }}/delete" class="inline"
          onsubmit="return confirm('Delete paper #{{ paper.id }}? This soft-deletes it (removes it from listings).');">
      <input type="hidden" name="return_to" value="{{ '/papers/triage' if is_triage else '/papers' }}" />
      <button type="submit"
              class="rounded border border-danger-strong bg-danger-subtle px-2 py-1 text-danger-strong hover:bg-danger-muted">
        🗑 Delete paper
      </button>
    </form>
  </div>

  {# Replace a corrupted PDF with a good copy — a straight file swap that
     skips OCR/ingest (chunks + metadata are kept). Needs a cite_key to name
     the file on disk. #}
  {% if paper.slug %}
  <form method="post" action="/papers/{{ paper.id }}/replace-pdf"
        enctype="multipart/form-data" class="mt-2 border-t border-line-subtle pt-2"
        x-data="{ picked: false }">
    <p class="text-fg-subtle">Replace PDF <span class="text-fg-faint">— upload a good copy of a corrupted file. Swaps the stored PDF only; skips OCR, keeps chunks &amp; metadata.</span></p>
    <div class="mt-1 flex items-center gap-2">
      <input type="file" name="file" accept="application/pdf" required
             @change="picked = $event.target.files.length > 0"
             class="min-w-0 flex-1 text-fg-muted file:mr-2 file:rounded file:border-0 file:bg-surface-muted file:px-2 file:py-1 file:text-fg-secondary" />
      <button type="submit" :disabled="!picked"
              class="shrink-0 rounded bg-info-solid px-3 py-1.5 text-on-solid hover:bg-info-solid-strong disabled:opacity-40">
        Upload
      </button>
    </div>
  </form>
  {% endif %}

  <form x-show="editing" x-cloak method="post" action="/papers/{{ paper.id }}/edit"
        class="mt-2 space-y-2"
        x-data="{ slug: '{{ slug_default }}', etSel: '{{ entry_type if entry_type_is_known else '__other__' }}' }">
    <p class="text-fg-subtle">Leave a field blank to keep its current value. Authors: one per line.</p>
    {# Fill only the *empty* fields (title/DOI/arXiv → exact S2 record, else
       title search; a known DOI then overlays the Crossref publisher record —
       see the s2-prefill route docstring). Client-side prefill — nothing is
       saved until you press Save; fields you've already filled are left alone. #}
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" onclick="__paperFillBlanks(this)" data-paper-id="{{ paper.id }}"
              class="rounded border border-info-strong bg-info-subtle px-2 py-1 text-info-deep hover:bg-info-muted">
        ⟲ Fill blanks from Crossref / Semantic Scholar
      </button>
      <span class="fill-msg text-[10px] text-fg-subtle"></span>
    </div>
    <label class="block">
      <span class="text-fg-subtle">Title</span>
      <input name="title" value="{{ prefill.title if prefill else paper.title }}"
             class="w-full rounded border border-line-strong px-2 py-1" />
    </label>
    <div class="grid grid-cols-2 gap-2">
      <label class="block">
        <span class="text-fg-subtle">Year</span>
        <input name="year" value="{{ prefill.year if prefill else (paper.year or '') }}" inputmode="numeric"
               class="w-full rounded border border-line-strong px-2 py-1" />
      </label>
      <label class="block">
        <span class="text-fg-subtle">DOI</span>
        <input name="doi" value="{{ prefill.doi if prefill else (paper.links.doi or '') }}" placeholder="10.xxxx/yyyy"
               class="w-full rounded border border-line-strong px-2 py-1 font-mono" />
      </label>
      <label class="block">
        <span class="text-fg-subtle">arXiv id</span>
        <input name="arxiv" value="{{ prefill.arxiv if prefill else (paper.links.arxiv or '') }}" placeholder="2501.01234"
               class="w-full rounded border border-line-strong px-2 py-1 font-mono" />
      </label>
      <label class="block">
        <span class="text-fg-subtle">Short handle</span>
        <input name="cite_key" x-model="slug" placeholder="e.g. piela07"
               class="w-full rounded border border-line-strong px-2 py-1 font-mono" />
      </label>
    </div>
    {% if suggested_slug and suggested_slug != slug_default %}
    <p class="text-fg-faint">Suggested handle:
      <button type="button" @click="slug = '{{ suggested_slug }}'"
              class="font-mono text-info-strong underline">{{ suggested_slug }}</button>
      (renaming moves the PDF on disk)</p>
    {% endif %}
    <div class="grid grid-cols-2 gap-2">
      <label class="block">
        <span class="text-fg-subtle">Journal</span>
        <input name="journal" value="{{ prefill.journal if prefill else (journal or '') }}"
               class="w-full rounded border border-line-strong px-2 py-1" />
      </label>
      <label class="block">
        <span class="text-fg-subtle">Document type</span>
        <select x-model="etSel" :disabled="etSel === '__other__'" name="entry_type"
                class="w-full rounded border border-line-strong px-2 py-1">
          <option value="">(leave unchanged)</option>
          {% for value, label in entry_type_choices %}
          <option value="{{ value }}">{{ label }}</option>
          {% endfor %}
          <option value="__other__">Other…</option>
        </select>
        <input x-show="etSel === '__other__'" x-cloak :disabled="etSel !== '__other__'"
               name="entry_type" value="{{ entry_type if not entry_type_is_known else '' }}"
               placeholder="Crossref type, e.g. peer-review"
               class="mt-1 w-full rounded border border-line-strong px-2 py-1 font-mono" />
      </label>
    </div>
    <label class="block">
      <span class="text-fg-subtle">Authors (one per line — "Family, Given M. [ORCID iD]", the iD optional)</span>
      <textarea name="authors" rows="3" placeholder="Goldsmith, Bryan R. [0000-0002-1825-0097]&#10;Zywucka, N."
                class="w-full rounded border border-line-strong px-2 py-1 font-mono">{% if prefill %}{{ prefill.authors }}{% elif author_rows %}{% for a in author_rows -%}
{{ a.line }}
{% endfor -%}{% else %}{% for line in author_lines -%}
{{ line }}
{% endfor -%}{% endif %}</textarea>
    </label>
    <label class="block">
      <span class="text-fg-subtle">Abstract</span>
      {# One-click hard-wrap strip (gr349107) — a publisher/PDF-pasted
         abstract carries a newline every ~80 chars; this joins the lines
         of each paragraph into one, client-side only (a blank line still
         starts a new paragraph). Left in the editor for review before
         Save — never auto-applied. #}
      <button type="button" onclick="__paperUnwrapAbstract(this)"
              class="unwrap-abstract-btn ml-2 rounded border border-line-strong bg-surface-subtle px-1.5 py-0.5 text-[10px] text-fg-muted hover:bg-surface-muted"
              title="join hard-wrapped lines within each paragraph into one line">
        ⤒ Unwrap
      </button>
      <textarea name="abstract" rows="4"
                class="w-full rounded border border-line-strong px-2 py-1">{{ prefill.abstract if prefill else (abstract or '') }}</textarea>
    </label>
    <button type="submit" class="rounded bg-success-solid px-3 py-1.5 text-on-solid hover:bg-success-solid-strong">
      Save changes
    </button>
  </form>
</div>

{# Prefill-empty-fields helper for the "⟲ Fill blanks from Semantic Scholar"
   button above. Defined once (guarded); reads the paper id off the button,
   fetches the read-only GET /papers/<id>/s2-prefill JSON, and fills only the
   inputs/textarea that are currently blank — never clobbering a value the
   operator already typed. Persistence is still the normal Save (POST /edit). #}
<script>
if (!window.__paperFillBlanks) {
  window.__paperFillBlanks = async function (btn) {
    const form = btn.closest('form');
    const msg = btn.parentElement.querySelector('.fill-msg');
    const pid = btn.getAttribute('data-paper-id');
    if (!form || !pid) return;
    btn.disabled = true;
    if (msg) { msg.textContent = 'Looking up…'; msg.classList.remove('text-danger'); }
    try {
      const r = await fetch('/papers/' + pid + '/s2-prefill', { cache: 'no-store' });
      const d = await r.json();
      if (!d.ok) {
        if (msg) { msg.textContent = d.message || 'No match.'; msg.classList.add('text-danger'); }
        btn.disabled = false;
        return;
      }
      let filled = 0;
      const setIfEmpty = (name, val) => {
        const el = form.querySelector('[name="' + name + '"]');
        if (el && val && !el.value.trim()) { el.value = val; filled++; }
      };
      setIfEmpty('title', d.title);
      setIfEmpty('year', d.year);
      setIfEmpty('doi', d.doi);
      setIfEmpty('arxiv', d.arxiv);
      setIfEmpty('authors', d.authors);
      setIfEmpty('abstract', d.abstract);
      setIfEmpty('journal', d.journal);
      // entry_type is deliberately NOT filled here — see the s2-prefill
      // route docstring (S2 hardcodes "article", no real signal).
      if (msg) msg.textContent = filled
        ? ('Filled ' + filled + ' blank field(s) — review and Save.')
        : 'Nothing to fill — all fields already set.';
    } catch (e) {
      if (msg) { msg.textContent = 'Lookup failed.'; msg.classList.add('text-danger'); }
    }
    btn.disabled = false;
  };
}
</script>

{# Abstract "⤒ Unwrap" handler (gr349107) — same guarded-singleton-global
   pattern as ``__paperFillBlanks`` above. Pure client-side text massage:
   splits on blank-line paragraph breaks, joins each paragraph's own lines
   with a space, then rejoins paragraphs on a blank line. Never touches the
   server; the operator still reviews + Saves. #}
<script>
if (!window.__paperUnwrapAbstract) {
  window.__paperUnwrapAbstract = function (btn) {
    const form = btn.closest('form');
    const ta = form ? form.querySelector('[name="abstract"]') : null;
    if (!ta) return;
    ta.value = ta.value
      .split(/\n[ \t]*\n/)
      .map((para) =>
        para
          .split('\n')
          .map((line) => line.trim())
          .filter((line) => line.length > 0)
          .join(' ')
      )
      .join('\n\n');
  };
}
</script>

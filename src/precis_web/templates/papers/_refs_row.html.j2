{# One Sources/Cited row — reused as-is by
   /papers/{ref_id}/refs/{direction} (looped, inside _refs_panel.html.j2)
   and by /papers/{ref_id}/fetch-ref's htmx single-row swap (standalone,
   ``row`` as the whole context). ``row`` is built by
   routes/papers.py::_refs_row — self-contained (carries ``ref_id`` /
   ``direction``), so it needs no outer template context either way. The
   Fetch form's ``hx-target="closest .refs-row"`` swaps THIS div without
   needing a synchronised DOM id.

   ``row.marker`` (citation-sources-tab, Sources tab only — never set on a
   Cited row) is the real bibliography marker from a matched
   ``paper_bib_entries`` row; bracket-styled (``[N]``) to distinguish it
   from the plain positional ``row.n`` (``N.``) index it replaces.
   ``row.raw_text`` is the verbatim parsed citation line for a union row
   (a bib entry with no matching S2/held row) — shown instead of
   ``row.title`` since a bare bib entry has no title field.

   ``row.reviewed_at``/``row.reviewed_by`` (held rows only —
   ``routes/papers.py::_refs_row``) drive the ✓ mark (gr351830), same
   ``refs.human_verified_*`` columns every other paper-link surface
   reads via ``_verified_mark.html.j2``. #}
{% import "_verified_mark.html.j2" as vm %}
<div class="refs-row border-b border-line-subtle py-1.5 text-xs last:border-0">
  <div class="flex items-baseline gap-1.5">
    {% if row.marker %}<span class="w-8 shrink-0 text-right text-fg-faint">[{{ row.marker }}]</span>
    {% elif row.n %}<span class="w-5 shrink-0 text-right text-fg-faint">{{ row.n }}.</span>{% endif %}
    {% if row.held %}
    <a href="{{ row.url }}" class="font-medium text-info-strong hover:underline">{{ row.title }}</a>
    {{ vm.verified_mark(row.reviewed_at, row.reviewed_by) }}
    {% if row.year %}<span class="text-fg-faint">({{ row.year }})</span>{% endif %}
    <span class="rounded bg-success-subtle px-1 text-[10px] text-success-strong" title="held in this corpus">held</span>
    {% elif row.raw_text %}
    <span class="font-medium text-fg">{{ row.raw_text }}</span>
    {% else %}
    <span class="font-medium text-fg">{{ row.title }}</span>
    {% if row.year %}<span class="text-fg-faint">({{ row.year }})</span>{% endif %}
    {% endif %}
  </div>
  {% if not row.held %}
  <div class="mt-0.5 flex flex-wrap items-center gap-2 pl-6 text-[11px]">
    {% if row.s2_url %}
    <a href="{{ row.s2_url }}" target="_blank" rel="noopener" class="text-info-strong hover:underline">Semantic Scholar</a>
    {% endif %}
    {% if row.doi_url %}
    <a href="{{ row.doi_url }}" target="_blank" rel="noopener" class="text-info-strong hover:underline">DOI</a>
    {% endif %}
    {% if row.scholar_url %}
    <a href="{{ row.scholar_url }}" target="_blank" rel="noopener" class="text-info-strong hover:underline">Scholar</a>
    {% endif %}
    {% if row.can_fetch %}
    <form method="post" action="/papers/{{ row.ref_id }}/fetch-ref"
          hx-post="/papers/{{ row.ref_id }}/fetch-ref"
          hx-target="closest .refs-row" hx-swap="outerHTML"
          class="ml-auto inline">
      <input type="hidden" name="doi" value="{{ row.doi or '' }}" />
      <input type="hidden" name="s2_id" value="{{ row.s2_id or '' }}" />
      <input type="hidden" name="title" value="{{ row.title or '' }}" />
      <input type="hidden" name="year" value="{{ row.year or '' }}" />
      <input type="hidden" name="n" value="{{ row.n or '' }}" />
      <input type="hidden" name="marker" value="{{ row.marker or '' }}" />
      <input type="hidden" name="raw_text" value="{{ row.raw_text or '' }}" />
      <input type="hidden" name="direction" value="{{ row.direction }}" />
      <input type="hidden" name="return_to"
             value="/papers/{{ row.ref_id }}?tab={{ 'Sources' if row.direction == 'sources' else 'Cited' }}" />
      <button type="submit"
              class="rounded border border-info-strong bg-info-subtle px-2 py-0.5 text-info-strong hover:bg-info-muted"
              title="mint/reuse a fetchable stub and jump the fetch_oa queue">
        Fetch
      </button>
    </form>
    {% endif %}
  </div>
  {% endif %}
</div>

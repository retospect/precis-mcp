{# Paper Meta tab — bibliographic metadata + edit / triage / delete.
   Rendered inside the shared reader's Meta tab (_reader/reader.html.j2),
   which supplies the ``x-show="tab === 'Meta'"`` wrapper. Reads the paper
   detail context (paper, pa_handle, n_chunks, pdf_on_disk, authors_display,
   abstract, ingested, tags, is_reviewed, reviewed_at, reviewed_by, journal,
   issn, entry_type, entry_type_label, retraction, extra_identifiers,
   s2_citation_count, s2_fields, keywords) built by papers._render_detail. #}
<dl class="space-y-1 text-xs">
  <div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">handle</dt><dd class="font-mono">{{ pa_handle }}</dd></div>
  <div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">id</dt><dd>#{{ paper.id }}</dd></div>
  {% if paper.slug %}<div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">cite_key</dt><dd class="font-mono">{{ paper.slug }}</dd></div>{% endif %}
  {% if paper.year %}<div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">year</dt><dd>{{ paper.year }}</dd></div>{% endif %}
  <div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">chunks</dt><dd>{{ n_chunks }}</dd></div>
  <div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">pdf</dt><dd>{{ 'on disk' if pdf_on_disk else ('held, missing file' if paper.has_pdf else 'stub (no pdf)') }}</dd></div>
  {% if authors_display %}<div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">authors</dt><dd>{{ authors_display }}</dd></div>{% endif %}
  {% if journal %}
  <div class="flex gap-2">
    <dt class="w-20 shrink-0 text-slate-400">journal</dt>
    <dd>{{ journal }}{% if issn %} <span class="text-slate-400" title="ISSN">({{ issn }})</span>{% endif %}</dd>
  </div>
  {% endif %}
  {% if entry_type %}<div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">type</dt><dd>{{ entry_type_label }}</dd></div>{% endif %}
  {% if paper.links.doi_url %}<div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">DOI</dt><dd><a class="text-sky-700 hover:underline" href="{{ paper.links.doi_url }}" target="_blank" rel="noopener">{{ paper.links.doi }}</a></dd></div>{% endif %}
  {% if paper.links.arxiv_url %}<div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">arXiv</dt><dd><a class="text-sky-700 hover:underline" href="{{ paper.links.arxiv_url }}" target="_blank" rel="noopener">{{ paper.links.arxiv }}</a></dd></div>{% endif %}
  {% for ident in extra_identifiers %}
  <div class="flex gap-2">
    <dt class="w-20 shrink-0 text-slate-400">{{ ident.label }}</dt>
    <dd>{% if ident.url %}<a class="text-sky-700 hover:underline" href="{{ ident.url }}" target="_blank" rel="noopener">{{ ident.value }}</a>{% else %}{{ ident.value }}{% endif %}</dd>
  </div>
  {% endfor %}
  {% if s2_citation_count is not none %}
  <div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">citations</dt><dd>{{ s2_citation_count }} <span class="text-slate-400">(Semantic Scholar)</span></dd></div>
  {% endif %}
  {% if s2_fields %}
  <div class="flex gap-2"><dt class="w-20 shrink-0 text-slate-400">fields</dt><dd>{{ s2_fields | join(', ') }}</dd></div>
  {% endif %}
</dl>

{# Retraction notice — display-only (source of record is Crossref's
   update-to metadata; see docs/backlog/paper-meta-surfacing.md). Rose,
   matching the strongest alert vocabulary this reader uses elsewhere
   (duplicate-identifier resolver / delete button). #}
{% if retraction %}
<div class="rounded-lg border border-rose-300 bg-rose-50 p-3 text-xs">
  <p class="font-medium text-rose-900">⚠ {{ retraction.label }}</p>
  {% if retraction.reason %}<p class="mt-1 text-rose-800">{{ retraction.reason }}</p>{% endif %}
  {% if retraction.url %}<a class="mt-1 inline-block text-rose-700 underline" href="{{ retraction.url }}" target="_blank" rel="noopener">notice</a>{% endif %}
</div>
{% endif %}

{% if keywords %}
<div class="border-t border-slate-100 pt-2">
  <p class="text-[11px] uppercase tracking-wide text-slate-400">Keywords</p>
  <div class="mt-1 flex flex-wrap gap-1">
    {% for kw in keywords %}
    <span class="rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">{{ kw }}</span>
    {% endfor %}
  </div>
</div>
{% endif %}

{# ingestion timeline #}
<div class="flex flex-wrap gap-x-4 gap-y-1 border-t border-slate-100 pt-2 text-[11px] text-slate-500">
  <span><span class="text-slate-400">ref </span><span title="{{ ingested.ref | abs_ts }}">{{ ingested.ref | ago or '—' }}</span></span>
  <span><span class="text-slate-400">PDF </span><span title="{{ ingested.pdf | abs_ts }}">{{ ingested.pdf | ago or '—' }}</span></span>
  <span><span class="text-slate-400">first chunk </span><span title="{{ ingested.first_chunk | abs_ts }}">{{ ingested.first_chunk | ago or '—' }}</span></span>
</div>

{# "Reviewed" sign-off row (refs.human_verified_at/by) — a compact
   mark-reviewed / undo toggle, distinct from the ``needs-triage`` tag
   below (a review can cover a paper that never needed triage). #}
<div class="flex items-center gap-2 border-t border-slate-100 pt-2 text-xs">
  {% if is_reviewed %}
  <span class="rounded border border-emerald-300 bg-emerald-50 px-2 py-1 text-emerald-800">
    Reviewed ✓ {{ reviewed_at }}{% if reviewed_by %} by {{ reviewed_by }}{% endif %}
  </span>
  <form method="post" action="/papers/{{ paper.id }}/reviewed" class="inline">
    <button type="submit" class="text-slate-400 hover:text-rose-600" title="undo — clear the review stamp">undo</button>
  </form>
  {% else %}
  <form method="post" action="/papers/{{ paper.id }}/reviewed" class="inline">
    <button type="submit"
            class="rounded border border-emerald-300 bg-emerald-50 px-2 py-1 text-emerald-800 hover:bg-emerald-100">
      Mark reviewed ✓
    </button>
  </form>
  {% endif %}
</div>

{# "Can't get it" — the acquirability FACT declared on THIS paper
   (meta.unacquirable_override {note,by,at}, no mode). Read through by
   precis.taproot.trust to harden a clean claim hub grounded only on
   unacquirable papers, and to enrich an unverified lifecycle finding's
   note — it NEVER softens a claim to Ⓐ/✍ itself (that's a separate,
   claim-level declaration made on the /claim page). POST /papers/<id>/
   unacquirable (papers.unacquirable). #}
<div class="border-t border-slate-100 pt-2 text-xs">
  {% if unacquirable %}
  <div class="flex flex-wrap items-center gap-2">
    <span class="rounded border border-amber-300 bg-amber-50 px-2 py-1 text-amber-800">
      ⊘ unacquirable
    </span>
    {% if unacquirable.note %}<span class="text-slate-500">{{ unacquirable.note }}</span>{% endif %}
    {% if unacquirable.by %}<span class="text-[10px] text-slate-400">— {{ unacquirable.by }}</span>{% endif %}
    <form method="post" action="/papers/{{ paper.id }}/unacquirable" class="inline">
      <input type="hidden" name="mode" value="clear" />
      <button type="submit" class="text-slate-400 hover:text-rose-600"
              title="clear the unacquirable declaration">undo</button>
    </form>
  </div>
  {% else %}
  <form method="post" action="/papers/{{ paper.id }}/unacquirable" class="space-y-1">
    <p class="text-slate-400">Can't get this paper? Declare it — a claim grounded only on unacquirable sources stops reading as clean; to vouch for a specific claim, declare it there instead.</p>
    <input name="note" required autocomplete="off"
           placeholder="why — e.g. paywalled; UoL + ILL + Scholar exhausted"
           class="w-full rounded border border-slate-300 px-1.5 py-0.5 text-[11px]" />
    <button type="submit" name="mode" value="set"
            class="rounded border border-slate-300 bg-slate-50 px-2 py-1 text-slate-700 hover:bg-slate-100"
            title="I tried hard to obtain this and could not; the metadata is correct">⊘ Can't get it</button>
  </form>
  {% endif %}
</div>

{# Tag chips. OPEN (free) tags — the ``needs-triage`` review flag
   included — carry a × that removes them via the tag verb; closed-
   vocab tags (STATUS:*, project:*, …) render inert (remove those
   through the agent tag() verb). An add box mints new OPEN tags. #}
<div class="flex flex-wrap items-center gap-1 border-t border-slate-100 pt-2">
  {% for t in tags %}
    {% if t.deletable %}
    <form method="post" action="/papers/{{ paper.id }}/tags" class="inline">
      <input type="hidden" name="remove" value="{{ t.value }}" />
      <span class="inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 text-[10px] text-slate-600">
        {{ t.value }}
        <button type="submit" class="text-slate-400 hover:text-rose-600" title="remove tag">×</button>
      </span>
    </form>
    {% else %}
    <span class="rounded bg-violet-50 px-1.5 py-0.5 text-[10px] text-violet-700"
          title="closed-vocab tag — remove via tag(kind='paper', id={{ paper.id }}, remove=[…])">{{ t.label }}</span>
    {% endif %}
  {% else %}
  <span class="text-[10px] italic text-slate-400">no tags yet</span>
  {% endfor %}
  <form method="post" action="/papers/{{ paper.id }}/tags" class="inline">
    <input type="hidden" name="add" value="read-later" />
    <button type="submit"
            class="rounded bg-slate-50 px-1.5 py-0.5 text-[10px] text-slate-500 hover:bg-slate-100"
            title="quick-tag: read-later">+ read later</button>
  </form>
  <form method="post" action="/papers/{{ paper.id }}/tags" class="inline">
    <input type="hidden" name="add" value="starred" />
    <button type="submit"
            class="rounded bg-slate-50 px-1.5 py-0.5 text-[10px] text-slate-500 hover:bg-slate-100"
            title="quick-tag: starred">+ starred</button>
  </form>
  <form method="post" action="/papers/{{ paper.id }}/tags" class="inline-flex items-center gap-1">
    <input name="add" placeholder="+ tag"
           class="w-20 rounded border border-slate-300 px-1.5 py-0.5 text-[10px]" />
  </form>
</div>

{# "Referenced by" — who links here (drafts / findings / dreams / papers),
   from the materialised ``links`` reverse index. Grouped by (source kind,
   relation); each source is one clickable row into its canonical page.
   Built by papers._backlinks. #}
{% if backlinks %}
<div class="border-t border-slate-100 pt-2">
  <p class="text-[11px] uppercase tracking-wide text-slate-400">Referenced by</p>
  <div class="mt-1 space-y-1.5">
    {% for g in backlinks %}
    <div>
      <p class="text-[10px] text-slate-400">
        <span class="font-mono text-slate-500">{{ g.kind }}</span>
        · {{ g.relation }}{% if g.count > 1 %} · {{ g.count }}{% endif %}
      </p>
      <ul class="mt-0.5 space-y-0.5">
        {% for r in g.rows %}
        <li class="truncate">
          <a class="text-sky-700 hover:underline" href="{{ r.url }}" title="{{ r.title }}">{{ r.title }}</a>
          <span class="font-mono text-[10px] text-slate-400">{{ r.handle }}</span>{% if r.edges > 1 %}<span class="text-[10px] text-slate-400"> ×{{ r.edges }}</span>{% endif %}
        </li>
        {% endfor %}
        {% if g.overflow %}<li class="text-[10px] italic text-slate-400">+{{ g.overflow }} more</li>{% endif %}
      </ul>
    </div>
    {% endfor %}
  </div>
</div>
{% endif %}

{% if abstract %}
<div class="border-t border-slate-100 pt-2">
  <p class="text-[11px] uppercase tracking-wide text-slate-400">Abstract</p>
  <p class="mt-1 text-xs leading-relaxed text-slate-700">{{ abstract }}</p>
</div>
{% endif %}

{% include "papers/_meta_forms.html.j2" %}

{% extends "base.html.j2" %}
{% block title %}Eye{% endblock %}
{% block content %}
<div class="mt-2 mb-4">
  <h1 class="text-lg font-semibold">Eye — focus a node, see its neighbourhood</h1>
  <p class="text-sm text-slate-500">A handle (<span class="font-mono">me4641</span>, <span class="font-mono">pc13234</span>, <span class="font-mono">sk:precis-get-help</span>) opens its focus page; anything else searches, and each hit's handle is a click away from focus.</p>
</div>
<form method="get" action="/eye/" class="flex gap-2">
  <input name="q" value="{{ q }}" autofocus placeholder="handle or query"
         class="flex-1 rounded border border-slate-300 px-3 py-1.5 text-sm font-mono" />
  <button class="rounded bg-slate-800 px-3 py-1.5 text-sm text-white">focus</button>
</form>
<p class="mt-3 text-xs text-slate-500">Ladder: {% for r in ladder %}<span class="font-mono">{{ r }}</span>{% if not loop.last %} &lt; {% endif %}{% endfor %}, any rung <span class="font-mono">+recall</span>.</p>
{% if error %}
<pre class="mt-4 whitespace-pre-wrap rounded border border-rose-200 bg-rose-50 p-4 text-sm text-rose-700">{{ error }}</pre>
{% elif hits %}
<pre class="mt-4 whitespace-pre-wrap rounded border border-slate-200 bg-white p-4 text-sm text-slate-800 leading-relaxed">{{ hits | safe }}</pre>
{% endif %}
{% endblock %}

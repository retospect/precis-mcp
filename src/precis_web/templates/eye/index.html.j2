{% extends "base.html.j2" %}
{% block title %}Eye{% endblock %}
{% block content %}
<div class="mt-2 mb-4">
  <h1 class="text-lg font-semibold">Eye — focus a node, see its neighbourhood</h1>
  <p class="text-sm text-fg-subtle">A handle (<span class="font-mono">me4641</span>, <span class="font-mono">pc13234</span>, <span class="font-mono">sk:precis-get-help</span>) opens its focus page; anything else searches, and each hit's handle is a click away from focus.</p>
</div>
<form method="get" action="/eye/" class="flex gap-2">
  <input name="q" value="{{ q }}" autofocus placeholder="handle or query"
         class="flex-1 rounded border border-line-strong px-3 py-1.5 text-sm font-mono" />
  <button class="rounded bg-solid-strong px-3 py-1.5 text-sm text-on-solid">focus</button>
</form>
<p class="mt-3 text-xs text-fg-subtle">Ladder: {% for r in ladder %}<span class="font-mono">{{ r }}</span>{% if not loop.last %} &lt; {% endif %}{% endfor %}, any rung <span class="font-mono">+recall</span>.</p>
{% if error %}
<pre class="mt-4 whitespace-pre-wrap rounded border border-danger bg-danger-subtle p-4 text-sm text-danger-strong">{{ error }}</pre>
{% elif hits %}
<pre class="mt-4 whitespace-pre-wrap rounded border border-line bg-surface p-4 text-sm text-fg leading-relaxed">{{ hits | safe }}</pre>
{% endif %}
{% endblock %}

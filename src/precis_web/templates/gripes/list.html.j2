{% extends "base.html.j2" %}
{% block title %}Gripes{% endblock %}
{% block content %}

<div class="flex items-center gap-3 mb-4">
  <h1 class="text-lg font-semibold">Gripes</h1>
  <a href="https://github.com/retospect/precis-mcp/tree/main/docs/backlog" target="_blank" rel="noopener"
     class="text-sm text-fg-faint hover:text-fg-muted hover:underline">
    repo backlog ↗
  </a>
</div>

{# File a gripe. Collapsed by default so the queue stays the page's
   subject; open=false costs one click and keeps the triage view intact.
   The attribution line the route appends is previewed here so nobody is
   surprised their login lands in the body text. #}
<details class="mb-5 rounded-md border border-line bg-surface">
  <summary class="cursor-pointer select-none px-4 py-2 text-sm font-medium text-fg-secondary hover:bg-surface-subtle">
    File a gripe
  </summary>
  <form method="post" action="/gripes" class="space-y-2 border-t border-line-subtle px-4 py-3">
    <textarea name="text" rows="4" required
              placeholder="What broke, what you expected, and how to hit it again…"
              class="w-full rounded-md border border-line-strong px-3 py-2 text-sm"></textarea>
    {# Optional project (gr543639): which repo the gripe is against —
       blank is the precis default; triage corrects a wrong guess. #}
    <input name="project" type="text"
           placeholder="project (optional — defaults to precis)"
           class="w-72 rounded-md border border-line-strong px-3 py-2 text-sm">
    <div class="flex flex-wrap items-center gap-3">
      <button class="rounded-md bg-accent-solid text-on-solid text-sm px-4 py-2 hover:bg-accent-solid-strong">
        File gripe
      </button>
      <span class="text-[12px] text-fg-faint">
        Filed as <span class="font-mono">{{ filed_by }}</span> — the body is immutable once
        filed, so corrections go in a comment.
      </span>
    </div>
  </form>
</details>

{# One <details> chip per status, workflow order (gr520298). Only the
   selected filter's panel carries rows at page load (default: triaged,
   the pick list the nav badge counts) — every other status fires ONE
   /gripes/rows request on its first expand (``toggle once``), on the
   shared code path; counts come from the load-time GROUP BY, so a
   1.9k-row done bucket costs a number, not a table. ``retired`` is the
   pseudo-status the count gives soft-deleted rows (merged/duplicate/
   junk). ``live`` / ``all`` lead the list only when selected. #}
<p class="mb-3 text-sm text-fg-faint">
  Showing <span class="font-mono">{{ selected }}</span>.
  Filter:
  {% for f in ['triaged', 'live', 'all'] %}
  {% if f == selected %}<span class="font-semibold text-fg-secondary">{{ f }}</span>{% else %}<a href="/gripes?status={{ f }}" class="text-accent-deep hover:underline">{{ f }}</a>{% endif %}{% if not loop.last %} · {% endif %}
  {% endfor %}
</p>
{% for c in chips %}
<details class="mb-3 group" data-status="{{ c.status }}"{% if c.status == selected %} open{% endif %}
  {%- if c.status != selected %} hx-get="/gripes/rows?status={{ c.status | urlencode }}" hx-trigger="toggle once" hx-target="#gripe-rows-{{ loop.index }}" hx-swap="innerHTML"{% endif %}>
  <summary class="cursor-pointer select-none text-sm font-semibold text-fg-secondary py-1 flex items-center gap-2">
    <span class="text-fg-faint transition group-open:rotate-90">&#9656;</span>
    <span class="inline-block rounded border px-1.5 py-0.5 text-[11px] font-medium uppercase {{ c.badge }}">
      {{ c.status }}
    </span>
    <span class="text-fg-faint font-normal">{{ c.count }}</span>
  </summary>
  <div id="gripe-rows-{{ loop.index }}" class="mt-2">
    {% if c.status == selected %}
      {% set rows = selected_rows %}{% set rows_status = c.status %}{% set next_offset = selected_next_offset %}{% set append = false %}{% include "gripes/_rows.html.j2" %}
    {% else %}
      <div class="rounded-md border border-line px-3 py-2 text-sm text-fg-faint">loading…</div>
    {% endif %}
  </div>
</details>
{% endfor %}

{% endblock %}

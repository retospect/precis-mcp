{% extends "base.html.j2" %}
{% block title %}Gripes{% endblock %}
{% block content %}

<div class="flex items-center gap-3 mb-4">
  <h1 class="text-lg font-semibold">Gripes</h1>
  <a href="https://github.com/retospect/precis-mcp/tree/main/docs/backlog" target="_blank" rel="noopener"
     class="text-sm text-fg-faint hover:text-fg-muted hover:underline">
    repo backlog ↗
  </a>
</div>

{# File a gripe. Collapsed by default so the queue stays the page's
   subject; open=false costs one click and keeps the triage view intact.
   The attribution line the route appends is previewed here so nobody is
   surprised their login lands in the body text. #}
<details class="mb-5 rounded-md border border-line bg-surface">
  <summary class="cursor-pointer select-none px-4 py-2 text-sm font-medium text-fg-secondary hover:bg-surface-subtle">
    File a gripe
  </summary>
  <form method="post" action="/gripes" class="space-y-2 border-t border-line-subtle px-4 py-3">
    <textarea name="text" rows="4" required
              placeholder="What broke, what you expected, and how to hit it again…"
              class="w-full rounded-md border border-line-strong px-3 py-2 text-sm"></textarea>
    {# Optional project (gr543639): which repo the gripe is against —
       blank is the precis default; triage corrects a wrong guess. #}
    <input name="project" type="text"
           placeholder="project (optional — defaults to precis)"
           class="w-72 rounded-md border border-line-strong px-3 py-2 text-sm">
    <div class="flex flex-wrap items-center gap-3">
      <button class="rounded-md bg-accent-solid text-on-solid text-sm px-4 py-2 hover:bg-accent-solid-strong">
        File gripe
      </button>
      <span class="text-[12px] text-fg-faint">
        Filed as <span class="font-mono">{{ filed_by }}</span> — the body is immutable once
        filed, so corrections go in a comment.
      </span>
    </div>
  </form>
</details>

{# Real filter buttons (gr549794): each links to /gripes?status=<s> —
   the route's allowlist already covers every value here (gr549572
   pinned the nav's link). Counts come from the load-time GROUP BY;
   cohort buttons (attention/live/all) carry the summed counts. Every
   button's title= names what it covers and why a gripe lands there
   (gr549769). Less-used statuses sit behind ``more`` — same links.
   Only the selected filter's rows render: a cohort filter used to
   duplicate its rows across the per-status sections below. #}
<div class="flex flex-wrap items-center gap-2 mb-2">
  {% for b in buttons %}
  <a href="/gripes?status={{ b.status | urlencode }}{{ sort_qs }}" title="{{ b.tooltip }}"
     class="inline-flex items-center gap-1.5 rounded-md border px-3 py-1.5 text-sm font-medium transition {% if b.selected %}border-accent-strong bg-accent-muted text-accent-deep{% else %}border-line bg-surface text-fg-secondary hover:bg-surface-subtle{% endif %}">
    {{ b.status }}
    <span class="rounded-full px-1 text-xs {% if b.selected %}text-accent-deep{% else %}text-fg-faint{% endif %}">{{ b.count }}</span>
  </a>
  {% endfor %}
  {% if more_filters %}
  <details class="relative group">
    <summary class="cursor-pointer select-none list-none inline-flex items-center gap-1 rounded-md border border-line bg-surface px-3 py-1.5 text-sm font-medium text-fg-secondary hover:bg-surface-subtle">
      more <span class="text-fg-faint transition group-open:rotate-180">&#9662;</span>
    </summary>
    <div class="absolute z-10 mt-1 min-w-[11rem] rounded-md border border-line bg-surface py-1 shadow-lg">
      {% for m in more_filters %}
      <a href="/gripes?status={{ m.status | urlencode }}{{ sort_qs }}" title="{{ m.tooltip }}"
         class="flex items-center justify-between gap-4 px-3 py-1.5 text-sm {% if m.selected %}bg-accent-muted text-accent-deep font-medium{% else %}text-fg-secondary hover:bg-surface-subtle{% endif %}">
        {{ m.status }}
        <span class="text-xs text-fg-faint">{{ m.count }}</span>
      </a>
      {% endfor %}
    </div>
  </details>
  {% endif %}
</div>

{# Sort picker (gr595573): the shared queue orders — drain is the
   default and links to the bare ?status= URL, so clicking it resets a
   non-default sort. Every link preserves the selected filter. #}
<div class="flex flex-wrap items-center gap-2 mb-4 text-sm">
  <span class="text-fg-faint">sort:</span>
  {% for s in sorts %}
  <a href="{{ s.href }}" title="{{ s.tooltip }}"
     class="inline-flex items-center rounded-md border px-2.5 py-1 text-xs font-medium transition {% if s.selected %}border-accent-strong bg-accent-muted text-accent-deep{% else %}border-line bg-surface text-fg-secondary hover:bg-surface-subtle{% endif %}">{{ s.sort }}</a>
  {% endfor %}
</div>

{% set rows = selected_rows %}{% set rows_status = selected %}{% set next_offset = selected_next_offset %}{% set append = false %}{% include "gripes/_rows.html.j2" %}

{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Gripes{% endblock %}
{% block content %}

<div class="flex items-center gap-3 mb-4">
  <h1 class="text-lg font-semibold">Gripes</h1>
  {# live (default) vs wontfix vs everything toggle #}
  <div class="inline-flex rounded-md border border-slate-300 overflow-hidden text-sm">
    <a href="/gripes"
       class="px-3 py-1 {% if status == 'live' %}bg-violet-600 text-white{% else %}bg-white text-slate-600 hover:bg-slate-50{% endif %}">
      live
    </a>
    <a href="/gripes?status=wontfix"
       class="px-3 py-1 {% if status == 'wontfix' %}bg-violet-600 text-white{% else %}bg-white text-slate-600 hover:bg-slate-50{% endif %}">
      wontfix
    </a>
    <a href="/gripes?status=all"
       class="px-3 py-1 {% if status == 'all' %}bg-violet-600 text-white{% else %}bg-white text-slate-600 hover:bg-slate-50{% endif %}">
      all
    </a>
  </div>
  <span class="text-sm text-slate-500">{{ total }} {{ status }}</span>
</div>

{% if not groups %}
  <div class="rounded-md border border-emerald-300 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">
    {% if status == 'wontfix' %}
    ✓ Nothing marked won't-fix.
    {% elif status == 'all' %}
    ✓ No gripes filed yet.
    {% else %}
    ✓ No live gripes. File friction as you hit it —
    <span class="font-mono">put(kind='gripe', text='…')</span>.
    {% endif %}
  </div>
{% endif %}

{% for g in groups %}
<section class="mb-5">
  <h2 class="text-sm font-semibold text-slate-700 mb-2 flex items-center gap-2">
    <span class="inline-block rounded border px-1.5 py-0.5 text-[11px] font-medium uppercase {{ g.badge }}">
      {{ g.status }}
    </span>
    <span class="text-slate-400 font-normal">{{ g.count }}</span>
  </h2>
  <div class="overflow-hidden rounded-md border border-slate-200">
    <table class="w-full text-sm">
      <tbody>
        {% for gr in g.gripes %}
        <tr class="border-t border-slate-100 first:border-t-0 align-top">
          <td class="px-3 py-2 w-14 text-slate-400 font-mono text-xs">#{{ gr.ref_id }}</td>
          <td class="px-3 py-2">
            <div class="font-medium text-slate-800">
              <a href="/gripes/{{ gr.ref_id }}" class="hover:underline">{{ gr.title_preview }}</a>
            </div>
            <div class="text-[12px] text-slate-400 mt-1 flex flex-wrap gap-x-3 gap-y-0.5">
              {% if gr.prio %}<span class="font-mono">PRIO:{{ gr.prio }}</span>{% endif %}
              <span>filed {{ gr.created }}</span>
              <span>updated {{ gr.updated }}</span>
            </div>
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endfor %}

{% endblock %}

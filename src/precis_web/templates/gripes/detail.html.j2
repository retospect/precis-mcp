{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% block title %}Gripe #{{ id }}{% endblock %}
{% block content %}
{{ drive_back('gripe', 'Gripes') }}

<div class="mt-2 mb-4 flex flex-wrap items-start justify-between gap-3">
  <div>
    <h1 class="text-lg font-semibold">Gripe #{{ id }}</h1>
    <p class="text-sm text-fg-subtle">
      {% if created %}filed {{ created | ago }}{% endif %}
      {% if updated %}· updated {{ updated | ago }}{% endif %}
      {% if set_by %}· by <span class="font-mono">{{ set_by }}</span>{% endif %}
      {% if prio %}· <span class="font-mono">PRIO:{{ prio }}</span>{% endif %}
    </p>
  </div>
  {% if not retired %}{% include "gripes/_gripe_status.html.j2" %}{% endif %}
</div>

{% if retired %}
<div class="mb-4 rounded-md border border-line bg-surface-subtle px-4 py-3 text-sm text-fg-muted">
  Retired — kept on record (merged / duplicate / junk soft-delete); controls are off.
</div>
{% endif %}

{# Body is immutable by design (the audit-trail record of what was
   filed) — no edit affordance here on purpose; corrections/context
   are comments below. #}
<div class="rounded-lg border border-line bg-surface p-4 text-sm text-fg-secondary whitespace-pre-wrap leading-relaxed">{{ body | linkify_refs(markdown=True) }}</div>

{% if comments %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">
    Comments <span class="text-fg-faint font-normal">({{ comments|length }})</span>
  </h2>
  <ul class="space-y-3">
    {% for c in comments %}
    <li class="rounded-lg border border-line bg-surface">
      <div class="px-4 py-1.5 border-b border-line-subtle bg-surface-subtle/60 rounded-t-lg text-xs font-mono text-fg-faint">
        ~{{ c.pos }}
      </div>
      <div class="px-4 py-3 text-sm whitespace-pre-wrap break-words text-fg">{{ c.text | linkify_refs(markdown=True) }}</div>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if not retired %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Add a comment</h2>
  <form method="post" action="/gripes/{{ id }}/comment" class="space-y-2">
    <textarea name="text" rows="3" required data-shortcut="e" data-shortcut-label="Add a comment" placeholder="Append context (e) — comments are append-only, corrections go in a new one…"
              class="w-full rounded-md border border-line-strong px-3 py-2 text-sm"></textarea>
    <button class="rounded-md bg-success-solid text-on-solid text-sm px-4 py-2 hover:bg-success-solid-strong">
      Comment
    </button>
  </form>
</section>

{# Retire is deliberately distinct from STATUS:wontfix above: wontfix
   keeps the gripe on record ("won't act, but not forgotten"); retire
   soft-deletes it — the convention once a fix has actually merged.
   Gated behind a confirm since it's destructive. #}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Retire</h2>
  <div class="rounded-lg border border-danger bg-danger-subtle p-4 text-sm text-danger-deep flex flex-wrap items-center gap-3">
    <p class="flex-1 min-w-[16rem]">
      Soft-deletes this gripe (history preserved, dropped from default search) —
      use once a fix has merged. Different from <span class="font-mono">STATUS:wontfix</span>
      above, which keeps a won't-act gripe on record.
    </p>
    <form method="post" action="/gripes/{{ id }}/retire"
          onsubmit="return confirm('Retire gripe #{{ id }}? This soft-deletes it.');">
      <button type="submit"
              class="rounded-md border border-danger-strong bg-surface text-danger-strong text-sm px-4 py-2 hover:bg-danger-muted">
        Retire…
      </button>
    </form>
  </div>
</section>
{% endif %}
{% endblock %}

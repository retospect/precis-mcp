{# One status's gripe rows — shared by the list's inline open section
   and the /gripes/rows fragment every other chip lazy-loads (gr520298).
   Context: ``rows`` (the _rows dicts, at most _ROWS_PAGE), ``rows_status``
   (the empty-state line + the show-more URL), ``next_offset`` (set when
   another page exists), and ``append`` — true when this render is a
   page-2+ continuation: bare <tr>s that htmx swaps into the tbody in
   place of the show-more row that fetched them. #}
{% macro gripe_row(gr) %}
      <tr data-row class="border-t border-line-subtle first:border-t-0 align-top">
        <td class="px-3 py-2 w-14 text-fg-faint font-mono text-xs">#{{ gr.ref_id }}</td>
        <td class="px-3 py-2">
          <div class="font-medium text-fg">
            <a href="/gripes/{{ gr.ref_id }}" data-row-open class="hover:underline">{{ gr.title_preview }}</a>
          </div>
          <div class="text-[12px] text-fg-faint mt-1 flex flex-wrap gap-x-3 gap-y-0.5">
            {% if gr.prio %}<span class="font-mono">PRIO:{{ gr.prio }}</span>{% endif %}
            {% if gr.project and gr.project != 'project:precis' %}<span class="font-mono">{{ gr.project }}</span>{% endif %}
            <span>filed {{ gr.created }}</span>
            <span>updated {{ gr.updated }}</span>
          </div>
        </td>
      </tr>
{% endmacro %}
{% macro more_row(status, offset) %}
      <tr data-rows-more class="border-t border-line-subtle">
        <td colspan="2" class="px-3 py-2 text-sm">
          <button type="button"
                  hx-get="/gripes/rows?status={{ status | urlencode }}&offset={{ offset }}"
                  hx-target="closest tr" hx-swap="outerHTML"
                  class="cursor-pointer text-accent-deep hover:underline">
            show more
          </button>
        </td>
      </tr>
{% endmacro %}
{% if append %}
  {% for gr in rows %}{{ gripe_row(gr) }}{% endfor %}
  {% if next_offset is not none %}{{ more_row(rows_status, next_offset) }}{% endif %}
{% elif rows %}
<div class="overflow-hidden rounded-md border border-line">
  <table class="w-full text-sm" data-shortcut-scope="list">
    <tbody>
      {% for gr in rows %}{{ gripe_row(gr) }}{% endfor %}
      {% if next_offset is not none %}{{ more_row(rows_status, next_offset) }}{% endif %}
    </tbody>
  </table>
</div>
{% else %}
<div class="rounded-md border border-line px-3 py-2 text-sm text-fg-faint">
  {% if rows_status == 'triaged' %}
  ✓ No triaged gripes — the pick list is empty. File friction as you hit
  it — use the form above, or
  <span class="font-mono">put(kind='gripe', text='…')</span>.
  {% elif rows_status == 'open' %}
  ✓ No open gripes. File friction as you hit it — use the form above, or
  <span class="font-mono">put(kind='gripe', text='…')</span>.
  {% else %}
  No gripes with status {{ rows_status }}.
  {% endif %}
</div>
{% endif %}

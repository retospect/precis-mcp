{% extends "base.html.j2" %}
{% block title %}Drive{% endblock %}
{% block content %}
<div class="mb-3 flex items-start gap-3" x-data="{ open: false, kind: 'cad' }">
  <div class="min-w-0">
    <h1 class="text-lg font-semibold">Drive</h1>
    <p class="text-sm text-slate-500">
      Everything you've collected — papers, patents, slides, cached
      answers — and everything you've made, in folders. One
      best-matching passage per source, the same query the LLM runs;
      flag what you want to read, move / tag / delete inline.
    </p>
  </div>
  {# Batch tab-opener + its one-time-setup reminder — the whole group stays
     hidden until the JS finds direct-download links (LibKey/arXiv) on the
     page. The standing "allow pop-ups" note matters because staggered opens
     only fire when the site is allow-listed (see the script comment); the
     confirm dialog says it too but is transient. #}
  <div id="open-all-wrap"
       class="ml-auto hidden self-center shrink-0 flex flex-col items-end gap-0.5">
    <button type="button" id="open-all-downloads"
            class="rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-700"
            title="Open every direct-download link on this page in its own tab, staggered 10-30s apart to go easy on the library servers. Allow pop-ups for this site (one-time) or only the first opens; click again to cancel.">
      Open all downloads ↓
    </button>
    <span class="text-[10px] leading-tight text-slate-400">
      one-time: allow pop-ups for this site so all open
    </span>
  </div>
  {# + New — cad/structure/figure/mermaid ride /drive/new; draft reuses
     /drafts/new so its genre picker + richer flow stay single-sourced there.
     Keeps ml-auto so it stays right-aligned when the download button is hidden. #}
  <div class="ml-auto relative shrink-0">
    <button type="button" @click="open = !open"
            class="rounded bg-sky-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-sky-700">
      + New <span class="text-[9px]">▾</span>
    </button>
    <form x-show="open" x-cloak @click.outside="open = false"
          method="post"
          :action="kind === 'draft' ? '/drafts/new' : '/drive/new'"
          class="absolute right-0 mt-1 w-64 z-20 rounded-lg border border-slate-200 bg-white p-3 shadow-lg space-y-2">
      <div>
        <label class="block text-xs font-medium text-slate-600 mb-1">Kind</label>
        <select x-model="kind" name="kind"
                class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm bg-white">
          <option value="cad">CAD (3D solid)</option>
          <option value="structure">DFT (atomistic cell)</option>
          <option value="figure">Figure (SVG canvas)</option>
          <option value="mermaid">Mermaid (diagram)</option>
          <option value="draft">Draft (document)</option>
        </select>
      </div>
      {# Draft genre: only /drafts/new consumes `doctype`; hidden for cad/structure/figure.
         Options come from the same _DOC_TYPES source the /drafts page renders. #}
      <div x-show="kind === 'draft'">
        <label class="block text-xs font-medium text-slate-600 mb-1">Type</label>
        <select name="doctype"
                class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm bg-white">
          {% for d in doctypes %}
          <option value="{{ d.value }}"{% if d.default %} selected{% endif %}>{{ d.label }}</option>
          {% endfor %}
        </select>
      </div>
      <div>
        <label class="block text-xs font-medium text-slate-600 mb-1">Title <span class="text-rose-500">*</span></label>
        <input name="title" required autocomplete="off" x-init="$el.focus()"
               placeholder="hex pocket block"
               class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm">
      </div>
      {# Draft description: the writer's initial prompt. Required for drafts
         (a title alone can't drive the planner) — bound via :required so the
         hidden field never blocks a cad/structure/figure/mermaid submit. #}
      <div x-show="kind === 'draft'">
        <label class="block text-xs font-medium text-slate-600 mb-1">What to write <span class="text-rose-500">*</span></label>
        <textarea name="summary" rows="3" :required="kind === 'draft'"
                  placeholder="Describe the document to write — this is the writer's prompt. A title alone isn't enough."
                  class="w-full rounded border border-slate-300 px-2 py-1.5 text-sm"></textarea>
        <p class="text-[10px] text-slate-400 mt-1">
          Becomes the writer's initial prompt and starts it writing. Required — you can't write a document from just a title.
        </p>
      </div>
      <p class="text-[10px] text-slate-400" x-show="kind !== 'draft'">
        Lands you in the editor with a starter you can edit by prompt.
      </p>
      <div class="flex justify-end">
        <button type="submit"
                class="rounded bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-700">
          Create ▸
        </button>
      </div>
    </form>
  </div>
</div>

{% if notice %}
<div class="rounded-md border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-800 mb-4">
  {{ notice }}
</div>
{% endif %}

<form method="get" action="/drive" class="mb-4 space-y-2"
      x-data='itemsFilter({{ kind_defs | tojson }}, {{ artifact_kind_defs | tojson }}, {{ work_kind_defs | tojson }}, {{ selected_kinds | tojson }}, {{ tags | tojson }}, {{ paper_chunks | tojson }})'>
  {# submitted=1 tells the server the checkboxes are authoritative (so
     "none checked" means none, and the choice is remembered in a cookie). #}
  <input type="hidden" name="submitted" value="1" />
  {# Carry the per-draft fetch scope through a search/sort/state change so it
     isn't silently dropped on the first form interaction (the "clear scope ×"
     link is the only way out). #}
  {% if cited_by %}<input type="hidden" name="cited_by" value="{{ cited_by }}" />{% endif %}
  <div class="flex flex-wrap items-end gap-2">
    <div class="flex-1 min-w-[16rem]">
      <label class="block text-xs text-slate-500 mb-0.5">Search</label>
      <input type="text" name="q" value="{{ q }}" autofocus
             placeholder="e.g. MOF CO₂ capture"
             @input="submitForm(1000)"
             class="w-full rounded-md border border-slate-300 px-3 py-1.5 text-sm" />
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-0.5">Sort</label>
      <select name="sort" @change="submitForm(150)" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm">
        <option value="relevance" {% if sort not in ('recency', 'oldest', 'untried') %}selected{% endif %}>Relevance</option>
        <option value="recency" {% if sort == 'recency' %}selected{% endif %}>Newest first</option>
        <option value="oldest" {% if sort == 'oldest' %}selected{% endif %}>Oldest first</option>
        {# The downloads queue's default (state=stub) — never-manually-opened
           first, then longest-since-last-tried. #}
        <option value="untried" {% if sort == 'untried' %}selected{% endif %}>Untried first</option>
      </select>
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-0.5">Show</label>
      <select name="state" @change="submitForm(150)" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm">
        <option value="all" {% if state not in ('stub', 'deleted') %}selected{% endif %}>All</option>
        <option value="stub" {% if state == 'stub' %}selected{% endif %}>Stubs (to get)</option>
        <option value="deleted" {% if state == 'deleted' %}selected{% endif %}>Deleted</option>
      </select>
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-0.5">Since</label>
      <input type="date" name="since" value="{{ since }}" @change="submitForm(150)"
             class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
    </div>
    <div>
      <label class="block text-xs text-slate-500 mb-0.5">Until</label>
      <input type="date" name="until" value="{{ until }}" @change="submitForm(150)"
             class="rounded-md border border-slate-300 px-2 py-1.5 text-sm" />
    </div>
    {% if folder_options %}
    <div>
      <label class="block text-xs text-slate-500 mb-0.5">Folder</label>
      <select name="folder" @change="submitForm(150)" class="rounded-md border border-slate-300 px-3 py-1.5 text-sm max-w-[12rem]">
        <option value="">Top level</option>
        {# "Anywhere" (folder=*) drops the top-level filter instead of
           scoping to one folder — filed artifacts list beside unfiled
           ones, so a kind's list matches its real total. #}
        <option value="*" {% if folder == '*' %}selected{% endif %}>Anywhere</option>
        {% for f in folder_options %}
        <option value="{{ f.id }}" {% if folder == f.id | string %}selected{% endif %}>{{ f.label }}</option>
        {% endfor %}
      </select>
    </div>
    {% endif %}
    <button type="submit"
            class="rounded-md bg-slate-800 text-white px-4 py-1.5 text-sm hover:bg-slate-700">
      Search
    </button>
  </div>

  {# Kind chips — click to toggle; All / None; remembered via cookie.
     Two facets: "Source" (ingested docs + cached answers) and "Author"
     (role='artifact' — drafts, cad, structure, …). #}
  <div class="flex flex-wrap items-center gap-1.5 text-xs">
    <span class="text-slate-500 mr-1">Source</span>
    <button type="button" @click="allKinds()" class="px-1.5 py-0.5 rounded border border-slate-300 text-slate-600 hover:bg-slate-50">All</button>
    <button type="button" @click="noKinds()" class="px-1.5 py-0.5 rounded border border-slate-300 text-slate-600 hover:bg-slate-50">None</button>
    <template x-for="kk in sourceKinds.filter(k => !perplexityKinds.includes(k) && k !== 'paper')" :key="kk">
      <label class="inline-flex items-center gap-1 px-2 py-0.5 rounded border cursor-pointer select-none"
             :class="kinds.includes(kk) ? 'bg-sky-100 border-sky-300 text-sky-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">
        <input type="checkbox" name="k" :value="kk" x-model="kinds" class="sr-only" />
        <span x-text="kk"></span>
      </label>
    </template>
    {# Grouped perplexity chip — collapses perplexity-reasoning +
       perplexity-research into one toggle, with a ▾ popover for picking
       just one of the two. #}
    <div class="relative inline-flex items-center" x-data="{ ppOpen: false }">
      <button type="button" @click="togglePerplexity()"
              class="inline-flex items-center gap-1 pl-2 pr-1 py-0.5 rounded-l border border-r-0 cursor-pointer select-none"
              :class="ppCount() > 0 ? 'bg-sky-100 border-sky-300 text-sky-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">
        <span>perplexity</span>
        <span x-show="ppCount() > 0 && ppCount() < perplexityKinds.length" class="text-[9px] opacity-70" x-text="ppCount() + '/' + perplexityKinds.length"></span>
      </button>
      <button type="button" @click="ppOpen = !ppOpen"
              class="px-1 py-0.5 rounded-r border cursor-pointer text-[9px]"
              :class="ppCount() > 0 ? 'bg-sky-100 border-sky-300 text-sky-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">▾</button>
      <div x-show="ppOpen" x-cloak @click.outside="ppOpen = false"
           class="absolute left-0 top-full mt-1 z-30 w-40 rounded-md border border-slate-200 bg-white py-1 shadow-lg">
        <label class="flex items-center gap-2 px-3 py-1 text-xs text-slate-600 hover:bg-slate-100 cursor-pointer">
          <input type="checkbox" name="k" value="perplexity-reasoning" x-model="kinds" class="rounded border-slate-300">
          <span>reasoning</span>
        </label>
        <label class="flex items-center gap-2 px-3 py-1 text-xs text-slate-600 hover:bg-slate-100 cursor-pointer">
          <input type="checkbox" name="k" value="perplexity-research" x-model="kinds" class="rounded border-slate-300">
          <span>research</span>
        </label>
        <label class="flex items-center gap-2 px-3 py-1 text-xs text-slate-600 hover:bg-slate-100 cursor-pointer">
          <input type="checkbox" name="k" value="websearch" x-model="kinds" class="rounded border-slate-300">
          <span>websearch</span>
        </label>
      </div>
    </div>
    {# Grouped paper chip — a tri-state radio popover (both/with/without
       chunks) rather than a checkbox list, since paper_chunks is a
       single global browse facet (Part 2 of the drive-ui-chunk-filter
       change), not a per-kind toggle. #}
    <div class="relative inline-flex items-center" x-data="{ paperOpen: false }">
      <button type="button" @click="togglePaper()"
              class="inline-flex items-center gap-1 pl-2 pr-1 py-0.5 rounded-l border border-r-0 cursor-pointer select-none"
              :class="kinds.includes('paper') ? 'bg-sky-100 border-sky-300 text-sky-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">
        <span>paper</span>
        <span x-show="paperChunks !== 'both'" class="text-[9px] opacity-70" x-text="paperChunks"></span>
      </button>
      {# Backing input so native form serialization emits k=paper — the main
         button only mutates the in-memory `kinds` array (drives the highlight
         + auto-submit); without this checkbox `paper` would never be posted
         and would silently drop from the kind set on the first resubmit. #}
      <input type="checkbox" name="k" value="paper" x-model="kinds" class="sr-only" />
      <button type="button" @click="paperOpen = !paperOpen"
              class="px-1 py-0.5 rounded-r border cursor-pointer text-[9px]"
              :class="kinds.includes('paper') ? 'bg-sky-100 border-sky-300 text-sky-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">▾</button>
      <div x-show="paperOpen" x-cloak @click.outside="paperOpen = false"
           class="absolute left-0 top-full mt-1 z-30 w-40 rounded-md border border-slate-200 bg-white py-1 shadow-lg">
        <label class="flex items-center gap-2 px-3 py-1 text-xs text-slate-600 hover:bg-slate-100 cursor-pointer">
          <input type="radio" name="paper_chunks" value="both" x-model="paperChunks" @change="submitForm(150)" class="border-slate-300">
          <span>both</span>
        </label>
        <label class="flex items-center gap-2 px-3 py-1 text-xs text-slate-600 hover:bg-slate-100 cursor-pointer">
          <input type="radio" name="paper_chunks" value="with" x-model="paperChunks" @change="submitForm(150)" class="border-slate-300">
          <span>with chunks</span>
        </label>
        <label class="flex items-center gap-2 px-3 py-1 text-xs text-slate-600 hover:bg-slate-100 cursor-pointer">
          <input type="radio" name="paper_chunks" value="without" x-model="paperChunks" @change="submitForm(150)" class="border-slate-300">
          <span>without chunks</span>
        </label>
      </div>
    </div>
  </div>
  {% if artifact_kind_defs %}
  <div class="flex flex-wrap items-center gap-1.5 text-xs">
    <span class="text-slate-500 mr-1">Author</span>
    <template x-for="kk in artifactKinds" :key="kk">
      <label class="inline-flex items-center gap-1 px-2 py-0.5 rounded border cursor-pointer select-none"
             :class="kinds.includes(kk) ? 'bg-amber-100 border-amber-300 text-amber-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">
        <input type="checkbox" name="k" :value="kk" x-model="kinds" class="sr-only" />
        <span x-text="kk"></span>
      </label>
    </template>
  </div>
  {% endif %}

  {# ── Work: quests + todos, plus the recurring-schedule preset. A third
     facet beside Source/Author. These kinds carry no embedded chunks, so
     they list in the no-query browse view (a text query matches only the
     chunked Source/Author kinds). Click a quest → its hub; a todo → its
     own subtree on /tasks. #}
  {% if work_kind_defs %}
  <div class="flex flex-wrap items-center gap-1.5 text-xs">
    <span class="text-slate-500 mr-1">Work</span>
    <template x-for="kk in workKinds" :key="kk">
      <label class="inline-flex items-center gap-1 px-2 py-0.5 rounded border cursor-pointer select-none"
             :class="kinds.includes(kk) ? 'bg-emerald-100 border-emerald-300 text-emerald-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">
        <input type="checkbox" name="k" :value="kk" x-model="kinds" class="sr-only" />
        <span x-text="kk"></span>
      </label>
    </template>
    {# Schedules = recurring todos (meta.schedule set) — a preset link, not
       a kind. The tag=level:recurring sentinel is translated server-side
       to has_schedule=True (§M facet normalization retired the tag). #}
    <a href="/drive?submitted=1&amp;k=todo&amp;tag=level:recurring&amp;sort=recency"
       class="inline-flex items-center gap-1 px-2 py-0.5 rounded border border-emerald-200 text-emerald-700 hover:bg-emerald-50">
      🔁 Schedules
    </a>
  </div>
  {% endif %}

  {# ── Other: kinds the deep link named that have no facet of their own
     (Status's "Refs by kind" chips cover every kind in `refs`). Rendered
     server-side from the selection, not from a def list — the point is to
     keep a scope like ?k=job visible and serializable across a submit. #}
  {% if other_kind_defs %}
  <div class="flex flex-wrap items-center gap-1.5 text-xs">
    <span class="text-slate-500 mr-1">Other</span>
    {% for kk in other_kind_defs %}
    <label class="inline-flex items-center gap-1 px-2 py-0.5 rounded border cursor-pointer select-none"
           :class="kinds.includes('{{ kk }}') ? 'bg-slate-200 border-slate-400 text-slate-800' : 'border-slate-200 text-slate-400 hover:bg-slate-50'">
      <input type="checkbox" name="k" value="{{ kk }}" x-model="kinds" class="sr-only" />
      <span>{{ kk }}</span>
    </label>
    {% endfor %}
  </div>
  {% endif %}

  {# Tag filter — type to autocomplete (substring), click to add a chip,
     ✕ to remove. Selected tags submit as repeated ?tag= params. #}
  <div class="flex flex-wrap items-center gap-1.5 text-xs">
    <span class="text-slate-500 mr-1">Tags</span>
    <template x-for="(t, i) in tags" :key="t">
      <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-violet-100 text-violet-800">
        <span x-text="t"></span>
        <button type="button" @click="removeTag(i)" class="text-violet-500 hover:text-violet-900 leading-none">&times;</button>
        <input type="hidden" name="tag" :value="t" />
      </span>
    </template>
    <div class="relative">
      <input type="text" x-model="tagQuery" @input.debounce.200ms="suggest()"
             @keydown.escape="suggestions = []" placeholder="filter by tag…"
             class="rounded border border-slate-300 px-2 py-0.5 text-xs w-44" />
      <div x-show="suggestions.length" x-cloak @click.outside="suggestions = []"
           class="absolute left-0 mt-1 z-30 w-56 max-h-56 overflow-auto rounded-md border border-slate-200 bg-white py-1 shadow-lg">
        <template x-for="s in suggestions" :key="s.tag">
          <button type="button" @click="addTag(s.tag)" x-text="s.label"
                  class="block w-full text-left px-3 py-1 text-xs text-slate-600 hover:bg-slate-100"></button>
        </template>
      </div>
    </div>
  </div>
</form>

<script>
  document.addEventListener('alpine:init', () => {
    Alpine.data('itemsFilter', (sourceKinds, artifactKinds, workKinds, selectedKinds, selectedTags, paperChunks) => ({
      sourceKinds: sourceKinds,
      artifactKinds: artifactKinds,
      workKinds: workKinds,
      kinds: selectedKinds,
      tags: selectedTags,
      paperChunks: paperChunks || 'both',
      tagQuery: '',
      suggestions: [],
      _t: null,
      perplexityKinds: ['perplexity-reasoning', 'perplexity-research', 'websearch'],
      init() {
        this.$watch('kinds', () => this.submitForm());
      },
      submitForm(delay = 150) {
        clearTimeout(this._t);
        this._t = setTimeout(() => this.$root.requestSubmit(), delay);
      },
      allKinds() { this.kinds = [...this.sourceKinds, ...this.artifactKinds]; },
      noKinds() { this.kinds = []; },
      ppCount() { return this.perplexityKinds.filter(k => this.kinds.includes(k)).length; },
      togglePerplexity() {
        if (this.ppCount() === this.perplexityKinds.length) {
          this.kinds = this.kinds.filter(k => !this.perplexityKinds.includes(k));
        } else {
          for (const k of this.perplexityKinds) if (!this.kinds.includes(k)) this.kinds.push(k);
        }
      },
      togglePaper() {
        this.kinds = this.kinds.includes('paper')
          ? this.kinds.filter(k => k !== 'paper')
          : [...this.kinds, 'paper'];
      },
      removeTag(i) { this.tags.splice(i, 1); },
      addTag(t) {
        if (!this.tags.includes(t)) this.tags.push(t);
        this.tagQuery = '';
        this.suggestions = [];
      },
      async suggest() {
        const term = this.tagQuery.trim();
        if (term.length < 2) { this.suggestions = []; return; }
        try {
          const r = await fetch('/drive/tags/suggest?q=' + encodeURIComponent(term));
          this.suggestions = await r.json();
        } catch (e) { this.suggestions = []; }
      },
    }));
  });
</script>

{% macro item_list(items) %}
<ul class="rounded-lg border border-slate-200 bg-white divide-y divide-slate-100">
  {% for row in items %}
  <li class="px-4 py-3 hover:bg-slate-50" x-data="{ titleHover: false, chunkHover: false }">
    <div class="flex items-start gap-3">
      {% if row.thumbnail %}
      <img src="{{ row.thumbnail }}" loading="lazy" alt=""
           class="mt-0.5 shrink-0 w-12 h-12 rounded object-cover border border-slate-200" />
      {% endif %}
      {# marker group: [kind] [stub|chunks] #}
      <div class="mt-0.5 shrink-0 flex items-center gap-1">
        <span class="text-[10px] px-1.5 py-0.5 rounded bg-slate-100 text-slate-500" title="kind">{{ row.kind }}</span>
        {% for b in row.state %}
          <span class="text-[10px] px-1.5 py-0.5 rounded {{ b.cls }}" title="{{ b.title }}">{{ b.label }}</span>
        {% endfor %}
      </div>
      <div class="min-w-0 flex-1 relative">
        {% set tm = row.title_meta %}
        <span class="relative inline-block" @mouseenter="titleHover=true" @mouseleave="titleHover=false">
          <a href="{{ row.open_url }}" class="text-sky-700 hover:underline text-sm">{{ row.title }}</a>
          {# Title/metadata popover — full (uncapped) title + journal/authors/year,
             only worth a floating box when it says more than the capped row title. #}
          {% if tm and (tm.title != row.title or tm.journal or tm.authors or tm.year) %}
          <div x-show="titleHover" x-cloak
               class="absolute left-0 top-full mt-1 z-20 w-80 max-w-[90vw] rounded-md border border-slate-200 bg-white p-3 text-xs text-slate-600 shadow-lg">
            <p class="font-medium text-slate-800">{{ tm.title }}</p>
            {% if tm.journal %}<p class="italic mt-0.5">{{ tm.journal }}</p>{% endif %}
            {% if tm.authors %}<p class="mt-0.5">{{ tm.authors | join(', ') }}</p>{% endif %}
            {% if tm.year %}<p class="mt-0.5">{{ tm.year }}</p>{% endif %}
          </div>
          {% endif %}
        </span>
        {% if row.tags %}
          <span class="ml-1 inline-flex flex-wrap gap-1 align-middle">
            {% for t in row.tags %}
            <a href="{{ t.href }}" class="text-[10px] px-1.5 py-0.5 rounded bg-violet-50 text-violet-700 hover:bg-violet-100">{{ t.label }}</a>
            {% endfor %}
          </span>
        {% endif %}
        {% if row.preview %}
          <span class="relative block" @mouseenter="chunkHover=true" @mouseleave="chunkHover=false">
            <p class="text-xs text-slate-500 mt-0.5">{{ row.preview }}</p>
            {% if row.chunk_full and row.chunk_full != row.preview %}
            <div x-show="chunkHover" x-cloak
                 class="absolute left-0 top-full mt-1 z-20 w-96 max-w-[90vw] rounded-md border border-slate-200 bg-white p-3 text-xs text-slate-600 shadow-lg whitespace-pre-line">{{ row.chunk_full }}</div>
            {% endif %}
          </span>
        {% elif row.created_at %}
          <p class="text-xs text-slate-400 mt-0.5">added <span title="{{ row.created_at | abs_ts }}">{{ row.created_at | ago }}</span></p>
        {% endif %}
        {# Off-site links (paper rows): "find:" search links (DOI/UoL/Scholar)
           plus direct-download PDFs (LibKey/arXiv). Download links carry
           data-download so the header "Open all downloads" button walks
           exactly them, and render emerald to read as the "get it" tier.
           data-ref-id lets that same button POST a manual-open attempt
           (/downloads/mark-tried) for every ref it opened a tab for. #}
        {% if row.links %}
          <p class="text-xs text-slate-400 mt-0.5">
            find:
            {% for l in row.links %}
              {%- if l.clip -%}
              {# copy-to-clipboard entry (no href) — bare DOI/arXiv id for
                 pasting into a library/ILL search. Key is ``clip`` because
                 Jinja resolves ``l.copy`` to the dict method (always truthy). #}
              <button type="button" data-v="{{ l.clip }}" title="{{ l.title }}"
                      onclick="navigator.clipboard.writeText(this.dataset.v); this.textContent='✓'; setTimeout(() => { this.textContent='⧉'; }, 900)"
                      class="text-sky-700 hover:underline">{{ l.label }}</button>
              {%- else -%}
              <a href="{{ l.href }}" target="_blank" rel="noopener"
                 {% if l.download %}data-download data-ref-id="{{ row.id }}"{% endif %}
                 class="{% if l.download %}font-medium text-emerald-700{% else %}text-sky-700{% endif %} hover:underline">{{ l.label }}</a>
              {%- endif -%}{% if not loop.last %} · {% endif %}
            {% endfor %}
          </p>
        {% endif %}
        {# Per-row quick actions (ItemPresenter.actions(), WS1a) — move to
           a folder, delete, or add a tag, each a small inline form
           dispatching straight through /drive's generic per-ref routes. #}
        {% if row.actions %}
        <div class="mt-1 flex flex-wrap items-center gap-2 text-[11px]">
          {% for a in row.actions %}
            {% if a.type == 'move' %}
            <form method="post" action="/drive/move" class="inline-flex items-center gap-1">
              <input type="hidden" name="kind" value="{{ a.kind }}">
              <input type="hidden" name="id" value="{{ a.id }}">
              <input type="hidden" name="back" value="{{ return_to }}">
              <select name="target_folder" class="rounded border border-slate-300 text-[11px] max-w-[8rem]">
                <option value="">(unfile)</option>
                {% for f in folder_options %}
                <option value="{{ f.id }}">{{ f.label }}</option>
                {% endfor %}
              </select>
              <button class="text-amber-700 hover:underline">move</button>
            </form>
            {% elif a.type == 'delete' %}
            <form method="post" action="/drive/item/{{ a.kind }}/{{ a.id }}/delete" class="inline"
                  onsubmit="return confirm('Delete this {{ a.kind }}? This cannot easily be undone.');">
              <input type="hidden" name="back" value="{{ return_to }}">
              <button class="text-rose-700 hover:underline">delete</button>
            </form>
            {% elif a.type == 'tag' %}
            <form method="post" action="/drive/item/{{ a.kind }}/{{ a.id }}/tag" class="inline-flex items-center gap-1">
              <input type="hidden" name="back" value="{{ return_to }}">
              <input type="text" name="value" placeholder="tag…" autocomplete="off"
                     class="rounded border border-slate-300 text-[11px] w-20 px-1 py-0.5">
              <button class="text-violet-700 hover:underline">tag</button>
            </form>
            {% endif %}
          {% endfor %}
        </div>
        {% endif %}
      </div>
      <div class="shrink-0 flex flex-col items-end gap-1">
        {% set ref_kind = row.kind %}
        {% set ref_id = row.id %}
        {% set active = row.flags %}
        {% set group = 'reading' %}
        {% include "_flag_buttons.html.j2" with context %}
        {# Acquisition-provenance flags (WS1b — folded from /papers-needed)
           ride along on stub rows: a record of which manual fetch route
           was already tried, so you don't chase the same dead end twice. #}
        {% set is_stub = row.state | selectattr('label', 'equalto', 'stub') | list | length > 0 %}
        {% if is_stub %}
        {% set flag_defs = acquire_flag_defs %}
        {% set group = 'acquire' %}
        {% include "_flag_buttons.html.j2" with context %}
        {% endif %}
      </div>
    </div>
  </li>
  {% endfor %}
</ul>
{% endmacro %}

{% macro pager() %}
{% if prev_url or next_url %}
<div class="mt-3 flex items-center gap-2 text-xs">
  {% if first_url %}
  <a href="{{ first_url }}" class="rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100" title="First page">&laquo; First</a>
  {% else %}
  <span class="rounded-md border border-slate-200 px-3 py-1 text-slate-300">&laquo; First</span>
  {% endif %}
  {% if prev_url %}
  <a href="{{ prev_url }}" class="rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100">&larr; Prev</a>
  {% else %}
  <span class="rounded-md border border-slate-200 px-3 py-1 text-slate-300">&larr; Prev</span>
  {% endif %}
  <span class="text-slate-500">Page {{ page }}{% if last_page and page <= last_page %} of {{ last_page }}{% endif %}</span>
  {% if next_url %}
  <a href="{{ next_url }}" class="rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100">Next &rarr;</a>
  {% else %}
  <span class="rounded-md border border-slate-200 px-3 py-1 text-slate-300">Next &rarr;</span>
  {% endif %}
  {% if last_url %}
  <a href="{{ last_url }}" class="rounded-md border border-slate-300 px-3 py-1 hover:bg-slate-100" title="Last page">Last &raquo;</a>
  {% else %}
  <span class="rounded-md border border-slate-200 px-3 py-1 text-slate-300">Last &raquo;</span>
  {% endif %}
</div>
{% endif %}
{% endmacro %}

<div class="flex gap-6 items-start">

  {# ── sidebar: the folder tree + create form + drop-zone info ──────── #}
  <aside class="w-60 shrink-0">
    <div class="rounded-md border border-slate-200 overflow-hidden">
      <div class="px-3 py-2 bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600">
        Folders
      </div>
      <ul class="py-1 text-sm">
        <li>
          <a href="/drive"
             class="block px-3 py-1 {% if current is none %}bg-slate-100 font-medium{% else %}hover:bg-slate-50{% endif %}">
            🗂 All
          </a>
        </li>
        {% for f in folders %}
        <li>
          <a href="/drive?folder={{ f.ref_id }}"
             style="padding-left: {{ 0.75 + f.depth * 0.9 }}rem"
             class="block py-1 pr-3 truncate {% if current and current.ref_id == f.ref_id %}bg-slate-100 font-medium{% else %}hover:bg-slate-50{% endif %}">
            📁 {{ f.title }}
            <span class="text-slate-400 text-xs">{{ f.n_children }}</span>
          </a>
        </li>
        {% endfor %}
        {% if not folders %}
        <li class="px-3 py-1 text-slate-400 text-xs">(no folders yet)</li>
        {% endif %}
      </ul>
    </div>

    <form method="post" action="/drive/create" class="mt-3 flex gap-1">
      <input type="hidden" name="parent_id" value="{{ current.ref_id if current else '' }}">
      <input name="name" placeholder="New folder{% if current %} in {{ current.title }}{% endif %}…"
             class="flex-1 min-w-0 rounded border border-slate-300 px-2 py-1 text-sm">
      <button class="rounded bg-slate-700 text-white px-2 py-1 text-sm hover:bg-slate-600">＋</button>
    </form>

    {# Watch-dir drop-zone info (the second items.py:15-19 gap) — where to
       drop files for manual ingest, read live off the watch daemon's plist. #}
    <div class="mt-4 rounded-md border border-slate-200 overflow-hidden">
      <div class="px-3 py-2 bg-slate-50 border-b border-slate-200 text-xs font-semibold text-slate-600">
        Drop-zones
      </div>
      {% if watch_dir %}
      <ul class="divide-y divide-slate-100 text-xs">
        {% for d in dropzones %}
        <li class="px-3 py-2" title="{{ d.description }}">
          <div class="font-medium text-slate-700">{{ d.label }}</div>
          <code class="block truncate text-slate-500 select-all" title="{{ d.path }}">{{ d.path }}</code>
        </li>
        {% endfor %}
      </ul>
      {% else %}
      <p class="px-3 py-2 text-xs text-slate-400">
        Watch-daemon plist not readable from this host — running outside
        the cluster, or the watch daemon isn't installed here.
      </p>
      {% endif %}
    </div>
  </aside>

  {# ── main pane: the search results / recent list ──────────────────── #}
  <section class="flex-1 min-w-0">

    {% if current %}
    <div class="flex items-center gap-2 mb-3 text-sm">
      <nav class="text-slate-500">
        <a href="/drive" class="hover:underline">Drive</a>
        {% for c in crumbs %}
        <span class="text-slate-300">/</span>
        {% if loop.last %}<span class="font-medium text-slate-800">{{ c.title }}</span>
        {% else %}<a href="/drive?folder={{ c.ref_id }}" class="hover:underline">{{ c.title }}</a>{% endif %}
        {% endfor %}
      </nav>
      <span class="text-slate-300">·</span>
      <form method="post" action="/drive/{{ current.ref_id }}/rename" class="inline-flex gap-1">
        <input name="name" value="{{ current.title }}"
               class="rounded border border-slate-300 px-2 py-0.5 text-xs w-40">
        <button class="rounded border border-slate-300 px-2 py-0.5 text-xs hover:bg-slate-50">rename</button>
      </form>
      <form method="post" action="/drive/{{ current.ref_id }}/delete" class="inline"
            onsubmit="return confirm('Delete folder “{{ current.title }}”? (refused unless empty)');">
        <button class="rounded border border-rose-300 text-rose-700 px-2 py-0.5 text-xs hover:bg-rose-50">delete</button>
      </form>
    </div>
    {% endif %}

    {% if q %}
      {% if not rows %}
      <p class="text-sm text-slate-500">
        No matches for <span class="font-medium text-slate-700">{{ q }}</span>{% if since or until %} in that date window{% endif %}.
      </p>
      {% else %}
      {# The lexical denominator, up top — "5 of 50" reads very
         differently from "5 of ~50,000" (Reto). Approximate (≈) since
         the fused ranking that produced `rows` has no cheap exact
         total. #}
      <p class="text-xs text-slate-500 mb-2">
        Showing {{ rows | length }} of ≈{{ "{:,}".format(result_total or 0) }} match{{ '' if (result_total or 0) == 1 else 'es' }} · one passage per item.
      </p>
      {{ item_list(rows) }}
      {{ pager() }}
      {% endif %}
    {% else %}
      {# Default landing: the recent list (or stub/deleted/cited_by queue) under the search. #}
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-sm font-semibold text-slate-600">
          {% if cited_by %}Papers to fetch{% if cited_by_title %} — {{ cited_by_title }}{% endif %}
          {% elif state == 'stub' %}Stubs — papers to get
          {% elif state == 'deleted' %}Deleted — soft-deleted refs
          {% elif current %}{{ current.title }}
          {% else %}Recently added{% endif %}
        </h2>
        {# "Fetch next N" — jumps the top never-tried DOI stubs to the front
           of the fetch_oa queue (POST /drive/requeue-stubs stamps
           meta.oa_requeued — the stub re-fetch door).
           Only on the stub queue itself — the button's DOI-only, never-tried
           selection is meaningless on any other state/facet. #}
        {% if state == 'stub' %}
        <div class="flex items-center gap-2">
          <form method="post" action="/drive/requeue-stubs" class="shrink-0">
            <input type="hidden" name="back" value="/drive?state=stub" />
            <button type="submit"
                    class="rounded-md bg-sky-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-sky-700"
                    title="Jump the top 25 never-tried DOI stubs to the front of the fetch queue.">
              Fetch next 25 ↑
            </button>
          </form>
          {# "Fetch next batch" — runs a bounded fetch_oa cascade pass
             right now (in-request), instead of waiting for the worker's
             next pass tick (POST /drive/fetch-next-batch). Sibling of
             "Fetch next 25 ↑" above: that one reorders the queue, this
             one actually works it. Non-destructive (a bounded read/fetch
             pass), so no confirm(). #}
          <form method="post" action="/drive/fetch-next-batch" class="shrink-0">
            <input type="hidden" name="back" value="/drive?state=stub" />
            <button type="submit"
                    class="rounded-md bg-emerald-600 px-3 py-1.5 text-xs font-medium text-white hover:bg-emerald-700"
                    title="Run one fetch_oa cascade pass now on the top 25 claimed stubs.">
              Fetch next batch
            </button>
          </form>
        </div>
        {% endif %}
      </div>
      {% if cited_by %}
      <p class="mb-2 text-xs text-slate-500">
        Papers this draft cites but the corpus is still missing (0 body blocks) — grab a copy via the find: links, or drop a PDF in the watch-dir below.
        <a href="/drive" class="ml-1 text-sky-600 hover:underline">clear scope ×</a>
      </p>
      {% endif %}
      {% if recent %}
        {# The total, up top — "12 of 12" vs "30 of 4,318" is the whole point
           of paging a stub queue. This count is exact (a plain filtered refs
           query, no fused-ranking approximation like the search path).
           Singular/plural spelled out per-noun — "papers to fetch" pluralises
           on the head noun, so a bare +s ("paper to fetchs") won't do. #}
        {% set n = result_total or 0 %}
        {% if cited_by %}{% set label = 'paper to fetch' if n == 1 else 'papers to fetch' %}
        {% elif state == 'stub' %}{% set label = 'stub' if n == 1 else 'stubs' %}
        {% elif state == 'deleted' %}{% set label = 'deleted ref' if n == 1 else 'deleted refs' %}
        {% else %}{% set label = 'item' if n == 1 else 'items' %}{% endif %}
        <p class="text-xs text-slate-500 mb-2">
          Showing {{ recent | length }} of {{ "{:,}".format(n) }} {{ label }}.
        </p>
        {{ item_list(recent) }}
        {% if state == 'stub' %}
        <p class="mt-2 text-xs text-slate-400">Use the find: links to track a copy down.</p>
        {% elif not cited_by and not current %}
        <p class="mt-2 text-xs text-slate-400">Search above to go deeper.</p>
        {% endif %}
        {{ pager() }}
      {% else %}
        <p class="text-sm text-slate-400">
          {% if cited_by %}Nothing to fetch — every paper this draft cites is already in the corpus. 🎉
          {% elif state == 'stub' %}No stubs in the selected kinds — nothing waiting to be fetched.
          {% elif state == 'deleted' %}Nothing deleted in the selected kinds.
          {% else %}Nothing here yet — ingest a paper, place something in a folder, or run a search above.{% endif %}
        </p>
      {% endif %}
    {% endif %}
  </section>
</div>

{# "Open all downloads" — walks every direct-download link on the page
   (DOI→LibKey, arXiv→PDF, marked data-download by the row template) and
   opens each in its own tab, staggered 10-30s apart to go easy on the
   library/publisher servers instead of firing 40 tabs in one burst.

   Background tabs: each open is a synthesized Cmd(mac)/Ctrl-modified click on
   a real <a target="_blank"> — Chrome/Chromium opens it BEHIND the current
   tab without stealing focus, exactly as if the user modifier-clicked the
   link (Safari/Firefox may still foreground; harmless). window.open can't
   background a tab, and its null-return pop-up-block signal goes with it — so
   there's no "blocked" label anymore; the confirm dialog tells the user to
   allow pop-ups instead.

   Pop-up trust: a click grants "transient activation" for only ~5s and it is
   NOT inherited by deferred setTimeout callbacks — so staggered opens land
   after it expires and can be silently blocked unless the site is allow-listed
   in the browser's pop-up settings. This is a self-hosted daily-use tool, so
   allow-listing melchior once is the intended setup. The FIRST tab opens
   synchronously inside the click (always allowed by the gesture); clicking
   again while a run is pending cancels the remaining timers. Button stays
   hidden until there's a downloadable row.

   Marking tried: a ref is marked opened (one ref_events row,
   source='manual:open') at the moment ITS OWN tab opens — per-tab inside
   the stagger, NOT all-up-front on the button click — via
   navigator.sendBeacon('/downloads/mark-tried', …) (same-origin, fire-and-
   forget). So cancelling the run or closing the browser mid-burst marks
   only what actually opened; the unopened rest stay untried and correctly
   re-surface next pass (the previous all-up-front mark instead lost every
   un-opened row on an abort). The same per-ref mark also fires on a MANUAL
   click of a single row's download link (the operator who walks the queue
   by hand rather than pressing "Open all"), so hand-opened papers sink to
   the back too. Marking sinks these rows to the back of the sort=untried
   queue on the next load, so reloading the top of that sort serves the
   next batch — no pagination bookkeeping needed here. #}
<script>
(function () {
  const btn = document.getElementById("open-all-downloads");
  const wrap = document.getElementById("open-all-wrap");
  if (!btn || !wrap) return;
  const links = Array.from(document.querySelectorAll("a[data-download]"));
  if (!links.length) return;  // no downloadable rows → leave the button hidden

  const urls = links.map((a) => a.href);
  const N = urls.length;

  // Mark ONE ref opened (source='manual:open') the instant its tab opens —
  // so an aborted run only marks what actually opened. Fire-and-forget.
  function markOne(refId) {
    if (!refId) return;
    const body = new URLSearchParams();
    body.append("ref_id", refId);
    if (navigator.sendBeacon) {
      navigator.sendBeacon("/downloads/mark-tried", body);
    } else {
      fetch("/downloads/mark-tried", { method: "POST", body, keepalive: true });
    }
  }

  // A manual open of a single row's download link marks just that ref —
  // covering the operator who walks the queue by hand instead of pressing
  // "Open all". Left-click, cmd/ctrl-click (background tab) both fire
  // 'click'; middle-click fires 'auxclick'. The "Open all" path dispatches
  // its click on a throwaway <a> (openOne), never these row links, so it
  // does not double-fire this handler.
  links.forEach((a) => {
    const mark = () => markOne(a.dataset.refId);
    a.addEventListener("click", mark);
    a.addEventListener("auxclick", mark);
  });

  const MIN_GAP = 10, MAX_GAP = 30;  // seconds between staggered opens
  // Whole-second gap in [MIN_GAP, MAX_GAP]. Math.random is fine here — this
  // is a UI convenience, not reproducible state.
  const gap = () => MIN_GAP + Math.floor(Math.random() * (MAX_GAP - MIN_GAP + 1));
  const idle = () => "Open all " + N + " downloads ↓";

  let timers = [];
  let running = false, opened = 0;

  btn.textContent = idle();
  wrap.classList.remove("hidden");

  function cancel() {
    timers.forEach(clearTimeout);
    timers = [];
    running = false;
    btn.textContent = "Cancelled — " + opened + "/" + N + " opened · click to restart";
  }

  function openOne(i) {
    // Background tab, no focus steal: synthesize a Cmd(mac)/Ctrl-modified
    // click on a real <a>, exactly as if the user modifier-clicked the link
    // — Chrome/Chromium opens it behind the current tab (Safari/Firefox may
    // still foreground; harmless). window.open can't background a tab, so we
    // forgo its null-return pop-up-block signal — the confirm dialog already
    // tells the user to allow pop-ups.
    const a = document.createElement("a");
    a.href = urls[i];
    a.target = "_blank";
    a.rel = "noopener";
    a.style.display = "none";
    document.body.appendChild(a);
    a.dispatchEvent(new MouseEvent("click", {
      bubbles: true, cancelable: true, view: window,
      ctrlKey: true, metaKey: true,   // background-tab modifier
    }));
    a.remove();
    markOne(links[i].dataset.refId);  // mark THIS ref as its tab opens
    opened += 1;
    if (opened >= N) {
      running = false;
      timers = [];
      btn.textContent = "Opened " + N + " ✓ — click to repeat";
    } else {
      btn.textContent = "Opened " + opened + "/" + N + " · click to cancel";
    }
  }

  btn.addEventListener("click", function () {
    if (running) { cancel(); return; }  // second click cancels the pending run

    const avgGap = (MIN_GAP + MAX_GAP) / 2;
    const mins = Math.max(1, Math.round((N - 1) * avgGap / 60));
    if (!window.confirm(
        "Open " + N + " downloads, spread over ~" + mins + " min?\n\n" +
        "The first opens now; the rest are staggered " + MIN_GAP + "-" + MAX_GAP +
        "s apart to go easy on the library servers.\n" +
        "Allow pop-ups for this site (one-time browser setting) or only the " +
        "first will open.\nClick the button again to cancel the pending ones.\n" +
        "Each row is marked tried only as its tab opens, so cancelling leaves " +
        "the rest for next time.")) {
      return;
    }

    running = true;
    opened = 0;
    timers = [];
    openOne(0);  // synchronous → rides the click's activation
    let t = 0;
    for (let i = 1; i < N; i++) {
      t += gap() * 1000;
      timers.push(setTimeout(() => openOne(i), t));
    }
  });
})();
</script>
{% endblock %}

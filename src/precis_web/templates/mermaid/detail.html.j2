{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% from "mermaid/_export.html.j2" import mm_export %}
{% block title %}{{ title }} — Mermaid{% endblock %}
{% block main_class %}px-4 py-6{% endblock %}
{% block content %}

<div class="mb-2 flex items-center gap-3">
  {{ drive_back('mermaid', 'Mermaid') }}
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-fg-faint">{{ slug }}</span>
  <a id="mm-full-link" href="/mermaid/{{ slug }}/full"
     class="rounded border border-line px-2 py-0.5 text-xs text-fg-secondary hover:bg-surface-subtle"
     title="full-size view — diagram and source fill the window">full-size</a>
  <span class="ml-auto">{{ mm_export(slug) }}</span>
</div>

{# The workbench is the pcb-workbench layout (static/pane-split.js):
   the rendered diagram on the left, source/info + chat on the right, and
   a draggable divider between them whose split is remembered per user. #}
<style>
  #mm-workbench { display: flex; align-items: stretch; height: calc(100vh - 9rem); min-height: 24rem; }
  #mm-workbench .mm-pane { display: flex; flex-direction: column; min-width: 0; }
  #mm-pane-diagram { flex: 0 0 50%; }
  #mm-pane-info { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  #mm-canvas-wrap { flex: 1 1 auto; min-height: 0; overflow: auto; }
  #mm-divider { flex: 0 0 7px; cursor: col-resize; border-radius: 4px; }
  #mm-divider:hover, #mm-divider:focus-visible { background: rgb(var(--bg-surface-emphasis)); }
</style>
<div id="mm-workbench">
  {# ── left: rendered diagram ── #}
  <section id="mm-pane-diagram" class="mm-pane scheme-light rounded border border-line bg-surface p-2">
    <div id="mm-canvas-wrap">
      <div id="mm-canvas">{{ svg | safe }}</div>
      {% if not svg %}
      <pre id="mm-canvas-fallback" class="text-xs text-fg-muted whitespace-pre-wrap">{{ source }}</pre>
      {% endif %}
    </div>
  </section>
  <div id="mm-divider" role="separator" aria-orientation="vertical" tabindex="0"
       aria-label="pane divider" title="drag to resize · double-click resets · arrows adjust"></div>

  {# ── right: source + lints + bindings, docs (two tabs), chat ── #}
  <section id="mm-pane-info" class="mm-pane gap-3 pr-1">
    <details>
      <summary class="text-[11px] text-fg-faint cursor-pointer">source</summary>
      <pre id="mm-source" class="mt-1 text-xs bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap">{{ source }}</pre>
    </details>
    <div id="mm-lints" class="space-y-1 text-[11px]">
      {% for f in findings %}
      <div class="text-warning-strong">⚠ [{{ f.kind }}] {{ f.message }}</div>
      {% endfor %}
    </div>
    {# ── node → chunk bindings ── #}
    <div id="mm-bindings" class="flex flex-wrap gap-1 text-[11px]{% if not bindings %} hidden{% endif %}">
      {% for b in bindings %}
      <span class="inline-flex items-center gap-1 rounded bg-info-subtle border border-info px-1.5 py-0.5 text-info-deep"
            title="{{ b.title }}">
        <span class="font-mono">{{ b.element }}</span>→<span class="font-mono">{{ b.handle }}</span>
      </span>
      {% endfor %}
    </div>

    <div>
      <div class="flex items-center gap-1 mb-1">
        <button id="mm-tab-vocab" type="button"
                class="px-2 py-0.5 rounded text-xs font-semibold text-fg-secondary bg-surface-muted">Shared vocabulary</button>
        <button id="mm-tab-notes" type="button"
                class="px-2 py-0.5 rounded text-xs text-fg-subtle hover:bg-surface-subtle">Implementation notes</button>
        <span class="ml-auto text-[10px] text-fg-faint">vocab is for you · notes are the model's</span>
      </div>
      <pre id="mm-vocab" class="text-xs bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap max-h-40 overflow-y-auto">{{ vocab or '(empty — the model will describe what the diagram is)' }}</pre>
      <pre id="mm-notes" class="hidden text-xs bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap max-h-40 overflow-y-auto">{{ notes or "(empty — the model records node ids / structure here)" }}</pre>
    </div>

    <div class="flex-1 min-h-0">
      <h2 class="text-xs font-semibold text-fg-subtle uppercase tracking-wide mb-1">Chat</h2>
      <div id="mm-chat" class="space-y-2 text-xs max-h-96 overflow-y-auto pr-1">
        {% for t in turns %}
        <pre class="bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap">{{ t }}</pre>
        {% endfor %}
      </div>
      <form id="mm-form" class="flex gap-2 mt-2" data-slug="{{ slug }}">
        <input id="mm-msg" name="message" autocomplete="off" placeholder="tell the model what to draw…"
               class="flex-1 rounded border border-line-strong px-3 py-1.5 text-sm">
        <button id="mm-send" class="rounded bg-solid text-on-solid px-3 py-1.5 text-sm hover:bg-solid-soft">Send ▸</button>
      </form>
    </div>
  </section>
</div>

<script src="/static/pane-split.js" defer></script>
<script>
(function () {
  const form = document.getElementById('mm-form');
  const slug = form.dataset.slug;
  const msg = document.getElementById('mm-msg');
  const chat = document.getElementById('mm-chat');
  const send = document.getElementById('mm-send');
  const canvas = document.getElementById('mm-canvas');
  const source = document.getElementById('mm-source');
  const vocab = document.getElementById('mm-vocab');
  const notes = document.getElementById('mm-notes');
  const lints = document.getElementById('mm-lints');
  const binds = document.getElementById('mm-bindings');
  const tabVocab = document.getElementById('mm-tab-vocab');
  const tabNotes = document.getElementById('mm-tab-notes');

  // The divider is the shared workbench splitter (static/pane-split.js);
  // deferred scripts run before DOMContentLoaded, so it is defined there.
  const attachSplit = function () {
    if (window.PrecisPaneSplit) {
      window.PrecisPaneSplit.attach({
        container: document.getElementById('mm-workbench'),
        left: document.getElementById('mm-pane-diagram'),
        divider: document.getElementById('mm-divider'),
        key: 'precis:mermaid:left-pct',
      });
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachSplit);
  } else {
    attachSplit();
  }

  const ON = 'px-2 py-0.5 rounded text-xs font-semibold text-fg-secondary bg-surface-muted';
  const OFF = 'px-2 py-0.5 rounded text-xs text-fg-subtle hover:bg-surface-subtle';
  function showTab(which) {
    const v = which === 'vocab';
    vocab.classList.toggle('hidden', !v);
    notes.classList.toggle('hidden', v);
    tabVocab.className = v ? ON : OFF;
    tabNotes.className = v ? OFF : ON;
  }
  tabVocab.addEventListener('click', () => showTab('vocab'));
  tabNotes.addEventListener('click', () => showTab('notes'));

  function toBottom() { chat.scrollTop = chat.scrollHeight; }
  function bubble(text, cls) {
    const pre = document.createElement('pre');
    pre.className = 'border rounded p-2 whitespace-pre-wrap ' + cls;
    pre.textContent = text;
    chat.appendChild(pre);
    toBottom();
    return pre;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    const text = msg.value.trim();
    if (!text) return;
    bubble('user: ' + text, 'bg-surface border-line');
    const pending = bubble('…thinking', 'bg-surface-subtle border-line text-fg-faint');
    msg.value = '';
    send.disabled = true;

    const body = new URLSearchParams();
    body.set('message', text);
    fetch('/mermaid/' + encodeURIComponent(slug) + '/turn', { method: 'POST', body })
      .then((r) => r.json())
      .then((d) => {
        if (d.error) { pending.textContent = 'error: ' + d.error; return; }
        pending.textContent = 'assistant: ' + (d.reply || '(no reply)');
        pending.className = 'border rounded p-2 whitespace-pre-wrap bg-surface-subtle border-line';
        // Inline the server-rendered + sanitized SVG (sanitize is the trust boundary).
        if (d.changed && d.svg) canvas.innerHTML = d.svg;
        if (d.changed && typeof d.source === 'string') source.textContent = d.source;
        if (typeof d.vocab === 'string' && d.vocab.trim()) vocab.textContent = d.vocab;
        if (typeof d.notes === 'string' && d.notes.trim()) notes.textContent = d.notes;
        lints.innerHTML = '';
        (d.findings || []).forEach((f) => {
          const div = document.createElement('div');
          div.className = 'text-warning-strong';
          div.textContent = '⚠ [' + f.kind + '] ' + f.message;
          lints.appendChild(div);
        });
        if (Array.isArray(d.bindings)) {
          binds.innerHTML = '';
          binds.classList.toggle('hidden', d.bindings.length === 0);
          d.bindings.forEach((b) => {
            const span = document.createElement('span');
            span.className = 'inline-flex items-center gap-1 rounded bg-info-subtle border border-info px-1.5 py-0.5 text-info-deep';
            span.title = b.title || '';
            const e = document.createElement('span'); e.className = 'font-mono'; e.textContent = b.element;
            const h = document.createElement('span'); h.className = 'font-mono'; h.textContent = b.handle;
            span.appendChild(e); span.append('→'); span.appendChild(h);
            binds.appendChild(span);
          });
        }
      })
      .catch((err) => { pending.textContent = 'request failed: ' + err; })
      .finally(() => { send.disabled = false; toBottom(); msg.focus(); });
  });

  toBottom();
})();
</script>
{% endblock %}

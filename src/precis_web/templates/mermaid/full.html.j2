{% extends "base.html.j2" %}
{% from "mermaid/_export.html.j2" import mm_export %}
{% block title %}{{ title }} — Mermaid full{% endblock %}
{% block main_class %}px-4 py-3{% endblock %}
{% block content %}

{# gr498614 follow-up: the full-size view — the sanitized render (left)
   and the source + lints (right) fill the window, split by the shared
   static/pane-split.js grip like the pcb workbench. Read-only; the
   workbench at /mermaid/<slug> stays the editor. #}
<div class="mb-2 flex items-center gap-3">
  <a href="/mermaid/{{ slug }}" class="text-xs text-fg-faint hover:text-fg-muted">&larr; workbench</a>
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-fg-faint">{{ slug }}</span>
  <span class="ml-auto">{{ mm_export(slug) }}</span>
</div>

<style>
  #mm-full { display: flex; align-items: stretch; height: calc(100vh - 5.5rem); min-height: 24rem; }
  #mm-full .mm-pane { display: flex; flex-direction: column; min-width: 0; }
  #mm-full-diagram { flex: 0 0 50%; }
  #mm-full-source { flex: 1 1 auto; min-height: 0; overflow-y: auto; }
  #mm-full-canvas-wrap { flex: 1 1 auto; min-height: 0; overflow: auto; }
  #mm-full-divider { flex: 0 0 7px; cursor: col-resize; border-radius: 4px; }
  #mm-full-divider:hover, #mm-full-divider:focus-visible { background: rgb(var(--bg-surface-emphasis)); }
</style>
<div id="mm-full">
  {# ── left: rendered diagram, full-size ── #}
  <section id="mm-full-diagram" class="mm-pane scheme-light rounded border border-line bg-surface p-2">
    <div id="mm-full-canvas-wrap">
      <div id="mm-full-canvas">{{ svg | safe }}</div>
      {% if not svg %}
      <pre id="mm-full-canvas-fallback" class="text-xs text-fg-muted whitespace-pre-wrap">{{ source }}</pre>
      {% endif %}
    </div>
  </section>
  <div id="mm-full-divider" role="separator" aria-orientation="vertical" tabindex="0"
       aria-label="pane divider" title="drag to resize · double-click resets · arrows adjust"></div>

  {# ── right: source + lints ── #}
  <section id="mm-full-source" class="mm-pane gap-2 pr-1">
    <h2 class="text-xs font-semibold text-fg-subtle uppercase tracking-wide">Source</h2>
    <div id="mm-full-lints" class="space-y-1 text-[11px]">
      {% for f in findings %}
      <div class="text-warning-strong">⚠ [{{ f.kind }}] {{ f.message }}</div>
      {% endfor %}
    </div>
    <pre class="text-xs bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap">{{ source }}</pre>
  </section>
</div>

<script src="/static/pane-split.js" defer></script>
<script>
(function () {
  // The divider is the shared workbench splitter (static/pane-split.js);
  // deferred scripts run before DOMContentLoaded, so it is defined there.
  const attachSplit = function () {
    if (window.PrecisPaneSplit) {
      window.PrecisPaneSplit.attach({
        container: document.getElementById('mm-full'),
        left: document.getElementById('mm-full-diagram'),
        divider: document.getElementById('mm-full-divider'),
        key: 'precis:mermaid:full-left-pct',
      });
    }
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', attachSplit);
  } else {
    attachSplit();
  }
})();
</script>
{% endblock %}

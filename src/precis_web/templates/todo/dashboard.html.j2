{% extends "base.html.j2" %}
{% block title %}Todo{% endblock %}
{# Inline the current tag filter as hidden inputs so write POSTs
   round-trip the filter and the redirect lands on the same view. #}
{% macro filter_inputs() %}
  {% for r in require_tags %}<input type="hidden" name="require" value="{{ r }}"/>{% endfor %}
  {% for x in exclude_tags %}<input type="hidden" name="exclude" value="{{ x }}"/>{% endfor %}
  {% if focus_id %}<input type="hidden" name="focus" value="{{ focus_id }}"/>{% endif %}
  {% if show_jobs and show_jobs != 'active' %}<input type="hidden" name="show_jobs" value="{{ show_jobs }}"/>{% endif %}
{% endmacro %}
{# Build a query string preserving the current state with the given
   overrides. ``require_add`` adds a pseudo-tag to require (so a
   status / level / kind badge becomes a one-click filter).
   ``show_jobs_override`` swaps the show_jobs param (used by the
   toggle); leave None to inherit the current state. #}
{% macro state_qs(new_focus, require_add=None, exclude_add=None, show_jobs_override=None, tree_override=-1) %}
  {%- set parts = [] -%}
  {%- for r in require_tags -%}{%- set _ = parts.append('require=' ~ r|urlencode) -%}{%- endfor -%}
  {%- if require_add and require_add not in require_tags -%}{%- set _ = parts.append('require=' ~ require_add|urlencode) -%}{%- endif -%}
  {%- for x in exclude_tags -%}{%- set _ = parts.append('exclude=' ~ x|urlencode) -%}{%- endfor -%}
  {%- if exclude_add and exclude_add not in exclude_tags -%}{%- set _ = parts.append('exclude=' ~ exclude_add|urlencode) -%}{%- endif -%}
  {%- if new_focus -%}{%- set _ = parts.append('focus=' ~ new_focus) -%}{%- endif -%}
  {%- if serves_id -%}{%- set _ = parts.append('serves=' ~ serves_id) -%}{%- endif -%}
  {%- set sj = show_jobs_override if show_jobs_override is not none else show_jobs -%}
  {%- if sj and sj != 'active' -%}{%- set _ = parts.append('show_jobs=' ~ sj) -%}{%- endif -%}
  {%- set td = tree_override if tree_override != -1 else tree_depth -%}
  {%- if td -%}{%- set _ = parts.append('tree=' ~ td) -%}{%- endif -%}
  {%- if parts -%}?{{ parts|join('&') }}{%- endif -%}
{% endmacro %}
{# Compat alias for existing callsites that just want to swap focus. #}
{% macro focus_qs(new_focus) %}{{ state_qs(new_focus) }}{% endmacro %}
{% block content %}
{# Tag filter bar. ``require`` and ``exclude`` are repeating GET
   params; AND semantics within each list; matching todos pull in
   their ancestor chain so the tree shape stays legible. #}
<form method="get" action="/todo"
      class="mb-4 rounded-lg border border-line bg-surface px-4 py-3 flex flex-wrap items-end gap-3">
  <div class="flex flex-col">
    <label class="text-xs text-fg-faint mb-0.5">Require tags (AND)</label>
    <input name="require" value="{{ require_tags|join(' ') }}"
           placeholder="e.g. STATUS:doing ask-user"
           class="w-64 rounded-md border border-line-strong px-3 py-1.5 text-sm" />
    <span class="text-xs text-fg-faint mt-0.5">space / comma separated</span>
  </div>
  <div class="flex flex-col">
    <label class="text-xs text-fg-faint mb-0.5">Exclude tags</label>
    <input name="exclude" value="{{ exclude_tags|join(' ') }}"
           placeholder="e.g. STATUS:done level:strategic"
           class="w-64 rounded-md border border-line-strong px-3 py-1.5 text-sm" />
    <span class="text-xs text-fg-faint mt-0.5">matches STATUS:*, level:*, or free tags</span>
  </div>
  <button class="rounded-md bg-success-solid text-on-solid text-sm px-4 py-1.5">Apply</button>
  {# Hidden so the operator's tag input doesn't drop the focus / show_jobs
     state when they apply the form. #}
  {% if focus_id %}<input type="hidden" name="focus" value="{{ focus_id }}"/>{% endif %}
  {% if serves_id %}<input type="hidden" name="serves" value="{{ serves_id }}"/>{% endif %}
  {% if show_jobs and show_jobs != 'active' %}<input type="hidden" name="show_jobs" value="{{ show_jobs }}"/>{% endif %}
  {% if filter_active %}
  {%- set clear_parts = [] -%}
  {%- if focus_id -%}{%- set _ = clear_parts.append('focus=' ~ focus_id) -%}{%- endif -%}
  {%- if show_jobs and show_jobs != 'active' -%}{%- set _ = clear_parts.append('show_jobs=' ~ show_jobs) -%}{%- endif -%}
  <a href="/todo{% if clear_parts %}?{{ clear_parts|join('&') }}{% endif %}"
     class="text-sm text-fg-subtle underline pb-1.5">clear filter</a>
  {% endif %}
  <div class="flex items-center gap-2 ml-auto">
    {# show_jobs toggle: hides terminal-state job rows by default so
       a flurry of failed plan_tick / fix_gripe attempts doesn't bury
       the live work. #}
    {% if show_jobs == 'active' %}
    <a href="/todo{{ state_qs(focus_id, show_jobs_override='all') }}"
       class="text-xs px-2 py-1 rounded border border-line-strong text-fg-muted hover:bg-surface-muted"
       title="show kind='job' rows in failed / succeeded / done / won't-do states">
      + show closed jobs
    </a>
    {% else %}
    <a href="/todo{{ state_qs(focus_id, show_jobs_override='active') }}"
       class="text-xs px-2 py-1 rounded bg-warning-muted border border-warning-strong text-warning-deep hover:bg-warning-emphasis">
      − hide closed jobs
    </a>
    {% endif %}
    {% if filter_active %}
    <span class="text-xs text-fg-subtle">
      showing {{ filtered_rows }} of {{ total_rows }} rows
    </span>
    {% endif %}
    {# Root-level pagination: keeps the rendered tree small so the page
       loads fast. Only shown when there's more than one page of roots. #}
    {% if total_roots > roots_per_page %}
    {% set base = state_qs(focus_id) %}
    {% set sep = '&' if '?' in base else '?' %}
    {% set npages = (total_roots + roots_per_page - 1) // roots_per_page %}
    <span class="text-xs text-fg-subtle flex items-center gap-2">
      {% if page > 1 %}<a href="/todo{{ base }}{{ sep }}page={{ page - 1 }}" class="text-info hover:underline">← prev</a>{% endif %}
      <span>page {{ page }} of {{ npages }} · {{ total_roots }} roots</span>
      {% if has_next %}<a href="/todo{{ base }}{{ sep }}page={{ page + 1 }}" class="text-info hover:underline">next →</a>{% endif %}
    </span>
    {% endif %}
  </div>
</form>
<script>
  // Repeating ``require=`` / ``exclude=`` params is how the route
  // expects multi-tag filters. Split the bare input the operator
  // typed (space / comma) into one hidden field per token so the
  // ergonomics match the refs tab.
  document.currentScript.previousElementSibling.addEventListener('submit', function (ev) {
    const form = ev.target;
    ['require', 'exclude'].forEach(function (name) {
      const inp = form.querySelector('input[name="' + name + '"]');
      if (!inp) return;
      const raw = inp.value || '';
      const parts = raw.split(/[\s,]+/).filter(Boolean);
      inp.remove();
      parts.forEach(function (p) {
        const h = document.createElement('input');
        h.type = 'hidden';
        h.name = name;
        h.value = p;
        form.appendChild(h);
      });
    });
  });
</script>
<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">

  <!-- Tree (2/3) -->
  <section class="lg:col-span-2">
    {# Drill-up breadcrumb: each ancestor is a clickable focus link;
       the final entry is the focused node itself (rendered as plain
       text since it's the current scope). The "All todos" link drops
       focus entirely but keeps the tag filter. #}
    {% if serves_id %}
    <nav class="mb-3 flex flex-wrap items-center gap-1 text-xs text-fg-subtle">
      <a href="/todo" class="hover:text-success-strong underline">All todos</a>
      <span class="text-fg-ghost">›</span>
      <span class="text-fg font-medium">serving qu{{ serves_id }}</span>
    </nav>
    {% endif %}
    {% if focus_id %}
    <nav class="mb-3 flex flex-wrap items-center gap-1 text-xs text-fg-subtle">
      <a href="/todo{{ focus_qs(none) }}" class="hover:text-success-strong underline">All todos</a>
      {% for b in breadcrumb %}
      <span class="text-fg-ghost">›</span>
      <a href="/todo{{ focus_qs(b.id) }}" class="hover:text-success-strong">#{{ b.id }} {{ b.title }}</a>
      {% endfor %}
      {% if focus_row %}
      <span class="text-fg-ghost">›</span>
      <span class="text-fg font-medium">#{{ focus_row.id }} {{ (focus_row.title or '').split('\n', 1)[0] }}</span>
      {% endif %}
    </nav>
    {% endif %}
    {# When focused: prominent add-child form + mermaid tree toggle so
       the two most common actions on a drilled-in node are one click,
       not two (the ⋯ panel below still works the same). #}
    {% if focus_id and focus_row %}
    <section class="mb-3 rounded-lg border border-line bg-surface p-3">
      <div class="mb-2 text-sm font-semibold" data-node-title>{{ focus_row.title }}</div>
      <form method="post" action="/todo/{{ focus_id }}/children" class="flex items-start gap-2">
        {{ filter_inputs() }}
        <textarea name="text" required rows="2" placeholder="Add a child under #{{ focus_id }}…"
                  class="flex-1 rounded border-line-strong text-sm border px-2 py-1"></textarea>
        <select name="level" class="rounded border-line-strong text-sm border px-1 py-1">
          <option value="subtask">subtask</option>
          <option value="tactical">tactical</option>
          <option value="strategic">strategic</option>
        </select>
        <button class="rounded bg-success-solid text-on-solid text-sm px-3 py-1">+ child</button>
      </form>
      <div class="mt-2 flex items-center gap-1 text-xs">
        <span class="text-fg-faint">Tree diagram:</span>
        {% for d in tree_depths %}
        <a href="/todo{{ state_qs(focus_id, tree_override=d) }}"
           class="px-2 py-0.5 rounded {% if d == tree_depth %}bg-success-muted text-success-strong font-medium{% else %}border border-line-strong text-fg-muted hover:bg-surface-muted{% endif %}">
          {{ d }} deep
        </a>
        {% endfor %}
        {% if tree_depth %}
        <a href="/todo{{ state_qs(focus_id, tree_override=0) }}" class="ml-2 text-fg-subtle hover:text-fg-secondary underline">hide</a>
        {% endif %}
      </div>
      {# Dependencies: the subtree's blocked-by links rendered as a
         depends-on / depended-on-by table (gr548798) — the page draws
         order from the links, so a plan reads as structure, not prose. #}
      {% if focus_deps %}
      <div class="mt-3" data-deps>
        <h3 class="text-xs font-semibold uppercase tracking-wide text-fg-faint mb-1">Dependencies</h3>
        <table class="w-full text-xs">
          <thead>
            <tr class="text-left text-fg-faint">
              <th class="pr-3 py-1 font-medium">Node</th>
              <th class="pr-3 py-1 font-medium">Depends on</th>
              <th class="py-1 font-medium">Depended on by</th>
            </tr>
          </thead>
          <tbody>
            {% for d in focus_deps %}
            <tr class="border-t border-line" data-dep="{{ d.id }}">
              <td class="pr-3 py-1 align-top"><a href="/todo?focus={{ d.id }}" class="font-mono hover:underline">#{{ d.id }}</a> {{ d.title }}</td>
              <td class="pr-3 py-1 align-top">{% for t in d.depends_on %}<a href="/todo?focus={{ t.id }}" class="font-mono hover:underline whitespace-nowrap">#{{ t.id }}</a> {{ t.title }}{{ "; " if not loop.last }}{% endfor %}</td>
              <td class="py-1 align-top">{% for t in d.depended_by %}<a href="/todo?focus={{ t.id }}" class="font-mono hover:underline whitespace-nowrap">#{{ t.id }}</a> {{ t.title }}{{ "; " if not loop.last }}{% endfor %}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}
    </section>
    {% endif %}
    {% if tree_diagram %}
    <section class="scheme-light mb-4 rounded-lg border border-line bg-surface p-3 overflow-x-auto">
      <pre class="mermaid">{{ tree_diagram }}</pre>
    </section>
    <script src="/static/mermaid/mermaid.min.js"></script>
    <script>
      mermaid.initialize({ startOnLoad: true, securityLevel: "strict", theme: "default" });
    </script>
    {% endif %}
    {# ── Vitals strip ──────────────────────────────────────────────
       Counted over the WHOLE tree (routes/todo.py::_tree_summary),
       not the 25 roots this page renders — "is the factory alive" is
       not a per-page question. Each count links to the filter that
       shows exactly those rows, so a non-zero number is one click
       from its cause. #}
    <div class="mb-3 flex flex-wrap items-center gap-2 text-xs" data-tour="todo-vitals">
      <a href="/todo?require=kind%3Ajob&require=STATUS%3Arunning&show_jobs=all"
         class="px-2 py-1 rounded-full border {% if summary.running %}bg-warning-subtle border-warning-strong text-warning-deep{% else %}border-line text-fg-subtle{% endif %}"
         title="jobs currently claimed by a worker">⏱ {{ summary.running }} running</a>
      <a href="/todo?require=kind%3Ajob&require=STATUS%3Aqueued&show_jobs=all"
         class="px-2 py-1 rounded-full border {% if summary.queued %}bg-info-subtle border-info-strong text-info-deep{% else %}border-line text-fg-subtle{% endif %}"
         title="jobs minted and waiting for a worker">{{ summary.queued }} queued</a>
      {% if summary.stuck %}
      <a href="/todo?require=stuck&show_jobs=all"
         class="px-2 py-1 rounded-full border bg-danger-subtle border-danger-strong text-danger-deep font-medium"
         title="running past PRECIS_STUCK_JOB_HOURS with a dead lease — presumed dead, pending sweeper or claim-time reclaim">⚠ {{ summary.stuck }} stuck</a>
      {% endif %}
      {% if summary.parked %}
      <a href="/todo?require=parked&show_jobs=all"
         class="px-2 py-1 rounded-full border bg-danger-subtle border-danger text-danger-strong"
         title="todos parked behind a failed child job — each shows a ▶ restart on its row">{{ summary.parked }} parked on failure</a>
      {% endif %}
      {% if summary.halted %}
      <a href="/todo?require=halted"
         class="px-2 py-1 rounded-full border border-line-strong text-fg-muted"
         title="subtrees with a halt brake on — the planner mints no ticks under these until ▶">⏸ {{ summary.halted }} halted</a>
      {% endif %}
      {% if summary.oldest_running %}
      <span class="text-fg-faint" title="the longest-running job started {{ summary.oldest_running | abs_ts }}">oldest run {{ summary.oldest_running_for }}</span>
      {% endif %}
      {# Auto-refresh. Off by default and opt-in: this page has editable
         textareas + tag inputs, and a reload that eats half-typed text is
         worse than a stale number. The JS below skips the reload while any
         input is focused for the same reason. #}
      <span class="ml-auto flex items-center gap-2 text-fg-faint">
        <span id="todo-as-of" title="server render time — {{ as_of | abs_ts }}">as of {{ as_of | abs_ts }}</span>
        <button type="button" id="todo-autorefresh"
                class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle"
                title="reload every 30s so a left-open tab stays honest; skipped while you're typing">
          <span data-when-on>⟳ auto 30s</span><span data-when-off>⟳ auto off</span>
        </button>
      </span>
    </div>
    <div class="flex items-center justify-between mb-3">
      <h1 class="text-lg font-semibold">
        {% if focus_id %}Subtree of #{{ focus_id }}{% else %}Todo tree{% endif %}
        {% if focus_id %}
        {# ``/c/td<id>`` lands here via the /r resolver — the handle page
           must link back to the node's fisheye render (gr548796). #}
        <a href="/eye/td{{ focus_id }}"
           class="ml-1 align-middle text-xs font-normal text-info hover:underline"
           title="open td{{ focus_id }} in the fisheye view (/eye)">fisheye ↗</a>
        {% endif %}
      </h1>
      <form method="post" action="/todo/roots" class="flex items-center gap-2"
            x-data="{open:false}">
        {{ filter_inputs() }}
        <template x-if="open">
          <span class="flex items-start gap-2">
            <input name="text" required type="text" placeholder="New strategic root title…"
                   class="rounded-md border-line-strong text-sm px-2 py-1 border w-48" />
            <textarea name="description" rows="2" placeholder="What are we doing / what's in the doc"
                      class="rounded-md border-line-strong text-sm px-2 py-1 border w-48"></textarea>
            <select name="doc_type" class="rounded-md border-line-strong text-sm border px-1 py-1">
              <option value="paper">paper</option>
              <option value="draft" selected>draft</option>
              <option value="pres">pres</option>
              <option value="cfp">cfp</option>
            </select>
            <label class="flex items-center gap-1 text-sm whitespace-nowrap">
              <input type="checkbox" name="start" value="on" />
              Start now
            </label>
            <button class="rounded-md bg-success-solid text-on-solid text-sm px-3 py-1">Add</button>
          </span>
        </template>
        <button type="button" @click="open=!open"
                class="rounded-md border border-line-strong text-sm px-3 py-1 hover:bg-surface-muted">
          + Strategic
        </button>
      </form>
    </div>

    {% if not rows %}
      <p class="text-sm text-fg-subtle">No todos yet. Add a strategic root to begin.</p>
    {% else %}
      <p class="text-xs text-fg-faint mb-2">
        Drag a todo onto another to reparent it; drop on the bar below to promote it to a root.
      </p>
      <!-- Detach-to-root drop zone -->
      <div data-droptop="1"
           class="mb-2 rounded-md border border-dashed border-line-strong text-xs text-fg-faint text-center py-1.5 transition-colors">
        ↥ drop here to move to top level
      </div>
    {% endif %}

    {# T12.2 — Todo-tree filter chips + collapse-all/expand-all. The
       chips toggle classes on #tree which CSS uses to hide matching
       rows. Per-row collapse is below — each row with children gets
       a ▶/▼ toggle; clicking it walks subsequent rows by data-depth
       and hides those deeper than the row's depth. State persists in
       localStorage so a refresh keeps the user's view. #}
    <div class="mb-2 flex items-center gap-1.5 text-xs flex-wrap" id="todo-filter-bar">
      <button type="button" data-filter-toggle="hide-done"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">
        <span data-when-on>👁 done hidden</span><span data-when-off>show / hide done</span>
      </button>
      <button type="button" data-filter-toggle="hide-wont-do"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">
        <span data-when-on>👁 won't-do hidden</span><span data-when-off>show / hide won't-do</span>
      </button>
      <button type="button" data-filter-toggle="only-recurring"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">
        <span data-when-on>🔁 recurring only</span><span data-when-off>recurring only</span>
      </button>
      <button type="button" data-filter-toggle="only-strategic"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">
        <span data-when-on>⭐ strategic only</span><span data-when-off>strategic only</span>
      </button>
      <button type="button" data-filter-toggle="only-jobs"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">
        <span data-when-on>⚙ jobs only</span><span data-when-off>jobs only</span>
      </button>
      <span class="mx-1 text-fg-ghost">|</span>
      <button type="button" id="todo-expand-all"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">▼ expand all</button>
      <button type="button" id="todo-collapse-all"
              class="px-2 py-1 rounded border border-line-strong hover:bg-surface-subtle">▶ collapse all</button>
      <span class="ml-auto text-fg-faint" id="todo-row-count"></span>
    </div>
    {# CSS rules driven by the filter classes on #tree. #}
    <style>
      #tree.hide-done li[data-status="done"] { display: none; }
      #tree.hide-wont-do li[data-status="won't-do"] { display: none; }
      #tree.only-recurring li:not([data-recurring="1"]) { display: none; }
      #tree.only-strategic li:not([data-level="strategic"]) { display: none; }
      #tree.only-jobs li:not([data-kind="job"]) { display: none; }
      /* Collapsed-row marker — JS sets data-row-collapsed on rows
         hidden because an ancestor is collapsed. */
      #tree li[data-row-collapsed="1"] { display: none; }
      /* Markdown-rendered prose (the details body under expand, the
         title hover popover): the linkifier emits bare <ul>/<ol> and
         preflight strips list markers — re-arm them inside .todo-md
         only (gr548796). */
      .todo-md ul { list-style: disc; padding-left: 1.25rem; }
      .todo-md ol { list-style: decimal; padding-left: 1.5rem; }
    </style>
    <ul id="tree" class="divide-y divide-line-subtle rounded-lg border border-line bg-surface" data-tour="todo-tree" data-shortcut-scope="list">
      {% for r in rows %}
      {% include "todo/_row.html.j2" %}
      {% endfor %}
    </ul>
  </section>

  <!-- Doable (1/3) -->
  <section data-tour="todo-doable">
    <h2 class="text-lg font-semibold mb-3">{% if focus_id %}Doable under #{{ focus_id }}{% else %}Doable next{% endif %}</h2>
    <pre class="rounded-lg border border-line bg-surface p-3 text-xs whitespace-pre-wrap text-fg-secondary overflow-x-auto">{{ doable_body }}</pre>
  </section>

</div>
<style>
  [x-cloak]{display:none!important}
  .drop-target{background-color:rgb(var(--bg-info-muted));outline:2px solid rgb(var(--border-info-emphasis));outline-offset:-2px}
</style>
<script>
(function () {
  // Drag-to-reparent. A todo <li> is the draggable; dropping it on
  // another todo <li> (or the top-level bar) POSTs to /todo/{id}/move,
  // which dispatches link(rel='parent') with the tree guards. We submit
  // a real form (full reload) to stay consistent with the no-SPA UI.
  let draggingId = null;

  // The current filter / focus / show_jobs state, threaded through
  // the synthetic DnD form so a drag-reparent lands back on the same
  // view instead of resetting.
  const REQUIRE = {{ require_tags|tojson }};
  const EXCLUDE = {{ exclude_tags|tojson }};
  const FOCUS = {{ focus_id|tojson }};
  const SHOW_JOBS = {{ show_jobs|tojson }};

  function moveTask(childId, newParentId) {
    if (childId == null) return;
    if (String(childId) === String(newParentId)) return;  // no-op onto self
    const f = document.createElement('form');
    f.method = 'post';
    f.action = '/todo/' + childId + '/move';
    const inp = document.createElement('input');
    inp.type = 'hidden';
    inp.name = 'new_parent_id';
    inp.value = newParentId == null ? '' : String(newParentId);
    f.appendChild(inp);
    REQUIRE.forEach(function (t) {
      const h = document.createElement('input');
      h.type = 'hidden'; h.name = 'require'; h.value = t;
      f.appendChild(h);
    });
    EXCLUDE.forEach(function (t) {
      const h = document.createElement('input');
      h.type = 'hidden'; h.name = 'exclude'; h.value = t;
      f.appendChild(h);
    });
    if (FOCUS != null) {
      const h = document.createElement('input');
      h.type = 'hidden'; h.name = 'focus'; h.value = String(FOCUS);
      f.appendChild(h);
    }
    if (SHOW_JOBS && SHOW_JOBS !== 'active') {
      const h = document.createElement('input');
      h.type = 'hidden'; h.name = 'show_jobs'; h.value = String(SHOW_JOBS);
      f.appendChild(h);
    }
    document.body.appendChild(f);
    f.submit();
  }

  document.querySelectorAll('#tree li[draggable="true"]').forEach(function (li) {
    li.addEventListener('dragstart', function (e) {
      draggingId = li.dataset.id;
      e.dataTransfer.effectAllowed = 'move';
      e.dataTransfer.setData('text/plain', draggingId);
    });
    li.addEventListener('dragover', function (e) {
      if (draggingId && draggingId !== li.dataset.id) {
        e.preventDefault();
        li.classList.add('drop-target');
      }
    });
    li.addEventListener('dragleave', function () {
      li.classList.remove('drop-target');
    });
    li.addEventListener('drop', function (e) {
      e.preventDefault();
      li.classList.remove('drop-target');
      moveTask(draggingId, li.dataset.id);
    });
  });

  const top = document.querySelector('[data-droptop]');
  if (top) {
    top.addEventListener('dragover', function (e) {
      if (draggingId) { e.preventDefault(); top.classList.add('drop-target'); }
    });
    top.addEventListener('dragleave', function () { top.classList.remove('drop-target'); });
    top.addEventListener('drop', function (e) {
      e.preventDefault();
      top.classList.remove('drop-target');
      moveTask(draggingId, '');  // empty parent = detach to root
    });
  }
})();
</script>

<script>
/* T12.2 — Todo-tree filter chips + per-row collapse.
   No backend, no Alpine; localStorage persists view state. */
(function () {
  const TREE = document.getElementById('tree');
  if (!TREE) return;
  const BAR = document.getElementById('todo-filter-bar');
  const ROW_COUNT_BADGE = document.getElementById('todo-row-count');

  // ---- filter chip toggle ------------------------------------------
  const FILTER_STORAGE_KEY = 'precis.todo.filters';
  function loadFilters() {
    try {
      const raw = localStorage.getItem(FILTER_STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch (_) { return {}; }
  }
  function saveFilters(filters) {
    try { localStorage.setItem(FILTER_STORAGE_KEY, JSON.stringify(filters)); } catch (_) {}
  }
  function applyFilters() {
    const filters = loadFilters();
    Object.keys({
      'hide-done': 1, 'hide-wont-do': 1, 'only-recurring': 1,
      'only-strategic': 1, 'only-jobs': 1,
    }).forEach(function (cls) {
      TREE.classList.toggle(cls, !!filters[cls]);
    });
    // Reflect chip on/off state in the button labels.
    BAR.querySelectorAll('[data-filter-toggle]').forEach(function (btn) {
      const cls = btn.dataset.filterToggle;
      const on = !!filters[cls];
      btn.classList.toggle('bg-success-solid', on);
      btn.classList.toggle('text-on-solid', on);
      btn.classList.toggle('border-success-solid', on);
      const onSpan = btn.querySelector('[data-when-on]');
      const offSpan = btn.querySelector('[data-when-off]');
      if (onSpan && offSpan) {
        onSpan.style.display = on ? '' : 'none';
        offSpan.style.display = on ? 'none' : '';
      }
    });
    updateRowCount();
  }
  BAR.addEventListener('click', function (e) {
    const btn = e.target.closest('[data-filter-toggle]');
    if (!btn) return;
    const filters = loadFilters();
    filters[btn.dataset.filterToggle] = !filters[btn.dataset.filterToggle];
    saveFilters(filters);
    applyFilters();
  });

  // ---- per-row collapse --------------------------------------------
  const COLLAPSE_STORAGE_KEY = 'precis.todo.collapsed';
  function loadCollapsed() {
    try {
      const raw = localStorage.getItem(COLLAPSE_STORAGE_KEY);
      return raw ? new Set(JSON.parse(raw)) : new Set();
    } catch (_) { return new Set(); }
  }
  function saveCollapsed(s) {
    try { localStorage.setItem(COLLAPSE_STORAGE_KEY, JSON.stringify(Array.from(s))); } catch (_) {}
  }

  // Build the "has children?" lookup from the flat row list. A row has
  // children if the next row's depth is greater than its own.
  const rows = Array.from(TREE.querySelectorAll('li[data-id]'));
  const hasChildren = new Map();
  for (let i = 0; i < rows.length; i++) {
    const d = parseInt(rows[i].dataset.depth || '0', 10);
    const nd = i + 1 < rows.length ? parseInt(rows[i + 1].dataset.depth || '0', 10) : -1;
    hasChildren.set(rows[i].dataset.id, nd > d);
  }
  // Inject toggle buttons on rows with children.
  rows.forEach(function (row) {
    if (!hasChildren.get(row.dataset.id)) return;
    const firstFlex = row.querySelector('div.flex');
    if (!firstFlex) return;
    const btn = document.createElement('button');
    btn.type = 'button';
    btn.className = 'text-xs w-5 text-fg-faint hover:text-fg-secondary shrink-0';
    btn.dataset.collapseToggle = row.dataset.id;
    btn.textContent = '▼';
    btn.title = 'collapse / expand subtree';
    // Insert immediately after the indent padding (as the first child).
    firstFlex.insertBefore(btn, firstFlex.firstChild);
  });
  function applyCollapsed() {
    const collapsed = loadCollapsed();
    let hideUntilDepth = -1;
    for (let i = 0; i < rows.length; i++) {
      const row = rows[i];
      const d = parseInt(row.dataset.depth || '0', 10);
      if (hideUntilDepth >= 0 && d > hideUntilDepth) {
        row.dataset.rowCollapsed = '1';
      } else {
        delete row.dataset.rowCollapsed;
        hideUntilDepth = -1;
      }
      // Update the toggle marker on this row if it has children.
      const btn = row.querySelector('[data-collapse-toggle]');
      if (btn) {
        const isCollapsed = collapsed.has(row.dataset.id);
        btn.textContent = isCollapsed ? '▶' : '▼';
        if (isCollapsed && hideUntilDepth < 0) hideUntilDepth = d;
      }
    }
    updateRowCount();
  }
  TREE.addEventListener('click', function (e) {
    const btn = e.target.closest('[data-collapse-toggle]');
    if (!btn) return;
    e.preventDefault();
    const id = btn.dataset.collapseToggle;
    const collapsed = loadCollapsed();
    if (collapsed.has(id)) collapsed.delete(id);
    else collapsed.add(id);
    saveCollapsed(collapsed);
    applyCollapsed();
  });
  document.getElementById('todo-collapse-all').addEventListener('click', function () {
    const collapsed = new Set();
    rows.forEach(function (row) {
      if (hasChildren.get(row.dataset.id)) collapsed.add(row.dataset.id);
    });
    saveCollapsed(collapsed);
    applyCollapsed();
  });
  document.getElementById('todo-expand-all').addEventListener('click', function () {
    saveCollapsed(new Set());
    applyCollapsed();
  });

  // ---- visible row counter -----------------------------------------
  function updateRowCount() {
    if (!ROW_COUNT_BADGE) return;
    const total = rows.length;
    const visible = rows.filter(function (r) {
      return getComputedStyle(r).display !== 'none';
    }).length;
    ROW_COUNT_BADGE.textContent =
      visible === total ? total + ' rows' : visible + ' / ' + total + ' rows';
  }

  applyFilters();
  applyCollapsed();
})();
</script>

<script>
/* Auto-refresh + a ticking staleness clock for the vitals strip.

   Separate from the tree script above, which early-returns when there
   are no rows — an empty tree is exactly when you most want to know
   whether the page is live or a tab you left open on Tuesday. */
(function () {
  const BTN = document.getElementById('todo-autorefresh');
  const AS_OF = document.getElementById('todo-as-of');
  if (!BTN || !AS_OF) return;
  const KEY = 'precis.todo.autorefresh';
  const RENDERED_AT = Date.now();
  const BASE_LABEL = AS_OF.textContent;

  function isOn() {
    try { return localStorage.getItem(KEY) === '1'; } catch (_) { return false; }
  }
  function paint() {
    const on = isOn();
    BTN.classList.toggle('bg-success-solid', on);
    BTN.classList.toggle('text-on-solid', on);
    BTN.classList.toggle('border-success-solid', on);
    const onSpan = BTN.querySelector('[data-when-on]');
    const offSpan = BTN.querySelector('[data-when-off]');
    if (onSpan && offSpan) {
      onSpan.style.display = on ? '' : 'none';
      offSpan.style.display = on ? 'none' : '';
    }
  }
  BTN.addEventListener('click', function () {
    try { localStorage.setItem(KEY, isOn() ? '0' : '1'); } catch (_) {}
    paint();
  });

  // Age the render in place, so a stale tab says so whether or not
  // auto-refresh is on.
  function tickAge() {
    const secs = Math.round((Date.now() - RENDERED_AT) / 1000);
    AS_OF.textContent = secs < 30 ? BASE_LABEL : BASE_LABEL + ' · ' +
      (secs < 90 ? secs + 's' : secs < 5400 ? Math.round(secs / 60) + 'm'
                                            : Math.round(secs / 3600) + 'h') + ' old';
  }
  setInterval(tickAge, 15000);

  // Never reload out from under a half-typed tag / edited todo body.
  function isTyping() {
    const el = document.activeElement;
    if (!el) return false;
    const tag = (el.tagName || '').toLowerCase();
    return tag === 'input' || tag === 'textarea' || tag === 'select' || el.isContentEditable;
  }
  setInterval(function () {
    if (isOn() && !isTyping()) window.location.reload();
  }, 30000);

  paint();
})();
</script>
{% endblock %}

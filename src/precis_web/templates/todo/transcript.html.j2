{% extends "base.html.j2" %}
{% block title %}LLM transcript{% endblock %}
{% block content %}
<div class="mb-3 flex items-center justify-between">
  <h1 class="text-lg font-semibold">LLM transcript</h1>
  <a href="/todo?focus={{ ref_id }}" class="text-sm text-fg-subtle underline">← todo</a>
</div>

{% if missing %}
<p class="text-sm text-fg-subtle">
  No transcript stored for #{{ ref_id }}. Transcripts are captured for
  <code>plan_tick</code> runs and kept ~30 days; older ones are GC'd, and
  runs from before transcript-logging shipped have none.
</p>
{% else %}
<p class="mb-3 text-xs text-fg-faint">job #{{ job_id }} · {{ turns | length }} turn(s)</p>
<div class="space-y-2">
  {% for t in turns %}
  <div class="rounded-lg border p-2 text-sm
              {% if t.role == 'assistant' %}border-info bg-info-subtle
              {% elif t.role == 'tool_result' %}border-line bg-surface-subtle
              {% else %}border-success bg-success-subtle{% endif %}">
    <div class="mb-1 font-mono text-[10px] uppercase tracking-wide
                {% if t.role == 'assistant' %}text-info-strong
                {% elif t.role == 'tool_result' %}text-fg-subtle
                {% else %}text-success-strong{% endif %}">
      {{ 'assistant' if t.role == 'assistant' else ('tool result' if t.role == 'tool_result' else 'final result') }}
    </div>
    {% if t.text %}
    <p class="whitespace-pre-wrap break-words text-fg">{{ t.text }}</p>
    {% endif %}
    {% for tool in t.tools %}
    <div class="mt-1 rounded bg-surface/70 px-2 py-1 font-mono text-xs text-fg-muted">
      <span class="text-accent-strong">⚙ {{ tool.name }}</span>
      <span class="break-all text-fg-subtle">{{ tool.input }}</span>
    </div>
    {% endfor %}
  </div>
  {% endfor %}
</div>
{% endif %}
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Categorizers{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">Categorizers</h1>
<p class="text-sm text-slate-500 mb-4">
  Every axis (<code>src/precis/data/axes/*.yaml</code>, closed-vocabulary,
  chunk- or paper/patent-level) and topic (<code>src/precis/data/topics/*.yaml</code>,
  paper/patent multi-label) the corpus can carry, in one inventory. The
  On / Off / Default control live-flips the governing
  <code>service_config</code> row (all hosts) — every worker node picks a
  flip up within one cache TTL, no redeploy.
</p>

{% if topics_globally_off %}
<div class="rounded-lg border border-amber-200 bg-amber-50 text-amber-700 px-4 py-2 text-xs mb-4">
  ⚠ Global kill-switch: <code>classify_topics</code> is force-disabled — no
  topic runs regardless of its per-topic toggle.
</div>
{% endif %}

<div class="rounded-lg border border-slate-200 bg-white px-4 py-2 mb-4 flex items-center gap-3 text-xs">
  <span class="flex-1">
    <span class="font-semibold text-slate-700">Topic classification — global kill-switch</span>
    <span class="block text-[11px] text-slate-400 mt-0.5">
      Governs every topic above: an explicit Off force-disables all topics
      regardless of their own toggle; Default reverts to "runs if any topic
      is on".
    </span>
  </span>
  <span class="w-20 shrink-0">
    {% if kill_switch.enabled %}
    <span class="inline-flex items-center rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 font-medium">active</span>
    {% else %}
    <span class="inline-flex items-center rounded-full bg-amber-100 text-amber-700 px-2 py-0.5 font-medium">off</span>
    {% endif %}
    {% if kill_switch.overridden %}
    <span class="block text-[10px] text-slate-400 mt-0.5">override</span>
    {% else %}
    <span class="block text-[10px] text-slate-400 mt-0.5">default</span>
    {% endif %}
  </span>
  <span class="w-56 shrink-0 flex items-center gap-1">
    <form method="post" action="/categorizers/toggle" class="inline">
      <input type="hidden" name="service" value="{{ kill_switch.service }}">
      <input type="hidden" name="action" value="on">
      <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-emerald-400 bg-emerald-50 text-emerald-700' if kill_switch.enabled else 'border-slate-200 text-slate-500 hover:bg-slate-50' }}">On</button>
    </form>
    <form method="post" action="/categorizers/toggle" class="inline">
      <input type="hidden" name="service" value="{{ kill_switch.service }}">
      <input type="hidden" name="action" value="off">
      <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-amber-400 bg-amber-50 text-amber-700' if not kill_switch.enabled else 'border-slate-200 text-slate-500 hover:bg-slate-50' }}">Off</button>
    </form>
    <form method="post" action="/categorizers/toggle" class="inline">
      <input type="hidden" name="service" value="{{ kill_switch.service }}">
      <input type="hidden" name="action" value="default">
      <button type="submit" class="px-2 py-0.5 rounded border border-slate-200 text-slate-400 hover:bg-slate-50">Default</button>
    </form>
  </span>
</div>

<div class="flex items-center justify-between mb-2">
  <div class="flex items-center gap-3 text-[11px] text-slate-400">
    <span class="flex items-center gap-1"><span class="inline-block w-3 h-2 rounded-sm bg-emerald-500"></span>done</span>
    <span class="flex items-center gap-1"><span class="inline-block w-3 h-2 rounded-sm bg-sky-500"></span>pending</span>
  </div>
  <button hx-get="/categorizers/progress" hx-trigger="click" hx-swap="none"
          class="px-2 py-0.5 rounded border border-slate-200 text-slate-500 hover:bg-slate-50 text-xs">↻ refresh coverage</button>
</div>

<div class="rounded-lg border border-slate-200 bg-white divide-y divide-slate-100 mb-8">
  <div class="px-4 py-2 text-[11px] font-semibold text-slate-500 flex items-center gap-3">
    <span class="w-32 shrink-0">Name</span>
    <span class="flex-1">What it categorizes</span>
    <span class="w-28 shrink-0">Granularity</span>
    <span class="w-20 shrink-0">Active</span>
    <span class="w-44 shrink-0">Prereqs</span>
    <span class="w-56 shrink-0">Toggle</span>
    <span class="w-24 shrink-0 text-right">Last run</span>
  </div>
  {% for row in axes + topics %}
  <div class="px-4 py-2 text-xs" data-categorizer="{{ row.name }}" data-kind="{{ row.kind }}" data-service="{{ row.service }}">
    <div class="flex items-center gap-3">
    <span class="w-32 shrink-0 font-mono text-slate-700 relative group inline-flex items-center gap-0.5">
      {{ row.name }}
      <sup class="text-slate-400 cursor-help select-none">ⓘ</sup>
      <span class="hidden group-hover:block absolute left-0 top-full mt-1 z-10 w-[34rem] max-w-[90vw] rounded-md border border-slate-200 bg-white shadow-lg p-2 text-[11px] font-sans normal-case text-slate-600 leading-snug">
        {{ row.question }}
        {% if row.prompt_preview %}
        <div class="mt-1.5 border-t border-slate-100 pt-1.5">
          <div class="text-[10px] font-semibold text-slate-400 uppercase tracking-wide">System</div>
          <pre class="mt-0.5 max-h-24 overflow-auto whitespace-pre-wrap break-words font-mono text-[10px] text-slate-500 bg-slate-50 rounded p-1">{{ row.prompt_preview.system }}</pre>
          <div class="mt-1 text-[10px] font-semibold text-slate-400 uppercase tracking-wide">Prompt</div>
          <pre class="mt-0.5 max-h-56 overflow-auto whitespace-pre-wrap break-words font-mono text-[10px] text-slate-600 bg-slate-50 rounded p-1">{{ row.prompt_preview.user }}</pre>
        </div>
        {% endif %}
      </span>
    </span>
    <span class="flex-1 text-slate-600">
      {{ row.question }}
      {% if row.shared_note %}
      <span class="block text-[11px] text-slate-400 mt-0.5">{{ row.shared_note }}</span>
      {% endif %}
    </span>
    <span class="w-28 shrink-0 text-slate-500">{{ row.granularity }}</span>
    <span class="w-20 shrink-0">
      {% if row.status == 'active' %}
      <span class="inline-flex items-center rounded-full bg-emerald-100 text-emerald-700 px-2 py-0.5 font-medium">active</span>
      {% else %}
      <span class="inline-flex items-center rounded-full bg-amber-100 text-amber-700 px-2 py-0.5 font-medium">off</span>
      {% endif %}
      {% if row.overridden %}
      <span class="block text-[10px] text-slate-400 mt-0.5">override</span>
      {% else %}
      <span class="block text-[10px] text-slate-400 mt-0.5">default</span>
      {% endif %}
    </span>
    <span class="w-44 shrink-0 text-slate-400">
      {% if row.prereq %}{{ row.prereq | join(', ') }}{% else %}—{% endif %}
    </span>
    <span class="w-56 shrink-0 flex items-center gap-1">
      <form method="post" action="/categorizers/toggle" class="inline">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="hidden" name="action" value="on">
        <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-emerald-400 bg-emerald-50 text-emerald-700' if row.active else 'border-slate-200 text-slate-500 hover:bg-slate-50' }}">On</button>
      </form>
      <form method="post" action="/categorizers/toggle" class="inline">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="hidden" name="action" value="off">
        <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-amber-400 bg-amber-50 text-amber-700' if not row.active else 'border-slate-200 text-slate-500 hover:bg-slate-50' }}">Off</button>
      </form>
      <form method="post" action="/categorizers/toggle" class="inline">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="hidden" name="action" value="default">
        <button type="submit" class="px-2 py-0.5 rounded border border-slate-200 text-slate-400 hover:bg-slate-50">Default</button>
      </form>
    </span>
    <span class="w-24 shrink-0 text-right text-slate-400 tabular-nums" id="lastproc-{{ row.name }}" title="last tag written">…</span>
    </div>
    <div class="mt-1 pl-32 pr-2" id="cov-{{ row.name }}"><span class="text-[11px] text-slate-300">loading coverage…</span></div>
    {% if row.chips %}
    <div class="mt-1 pl-32 flex flex-wrap gap-1">
      {% for chip in row.chips %}
      <a href="{{ chip.url }}" title="papers tagged {{ chip.tag }}"
         class="inline-flex items-center rounded-full border border-slate-200 bg-slate-50 px-2 py-0.5 text-[11px] text-slate-600 hover:bg-slate-100 hover:border-slate-300">{{ chip.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>

<div hx-get="/categorizers/progress" hx-trigger="load" hx-swap="none"></div>
{% endblock %}

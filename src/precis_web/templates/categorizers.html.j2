{% extends "base.html.j2" %}
{% block title %}Categorizers{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">Categorizers</h1>
<p class="text-sm text-fg-subtle mb-4">
  Every axis (<code>src/precis/data/axes/*.yaml</code>, closed-vocabulary,
  chunk- or paper/patent-level) and topic (<code>src/precis/data/topics/*.yaml</code>,
  paper/patent multi-label) the corpus can carry, in one inventory. The
  On / Off / Default control live-flips the governing
  <code>service_config</code> row (all hosts) — every worker node picks a
  flip up within one cache TTL, no redeploy.
</p>

{% if topics_globally_off %}
<div class="rounded-lg border border-warning bg-warning-subtle text-warning-strong px-4 py-2 text-xs mb-4">
  ⚠ Global kill-switch: <code>classify_topics</code> is force-disabled — no
  topic runs regardless of its per-topic toggle.
</div>
{% endif %}

<div class="rounded-lg border border-line bg-surface px-4 py-2 mb-4 flex items-center gap-3 text-xs">
  <span class="flex-1">
    <span class="font-semibold text-fg-secondary">Topic classification — global kill-switch</span>
    <span class="block text-[11px] text-fg-faint mt-0.5">
      Governs every topic above: an explicit Off force-disables all topics
      regardless of their own toggle; Default reverts to "runs if any topic
      is on".
    </span>
  </span>
  <span class="w-20 shrink-0">
    {% if kill_switch.enabled %}
    <span class="inline-flex items-center rounded-full bg-success-muted text-success-strong px-2 py-0.5 font-medium">active</span>
    {% else %}
    <span class="inline-flex items-center rounded-full bg-warning-muted text-warning-strong px-2 py-0.5 font-medium">off</span>
    {% endif %}
    {% if kill_switch.overridden %}
    <span class="block text-[10px] text-fg-faint mt-0.5">override</span>
    {% else %}
    <span class="block text-[10px] text-fg-faint mt-0.5">default</span>
    {% endif %}
  </span>
  <span class="w-56 shrink-0 flex items-center gap-1">
    <form method="post" action="/categorizers/toggle" class="inline">
      <input type="hidden" name="service" value="{{ kill_switch.service }}">
      <input type="hidden" name="action" value="on">
      <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-success-emphasis bg-success-subtle text-success-strong' if kill_switch.enabled else 'border-line text-fg-subtle hover:bg-surface-subtle' }}">On</button>
    </form>
    <form method="post" action="/categorizers/toggle" class="inline">
      <input type="hidden" name="service" value="{{ kill_switch.service }}">
      <input type="hidden" name="action" value="off">
      <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-warning-emphasis bg-warning-subtle text-warning-strong' if not kill_switch.enabled else 'border-line text-fg-subtle hover:bg-surface-subtle' }}">Off</button>
    </form>
    <form method="post" action="/categorizers/toggle" class="inline">
      <input type="hidden" name="service" value="{{ kill_switch.service }}">
      <input type="hidden" name="action" value="default">
      <button type="submit" class="px-2 py-0.5 rounded border border-line text-fg-faint hover:bg-surface-subtle">Default</button>
    </form>
  </span>
</div>

<div class="flex items-center justify-between mb-2">
  <div class="flex items-center gap-3 text-[11px] text-fg-faint">
    <span class="flex items-center gap-1"><span class="inline-block w-3 h-2 rounded-sm bg-success-solid-soft"></span>done</span>
    <span class="flex items-center gap-1"><span class="inline-block w-3 h-2 rounded-sm bg-info-solid-soft"></span>pending</span>
  </div>
  <button hx-get="/categorizers/progress" hx-trigger="click" hx-swap="none"
          class="px-2 py-0.5 rounded border border-line text-fg-subtle hover:bg-surface-subtle text-xs">↻ refresh coverage</button>
</div>

<div class="rounded-lg border border-line bg-surface divide-y divide-line-subtle mb-8">
  <div class="px-4 py-2 text-[11px] font-semibold text-fg-subtle flex items-center gap-3">
    <span class="w-32 shrink-0">Name</span>
    <span class="flex-1">What it categorizes</span>
    <span class="w-28 shrink-0">Granularity</span>
    <span class="w-20 shrink-0">Active</span>
    <span class="w-44 shrink-0">Prereqs</span>
    <span class="w-72 shrink-0">Toggle</span>
    <span class="w-24 shrink-0 text-right">Last run</span>
  </div>
  {% for row in axes + topics %}
  <div class="px-4 py-2 text-xs" data-categorizer="{{ row.name }}" data-kind="{{ row.kind }}" data-service="{{ row.service }}">
    <div class="flex items-center gap-3">
    <span class="w-32 shrink-0 font-mono text-fg-secondary relative group inline-flex items-center gap-0.5">
      {{ row.name }}
      <sup class="text-fg-faint cursor-help select-none">ⓘ</sup>
      <span class="hidden group-hover:block absolute left-0 top-full mt-1 z-10 w-[34rem] max-w-[90vw] rounded-md border border-line bg-surface shadow-lg p-2 text-[11px] font-sans normal-case text-fg-muted leading-snug">
        {{ row.question }}
        {% if row.prompt_preview %}
        <div class="mt-1.5 border-t border-line-subtle pt-1.5">
          <div class="text-[10px] font-semibold text-fg-faint uppercase tracking-wide">System</div>
          <pre class="mt-0.5 max-h-24 overflow-auto whitespace-pre-wrap break-words font-mono text-[10px] text-fg-subtle bg-surface-subtle rounded p-1">{{ row.prompt_preview.system }}</pre>
          <div class="mt-1 text-[10px] font-semibold text-fg-faint uppercase tracking-wide">Prompt</div>
          <pre class="mt-0.5 max-h-56 overflow-auto whitespace-pre-wrap break-words font-mono text-[10px] text-fg-muted bg-surface-subtle rounded p-1">{{ row.prompt_preview.user }}</pre>
        </div>
        {% endif %}
      </span>
    </span>
    <span class="flex-1 text-fg-muted">
      {{ row.question }}
      {% if row.shared_note %}
      <span class="block text-[11px] text-fg-faint mt-0.5">{{ row.shared_note }}</span>
      {% endif %}
    </span>
    <span class="w-28 shrink-0 text-fg-subtle">{{ row.granularity }}</span>
    <span class="w-20 shrink-0">
      {% if row.status == 'active' %}
      <span class="inline-flex items-center rounded-full bg-success-muted text-success-strong px-2 py-0.5 font-medium">active</span>
      {% else %}
      <span class="inline-flex items-center rounded-full bg-warning-muted text-warning-strong px-2 py-0.5 font-medium">off</span>
      {% endif %}
      {% if row.overridden %}
      <span class="block text-[10px] text-fg-faint mt-0.5">override</span>
      {% else %}
      <span class="block text-[10px] text-fg-faint mt-0.5">default</span>
      {% endif %}
    </span>
    <span class="w-44 shrink-0 text-fg-faint">
      {% if row.prereq %}{{ row.prereq | join(', ') }}{% else %}—{% endif %}
    </span>
    <span class="w-72 shrink-0 flex items-center gap-1">
      <form method="post" action="/categorizers/toggle" class="inline">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="hidden" name="action" value="on">
        <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-success-emphasis bg-success-subtle text-success-strong' if row.active else 'border-line text-fg-subtle hover:bg-surface-subtle' }}">On</button>
      </form>
      <form method="post" action="/categorizers/toggle" class="inline">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="hidden" name="action" value="off">
        <button type="submit" class="px-2 py-0.5 rounded border {{ 'border-warning-emphasis bg-warning-subtle text-warning-strong' if not row.active else 'border-line text-fg-subtle hover:bg-surface-subtle' }}">Off</button>
      </form>
      <form method="post" action="/categorizers/toggle" class="inline">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="hidden" name="action" value="default">
        <button type="submit" class="px-2 py-0.5 rounded border border-line text-fg-faint hover:bg-surface-subtle">Default</button>
      </form>
      <form method="post" action="/categorizers/concurrency" class="inline flex items-center gap-0.5"
            title="in-pass LLM-call concurrency (thread-pool width); 1 = serial">
        <input type="hidden" name="service" value="{{ row.service }}">
        <input type="number" name="concurrency" min="1" value="{{ row.concurrency }}"
               class="w-12 px-1 py-0.5 rounded border border-line text-fg-muted text-xs">
        <button type="submit" class="px-1.5 py-0.5 rounded border border-line text-fg-faint hover:bg-surface-subtle">set</button>
      </form>
    </span>
    <span class="w-24 shrink-0 text-right text-fg-faint tabular-nums" id="lastproc-{{ row.name }}" title="last tag written">…</span>
    </div>
    <div class="mt-1 pl-32 pr-2" id="cov-{{ row.name }}"><span class="text-[11px] text-fg-ghost">loading coverage…</span></div>
    {% if row.chips %}
    <div class="mt-1 pl-32 flex flex-wrap gap-1">
      {% for chip in row.chips %}
      <a href="{{ chip.url }}" title="papers tagged {{ chip.tag }}"
         class="inline-flex items-center rounded-full border border-line bg-surface-subtle px-2 py-0.5 text-[11px] text-fg-muted hover:bg-surface-muted hover:border-line-strong">{{ chip.label }}</a>
      {% endfor %}
    </div>
    {% endif %}
  </div>
  {% endfor %}
</div>

<div hx-get="/categorizers/progress" hx-trigger="load" hx-swap="none"></div>
{% endblock %}

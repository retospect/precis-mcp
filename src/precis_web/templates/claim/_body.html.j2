{# The claim page's whole body, factored out of ``claim/view.html.j2`` so the
   full page and the ``/claim/<head>/fragment`` route render the SAME markup
   (the byte-identical rule ``smartdraft/_blocks.html.j2`` states). The
   /nanopub workbench swaps this fragment straight into its review pane —
   there is no iframe, so this must carry no page chrome and no <html>. #}
{% import "_paper_head.html.j2" as ph %}
{% if missing %}
<div class="rounded-lg border border-line bg-surface p-4 text-sm text-fg-muted">
  No claim hub for <span class="font-mono">{{ head }}</span>.
</div>
{% else %}

{# tex-scope: claim sentences may carry $…$/$$…$$ TeX; base.html.j2's
   init script runs client-side KaTeX over any tex-scope element on load
   and after htmx swaps. Reversal (2026-08-28, Reto): titles WERE kept
   plain text under the 2026-08-04 "Already decided" policy (679393c9),
   until a real hub (fi236297) rendered raw $math$ in its title — Reto
   asked for math-processing on claim titles too, superseding that call.
   `tagline` (precis.workers.hub_tagline) is a 3-6 word human handle for
   the hub, presentation metadata on `refs.meta` — never part of the claim
   string/URI. Absent (`None`) → exactly the pre-tagline h1, no placeholder,
   no layout shift. Present → styled as a visually-leading prefix, the full
   AIDA sentence following. #}
<h1 class="tex-scope text-lg font-semibold text-fg leading-snug">
  {% if tagline %}<span class="text-info-strong">{{ tagline }}:</span> {% endif %}{{ claim }}
</h1>
<p class="mt-1 text-xs text-fg-faint">
  <span class="font-mono">{{ head }}</span>
  {% if status %}· status <span class="font-mono">{{ status }}</span>{% endif %}
  {% if np %}· nanopub
  <a class="font-mono text-success hover:underline" href="#review"
     title="publish state — jump to the review-and-sign section below">{{ np.state }}</a>
  {% endif %}
  {# Claim type (precis.taproot.claim_type) + its human reclassification
     door (POST /claim/<head>/type); the empty option clears. #}
  · type <span class="font-mono">{{ claim_type or "unsorted" }}</span>{% if claim_type_by == 'human' %} <span class="text-fg-faint">(human)</span>{% endif %}
  <details class="inline">
    <summary class="inline cursor-pointer hover:text-fg-muted" title="reclassify this claim">reclassify</summary>
    <form method="post" action="/claim/{{ head }}/type" class="mt-1 flex items-center gap-1">
      <select name="claim_type" class="rounded border border-line-strong px-1.5 py-0.5 text-[11px] text-fg-secondary">
        <option value=""{% if not claim_type %} selected{% endif %}>(unsorted)</option>
        {% for t in claim_types %}<option value="{{ t }}"{% if t == claim_type %} selected{% endif %}>{{ t }}</option>
        {% endfor %}
      </select>
      <button type="submit" class="rounded border border-line-strong bg-surface-subtle px-1.5 py-0.5 text-fg-muted hover:bg-surface-muted">save</button>
    </form>
  </details>
  {# The human edit door (POST /claim/<head>/tagline) — tiny, unobtrusive,
     prefilled with the current tagline (empty for "not set yet"). Empty
     submit clears, handing the hub back to the hub_tagline pass. #}
  · <details class="inline">
    <summary class="inline cursor-pointer hover:text-fg-muted" title="edit the tagline">tagline</summary>
    <form method="post" action="/claim/{{ head }}/tagline" class="mt-1 flex items-center gap-1">
      <input name="tagline" value="{{ tagline or '' }}" maxlength="64" autocomplete="off"
             placeholder="3-6 word handle, e.g. Graphene is FET"
             class="w-56 rounded border border-line-strong px-1.5 py-0.5 text-[11px] text-fg-secondary" />
      <button type="submit" class="rounded border border-line-strong bg-surface-subtle px-1.5 py-0.5 text-fg-muted hover:bg-surface-muted">save</button>
    </form>
  </details>
</p>
{% if consensus %}<p class="text-[11px] text-fg-faint">{{ consensus }}</p>{% endif %}

{# Hypothesis falsification prose (docs/backlog/
   hypothesis-cites-render-not-stored.md): real fields, not the raw
   json.dumps the review textarea below still shows — `motivation` (why the
   leap) and `testable_by` (the discriminating experiment), the two things
   `nanopub/gates.py::run_mint_gates` demands in place of grounding passages
   for this artifact type. `hypothesis` is `None` for every ordinary hub. #}
{% if hypothesis %}
<div class="mt-3 rounded-md bg-fuchsia-subtle border border-fuchsia px-3 py-2 text-xs text-fuchsia-deep">
  <p class="font-semibold">◈ Hypothesis — motivation, not evidence</p>
  <p class="mt-1"><span class="font-semibold">motivation:</span>
    {{ hypothesis.motivation if hypothesis.motivation else '(not recorded)' }}</p>
  <p class="mt-1"><span class="font-semibold">falsified by:</span>
    {{ hypothesis.testable_by if hypothesis.testable_by else '(not recorded)' }}</p>
</div>
{% endif %}

{# Refuted lifecycle (docs/backlog/quest-dossier-dialectic.md §"Refuted
   lifecycle"): red = the claim AS STATED is dead, not "this document is
   wrong" — so this reads as a verdict on the sentence above, distinct from
   the amber softener callouts below (which qualify trust, not kill the
   claim). `refuted` is set (possibly with None ruling fields) only when the
   hub carries STATUS:refuted. #}
{% if refuted %}
<p class="mt-3 rounded-md bg-danger-subtle border border-danger px-3 py-2 text-xs text-danger-deep">
  <strong>Refuted</strong> — the claim as stated is dead.
  {% if refuted.ruling_url %}
  Superseded by: <a href="{{ refuted.ruling_url }}" class="text-danger-strong underline decoration-dotted">{{ refuted.ruling_title }}</a>
  {% else %}
  ruling unknown
  {% endif %}
</p>
{% endif %}

{% if np %}
{# The maturity flow graph, left → right — where this claim sits on the
   candidate → published ladder. Hover a rung for what was checked and
   what happened to climb it (the gates list at the bottom has the full
   per-gate readout). #}
<div class="np-ladder mt-3 flex flex-wrap items-center gap-y-1 text-xs" aria-label="claim maturity">
  {% for s in np.ladder %}
  {% if not loop.first %}<span class="mx-1.5 text-fg-ghost">→</span>{% endif %}
  <span class="px-2 py-0.5 rounded-full cursor-help border
    {% if s.blocked %}border-danger-strong bg-danger-muted text-danger-strong font-semibold
    {% elif s.current and s.name == 'published' %}border-success-strong bg-success-muted text-success-strong font-semibold
    {% elif s.current %}border-info-strong bg-info-muted text-info-deep font-semibold
    {% elif s.done %}border-info bg-info-subtle text-info-strong
    {% else %}border-line bg-surface-subtle text-fg-faint{% endif %}"
    title="{{ s.tip }}">{{ '◆ ' if s.blocked }}{{ s.name }}</span>
  {% endfor %}
</div>
{% endif %}

{# Discussion — deliberately above the fold (the follow-up box is the
   claim page's main thinking affordance, not an afterthought). Posts to
   the SAME /refs/finding/<hub_ref_id>/ask route the finding page used;
   that route spawns the agentic pass and redirects to the new conv
   thread (/refs/conv/<id>). `discussions` is a (possibly empty) list on
   the full page, None on surfaces that don't pass it. #}
{% if discussions is not none %}
<section class="mt-4">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Discussion</h2>
  {% if discussions %}
  <ul class="mb-3 rounded-lg border border-line bg-surface divide-y divide-line-subtle">
    {% for d in discussions %}
    <li class="px-3 py-2 text-sm flex items-center gap-2">
      <span class="text-fg-faint">💬</span>
      <a href="{{ d.url }}" class="text-info-strong hover:underline flex-1">{{ d.title }}</a>
      {% if d.chunk is not none %}
      <span class="text-xs font-mono text-fg-faint">on ~{{ d.chunk }}</span>
      {% endif %}
      <span class="text-xs text-fg-faint">{{ d.turns }} turn{{ '' if d.turns == 1 else 's' }}</span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  <form method="post" action="/refs/finding/{{ hub_ref_id }}/ask" class="space-y-2">
    <textarea name="question" rows="2" required
              placeholder="Ask a follow-up about this claim…"
              class="w-full rounded-md border border-line-strong px-3 py-2 text-sm"></textarea>
    <div class="flex items-center gap-2">
      <button class="rounded-md bg-info-solid text-on-solid text-sm px-4 py-2 hover:bg-info-solid-strong">
        Ask &amp; think
      </button>
      <span class="text-xs text-fg-faint">
        runs an agentic <span class="font-mono text-fg-subtle">{{ ask_model | default('sonnet') }}</span> pass
        over the corpus (~30–60s); the answer lands in a linked thread
      </span>
    </div>
  </form>
</section>
{% endif %}

{% if np %}
{% include "claim/_review.html.j2" %}
{% endif %}

{% if inflight %}
<p class="mt-3 rounded-md bg-warning-subtle border border-warning px-3 py-2 text-xs text-warning-deep">
  Still tracing — no citable originator derived yet.
</p>
{% endif %}

{# A claim-level declaration made HERE (Ⓐ/✍, `trust_overridden`) softens an
   otherwise-unverified label; a plain 'unverified' with a note may instead be
   the harden rule (a clean hub grounded only on sources declared unacquirable
   on their OWN Meta tab — a fact, not an assertion, so composing a claim-level
   declaration below still applies). #}
{% if trust_overridden %}
<p class="mt-3 rounded-md bg-warning-subtle border border-warning px-3 py-2 text-xs text-warning-deep">
  {% if status == 'abstract' %}Ⓐ Abstract backs it — declared here, full text
  not verified.{% else %}✍ Author-vouched — declared here, source
  unobtainable.{% endif %}
  {% if trust_note %}<span class="text-warning-strong">— {{ trust_note }}</span>{% endif %}
  <form method="post" action="/claim/{{ head }}/unacquirable" class="mt-1">
    <input type="hidden" name="mode" value="clear" />
    <button type="submit" class="text-warning-strong hover:text-danger underline decoration-dotted"
            title="clear this claim-level declaration">undo</button>
  </form>
</p>
{% elif status == 'unverified' and trust_note %}
<p class="mt-3 rounded-md bg-warning-subtle border border-warning px-3 py-2 text-xs text-warning-deep">
  ⚠ {{ trust_note }}
</p>
{% endif %}

{% if status == 'unverified' %}
{# The claim-level softener control — an author assertion made HERE, about
   THIS claim, never inherited from a source paper's Meta-tab acquirability
   fact (declaring a paper unacquirable there never softens a claim). #}
<form method="post" action="/claim/{{ head }}/unacquirable" class="mt-3 space-y-1 rounded-md border border-line bg-surface px-3 py-2">
  <p class="text-xs text-fg-faint">Can't get a source but the claim is still good? Vouch for it here.</p>
  <input name="note" required autocomplete="off"
         placeholder="why — e.g. abstract confirms the number; source is print-only"
         class="w-full rounded border border-line-strong px-1.5 py-0.5 text-[11px]" />
  <div class="flex flex-wrap gap-2">
    <button type="submit" name="mode" value="abstract"
            class="rounded border border-warning-strong bg-warning-subtle px-2 py-1 text-warning-deep hover:bg-warning-muted"
            title="the abstract on file backs THIS claim — full text not read">Ⓐ Abstract backs it</button>
    <button type="submit" name="mode" value="vouched"
            class="rounded border border-line-strong bg-surface-subtle px-2 py-1 text-fg-secondary hover:bg-surface-muted"
            title="I assert this source makes this claim; source unobtainable">✍ I vouch for it</button>
  </div>
</form>
{% endif %}

{% macro evidence_row(row) %}
<li class="text-sm">
  <p class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5">
  {% if row.starred %}<span class="text-warning-soft" title="prints on export">★</span>{% endif %}
  {# target the shared 'precis-paper' window (same as the nested [pc…]
     passage link and the smartdraft paper cites) so clicking a source
     from the claim window opens/reuses ONE paper window instead of
     navigating the claim page away. NO rel="noopener": per the HTML spec it
     makes the browser treat a named target like _blank, so every click would
     spawn a fresh tab instead of reusing the one 'precis-paper' window. #}
  <a href="/r/paper/{{ row.paper_ref_id }}" target="precis-paper" class="font-mono text-info-strong underline decoration-dotted">{{ row.handle }}</a>
  {# Shared identity header (compact one line): year · title · venue · first … last. #}
  {{ ph.paper_head(row.head, compact=true) }}
  {% if row.unacquirable %}
  {# This paper declared itself unacquirable on its OWN Meta tab — a fact,
     mode-less, that can contribute to the hub-harden rule above. #}
  <span class="text-[11px] rounded bg-warning-muted text-warning-strong px-1.5 py-0.5"
        title="{% if row.unacq_note %}{{ row.unacq_note }}{% else %}source declared unacquirable on its Meta tab{% endif %}">⊘ unacquirable</span>
  {% endif %}
  {% if row.integrity != 'clean' %}
  <span class="text-[11px] rounded bg-danger-muted text-danger-strong px-1.5 py-0.5">⚠ {{ row.integrity }}</span>
  {% endif %}
  </p>
  {# Its grounding passages, nested right below the paper (one listing —
     the separate "Grounding passages" section this replaces repeated
     every pc handle). A passage grounding several papers nests under its
     highest-ranked one and names the rest on its "grounds" line. #}
  {% for c in (passages_by_paper | default({})).get(row.handle, []) %}
  <div class="mt-1 ml-5 text-xs">
    <p class="flex flex-wrap items-baseline gap-x-1.5">
      {% if c.starred %}<span class="text-warning-soft" title="grounds a print-visible source">★</span>{% endif %}
      {% if c.is_chunk %}{{ ('[' ~ c.handle ~ ']') | linkify_refs }}{% else %}<span class="font-mono text-fg-muted">{{ c.handle }}</span>{% endif %}
      <span class="text-fg-faint">grounds
        {% for p in c.papers %}{{ p.handle }} <span class="italic">({{ p.role }})</span>{% if not loop.last %}, {% endif %}{% endfor %}
      </span>
    </p>
    {% if c.quote_html %}
    {# tex-scope: verbatim paper text, which legitimately carries $…$/$$…$$
       TeX — the base.html.j2 init script runs client-side KaTeX over this
       element. The claim title above is tex-scope too now (2026-08-28
       reversal — see its comment). #}
    <blockquote class="tex-scope mt-1 border-l-2 border-line pl-3 text-fg-muted">{{ c.quote_html }}</blockquote>
    {% else %}
    <p class="mt-1 text-fg-faint italic">passage text not available</p>
    {% endif %}
  </div>
  {% endfor %}
</li>
{% endmacro %}

{% set starred_corroborators = corroborators | selectattr('starred') | list %}
{% set unstarred_corroborators = corroborators | rejectattr('starred') | list %}
{% set print_rows = originators + starred_corroborators %}

<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Prints on export ★</h2>
  {% if print_rows %}
  <ul class="space-y-1.5">
    {% for row in print_rows %}
    {{ evidence_row(row) }}
    {% endfor %}
  </ul>
  {% else %}
  <p class="text-sm text-fg-subtle italic">no print-visible sources yet</p>
  {% endif %}
</section>

{% if unstarred_corroborators %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Corroborating evidence</h2>
  <ul class="space-y-1.5">
    {% for row in unstarred_corroborators %}
    {{ evidence_row(row) }}
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if computed %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Computed evidence</h2>
  {# Pathway evidence edges (tier "computed"). Never in the print set — a
     pathway has no cite_key. `stale` = superseded, or the pathway's content
     key moved off the one the citation pinned. #}
  <ul class="space-y-1.5">
    {% for c in computed %}
    <li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 text-sm">
      {% if c.handle %}{{ ('[' ~ c.handle ~ ']') | linkify_refs }}{% endif %}
      <span class="text-[11px] rounded bg-surface-muted text-fg-subtle px-1.5 py-0.5">computed</span>
      {% if c.title %}<span class="text-fg-secondary">{{ c.title }}</span>{% endif %}
      {% if c.content_key %}<span class="font-mono text-[11px] text-fg-faint">key {{ c.content_key }}</span>{% endif %}
      {% if c.stale %}<span class="rounded bg-warning-muted text-warning-deep px-1.5 py-0.5 text-[11px]">⚠ stale: {{ c.stale }}</span>{% endif %}
      {% if c.mismatch %}<span class="rounded bg-danger-muted text-danger-deep px-1.5 py-0.5 text-[11px]">⚠ mismatch: {{ c.mismatch }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if contradictors %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-danger-strong">Contradicting evidence</h2>
  <ul class="space-y-1.5">
    {% for row in contradictors %}
    {{ evidence_row(row) }}
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if citation_misses %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-danger-strong">Citation misses</h2>
  <ul class="space-y-1.5">
    {% for m in citation_misses %}
    <li class="flex flex-wrap items-baseline gap-x-1.5 text-sm text-danger-strong">
      <span class="rounded bg-danger-muted text-danger-strong px-1.5 py-0.5 text-[11px]">⚠ cited source does not support this claim</span>
      {% if m.marker is not none %}<span class="text-fg-subtle">marker [{{ m.marker }}]</span>{% endif %}
      {% if m.cited_ref_id %}<span class="text-fg-faint">· <a href="/r/paper/{{ m.cited_ref_id }}" target="precis-paper" class="font-mono text-info-strong underline decoration-dotted">cited paper</a></span>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if citers %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-fg-secondary">Used by</h2>
  {# Inbound `cites` edges — who invokes this claim. Each links to the citing
     passage via the SAME [handle] | linkify_refs render the grounding
     passages use, so a pc<id> chunk reuses the shared 'precis-paper' window
     (a dc<id> draft chunk opens the draft reader) — the per-kind target is
     chosen in linkify._render_universal_handle, not here. #}
  <ul class="space-y-1.5">
    {% for u in citers %}
    <li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 text-sm">
      {% if u.handle %}
        {% if u.is_chunk %}{{ ('[' ~ u.handle ~ ']') | linkify_refs }}{% else %}<span class="font-mono text-fg-muted">{{ u.handle }}</span>{% endif %}
      {% endif %}
      <span class="text-[11px] rounded bg-surface-muted text-fg-subtle px-1.5 py-0.5">{{ u.kind }}</span>
      {% if u.title %}<span class="tex-scope text-fg-secondary">{% if u.kind in PAPER_IDENT_KINDS %}{{ u.title | title_md | render_markdown }}{% else %}{{ u.title }}{% endif %}</span>{% endif %}
      {% if u.year %}<span class="text-fg-faint">({{ u.year }})</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if coverage_note %}
{# sole_derivative (gr307372) escalates the note from a muted aside to a
   visible warning — the one-supporter-and-it-may-be-derivative case must
   not render as healthy. #}
<p class="mt-6 text-xs {{ 'text-warning-strong font-medium' if sole_derivative else 'text-fg-subtle italic' }}">{{ coverage_note }}</p>
{% endif %}

{% endif %}

{# Nearest-claims list: included inline by _review.html.j2, or served alone
   by GET /claim/<head>/nearest (the lazy-load fragment). #}
{% if np.nearest_note %}
<p class="text-xs text-fg-subtle">{{ np.nearest_note }}</p>
{% elif not np.nearest %}
<p class="text-xs text-fg-subtle">No other claim hubs found nearby.</p>
{% else %}
<ul class="space-y-1.5">
  {% for n in np.nearest %}
  <li class="flex items-center justify-between gap-2 text-xs">
    <span class="grow min-w-0 truncate" title="{{ n.claim }}">
      <span class="px-1.5 py-0.5 rounded font-mono
        {% if n.verdict == 'same' %}bg-danger-muted text-danger-strong
        {% elif n.verdict == 'contradicts' %}bg-warning-muted text-warning-strong
        {% else %}bg-surface-muted text-fg-muted{% endif %}"
        title="dedup_judge: {{ n.verdict }} (confidence {{ '%.2f' | format(n.confidence) }})">{{ n.verdict }}</span>
      <a class="text-success-strong hover:underline" href="/claim/{{ n.handle }}">{{ n.handle }}</a>
      {{ n.claim[:100] }}{% if n.claim|length > 100 %}…{% endif %}
      <span class="text-fg-faint font-mono">d={{ '%.3f' | format(n.distance) }}</span>
    </span>
    {% if n.can_merge %}
    <form method="post" action="/nanopub/fi{{ hub_ref_id }}/merge" class="shrink-0">
      <input type="hidden" name="loser" value="{{ n.hub_ref_id }}">
      <button class="px-2 py-1 rounded border border-line-strong text-fg-muted hover:bg-surface-muted text-xs whitespace-nowrap">Merge into this</button>
    </form>
    {% endif %}
  </li>
  {% endfor %}
</ul>
{% endif %}

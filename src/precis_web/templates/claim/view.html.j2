{% extends "base.html.j2" %}
{% import "_paper_head.html.j2" as ph %}
{% block title %}{% if missing %}Claim {{ head }}{% else %}{{ claim }}{% endif %}{% endblock %}
{% block content %}
{% if missing %}
<div class="rounded-lg border border-slate-200 bg-white p-4 text-sm text-slate-600">
  No claim hub for <span class="font-mono">{{ head }}</span>.
</div>
{% else %}

<h1 class="text-lg font-semibold text-slate-800 leading-snug">{{ claim }}</h1>
<p class="mt-1 text-xs text-slate-400">
  <span class="font-mono">{{ head }}</span>
  {% if status %}· status <span class="font-mono">{{ status }}</span>{% endif %}
  {% if np %}· nanopub
  <a class="font-mono text-emerald-600 hover:underline" href="#review"
     title="publish state — jump to the review-and-sign section below">{{ np.state }}</a>
  {% endif %}
</p>

{% if np %}
{% include "claim/_review.html.j2" %}
{% endif %}

{% if inflight %}
<p class="mt-3 rounded-md bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800">
  Still tracing — no citable originator derived yet.
</p>
{% endif %}

{# A claim-level declaration made HERE (Ⓐ/✍, `trust_overridden`) softens an
   otherwise-unverified label; a plain 'unverified' with a note may instead be
   the harden rule (a clean hub grounded only on sources declared unacquirable
   on their OWN Meta tab — a fact, not an assertion, so composing a claim-level
   declaration below still applies). #}
{% if trust_overridden %}
<p class="mt-3 rounded-md bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800">
  {% if status == 'abstract' %}Ⓐ Abstract backs it — declared here, full text
  not verified.{% else %}✍ Author-vouched — declared here, source
  unobtainable.{% endif %}
  {% if trust_note %}<span class="text-amber-700">— {{ trust_note }}</span>{% endif %}
  <form method="post" action="/claim/{{ head }}/unacquirable" class="mt-1">
    <input type="hidden" name="mode" value="clear" />
    <button type="submit" class="text-amber-700 hover:text-rose-600 underline decoration-dotted"
            title="clear this claim-level declaration">undo</button>
  </form>
</p>
{% elif status == 'unverified' and trust_note %}
<p class="mt-3 rounded-md bg-amber-50 border border-amber-200 px-3 py-2 text-xs text-amber-800">
  ⚠ {{ trust_note }}
</p>
{% endif %}

{% if status == 'unverified' %}
{# The claim-level softener control — an author assertion made HERE, about
   THIS claim, never inherited from a source paper's Meta-tab acquirability
   fact (declaring a paper unacquirable there never softens a claim). #}
<form method="post" action="/claim/{{ head }}/unacquirable" class="mt-3 space-y-1 rounded-md border border-slate-200 bg-white px-3 py-2">
  <p class="text-xs text-slate-400">Can't get a source but the claim is still good? Vouch for it here.</p>
  <input name="note" required autocomplete="off"
         placeholder="why — e.g. abstract confirms the number; source is print-only"
         class="w-full rounded border border-slate-300 px-1.5 py-0.5 text-[11px]" />
  <div class="flex flex-wrap gap-2">
    <button type="submit" name="mode" value="abstract"
            class="rounded border border-amber-300 bg-amber-50 px-2 py-1 text-amber-800 hover:bg-amber-100"
            title="the abstract on file backs THIS claim — full text not read">Ⓐ Abstract backs it</button>
    <button type="submit" name="mode" value="vouched"
            class="rounded border border-slate-300 bg-slate-50 px-2 py-1 text-slate-700 hover:bg-slate-100"
            title="I assert this source makes this claim; source unobtainable">✍ I vouch for it</button>
  </div>
</form>
{% endif %}

{% macro evidence_row(row) %}
<li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 text-sm">
  {% if row.starred %}<span class="text-amber-500" title="prints on export">★</span>{% endif %}
  {# target the shared 'precis-paper' window (same as the grounding-chunk
     [pc…] link below and the smartdraft paper cites) so clicking a source
     from the claim window opens/reuses ONE paper window instead of
     navigating the claim page away. NO rel="noopener": per the HTML spec it
     makes the browser treat a named target like _blank, so every click would
     spawn a fresh tab instead of reusing the one 'precis-paper' window. #}
  <a href="/r/paper/{{ row.paper_ref_id }}" target="precis-paper" class="font-mono text-sky-700 underline decoration-dotted">{{ row.handle }}</a>
  {# Shared identity header (compact one line): year · title · venue · first … last. #}
  {{ ph.paper_head(row.head, compact=true) }}
  {% if row.source_handle %}<span class="text-slate-400">· grounded at {% if row.source_is_chunk %}{{ ('[' ~ row.source_handle ~ ']') | linkify_refs }}{% else %}<span class="font-mono">{{ row.source_handle }}</span>{% endif %}</span>{% endif %}
  {% if row.unacquirable %}
  {# This paper declared itself unacquirable on its OWN Meta tab — a fact,
     mode-less, that can contribute to the hub-harden rule above. #}
  <span class="text-[11px] rounded bg-amber-100 text-amber-700 px-1.5 py-0.5"
        title="{% if row.unacq_note %}{{ row.unacq_note }}{% else %}source declared unacquirable on its Meta tab{% endif %}">⊘ unacquirable</span>
  {% endif %}
  {% if row.integrity != 'clean' %}
  <span class="text-[11px] rounded bg-rose-100 text-rose-700 px-1.5 py-0.5">⚠ {{ row.integrity }}</span>
  {% endif %}
</li>
{% endmacro %}

{% set starred_corroborators = corroborators | selectattr('starred') | list %}
{% set unstarred_corroborators = corroborators | rejectattr('starred') | list %}
{% set print_rows = originators + starred_corroborators %}

<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-slate-700">Prints on export ★</h2>
  {% if print_rows %}
  <ul class="space-y-1.5">
    {% for row in print_rows %}
    {{ evidence_row(row) }}
    {% endfor %}
  </ul>
  {% else %}
  <p class="text-sm text-slate-500 italic">no print-visible sources yet</p>
  {% endif %}
</section>

{% if unstarred_corroborators %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-slate-700">Corroborating evidence</h2>
  <ul class="space-y-1.5">
    {% for row in unstarred_corroborators %}
    {{ evidence_row(row) }}
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if contradictors %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-rose-700">Contradicting evidence</h2>
  <ul class="space-y-1.5">
    {% for row in contradictors %}
    {{ evidence_row(row) }}
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if citation_misses %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-rose-700">Citation misses</h2>
  <ul class="space-y-1.5">
    {% for m in citation_misses %}
    <li class="flex flex-wrap items-baseline gap-x-1.5 text-sm text-rose-700">
      <span class="rounded bg-rose-100 text-rose-700 px-1.5 py-0.5 text-[11px]">⚠ cited source does not support this claim</span>
      {% if m.marker is not none %}<span class="text-slate-500">marker [{{ m.marker }}]</span>{% endif %}
      {% if m.cited_ref_id %}<span class="text-slate-400">· <a href="/r/paper/{{ m.cited_ref_id }}" target="precis-paper" class="font-mono text-sky-700 underline decoration-dotted">cited paper</a></span>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if chunks %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-slate-700">Grounding passages</h2>
  <ul class="space-y-3">
    {% for c in chunks %}
    <li class="text-sm">
      <p class="flex flex-wrap items-baseline gap-x-1.5 text-xs">
        {% if c.starred %}<span class="text-amber-500" title="grounds a print-visible source">★</span>{% endif %}
        {% if c.is_chunk %}{{ ('[' ~ c.handle ~ ']') | linkify_refs }}{% else %}<span class="font-mono text-slate-600">{{ c.handle }}</span>{% endif %}
        <span class="text-slate-400">grounds
          {% for p in c.papers %}{{ p.handle }} <span class="italic">({{ p.role }})</span>{% if not loop.last %}, {% endif %}{% endfor %}
        </span>
      </p>
      {% if c.quote_html %}
      {# tex-scope: this is verbatim paper/draft text, which legitimately
         carries $…$/$$…$$ TeX (the claim title above never does — the
         decided claim-titles-are-plain-text policy) — the
         base.html.j2 init script runs client-side KaTeX over this element. #}
      <blockquote class="tex-scope mt-1 border-l-2 border-slate-200 pl-3 text-slate-600">{{ c.quote_html }}</blockquote>
      {% else %}
      <p class="mt-1 text-xs text-slate-400 italic">passage text not available</p>
      {% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if citers %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-slate-700">Used by</h2>
  {# Inbound `cites` edges — who invokes this claim. Each links to the citing
     passage via the SAME [handle] | linkify_refs render the grounding
     passages use, so a pc<id> chunk reuses the shared 'precis-paper' window
     (a dc<id> draft chunk opens the draft reader) — the per-kind target is
     chosen in linkify._render_universal_handle, not here. #}
  <ul class="space-y-1.5">
    {% for u in citers %}
    <li class="flex flex-wrap items-baseline gap-x-1.5 gap-y-0.5 text-sm">
      {% if u.handle %}
        {% if u.is_chunk %}{{ ('[' ~ u.handle ~ ']') | linkify_refs }}{% else %}<span class="font-mono text-slate-600">{{ u.handle }}</span>{% endif %}
      {% endif %}
      <span class="text-[11px] rounded bg-slate-100 text-slate-500 px-1.5 py-0.5">{{ u.kind }}</span>
      {% if u.title %}<span class="text-slate-700">{{ u.title }}</span>{% endif %}
      {% if u.year %}<span class="text-slate-400">({{ u.year }})</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if coverage_note %}
<p class="mt-6 text-xs text-slate-500 italic">{{ coverage_note }}</p>
{% endif %}

{# Discussion — the "Ask & think" follow-up affordance the generic finding
   detail carried before /refs/finding/<hub> began redirecting here (the
   redirect must not drop functionality). Posts to the SAME
   /refs/finding/<hub_ref_id>/ask route the finding page used; that route
   spawns the agentic pass and redirects to the new conv thread
   (/refs/conv/<id>). The thread then lists under Discussion below on the next
   load of this claim page (the finding→claim redirect makes both surfaces
   share one discussion set). `discussions` is a (possibly empty) list on the
   full page, None on surfaces that don't pass it. #}
{% if discussions is not none %}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2 text-slate-700">Discussion</h2>
  {% if discussions %}
  <ul class="mb-3 rounded-lg border border-slate-200 bg-white divide-y divide-slate-100">
    {% for d in discussions %}
    <li class="px-3 py-2 text-sm flex items-center gap-2">
      <span class="text-slate-400">💬</span>
      <a href="{{ d.url }}" class="text-sky-700 hover:underline flex-1">{{ d.title }}</a>
      {% if d.chunk is not none %}
      <span class="text-xs font-mono text-slate-400">on ~{{ d.chunk }}</span>
      {% endif %}
      <span class="text-xs text-slate-400">{{ d.turns }} turn{{ '' if d.turns == 1 else 's' }}</span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  <form method="post" action="/refs/finding/{{ hub_ref_id }}/ask" class="space-y-2">
    <textarea name="question" rows="2" required
              placeholder="Ask a follow-up about this claim…"
              class="w-full rounded-md border border-slate-300 px-3 py-2 text-sm"></textarea>
    <div class="flex items-center gap-2">
      <button class="rounded-md bg-sky-600 text-white text-sm px-4 py-2 hover:bg-sky-700">
        Ask &amp; think
      </button>
      <span class="text-xs text-slate-400">
        runs an agentic pass (can take ~30–60s); the answer lands in a linked thread
      </span>
    </div>
  </form>
</section>
{% endif %}

{% endif %}
{% endblock %}

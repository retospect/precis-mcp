{# Compact popover fragment for the inline claim-hub hover preview. Loaded via
   htmx into a sibling span; mirrors preview/popover.html.j2's outer wrapper so
   it renders correctly inside the teleported ref-popover. #}
<div class="space-y-1">
  <div class="flex items-center gap-2 text-xs">
    <span class="font-mono px-1.5 py-0.5 rounded bg-slate-100 text-slate-700">claim</span>
    {% if not missing %}
    <span class="text-slate-400 font-mono">{{ head }}</span>
    {% endif %}
  </div>
  {% if missing %}
  <p class="text-xs text-slate-500 italic">not a claim hub</p>
  {% else %}
  <p class="text-sm font-medium text-slate-800 line-clamp-3">{{ claim }}</p>
  {% if inflight %}
  <p class="text-[11px] text-amber-700 italic">still tracing — no citable originator yet</p>
  {% endif %}
  {% set starred_corroborators = corroborators | selectattr('starred') | list %}
  {% set print_rows = originators + starred_corroborators %}
  {% if print_rows %}
  <ul class="space-y-0.5">
    {% for row in print_rows %}
    <li class="text-xs text-slate-600 truncate">
      <span class="text-amber-500">★</span>
      <span class="font-mono">{{ row.handle }}</span> {{ row.title }}
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% set unstarred_corroborators = corroborators | rejectattr('starred') | list %}
  {% if unstarred_corroborators or contradictors %}
  <p class="text-[11px] text-slate-400">
    {% if unstarred_corroborators %}+{{ unstarred_corroborators | length }} corroborating{% endif %}
    {% if unstarred_corroborators and contradictors %} / {% endif %}
    {% if contradictors %}+{{ contradictors | length }} contradicting{% endif %}
  </p>
  {% endif %}
  <p class="text-xs text-sky-700">click to open →</p>
  {% endif %}
</div>

{% extends "base.html.j2" %}
{% block title %}Connect {{ consent.client_name }}{% endblock %}
{% block content %}
<section class="mx-auto max-w-xl py-6">
  <h1 class="text-xl font-semibold mb-3">Connect {{ consent.client_name }} to Precis</h1>
  <p class="mb-4 text-sm text-fg-secondary">You are signed in as {{ user.login }}. This app is requesting permission to:</p>
  <ul class="list-disc pl-5 mb-5 text-sm">
    {% for scope in consent.scopes %}
    <li>{{ scope_labels.get(scope, scope) }}</li>
    {% endfor %}
  </ul>
  {% if 'mcp:full' in consent.scopes %}
  <p class="mb-5 text-sm text-fg-secondary">This includes tools that write data. Shared corpus access is not limited to documents you own. Personal features with account-specific access use your signed-in account.</p>
  {% endif %}
  <form method="post" action="/oauth/consent">
    <input type="hidden" name="request" value="{{ consent.request_id }}" />
    <input type="hidden" name="csrf_token" value="{{ consent.csrf_token }}" />
    <label for="connection-label" class="block text-sm font-medium mb-1">Connection name</label>
    <input id="connection-label" name="label" value="{{ consent.client_name }}" required maxlength="100"
           placeholder="For example, Claude on my laptop" aria-describedby="connection-label-help"
           autocomplete="off" class="w-full rounded border border-stroke bg-canvas p-2 mb-2" />
    <p id="connection-label-help" class="text-xs text-fg-muted mb-5">Use a name you will recognize later. You can revoke this connection from your account without disconnecting your other apps.</p>
    <div class="flex gap-3">
      <button name="decision" value="allow" type="submit" class="rounded bg-info-solid px-4 py-2 text-on-solid hover:bg-info-solid-strong">Allow access</button>
      <button name="decision" value="deny" type="submit" formnovalidate class="rounded border border-stroke px-4 py-2">Deny</button>
    </div>
  </form>
</section>
{% endblock %}

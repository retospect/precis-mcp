{#- DRC badge. ``drc`` is a mapping {rule: error count} (empty = clean) or a
    string status such as "stale, re-check" (precis.pcb.argue.vitals). -#}
{% if drc is string %}
<span class="text-xs text-warning">DRC: {{ drc }}</span>
{% elif drc is mapping and drc %}
<span class="text-xs text-danger">
  DRC:
  {% for rule, n in drc.items() %}{{ rule }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
</span>
{% elif drc %}
<span class="text-xs text-warning">DRC: {{ drc }}</span>
{% else %}
<span class="text-xs text-success">DRC: no recorded errors</span>
{% endif %}

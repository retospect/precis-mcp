{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% from "_design_chat.html.j2" import design_chat %}
{% block title %}{{ title }} — PCB{% endblock %}
{% block main_class %}px-4 py-6{% endblock %}
{% block content %}

<div class="mb-3 flex items-baseline gap-3 flex-wrap">
  {{ drive_back('pcb', 'PCB') }}
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-fg-faint">{{ slug }}</span>
  <span class="text-xs text-fg-subtle">{{ n_parts }} part(s) · {{ n_nets }} net(s)</span>
  {% if route_status %}
  <span class="text-xs text-fg-subtle">
    routes:
    {% for status, n in route_status.items() %}{{ status }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
  </span>
  {% endif %}
  {% include "pcb/_drc_badge.html.j2" %}
  <span class="text-xs text-fg-subtle">
    export:
    <a href="/pcb/{{ slug | urlencode }}/fab.zip" class="underline hover:text-fg-secondary">production files (.zip)</a>
    ·
    <a href="/pcb/{{ slug | urlencode }}/export.epro2" class="underline hover:text-fg-secondary">.epro2</a>
    ·
    <a href="/pcb/{{ slug | urlencode }}/code" class="underline hover:text-fg-secondary">code</a>
    ·
    <a href="/pcb/new" class="underline hover:text-fg-secondary">new board</a>
  </span>
</div>

{% if read_only %}
<div id="pcb-history-summary" class="rounded border p-3">
  <h2>Recorded revision {{ rev }} — read-only summary</h2>
  <pre>{{ revision_summary | tojson(indent=2) }}</pre>
  <a href="/pcb/{{ slug | urlencode }}">Current board</a>
</div>
{% else %}
<script type="application/json" id="pcb-selection-manifest">{{ {'context': pcb_context, 'instances': pcb_instances, 'poses': pcb_poses} | tojson }}</script>
<script type="application/json" id="pcb-part-cards">{{ pcb_part_cards | tojson }}</script>
{# refdes → placement group (slice 2): the cross-probe's sheet lookup. #}
<script type="application/json" id="pcb-sheet-map">{{ pcb_sheet_map | tojson }}</script>
{# The workbench (docs/backlog/pcb-workbench-layout.md): schematic left,
   layout right, a draggable divider whose split is remembered, and the
   info strip below. Both panes are <object> documents — each SVG keeps
   its own scripted legend/behaviour, and static/viewport.js drives
   zoom/pan in both by rewriting the viewBox. #}
<style>
  #pcb-workbench { display: flex; align-items: stretch; height: 72vh; min-height: 22rem; }
  /* Sheet tabs (slice 2): one per placement group plus the overview;
     pcb-sheets.js switches the schematic <object>'s ?sheet=. */
  #pcb-sheet-tabs { display: flex; flex-wrap: wrap; gap: 2px; margin: 0 0 4px 1px; }
  #pcb-sheet-tabs button { font-family: inherit; font-size: 11px; padding: 1px 7px;
    border: 1px solid rgb(var(--border-line)); border-radius: 4px 4px 0 0;
    background: transparent; color: rgb(var(--fg-subtle)); cursor: pointer; }
  #pcb-sheet-tabs button[aria-pressed="true"] { font-weight: 600;
    color: rgb(var(--fg-secondary)); border-bottom-color: transparent;
    background: rgb(var(--bg-surface-emphasis)); }
  #pcb-workbench .pcb-pane { display: flex; flex-direction: column; min-width: 0;
    position: relative; }
  /* gr518348: the fab SVG is a gerber export + reparse — seconds on a
     real board, so the pane shows an elapsed-time note until the object
     loads (pcb-workbench.js owns show/hide). */
  #pcb-board-loading { position: absolute; right: 0.75rem; bottom: 0.5rem;
    border: 1px solid rgb(var(--border-line)); border-radius: 4px;
    background: rgb(var(--bg-surface)); color: rgb(var(--fg-secondary));
    font-size: 11px; font-family: inherit; padding: 2px 8px; z-index: 5; }
  #pcb-board-loading[hidden] { display: none; }
  #pcb-pane-schematic { flex: 0 0 50%; }
  #pcb-pane-layout { flex: 1 1 auto; }
  #pcb-workbench object { flex: 1 1 auto; min-height: 0; width: 100%; }
  #pcb-divider { flex: 0 0 7px; cursor: col-resize; border-radius: 4px; }
  #pcb-divider:hover, #pcb-divider:focus-visible,
  #pcb-height:hover, #pcb-height:focus-visible { background: rgb(var(--bg-surface-emphasis)); }
  #pcb-height { height: 7px; cursor: row-resize; border-radius: 4px; margin: 2px 0; }
  /* Reto's rule: the panel shows the selection; a hover temporarily
     replaces it, and leaving restores it (gr520537 — one model, the old
     #pcb-info-strip's second display is gone). */
  #pcb-selection-panel.hovering #pcb-selection-layout { display: none; }
  #pcb-selection-hover:empty { display: none; }
  #pcb-selection-hover { white-space: pre-wrap; }
  /* gr520538: selection info and preview lay out as two boxes — side by
     side while the panel is wide, stacked when it narrows. The preview
     shows the part's cached JLCPCB image when one exists. */
  #pcb-selection-layout { display: flex; flex-wrap: wrap; gap: 0.5rem 1.5rem; }
  #pcb-selection-layout > #pcb-selection-body { flex: 1 1 26rem; min-width: 0; }
  #pcb-selection-preview { flex: 0 1 auto; margin-left: auto; }
  #pcb-selection-preview img { max-height: 8rem; max-width: 16rem;
    object-fit: contain; border-radius: 4px; }
</style>
<div id="pcb-workbench" class="mb-1">
  <section id="pcb-pane-schematic" class="pcb-pane rounded border border-line bg-surface p-2">
    <h2 class="mb-1 px-1 text-sm font-semibold text-fg-secondary">Schematic
      <span class="font-normal text-xs text-fg-faint">net-label style — matching labels are the connection · double-click a part to focus</span>
      {# Focus bar (slice 1): hidden until a double-click enters focus mode.
         Pin toggles the focused part's placement lock; exit leaves focus. #}
      <span id="pcb-focus-bar" class="hidden items-center gap-1 pl-2 align-middle text-xs font-normal">
        <span id="pcb-focus-label" class="font-mono text-fg-secondary"></span>
        <button type="button" id="pcb-focus-pin"
                title="pin this part in place (lock its placement)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">pin</button>
        <button type="button" id="pcb-focus-only" aria-pressed="false"
                title="show only the parts and pins on the focus"
                class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">only connected</button>
        <button type="button" id="pcb-focus-exit"
                title="leave focus (Esc)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">exit focus</button>
      </span>
      <span class="vp-tools float-right inline-flex gap-1">
        <button type="button" data-vp="in" data-shortcut-label="Zoom in" title="zoom in (+)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">+</button>
        <button type="button" data-vp="out" data-shortcut-label="Zoom out" title="zoom out (-)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">−</button>
        <button type="button" data-vp="fit" data-shortcut-label="Fit view" title="fit view (f, or double-click empty space)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">fit</button>
        <button type="button" data-vp="reset" data-shortcut-label="Reset view" title="reset view (0)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">reset</button>
      </span>
    </h2>
    {% if pcb_sheets %}
    {# Sheet tabs (slice 2): placement groups. pcb-sheets.js owns the
       <object>'s ?sheet= (+ ?focus=) URL state via its dataset. #}
    <div id="pcb-sheet-tabs" role="tablist" aria-label="schematic sheets">
      <button type="button" role="tab" data-sheet="" aria-pressed="true"
              title="{{ pcb_sheet_titles.get('', 'the whole design') }}">overview</button>
      {% for s in pcb_sheets %}
      <button type="button" role="tab" data-sheet="{{ s }}" aria-pressed="false"
              title="{{ pcb_sheet_titles.get(s, s) }}">{{ s }}</button>
      {% endfor %}
    </div>
    {% endif %}
    <object id="pcb-schematic-object" type="image/svg+xml"
            data="/pcb/{{ slug | urlencode }}/schematic.svg"
            data-base="/pcb/{{ slug | urlencode }}/schematic.svg"
            data-pin-url="/pcb/{{ slug | urlencode }}/pin">
      schematic unavailable
    </object>
  </section>
  <div id="pcb-divider" role="separator" aria-orientation="vertical" tabindex="0"
       aria-label="pane divider" title="drag to resize · double-click resets · arrows adjust"></div>
  <section id="pcb-pane-layout" class="pcb-pane rounded border border-line bg-surface p-2">
    <h2 class="mb-1 px-1 text-sm font-semibold text-fg-secondary">Layout
      <span class="font-normal text-xs text-fg-faint">click a pad, part or track to drop its handle into the argument below</span>
      <a href="/pcb/{{ slug | urlencode }}/export.epro2" class="font-normal text-xs text-fg-faint underline hover:text-fg-secondary">download .epro2 (EasyEDA Pro)</a>
      <span class="vp-tools float-right inline-flex gap-1">
        <button type="button" id="pcb-granularity" aria-pressed="false"
                title="selection granularity — 'detail' picks the pad, outline or track segment under the pointer; 'part' selects the whole part"
                class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">select: detail</button>
        <button type="button" id="pcb-layers-toggle" aria-pressed="true"
                title="hide or show the layer panel" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">hide layers</button>
        <button type="button" id="pcb-flip" aria-pressed="false"
                title="bottom view — mirrored, B.* layers on top" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">bottom view</button>
        <button type="button" data-vp="in" data-shortcut-label="Zoom in" title="zoom in (+)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">+</button>
        <button type="button" data-vp="out" data-shortcut-label="Zoom out" title="zoom out (-)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">−</button>
        <button type="button" data-vp="fit" data-shortcut-label="Fit view" title="fit view (f, or double-click empty space)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">fit</button>
        <button type="button" data-vp="reset" data-shortcut-label="Reset view" title="reset view (0)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">reset</button>
      </span>
    </h2>
    {# gr519469: a stale shown token answers board.svg with a 409 text body,
       which the <object> paints raw. pcb-workbench.js unhides this when the
       loaded document isn't the svg; a page reload re-renders against the
       current snapshot (the embedded selection manifest is stale too). #}
    <div id="pcb-board-stale" class="hidden mb-1 flex items-center gap-2 px-1 text-xs text-fg-subtle">
      board changed since this page loaded —
      <button type="button" id="pcb-board-reload"
              class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">reload</button>
    </div>
    <object id="pcb-board-object" type="image/svg+xml"
            data="/pcb/{{ slug | urlencode }}/board.svg?shown={{ pcb_context.shown.snapshot | urlencode }}"
            data-base="/pcb/{{ slug | urlencode }}/board.svg?shown={{ pcb_context.shown.snapshot | urlencode }}">
      board render unavailable
    </object>
    <div id="pcb-board-loading" role="status" hidden
         title="the fab view re-exports the gerbers and renders them back — the first paint is the slow one">rendering board · <span>0</span>s</div>
  </section>
</div>
{# gr496860: a row-resize handle under the panes, mirroring #pcb-divider —
   remembered per user, double-click resets, arrows adjust. #}
<div id="pcb-height" role="separator" aria-orientation="horizontal" tabindex="0"
     aria-label="workbench height" title="drag to resize · double-click resets · arrows adjust"></div>
{# gr520806: the in-viewer manual — one short collapsible panel covering
   the panes, selection/hover, sheets, cross-probing, the layer box and
   the keyboard shortcuts. #}
<details id="pcb-help" class="mb-3 rounded border border-line bg-surface px-2 py-1 text-xs text-fg-subtle">
  <summary class="cursor-pointer select-none font-semibold text-fg-secondary">Viewer manual</summary>
  <ul class="mt-1 list-disc space-y-0.5 pl-5">
    <li><b>Panes</b> — schematic left, board layout right; drag the divider to resize (double-click resets), same for the height handle.</li>
    <li><b>Hover</b> shows the object under the pointer (part card or net/via/track line) and lights its net and part in both panes; it never changes the selection.</li>
    <li><b>Click</b> selects: a pad, part, via, silkscreen, track segment, net or outline — the Selection box below keeps it until you click elsewhere or press <kbd>Esc</kbd>. Its links hop pad ↔ net ↔ part.</li>
    <li><b>select: detail/part</b> — detail picks the exact object under the pointer; part resolves a pad, part-body or part-silkscreen click to the whole part, and a track click to its net (board outline and vias stay detail).</li>
    <li><b>Schematic</b> — sheet tabs switch placement groups; double-click a part or net label to focus it (only connected trims to its neighbourhood, pin locks the part's placement — persisted); a click selects the same board object and jumps to its sheet.</li>
    <li><b>Layers</b> — the legend box in the board's left gutter toggles each layer and shows the cursor's board x/y; <i>hide layers</i> collapses it, <i>bottom view</i> mirrors the board.</li>
    <li><b>Keys</b> — <kbd>+</kbd>/<kbd>−</kbd> zoom, <kbd>f</kbd> fit, <kbd>0</kbd> reset, <kbd>Esc</kbd> deselect or leave focus.</li>
    <li><b>Design chat</b> — Ask answers without changing anything; Propose suggests an edit and always needs explicit Apply.</li>
  </ul>
</details>
{# gr520537: ONE selection display. The panel shows the clicked object and
   keeps it; a hover in either pane temporarily replaces it in the same
   box (#pcb-selection-hover swaps in for #pcb-selection-body). The board
   cursor readout moved into the fab SVG's layer-legend box. #}
<div id="pcb-selection-panel" class="rounded border p-3 mb-3">
  <h2 class="text-sm font-semibold">Selection</h2>
  <div id="pcb-selection-layout">
    <div id="pcb-selection-body">
      <p id="pcb-selection-status" role="status">Select a board object.</p>
      <label>Object <select id="pcb-object-choice"><option value="">Select…</option>
        <optgroup label="Components">{% for item in pcb_instances %}<option value="{{ item.key }}">{{ item.refdes }}</option>{% endfor %}</optgroup>
      </select></label>
      <p id="pcb-selection-facts" class="text-sm"></p>
      <p id="pcb-selection-nav" class="text-sm"></p>
      <pre id="pcb-selection-identity"></pre>
    </div>
    <div id="pcb-selection-preview"><img id="pcb-selection-thumb" alt="" hidden></div>
  </div>
  <div id="pcb-selection-hover" aria-live="polite"></div>
  {# gr520539: real buttons — styled, each with a hover tooltip, and
     greyed out whenever they cannot apply (deselect included). #}
  <button type="button" id="pcb-copy-selection" disabled
          title="copy the selected object's identity JSON to the clipboard"
          class="rounded border border-line px-2 py-0.5 text-xs text-fg-secondary disabled:opacity-50 disabled:cursor-not-allowed">Copy selection</button>
  <button type="button" id="pcb-select-component" disabled
          title="select the whole component the selected pad or silkscreen belongs to"
          class="rounded border border-line px-2 py-0.5 text-xs text-fg-secondary disabled:opacity-50 disabled:cursor-not-allowed">Select component</button>
  <button type="button" id="pcb-select-net" disabled
          title="select the net the selected pad, via or track belongs to"
          class="rounded border border-line px-2 py-0.5 text-xs text-fg-secondary disabled:opacity-50 disabled:cursor-not-allowed">Select net</button>
  <button type="button" id="pcb-deselect" disabled
          title="clear the current selection (Esc)"
          class="rounded border border-line px-2 py-0.5 text-xs text-fg-secondary disabled:opacity-50 disabled:cursor-not-allowed">Deselect</button>
</div>

{# ONE chat box (workbench spec slice 3): Ask posts to /note (question
   notes, no edits), Propose posts the shared design-chat form (proposal,
   explicit Apply). Clicked handles show as removable chips; layout-only
   objects carry the L: prefix. The transcript + Apply stay in the
   design-chat macro below; its own input form is hidden for pcb —
   this box drives it. #}
<div class="mb-6 rounded border border-line bg-surface p-2"
     id="pcb-argue" data-note-url="/pcb/{{ slug }}/note">
  <h2 class="mb-1 px-1 text-sm font-semibold text-fg-secondary">Design chat
    <span class="font-normal text-xs text-fg-faint">handles: <code>U1</code> part · <code>U1.3</code> pad · <code>net:GND</code> net · <code>L:</code> layout objects</span>
  </h2>
  <div class="mb-1 flex items-center gap-2 px-1 text-xs" role="group" aria-label="chat mode">
    <button type="button" id="pcb-mode-ask" aria-pressed="true"
            class="rounded border border-line px-2 py-0.5 font-semibold">Ask</button>
    <button type="button" id="pcb-mode-propose" aria-pressed="false"
            class="rounded border border-line px-2 py-0.5">Propose</button>
    <span class="text-fg-faint">Ask answers a question, changes nothing · Propose suggests an edit, always needs explicit Apply</span>
  </div>
  <div id="pcb-argue-chips" class="flex flex-wrap gap-1 px-1 pb-1 text-[10px] text-fg-subtle"></div>
  <textarea id="pcb-argue-text" rows="3"
            class="w-full rounded border border-line-strong p-2 font-mono text-sm"
            placeholder="R_BLEED is on the wrong side of J_HV, and U1.3 should be on net:GND …"></textarea>
  <div class="mt-1 flex items-center gap-3">
    <button type="button" id="pcb-argue-submit"
            class="rounded bg-solid-strong px-3 py-1 text-xs text-on-solid">send</button>
    <button type="button" id="pcb-argue-clear"
            class="rounded border border-line px-2 py-0.5 text-xs text-fg-secondary">clear</button>
    <span id="pcb-argue-status" class="text-xs text-fg-subtle"></span>
  </div>
  <div id="pcb-argue-error" class="mt-1 hidden text-xs text-danger-strong"></div>
  <h3 class="mt-3 mb-1 px-1 text-xs font-semibold text-fg-muted">Notes</h3>
  <div id="pcb-notes-host">{% include "pcb/_notes.html.j2" %}</div>
</div>
<script src="/static/pcb-facts.js" defer></script>
<script src="/static/viewport.js" defer></script>
<script src="/static/pane-split.js" defer></script>
<script src="/static/pcb-workbench.js" defer></script>
<script src="/static/pcb-sheets.js" defer></script>
<script src="/static/pcb-focus.js" defer></script>
<script src="/static/pcb-argue.js" defer></script>
<script src="/static/pcb-hover.js" defer></script>
<script src="/static/pcb-selection.js" defer></script>
<script src="/static/pcb-crossprobe.js" defer></script>
{% endif %}
{{ design_chat(chat, rev, rev_current) }}
{% endblock %}

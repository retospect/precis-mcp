{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% block title %}{{ title }} — PCB{% endblock %}
{% block content %}

<div class="mb-3 flex items-baseline gap-3 flex-wrap">
  {{ drive_back('pcb', 'PCB') }}
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-slate-400">{{ slug }}</span>
  <span class="text-xs text-slate-500">{{ n_parts }} part(s) · {{ n_nets }} net(s)</span>
  {% if route_status %}
  <span class="text-xs text-slate-500">
    routes:
    {% for status, n in route_status.items() %}{{ status }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
  </span>
  {% endif %}
  {% if drc %}
  <span class="text-xs text-rose-600">
    DRC:
    {% for rule, n in drc.items() %}{{ rule }} {{ n }}{% if not loop.last %} · {% endif %}{% endfor %}
  </span>
  {% else %}
  <span class="text-xs text-emerald-600">DRC: no recorded errors</span>
  {% endif %}
</div>

{# object, not img: the board SVG's layer-toggle legend is scripted, and
   scripts only run when the SVG is its own document. #}
<div class="mb-6 rounded border border-slate-200 bg-white p-2">
  <h2 class="mb-1 px-1 text-sm font-semibold text-slate-700">Board
    <span class="font-normal text-xs text-slate-400">click a pad, part or track to drop its handle into the argument below</span>
  </h2>
  <div class="overflow-auto">
    <object id="pcb-board" type="image/svg+xml" data="/pcb/{{ slug }}/board.svg"
            class="min-w-full">
      board render unavailable
    </object>
  </div>
</div>

{# One text box, always present: a whole-design argument needs no click.
   Clicks on the board SVG (its own document, same origin) insert handles
   at the caret — see static/pcb-argue.js. No place/route button here:
   actions stay in the MCP/job surface; this page is for arguing. #}
<div class="mb-6 rounded border border-slate-200 bg-white p-2"
     id="pcb-argue" data-note-url="/pcb/{{ slug }}/note">
  <h2 class="mb-1 px-1 text-sm font-semibold text-slate-700">Argue with the design
    <span class="font-normal text-xs text-slate-400">handles: <code>U1</code> part · <code>U1.3</code> pad · <code>net:GND</code> net</span>
  </h2>
  <textarea id="pcb-argue-text" rows="3"
            class="w-full rounded border border-slate-300 p-2 font-mono text-sm"
            placeholder="R_BLEED is on the wrong side of J_HV, and U1.3 should be on net:GND …"></textarea>
  <div class="mt-1 flex items-center gap-3">
    <button type="button" id="pcb-argue-submit"
            class="rounded bg-slate-800 px-3 py-1 text-xs text-white">submit argument</button>
    <span id="pcb-argue-status" class="text-xs text-slate-500"></span>
  </div>
  <div id="pcb-argue-error" class="mt-1 hidden text-xs text-rose-700"></div>
  <h3 class="mt-3 mb-1 px-1 text-xs font-semibold text-slate-600">Notes</h3>
  <div id="pcb-notes-host">{% include "pcb/_notes.html.j2" %}</div>
</div>
<script src="/static/pcb-argue.js" defer></script>

<div class="mb-6 rounded border border-slate-200 bg-white p-2">
  <h2 class="mb-1 px-1 text-sm font-semibold text-slate-700">Schematic
    <span class="font-normal text-xs text-slate-400">net-label style — matching labels are the connection</span>
  </h2>
  <div class="overflow-auto">
    <img src="/pcb/{{ slug }}/schematic.svg" alt="schematic of {{ title }}"
         class="min-w-full">
  </div>
</div>

{% endblock %}

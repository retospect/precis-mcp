{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% block title %}Imported {{ slug }} — PCB{% endblock %}
{% block content %}

<div class="mb-3 flex items-baseline gap-3 flex-wrap">
  {{ drive_back('pcb', 'PCB') }}
  <h1 class="text-lg font-semibold">Imported {{ slug }}</h1>
  <span class="text-xs text-fg-faint">{{ filename }}</span>
</div>

<div class="rounded border border-line bg-surface p-3 text-sm">
  <p>
    {{ stats.components }} component(s) · {{ stats.footprints }} footprint(s) ·
    {{ stats.nets }} net(s) · {{ stats.connections }} connection(s) ·
    {{ stats.mounting_holes }} mounting hole(s)
  </p>
  {% if counts %}
  <p class="mt-1 text-xs text-fg-subtle">
    applied: {{ counts.components }} component(s) · {{ counts.pins }} pin(s) ·
    {{ counts.instances }} instance(s) · {{ counts.nets }} net(s) ·
    {{ counts.conns }} connection(s) · {{ counts.features }} feature(s)
  </p>
  {% endif %}
  <p class="mt-1 text-xs text-fg-subtle">stackup: {{ stackup | join(', ') }}</p>
  {% if planes %}
  <p class="mt-1 text-xs text-fg-subtle">
    planes: {% for layer, net in planes|dictsort %}{{ layer }}={{ net }}{% if not loop.last %}, {% endif %}{% endfor %}
  </p>
  {% endif %}
  {% for line in dropped %}
  <p class="mt-1">{{ line }}</p>
  {% endfor %}
  {% if intake %}
  <h3 class="mt-3 text-xs font-semibold text-fg-muted">Intake</h3>
  <pre class="text-xs">{{ intake | join('\n') }}</pre>
  {% endif %}
  {% if warnings %}
  <h3 class="mt-3 text-xs font-semibold text-fg-muted">Warnings</h3>
  <ul class="list-disc pl-5 text-xs">
    {% for w in warnings %}<li>{{ w }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if copper %}
  <h3 class="mt-3 text-xs font-semibold text-fg-muted">Copper</h3>
  <pre class="text-xs">{{ copper | join('\n') }}</pre>
  {% endif %}
  {% if alignment %}
  <h3 class="mt-3 text-xs font-semibold text-fg-muted">Looks alignment-critical (listed, not locked)</h3>
  <ul class="list-disc pl-5 text-xs">
    {% for refdes, why in alignment %}<li>{{ refdes }} — {{ why }}</li>{% endfor %}
  </ul>
  {% endif %}
  {% if queued or facts %}
  <p class="mt-2 text-xs text-fg-subtle">{{ queued }} datasheet pull(s), {{ facts }} facts extraction(s) queued</p>
  {% endif %}
  <p class="mt-3"><a href="/pcb/{{ slug | urlencode }}" class="underline">open the board</a></p>
</div>
{% endblock %}

{# Services sub-tab — the retired Factory console: every pass /
   job-type / compute / daemon / serving row from the ServiceSpec
   registry, joined to its live ``service_config`` prio and last
   activity, plus the Quests char-budget shares. The host *strip*
   (load/capability chips) now lives on the Health sub-tab — this tab
   only keeps the host *selector*, which scopes which host's
   ``service_config`` row an edit targets. #}
<p class="text-sm text-fg-subtle mb-3">
  Everything the factory runs — one row per pass, job-type, compute
  service, daemon, and serving endpoint — from the ServiceSpec registry,
  joined to its live <code>service_config</code> prio and last activity.
  Editing writes <code>service_config</code> for the selected host; the
  worker picks it up on its next cycle (no redeploy).
</p>

{# ── Host selector — edits apply to this host ('*' = all) ─────── #}
<form method="get" action="/status" class="mb-4 flex items-center gap-2 text-sm">
  <input type="hidden" name="tab" value="services">
  <label class="text-fg-subtle">Editing host</label>
  <select name="host" onchange="this.form.submit()"
          class="rounded-md border border-line-strong text-sm px-2 py-1.5">
    {% for h in host_options %}
    <option value="{{ h }}" {% if h == selected_host %}selected{% endif %}>{{ '* (all hosts)' if h == '*' else h }}</option>
    {% endfor %}
  </select>
  <span class="text-xs text-fg-faint">prio 0 = off · 1–10 = claim weight · blank = env/profile default ({{ default_prio }})</span>
</form>

{# ── Reserve mode (§B-2, gr162694 #4) — a TTL'd gate on heavy claims for
     the selected host. Read-only banner if already reserved; a short-lived
     form to set/release it otherwise. Both POST the ONE door
     (service_config.set_reserve/clear_reserve), never a raw UPSERT. #}
<section class="mb-4">
  {% if reserve %}
  <div class="rounded-lg border border-accent-strong bg-accent-subtle px-3 py-2 text-sm flex items-center gap-3"
       title="Reserve mode blocks new heavy claims on {{ selected_host }} until it expires (service_config pseudo-row, §B-2). Set by {{ reserve.actor or 'unknown' }}.">
    <span class="text-accent-deep">🔒 <strong>{{ selected_host }}</strong> reserved until {{ reserve.expires_at | abs_ts }}</span>
    <form method="post" action="/factory/release">
      <input type="hidden" name="host" value="{{ selected_host }}">
      <button class="rounded bg-accent-solid-strong text-on-solid text-xs px-2 py-1 hover:bg-accent-solid-strong transition">Release now</button>
    </form>
  </div>
  {% else %}
  <form method="post" action="/factory/reserve" class="flex items-center gap-2 text-xs text-fg-subtle">
    <input type="hidden" name="host" value="{{ selected_host }}">
    <span>Reserve {{ selected_host }} for</span>
    <input type="number" name="hours" value="4" min="0.1" max="168" step="0.5"
           class="w-16 rounded border border-line-strong px-1 py-0.5">
    <span>hours (blocks new heavy claims)</span>
    <button class="rounded bg-solid text-on-solid px-2 py-1 hover:bg-solid-strong transition">Reserve</button>
  </form>
  {% endif %}
</section>

{# ── LLM placement chains — the Phase B operator editor ── #}
<section class="mb-6">
  <div class="rounded-lg border border-line bg-surface p-4 max-w-2xl">
    <h2 class="text-sm font-semibold mb-2">LLM placement chains (operator)</h2>

    <div class="flex items-center gap-2 mb-3">
      {% if llm_chains.cloud_enabled %}
      <span class="rounded px-1.5 py-0.5 text-[11px] bg-success-subtle text-success-strong">cloud ON</span>
      {% else %}
      <span class="rounded px-1.5 py-0.5 text-[11px] bg-warning-subtle text-warning-strong">cloud OFF</span>
      {% endif %}
      <form method="post" action="/factory/llm/cloud">
        <input type="hidden" name="enabled" value="{{ 'false' if llm_chains.cloud_enabled else 'true' }}">
        <button class="rounded bg-surface-emphasis text-fg-secondary text-xs px-3 py-1 hover:bg-surface-strong transition">
          {% if llm_chains.cloud_enabled %}Disable cloud (→ local only){% else %}Enable cloud{% endif %}
        </button>
      </form>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
      {% for t in llm_chains.tiers %}
      <form method="post" action="/factory/llm/chain" class="rounded border border-line p-2">
        <input type="hidden" name="tier" value="{{ t.tier }}">
        <div class="text-xs font-mono text-fg-muted mb-1">{{ t.tier }}</div>
        <textarea name="chain_json" rows="3"
                  class="w-full rounded border border-line-strong text-[11px] font-mono px-1.5 py-1"
                  placeholder='default ladder — paste JSON [{"placement":"cloud","model":"…","transport":"openai_tools"}, …]'>{{ t.chain_json }}</textarea>
        <button class="mt-1 rounded bg-info-solid text-on-solid text-xs px-3 py-1 hover:bg-info-solid-strong transition">
          Save
        </button>
      </form>
      {% endfor %}
    </div>
    <p class="text-[11px] text-fg-faint mt-2">
      Blank = revert to the default ladder; malformed JSON (not a valid list) is ignored, leaving the prior override untouched.
    </p>
  </div>
</section>

{# ── LLM operations — per-source model routing (Phase 2) ───────── #}
<section class="mb-6">
  <div class="rounded-lg border border-line bg-surface p-4">
    <h2 class="text-sm font-semibold mb-2">LLM operations (operator)</h2>
    <p class="text-[11px] text-fg-faint mb-2">
      One row per LLM call site (<code>source=</code>), registry ∪ excluded ∪
      observed, most-recently-run first. Steerable rows write/clear
      <code>llm.op.&lt;source&gt;</code> — the tier select and the model
      select are mutually exclusive: "default" reverts to the registry
      default, a capability tier remaps the operation to that tier (its
      model select is ignored), and "pinned" pins the chosen model (its
      tier is ignored). Non-steerable rows (router-bypassers, functional
      pins) are read-only.
    </p>
    <div class="overflow-x-auto rounded-lg border border-line">
      <table class="min-w-full text-xs">
        <thead class="bg-surface-subtle text-fg-subtle">
          <tr>
            <th class="text-left font-medium px-3 py-2">operation</th>
            <th class="text-left font-medium px-3 py-2">default</th>
            <th class="text-left font-medium px-3 py-2">effective</th>
            <th class="text-left font-medium px-3 py-2">control</th>
            <th class="text-left font-medium px-3 py-2">last-seen model</th>
            <th class="text-left font-medium px-3 py-2">last run</th>
            <th class="text-left font-medium px-3 py-2">7d calls</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-line-subtle">
          {% for op in llm_ops.rows %}
          <tr class="align-top">
            <td class="px-3 py-2">
              <div class="font-medium"
                   {% if op.description or op.note %}
                   title="{{ op.description }}{% if op.note %}&#10;&#10;{{ op.note }}{% endif %}"
                   {% endif %}>
                {{ op.label }}
              </div>
              <div class="text-[11px] text-fg-faint font-mono">{{ op.source }}</div>
            </td>
            <td class="px-3 py-2 font-mono text-[11px] text-fg-subtle">
              {% if op.default_tier %}{{ op.default_tier }} / {{ op.default_model or '—' }}{% else %}—{% endif %}
            </td>
            <td class="px-3 py-2 font-mono text-[11px]">{{ op.effective }}</td>
            <td class="px-3 py-2">
              {% if op.steerable %}
              {% set is_pinned = op.override and op.override.model %}
              <form method="post" action="/factory/llm/op" class="flex items-center gap-1">
                <input type="hidden" name="source" value="{{ op.source }}">
                <select name="tier" class="rounded border border-line-strong text-[11px] px-1 py-0.5"
                        onchange="var m=this.form.elements['model']; m.disabled = (this.value !== 'pinned');">
                  <option value="default" {% if not op.override %}selected{% endif %}>default</option>
                  {% for t in ("frontier", "big", "medium", "small") %}
                  <option value="{{ t }}" {% if op.override and op.override.tier == t %}selected{% endif %}>{{ t }}</option>
                  {% endfor %}
                  <option value="pinned" {% if is_pinned %}selected{% endif %}>pinned</option>
                </select>
                <select name="model" class="rounded border border-line-strong text-[11px] px-1 py-0.5"
                        {% if not is_pinned %}disabled{% endif %}>
                  <option value="">(pick a model)</option>
                  {% for m in llm_ops.models %}
                  <option value="{{ m }}" {% if op.override and op.override.model == m %}selected{% endif %}>{{ m }}</option>
                  {% endfor %}
                </select>
                <button class="rounded bg-info-solid text-on-solid text-[11px] px-2 py-0.5 hover:bg-info-solid-strong transition">Save</button>
              </form>
              {% else %}
              <span class="text-[11px] text-warning-strong">
                {{ op.excluded_reason or "not in the steerable registry" }}
              </span>
              {% endif %}
            </td>
            <td class="px-3 py-2">{{ op.last_seen_model or '—' }}</td>
            <td class="px-3 py-2">{{ op.last_run or "never" }}</td>
            <td class="px-3 py-2">{{ op.calls_7d }}</td>
          </tr>
          {% endfor %}
          {% if not llm_ops.rows %}
          <tr><td class="px-3 py-2 text-fg-faint" colspan="7">No operations observed.</td></tr>
          {% endif %}
        </tbody>
      </table>
    </div>
    <p class="text-[11px] text-fg-faint mt-2">
      Tier and model are mutually exclusive — picking a capability tier
      ignores the model select (and vice versa); "pinned" with no model
      selected is a no-op (leaves the prior override, if any, untouched).
    </p>
  </div>
</section>

{# ── One list per category ───────────────────────────────────── #}
{% for cat in categories %}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2 capitalize">{{ cat.name }}</h2>
  <div class="overflow-x-auto rounded-lg border border-line bg-surface">
    <table class="min-w-full text-xs">
      <thead class="bg-surface-subtle text-fg-subtle">
        <tr>
          <th class="text-left font-medium px-3 py-2" title="The ServiceSpec registry key — the --only / service_config.service token.">service</th>
          <th class="text-left font-medium px-3 py-2" title="What sort of runnable this is: pass / job / compute / daemon / serving.">kind</th>
          <th class="text-left font-medium px-3 py-2" title="Worker profiles that run this in the default rotation; the env var below is the deploy-time enable flag, if any.">profile</th>
          <th class="text-left font-medium px-3 py-2" title="Capability requirements (gpu/podman/tts/…), whether it calls an LLM, and any external service it depends on.">needs</th>
          <th class="text-left font-medium px-3 py-2" title="Claim weight for the editing host — 0 = off, 1-10 = weight, blank = env/profile default.">prio ({{ selected_host }})</th>
          <th class="text-left font-medium px-3 py-2" title="Pinned model_pref for the editing host, if any — blank = auto (router picks).">model</th>
          <th class="text-left font-medium px-3 py-2" title="When this handler last logged a batch with ok > 0 (worker_logs); hover for the absolute timestamp.">last ok</th>
          <th class="text-left font-medium px-3 py-2" title="When this handler last logged a batch with failed > 0 (worker_logs); hover for the absolute timestamp.">last fail</th>
          <th class="text-left font-medium px-3 py-2" title="Wall-clock next fire for a scheduler_leases cadence; 'every cycle' for a per-tick pass; blank for job-queue executors (data-driven, not scheduled).">next run</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-line-subtle">
        {% for s in cat.services %}
        <tr class="align-top">
          <td class="px-3 py-2">
            <div class="flex items-center gap-2">
              <span class="font-mono font-semibold text-fg">{{ s.name }}</span>
              {% if s.has_agent %}
              <a href="/env?agent={{ s.name }}" class="text-success-strong hover:underline" title="agent env inspector">env↗</a>
              {% endif %}
            </div>
            <div class="text-fg-subtle mt-0.5">{{ s.one_line }}</div>
          </td>
          <td class="px-3 py-2 text-fg-muted">{{ s.kind }}</td>
          <td class="px-3 py-2 font-mono text-fg-muted">
            {{ s.profiles }}
            {% if s.enable_env %}<div class="text-fg-faint">{{ s.enable_env }}</div>{% endif %}
          </td>
          <td class="px-3 py-2">
            {% if s.requires %}
            <span class="font-mono text-warning-strong">{{ ', '.join(s.requires) }}</span>
            {% endif %}
            {% if s.uses_model %}<span class="text-info-strong">model</span>{% endif %}
            {% if s.external %}<div class="text-fg-faint font-mono">{{ ', '.join(s.external) }}</div>{% endif %}
            {% if not s.requires and not s.uses_model and not s.external %}<span class="text-fg-ghost">—</span>{% endif %}
          </td>
          {# ── editable prio ── #}
          <td class="px-3 py-2">
            <form method="post" action="/factory/prio" class="flex items-center gap-1">
              <input type="hidden" name="host" value="{{ selected_host }}">
              <input type="hidden" name="service" value="{{ s.name }}">
              <input type="number" name="prio" min="0" max="10"
                     value="{{ s.prio if s.prio is not none else '' }}"
                     placeholder="{{ default_prio }}"
                     class="w-14 rounded border {% if s.prio == 0 %}border-danger-strong bg-danger-subtle{% else %}border-line-strong{% endif %} px-1 py-0.5 text-xs">
              <button class="rounded bg-solid text-on-solid px-1.5 py-0.5 text-[11px]">set</button>
            </form>
            {% if s.prio is not none %}
            <form method="post" action="/factory/clear" class="mt-0.5">
              <input type="hidden" name="host" value="{{ selected_host }}">
              <input type="hidden" name="service" value="{{ s.name }}">
              <button class="text-[11px] text-fg-faint hover:text-danger hover:underline">clear</button>
            </form>
            {% endif %}
            {% if s.others %}<div class="text-[11px] text-fg-faint mt-0.5">others: {{ s.others }}</div>{% endif %}
          </td>
          {# ── model picker (model-using rows) ── #}
          <td class="px-3 py-2">
            {% if s.uses_model %}
            <form method="post" action="/factory/model" class="flex items-center gap-1">
              <input type="hidden" name="host" value="{{ selected_host }}">
              <input type="hidden" name="service" value="{{ s.name }}">
              <select name="model" onchange="this.form.submit()"
                      class="rounded border border-line-strong px-1 py-0.5 text-xs max-w-[10rem]">
                <option value="" {% if not s.model_pref %}selected{% endif %}>(auto)</option>
                {% for m in models %}
                <option value="{{ m }}" {% if m == s.model_pref %}selected{% endif %}>{{ m }}</option>
                {% endfor %}
                {% if s.model_pref and s.model_pref not in models %}
                <option value="{{ s.model_pref }}" selected>{{ s.model_pref }} (?)</option>
                {% endif %}
              </select>
            </form>
            {% else %}
            <span class="text-fg-ghost">—</span>
            {% endif %}
          </td>
          <td class="px-3 py-2 {% if s.last_ok %}text-success-strong{% else %}text-fg-ghost{% endif %}"
              {% if s.last_ok_title %}title="{{ s.last_ok_title }}"{% endif %}>{{ s.last_ok or '—' }}</td>
          <td class="px-3 py-2 {% if s.last_fail %}text-danger-strong{% else %}text-fg-ghost{% endif %}"
              {% if s.last_fail_title %}title="{{ s.last_fail_title }}"{% endif %}>{{ s.last_fail or '—' }}</td>
          <td class="px-3 py-2 text-fg-muted"
              {% if s.next_run %}title="{{ s.next_run.title }}"{% endif %}>{{ s.next_run.text if s.next_run else '—' }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endfor %}

{# ── Queue wait by origin class (slice 6, D6) — is interactive work moving? ── #}
<section class="mt-8">
  <h2 class="text-sm font-semibold mb-1">Queue wait by class</h2>
  <p class="text-xs text-fg-subtle mb-3">
    How long each scheduling class waited from mint to claim
    (<span class="font-mono">started_at − created_at</span>) over the last 24h
    {% if selected_host != '*' %}on {{ selected_host }}{% else %}fleet-wide{% endif %}.
    The claim ranks human → agent → recurring → background; interactive classes
    should stay low while background bands absorb the backlog.
  </p>
  {% if not wait_by_class %}
  <p class="text-xs text-fg-subtle">No jobs claimed in the window.</p>
  {% else %}
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-xs text-fg-subtle border-b border-line">
          <th class="py-1 pr-3">class</th>
          <th class="py-1 pr-3">n</th>
          <th class="py-1 pr-3">p50</th>
          <th class="py-1 pr-3">p95</th>
          <th class="py-1 pr-3">max</th>
        </tr>
      </thead>
      <tbody>
        {% for w in wait_by_class %}
        <tr class="border-b border-line-subtle">
          <td class="py-1.5 pr-3 text-fg">{{ w.cls }}</td>
          <td class="py-1.5 pr-3 font-mono text-xs">{{ w.n }}</td>
          <td class="py-1.5 pr-3 font-mono text-xs">{{ w.p50 }}</td>
          <td class="py-1.5 pr-3 font-mono text-xs">{{ w.p95 }}</td>
          <td class="py-1.5 pr-3 font-mono text-xs">{{ w.max }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

{# ── Quests tab — the other substrate: which strivings get attention ── #}
<section class="mt-8">
  <h2 class="text-sm font-semibold mb-1">Quests</h2>
  <p class="text-xs text-fg-subtle mb-3">
    Same model as services — set a priority, the system allocates
    proportionally — on the striving substrate. Each active quest's usage
    (chars) over the trailing {{ quests.window_days }}-day window against its
    priority-weighted share of the budget
    {% if quests.budget %}({{ '{:,}'.format(quests.budget) }} chars){% else %}(no budget set — usage only){% endif %}.
    A quest at 100% is one the allocator skips this round.
  </p>
  {% if not quests.rows %}
  <p class="text-xs text-fg-subtle">No active quests.</p>
  {% else %}
  <div class="overflow-x-auto">
    <table class="min-w-full text-sm">
      <thead>
        <tr class="text-left text-xs text-fg-subtle border-b border-line">
          <th class="py-1 pr-3">quest</th>
          <th class="py-1 pr-3">prio</th>
          <th class="py-1 pr-3">spend ({{ quests.window_days }}d)</th>
          <th class="py-1 pr-3 w-64">share consumed</th>
        </tr>
      </thead>
      <tbody>
        {% for q in quests.rows %}
        <tr class="border-b border-line-subtle">
          <td class="py-1.5 pr-3">
            <span class="text-fg">{{ q.title }}</span>
            <span class="text-xs text-fg-faint font-mono">qu{{ q.id }}</span>
          </td>
          <td class="py-1.5 pr-3 font-mono text-xs">{{ q.prio if q.prio is not none else '—' }}</td>
          <td class="py-1.5 pr-3 font-mono text-xs">{{ '{:,}'.format(q.spend) }} chars</td>
          <td class="py-1.5 pr-3">
            {% if q.pct is not none %}
            <div class="flex items-center gap-2">
              <div class="flex-1 h-2 rounded bg-surface-muted overflow-hidden">
                <div class="h-2 {% if q.over %}bg-danger-solid-soft{% elif q.pct >= 75 %}bg-warning-solid-soft{% else %}bg-success-solid-soft{% endif %}"
                     style="width: {{ q.pct }}%"></div>
              </div>
              <span class="text-xs {% if q.over %}text-danger-strong font-semibold{% else %}text-fg-subtle{% endif %}">{{ q.pct }}%</span>
            </div>
            {% else %}
            <span class="text-xs text-fg-faint">— (no budget share)</span>
            {% endif %}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

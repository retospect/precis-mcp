{# Lazy top block of the Health sub-tab — rendered by GET
   /status/health-panels, fetched via htmx on page load. These four
   panels carry the profiled-slow queries (failed_passes, the
   bodiless-EXISTS paper count, the worker_logs hosts rollup,
   spin_loops — gr518161), so they defer off the initial render the
   same way /status/backlog does. Template context:
   precis_web.routes.status._health_panels_ctx. #}

<div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-6">
  <div class="rounded-lg border border-line bg-surface p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint">Papers</div>
    <div class="mt-1 text-2xl font-semibold">{{ papers.get('total', 0) }}</div>
    <div class="text-sm text-fg-subtle">
      {{ papers.get('held', 0) }} held · {{ papers.get('stub', 0) }} stubs{% if papers.get('bodiless') %} · <span class="text-warning-strong" title="PDF held but no body text (pdf_sha256 set, zero ord>=0 chunks): in no fetch queue (gr453860)">{{ papers.get('bodiless') }} PDF-no-body</span>{% endif %}{% if papers.get('body_partial') %} · <span class="text-warning-strong" title="Body is mostly references/SI after one re-fetch (tag body:partial, gr464259)">{{ papers.get('body_partial') }} partial-body</span>{% endif %}{% if papers.get('body_needs_ocr') %} · <span class="text-warning-strong" title="Extraction empty after a retry (tag body:needs_ocr, gr453860)">{{ papers.get('body_needs_ocr') }} needs-OCR</span>{% endif %}
    </div>
  </div>
  <div class="rounded-lg border border-line bg-surface p-4 md:col-span-2">
    <div class="text-xs uppercase tracking-wide text-fg-faint mb-2">Refs by kind</div>
    <div class="flex flex-wrap gap-2">
      {% for k in kind_counts %}
      {# Straight into Drive scoped to that one kind (folder=* so filed
         artifacts count too, matching the number on the chip) rather than
         a separate single-purpose listing page. #}
      <a href="/drive?k={{ k.kind | urlencode }}&amp;folder=*&amp;sort=recency"
         class="text-xs px-2 py-1 rounded bg-surface-muted text-fg-secondary hover:bg-info-muted hover:text-info-deep transition">
        {{ k.kind }} <span class="font-semibold">{{ k.count }}</span>
      </a>
      {% endfor %}
    </div>
  </div>
</div>

<div class="rounded-lg border border-line bg-surface p-4 mb-6 text-sm">
  <span class="text-xs uppercase tracking-wide text-fg-faint">PDF corpus root</span>
  <span class="ml-2 font-mono text-fg-secondary break-all">{{ corpus_dir }}</span>
  <span class="text-fg-faint">(set via <span class="font-mono">PRECIS_CORPUS_DIR</span>)</span>
  <span class="ml-2 text-fg-ghost">·</span>
  <span class="text-xs uppercase tracking-wide text-fg-faint ml-2">version</span>
  <span class="ml-1 font-mono text-fg-secondary">{{ app_version }}</span>
  <span class="ml-2 text-fg-ghost">·</span>
  <span class="text-xs uppercase tracking-wide text-fg-faint ml-2"
        title="Live papers (most-recent {{ title_mismatch.get('n_sampled', 0) }} sampled) whose registry title shares zero distinctive words with their own chunk 0 (gr353804); n_tagged = already caught by the ingest-time guard.">
    registry title mismatch
  </span>
  <span class="ml-1 font-mono text-fg-secondary">{{ title_mismatch.get('n_mismatch', 0) }}/{{ title_mismatch.get('n_sampled', 0) }}</span>
  <span class="text-fg-faint">({{ title_mismatch.get('n_tagged', 0) }} tagged)</span>
</div>

<!-- Machines: the reconciled host strip (heartbeat sensors + capability
     chips + both error windows). -->
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Machines</h2>
  {% if not heartbeats %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">
    No heartbeats yet. Run <span class="font-mono">precis heartbeat</span> on each host (on a timer).
  </p>
  {% else %}
  <div class="flex flex-wrap gap-2">
    {% for h in heartbeats %}
    <div class="rounded-lg border {% if h.stale %}border-line bg-surface-subtle{% else %}border-success bg-success-subtle{% endif %} px-3 py-2 text-xs">
      {% if h.reserve %}
      <div class="mb-1 rounded bg-accent-muted border border-accent-strong text-accent-deep px-1.5 py-0.5 text-[11px]"
           title="Reserve mode blocks new heavy claims on {{ h.host }} until it expires (service_config pseudo-row, §B-2). Set by {{ h.reserve.actor or 'unknown' }}.">
        🔒 reserved until {{ h.reserve.expires_at | abs_ts }}
      </div>
      {% endif %}
      <div class="flex items-center gap-2">
        <span class="font-mono font-semibold text-fg">{{ h.host }}</span>
        {% if h.stale %}
        <span class="text-fg-faint">● stale</span>
        {% else %}
        <span class="text-success-strong">● live</span>
        {% endif %}
        <span class="text-fg-faint">{{ h.ago }}</span>
      </div>
      <div class="text-fg-subtle mt-0.5">
        {% if h.temp_c is not none %}
        <span class="{% if h.temp_c >= 85 %}text-danger-strong font-semibold{% elif h.temp_c >= 70 %}text-warning-strong{% endif %}">{{ '%.1f'|format(h.temp_c) }} °C</span> ·
        {% endif %}
        load
        {% if h.load1 is not none %}
        <span class="font-mono">{{ '%.2f'|format(h.load1) }} / {{ '%.2f'|format(h.load5) }} / {{ '%.2f'|format(h.load15) }}</span>
        {% else %}<span class="font-mono">—</span>{% endif %}
      </div>
      {% if h.top_cpu %}
      <div class="text-fg-faint mt-0.5" title="Top processes by CPU% (heartbeat self-probe) — diagnostic only, not the liveness signal.">
        cpu: {% for p in h.top_cpu %}{{ p.cmd }} {{ p.cpu }}%{% if not loop.last %} · {% endif %}{% endfor %}
      </div>
      {% endif %}
      {% if h.slots %}
      <div class="mt-1 flex flex-wrap gap-1" title="Resources this host advertises (heartbeat self-probe). free/capacity slots.">
        {% for sl in h.slots %}
        {% if sl.pressure %}
        <span class="rounded px-1 py-0.5 font-mono text-[11px] border
          {% if sl.pressure == 'crit' %}bg-danger-muted border-danger-strong text-danger-strong
          {% elif sl.pressure == 'warn' %}bg-warning-muted border-warning-strong text-warning-strong
          {% else %}bg-success-subtle border-success text-success-strong{% endif %}"
          title="{{ sl.ptitle }}">{{ sl.label }} {{ sl.free }}/{{ sl.capacity }}</span>
        {% else %}
        <span class="rounded bg-surface/70 border border-line px-1 py-0.5 font-mono text-[11px] text-fg-muted cursor-help"
          title="{{ sl.desc }}">{{ sl.resource }} {{ sl.free }}/{{ sl.capacity }}</span>
        {% endif %}
        {% endfor %}
      </div>
      {% endif %}
      {# ── both error windows: 24h tally (WARNING+ERROR, worker_logs
         liveness) and 6h detail (ERROR/CRITICAL, with samples) ── #}
      <div class="mt-1 flex flex-wrap items-center gap-1">
        {% if h.problems %}
        <span class="rounded px-1 py-0.5 text-[11px] bg-danger-muted text-danger-strong">{{ h.problems }} err/warn 24h</span>
        {% endif %}
        {% if h.errors_6h %}
        {# The most recent WARNING+ line, visible (not just a count behind a
           hover) — gr162694 #2. title= carries the full line + absolute ts
           plus the older samples, for the full picture on mouseover. #}
        <span class="rounded px-1 py-0.5 text-[11px] bg-danger-muted border border-danger-strong text-danger-strong cursor-help"
          title="{% if h.errors_6h.latest %}{{ h.errors_6h.latest.title }}&#10;{% endif %}{% for e in h.errors_6h.samples %}{{ e.ago }} · {{ e.pass }} · {{ e.msg }}&#10;{% endfor %}{% if h.errors_6h.count > h.errors_6h.samples|length %}…and {{ h.errors_6h.count - h.errors_6h.samples|length }} more{% endif %}">⚠ {{ h.errors_6h.latest.line if h.errors_6h.latest else (h.errors_6h.count|string + ' errors') }}{% if h.errors_6h.count > 1 %} <span class="text-danger-soft">(+{{ h.errors_6h.count - 1 }})</span>{% endif %}</span>
        {% endif %}
        {% if not h.problems and not h.errors_6h %}
        <span class="text-success" title="No WARNING/ERROR worker logs from {{ h.host }} recently.">no recent errors</span>
        {% endif %}
      </div>
    </div>
    {% endfor %}
  </div>
  {% endif %}
  {% if extra_hosts %}
  {# hosts seen only in worker_logs (no heartbeat row) — same plain pill
     the old page showed for these. #}
  <div class="mt-2 flex flex-wrap gap-2">
    {% for hl in extra_hosts %}
    <span class="text-xs px-2 py-1 rounded {% if hl.stale %}bg-surface-muted text-fg-subtle{% else %}bg-success-subtle text-success-strong{% endif %}">
      {{ hl.host }} · logged {{ hl.ago }}{% if hl.problems %} · <span class="text-danger font-semibold">{{ hl.problems }} err/warn 24h</span>{% endif %}
    </span>
    {% endfor %}
  </div>
  {% endif %}
</section>

<!-- Health checks — the health_digest panel itself: literally the
     ``health_panel()`` object the agent surface renders at
     ``get(kind='alert', id='/health')``, so the page and the agent can
     never disagree on a check's verdict. ``stale`` rows are findings
     (each carries a registered failure id); ``unknown`` means the
     check's own probe failed. Rows flagged ``live`` were re-probed at
     render time; the rest are the last eval's snapshot. The heavy
     backlog counts stay live behind the lazy fragment below. -->
{% set hp = health or {} %}
{% set hp_checks = hp.get('checks', []) %}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Health checks
    <span class="font-normal text-xs text-fg-faint">
      {% if hp.get('snapshot_age_hours') is not none %}
        snapshot {{ '%.1f'|format(hp.snapshot_age_hours) }}h old{% if hp.get('computed_at') %} ({{ hp.computed_at.strftime('%Y-%m-%dT%H:%MZ') }}){% endif %}
      {% else %}
        no health_digest eval yet
      {% endif %}
      {% set open_alerts = hp.get('open_alerts', {}) %}
      {% if open_alerts %}
        · open alerts:
        {% for sev, n in open_alerts | dictsort %}<span class="{% if sev == 'critical' %}text-danger font-semibold{% elif sev == 'warn' %}text-warning{% else %}text-fg-faint{% endif %}">{{ n }} {{ sev }}</span>{{ ', ' if not loop.last }}{% endfor %}
      {% endif %}
    </span>
  </h2>
  {% if not hp_checks %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">
    No health checks yet — the hourly <span class="font-mono">health_digest</span> pass has not run on this store.
  </p>
  {% else %}
  <div class="rounded-lg border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line-subtle">
        {# Same order the agent render uses: stale, then unknown, then ok. #}
        {% for want in ('stale', 'unknown', 'ok') %}
        {% for c in hp_checks if c.status == want %}
        <tr class="hover:bg-surface-subtle">
          <td class="px-4 py-2 text-fg-secondary whitespace-nowrap">
            <span class="inline-block w-2 h-2 rounded-full mr-1 align-middle
              {% if c.status == 'unknown' %}bg-surface-strong{% elif c.status == 'stale' %}{% if c.severity == 'critical' %}bg-danger-solid-soft{% else %}bg-warning-solid-soft{% endif %}{% else %}bg-success-solid-soft{% endif %}"></span>
            <span class="font-mono text-xs">{{ c.id }}</span>
            {% if c.live %}<span class="text-xs text-success" title="re-probed at render time, not from the snapshot">· live</span>{% endif %}
          </td>
          <td class="px-4 py-2 text-fg-subtle text-xs">{{ c.detail }}</td>
          <td class="px-4 py-2 text-right tabular-nums whitespace-nowrap {% if c.status == 'stale' %}text-warning-strong font-semibold{% else %}text-fg-faint{% endif %}">
            {% if c.age_hours is not none %}{{ '%.1f'|format(c.age_hours) }}h{% else %}—{% endif %}
          </td>
        </tr>
        {% endfor %}
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

<!-- Background health — spin loops (a worker re-claiming the same ref
     every pass) + failed worker passes, both over 24h. These are the
     derived-queue failure modes that are otherwise invisible until
     someone reads ref_events by hand. Green "all clear" when empty. -->
{% set spin = bg_health.get('spin_loops', []) %}
{% set fails = bg_health.get('failed_passes', []) %}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Background health</h2>
  {% if not spin and not fails %}
  <div class="rounded-lg border border-success bg-success-subtle p-3 text-sm text-success-strong">
    <span class="inline-block w-2 h-2 rounded-full mr-1 align-middle bg-success-solid-soft"></span>
    No spin loops or failed passes in the last 24h.
  </div>
  {% else %}
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    {% if spin %}
    <div class="rounded-lg border border-danger bg-surface overflow-hidden">
      <div class="px-4 py-2 text-xs uppercase tracking-wide text-danger bg-danger-subtle font-medium">
        Spin loops ({{ spin|length }}) — same ref re-claimed every pass
      </div>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-line-subtle">
          {% for s in spin %}
          <tr class="hover:bg-surface-subtle">
            <td class="px-4 py-2 font-mono text-fg-secondary">#{{ s.ref_id }}</td>
            <td class="px-4 py-2 font-mono text-fg-muted">{{ s.source }}</td>
            <td class="px-4 py-2 text-fg-subtle">{{ s.last_event }}</td>
            <td class="px-4 py-2 text-right font-semibold text-danger-strong tabular-nums">{{ s.count }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
    {% if fails %}
    <div class="rounded-lg border border-warning bg-surface overflow-hidden">
      <div class="px-4 py-2 text-xs uppercase tracking-wide text-warning-strong bg-warning-subtle font-medium">
        Failed passes ({{ fails|length }}) — 24h, by handler
      </div>
      <table class="w-full text-sm">
        <tbody class="divide-y divide-line-subtle">
          {% for f in fails %}
          <tr class="hover:bg-surface-subtle">
            <td class="px-4 py-2 font-mono text-fg-secondary">{{ f.host }}</td>
            <td class="px-4 py-2 font-mono text-fg-muted">{{ f.handler }}</td>
            <td class="px-4 py-2 text-right font-semibold text-warning-strong tabular-nums">{{ f.failed }}</td>
            <td class="px-4 py-2 text-right text-fg-faint">{{ f.ago }}</td>
          </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
    {% endif %}
  </div>
  {% endif %}
</section>

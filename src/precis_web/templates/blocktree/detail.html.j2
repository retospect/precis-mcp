{% extends "base.html.j2" %}
{% block title %}{{ title }}{% endblock %}
{% block content %}

<div class="flex items-center gap-3 mb-4">
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-fg-subtle">{{ kind_label }} · {{ slug }}</span>
  <a href="/{{ kind }}/{{ slug | urlencode }}/code" class="text-xs text-info hover:underline ml-auto">Code →</a>
  <a href="{{ view3d_url }}" class="text-xs text-info hover:underline">3D view →</a>
</div>

<p class="text-xs text-fg-subtle mb-4">Envelope projections along the selected axis. Each outline is the convex hull of a block's envelope; collapsed subtrees show bounding rectangles. Inspect realized geometry in the 3D view.</p>

<form method="get" class="flex flex-wrap items-end gap-3 mb-4 text-sm">
  <div>
    <label class="block text-xs text-fg-subtle mb-1">view axis</label>
    <select name="axis" class="border border-line-strong rounded px-2 py-1">
      {% for a in axes %}
        <option value="{{ a }}" {{ 'selected' if a == axis else '' }}>{{ a }}</option>
      {% endfor %}
    </select>
  </div>
  <div>
    <label class="block text-xs text-fg-subtle mb-1">abstraction level</label>
    <select name="level" class="border border-line-strong rounded px-2 py-1">
      {% for lv in levels %}
        <option value="{{ lv }}" {{ 'selected' if lv == level else '' }}>{{ lv }}</option>
      {% endfor %}
    </select>
  </div>
  <div>
    <label class="block text-xs text-fg-subtle mb-1">colour</label>
    <select name="colour" class="border border-line-strong rounded px-2 py-1">
      {% for c in colour_channels %}
        <option value="{{ c }}" {{ 'selected' if c == colour else '' }}>{{ c }}</option>
      {% endfor %}
    </select>
  </div>
  <div>
    <label class="block text-xs text-fg-subtle mb-1">isolate subtree</label>
    <select name="isolate" class="border border-line-strong rounded px-2 py-1">
      <option value="">(whole design)</option>
      {% for b in block_names %}
        <option value="{{ b }}" {{ 'selected' if b == isolate else '' }}>{{ b }}</option>
      {% endfor %}
    </select>
  </div>
  <div>
    <label class="block text-xs text-fg-subtle mb-1" title="per-subtree level override: name:level, name2:level2">level overrides</label>
    <input type="text" name="overrides" value="{{ overrides }}" placeholder="hub:realized, rest:envelope"
           class="border border-line-strong rounded px-2 py-1 w-56" />
  </div>
  <button type="submit" class="px-3 py-1 rounded bg-solid-strong text-on-solid">apply</button>
</form>

{# The reader rides static/viewport.js (pcb-workbench-layout.md slice 3):
   the svg loads as an <object> so its viewBox is the camera — wheel/pinch
   zooms toward the cursor, two-finger scroll and drags pan, double-click
   empty space or f fits, 0/+/- are the same keys the pcb panes carry. #}
<div id="se-2d-pane" class="rounded-lg border border-line bg-surface p-2"
     style="height: 72vh; display: flex; flex-direction: column;">
  <div class="vp-tools mb-1 inline-flex gap-1">
    <button type="button" data-vp="in" data-shortcut-label="Zoom in" title="zoom in (+)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">+</button>
    <button type="button" data-vp="out" data-shortcut-label="Zoom out" title="zoom out (-)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">−</button>
    <button type="button" data-vp="fit" data-shortcut-label="Fit view" title="fit view (f, or double-click empty space)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">fit</button>
    <button type="button" data-vp="reset" data-shortcut-label="Reset view" title="reset view (0)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">reset</button>
  </div>
  <object id="se-2d-object" type="image/svg+xml" data="{{ svg_url }}"
          aria-label="{{ title }} — {{ axis }} view"
          style="flex: 1 1 auto; min-height: 0; width: 100%;">
    <img src="{{ svg_url }}" alt="{{ title }} — {{ axis }} view" class="w-full h-auto" />
  </object>
</div>
{% endblock %}
{% block scripts %}
<script src="/static/viewport.js" defer></script>
<script src="/static/se-2d.js" defer></script>
{% endblock %}

{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% from "_design_chat.html.j2" import design_chat %}
{% block title %}{{ title }} — 3D{% endblock %}
{% block content %}
<link rel="stylesheet" href="/static/three-cad-viewer/three-cad-viewer.css" />
<!-- our own overrides for the vendored chrome above (gr337753/gr337747/
     gr337752/gr340029/gr340030) -- NEVER edit the vendored stylesheet
     itself. -->
<link rel="stylesheet" href="/static/blocktree-3d-overrides.css" />

<div class="flex items-center gap-3 mb-4">
  {{ drive_back(kind, kind_label) }}
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-slate-500">{{ kind_label }} · {{ slug }}</span>
  {% if read_only %}
  <span id="bt3d-readonly" class="text-[11px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200"
        title="A past revision — the tree as it was at save {{ rev }}. Nothing here can be edited; go to the current revision to comment or edit.">
    read-only · revision {{ rev }} of {{ rev_current }} ·
    <a class="underline" href="/{{ kind }}/{{ slug | urlencode }}">current</a>
  </span>
  {% endif %}
  <a href="{{ detail_2d_url }}" class="text-xs text-blue-600 hover:underline ml-auto">Envelope projections →</a>
</div>

{% if validate_panel %}
<details id="bt3d-validate" class="mb-4 text-sm">
  <summary class="cursor-pointer {{ 'text-red-700' if validate_panel.rows else 'text-slate-600' }}">{{ validate_panel.digest }}</summary>
  {% if validate_panel.rows %}
  <table class="mt-2 text-xs border border-slate-200">
    <thead><tr class="bg-slate-50 text-left"><th class="px-2 py-1">severity</th><th class="px-2 py-1">rule</th><th class="px-2 py-1">subject</th><th class="px-2 py-1">detail</th></tr></thead>
    <tbody>
    {% for r in validate_panel.rows %}
      <tr class="border-t border-slate-200{% if r.targets %} cursor-pointer{% endif %}" data-validation-row><td class="px-2 py-1">{{ r.severity }}</td><td class="px-2 py-1">{{ r.rule }}</td><td class="px-2 py-1">{{ r.subject }}</td><td class="px-2 py-1">
        {% if r.targets %}
        <button type="button" data-validation-subject="{{ r.subject }}" aria-pressed="false"
                class="text-left text-blue-700 underline rounded focus:outline focus:outline-2"
                title="Select {{ r.subject }} in the shown design">{{ r.detail }}</button>
        {% else %}{{ r.detail }} <span class="text-slate-500">{{ r.unavailable }}</span>{% endif %}
      </td></tr>
    {% endfor %}
    </tbody>
  </table>
  <p id="bt3d-validation-status" role="status" aria-live="polite" class="mt-1 text-xs text-slate-600"></p>
  <a href="" class="text-xs text-blue-700 underline" data-validation-refresh hidden>Refresh shown design</a>
  {% endif %}
</details>
{% endif %}

{# The three scene-shaping controls are NOT a form any more: changing one
   swaps the scene in place (blocktree-3d.js's live-scene seam) instead of
   reloading the page and resetting the camera. They keep their `name`
   attributes only as labels — nothing submits them. #}
<div class="flex flex-wrap items-end gap-3 mb-4 text-sm">
  <div>
    <label class="block text-xs text-slate-500 mb-1" for="bt3d-level">abstraction level</label>
    <select id="bt3d-level" class="border border-slate-300 rounded px-2 py-1">
      {% for lv in levels %}
        <option value="{{ lv }}" {{ 'selected' if lv == level else '' }}>{{ lv }}</option>
      {% endfor %}
    </select>
  </div>
  <div>
    <label class="block text-xs text-slate-500 mb-1" for="bt3d-isolate">isolate subtree</label>
    <select id="bt3d-isolate" class="border border-slate-300 rounded px-2 py-1"
            title="filters the scene already in hand — no rebuild, no reload">
      <option value="">(whole design)</option>
      {% for b in block_names %}
        <option value="{{ b }}" {{ 'selected' if b == isolate else '' }}>{{ b }}</option>
      {% endfor %}
    </select>
  </div>
  {# Hidden state carrier: the per-block level chips in the tree rows
     (blocktree-3d.js) read and write it, then refetch via loadScene. #}
  <div hidden>
    <label class="block text-xs text-slate-500 mb-1" for="bt3d-overrides" title="per-subtree level override: name:level, name2:level2">level overrides</label>
    <input type="text" id="bt3d-overrides" value="{{ overrides }}" placeholder="hub:realized, rest:envelope"
           class="border border-slate-300 rounded px-2 py-1 w-56" />
  </div>
  {# `level` and `overrides` refetch and re-render, which on a real design
     is seconds (gr458329 measured ~3 s on a 20-block machine). Without a
     mark the page looks like it ignored the change. #}
  <span id="bt3d-busy" class="text-xs text-slate-500" hidden>rebuilding scene…</span>
  <button type="button" id="bt3d-explode" class="px-3 py-1 rounded border border-slate-300 hover:bg-slate-100">
    explode
  </button>
  <span class="flex items-center gap-1 text-xs text-slate-600"
        title="the view as on screen, scale bar included — the SVG holds the scene as an image and the scale bar as vector">
    export
    <button type="button" id="bt3d-export-png" class="px-2 py-0.5 rounded border border-slate-300 hover:bg-slate-100">PNG</button>
    <button type="button" id="bt3d-export-svg" class="px-2 py-0.5 rounded border border-slate-300 hover:bg-slate-100">SVG snapshot</button>
    {# Atom files (the current design; not offered on a past revision): every
       structure-bound block's atoms in Å in the design's world frame. #}
    {% if has_atomic and not read_only %}
    <a id="bt3d-export-xyz" href="/{{ kind }}/{{ slug | urlencode }}/atoms.xyz" download
       title="every structure-bound block's atoms, Å, design world frame (extended XYZ)"
       class="px-2 py-0.5 rounded border border-slate-300 hover:bg-slate-100">xyz</a>
    <a id="bt3d-export-pdb" href="/{{ kind }}/{{ slug | urlencode }}/atoms.pdb" download
       title="the same atoms as PDB, one chain per block (or the structure's own chains)"
       class="px-2 py-0.5 rounded border border-slate-300 hover:bg-slate-100">pdb</a>
    {% endif %}
  </span>
  <label class="flex items-center gap-1 text-xs text-slate-600">
    <input type="checkbox" id="bt3d-connections" checked />
    connections
  </label>
  <label class="flex items-center gap-1 text-xs text-slate-600"
         title="the x/y/z orientation marker in the corner of the 3D view; PNG/SVG export includes it only while this is on">
    <input type="checkbox" id="bt3d-axes" checked />
    axes
  </label>
  <label class="flex items-center gap-1 text-xs text-slate-600">
    containers
    <select id="bt3d-container-mode" class="border border-slate-300 rounded px-1 py-0.5"
            title="a block with both its own envelope and visible children renders as a container box around them — translucent (default) lets you see inside without hiding the box entirely">
      <option value="translucent" selected>translucent</option>
      <option value="solid">solid</option>
      <option value="hidden">hidden</option>
    </select>
  </label>
  {% if has_atomic %}
  <label class="flex items-center gap-1 text-xs text-slate-600"
         title="off shows the plain block envelopes instead — the slider does not do this, its far end swaps atoms for the smoothed surface, which is still the structure">
    <input type="checkbox" id="bt3d-atoms" checked />
    atoms
  </label>
  <label id="bt3d-target-label" class="hidden items-center gap-1 text-xs text-slate-600"
         title="the smooth surface the generator fitted the atoms to (translucent)">
    <input type="checkbox" id="bt3d-target" />
    target surface
  </label>
  <div class="flex items-center gap-2">
    <label for="bt3d-smooth" class="text-xs text-slate-600" title="0 = full atomic detail, 100 = smoothed surface coloured by scaffold deviation">
      atomic ↔ smooth
    </label>
    <input type="range" id="bt3d-smooth" min="0" max="100" value="0" step="1" class="w-32" />
  </div>
  {# Strain layers (Reto, 2026-10-02): one row per
     measure, each on its own part of the picture with its own colour, all
     usable at once. A threshold slider per row; only what sits at or above
     it is coloured, default = the top 5%. Rows whose measure the structure
     does not carry stay hidden. #}
  <div id="bt3d-smooth-legend" class="hidden items-center gap-1 text-[11px] text-slate-500"
       title="each atom's distance from its own smoothed position (the structure smoothed over its bonds, the far end of the atomic ↔ smooth slider); vertices below the threshold stay grey">
    <span>deviation from smoothed</span>
    <input type="range" id="bt3d-dev-threshold" data-role="threshold" min="0" max="1000" value="950" step="1" class="w-20" />
    <span class="inline-block w-16 h-2 rounded" style="background: linear-gradient(to right, #e0f2fe, #1d4ed8, #7f1d1d);"></span>
    ≥ <span data-role="value">0.00 Å</span>
    (<span id="bt3d-smooth-legend-min" data-role="min">0.00</span>–<span id="bt3d-smooth-legend-max" data-role="max">0.00</span>)
  </div>
  <div id="bt3d-layer-bond" class="hidden items-center gap-1 text-[11px] text-slate-500"
       title="C–C bonds coloured by |length − 1.42 Å|; bonds below the threshold stay grey">
    <label class="flex items-center gap-1"><input type="checkbox" id="bt3d-bond-strain" data-role="toggle" /> bond strain vs 1.42 Å</label>
    <input type="range" id="bt3d-bond-threshold" data-role="threshold" min="0" max="1000" value="950" step="1" class="w-20" />
    <span class="inline-block w-16 h-2 rounded" style="background: linear-gradient(to right, #22c55e, #16a34a, #14532d);"></span>
    ≥ <span data-role="value">0.000 Å</span>
    (<span data-role="min">0.000</span>–<span data-role="max">0.000</span>)
  </div>
  <div id="bt3d-layer-angle" class="hidden items-center gap-1 text-[11px] text-slate-500"
       title="3-coordinated carbon atoms coloured by θp (out-of-plane pyramidalization, picks out pentagons and heptagons) or by the RMS deviation of their bond angles from 120° (in-plane distortion); atoms below the threshold keep their element colour">
    <label class="flex items-center gap-1"><input type="checkbox" id="bt3d-angle-strain" data-role="toggle" /> angle strain</label>
    <select id="bt3d-angle-measure" data-role="measure" class="border border-slate-300 rounded px-1 py-0">
      <option value="thetap" selected>θp vs planar</option>
      <option value="120">vs 120°</option>
    </select>
    <input type="range" id="bt3d-angle-threshold" data-role="threshold" min="0" max="1000" value="950" step="1" class="w-20" />
    <span class="inline-block w-16 h-2 rounded" style="background: linear-gradient(to right, #fb923c, #ea580c, #7c2d12);"></span>
    ≥ <span data-role="value">0.0°</span>
    (<span data-role="min">0.0</span>–<span data-role="max">0.0</span>)
  </div>
  {% endif %}
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div>
    <h2 class="text-sm font-semibold text-slate-700 mb-2">Assembly</h2>
    {# Load progress (gr462703): sits above the viewer shell, not inside it —
       the viewer's fallback replaces the shell's children. blocktree-3d.js
       drives data-phase (scene|render|server|download|build|done|timeout). #}
    <div id="bt3d-progress" data-phase="scene" class="mb-1">
      <div id="bt3d-progress-track"><div id="bt3d-progress-fill"></div></div>
      <div id="bt3d-progress-label" class="text-xs text-slate-500" aria-live="polite">loading design…</div>
    </div>
    <div id="bt3d-viewer" class="relative w-full rounded-lg border border-slate-200 bg-white" style="height: 520px;"
         data-svg-url="{{ svg_url }}" data-2d-url="{{ detail_2d_url }}"></div>
    <p class="text-[11px] text-slate-400 mt-1">
      Drag to rotate · scroll to zoom · click a feature to select (vertex/edge/face/solid filter in the tree panel) ·
      <b>explode</b> pulls parts apart along their drawn attachment directions · selecting a block also highlights its
      drawn connections and the linked mermaid node.
      {% if rev_explicit and has_record %}Blocks added or changed at revision {{ rev }} are tinted amber.{% endif %}
    </p>

    {# ── revision scrubber (design-workbench build, slice 2) ──
       A plain GET form of its own: the range input submits on change, the
       prev/next links are ordinary anchors; level/isolate/overrides ride
       along as hidden inputs so scrubbing keeps the view settings. A
       design saved before the record existed spans one position. #}
    {% if revision %}
    <div id="bt3d-revision" class="mt-3 rounded-lg border border-slate-200 bg-white text-xs">
      <form method="get" action="/{{ kind }}/{{ slug | urlencode }}" class="flex items-center gap-2 px-3 py-2 border-b border-slate-100">
        <input type="hidden" name="level" value="{{ level }}">
        {% if isolate %}<input type="hidden" name="isolate" value="{{ isolate }}">{% endif %}
        {% if overrides %}<input type="hidden" name="overrides" value="{{ overrides }}">{% endif %}
        <span class="font-semibold text-slate-700">Revision</span>
        {% if has_record and rev > 1 %}
        <a class="text-emerald-700 hover:underline" href="/{{ kind }}/{{ slug | urlencode }}?rev={{ rev - 1 }}&level={{ level }}" title="previous revision">‹ {{ rev - 1 }}</a>
        {% else %}<span class="text-slate-300">‹</span>{% endif %}
        <input type="range" name="rev" min="{{ 1 if has_record else rev_current }}" max="{{ rev_current }}" step="1" value="{{ rev }}"
               class="w-40" title="drag to a revision — the page reloads at that snapshot"
               onchange="this.form.submit()">
        {% if rev < rev_current %}
        <a class="text-emerald-700 hover:underline" href="/{{ kind }}/{{ slug | urlencode }}?rev={{ rev + 1 }}&level={{ level }}" title="next revision">{{ rev + 1 }} ›</a>
        {% else %}<span class="text-slate-300">›</span>{% endif %}
        <span class="tabular-nums text-slate-600">{{ rev }} / {{ rev_current }}</span>
        {% if not has_record %}
        <span class="text-slate-400">— current, no record</span>
        {% elif not read_only %}
        <span class="text-slate-400">— current</span>
        {% endif %}
        {% if revision.created %}<span class="ml-auto text-[10px] text-slate-400">{{ revision.created }}</span>{% endif %}
      </form>

      <div class="px-3 py-2 space-y-1.5">
        {% set d = revision.diff %}
        <div class="text-[10px] uppercase tracking-wide text-slate-400">
          {{ revision.n_blocks }} block{{ '' if revision.n_blocks == 1 else 's' }} ·
          changed since revision {{ rev - 1 }}
          {% if rev == 1 %}<span class="normal-case">(nothing — first save)</span>{% endif %}
        </div>
        {% if not has_record %}
          <p class="text-slate-400">No revision record — this design was saved before revisions were recorded.</p>
        {% elif not (d.added or d.removed or d.changed) %}
          <p class="text-slate-400">No block differs from the previous revision.</p>
        {% else %}
          {% if d.added %}
          <div><span class="text-emerald-700 font-semibold">+{{ d.added | length }} block{{ '' if d.added | length == 1 else 's' }}</span>
            {% for b in d.added %}<code class="text-slate-500" data-uid="{{ b.uid }}">{{ b.name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div>
          {% endif %}
          {% if d.removed %}
          <div><span class="text-red-700 font-semibold">−{{ d.removed | length }} block{{ '' if d.removed | length == 1 else 's' }}</span>
            {% for b in d.removed %}<code class="text-slate-500" data-uid="{{ b.uid }}">{{ b.name }}</code>{% if not loop.last %}, {% endif %}{% endfor %}</div>
          {% endif %}
          {% if d.changed %}
          <div><span class="text-amber-700 font-semibold">{{ d.changed | length }} changed</span>
            {% for b in d.changed %}<code class="text-slate-500" data-uid="{{ b.uid }}">{{ b.name }}</code> <span class="text-slate-400">({{ b.what | join(', ') }})</span>{% if not loop.last %}, {% endif %}{% endfor %}</div>
          {% endif %}
        {% endif %}

        <div class="pt-1 border-t border-slate-100">
          <span class="text-[10px] uppercase tracking-wide text-slate-400">Ops</span>
          {% if not revision.has_record %}
          <span class="text-slate-400">no op record</span>
          {% elif not revision.ops %}
          <span class="text-slate-400">none recorded (whole-tree save)</span>
          {% else %}
          <pre id="bt3d-revision-ops" class="mt-0.5 max-h-40 overflow-auto rounded bg-slate-50 p-2 font-mono text-[11px] text-slate-700 whitespace-pre">{% for line in revision.ops %}{{ line }}
{% endfor %}</pre>
          {% endif %}
          {% if revision.turn %}
          <div class="mt-0.5 text-slate-500">from turn <code>{{ revision.turn }}</code></div>
          {% endif %}
        </div>
      </div>
    </div>
    {% endif %}
    {% if pick_url %}
    {# se-pick-hierarchy: every level the picked atom or block belongs to,
       innermost first; "cite" drops that level's token into the design
       chat. Outside the canvas on purpose — the viewer-check pixel-diffs
       the canvas rectangle, and a popup over it would read as a change. #}
    <div id="bt3d-pick-panel" class="hidden mt-3 rounded-lg border border-slate-200 bg-white p-3 text-sm">
      <p class="text-xs text-slate-500 mb-2">Picked <b id="bt3d-pick-subject" class="text-slate-700"></b>
        <span class="text-slate-400">— click an atom for its residue, pair and strand; cite a level into the chat</span></p>
      <p id="bt3d-pick-status" class="text-xs text-red-700 hidden"></p>
      <table class="w-full text-xs"><tbody id="bt3d-pick-rows"></tbody></table>
    </div>
    {% endif %}
    {% if note_url %}
    <div id="bt3d-note-panel" class="hidden mt-3 rounded-lg border border-slate-200 bg-white p-3 text-sm">
      <p class="text-xs text-slate-500 mb-2">Comment on <b id="bt3d-note-block" class="text-slate-700"></b>
        <span class="text-slate-400">— saved into the design interview as a note</span></p>
      <textarea id="bt3d-note-raw" rows="2" placeholder="what do you want captured about this block?"
                class="w-full border border-slate-300 rounded px-2 py-1 mb-2"></textarea>
      <div class="flex items-center gap-2 mb-2">
        <button type="button" id="bt3d-note-suggest"
                class="px-3 py-1 rounded bg-slate-800 text-white text-xs">suggest note</button>
        <span id="bt3d-note-status" class="text-xs text-slate-500"></span>
      </div>
      <div id="bt3d-note-proposal" class="hidden">
        <textarea id="bt3d-note-text" rows="2"
                  class="w-full border border-slate-300 rounded px-2 py-1 mb-2"></textarea>
        <div class="flex items-center gap-2">
          <select id="bt3d-note-kind" class="border border-slate-300 rounded px-2 py-1 text-xs">
            <option value="question">question</option>
            <option value="decision">decision</option>
          </select>
          <button type="button" id="bt3d-note-save"
                  class="px-3 py-1 rounded border border-slate-300 hover:bg-slate-100 text-xs">save note</button>
        </div>
      </div>
    </div>
    {% elif read_only %}
    <p class="mt-3 text-xs text-slate-500">Read-only — you are viewing revision {{ rev }} of {{ rev_current }}; comments and edits go on
      <a class="text-emerald-700 hover:underline" href="/{{ kind }}/{{ slug | urlencode }}">the current revision</a>.</p>
    {% endif %}
  </div>
  <div>
    <h2 class="text-sm font-semibold text-slate-700 mb-2">Topology</h2>
    <div id="bt3d-topology" class="relative rounded-lg border border-slate-200 bg-white overflow-hidden" style="height: 520px;"></div>
    <p class="text-[11px] text-slate-400 mt-1">
      Blocks settle where their connects pull them · drag a node to pin it, double-click to release ·
      hover a node or link for detail · click a node to select it in the 3D view.
    </p>
    <!-- Fallback only: rendered when the cloud can't run (spec slice 1 —
         one release, then this dies). -->
    <div id="bt3d-mermaid-wrap" class="rounded-lg border border-slate-200 bg-white p-2 overflow-auto hidden" style="height: 520px;">
      <pre class="mermaid" id="bt3d-mermaid">graph LR</pre>
    </div>
  </div>
</div>

{% if print_files %}
{# Print files (routes/se_print.py): links only — the cheap report decided
   printability, the full print check runs when a link is clicked. #}
<div id="bt3d-print-files" class="mt-4 rounded-lg border border-slate-200 bg-white p-3 text-sm">
  <h2 class="text-sm font-semibold text-slate-700 mb-2">Print files</h2>
  <ul class="space-y-1">
    {% for pf in print_files %}
    <li>
      <span class="font-mono text-xs text-slate-700">{{ pf.block }}</span>
      <a class="text-blue-600 hover:underline ml-2" href="{{ pf.url }}" download>Download 3MF</a>
      <span class="text-xs text-slate-500 ml-2">{{ pf.errors }} error{{ '' if pf.errors == 1 else 's' }}, {{ pf.warns }} warning{{ '' if pf.warns == 1 else 's' }} (before the mesh check)</span>
    </li>
    {% endfor %}
  </ul>
  <p class="text-[11px] text-slate-400 mt-2">The download runs the full print check; its findings are in the agent's <code>view='print'</code> report.</p>
</div>
{% endif %}

{# ── design chat (design-workbench build, slice 3) — the shared partial;
   selecting a block in the viewer calls window.designChatAddHandle(name)
   through the viewer's onSelectBlock hook below. ── #}
{% if chat %}{{ design_chat(chat, rev, rev_current) }}{% endif %}

{% endblock %}
{% block scripts %}
{# One three.js for the vendored viewer and the atom overlay
   (static/three-cad-viewer/README.md). Must precede every module script. #}
<script type="importmap">
{"imports": {"three": "/static/three-r184/three.module.min.js"}}
</script>
{# Start the scene and atom fetches before mermaid and the module bundle
   load (~0.6 s on Reto's Safari reading, se-3d-viewer-6); blocktree-3d.js
   takes these responses when the URLs match (_takePrefetch). The no-op
   catch keeps a failed fetch from logging as unhandled before the module
   reads it. #}
<script>
  (() => {
    const start = (url) => {
      const ctl = new AbortController();
      const resp = fetch(url, { signal: ctl.signal });
      resp.catch(() => {});
      return { url, resp, ctl };
    };
    performance.mark("bt3d-prefetch-start");
    window.__bt3dPrefetch = {
      scene: start({{ scene_url | tojson }}),
      {% if has_atomic %}atomic: start({{ atomic3d_url | tojson }}),{% endif %}
    };
  })();
</script>
<script src="/static/mermaid/mermaid.min.js"></script>
<script type="module">
  import { blocktreeViewer3D } from "/static/blocktree-3d.js";
  blocktreeViewer3D({
    viewerEl: document.getElementById("bt3d-viewer"),
    mermaidEl: document.getElementById("bt3d-mermaid"),
    topologyEl: document.getElementById("bt3d-topology"),
    explodeButton: document.getElementById("bt3d-explode"),
    connectionsToggle: document.getElementById("bt3d-connections"),
    axesToggle: document.getElementById("bt3d-axes"),
    containerModeSelect: document.getElementById("bt3d-container-mode"),
    levelSelect: document.getElementById("bt3d-level"),
    isolateSelect: document.getElementById("bt3d-isolate"),
    overridesInput: document.getElementById("bt3d-overrides"),
    busyEl: document.getElementById("bt3d-busy"),
    progressEl: document.getElementById("bt3d-progress"),
    exportEls: {
      png: document.getElementById("bt3d-export-png"),
      svg: document.getElementById("bt3d-export-svg"),
    },
    exportName: {{ slug | tojson }},
    sceneUrl: {{ scene_url | tojson }},
    validationPanel: document.getElementById("bt3d-validate"),
    validationIdentity: {{ validation_identity | tojson }},
    validationUrl: {{ validation_url | tojson }},
    {% if has_atomic %}
    atomsToggle: document.getElementById("bt3d-atoms"),
    atomicUrl: {{ atomic3d_url | tojson }},
    smoothEls: {
      slider: document.getElementById("bt3d-smooth"),
      legend: document.getElementById("bt3d-smooth-legend"),
      legendMin: document.getElementById("bt3d-smooth-legend-min"),
      legendMax: document.getElementById("bt3d-smooth-legend-max"),
      targetToggle: document.getElementById("bt3d-target"),
      targetLabel: document.getElementById("bt3d-target-label"),
    },
    strainEls: {
      bond: document.getElementById("bt3d-layer-bond"),
      angle: document.getElementById("bt3d-layer-angle"),
    },
    {% endif %}
    onSelectBlock: (name) => { if (window.designChatAddHandle) window.designChatAddHandle(name); },
    {% if pick_url %}
    pickUrl: {{ pick_url | tojson }},
    pickEls: {
      panel: document.getElementById("bt3d-pick-panel"),
      subject: document.getElementById("bt3d-pick-subject"),
      status: document.getElementById("bt3d-pick-status"),
      rows: document.getElementById("bt3d-pick-rows"),
    },
    onCiteToken: (token) => { if (window.designChatAddToken) window.designChatAddToken(token); },
    {% endif %}
    {% if note_url %}
    noteUrls: { save: {{ note_url | tojson }}, rewrite: {{ note_rewrite_url | tojson }} },
    noteEls: {
      panel: document.getElementById("bt3d-note-panel"),
      blockLabel: document.getElementById("bt3d-note-block"),
      raw: document.getElementById("bt3d-note-raw"),
      suggestButton: document.getElementById("bt3d-note-suggest"),
      proposal: document.getElementById("bt3d-note-proposal"),
      text: document.getElementById("bt3d-note-text"),
      kind: document.getElementById("bt3d-note-kind"),
      saveButton: document.getElementById("bt3d-note-save"),
      status: document.getElementById("bt3d-note-status"),
    },
    {% endif %}
  });
</script>
{% endblock %}

{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% from "_design_chat.html.j2" import design_chat %}
{% block title %}{{ title }} — 3D{% endblock %}
{% block content %}
<link rel="stylesheet" href="/static/three-cad-viewer/three-cad-viewer.css" />
<!-- our own overrides for the vendored chrome above (gr337753/gr337747/
     gr337752/gr340029/gr340030) -- NEVER edit the vendored stylesheet
     itself. -->
<link rel="stylesheet" href="/static/blocktree-3d-overrides.css" />

<div class="flex items-center gap-3 mb-4">
  {{ drive_back(kind, kind_label) }}
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-fg-subtle">{{ kind_label }} · {{ slug }}</span>
  {# Always in the DOM, hidden on the current revision: the in-place
     scrubber (gr458084) shows and renumbers it without a reload. #}
  <span id="bt3d-readonly" {{ '' if read_only else 'hidden' }}
        class="text-[11px] px-1.5 py-0.5 rounded-full bg-warning-muted text-warning-deep border border-warning"
        title="A past revision — the tree as it was at that save. Nothing here can be edited; go to the current revision to comment or edit.">
    read-only · revision <span data-role="rev">{{ rev }}</span> of <span data-role="current">{{ rev_current }}</span> ·
    <a class="underline" href="/{{ kind }}/{{ slug | urlencode }}">current</a>
  </span>
  <a href="/{{ kind }}/{{ slug | urlencode }}/code" class="text-xs text-info hover:underline ml-auto">Code →</a>
  <a href="{{ detail_2d_url }}" class="text-xs text-info hover:underline">Envelope projections →</a>
  {% if flow_url %}<a href="{{ flow_url }}" class="text-xs text-info hover:underline">Flow →</a>{% endif %}
</div>

{% if show_validate %}
<details id="bt3d-validate" class="mb-4 text-sm" data-url="{{ validate_panel_url }}">
  <summary class="cursor-pointer text-fg-subtle">validate: checking…</summary>
</details>
{% endif %}

{% if structures %}
{# gr504809: whether and how each bound structure was relaxed, read off the
   relax records (precis_web/relax_provenance.py). The description column is
   the author's free text and is labelled as such: it is never read as a
   recorded relax. #}
{% set tone_cls = {
  "success": "bg-success-subtle text-success-strong border-success",
  "info": "bg-info-subtle text-info-strong border-info",
  "warning": "bg-warning-muted text-warning-deep border-warning",
  "danger": "bg-danger-subtle text-danger-strong border-danger",
} %}
<details id="bt3d-structures" open class="mb-4 rounded-lg border border-line bg-surface text-sm">
  <summary class="cursor-pointer px-3 py-2">
    <span class="font-semibold text-fg-secondary">Structures &amp; relaxation</span>
    <span class="text-xs text-fg-subtle">— {{ structures_summary }}{% if read_only %} · the structures as they are now, not at revision {{ rev }}{% endif %}</span>
  </summary>
  <table class="w-full text-xs border-t border-line-subtle">
    <thead class="text-fg-faint text-left">
      <tr><th class="px-3 py-1 font-normal">block</th><th class="px-3 py-1 font-normal">structure</th><th class="px-3 py-1 font-normal">relaxation</th></tr>
    </thead>
    <tbody>
    {% for s in structures %}
      <tr class="border-t border-line-subtle align-top" data-block="{{ s.block }}" data-relax-state="{{ s.relax.state }}">
        <td class="px-3 py-2 font-mono text-fg-secondary">{{ s.block }}</td>
        <td class="px-3 py-2 whitespace-nowrap">
          {% if s.href %}<a class="text-info hover:underline" href="{{ s.href }}">{{ s.slug }}</a>{% else %}<span class="text-fg-subtle">{{ s.slug }}</span>{% endif %}
          {% if s.handle %}<span class="text-fg-faint"> · {{ s.handle }}</span>{% endif %}
          {% if s.version %}<span class="text-fg-faint"> · v{{ s.version }}</span>{% endif %}
          {# gr504830: the shareable image (picture + legend + caption, the
             caption also in the file's metadata). #}
          {% if s.href %}<br><a class="text-info hover:underline" data-role="package"
             href="/{{ kind }}/{{ slug | urlencode }}/package/{{ s.block | urlencode }}.png" target="_blank"
             title="an image of this structure with a legend and a caption (refs, relax state, intent) to paste into chat; crop the caption off below the dashed line — the same text is in the image's metadata">package image</a>
          <a class="text-fg-faint hover:underline" href="/{{ kind }}/{{ slug | urlencode }}/package/{{ s.block | urlencode }}.svg" target="_blank">svg</a>{% endif %}
        </td>
        <td class="px-3 py-2">
          <span class="inline-block rounded border px-1.5 py-0.5 {{ tone_cls[s.relax.tone] }}">{{ s.relax.headline }}</span>
          {% if s.run_href %}<a class="ml-1 text-info hover:underline" href="{{ s.run_href }}">run r{{ s.relax.run_id }} →</a>{% endif %}
          <p class="mt-1 text-fg-subtle">{{ s.relax.detail }}</p>
          {% if s.description %}<p class="mt-1 text-fg-faint" title="free text typed by whoever saved the structure; precis does not check it">description (free text, not checked): <span class="text-fg-subtle">{{ s.description }}</span></p>{% endif %}
        </td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
</details>
{% endif %}

{# The three scene-shaping controls are NOT a form any more: changing one
   swaps the scene in place (blocktree-3d.js's live-scene seam) instead of
   reloading the page and resetting the camera. They keep their `name`
   attributes only as labels — nothing submits them. #}
<div class="flex flex-wrap items-end gap-3 mb-4 text-sm">
  <div>
    <label class="block text-xs text-fg-subtle mb-1" for="bt3d-level">abstraction level</label>
    <select id="bt3d-level" class="border border-line-strong rounded px-2 py-1">
      {% for lv in levels %}
        <option value="{{ lv }}" {{ 'selected' if lv == level else '' }}>{{ lv }}</option>
      {% endfor %}
    </select>
  </div>
  <div>
    <label class="block text-xs text-fg-subtle mb-1" for="bt3d-isolate">isolate subtree</label>
    <select id="bt3d-isolate" class="border border-line-strong rounded px-2 py-1"
            title="filters the scene already in hand — no rebuild, no reload">
      <option value="">(whole design)</option>
      {% for b in block_names %}
        <option value="{{ b }}" {{ 'selected' if b == isolate else '' }}>{{ b }}</option>
      {% endfor %}
    </select>
  </div>
  {# Hidden state carrier: the per-block level chips in the tree rows
     (blocktree-3d.js) read and write it, then refetch via loadScene. #}
  <div hidden>
    <label class="block text-xs text-fg-subtle mb-1" for="bt3d-overrides" title="per-subtree level override: name:level, name2:level2">level overrides</label>
    <input type="text" id="bt3d-overrides" value="{{ overrides }}" placeholder="hub:realized, rest:envelope"
           class="border border-line-strong rounded px-2 py-1 w-56" />
  </div>
  {# `level` and `overrides` refetch and re-render, which on a real design
     is seconds (gr458329 measured ~3 s on a 20-block machine). Without a
     mark the page looks like it ignored the change. #}
  <span id="bt3d-busy" class="text-xs text-fg-subtle" hidden>rebuilding scene…</span>
  <button type="button" id="bt3d-explode" class="px-3 py-1 rounded border border-line-strong hover:bg-surface-muted">
    explode
  </button>
  {# The shared camera keys (pcb-workbench-layout.md's gesture table —
     se 3D column): the same f/0/+/- the SVG panes carry, registered on
     data-shortcut so `?` lists them; blocktree-3d.js maps the clicks to
     the vendored viewer's reset/zoom. #}
  <span class="vp-tools flex items-center gap-1" role="group" aria-label="view">
    <button type="button" id="bt3d-vp-in" data-shortcut="+" data-shortcut-label="Zoom in"
            title="zoom in (+)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">+</button>
    <button type="button" id="bt3d-vp-out" data-shortcut="-" data-shortcut-label="Zoom out"
            title="zoom out (-)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">−</button>
    <button type="button" id="bt3d-vp-fit" data-shortcut="f" data-shortcut-label="Fit view"
            title="fit view (f) — or double-click empty space" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">fit</button>
    <button type="button" id="bt3d-vp-reset" data-shortcut="0" data-shortcut-label="Reset view"
            title="reset view (0)" class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">reset</button>
    {# gr508637: dark chrome + canvas and a night atom palette; and the
       viewer filling the window (Esc exits). #}
    <button type="button" id="bt3d-night" aria-pressed="false"
            title="night mode — dark viewer and canvas; atoms switch to the night palette"
            class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">night</button>
    <button type="button" id="bt3d-full" aria-pressed="false"
            title="full window — the viewer fills the screen (Esc exits)"
            class="rounded border border-line px-1 font-mono text-xs text-fg-secondary">full</button>
  </span>
  <span class="flex items-center gap-1 text-xs text-fg-muted"
        title="the view as on screen, scale bar included — the SVG holds the scene as an image and the scale bar as vector">
    export
    <button type="button" id="bt3d-export-png" class="px-2 py-0.5 rounded border border-line-strong hover:bg-surface-muted">PNG</button>
    <button type="button" id="bt3d-export-svg" class="px-2 py-0.5 rounded border border-line-strong hover:bg-surface-muted">SVG snapshot</button>
    {# Atom files (the current design; not offered on a past revision): every
       structure-bound block's atoms in Å in the design's world frame. #}
    {% if has_atomic and not read_only %}
    <a id="bt3d-export-xyz" href="/{{ kind }}/{{ slug | urlencode }}/atoms.xyz" download
       title="every structure-bound block's atoms, Å, design world frame (extended XYZ)"
       class="px-2 py-0.5 rounded border border-line-strong hover:bg-surface-muted">xyz</a>
    <a id="bt3d-export-pdb" href="/{{ kind }}/{{ slug | urlencode }}/atoms.pdb" download
       title="the same atoms as PDB, one chain per block (or the structure's own chains)"
       class="px-2 py-0.5 rounded border border-line-strong hover:bg-surface-muted">pdb</a>
    {% endif %}
  </span>
  <label class="flex items-center gap-1 text-xs text-fg-muted">
    <input type="checkbox" id="bt3d-connections" checked />
    connections
  </label>
  {% if kind == "se" %}
  <label class="flex items-center gap-1 text-xs text-fg-muted"
         title="the swept fastener, driver and hand volumes behind each blocked insertion-path finding (red path, amber driver, purple hand)">
    <input type="checkbox" id="bt3d-tool-volumes" />
    tool volumes
  </label>
  {% if has_realized %}
  <label class="flex items-center gap-1 text-xs text-fg-muted"
         title="at the realized ladder rung (or a block's z chip), draw the bound cad design's realized component meshes instead of the envelope — coarse, server-cached; off draws envelopes everywhere, exactly as before">
    <input type="checkbox" id="bt3d-meshes" />
    meshes
  </label>
  {% endif %}
  {% endif %}
  <label class="flex items-center gap-1 text-xs text-fg-muted"
         title="the x/y/z orientation marker in the corner of the 3D view; PNG/SVG export includes it only while this is on">
    <input type="checkbox" id="bt3d-axes" checked />
    axes
  </label>
  <label class="flex items-center gap-1 text-xs text-fg-muted">
    containers
    <select id="bt3d-container-mode" class="border border-line-strong rounded px-1 py-0.5"
            title="a block with both its own envelope and visible children renders as a container box around them — translucent (default) lets you see inside without hiding the box entirely">
      <option value="translucent" selected>translucent</option>
      <option value="solid">solid</option>
      <option value="hidden">hidden</option>
    </select>
  </label>
  {% if has_atomic %}
  <label class="flex items-center gap-1 text-xs text-fg-muted"
         title="off shows the plain block envelopes instead — the slider does not do this, its far end swaps atoms for the smoothed surface, which is still the structure">
    <input type="checkbox" id="bt3d-atoms" checked />
    atoms
  </label>
  <label id="bt3d-target-label" class="hidden items-center gap-1 text-xs text-fg-muted"
         title="the smooth surface the generator fitted the atoms to (translucent)">
    <input type="checkbox" id="bt3d-target" />
    target surface
  </label>
  <div class="flex items-center gap-2">
    <label for="bt3d-smooth" class="text-xs text-fg-muted" title="0 = full atomic detail, 100 = smoothed surface coloured by scaffold deviation">
      atomic ↔ smooth
    </label>
    <input type="range" id="bt3d-smooth" min="0" max="100" value="0" step="1" class="w-32" />
  </div>
  {# Strain layers (Reto, 2026-10-02): one row per
     measure, each on its own part of the picture with its own colour, all
     usable at once. A threshold slider per row; only what sits at or above
     it is coloured, default = the top 5%. Rows whose measure the structure
     does not carry stay hidden. #}
  <div id="bt3d-smooth-legend" class="hidden items-center gap-1 text-[11px] text-fg-subtle"
       title="each atom's distance from its own smoothed position (the structure smoothed over its bonds, the far end of the atomic ↔ smooth slider); vertices below the threshold stay grey">
    <span>deviation from smoothed</span>
    {# gr508636: the threshold slider IS the box plot — blocktree-3d.js
       draws whiskers/box/median/outliers from the overlay's stats and
       drag/keys move the marker. Keeps the range input's `.value`/`input`
       contract (viewer_check.py). #}
    <svg id="bt3d-dev-threshold" data-role="threshold" class="bt3d-boxplot" width="150" height="30"
         viewBox="0 0 150 30" role="slider" tabindex="0"
         aria-label="deviation threshold" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="950"></svg>
    <span class="inline-block w-16 h-2 rounded" style="background: linear-gradient(to right, #e0f2fe, #1d4ed8, #7f1d1d);"></span>
    ≥ <span data-role="value">0.00 Å</span>
    (<span id="bt3d-smooth-legend-min" data-role="min">0.00</span>–<span id="bt3d-smooth-legend-max" data-role="max">0.00</span>)
  </div>
  <div id="bt3d-layer-bond" class="hidden items-center gap-1 text-[11px] text-fg-subtle"
       title="C–C bonds coloured by |length − 1.42 Å|; bonds below the threshold stay grey">
    <label class="flex items-center gap-1"><input type="checkbox" id="bt3d-bond-strain" data-role="toggle" /> bond strain vs 1.42 Å</label>
    <svg id="bt3d-bond-threshold" data-role="threshold" class="bt3d-boxplot" width="150" height="30"
         viewBox="0 0 150 30" role="slider" tabindex="0"
         aria-label="bond strain threshold" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="950"></svg>
    <span class="inline-block w-16 h-2 rounded" style="background: linear-gradient(to right, #22c55e, #16a34a, #14532d);"></span>
    ≥ <span data-role="value">0.000 Å</span>
    (<span data-role="min">0.000</span>–<span data-role="max">0.000</span>)
  </div>
  <div id="bt3d-layer-angle" class="hidden items-center gap-1 text-[11px] text-fg-subtle"
       title="3-coordinated carbon atoms coloured by θp (out-of-plane pyramidalization, picks out pentagons and heptagons) or by the RMS deviation of their bond angles from 120° (in-plane distortion); atoms below the threshold keep their element colour">
    <label class="flex items-center gap-1"><input type="checkbox" id="bt3d-angle-strain" data-role="toggle" /> angle strain</label>
    <select id="bt3d-angle-measure" data-role="measure" class="border border-line-strong rounded px-1 py-0">
      <option value="thetap" selected>θp vs planar</option>
      <option value="120">vs 120°</option>
    </select>
    <svg id="bt3d-angle-threshold" data-role="threshold" class="bt3d-boxplot" width="150" height="30"
         viewBox="0 0 150 30" role="slider" tabindex="0"
         aria-label="angle strain threshold" aria-valuemin="0" aria-valuemax="1000" aria-valuenow="950"></svg>
    <span class="inline-block w-16 h-2 rounded" style="background: linear-gradient(to right, #fb923c, #ea580c, #7c2d12);"></span>
    ≥ <span data-role="value">0.0°</span>
    (<span data-role="min">0.0</span>–<span data-role="max">0.0</span>)
  </div>
  {% endif %}
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
  <div>
    <h2 class="text-sm font-semibold text-fg-secondary mb-2">Assembly</h2>
    {# Load progress (gr462703): sits above the viewer shell, not inside it —
       the viewer's fallback replaces the shell's children. blocktree-3d.js
       drives data-phase (scene|render|server|download|build|done|timeout|error). #}
    <div id="bt3d-progress" data-phase="scene" class="mb-1">
      <div id="bt3d-progress-track"><div id="bt3d-progress-fill"></div></div>
      <div id="bt3d-progress-label" class="text-xs text-fg-subtle" aria-live="polite">loading design…</div>
    </div>
    <div id="bt3d-viewer" class="relative w-full rounded-lg border border-line bg-surface" style="height: 520px;"
         {% if focus %}data-focus="{{ focus }}"{% endif %}
         {% if ray %}data-ray="{{ ray }}"{% endif %}
         data-svg-url="{{ svg_url }}" data-2d-url="{{ detail_2d_url }}"></div>
    <p class="text-[11px] text-fg-faint mt-1">
      Drag to rotate · scroll to zoom · click a feature to select (vertex/edge/face/solid filter in the tree panel) ·
      <b>explode</b> pulls parts apart along their drawn attachment directions · selecting a block also highlights its
      drawn connections and the linked topology node.
      {% if rev_explicit and has_record %}Blocks added or changed at revision {{ rev }} are tinted amber.{% endif %}
    </p>

    {# ── revision scrubber (design-workbench build, slice 2) ──
       Not a form since gr458084: the range input and the prev/next
       anchors go through blocktree-3d.js's live-scene seam (scene3d.json
       ?rev=N re-rendered with the camera held, the panel body refetched
       from revision.html), so stepping revisions no longer reloads the
       page. The body is the shared partial that route serves. #}
    {% if revision %}
    <div id="bt3d-revision" class="mt-3 rounded-lg border border-line bg-surface text-xs"
         data-rev="{{ rev }}" data-rev-current="{{ rev_current }}">
      {% include "blocktree/_revision_panel.html.j2" %}
    </div>
    {% endif %}
    {% if pick_url %}
    {# se-pick-hierarchy: every level the picked atom or block belongs to,
       innermost first; "cite" drops that level's token into the design
       chat. Outside the canvas on purpose — the viewer-check pixel-diffs
       the canvas rectangle, and a popup over it would read as a change. #}
    <div id="bt3d-pick-panel" class="hidden mt-3 rounded-lg border border-line bg-surface p-3 text-sm">
      <p class="text-xs text-fg-subtle mb-2">Picked <b id="bt3d-pick-subject" class="text-fg-secondary"></b>
        <span class="text-fg-faint">— click an atom for its residue, pair and strand; cite a level into the chat</span></p>
      <p id="bt3d-pick-status" class="text-xs text-danger-strong hidden"></p>
      <table class="w-full text-xs"><tbody id="bt3d-pick-rows"></tbody></table>
    </div>
    {% endif %}
    {% if note_url %}
    {# Argue with the design — the pcb argue box back-ported
       (docs/backlog/pcb-argue-backport-se.md): ONE always-present box,
       not a per-selection panel; a block pick drops its handle at the
       caret so one note can carry several anchors in the user's own
       sentence order. se keeps the rewrite step pcb skips: raw words →
       suggest (AI rewrite) → editable proposal → save. #}
    <div id="bt3d-argue" class="mt-3 rounded-lg border border-line bg-surface p-3 text-sm">
      <p class="text-xs text-fg-subtle mb-2">Argue with the design
        <span class="text-fg-faint">— double-click a block to drop its handle at the caret; saved into the design interview as a note</span></p>
      <textarea id="bt3d-argue-raw" rows="2" placeholder="hub needs a stiffer link to rim, and wheel.bore_d is undersized …"
                class="w-full border border-line-strong rounded px-2 py-1 mb-2"></textarea>
      <div class="flex items-center gap-2 mb-2">
        <button type="button" id="bt3d-argue-suggest"
                class="px-3 py-1 rounded bg-solid-strong text-on-solid text-xs">suggest note</button>
        <span id="bt3d-argue-status" class="text-xs text-fg-subtle"></span>
      </div>
      <div id="bt3d-argue-proposal" class="hidden">
        <textarea id="bt3d-argue-text" rows="2"
                  class="w-full border border-line-strong rounded px-2 py-1 mb-2"></textarea>
        <div class="flex items-center gap-2">
          <select id="bt3d-argue-kind" class="border border-line-strong rounded px-2 py-1 text-xs">
            <option value="question">question</option>
            <option value="decision">decision</option>
          </select>
          <button type="button" id="bt3d-argue-save"
                  class="px-3 py-1 rounded border border-line-strong hover:bg-surface-muted text-xs">save note</button>
        </div>
      </div>
    </div>
    {% elif read_only %}
    <p class="mt-3 text-xs text-fg-subtle">Read-only — you are viewing revision {{ rev }} of {{ rev_current }}; comments and edits go on
      <a class="text-success-strong hover:underline" href="/{{ kind }}/{{ slug | urlencode }}">the current revision</a>.</p>
    {% endif %}
  </div>
  <div>
    <h2 class="text-sm font-semibold text-fg-secondary mb-2">Topology</h2>
    <div id="bt3d-topology" class="relative rounded-lg border border-line bg-surface overflow-hidden" style="height: 520px;"></div>
    <p class="text-[11px] text-fg-faint mt-1">
      Blocks settle where their connects pull them · drag a node to pin it, double-click to release ·
      hover a node or link for detail · click a node to select it in the 3D view.
    </p>
  </div>
</div>

{% if print_files %}
{# Print files (routes/se_print.py): links only — the cheap report decided
   printability, the full print check runs when a link is clicked. #}
<div id="bt3d-print-files" class="mt-4 rounded-lg border border-line bg-surface p-3 text-sm">
  <h2 class="text-sm font-semibold text-fg-secondary mb-2">Print files</h2>
  <ul class="space-y-1">
    {% for pf in print_files %}
    <li>
      <span class="font-mono text-xs text-fg-secondary">{{ pf.block }}</span>
      <a class="text-info hover:underline ml-2" href="{{ pf.url }}" download>Download 3MF</a>
      <span class="text-xs text-fg-subtle ml-2">{{ pf.errors }} error{{ '' if pf.errors == 1 else 's' }}, {{ pf.warns }} warning{{ '' if pf.warns == 1 else 's' }} (before the mesh check)</span>
    </li>
    {% endfor %}
  </ul>
  <p class="text-[11px] text-fg-faint mt-2">The download runs the full print check; its findings are in the agent's <code>view='print'</code> report.</p>
</div>
{% endif %}

{# ── design chat (design-workbench build, slice 3) — the shared partial;
   selecting a block in the viewer calls window.designChatAddHandle(name)
   through the viewer's onSelectBlock hook below. ── #}
{% if chat %}{{ design_chat(chat, rev, rev_current) }}{% endif %}

{% endblock %}
{% block scripts %}
{# One three.js for the vendored viewer and the atom overlay
   (static/three-cad-viewer/README.md). Must precede every module script. #}
<script type="importmap">
{"imports": {"three": "/static/three-r184/three.module.min.js"}}
</script>
{# Start the scene and atom fetches before the module bundle
   load (~0.6 s on Reto's Safari reading, se-3d-viewer-6); blocktree-3d.js
   takes these responses when the URLs match (_takePrefetch). The no-op
   catch keeps a failed fetch from logging as unhandled before the module
   reads it. #}
<script>
  (() => {
    const start = (url) => {
      const ctl = new AbortController();
      const resp = fetch(url, { signal: ctl.signal });
      resp.catch(() => {});
      return { url, resp, ctl };
    };
    performance.mark("bt3d-prefetch-start");
    window.__bt3dPrefetch = {
      scene: start({{ scene_url | tojson }}),
      {% if has_atomic %}atomic: start({{ atomic3d_url | tojson }}),{% endif %}
    };
  })();
</script>
{% if show_validate %}
<script>
  // After first paint: the validator can take seconds, so its panel is
  // filled in from its own request, never from the page request.
  (() => {
    const el = document.getElementById("bt3d-validate");
    if (!el || el.dataset.identity !== undefined) return;
    fetch(el.dataset.url).then(async (r) => {
      if (!r.ok) throw new Error(String(r.status));
      el.dataset.identity = r.headers.get("X-Validation-Identity") || "";
      el.innerHTML = await r.text();
    }).catch(() => {
      const s = el.querySelector("summary");
      if (s) s.textContent = "validate: unavailable";
    });
  })();
</script>

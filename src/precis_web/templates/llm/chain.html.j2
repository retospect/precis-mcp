{% extends "base.html.j2" %}
{% block title %}LLM chains{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">LLM chains</h1>
<p class="text-sm text-fg-subtle mb-4">
  What each capability tier dispatches to <em>right now</em> — the rungs
  the router walks, in order (slot 1 is tried first, later slots are the
  failover ladder). Resolved through the same
  <code>resolve_chain</code>/<code>resolve_model</code> dispatch uses, so
  this can't drift from real routing. Overrides are edited on the
  <a href="/status?tab=services" class="text-success-strong hover:underline">Services</a>
  tab; the catalog of models on
  <a href="/status?tab=models" class="text-success-strong hover:underline">Models</a>.
  Per-operation routing lives at <a href="/llm/op" class="text-success-strong hover:underline">/llm/op</a>;
  content-keyword rules at <a href="/llm/rules" class="text-success-strong hover:underline">/llm/rules</a>.
</p>


{# The rung cards lazy-load: _active_routing_ctx/_llm_chain_ctx run
   the per-tier resolve walks + override reads off the shell render
   (gr518162) — same deferral shape as /status's panels. #}
<div hx-get="/llm/chain/panel" hx-trigger="load" hx-swap="innerHTML">
  <div class="rounded-lg border border-line bg-surface px-4 py-3 text-sm text-fg-faint flex items-center gap-2">
    <span class="inline-block w-3 h-3 rounded-full border-2 border-line-strong border-t-line-heavy animate-spin"></span>
    resolving live chains…
  </div>
</div>
{% endblock %}

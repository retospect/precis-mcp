{% extends "base.html.j2" %}
{% block title %}LLM keyword rules{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">Keyword rules</h1>
<p class="text-sm text-fg-subtle mb-4">
  Ordered <code>(pattern → target)</code> rules <code>route()</code> matches
  against each request's prompt text — first match wins, case-insensitive,
  whole-word for plain keywords. A target is a model id, a capability tier,
  or a full rung chain (the <code>llm.op.*</code> grammar). A target that is
  unavailable or over its limiter falls back to normal routing — a rule
  never bypasses a gate. Per-tier chains live at
  <a href="/llm/chain" class="text-success-strong hover:underline">/llm/chain</a>,
  per-operation routing at
  <a href="/llm/op" class="text-success-strong hover:underline">/llm/op</a>.
</p>

<div class="overflow-x-auto rounded-lg border border-line bg-surface mb-6">
  <table class="min-w-full text-xs">
    <thead class="bg-surface-subtle text-fg-subtle">
      <tr>
        <th class="text-left font-medium px-3 py-2">#</th>
        <th class="text-left font-medium px-3 py-2">pattern</th>
        <th class="text-left font-medium px-3 py-2">target</th>
        <th class="text-left font-medium px-3 py-2">scope</th>
        <th class="text-left font-medium px-3 py-2">state</th>
        <th class="text-left font-medium px-3 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line-subtle">
      {% for r in kw_rules %}
      <tr class="align-top {% if not r.enabled %}opacity-50{% endif %}">
        <td class="px-3 py-2 tabular-nums text-fg-faint">{{ loop.index }}</td>
        <td class="px-3 py-2">
          <div class="font-mono text-[11px]"{% if r.note %} title="{{ r.note }}"{% endif %}>{{ r.pattern }}</div>
          <div class="text-[10px] text-fg-faint">{% if r.is_regex %}regex{% else %}keyword{% endif %} · id {{ r.rule_id }}</div>
        </td>
        <td class="px-3 py-2 font-mono text-[11px]">{{ r.target }}</td>
        <td class="px-3 py-2 text-[11px] text-fg-subtle">
          {% if r.sources %}sources: {{ r.sources | join(', ') }}<br>{% endif %}
          {% if r.tiers %}tiers: {{ r.tiers | join(', ') }}{% endif %}
          {% if not r.sources and not r.tiers %}all{% endif %}
        </td>
        <td class="px-3 py-2 text-[11px]">
          {% if r.enabled %}<span class="text-success-strong">on</span>
          {% else %}<span class="text-warning-strong">off</span>{% endif %}
          {% if not r.compiled %}<div class="text-[10px] text-danger-strong">bad pattern</div>{% endif %}
        </td>
        <td class="px-3 py-2 whitespace-nowrap">
          {% if r.rule_id.isdigit() %}
          <form method="post" action="/llm/rules/toggle" class="inline">
            <input type="hidden" name="rule_id" value="{{ r.rule_id }}">
            <input type="hidden" name="enabled" value="{{ 'false' if r.enabled else 'true' }}">
            <button class="text-[11px] text-accent-strong hover:underline">{{ 'disable' if r.enabled else 'enable' }}</button>
          </form>
          <form method="post" action="/llm/rules/move" class="inline">
            <input type="hidden" name="rule_id" value="{{ r.rule_id }}">
            <input type="hidden" name="direction" value="up">
            <button title="Move up (match earlier)" class="text-[11px] text-fg-subtle hover:underline" {% if loop.first %}disabled{% endif %}>↑</button>
          </form>
          <form method="post" action="/llm/rules/move" class="inline">
            <input type="hidden" name="rule_id" value="{{ r.rule_id }}">
            <input type="hidden" name="direction" value="down">
            <button title="Move down (match later)" class="text-[11px] text-fg-subtle hover:underline" {% if loop.last %}disabled{% endif %}>↓</button>
          </form>
          {% else %}
          <span class="text-[10px] text-fg-faint">code default</span>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="px-3 py-4 text-fg-faint">No keyword rules.</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<details class="rounded-lg border border-line bg-surface p-4 mb-6">
  <summary class="text-sm font-medium cursor-pointer">Add a rule</summary>
  <form method="post" action="/llm/rules/add" class="mt-3 grid gap-2 sm:grid-cols-2 text-xs">
    <label class="flex flex-col gap-1">pattern
      <input name="pattern" required maxlength="200" placeholder="keyword or regex, e.g. proof"
             class="rounded border border-line bg-surface px-2 py-1 font-mono">
    </label>
    <label class="flex flex-col gap-1">target
      <div class="flex gap-1">
        <select name="target_kind" class="rounded border border-line bg-surface px-2 py-1">
          <option value="model">model</option>
          <option value="tier">tier</option>
          <option value="chain">chain JSON</option>
        </select>
        <input name="target_value" placeholder="claude-opus-4-8 · big · [{...}]"
               class="flex-1 rounded border border-line bg-surface px-2 py-1 font-mono">
      </div>
    </label>
    <label class="flex flex-col gap-1">scope: sources (comma list, blank = all)
      <input name="sources" placeholder="all sources (comma-separated)" class="rounded border border-line bg-surface px-2 py-1 font-mono">
    </label>
    <label class="flex flex-col gap-1">scope: tiers (comma list, blank = all)
      <input name="tiers" placeholder="all tiers (comma-separated)" class="rounded border border-line bg-surface px-2 py-1 font-mono">
    </label>
    <label class="flex flex-col gap-1 sm:col-span-2">note
      <input name="note" placeholder="why this rule exists" class="rounded border border-line bg-surface px-2 py-1">
    </label>
    <label class="flex items-center gap-2">
      <input type="checkbox" name="is_regex"> pattern is a regex (whole-word literal otherwise)
    </label>
    <div><button class="rounded bg-accent-subtle px-3 py-1 text-accent-strong">add</button></div>
  </form>
</details>

<details class="rounded-lg border border-line bg-surface p-4">
  <summary class="text-sm font-medium cursor-pointer">Preview — which rule fires?</summary>
  <div class="mt-3 grid gap-2 sm:grid-cols-3 text-xs">
    <label class="flex flex-col gap-1 sm:col-span-2">sample text
      <textarea id="kw-text" rows="3" placeholder="sample prompt text to test against the rules" class="rounded border border-line bg-surface px-2 py-1 font-mono"></textarea>
    </label>
    <div class="grid gap-2">
      <label class="flex flex-col gap-1">source
        <input id="kw-source" placeholder="request source (optional)" class="rounded border border-line bg-surface px-2 py-1 font-mono">
      </label>
      <label class="flex flex-col gap-1">tier
        <select id="kw-tier" class="rounded border border-line bg-surface px-2 py-1 font-mono">
          <option value="">(any)</option>
          {% for t in kw_tiers %}<option value="{{ t }}">{{ t }}</option>{% endfor %}
        </select>
      </label>
    </div>
  </div>
  <pre id="kw-preview" class="mt-2 text-[11px] font-mono text-fg-subtle whitespace-pre-wrap"></pre>
  <script>
  (function () {
    const out = document.getElementById('kw-preview');
    let timer = null;
    async function preview() {
      const q = new URLSearchParams({
        text: document.getElementById('kw-text').value,
        source: document.getElementById('kw-source').value,
        tier: document.getElementById('kw-tier').value,
      });
      const row = await (await fetch('/api/llm/keyword-route?' + q)).json();
      out.textContent = row.matched
        ? 'rule ' + row.rule_id + ' → ' + JSON.stringify(row.target)
          + (row.fallback ? '\nfallback: ' + row.fallback
             : '\nmodel ' + row.model + ' · tier ' + row.tier
               + ' · rungs ' + JSON.stringify(row.rungs))
        : 'no rule matches — normal routing';
    }
    function schedule() { clearTimeout(timer); timer = setTimeout(preview, 200); }
    for (const id of ['kw-text', 'kw-source', 'kw-tier'])
      document.getElementById(id).addEventListener('input', schedule);
  })();
  </script>
</details>
{% endblock %}

<!doctype html>
<html lang="en" class="h-full bg-slate-50">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}precis{% endblock %} · precis web</title>
  {# Prebuilt static Tailwind (scripts/ship regenerates it from the content
     scan). Replaces the in-browser Play CDN, which warns in production and is
     slower on first paint. See tailwind.config.js. #}
  <link rel="stylesheet" href="/static/tailwind.css" />
  {# Vendored KaTeX (the claim-page math-rendering work) —
     self-hosted like tailwind.css/pdf.js above, no runtime CDN fetch
     (tailnet-only deployment). Renders math ONLY inside an opt-in
     ``.tex-scope`` container (see the init script near the end of body) —
     grounding quotes and similar verbatim paper/draft text, never
     document-wide (single-``$`` auto-render over arbitrary page prose is
     false-positive-prone). #}
  <link rel="stylesheet" href="/static/katex/katex.min.css" />
  <script src="/static/katex/katex.min.js" defer></script>
  <script src="/static/katex/contrib/auto-render.min.js" defer></script>
  <script src="https://unpkg.com/htmx.org@2.0.3" defer></script>
  <script src="https://unpkg.com/alpinejs@3.x.x/dist/cdn.min.js" defer></script>
  <style>[x-cloak] { display: none !important; }</style>
  {# Abbreviation recall (linkify._highlight_abbrevs — draft reader +
     claim-page quote blocks): an INSTANT custom tooltip, no native <abbr
     title> show-delay. Definition rides in a nested .pa-pop, shown on
     hover/focus via CSS. Shared here (not per-page) so every surface that
     runs the highlighter — smartdraft, the claim page's quote blocks, and
     any future one — gets it for free. #}
  <style>
    .pa{position:relative;text-decoration:underline dotted;
        text-decoration-color:#94a3b8;cursor:help}
    .pa>.pa-pop{display:none;position:absolute;bottom:100%;left:0;z-index:50;
        margin-bottom:3px;width:max-content;max-width:18rem;white-space:normal;
        border-radius:4px;background:#1e293b;color:#fff;
        padding:2px 6px;font-size:11px;font-weight:400;line-height:1.3}
    .pa:hover>.pa-pop,.pa:focus>.pa-pop,.pa:focus-within>.pa-pop{display:block}
    .pa-pop>.pa-def,.pa-pop>.pa-attr,.pa-pop>.pa-link{display:block}
    .pa-pop>.pa-attr{color:#cbd5e1;font-size:10px}
    .pa-pop>.pa-link{color:#7dd3fc;margin-top:1px}
  </style>
</head>
<body class="h-full text-slate-800">
  {# ``?embed=1`` = chrome-less pane mode: the page is being shown inside
     another page's iframe (the /nanopub three-pane review surface), so
     the site header is hidden and same-origin navigation keeps the flag
     (script below) — the framed page stays frameless as you click
     through it. #}
  {% set embed = request.query_params.get('embed') == '1' %}
  <div class="min-h-full">
    {% if not embed %}
    <header class="bg-slate-900 text-slate-100">
      <div class="mx-auto max-w-6xl px-4">
        {# Nav, by attention priority (the rationalized target information
           architecture; see also precis_web.nav):
             • Daily — daily-driver kinds, always visible, left.
             • Browse ▾ — the corpus look-up long tail (Drive's five
               standalone kind-specific readers), behind a dropdown.
             • Attention (right, badged) — Needs you, Gripes, Alerts.
             • Manual — the user-facing how-to, top-level and unbadged.
             • Ops ▾ — System + the admin/dev surfaces, right dropdown.
             • 🔍 loupe — global search, submits to Drive.
             • Account — your own login (abbrev chip), far right. #}
        <nav class="flex flex-wrap items-center gap-0.5 py-1.5 text-xs">
          <span class="font-semibold tracking-tight text-emerald-400 mr-2">precis</span>
          {% set _tab_on = 'bg-slate-700 text-white' %}
          {% set _tab_off = 'text-slate-300 hover:bg-slate-800 hover:text-white' %}

          {# ── Daily: always-visible daily-driver kinds ──
             Drafts/Papers/Items retired into Drive (WS1a/WS1b/nav
             restructure) — their routes redirect, so no tab needed. #}
          {% set tabs = [('drive','Drive','/drive'), ('tags','Tags','/tags'), ('tasks','ToDo','/tasks')] %}
          {% for key, label, href in tabs %}
          <a href="{{ href }}"
             class="px-2 py-1 rounded text-xs font-medium transition {% if active_tab == key %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
            {{ label }}
          </a>
          {% endfor %}

          <span class="mx-1 h-4 w-px bg-slate-700"></span>

          {# ── Browse ▾: the corpus look-up long tail ──
             WS1b folded Papers-Needed / Oracle / Patents / CFPs / Refs
             per-kind lists into Drive kind/state facet presets (Oracle's
             "roll the dice" and Patents' OPS remote-search are MCP/CLI
             affordances, not web routes, so nothing web-facing was lost).
             Structures/CAD/Figures/Mermaid keep their own tab: each
             carries kind-specific columns (parts, atoms, energy, turns, …)
             Drive's generic row rendering doesn't reproduce; Clusters is
             likewise a bespoke visualization with no Drive equivalent. #}
          {% set browse = [('quests','Quests','/drive?submitted=1&k=quest&sort=recency'), ('schedules','Schedules','/drive?submitted=1&k=todo&tag=level:recurring&sort=recency'), ('clusters','Clusters','/clusters'), ('structure','Structures','/structure'), ('cad','CAD','/cad'), ('figure','Figures','/figure'), ('mermaid','Mermaid','/mermaid'), ('nanopub','Nanopubs','/nanopub')] %}
          {% set browse_keys = browse | map(attribute=0) | list %}
          <div x-data="{open:false}" @click.outside="open=false" @keydown.escape="open=false" class="relative">
            <button type="button" @click="open=!open"
                    class="px-2 py-1 rounded text-xs font-medium transition inline-flex items-center gap-1 {% if active_tab in browse_keys %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
              Browse <span class="text-[9px]">▾</span>
            </button>
            <div x-show="open" x-cloak x-transition.opacity
                 class="absolute left-0 mt-1 z-40 min-w-[9rem] rounded-md border border-slate-700 bg-slate-800 py-1 shadow-lg">
              {% for key, label, href in browse %}
              <a href="{{ href }}"
                 class="block px-3 py-1.5 text-xs font-medium transition {% if active_tab == key %}bg-slate-700 text-white{% else %}text-slate-300 hover:bg-slate-700 hover:text-white{% endif %}">
                {{ label }}
              </a>
              {% endfor %}
            </div>
          </div>

          {# ── Right: Attention (Needs you / Gripes / Alerts, badged) +
               Ops ▾ (System + admin surfaces) + global search. ── #}
          {% set ops = [('status','System','/status'), ('categorizers','Categorizers','/categorizers'), ('agentlogs','Agent Logs','/agentlogs'), ('console','Console','/console'), ('env','Env','/env'), ('secrets','Secrets','/secrets'), ('settings','Settings','/settings')] %}
          {% set ops_keys = ops | map(attribute=0) | list %}
          <div class="ml-auto flex items-center gap-0.5">
            {# Needs you: asks + needs-triage, red attention badge. The
               full triage queue (active_tab 'triage') lands under this
               tab, so it lights up there too. #}
            {% set needs_you_keys = ['needs-you', 'triage'] %}
            <a href="/needs-you"
               class="px-2 py-1 rounded text-xs font-medium transition inline-flex items-center {% if active_tab in needs_you_keys %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
              Needs you
              {% if nav_needs_you %}
              <span class="ml-1 inline-flex items-center justify-center rounded-full bg-rose-600 text-white text-[10px] font-semibold leading-none px-1.5 h-[1.1rem] min-w-[1.1rem]">{{ nav_needs_you }}</span>
              {% endif %}
            </a>
            <a href="/gripes"
               class="px-2 py-1 rounded text-xs font-medium transition inline-flex items-center {% if active_tab == 'gripes' %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
              Gripes
              {% if nav_gripes %}
              <span class="ml-1 inline-flex items-center justify-center rounded-full bg-violet-500 text-white text-[10px] font-semibold leading-none px-1.5 h-[1.1rem] min-w-[1.1rem]">{{ nav_gripes }}</span>
              {% endif %}
            </a>
            <a href="/alerts"
               class="px-2 py-1 rounded text-xs font-medium transition inline-flex items-center {% if active_tab == 'alerts' %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
              Alerts
              {% if nav_alerts %}
              <span class="ml-1 inline-flex items-center justify-center rounded-full bg-amber-500 text-slate-900 text-[10px] font-semibold leading-none px-1.5 h-[1.1rem] min-w-[1.1rem]">{{ nav_alerts }}</span>
              {% endif %}
            </a>
            <span class="mx-1 h-4 w-px bg-slate-700"></span>
            {# Manual — the user-facing how-to (routes/manual.py). Top-level
               and unbadged: it is the thing you go looking for when you do
               NOT know which tab you need, so it must not be inside a
               dropdown. #}
            <a href="/manual"
               class="px-2 py-1 rounded text-xs font-medium transition {% if active_tab == 'manual' %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
              Manual
            </a>
            {# Ops ▾ — System (merged Status+Factory+Budget, WS3) + the
               admin/dev surfaces. #}
            <div x-data="{open:false}" @click.outside="open=false" @keydown.escape="open=false" class="relative">
              <button type="button" @click="open=!open"
                      class="px-2 py-1 rounded text-xs font-medium transition inline-flex items-center gap-1 {% if active_tab in ops_keys %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}">
                Ops <span class="text-[9px]">▾</span>
              </button>
              <div x-show="open" x-cloak x-transition.opacity
                   class="absolute right-0 mt-1 z-40 min-w-[9rem] rounded-md border border-slate-700 bg-slate-800 py-1 shadow-lg">
                {% for key, label, href in ops %}
                <a href="{{ href }}"
                   class="block px-3 py-1.5 text-xs font-medium transition {% if active_tab == key %}bg-slate-700 text-white{% else %}text-slate-300 hover:bg-slate-700 hover:text-white{% endif %}">
                  {{ label }}
                </a>
                {% endfor %}
              </div>
            </div>
            {# 🔍 loupe — global cross-kind search. Submits to /drive (WS1b
               repoint — the unified seek+manage surface), which runs the
               same cross-kind chunk search over its default kind set; the
               user can narrow/widen via the Source/Author kind chips on
               the results page. #}
            <form method="get" action="/drive" class="ml-1 flex items-center gap-1">
              <input name="q" placeholder="🔍 search everything…"
                     class="bg-slate-800 border border-slate-700 text-slate-100 placeholder-slate-400 text-sm px-3 py-1 rounded w-44 focus:w-72 focus:outline-none focus:ring-1 focus:ring-emerald-500 transition-all" />
            </form>
            {# Account — your own login: password, profile, podcast link.
               Signed in, this is the abbrev chip (the same short handle
               that will tag your edits); with PRECIS_WEB_AUTH off there
               is no identity to abbreviate, so it degrades to a word.
               Roster management stays in `precis users` on the host. #}
            <a href="/account" title="{{ nav_user.login if nav_user else 'Account' }}"
               class="ml-1 rounded transition {% if nav_user %}inline-flex items-center justify-center h-6 w-6 text-[10px] font-semibold {% if active_tab == 'account' %}bg-emerald-500 text-slate-900{% else %}bg-slate-700 text-slate-200 hover:bg-slate-600 hover:text-white{% endif %}{% else %}px-2 py-1 text-xs font-medium {% if active_tab == 'account' %}{{ _tab_on }}{% else %}{{ _tab_off }}{% endif %}{% endif %}">
              {{ nav_user.abbrev | upper if nav_user else 'Account' }}
            </a>
          </div>
        </nav>
      </div>
    </header>
    {% endif %}
    {% if embed %}
    <script>
      // Embed mode = this page lives inside an iframe pane. Two jobs, one
      // capture-phase click listener:
      //
      //  1. WORKBENCH PANE ROUTING (window.name np-review / np-paper —
      //     the /nanopub workbench's panes): route by DESTINATION, not by
      //     which pane the click happened in. Paper-destined links (the
      //     shared "precis-paper" named target, /papers/ paths, /c/pc…
      //     paper-chunk handles) load the np-paper pane; claim links
      //     (/claim/…) load the np-review pane. The destination pane is
      //     navigated DIRECTLY through the parent document (same-origin,
      //     so reachable): named-target resolution from a nested browsing
      //     context is unreliable across browsers — Safari silently drops
      //     it, which reads as a dead click (this used to live on claim
      //     pages only, leaving the paper pane's own pa/pc links dead
      //     there). A link whose destination IS this pane navigates in
      //     place; the shown page's own self-link is swallowed (a
      //     fragment still scrolls). Modified clicks (cmd/ctrl/shift/
      //     middle) fall through to the browser untouched.
      //
      //  2. EMBED STICKINESS: stamp embed=1 onto same-origin link hrefs
      //     and form actions as they are used (capture phase, before the
      //     default navigation reads them). External links must leave the
      //     pane: publishers (doi.org redirect targets) send
      //     X-Frame-Options/frame-ancestors deny, so navigating the
      //     iframe there shows a blank pane.
      const NP_PANES = ["np-review", "np-paper"];
      const inWorkbench = NP_PANES.includes(window.name) && window.parent !== window;
      document.addEventListener("click", e => {
        const a = e.target.closest("a[href]");
        if (!a) return;
        if (a.host !== location.host) {
          if (!a.target) { a.target = "_blank"; a.rel = "noopener"; }
          return;
        }
        // A bare "#fragment" anchor is an in-page scroll, never a
        // navigation — leave it alone.
        if ((a.getAttribute("href") || "").startsWith("#")) return;
        // Only target-less links and the pane-owned targets (the shared
        // precis-paper window, the panes themselves) are ours to route —
        // an anchor that carries its own target (a popover's
        // target="_blank" chunk permalink, say) keeps it: hijacking it
        // into a pane would swallow a deliberate new-tab affordance.
        const routable = !a.target || a.target === "precis-paper" || NP_PANES.includes(a.target);
        if (inWorkbench && routable && !(e.metaKey || e.ctrlKey || e.shiftKey || e.altKey || e.button !== 0)) {
          try {
            const u = new URL(a.href);
            const toPaper = a.target === "precis-paper"
              || u.pathname.startsWith("/papers/")
              || u.pathname.startsWith("/c/pc");
            const dest = toPaper ? "np-paper"
              : (u.pathname.startsWith("/claim/") ? "np-review" : null);
            if (dest) {
              u.searchParams.set("embed", "1");
              // preventDefault via .call so this template carries no
              // empty-parens call (the error-page stale-substitution
              // tripwire pinned by test_base_template_installs_one_
              // delegated_popover_registry).
              if (dest === window.name) {
                e.preventDefault.call(e);
                if (u.pathname === location.pathname) {
                  if (u.hash) location.hash = u.hash;
                  return;
                }
                location.assign(u);
                return;
              }
              let frame = null;
              try { frame = window.parent.document.getElementById(dest); } catch {}
              if (frame) { e.preventDefault.call(e); frame.src = u; return; }
              a.href = u; a.target = dest;  // last resort: named target
              return;
            }
          } catch {}
        }
        if (a.target) return;
        try { const u = new URL(a.href); u.searchParams.set("embed", "1"); a.href = u; } catch {}
      }, true);
      document.addEventListener("submit", e => {
        try {
          const u = new URL(e.target.action || location.href);
          if (u.host !== location.host) return;
          u.searchParams.set("embed", "1");
          e.target.action = u;
        } catch {}
      }, true);
    </script>
    {% endif %}
    {# Most pages read best centred at a comfortable measure; the two-pane
       document reader (papers/pres detail) overrides ``main_class`` to go
       full-bleed so the PDF pane grows with the viewport (no max-width cap). #}
    <main class="{% block main_class %}mx-auto max-w-6xl px-4 py-6{% endblock %}">
      {% block content %}{% endblock %}
    </main>
  </div>
  {% block scripts %}{% endblock %}
  <script>
    // Delegated hover-preview popover coordination for every anchor
    // ``precis_web.linkify._anchor_html`` renders anywhere on the page
    // (gr171760). Each anchor used to attach its OWN window-scoped
    // ``scroll``/``keydown.escape``/``ref-popover-open`` listeners so at
    // most one popover was ever open — fine at dozens of refs, but O(N)
    // capture-phase handlers firing per scroll frame on a citation-heavy
    // draft (thousands of refs). This installs that coordination ONCE,
    // page-wide: it tracks only the single currently-open anchor's
    // wrapper element and reaches into its Alpine scope directly, so no
    // per-anchor listener or DOM event is needed to notify it.
    //
    // A bare block (not an IIFE) — every helper below takes an explicit
    // argument rather than closing purely over ``openEl``, which
    // incidentally keeps this script free of an empty argument list (a
    // couple of routes' error-page tests assert that shape is absent,
    // guarding against an unrelated stale-template-substitution bug).
    {
      let openEl = null;

      // Guards every reach into Alpine state: the wrapper may have been
      // evicted from the DOM since it opened (the drafts reader's virtual
      // scrolling unloads rows that scroll far away), in which case
      // there's nothing to close — just drop the stale reference.
      function refPopoverData(el) {
        if (!el || !window.Alpine || !document.contains(el)) return null;
        try {
          return window.Alpine.$data(el);
        } catch {
          return null;
        }
      }

      function refPopoverClose(el) {
        const d = refPopoverData(el);
        if (d) d.hovered = false;
        if (openEl === el) openEl = null;
      }

      // The wrapper carries its popover id as ``data-popid``; the teleported
      // card carries the SAME id as its own ``id`` (that's how ``hx-target``
      // finds it). Two different DOM nodes, one shared identity — so
      // ``release`` (called from EITHER the wrapper's own close handlers OR
      // the card's, since they share the same delayed-close expression) can
      // recognise "this is the currently-open one" by popover id even when
      // ``el`` is the card, not the wrapper ``openEl`` tracks.
      function popIdOf(el) {
        if (!el) return null;
        return (el.dataset && el.dataset.popid) || el.id || null;
      }

      // Escape closes whichever popover is open, page-wide — was a
      // ``@keydown.escape.window`` on every single anchor.
      window.addEventListener('keydown', (e) => {
        if (e.key === 'Escape') refPopoverClose(openEl);
      });
      // A scroll OUTSIDE the open popover's own (overflow-y-auto) card
      // closes it — a page/pane scroll detaches the fixed-position card
      // from its anchor, which should close it, but scrolling the card's
      // own content must not. Capture-phase: a scroll inside some OTHER
      // scrollable ancestor doesn't bubble to ``window``, only capture
      // reaches it. Was a ``@scroll.window.capture`` on every single
      // anchor; now one listener regardless of how many anchors exist.
      window.addEventListener(
        'scroll',
        (e) => {
          if (!openEl) return;
          const popId = openEl.dataset.popid;
          const card = popId ? document.getElementById(popId) : null;
          if (!card || !card.contains(e.target)) refPopoverClose(openEl);
        },
        true,
      );

      window.__refPopover = {
        // Called from an anchor's own hover-open handler: closes whichever
        // OTHER popover is currently open (≤1 open cluster-wide) and
        // becomes the tracked one. Was a ``$dispatch``'d + ``.window``-
        // listened ``ref-popover-open`` custom event on every anchor.
        open(el) {
          if (openEl && openEl !== el) refPopoverClose(openEl);
          openEl = el;
        },
        // Called from an anchor's own close handlers — the wrapper's
        // mouseleave-delay / click-outside, AND the teleported card's own
        // mouseleave-delay (gr171760 review: the card's ``$el`` is the card
        // itself, never ``openEl``, so this must compare popover IDENTITY
        // — the shared popover id — not raw element identity, or a close
        // via the card path would never clear the stale reference). A fast
        // re-open of a DIFFERENT chip before this fires must NOT clear the
        // newer one, which the popid comparison also guarantees (each
        // anchor mints its own id).
        release(el) {
          if (popIdOf(openEl) === popIdOf(el)) openEl = null;
        },
      };

      // A preview fetch that never lands must not leave the card sitting on
      // its "loading…" seed (linkify._POPOVER_PLACEHOLDER) forever: the
      // anchor's hx-trigger is 'mouseenter once', so there is no retry to
      // wait for. One delegated handler, page-wide — same shape as the
      // open/close coordination above, and for the same reason (a
      // citation-heavy draft renders thousands of these cards).
      function refPopoverFail(e) {
        const t = e.detail && e.detail.target;
        if (!t || !t.classList || !t.classList.contains('ref-popover')) return;
        const seed = t.querySelector('.ref-popover-status');
        if (!seed) return;   // real content already swapped in — leave it
        seed.className = 'ref-popover-status block px-1 py-1.5 text-xs text-rose-500';
        seed.textContent = 'preview unavailable — click through to open it';
      }
      document.addEventListener('htmx:responseError', refPopoverFail);
      document.addEventListener('htmx:sendError', refPopoverFail);
      document.addEventListener('htmx:timeout', refPopoverFail);
    }
  </script>
  <script>
    // KaTeX auto-render, scoped to opt-in ``.tex-scope`` containers
    // (the claim-page math-rendering work). Delimiters
    // cover both the ``$…$``/``$$…$$`` a paper's markdown chunk text uses
    // and the ``\(…\)``/``\[…\]`` a LaTeX-imported passage may still carry.
    // Re-run on ``htmx:afterSwap`` too, so content an htmx fragment loads
    // AFTER the initial render (a preview card, a swapped panel, …) still
    // gets its math typeset — the katex/auto-render scripts are ``defer``
    // in <head>, which always finishes before this fires.
    function renderTexScopes(root) {
      if (!window.renderMathInElement) return;
      (root || document).querySelectorAll('.tex-scope').forEach((el) => {
        window.renderMathInElement(el, {
          delimiters: [
            { left: '$$', right: '$$', display: true },
            { left: '\\[', right: '\\]', display: true },
            { left: '$', right: '$', display: false },
            { left: '\\(', right: '\\)', display: false },
          ],
          ignoredTags: ['script', 'style', 'textarea', 'pre', 'code'],
          throwOnError: false,
        });
      });
    }
    document.addEventListener('DOMContentLoaded', (_e) => renderTexScopes(document));
    document.addEventListener('htmx:afterSwap', (e) => {
      const target = e.detail && e.detail.target;
      if (!target) return;
      if (target.matches && target.matches('.tex-scope')) {
        renderTexScopes(target.parentElement || document);
      } else {
        renderTexScopes(target);
      }
    });
  </script>
</body>
</html>

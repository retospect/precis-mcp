{% extends "base.html.j2" %}
{% block title %}Learning{% endblock %}
{% block content %}
<style>
  .learning-days {display:grid;grid-template-rows:repeat(7,1fr);grid-auto-flow:column;gap:.35rem;min-width:34rem;}
  .learning-day {display:flex;align-items:center;justify-content:center;min-height:2rem;border:1px solid rgb(var(--border-line));border-radius:.25rem;font-size:.65rem;}
  .learning-day:focus-visible {outline:2px solid currentColor;outline-offset:2px;}
</style>
<a href="/account" class="text-xs text-fg-faint hover:text-fg-muted">&larr; Account</a>
<div class="mt-2 mb-4">
  <h1 class="text-lg font-semibold">Learning</h1>
  <p class="text-sm text-fg-subtle">Your private manual study check-ins. They record engagement, not mastery.</p>
</div>
{% if error %}<p role="alert" class="mb-4 text-sm text-danger-strong">{{ error }}</p>{% endif %}
{% if notice %}<p role="status" class="mb-4 text-sm text-fg-secondary">{{ notice }}</p>{% endif %}

<section aria-labelledby="activity-heading" class="mb-6 max-w-3xl rounded-lg border border-line bg-surface p-4">
  <h2 id="activity-heading" class="text-sm font-semibold">Study activity · 84 days</h2>
  <p class="mt-1 text-xs text-fg-subtle">{{ activity.days[0].date }} to {{ activity.today }}, in {{ activity.timezone }}. {% if activity.last_studied %}Last recorded study: {{ activity.last_studied }}.{% else %}No study recorded yet.{% endif %}</p>
  <p id="activity-help" class="mt-2 text-xs text-fg-subtle">S = studied (self-report), R = rest (self-report), – = no study recorded. Select a recorded date to read its check-in.</p>
  <div class="mt-3 overflow-x-auto">
    <div class="learning-days" role="list" aria-label="Study activity by date" aria-describedby="activity-help">
      {% for day in activity.days %}
      {% set label = day.date ~ ': ' ~ ('no study recorded' if day.status == 'unrecorded' else day.status ~ ' (self-report)') ~ (', ' ~ day.minutes ~ ' minutes' if day.minutes is not none else '') %}
      <div role="listitem">
        {% if day.event_id is not none %}
        <a href="/learning?event={{ day.event_id }}#day-detail" title="{{ label }}" aria-label="{{ label }}" class="learning-day {% if day.status == 'studied' %}bg-success-solid-soft text-on-bright{% else %}bg-inset text-fg-secondary{% endif %}">{{ 'S' if day.status == 'studied' else 'R' }}</a>
        {% else %}
        <span title="{{ label }}" aria-label="{{ label }}" class="learning-day bg-canvas text-fg-faint">–</span>
        {% endif %}
      </div>
      {% endfor %}
    </div>
  </div>
</section>

{% if selected %}
<section id="day-detail" aria-labelledby="day-heading" class="mb-6 max-w-3xl rounded-lg border border-line bg-surface p-4">
  <h2 id="day-heading" class="text-sm font-semibold">{{ selected.study_date }} · {{ selected.status }}</h2>
  <p class="mt-1 text-xs text-fg-subtle">Source: self-report{% if selected.minutes is not none %} · {{ selected.minutes }} minutes{% endif %}</p>
  {% if selected.note %}<p class="mt-2 whitespace-pre-wrap text-sm">{{ selected.note }}</p>{% endif %}
  <p class="mt-2 text-xs text-fg-faint">Recorded {{ selected.created_at }} UTC. A new check-in for this date preserves this entry in your history.</p>
</section>
{% endif %}

<section aria-labelledby="checkin-heading" class="mb-6 max-w-3xl">
  <h2 id="checkin-heading" class="text-sm font-semibold">Check in · today is {{ activity.today }}</h2>
  <p class="mt-1 mb-3 text-xs text-fg-subtle">Any study session counts, however short. You can choose an earlier date to record or correct a day.</p>
  <div class="grid gap-4 sm:grid-cols-2">
    <form method="post" action="/learning/checkin" class="space-y-3 rounded-lg border border-line bg-surface p-4">
      <h3 class="text-sm font-medium">Studied</h3>
      <input type="hidden" name="status" value="studied" />
      <input type="hidden" name="idempotency_key" value="{{ studied_key }}" />
      <div><label for="study-date" class="block text-xs text-fg-muted">Study date</label><input id="study-date" name="date" type="date" value="{{ activity.today }}" max="{{ activity.today }}" class="mt-1 rounded border border-line bg-canvas px-2 py-1 text-sm" /></div>
      <div><label for="study-minutes" class="block text-xs text-fg-muted">Minutes (optional)</label><input id="study-minutes" name="minutes" type="number" min="0" max="1440" step="1" class="mt-1 w-24 rounded border border-line bg-canvas px-2 py-1 text-sm" /></div>
      <div><label for="study-note" class="block text-xs text-fg-muted">Note (optional, up to 500 characters)</label><textarea id="study-note" name="note" maxlength="500" rows="3" placeholder="Topics, progress, or questions" aria-describedby="study-note-help" class="mt-1 w-full rounded border border-line bg-canvas px-2 py-1 text-sm"></textarea><p id="study-note-help" class="mt-1 text-xs text-fg-subtle">Add what you studied or want to revisit.</p></div>
      <button type="submit" class="rounded bg-info-solid px-3 py-1.5 text-xs text-on-solid">Record studied</button>
    </form>
    <form method="post" action="/learning/checkin" class="space-y-3 rounded-lg border border-line bg-surface p-4">
      <h3 class="text-sm font-medium">Rest</h3>
      <input type="hidden" name="status" value="rest" />
      <input type="hidden" name="idempotency_key" value="{{ rest_key }}" />
      <div><label for="rest-date" class="block text-xs text-fg-muted">Rest date</label><input id="rest-date" name="date" type="date" value="{{ activity.today }}" max="{{ activity.today }}" class="mt-1 rounded border border-line bg-canvas px-2 py-1 text-sm" /></div>
      <div><label for="rest-note" class="block text-xs text-fg-muted">Note (optional, up to 500 characters)</label><textarea id="rest-note" name="note" maxlength="500" rows="3" placeholder="Context for this rest day" aria-describedby="rest-note-help" class="mt-1 w-full rounded border border-line bg-canvas px-2 py-1 text-sm"></textarea><p id="rest-note-help" class="mt-1 text-xs text-fg-subtle">Add any context you want to keep for this rest day.</p></div>
      <p class="text-xs text-fg-subtle">Rest records your choice for this date, without study minutes.</p>
      <button type="submit" class="rounded border border-line px-3 py-1.5 text-xs">Record rest</button>
    </form>
  </div>
</section>

<section id="settings" aria-labelledby="settings-heading" class="mb-6 max-w-3xl rounded-lg border border-line bg-surface p-4">
  <h2 id="settings-heading" class="text-sm font-semibold">Learning preferences</h2>
  <form method="post" action="/learning/settings" class="mt-3 space-y-3">
    <div><label for="learning-timezone" class="block text-xs text-fg-muted">Timezone</label><input id="learning-timezone" name="timezone" value="{{ settings.timezone }}" required placeholder="Europe/Dublin" class="mt-1 rounded border border-line bg-canvas px-2 py-1 text-sm" /><p class="mt-1 text-xs text-fg-subtle">Use an IANA timezone such as Europe/Dublin or UTC.</p></div>
    <div><label for="learning-minutes" class="block text-xs text-fg-muted">Typical session minutes (optional)</label><input id="learning-minutes" name="typical_session_minutes" type="number" min="1" max="1440" step="1" value="{{ settings.typical_session_minutes if settings.typical_session_minutes is not none else '' }}" aria-describedby="typical-help" class="mt-1 w-24 rounded border border-line bg-canvas px-2 py-1 text-sm" /><p id="typical-help" class="mt-1 text-xs text-fg-subtle">30 minutes can be a starting suggestion. This is editable guidance, never a quota or daily completion threshold. Leave empty to remove it.</p></div>
    <button type="submit" class="rounded bg-info-solid px-3 py-1.5 text-xs text-on-solid">Save learning preferences</button>
  </form>
</section>
{% endblock %}

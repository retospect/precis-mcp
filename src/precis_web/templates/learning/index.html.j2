{% extends "base.html.j2" %}
{% block title %}Learning{% endblock %}
{% block content %}
<style>
  .learning-overview {display:grid;align-items:start;gap:1rem;max-width:64rem;}
  @media (min-width: 52rem) {
    .learning-overview {grid-template-columns:minmax(0,1fr) auto;}
  }
  .learning-activity {width:min(100%, 14rem);}
  .learning-days {display:grid;grid-template-columns:repeat(12, minmax(0, 1fr));gap:2px;}
  .learning-day {display:grid;place-items:center;aspect-ratio:1;border:1px solid rgb(var(--border-line));border-radius:2px;font-size:.6rem;}
  .learning-day:focus-visible {outline:2px solid currentColor;outline-offset:2px;}
  {# Masked cloze gaps (gr664414): the answer stays in the DOM for assistive
     tech and hover reveal, visually replaced by a blank until hover/focus. #}
  .cloze-mask {display:inline-flex;align-items:baseline;gap:.15rem;border-radius:.25rem;}
  .cloze-mask:focus-visible {outline:2px solid currentColor;outline-offset:2px;}
  .cloze-mask .cloze-blank {padding:0 .4rem;border-radius:.25rem;background:color-mix(in srgb, currentColor 25%, transparent);}
  .cloze-mask .cloze-answer {display:none;}
  .cloze-mask:hover .cloze-answer, .cloze-mask:focus .cloze-answer {display:inline;}
  .cloze-mask:hover .cloze-blank, .cloze-mask:focus .cloze-blank {display:none;}
  .cloze-mask .cloze-index {font-size:.6em;opacity:.7;margin-left:.1rem;}
</style>
<a href="/account" class="text-xs text-fg-faint hover:text-fg-muted">&larr; Account</a>
<div class="mt-2 mb-4">
  <h1 class="text-lg font-semibold">Learning</h1>
  <p class="text-sm text-fg-subtle">Your study cards and private record of study activity.</p>
</div>
{% if error %}<p role="alert" class="mb-4 text-sm text-danger-strong">{{ error }}</p>{% endif %}
{% if notice %}<p role="status" class="mb-4 text-sm text-fg-secondary">{{ notice }}</p>{% endif %}

{% include "anki/_known_undo.html.j2" %}

<div class="learning-overview mb-6">
<section aria-labelledby="context-heading" class="rounded-lg border border-line bg-surface p-4">
  <h2 id="context-heading" class="text-sm font-semibold">Current context</h2>
  {% if groups %}
  <p class="mt-1 text-xs text-fg-subtle">The cards you are learning right now, grouped by concept — cards with no live concept sit in a "No live concept" group of their own. Submit an answer to record a study attempt, or hover or focus a gap for a quick reveal. <strong>boost</strong> queues a card to come up today at the next Anki sync; <strong>drop</strong> retires it; <strong>I know this</strong> marks the concept as mastered and permanently removes your cards for it from study and from Anki at the next sync. Use <strong>Undo</strong> to restore them.</p>
  <ul class="mt-3 divide-y divide-line-subtle">
    {% for g in groups %}
    <li class="py-3">
      <div class="flex items-start gap-2">
        <span class="flex-1 text-sm font-medium text-fg-primary">{{ g.name }}
          <span class="text-xs font-normal text-fg-faint">&mdash; {{ g.state }}{% if g.mastery %} &middot; mastery {{ '%.2f' | format(g.mastery) }}{% endif %}</span>
        {% if g.memory %}<a href="{{ g.memory.href }}" class="ml-2 text-xs font-normal text-info-emphasis hover:underline">{{ g.memory.label }}</a>{% endif %}
        </span>
        {# "I know this" marks a concept mastered — meaningless on the
           ungrouped (no live concept) shelf, so it is withheld (gr742735). #}
        {% if not g.ungrouped %}
        <form method="post" action="/anki/known" hx-post="/anki/known" hx-swap="none">
          <input type="hidden" name="concept" value="{{ g.concept_id }}" />
          <input type="hidden" name="return_to" value="learning" />
          <button type="submit"
                  class="shrink-0 rounded border border-line px-2 py-0.5 text-xs text-fg-muted hover:text-danger hover:border-danger transition">I know this</button>
        </form>
        {% endif %}
      </div>
      <ul class="ml-4 mt-1 space-y-1">
        {% for card in g.cards %}
        <li id="study-card-{{ card.id }}" class="py-1 text-sm text-fg-secondary">
          <div class="flex items-center gap-2">
            <span class="flex-1">{% if answered == card.id|string %}{{ card.text | render_cloze }}{% else %}{{ card.text | render_cloze_masked }}{% endif %}</span>
            {% if card.boosted %}
            {% include "anki/_boosted.html.j2" %}
            {% else %}
            <button type="button"
                    hx-post="/anki/boost" hx-vals='{"card": "{{ card.id }}"}'
                    hx-target="this" hx-swap="outerHTML"
                    title="Bring this card's due date forward to today at the next Anki sync."
                    class="shrink-0 text-xs text-fg-faint hover:text-info-emphasis transition">boost</button>
            {% endif %}
            <button type="button"
                    hx-post="/anki/drop" hx-vals='{"card": "{{ card.id }}"}'
                    hx-target="closest li" hx-swap="delete"
                    class="shrink-0 text-xs text-fg-faint hover:text-danger transition">drop</button>
          </div>
          {% if answered == card.id|string %}
          <p role="status" class="mt-1 text-xs text-fg-subtle">Card answer revealed.</p>
          {% endif %}
          {% if card.text | has_cloze %}
          <form method="post" action="/learning/answer/{{ card.id }}" class="mt-1 flex flex-wrap gap-2">
            <input type="hidden" name="attempt" value="{{ attempt }}" />
            <input name="response" required maxlength="2000" autocomplete="off" aria-label="Your answer for this card" placeholder="Your answer" class="rounded border border-line bg-canvas px-2 py-1 text-xs" />
            <button type="submit" class="rounded border border-line px-2 py-1 text-xs">Check answer</button>
          </form>
          {% endif %}
        </li>
        {% endfor %}
      </ul>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="mt-1 text-xs text-fg-subtle">No active study cards.</p>
  {% endif %}
</section>

<aside aria-labelledby="activity-heading" class="learning-activity rounded-lg border border-line bg-surface p-3">
  <h2 id="activity-heading" class="text-sm font-semibold">Study activity</h2>
  <p class="mt-1 text-xs text-fg-subtle">{{ activity.days[0].date }} to {{ activity.today }} · {{ activity.timezone }}</p>
  <div class="learning-days mt-2" role="list" aria-label="Study activity by date">
    {% for day in activity.days %}
    {% set total = day.study_answers + day.anki_reviews %}
    {% set label = day.date ~ ': ' ~ day.study_answers ~ (' study answer, ' if day.study_answers == 1 else ' study answers, ') ~ day.anki_reviews ~ (' Anki review' if day.anki_reviews == 1 else ' Anki reviews') %}
    {% set label = label ~ (', ' ~ day.status ~ ' (self-report)' if day.event_id is not none else '') ~ (', ' ~ day.minutes ~ ' minutes' if day.minutes is not none else '') %}
    {% set colour = ('bg-success-solid-soft text-on-bright' if total >= 5 or day.status == 'studied' else 'bg-inset text-success') if total or day.status == 'studied' else ('bg-inset text-fg-secondary' if day.event_id is not none else 'bg-canvas text-fg-faint') %}
    {% set marker = ('S' if day.status == 'studied' else 'R') if day.event_id is not none else ('·' if total else '') %}
    <div role="listitem">
      {% if day.event_id is not none %}
      <a href="/learning?event={{ day.event_id }}#day-detail" title="{{ label }}" aria-label="{{ label }}" class="learning-day {{ colour }}">{{ marker }}</a>
      {% else %}
      <span title="{{ label }}" class="learning-day {{ colour }}"><span class="sr-only">{{ label }}</span><span aria-hidden="true">{{ marker }}</span></span>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  <p class="mt-2 text-xs text-fg-subtle">{{ 'Last recorded study: ' ~ activity.last_studied if activity.last_studied else 'No study recorded yet.' }}</p>
  <p class="mt-1 text-xs text-fg-subtle">Dots mark answers or Anki reviews. S/R mark optional studied/rest check-ins.</p>
</aside>
</div>

{% if walk %}
<section aria-labelledby="walk-heading" class="mb-6 max-w-3xl rounded-lg border border-line bg-surface p-4">
  <h2 id="walk-heading" class="text-sm font-semibold">Your recent walk</h2>
  <p class="mt-1 text-xs text-fg-subtle">The /eye pages you focused most recently, newest first. Only you can see this trail; it keeps handles and times — never page content.</p>
  <ol class="mt-3 space-y-1 text-sm">
    {% for row in walk %}
    {% set step = row.step %}
    <li class="flex flex-wrap items-baseline gap-x-2">
      <span class="text-xs text-fg-faint" title="{{ step.visited_at }} UTC">{{ step.visited_at | ago }}</span>
      <a href="{{ row.href }}" class="eye-handle text-info underline">{{ step.handle }}</a>
      <span class="text-xs text-fg-faint">[{{ step.kind }}]</span>
      {% if step.previous_handle %}<span class="text-xs text-fg-faint" title="The step before this one">from {{ step.previous_handle }}</span>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <form method="post" action="/learning/walk/clear" class="mt-3">
    <button type="submit" class="rounded border border-line px-2 py-0.5 text-xs text-fg-muted hover:text-danger hover:border-danger transition">Clear walk</button>
  </form>
</section>
{% endif %}

{% if selected %}
<section id="day-detail" aria-labelledby="day-heading" class="mb-6 max-w-3xl rounded-lg border border-line bg-surface p-4">
  <h2 id="day-heading" class="text-sm font-semibold">{{ selected.study_date }} · {{ selected.status }}</h2>
  <p class="mt-1 text-xs text-fg-subtle">Source: self-report{% if selected.minutes is not none %} · {{ selected.minutes }} minutes{% endif %}</p>
  {% if selected.note %}<p class="mt-2 whitespace-pre-wrap text-sm">{{ selected.note }}</p>{% endif %}
  <p class="mt-2 text-xs text-fg-faint">Recorded {{ selected.created_at }} UTC. A new check-in for this date preserves this entry in your history.</p>
</section>
{% endif %}

<details class="mb-6 max-w-3xl">
  <summary class="cursor-pointer text-sm font-semibold">Optional check-in · today is {{ activity.today }}</summary>
  <p class="mt-1 mb-3 text-xs text-fg-subtle">Any study session counts, however short. You can choose an earlier date to record or correct a day.</p>
  <div class="grid gap-4 sm:grid-cols-2">
    <form method="post" action="/learning/checkin" class="space-y-3 rounded-lg border border-line bg-surface p-4">
      <h3 class="text-sm font-medium">Studied</h3>
      <input type="hidden" name="status" value="studied" />
      <input type="hidden" name="idempotency_key" value="{{ studied_key }}" />
      <div><label for="study-date" class="block text-xs text-fg-muted">Study date</label><input id="study-date" name="date" type="date" value="{{ activity.today }}" max="{{ activity.today }}" class="mt-1 rounded border border-line bg-canvas px-2 py-1 text-sm" /></div>
      <div><label for="study-minutes" class="block text-xs text-fg-muted">Minutes (optional)</label><input id="study-minutes" name="minutes" type="number" min="0" max="1440" step="1" class="mt-1 w-24 rounded border border-line bg-canvas px-2 py-1 text-sm" /></div>
      <div><label for="study-note" class="block text-xs text-fg-muted">Note (optional, up to 500 characters)</label><textarea id="study-note" name="note" maxlength="500" rows="3" placeholder="Topics, progress, or questions" aria-describedby="study-note-help" class="mt-1 w-full rounded border border-line bg-canvas px-2 py-1 text-sm"></textarea><p id="study-note-help" class="mt-1 text-xs text-fg-subtle">Add what you studied or want to revisit.</p></div>
      <button type="submit" class="rounded bg-info-solid px-3 py-1.5 text-xs text-on-solid">Record studied</button>
    </form>
    <form method="post" action="/learning/checkin" class="space-y-3 rounded-lg border border-line bg-surface p-4">
      <h3 class="text-sm font-medium">Rest</h3>
      <input type="hidden" name="status" value="rest" />
      <input type="hidden" name="idempotency_key" value="{{ rest_key }}" />
      <div><label for="rest-date" class="block text-xs text-fg-muted">Rest date</label><input id="rest-date" name="date" type="date" value="{{ activity.today }}" max="{{ activity.today }}" class="mt-1 rounded border border-line bg-canvas px-2 py-1 text-sm" /></div>
      <div><label for="rest-note" class="block text-xs text-fg-muted">Note (optional, up to 500 characters)</label><textarea id="rest-note" name="note" maxlength="500" rows="3" placeholder="Context for this rest day" aria-describedby="rest-note-help" class="mt-1 w-full rounded border border-line bg-canvas px-2 py-1 text-sm"></textarea><p id="rest-note-help" class="mt-1 text-xs text-fg-subtle">Add any context you want to keep for this rest day.</p></div>
      <p class="text-xs text-fg-subtle">Rest records your choice for this date, without study minutes.</p>
      <button type="submit" class="rounded border border-line px-3 py-1.5 text-xs">Record rest</button>
    </form>
  </div>
</details>

<section id="settings" aria-labelledby="settings-heading" class="mb-6 max-w-3xl rounded-lg border border-line bg-surface p-4">
  <h2 id="settings-heading" class="text-sm font-semibold">Learning preferences</h2>
  <form method="post" action="/learning/settings" class="mt-3 space-y-3">
    <div><label for="learning-timezone" class="block text-xs text-fg-muted">Timezone</label><select id="learning-timezone" name="timezone" required class="mt-1 max-w-full rounded border border-line bg-canvas px-2 py-1 text-sm">{% for zone in timezones %}<option value="{{ zone }}"{% if zone == settings.timezone %} selected{% endif %}>{{ zone }}</option>{% endfor %}</select><p class="mt-1 text-xs text-fg-subtle">Choose the IANA timezone that sets your local day boundary, such as Europe/Dublin or UTC.</p></div>
    <div><label for="learning-minutes" class="block text-xs text-fg-muted">Typical session minutes (optional)</label><input id="learning-minutes" name="typical_session_minutes" type="number" min="1" max="1440" step="1" value="{{ settings.typical_session_minutes if settings.typical_session_minutes is not none else '' }}" aria-describedby="typical-help" class="mt-1 w-24 rounded border border-line bg-canvas px-2 py-1 text-sm" /><p id="typical-help" class="mt-1 text-xs text-fg-subtle">30 minutes can be a starting suggestion. This is editable guidance, never a quota or daily completion threshold. Leave empty to remove it.</p></div>
    <button type="submit" class="rounded bg-info-solid px-3 py-1.5 text-xs text-on-solid">Save learning preferences</button>
  </form>
</section>
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Work{% endblock %}
{% block content %}
{# /work — the read-only quest → root → slices hierarchy, the same
   ``precis.todo.work_view.work_model`` the MCP ``view='work'`` formats as
   text. Every row carries ``data-handle`` so the step-5b list/click/chat
   surface can select rows later; every handle links to /eye/<handle>. #}
{% set sc = {'done':'bg-success-muted text-success-strong','doing':'bg-warning-muted text-warning-strong','blocked':'bg-danger-muted text-danger-strong','paused':'bg-surface-emphasis text-fg-muted',"won't-do":'bg-surface-emphasis text-fg-subtle'} %}
<h1 class="text-lg font-semibold mb-1">Work</h1>
<p class="text-sm text-fg-subtle mb-3">
  What is in flight: one line per live quest — expand it for its served roots,
  slices and live jobs. {{ model.quests | length }} quest{{ '' if model.quests | length == 1 else 's' }}:
  {{ model.n_running }} running · {{ model.n_queued }} queued · {{ model.n_idle }} idle ·
  {{ model.n_agents }} live agent{{ '' if model.n_agents == 1 else 's' }}.
  Read-only; same data as <code>search(kind='todo', view='work')</code>.
</p>

{# ── sub-tab nav (mirrors /status) ─────────────────────────────── #}
<div class="mb-5 flex gap-1 text-sm border-b border-line">
  {% for key, label in [('health', 'Health'), ('services', 'Services'), ('models', 'Models'), ('budget', 'Budget'), ('now', 'Now'), ('setup', 'Setup')] %}
  <a href="/status?tab={{ key }}"
     class="px-3 py-1.5 -mb-px border-b-2 font-medium transition border-transparent text-fg-subtle hover:text-fg-secondary hover:border-line-strong">
    {{ label }}
  </a>
  {% endfor %}
  <a href="/work"
     class="px-3 py-1.5 -mb-px border-b-2 font-medium transition border-success-solid text-success-strong">
    Work
  </a>
</div>

{% macro cols_header() %}
<div class="flex items-center gap-3 px-3 py-1 text-xs uppercase tracking-wide text-fg-faint border-b border-line">
  <div class="flex-1 min-w-0">Item</div>
  <div class="w-40 shrink-0">Status</div>
  <div class="w-14 shrink-0 text-right">Agents</div>
  <div class="w-20 shrink-0">Stage</div>
  <div class="w-20 shrink-0 text-right">Age</div>
</div>
{% endmacro %}

{# One open gripe as a row (td541980): the columns of a todo row, with the
   derived loop stage in the status and stage cells and no agents. ``pad``
   is the item cell's left padding in rem. #}
{% macro gripe_row(g, pad, root_id=none) %}
<li class="flex items-baseline gap-3 px-3 py-1.5 text-sm"
    data-handle="{{ g.handle }}" data-kind="gripe" data-status="{{ g.stage }}"{% if root_id is not none %} data-root="{{ root_id }}"{% endif %}>
  <div class="flex-1 min-w-0 truncate" style="padding-left: {{ pad }}rem">
    <a href="/eye/{{ g.handle }}" class="font-mono text-xs text-fg-subtle hover:underline">{{ g.handle }}</a>
    <span title="{{ g.title }}">{{ g.title.split('\n', 1)[0] | truncate(120) }}</span>
    {% if g.lane %}<span class="text-xs text-fg-faint">[{{ g.lane }}]</span>{% endif %}
  </div>
  <div class="w-40 shrink-0 text-xs text-fg-secondary truncate">{{ g.stage }}</div>
  <div class="w-14 shrink-0 text-right text-xs"><span class="text-fg-ghost">–</span></div>
  <div class="w-20 shrink-0"><span class="text-xs px-1.5 py-0.5 rounded bg-info-muted text-info-strong">{{ g.stage }}</span></div>
  <div class="w-20 shrink-0 text-right text-xs text-fg-faint" title="{{ g.created_at | abs_ts }}">{{ g.created_at | ago }}</div>
</li>
{% endmacro %}

{# Quest run-state chips (td573295): derived, not the quest STATUS. #}
{% set rs = {'running':'bg-success-muted text-success-strong','queued':'bg-info-muted text-info-strong','idle':'bg-surface-emphasis text-fg-subtle'} %}
{% for state, label in [('running', 'Running'), ('queued', 'Queued'), ('idle', 'Idle')] %}
{% set group = model.quests | selectattr('run_state', 'equalto', state) | list %}
{% if group %}
<h2 class="text-sm font-semibold mb-2 mt-6">{{ label }} ({{ group | length }})</h2>
{% for q in group %}
<section class="mb-4 rounded-lg border border-line bg-surface" data-handle="{{ q.handle }}" data-kind="quest" data-run-state="{{ q.run_state }}">
  <details>
    <summary class="flex items-baseline gap-2 px-3 py-2 cursor-pointer">
      <span class="text-fg-faint">◆</span>
      <a href="/eye/{{ q.handle }}" class="font-mono text-xs font-semibold hover:underline">{{ q.handle }}</a>
      <span class="font-semibold text-sm truncate">{{ q.title }}</span>
      <span class="text-xs px-1.5 py-0.5 rounded {{ rs.get(q.run_state, 'bg-info-muted text-info-strong') }}">{{ q.run_state }}</span>
      <span class="text-xs px-1.5 py-0.5 rounded {{ sc.get(q.status, 'bg-info-muted text-info-strong') }}">{{ q.status }}</span>
      {% if q.prio is not none %}<span class="text-xs text-fg-faint">prio {{ q.prio }}</span>{% endif %}
      <span class="text-xs text-fg-faint">agents {{ q.agents }}</span>
      <span class="text-xs text-fg-faint">jobs {{ q.jobs | length }}{% if q.running_jobs %} ({{ q.running_jobs }} running){% endif %}</span>
      {% if q.next_doable %}<a href="/eye/{{ q.next_doable }}" class="font-mono text-xs text-fg-subtle hover:underline">next {{ q.next_doable }}</a>{% endif %}
      <span class="ml-auto text-xs text-fg-faint" title="{{ q.newest | abs_ts }}">{{ q.newest | ago }}</span>
    </summary>
    {{ cols_header() }}
    <ul class="divide-y divide-line">
      {% for root in q.roots %}
      {% for r in root.rows %}
      <li class="flex items-baseline gap-3 px-3 py-1.5 text-sm"
          data-handle="{{ r.handle }}" data-kind="{{ r.kind }}" data-depth="{{ r.depth }}"
          data-status="{{ r.status }}" data-root="{{ root.root_id }}"{% if r.node %} data-node="{{ r.node }}"{% endif %}>
        <div class="flex-1 min-w-0 truncate" style="padding-left: {{ (r.depth - 1) * 1.25 }}rem">
          <a href="/eye/{{ r.handle }}" class="font-mono text-xs text-fg-subtle hover:underline">{{ r.handle }}</a>
          <span title="{{ r.title }}">{{ r.title }}</span>
          {% if r.prio is not none %}<span class="text-xs text-fg-faint">prio {{ r.prio }}</span>{% endif %}
          {% if r.jobs %}<span class="text-xs text-fg-faint">jobs {{ r.jobs }}{% if r.jobs_live %} ({{ r.jobs_live }} live){% endif %}</span>{% endif %}
          {# plan node line (td542097): gate predicate + last reason, loop count, generator source #}
          {% if r.node_text %}<div class="text-xs text-fg-faint truncate" title="{{ r.node_text }}">{{ r.node_text }}</div>{% endif %}
          {% if r.after or r.hold or r.preview %}<div class="text-xs text-fg-faint truncate">
            {% for handle in r.after %}<a href="/eye/{{ handle }}" class="hover:underline">after {{ handle }}</a>{% if not loop.last %}, {% endif %}{% endfor %}
            {% if r.hold %}{{ r.hold }}{% endif %}
            {% if r.preview %}preview: {{ r.preview }}{% endif %}
          </div>{% endif %}
        </div>
        <div class="w-40 shrink-0 text-xs text-fg-secondary truncate" title="{{ r.icon }}">{{ r.icon }}</div>
        <div class="w-14 shrink-0 text-right text-xs">{% if r.agents %}<span class="text-success-strong font-semibold">{{ r.agents }}</span>{% else %}<span class="text-fg-ghost">0</span>{% endif %}</div>
        <div class="w-20 shrink-0"><span class="text-xs px-1.5 py-0.5 rounded {{ sc.get(r.stage, 'bg-info-muted text-info-strong') }}">{{ r.stage }}</span>
          {% if r.lane %}<div class="text-xs text-fg-faint truncate" title="lane {{ r.lane }}">lane={{ r.lane }}</div>{% endif %}
          {% if r.attempt is not none %}<div class="text-xs text-fg-faint">attempt:{{ r.attempt }}</div>{% endif %}
        </div>
        <div class="w-20 shrink-0 text-right text-xs text-fg-faint" title="{{ r.updated_at | abs_ts }}">{{ r.updated_at | ago }}</div>
      </li>
      {% endfor %}
      {% if root.hidden %}
      <li class="px-3 py-1.5 text-xs text-fg-faint">
        … +{{ root.hidden }} more under <a href="/eye/td{{ root.root_id }}" class="font-mono hover:underline">td{{ root.root_id }}</a>
      </li>
      {% endif %}
      {# Open gripes hung under the root by thread: tag (td540842). #}
      {% for g in root.gripes.rows %}
      {{ gripe_row(g, 1.25, root.root_id) }}
      {% endfor %}
      {% if root.gripes.hidden %}
      <li class="px-3 py-1.5 text-xs text-fg-faint">
        … +{{ root.gripes.hidden }} more gripes — <code>{{ root.gripes.more }}</code>
      </li>
      {% endif %}
      {% endfor %}
      {# The quest's live job lines (running / claimable), one per line. #}
      {% for j in q.jobs %}
      <li class="px-3 py-1.5 text-xs font-mono text-fg-secondary" data-kind="job">{{ j }}</li>
      {% endfor %}
    </ul>
  </details>
</section>
{% endfor %}
{% endif %}
{% endfor %}
{% if not model.quests %}
<p class="text-sm text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3 mb-6">
  No quests.
</p>
{% endif %}

{% if model.unassigned %}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Unassigned roots ({{ model.unassigned | length }}) — serve no quest</h2>
  <ul class="rounded-lg border border-line bg-surface divide-y divide-line">
    {% for u in model.unassigned %}
    <li class="flex items-baseline gap-3 px-3 py-1.5 text-sm" data-handle="{{ u.handle }}" data-kind="todo" data-status="{{ u.status }}">
      <a href="/eye/{{ u.handle }}" class="font-mono text-xs text-fg-subtle hover:underline">{{ u.handle }}</a>
      <span class="flex-1 min-w-0 truncate">{{ u.title }}</span>
      <span class="text-xs px-1.5 py-0.5 rounded {{ sc.get(u.status, 'bg-info-muted text-info-strong') }}">{{ u.status }}</span>
    </li>
    {% endfor %}
  </ul>
</section>
{% endif %}

{% if model.unplaced_gripes.rows %}
<section class="mb-6" data-kind="unplaced-gripes">
  <h2 class="text-sm font-semibold mb-2">Unplaced gripes ({{ model.unplaced_gripes.rows | length + model.unplaced_gripes.hidden }}) — open, thread matches no root</h2>
  <div class="rounded-lg border border-line bg-surface">
    {{ cols_header() }}
    <ul class="divide-y divide-line">
      {% for g in model.unplaced_gripes.rows %}
      {{ gripe_row(g, 0) }}
      {% endfor %}
      {% if model.unplaced_gripes.hidden %}
      <li class="px-3 py-1.5 text-xs text-fg-faint">
        … +{{ model.unplaced_gripes.hidden }} newer — <code>{{ model.unplaced_gripes.more }}</code>
      </li>
      {% endif %}
    </ul>
  </div>
</section>
{% endif %}

<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Hosts</h2>
  {% if model.hosts %}
  <ul class="rounded-lg border border-line bg-surface divide-y divide-line">
    {% for h in model.hosts %}
    <li class="flex items-baseline gap-3 px-3 py-1.5 text-sm">
      <span class="font-mono text-xs font-semibold">{{ h.host }}</span>
      <span class="text-xs text-fg-faint">reported {{ h.age }}</span>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">
    None reported — install <code>scripts/fleet-report</code> (fleet-help).
  </p>
  {% endif %}
  <p class="text-xs text-fg-faint mt-2">release: not reported by any host (dark-factory step 4)</p>
</section>
{% endblock %}

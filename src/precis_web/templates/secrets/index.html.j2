{% extends "base.html.j2" %}
{% block title %}Secrets{% endblock %}
{% macro value_control(placeholder) %}
<div class="flex-1">
  <input type="password" name="value" autocomplete="new-password"
         x-model="v" x-show="!multiline" x-bind:disabled="multiline"
         placeholder="{{ placeholder }}" class="w-full rounded border px-2 py-1 text-xs font-mono" />
  <textarea name="value" autocomplete="off" spellcheck="false" rows="5"
            x-model="v" x-show="multiline" x-bind:disabled="!multiline" disabled
            placeholder="{{ placeholder }}" class="w-full rounded border px-2 py-1 text-xs font-mono"></textarea>
  <p class="text-xs text-fg-subtle mt-1" data-secret-entry-count
     x-text="'Entered: ' + Array.from(v).length + ' chars · ' + (v ? v.split(/\r\n|\r|\n/).length : 0) + ' lines'">Entered: 0 chars · 0 lines</p>
  <label class="block text-xs text-fg-subtle mt-1">
    <input type="checkbox" x-model="multiline"
           x-bind:disabled="multiline && /[\r\n]/.test(v)" /> Multiline value
  </label>
  <p class="text-xs text-fg-subtle mt-1" x-show="multiline && /[\r\n]/.test(v)" x-cloak>
    Remove line breaks before switching to single line.
  </p>
</div>
{% endmacro %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">Secrets</h1>
<p class="text-sm text-fg-subtle mb-2 max-w-2xl">
  Encrypted at rest in the DB vault. This page shows only a masked hint — it
  never decrypts. Updates are <strong>write-only</strong>: type a new value to
  replace one secret; leaving a field blank changes nothing. "Check now" queues
  a background job that runs a short server-side auth check against each
  configured provider's own API — the plaintext never reaches this page, a log
  line, or an error message, and this page itself makes no outbound call.
</p>
<p class="text-xs text-fg-subtle mb-3 max-w-2xl">
  Entered counts describe the new text in the field, not the saved value or its validity.
  Characters count Unicode code points, including whitespace and line breaks.
  Empty text has zero lines; blank and trailing lines count. CRLF is one line break.
  Saved hints include counts for new saves/replacements; older hints stay uncounted
  until replaced. Saved counts are informational, not validity or authentication proof.
</p>

<div class="flex items-center gap-3 mb-5">
  <form method="post" action="/secrets/check">
    <button type="submit"
            class="rounded bg-solid text-on-solid text-xs px-3 py-1.5
                   hover:bg-solid-strong transition">Check now</button>
  </form>
  <span class="text-xs text-fg-faint">
    {% if check_queued %}a status check is queued
    {% elif checked_at %}checked {{ checked_at | ago }}
    {% else %}not checked yet{% endif %}
  </span>
</div>

<div class="rounded-lg border border-line bg-surface overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-surface-subtle text-fg-subtle text-xs uppercase tracking-wide">
      <tr>
        <th class="text-left font-medium px-4 py-2">Status</th>
        <th class="text-left font-medium px-4 py-2">Name</th>
        <th class="text-left font-medium px-4 py-2">Current</th>
        <th class="text-left font-medium px-4 py-2 w-1/3">Replace value</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line-subtle">
      {% for r in rows %}
      <tr>
        <td class="px-4 py-2 align-top">
          <div class="flex items-center gap-1.5" title="{{ r.dot_title }}">
            <span class="inline-block w-2 h-2 rounded-full shrink-0
                         {% if r.dot_color == 'rose' %}bg-danger-solid-soft
                         {% elif r.dot_color == 'amber' %}bg-warning-solid-soft
                         {% else %}bg-success-solid-soft{% endif %}"></span>
            <span class="text-[10px] text-fg-faint whitespace-nowrap">{{ r.dot_label }}</span>
          </div>
          {% if r.entry and r.present and r.entry.checked_at and r.entry.state != 'missing' %}
          <div class="text-[10px] text-fg-ghost whitespace-nowrap mt-0.5">
            checked {{ r.entry.checked_at | ago }}: {{ r.entry.state }}
          </div>
          {% endif %}
        </td>
        <td class="px-4 py-2 align-top">
          <div class="flex items-center gap-2">
            <span class="font-mono text-xs text-fg-secondary">{{ r.name }}</span>
            {% if r.known %}
            <span class="text-[10px] px-1.5 py-0.5 rounded-full whitespace-nowrap
                         {% if r.spec.cost.startswith('free') %}bg-success-subtle text-success-strong
                         {% else %}bg-warning-subtle text-warning-strong{% endif %}">{{ r.spec.cost }}</span>
            {% endif %}
          </div>
          {% if r.known %}
          <div class="text-[11px] text-fg-subtle mt-0.5 max-w-sm">{{ r.spec.purpose }}</div>
          {% if r.dot_color in ('rose', 'amber') %}
          <div class="text-[11px] text-fg-faint mt-1 max-w-sm">
            {{ r.spec.get_blurb }}
            {% if r.spec.get_url %}
            <a href="{{ r.spec.get_url }}" target="_blank" rel="noopener"
               class="underline hover:text-fg-muted whitespace-nowrap">Get one &rarr;</a>
            {% endif %}
          </div>
          {% endif %}
          {% endif %}
        </td>
        <td class="px-4 py-2 align-top">
          {% if r.in_vault %}
          <span class="font-mono text-xs text-fg-faint">{{ r.hint }}</span>
          <span class="text-[10px] text-fg-ghost ml-2">{{ r.updated_at | ago }}</span>
          {% elif r.env_or_file %}
          <span class="text-[11px] text-fg-faint">(env/file)</span>
          {% else %}
          <span class="text-[11px] text-fg-ghost">&mdash;</span>
          {% endif %}
        </td>
        <td class="px-4 py-2 align-top">
          {% if r.known and not r.present %}
          <form method="post" action="/secrets/set" class="flex gap-2"
                x-data="{ v: '', multiline: false }">
            <input type="hidden" name="name" value="{{ r.name }}" />
            {{ value_control("value") }}
            <button type="submit" x-bind:disabled="!v"
                    class="rounded bg-success-solid text-on-solid text-xs px-3 py-1
                           disabled:opacity-30 disabled:cursor-not-allowed
                           hover:bg-success-solid-strong transition">Add</button>
          </form>
          {% else %}
          <form method="post" action="/secrets/set" class="flex gap-2"
                x-data="{ v: '', multiline: false }">
            <input type="hidden" name="name" value="{{ r.name }}" />
            {{ value_control("(unchanged)") }}
            <button type="submit" x-bind:disabled="!v"
                    class="rounded bg-info-solid text-on-solid text-xs px-3 py-1
                           disabled:opacity-30 disabled:cursor-not-allowed
                           hover:bg-info-solid-strong transition">Save</button>
          </form>
          {% endif %}
        </td>
        <td class="px-4 py-2 align-top text-right">
          {% if r.in_vault %}
          <form method="post" action="/secrets/delete"
                onsubmit="return confirm('Delete {{ r.name }}?')">
            <input type="hidden" name="name" value="{{ r.name }}" />
            <button type="submit"
                    class="text-xs text-fg-faint hover:text-danger transition">delete</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="5" class="px-4 py-6 text-center text-fg-faint">
        The vault is empty. Add one below.
      </td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{% if per_user_count > 0 %}
<p class="mt-2 text-[11px] text-fg-faint">
  {{ per_user_count }} per-user credentials (reMarkable pairing, feed tokens)
  are managed on /account and not listed here.
</p>
{% endif %}

<div class="mt-6 rounded-lg border border-line bg-surface p-4 max-w-2xl">
  <div class="text-xs uppercase tracking-wide text-fg-faint mb-3">Add a secret</div>
  <form method="post" action="/secrets/set" class="flex gap-2" x-data="{ n: '', v: '', multiline: false }">
    <input type="text" name="name" x-model="n" placeholder="NAME (e.g. PERPLEXITY_API_KEY)"
           class="w-1/2 rounded border border-line px-2 py-1 text-xs font-mono
                  focus:border-info-emphasis focus:outline-none" />
    {{ value_control("value") }}
    <button type="submit" x-bind:disabled="!n || !v"
            class="rounded bg-success-solid text-on-solid text-xs px-3 py-1
                   disabled:opacity-30 disabled:cursor-not-allowed
                   hover:bg-success-solid-strong transition">Add</button>
  </form>
</div>
{% endblock %}

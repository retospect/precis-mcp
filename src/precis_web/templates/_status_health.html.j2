{# Health sub-tab — corpus / ingest / worker telemetry (the old Status
   page). WS3 reconciled the two host strips that used to live on
   separate pages (Status's heartbeat table + worker_logs liveness
   pills, Factory's capability-chip cards) into the ONE strip below:
   each heartbeat row now also carries Factory's resource-slot chips
   and its 6h ERROR/CRITICAL-with-samples chip, alongside Status's own
   24h WARNING+ERROR tally — both windows shown side by side rather
   than collapsed to one, since they answer different questions ("how
   noisy today" vs "what broke recently, in detail"). A host that only
   shows up in worker_logs (no heartbeat row) still renders, as a plain
   pill, same as before. #}


{# The profiled-slow top block (Papers, Machines, Health checks,
   Background health — failed_passes/bodiless-EXISTS/hosts/spin_loops
   each ~0.2-1.8s serial on prod) lazy-loads as ONE fragment so the
   cheap tail below paints first (gr518161). #}
<div hx-get="/status/health-panels" hx-trigger="load" hx-swap="innerHTML">
  <div class="rounded-lg border border-line bg-surface px-4 py-3 text-sm text-fg-faint flex items-center gap-2 mb-6">
    <span class="inline-block w-3 h-3 rounded-full border-2 border-line-strong border-t-line-heavy animate-spin"></span>
    loading health panels…
  </div>
</div>

<!-- Claude usage rolled up from ref_events.cost_usd. -->
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Claude usage</h2>
  <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
    <div class="rounded-lg border border-line bg-surface p-4">
      <div class="text-xs uppercase tracking-wide text-fg-faint">Last 24h</div>
      <div class="mt-1 text-2xl font-semibold">${{ '%.2f'|format(usage.get('day', {}).get('cost', 0)) }}</div>
      <div class="text-sm text-fg-subtle">{{ usage.get('day', {}).get('calls', 0) }} calls</div>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <div class="text-xs uppercase tracking-wide text-fg-faint">Last 7d</div>
      <div class="mt-1 text-2xl font-semibold">${{ '%.2f'|format(usage.get('week', {}).get('cost', 0)) }}</div>
      <div class="text-sm text-fg-subtle">{{ usage.get('week', {}).get('calls', 0) }} calls</div>
    </div>
    <div class="rounded-lg border border-line bg-surface p-4">
      <div class="text-xs uppercase tracking-wide text-fg-faint mb-1">By model (7d)</div>
      <ul class="text-sm divide-y divide-line-subtle">
        {% for m in usage.get('by_model', []) %}
        <li class="py-1 flex justify-between gap-2">
          <span class="font-mono text-fg-muted truncate">{{ m.label }}</span>
          <span class="text-fg-subtle shrink-0">{{ m.calls }} · ${{ '%.2f'|format(m.cost) }}</span>
        </li>
        {% else %}
        <li class="py-1 text-fg-faint">no LLM cost recorded</li>
        {% endfor %}
      </ul>
    </div>
  </div>
  <p class="mt-1 text-xs text-fg-faint">
    Whole-runtime spend (real dollars + claude quota) lives on the
    <a href="/status?tab=budget" class="text-info hover:text-info-strong">Budget</a> sub-tab.
  </p>
</section>

<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
  <section>
    <h2 class="text-sm font-semibold mb-2">Todos by status</h2>
    <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
      {% for t in todo_status %}
      {# Click-through → /tags/refs filters refs by tag, scoped to
         kind=todo and namespace=STATUS for the relevant status. Each
         count is the population landing on the filtered list. #}
      <li class="px-4 py-2 flex justify-between text-sm hover:bg-surface-subtle">
        <a href="/tags/refs?kind=todo&namespace=STATUS&value={{ t.status }}"
           class="flex-1 text-fg-secondary hover:text-success-strong">{{ t.status }}</a>
        <span class="font-semibold">{{ t.count }}</span>
      </li>
      {% else %}
      <li class="px-4 py-2 text-sm text-fg-subtle">no todos</li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2 class="text-sm font-semibold mb-2">Recent activity
      <span class="font-normal text-xs text-fg-faint">(ref_events — per-ref)</span>
    </h2>
    <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
      {% for e in events %}
      <li class="px-4 py-2 text-xs flex items-center gap-2">
        <span class="text-fg-faint w-28 shrink-0">{{ e.ts }}</span>
        <span class="font-mono text-fg-muted">{{ e.event }}</span>
        <span class="text-fg-faint">{{ e.source }}</span>
        {% if e.ref_id %}<span class="ml-auto text-fg-faint">#{{ e.ref_id }}</span>{% endif %}
      </li>
      {% else %}
      <li class="px-4 py-2 text-sm text-fg-subtle">no events</li>
      {% endfor %}
    </ul>
    <p class="mt-1 text-xs text-fg-faint">
      Per-ref events only — chunk_keywords, embed, summarize batches
      log to <code>worker_logs</code> instead (panel below).
    </p>
  </section>
</div>

{# Three focused recent-N panels: dreams, todo work-done, worker
   passes. These exist so a quiet ref_events stream doesn't read
   as "the cluster is dead" — dreams + pass batches keep ticking
   even when no status flips. #}
<div class="grid grid-cols-1 md:grid-cols-3 gap-6 mt-6">
  <section>
    <div class="flex items-baseline justify-between mb-2">
      <h2 class="text-sm font-semibold">Recent dreams</h2>
      {# Synthetic-insight badge: dreams promoted by the agent's own
         Step-7 self-review (cited refs verified + cross-kind +
         specific mechanism named). Click for the full filtered list. #}
      {% if insight_count > 0 %}
      <a href="/tags/refs?namespace=tier&value=synthetic-insight"
         class="text-xs text-success-strong hover:underline">
        ✨ {{ insight_count }} synthetic insight{{ '' if insight_count == 1 else 's' }} →
      </a>
      {% endif %}
    </div>
    <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
      {% for d in recent_dreams %}
      <li class="px-4 py-2 text-xs flex items-center gap-2">
        <span class="text-fg-faint w-16 shrink-0">{{ d.ago }}</span>
        {% if d.is_insight %}<span class="text-success" title="agent-verified synthetic insight">✨</span>{% endif %}
        <a class="text-fg-secondary hover:underline truncate"
           href="/refs/memory/{{ d.ref_id }}">{{ d.title }}</a>
      </li>
      {% else %}
      <li class="px-4 py-2 text-sm text-fg-subtle">no dreams yet</li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2 class="text-sm font-semibold mb-2">Recent todo work-done</h2>
    <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
      {% for t in recent_todo_done %}
      <li class="px-4 py-2 text-xs flex items-center gap-2">
        <span class="text-fg-faint w-16 shrink-0">{{ t.ago }}</span>
        <span class="font-mono text-accent w-20 shrink-0">{{ t.event }}</span>
        <a class="text-fg-secondary hover:underline truncate"
           href="/todo#row-{{ t.ref_id }}">{{ t.title }}</a>
      </li>
      {% else %}
      <li class="px-4 py-2 text-sm text-fg-subtle">no completions recorded</li>
      {% endfor %}
    </ul>
  </section>

  <section>
    <h2 class="text-sm font-semibold mb-2">Recent worker passes
      <span class="font-normal text-xs text-fg-faint">(productive)</span>
    </h2>
    <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
      {% for p in recent_passes %}
      <li class="px-4 py-2 text-xs flex items-center gap-2">
        <span class="text-fg-faint w-16 shrink-0">{{ p.ago }}</span>
        <span class="font-mono text-fg-muted w-32 shrink-0">{{ p.pass }}</span>
        <span class="text-fg-faint w-20 shrink-0">{{ p.host }}</span>
        <span class="ml-auto tabular-nums text-fg-subtle">
          claimed {{ p.claimed }} · ok {{ p.ok }}{% if p.failed %} · <span class="text-danger">failed {{ p.failed }}</span>{% endif %}
        </span>
      </li>
      {% else %}
      <li class="px-4 py-2 text-sm text-fg-subtle">no productive batches recorded</li>
      {% endfor %}
    </ul>
  </section>
</div>

{# Recent LLM-agent fires: dream / structural reviewer / deep_review
   / job_claude_inproc / quota_check. Each is one ``claude -p`` call
   per row — failed rows render in red so silent-failure streaks
   stand out. #}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2">Recent LLM agent activity
    <span class="font-normal text-xs text-fg-faint">(dream, reviewers, job runner, quota)</span>
  </h2>
  <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
    {% for a in recent_agents %}
    <li class="px-4 py-2 text-xs flex items-center gap-2 {% if not a.ok_flag %}bg-danger-subtle{% endif %}">
      <span class="text-fg-faint w-16 shrink-0">{{ a.ago }}</span>
      <span class="font-mono {% if a.ok_flag %}text-accent-strong{% else %}text-danger-strong{% endif %} w-44 shrink-0">{{ a.pass }}</span>
      <span class="text-fg-subtle w-20 shrink-0">{{ a.host }}</span>
      <span class="ml-auto tabular-nums {% if a.ok_flag %}text-success-strong{% else %}text-danger-strong font-medium{% endif %}">
        {% if a.ok_flag %}ok{% else %}FAILED{% endif %}
        <span class="text-fg-faint">·</span> claimed {{ a.claimed }} · ok {{ a.ok }} · failed {{ a.failed }}
      </span>
    </li>
    {% else %}
    <li class="px-4 py-2 text-sm text-fg-subtle">no agent fires recorded yet</li>
    {% endfor %}
  </ul>
</section>

{# Standing automations: recurring todos (meta.schedule set) tagged
   ``automation`` — the morning/evening podcast casts, the news briefing.
   The cron-into-recurring fold moved the retired ``kind='cron'`` push mechanism onto the
   recurring facet + ``meta.deliver``; the recurring's title IS the
   prompt for a deliver-mode tick — edit it to change behaviour. See
   precis-automations. #}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2">Automations
    <span class="font-normal text-xs text-fg-faint">(standing recurrings — the casts, the briefing)</span>
  </h2>
  <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
    {% for a in automations %}
    <li class="px-4 py-2 text-xs flex items-center gap-2 {% if a.status == 'paused' %}bg-warning-subtle{% endif %}">
      <span class="font-mono text-accent-strong w-28 shrink-0">{{ a.label }}</span>
      <span class="text-fg-subtle w-28 shrink-0">{{ a.recurring }}</span>
      <span class="text-fg-secondary truncate">{{ a.payload }}</span>
      {% if a.produced %}
      <a class="text-info-strong hover:underline shrink-0 truncate max-w-xs"
         href="/refs/{{ a.produced.kind }}/{{ a.produced.ref_id }}">→ {{ a.produced.kind }}: {{ a.produced.title }}</a>
      {% endif %}
      <span class="ml-auto tabular-nums text-fg-subtle shrink-0">
        {% if a.status == 'paused' %}<span class="text-warning">paused</span> · {% endif %}last {{ a.last_fired }} · fired {{ a.fire_count }}
      </span>
    </li>
    {% else %}
    <li class="px-4 py-2 text-sm text-fg-subtle">no automations tagged yet
      <span class="text-fg-faint">— tag a standing recurring with <code>automation</code></span>
    </li>
    {% endfor %}
  </ul>
</section>

{# Chunk-pipeline backlog: how many chunks are still waiting on each
   pass. ``pending = 0`` means the worker is caught up; a growing
   number means the embedder / keyword extractor / summarizer can't
   keep up with ingest. -1 = query failed (schema drift).

   This panel's counts are full-table aggregate scans over ``chunks``
   (the slowest queries on the page), so we lazy-load them: the section
   below streams in via htmx (``GET /status/backlog``) on page load
   instead of blocking the initial render. #}
<section class="mt-6">
  <h2 class="text-sm font-semibold mb-2">Chunk pipeline backlog
    <span class="font-normal text-xs text-fg-faint">(pending 0 = caught up)</span>
  </h2>
  <div hx-get="/status/backlog" hx-trigger="load" hx-swap="innerHTML">
    <div class="rounded-lg border border-line bg-surface px-4 py-3 text-sm text-fg-faint flex items-center gap-2">
      <span class="inline-block w-3 h-3 rounded-full border-2 border-line-strong border-t-line-heavy animate-spin"></span>
      loading backlog…
    </div>
  </div>
</section>

{% extends "base.html.j2" %}
{% block title %}{{ ref.title }} — smartdraft{% endblock %}
{% block content %}
{# The shared draftEdit/tableEditor Alpine components + ProseMirror mount
   (gripe 56746) — same macros the classic /drafts reader uses, so smartdraft
   gets the rich in-place editor (incl. `[`-citation autocomplete) and the
   table grid editor. #}
{% import "drafts/_editors.html.j2" as draft_editors %}
{# Shared figure media render + clearance badge + upload form (gripe 56668)
   — same drafts/_figures.html.j2 the classic /drafts reader uses, so a
   figure looks and behaves identically in both readers. #}
{% import "drafts/_figures.html.j2" as draft_figures %}
{# One URL builder for the whole panel — every control overrides one param.
   Params are to_* so they don't shadow the render-context globals they
   default to (a macro can't see template-level {% set %} vars). #}
{% macro slink(to_focus=None, to_q=None, to_sig=None, to_view=None, to_rel=None, to_debug=None) -%}
/smartdraft/{{ ident }}?focus={{ to_focus if to_focus is not none else focus_dc }}&relevance={{ '1' if (to_rel if to_rel is not none else relevance) else '0' }}&q={{ (to_q if to_q is not none else q) | urlencode }}&sig={{ to_sig if to_sig is not none else active_sig }}&sview={{ to_view if to_view is not none else sview }}&debug={{ '1' if (to_debug if to_debug is not none else debug) else '0' }}
{%- endmacro %}
{% macro qs(dc) %}{{ slink(to_focus=dc) }}{% endmacro %}

{# one kept-body / collapsed-run row under a heading section (the fisheye detail
   layer). q/focus_dc/debug are render-context globals a macro can see; hit_dcs
   is a template {% set %} so it must be passed in. #}
{% macro toc_body_row(row, hit_dcs) %}
{%- if row.collapsed_nodes -%}
  {% set first = row.collapsed_nodes[0] %}
  {% set _peek = row.collapsed_nodes[:8] | map(attribute='summary') | join('\n') %}
  <a href="?focus={{ first.dc }}" data-dc="{{ first.dc }}"
     title="{{ _peek }}{% if row.collapsed_nodes|length > 8 %}
… +{{ row.collapsed_nodes|length - 8 }} more{% endif %}"
     class="sd-collapse">⋯ {{ row.collapsed_nodes|length }} paras ⋯</a>
{%- else -%}
  {% set n = row.node %}
  <a id="toc-{{ n.dc }}" href="?focus={{ n.dc }}" data-dc="{{ n.dc }}"
     style="padding-left: {{ 0.4 + n.depth * 0.6 }}rem"
     class="sd-row{% if q and n.dc in hit_dcs %} sd-hit{% elif n.dc == focus_dc %} sd-focus{% elif row.shared %} sd-shared{% elif row.pressure >= 0.4 %} sd-hot{% endif %}">
    <span class="sd-btext">{% if debug %}<span class="sd-dc">{{ n.dc }}</span> {% endif %}· {{ n.summary }}</span>
    <span class="sd-badge">{%- if row.shared %}<span title="shares a keyword with the focus">🔑</span>{% endif -%}{%- if n.pinned %}📌{% endif -%}{%- if n.locked %}🔒{% endif -%}</span>
  </a>
{%- endif -%}
{% endmacro %}

<style>
  /* Named classes for the high-count outline/TOC rows — each replaces ~350
     chars of repeated Tailwind utilities, so a 1897-heading draft's response
     drops from megabytes of class attributes to a few named hooks. Colours are
     the Tailwind slate/sky/amber/emerald values these rows used verbatim. */
  details.sd-sec > summary.sd-sum { list-style: none; cursor: pointer; }
  details.sd-sec > summary.sd-sum::-webkit-details-marker { display: none; }
  .sd-sum, .sd-row { display: flex; align-items: flex-start; gap: .25rem;
    padding-top: .125rem; padding-bottom: .125rem; padding-right: .5rem; }
  .sd-sum:hover, .sd-row:hover { background: #f8fafc; }          /* slate-50 */
  .sd-focus { background: #fffbeb; box-shadow: inset 0 0 0 1px #fbbf24; } /* amber-50 + ring-400 */
  .sd-hit { background: #e0f2fe; }                               /* sky-100 */
  .sd-shared { background: #ecfdf5; }                            /* emerald-50 */
  .sd-hot { background: #f0f9ff; }                               /* sky-50 */
  .sd-tw { flex-shrink: 0; margin-top: .125rem; width: .5rem; font-size: 9px;
    color: #94a3b8; transition: transform .1s; }
  details.sd-sec[open] > summary.sd-sum .sd-tw { transform: rotate(90deg); }
  .sd-htext, .sd-btext { min-width: 0; flex: 1 1 0%; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; }
  .sd-htext { font-weight: 600; color: #1e293b; }               /* slate-800 */
  .sd-htext:hover { color: #0369a1; }                           /* sky-700 */
  .sd-btext { color: #475569; }                                 /* slate-600 */
  .sd-collapse { display: block; padding: .125rem .5rem; color: #cbd5e1; }
  .sd-collapse:hover { background: #f8fafc; color: #64748b; }
  .sd-badge { flex-shrink: 0; font-size: 10px; }
  .sd-dc { font-family: ui-monospace, monospace; font-size: 9px; color: #0ea5e9; }
</style>

{# KaTeX — same client-side $…$ / $$…$$ math render the classic /drafts reader
   uses (detail.html.j2), so smartdraft renders LaTeX ($sp^3$, reactions) too.
   mhchem registers \ce{}/\pu{}; auto-render's onload fires the initial pass
   over #sd-content, and afterSwap() re-runs it after every no-reload nav. #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/mhchem.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
  onload="window.__sdRenderMath && window.__sdRenderMath()"></script>

{# ProseMirror mount (window.__mountDraftPM) + the global draftEdit/
   tableEditor Alpine factories + their CSS — loaded ONCE here, OUTSIDE
   #sd-content, so a no-reload nav swap (swapFrom, below) never re-imports the
   ES module or redefines the globals; only the macro-rendered markup inside
   #sd-content is replaced + re-initialized via Alpine.initTree. #}
{% include "drafts/_editors.html.j2" %}

<div class="mb-2 flex items-center justify-between">
  <h1 class="truncate text-base font-semibold">{{ ref.title }}</h1>
  <div class="flex items-center gap-3 text-[11px] text-slate-500">
    <a href="{{ slink(to_debug=(not debug)) }}" class="{% if debug %}text-sky-700{% else %}hover:text-slate-800{% endif %}" title="show chunk ids (debug)">ids</a>
    <a href="/drafts/{{ ident }}" class="hover:text-slate-800">open in classic ↗</a>
  </div>
</div>

<div id="sd-content" class="grid grid-cols-1 items-start gap-3 lg:grid-cols-[28%_44%_28%]">

  {# ── LEFT: fisheye TOC nav (sticky sidebar; the middle flows so its
       hover-preview popovers aren't clipped by an overflow container) ── #}
  <div class="sticky top-2 self-start rounded border border-slate-200 bg-white">
    {# header: search + signal toggles + fisheye/full + results view #}
    <div class="space-y-1.5 border-b border-slate-100 p-2">
      <form method="get" action="/smartdraft/{{ ident }}">
        <input type="hidden" name="focus" value="{{ focus_dc }}">
        <input type="hidden" name="relevance" value="{{ '1' if relevance else '0' }}">
        <input type="hidden" name="sig" value="{{ active_sig }}">
        <input type="hidden" name="sview" value="{{ sview }}">
        <input name="q" value="{{ q }}" placeholder="search…" autocomplete="off"
               class="w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none">
      </form>
      <div class="flex items-center gap-1">
        {% for s in [('v','verbatim text'),('k','keywords'),('t','tags'),('s','semantic (embedding)')] %}
        {% set on = s[0] in active_sig %}
        {% set nsig = (active_sig|replace(s[0],'')) if on else (active_sig ~ s[0]) %}
        <a href="{{ slink(to_sig=nsig) }}" title="{{ s[1] }} — click to toggle"
           class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-[11px] font-semibold
                  {% if on %}border-sky-500 bg-sky-600 text-white{% else %}border-slate-200 text-slate-300 hover:text-slate-500{% endif %}">{{ s[0]|upper }}</a>
        {% endfor %}
        <a href="{{ slink(to_rel=(not relevance)) }}" title="fisheye vs full document"
           class="ml-auto rounded border border-slate-200 px-1.5 py-0.5 text-[11px] {% if relevance %}bg-sky-600 text-white{% else %}text-slate-500{% endif %}">{{ '🔍' if relevance else '📄' }}</a>
      </div>
      {% if q %}
      <div class="flex items-center gap-2 text-[10px] text-slate-500">
        <span>{{ hits | length }} hit{{ 's' if hits | length != 1 }}</span>
        <a href="{{ slink(to_view='list') }}" class="{% if sview == 'list' %}font-semibold text-sky-700{% else %}hover:text-slate-700{% endif %}">list</a>
        <a href="{{ slink(to_view='toc') }}" class="{% if sview == 'toc' %}font-semibold text-sky-700{% else %}hover:text-slate-700{% endif %}">in-toc</a>
        <a href="{{ slink(to_q='') }}" class="ml-auto hover:text-rose-600">clear</a>
      </div>
      {% if sem_degraded and 's' in active_sig %}
      <div class="text-[10px] text-amber-600" title="the web embedder returned nothing — semantic search is unavailable right now">⚠ semantic unavailable (embedder warming?) — V/K/T only</div>
      {% endif %}
      {% endif %}
    </div>

    <div class="max-h-[calc(100vh-9rem)] overflow-auto py-1 text-xs">
      {% if q and sview == 'list' %}
      {# ── search results (ranked list) ── #}
      {% for h in hits %}
      {% set n = h.node %}
      <a href="?focus={{ n.dc }}" data-dc="{{ n.dc }}"
         class="flex items-center gap-1 px-2 py-1 hover:bg-sky-100 {% if n.dc == focus_dc %}bg-sky-100 ring-1 ring-inset ring-sky-400{% else %}bg-sky-50{% endif %}">
        {% for b in [('v', h.v, 'V', 'bg-sky-600'), ('k', h.k, 'K', 'bg-teal-600'), ('t', h.t, 'T', 'bg-amber-600')] %}
          {% if b[1] %}<span title="{{ b[0] }} match{{ '' if b[0] in active_sig else ' (off — not counted)' }}"
             class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[9px] font-semibold text-white {% if b[0] in active_sig %}{{ b[3] }}{% else %}bg-slate-300{% endif %}">{{ b[2] }}</span>{% endif %}
        {% endfor %}
        {% if h.s_rank %}<span title="semantic rank #{{ h.s_rank }}{{ '' if 's' in active_sig else ' (off)' }}"
           class="inline-flex h-4 shrink-0 items-center justify-center rounded-full px-1 text-[9px] font-semibold text-white {% if 's' in active_sig %}bg-violet-600{% else %}bg-slate-300{% endif %}">S{{ h.s_rank }}</span>{% endif %}
        <span class="min-w-0 flex-1 truncate text-slate-600">{{ n.summary }}</span>
      </a>
      {% else %}
      <div class="px-2 py-3 text-slate-400">No matches.</div>
      {% endfor %}

      {% else %}
      {# ── fisheye TOC: foldable heading-outline tree (details/summary, no JS).
           The focus's section path (+ any hit's) ships open; the rest fold. ── #}
      {% set hit_dcs = hits | map(attribute='node') | map(attribute='dc') | list %}
      {% for sec in view.outline recursive %}
        {% if sec.heading %}
        <details {% if sec.open %}open{% endif %} class="sd-sec">
          <summary id="toc-{{ sec.heading.dc }}"
             style="padding-left: {{ 0.2 + sec.heading.depth * 0.6 }}rem"
             class="sd-sum{% if sec.heading.dc == focus_dc %} sd-focus{% elif q and sec.heading.dc in hit_dcs %} sd-hit{% endif %}">
            <span class="sd-tw">{% if sec.children or sec.body %}▸{% endif %}</span>
            <a data-dc="{{ sec.heading.dc }}" href="?focus={{ sec.heading.dc }}"
               class="sd-htext">{% if debug %}<span class="sd-dc">{{ sec.heading.dc }}</span> {% endif %}{{ sec.heading.summary }}</a>
            {%- if sec.heading.pinned %}<span class="sd-badge">📌</span>{% endif -%}
          </summary>
          {% for row in sec.body %}{{ toc_body_row(row, hit_dcs) }}{% endfor %}
          {% if sec.children %}{{ loop(sec.children) }}{% endif %}
        </details>
        {% else %}
          {% for row in sec.body %}{{ toc_body_row(row, hit_dcs) }}{% endfor %}
          {% if sec.children %}{{ loop(sec.children) }}{% endif %}
        {% endif %}
      {% else %}
        <div class="px-2 py-3 text-slate-400">No chunks yet.</div>
      {% endfor %}
      {% endif %}
    </div>
  </div>

  {# ── MIDDLE: the focus + its neighbourhood. NOT an overflow container —
       it flows with the page so linkify hover-preview popovers escape freely
       (an overflow-auto ancestor would clip them at the panel edge). ── #}
  <div class="rounded border border-slate-200 bg-white">
    <div class="border-b border-slate-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Focus</div>
    <div class="space-y-2 p-3 text-sm">
      {% for m in view.middle %}
        {% set n = m.node %}
        {% set hd = 'font-semibold text-slate-900 text-base' if n.is_heading else '' %}
        {% if m.mode == 'full' and n.is_table %}
        {# Table focus: the ⊞ grid editor (shared draft_editors.html.j2,
           gripe 56746) instead of the plain-text editor — a table chunk isn't
           `n.editable` (there's no free-text edit path for it), but it always
           gets the structured grid. #}
        {% set _seed = n.table or {'header': ['Column 1', 'Column 2'], 'rows': [], 'caption': none} %}
        <div id="mid-focus" class="rounded border border-amber-200 bg-amber-50 p-2">
          <div class="mb-1 flex items-center gap-2 text-[10px] text-amber-700">
            <span>{% if debug %}<span class="font-mono text-sky-500">{{ n.dc }}</span> {% endif %}{% if n.locked %}🔒{% endif %}</span>
            <button onclick="smartPin('{{ n.dc }}')"
                    class="ml-auto {% if focus_pinned %}font-semibold text-amber-800{% else %}text-slate-400 hover:text-amber-700{% endif %}"
                    title="pin/unpin this para (key: p)">📌 {{ 'unpin' if focus_pinned else 'pin' }}</button>
          </div>
          {% call draft_editors.draft_table_editor(ident, n.base58, n.sha, _seed) %}
          {% if n.table %}
          <div class="overflow-x-auto">
            <table class="w-full border-collapse text-sm">
              {% if n.table.caption %}
              <caption class="mb-1 text-left text-[13px] font-semibold text-slate-700">{{ n.table.caption | linkify_refs(markdown=True, compact=True) }}</caption>
              {% endif %}
              <thead><tr>
                {% for h in n.table.header %}
                <th class="border-b-2 border-slate-300 px-2 py-1 text-left align-top font-semibold text-slate-800">{{ h | linkify_refs(markdown=True, compact=True) }}</th>
                {% endfor %}
              </tr></thead>
              <tbody>
                {% for row in n.table.rows %}
                <tr class="even:bg-slate-50">
                  {% for cell in row %}
                  <td class="border-b border-slate-100 px-2 py-1 align-top text-slate-700 whitespace-pre-wrap break-words">{{ cell | linkify_refs(markdown=True, compact=True) }}</td>
                  {% endfor %}
                </tr>
                {% endfor %}
              </tbody>
            </table>
          </div>
          {% else %}
          <p class="whitespace-pre-wrap text-slate-800 {{ hd }}">{{ m.display | linkify_refs(markdown=True, compact=True) }}</p>
          {% endif %}
          {% endcall %}
        </div>
        {% elif m.mode == 'full' and n.is_figure %}
        {# Figure focus: the shared medium-aware image render + clearance
           badge (drafts/_figures.html.j2, gripe 56668) — the SAME markup
           the classic /drafts reader uses, instead of the raw caption text
           smartdraft rendered before figures had their own render here. #}
        <div id="mid-focus" class="rounded border border-amber-200 bg-amber-50 p-2">
          <div class="mb-1 flex items-center gap-2 text-[10px] text-amber-700">
            <span>{% if debug %}<span class="font-mono text-sky-500">{{ n.dc }}</span> {% endif %}{% if n.locked %}🔒{% endif %}</span>
            <button onclick="smartPin('{{ n.dc }}')"
                    class="ml-auto {% if focus_pinned %}font-semibold text-amber-800{% else %}text-slate-400 hover:text-amber-700{% endif %}"
                    title="pin/unpin this para (key: p)">📌 {{ 'unpin' if focus_pinned else 'pin' }}</button>
          </div>
          <figure class="rounded-md border border-slate-200 bg-white p-2">
            {{ draft_figures.figure_media(ident, n.base58, n.figure_render, n.text) }}
            <figcaption class="mt-1.5 text-sm text-slate-700 whitespace-pre-wrap break-words">{{ m.display | linkify_refs(markdown=True, compact=True) }}</figcaption>
            {{ draft_figures.clearance_badge(ident, n.base58, n.figure_origin, n.figure_cleared, n.figure_permission) }}
          </figure>
        </div>
        {% elif m.mode == 'full' %}
        <div id="mid-focus" class="rounded border border-amber-200 bg-amber-50 p-2">
          {% call draft_editors.draft_edit(ident, n.base58, n.sha, n.editable, n.is_heading, n.text, rows=10) %}
          <div class="mb-1 flex items-center gap-2 text-[10px] text-amber-700">
            <span>{% if debug %}<span class="font-mono text-sky-500">{{ n.dc }}</span> {% endif %}{% if n.locked %}🔒{% endif %}</span>
            <div class="ml-auto flex items-center gap-2">
              <button onclick="smartPin('{{ n.dc }}')"
                      class="{% if focus_pinned %}font-semibold text-amber-800{% else %}text-slate-400 hover:text-amber-700{% endif %}"
                      title="pin/unpin this para (key: p)">📌 {{ 'unpin' if focus_pinned else 'pin' }}</button>
              {% if n.editable %}
              <button @click="startEdit()" class="text-slate-400 hover:text-slate-700">✎ edit</button>
              {% endif %}
            </div>
          </div>
          {# rendered view (with links) #}
          <div class="whitespace-pre-wrap text-slate-800 {{ hd }}">{{ m.display | linkify_refs(markdown=True, compact=True) }}</div>
          {# tag row (the T search signal) — chips + type-ahead add #}
          <div class="mt-2 flex flex-wrap items-center gap-1 border-t border-amber-100 pt-1.5 text-[10px]">
            <span class="text-slate-400">🏷</span>
            {% for tag in n.tags %}
            <span class="inline-flex items-center gap-0.5 rounded bg-teal-100 px-1 text-teal-700">{{ tag }}<button onclick="smartTagRemove('{{ n.dc }}', {{ tag | tojson }})" class="hover:text-rose-600" title="remove tag">&times;</button></span>
            {% endfor %}
            <span class="relative" x-data="smartTagInput('{{ n.dc }}')">
              <input x-model="v" @input.debounce.200ms="suggest()" @keydown.enter.prevent="add()" @keydown.escape="items=[]"
                     placeholder="+tag" class="w-14 rounded border border-slate-200 px-1 py-0.5 focus:w-28 focus:border-teal-400 focus:outline-none">
              <div x-show="items.length" x-cloak class="absolute left-0 top-full z-50 mt-0.5 min-w-[6rem] rounded border border-slate-200 bg-white shadow-lg">
                <template x-for="s in items" :key="s"><button type="button" @click="v = s; add()" class="block w-full whitespace-nowrap px-1.5 py-0.5 text-left text-teal-700 hover:bg-teal-50" x-text="s"></button></template>
              </div>
            </span>
          </div>
          {% endcall %}
        </div>
        {% elif m.mode == 'doc' %}
        {# full-doc mode: every chunk verbatim, plain (focus is the amber box above) #}
        <a href="{{ qs(n.dc) }}" class="block whitespace-pre-wrap rounded px-2 py-1 text-slate-700 hover:bg-slate-50 {{ hd }}">{% if debug %}<span class="font-mono text-[9px] text-sky-500">{{ n.dc }} </span>{% endif %}{{ m.display | linkify_refs(markdown=True, compact=True) }}</a>
        {% elif m.mode in ('tail', 'head') %}
        {# ±1 neighbour: verbatim, truncated toward the focus (tail leads in, head flows out) #}
        <a href="{{ qs(n.dc) }}" class="block whitespace-pre-wrap rounded px-2 py-1 text-slate-500 hover:bg-slate-50 {{ hd }}">{% if debug %}<span class="font-mono text-[9px] text-sky-500">{{ n.dc }} </span>{% endif %}{{ m.display | linkify_refs(markdown=True, compact=True) }}</a>
        {% else %}
        {# ±2 neighbour: one-line summary #}
        <a href="{{ qs(n.dc) }}" class="block truncate rounded px-2 py-0.5 text-slate-400 hover:bg-slate-50 {{ hd }}" title="{{ n.text[:400] }}">{% if debug %}<span class="font-mono text-[9px] text-sky-500">{{ n.dc }} </span>{% endif %}· {{ m.display }}</a>
        {% endif %}
      {% else %}
        <div class="text-slate-400">Empty draft.</div>
      {% endfor %}
      {# "Relevant elsewhere" is not injected here — it broke the reading
         sequence. Distant-but-relevant chunks light up in the TOC (left) at
         their real location instead (sky tint), so the map carries relevance
         and the middle stays a clean read. #}
    </div>
  </div>

  {# ── RIGHT: collaboration (working set + request box) — sticky sidebar ── #}
  <div class="sticky top-2 self-start rounded border border-slate-200 bg-white" x-data="smartAsk('{{ ident }}', '{{ focus_dc }}')">
    <div class="border-b border-slate-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Collaborate</div>
    <div class="space-y-2 p-2 text-xs">
      {% if needs %}
      <div class="rounded border border-amber-200 bg-amber-50 p-1.5">
        <div class="mb-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700">Needs · in-flight</div>
        {% for w in needs %}
        <div class="flex items-center gap-1 py-0.5 text-[10px]">
          {% if w.asks %}<span title="{{ w.asks | join('; ') }}">✋</span>{% endif %}
          <a href="/r/todo/{{ w.todo_id }}" target="_blank" rel="noopener" class="min-w-0 flex-1 truncate text-slate-700 hover:underline">{{ w.title }}</a>
          <span class="shrink-0 rounded px-1 {% if w.blocked %}bg-rose-100 text-rose-700{% else %}bg-slate-200 text-slate-600{% endif %}">{{ w.status }}</span>
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {# ── Cited sources (gripe 56635): the FOCUS block's paper citations,
           as hover-preview chips (precis_web.routes.smartdraft._cited_sources,
           reusing the classic /drafts reader's _ref_chips parser). Each chip
           opens the paper reader in a NEW TAB (popover_chip → linkify.
           _anchor_html carries target="_blank", no data-dc) so the writing
           surface stays put. Omitted when the focus cites nothing. #}
      {% if cited_sources %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Cited sources</div>
        <div class="flex flex-wrap gap-1">
          {% for c in cited_sources %}{{ c }}{% endfor %}
        </div>
      </div>
      {% endif %}

      <div class="flex items-center gap-2 text-slate-500">
        <span>Pinned: 📌 {{ eye_count }}</span>
        {% if eye_count %}<button onclick="smartClearPins()" class="text-[10px] text-slate-400 hover:text-rose-600">unpin all</button>
        {% else %}<span class="text-[10px] text-slate-400">nothing pinned — the ask works on the current para</span>{% endif %}
      </div>

      {# ── Figure add + clearance (gripe 56668 — ported from the classic
           /drafts reader; shared markup drafts/_figures.html.j2). Add
           inserts a new figure chunk right after the current focus (the
           same "insert after this block" semantics the classic per-row
           control uses); the upload form + any clearance edit below POST to
           the SAME /drafts/{ident}/figure… endpoints classic uses — the
           delegated `submit` listener below intercepts them so a successful
           save refreshes this panel in place instead of navigating to the
           classic reader (their redirect target). #}
      {% if view.focus %}
      <div class="rounded border border-slate-200 bg-slate-50 p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Figure</div>
        {{ draft_figures.figure_upload_form(ident, view.focus.base58) }}
      </div>
      {% endif %}
      {% set fig_nodes = view.nodes | selectattr('is_figure') | list %}
      {% if fig_nodes %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Figures · clearance</div>
        {% for fn in fig_nodes %}
        <div class="flex items-center gap-1.5 py-0.5 text-[10px]">
          <a href="{{ qs(fn.dc) }}" data-dc="{{ fn.dc }}"
             class="min-w-0 flex-1 truncate text-slate-600 hover:text-sky-700"
             title="{{ fn.summary }}">{{ fn.summary }}</a>
          {{ draft_figures.clearance_badge(ident, fn.base58, fn.figure_origin, fn.figure_cleared, fn.figure_permission) }}
        </div>
        {% endfor %}
      </div>
      {% endif %}

      {# ── Term occurrences (gripe 56690): focusing a chunk_kind='term'
           leaf lists every other chunk mentioning it — short / long /
           abbrev / surface_forms — so the author jumps straight to a
           usage site. Computed server-side from the already-loaded node
           set (precis_web.smartdraft.term_occurrences), no DB scan. #}
      {% if view.focus and view.focus.is_term %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Occurs in {{ term_occurrences | length }} place{{ 's' if term_occurrences | length != 1 else '' }}</div>
        {% if term_occurrences %}
        {% for on in term_occurrences %}
        <a href="{{ qs(on.dc) }}" data-dc="{{ on.dc }}"
           class="block truncate rounded px-1 py-0.5 text-[10px] text-slate-600 hover:bg-slate-50 hover:text-sky-700"
           title="{{ on.summary }}">{{ on.summary }}</a>
        {% endfor %}
        {% else %}
        <div class="text-[10px] text-slate-400">not yet used elsewhere in this draft</div>
        {% endif %}
      </div>
      {% endif %}

      <textarea x-model="text" rows="3" placeholder="Ask the LLM (works on the pinned context, or the current para if nothing is pinned)…"
                class="w-full rounded border border-slate-200 px-2 py-1"></textarea>
      <div class="flex items-center gap-2">
        <select x-model="model" class="rounded border border-slate-200 px-1 py-0.5 text-slate-600">
          <option>opus</option><option>sonnet</option><option>haiku</option>
        </select>
        <span class="text-slate-400" x-show="msg" x-text="msg"></span>
        <button @click="send()" :disabled="!text.trim()" class="ml-auto rounded bg-slate-800 px-2 py-1 text-white disabled:opacity-40">Send ▸</button>
      </div>
    </div>

    {# ── Tools pane (right-rail bottom) — export / doc-metadata / lifecycle
         controls ported from the classic /drafts reader (detail.html.j2).
         Tabbed (Export · Meta · Actions) so the resting footprint stays a
         tab-bar + one short row — the rail is a `sticky` element and a pane
         tall enough to exceed the viewport would strand its own bottom. Every
         dropdown opens UPWARD (`bottom-full`) for the same reason: there's no
         room below. All controls POST/GET the SAME shared /drafts/{ident}/…
         endpoints classic uses (nothing new server-side); the in-place ones
         (authors/genre/auto-author/export→project/reMarkable, which classic
         redirects back to its own reader) are intercepted in the submit
         handler below and refreshed in place — fork/delete correctly navigate
         away (new copy / drafts list). #}
    <div class="border-t border-slate-100" x-data="{ tool: 'export' }">
      <div class="flex items-center gap-1 border-b border-slate-100 px-2 py-1">
        <span class="mr-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Tools</span>
        <template x-for="t in ['export', 'meta', 'actions']" :key="t">
          <button @click="tool = t"
                  class="rounded px-1.5 py-0.5 text-[11px] capitalize"
                  :class="tool === t ? 'bg-slate-700 text-white' : 'text-slate-500 hover:text-slate-800'"
                  x-text="t"></button>
        </template>
      </div>

      {# ── Export: docx/pdf downloads, PDF→project job, papers zip, reMarkable.
           `withSources` toggles the include-referenced-sources appendix (docx
           returns a zip; PDF a pdfpages appendix) — same semantics as classic. #}
      <div x-show="tool === 'export'" x-cloak class="space-y-1.5 p-2 text-xs" x-data="{ withSources: false }">
        <label class="flex items-center gap-1 text-slate-500"
               title="include the referenced papers & datasheets in the export">
          <input type="checkbox" x-model="withSources" class="h-3 w-3"><span>+ sources</span>
        </label>
        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <a :href="'/drafts/{{ ident }}/export.docx' + (withSources ? '?sources=1' : '')"
             class="text-slate-500 underline hover:text-slate-800"
             x-text="withSources ? 'download .docx+zip' : 'download .docx'">download .docx</a>
          <a :href="'/drafts/{{ ident }}/pdf' + (withSources ? '?sources=1' : '')"
             class="text-slate-500 underline hover:text-slate-800">download PDF</a>
          <form method="post" action="/drafts/{{ ident }}/export.pdf" class="inline">
            <input type="hidden" name="sources" :value="withSources ? '1' : ''">
            <button type="submit" class="text-slate-500 underline hover:text-slate-800"
                    title="start a background job that persists the PDF into the project workspace">export →project</button>
          </form>
          <a href="/drafts/{{ ident }}/papers.zip"
             class="text-slate-500 underline hover:text-slate-800"
             title="zip the cited paper/datasheet PDFs + a manifest">download papers</a>
          {% if remarkable_ready %}
          <form method="post" action="/drafts/{{ ident }}/remarkable" class="inline">
            <button type="submit" class="text-slate-500 underline hover:text-slate-800"
                    title="export in reMarkable mode (footnoted references) and send to the tablet">→ reMarkable</button>
          </form>
          {% endif %}
        </div>
      </div>

      {# ── Meta: byline, genre + project brief, auto-author toggle. The two
           editors are upward-opening popovers (no added rail height). #}
      <div x-show="tool === 'meta'" x-cloak class="flex flex-wrap items-center gap-x-3 gap-y-1 p-2 text-xs">
        {# Author byline editor — one author per line, "Name | Affiliation | ROR". #}
        <div class="relative" x-data="{ au: false }" @click.outside="au = false">
          <button @click="au = !au"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="edit the author byline + affiliations">authors ▾</button>
          <form x-show="au" x-cloak method="post"
                action="/drafts/{{ ident }}/authors"
                class="absolute bottom-full right-0 z-40 mb-1 w-96 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Authors — one per line</label>
              <textarea name="authors" rows="4"
                        placeholder="Doe, Jane | Massachusetts Institute of Technology | https://ror.org/042nb2s44&#10;Roe, John | Caltech&#10;Solo Author"
                        class="mt-0.5 w-full resize-y rounded border border-slate-200 px-2 py-1 font-mono text-xs leading-snug focus:border-sky-400 focus:outline-none">{{ author_lines }}</textarea>
              <p class="mt-0.5 text-[10px] text-slate-400"><span class="font-mono">Name | Affiliation | ROR</span> — affiliation + ROR optional; a shared ROR collapses to one numbered affiliation. Replaces the whole byline.</p>
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">save authors</button>
              <button type="button" @click="au = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Genre (document type) + project context (planner brief). #}
        <div class="relative" x-data="{ gen: false }" @click.outside="gen = false">
          <button @click="gen = !gen"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="set the document genre + project context">genre{% if cur_doctype %}: {{ cur_doctype }}{% endif %} ▾</button>
          <form x-show="gen" x-cloak method="post"
                action="/drafts/{{ ident }}/workspace"
                class="absolute bottom-full right-0 z-40 mb-1 w-80 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Genre (document type)</label>
              <select name="doctype"
                      class="mt-0.5 w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none">
                <option value="" {% if not cur_doctype %}selected{% endif %}>— none —</option>
                {% for d in doctypes %}
                <option value="{{ d.value }}" {% if cur_doctype == d.value %}selected{% endif %}>{{ d.label }}</option>
                {% endfor %}
              </select>
              <p class="mt-0.5 text-[10px] text-slate-400">paper / patent / report / review unlock the per-heading style picker.</p>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Project context (planner brief)</label>
              <textarea name="brief" rows="4"
                        placeholder="Standing guidance injected into every planner tick's ## Project context…"
                        class="mt-0.5 w-full resize-y rounded border border-slate-200 px-2 py-1 text-xs leading-snug focus:border-sky-400 focus:outline-none">{{ cur_brief }}</textarea>
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">save</button>
              <button type="button" @click="gen = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Per-document auto-author toggle (3e). Turning ON confirms first
           (the grounded lenses will EDIT the draft). #}
        <form method="post" action="/drafts/{{ ident }}/authoring"
              @submit="if (!{{ 'true' if authoring_enabled else 'false' }} && !confirm('Turn ON auto-authoring? The cites/structure review lenses will EDIT this draft — adding grounded, cited prose where a real source supports it and flagging the rest. Every edit re-opens that paragraph for your human sign-off.')) $event.preventDefault()">
          <input type="hidden" name="enabled" value="{{ '0' if authoring_enabled else '1' }}" />
          <button class="underline {% if authoring_enabled %}text-amber-600 hover:text-amber-800{% else %}text-slate-500 hover:text-slate-800{% endif %}"
                  title="{% if authoring_enabled %}auto-author is ON — grounded lenses edit the draft; click to turn OFF{% else %}auto-author is OFF — review lenses only file findings; click to turn ON{% endif %}">✎ auto-author: {{ 'ON' if authoring_enabled else 'OFF' }}</button>
        </form>
      </div>

      {# ── Actions: duplicate (Phase-1 fork → new draft) and delete. Both are
           upward-opening popovers; both navigate away on success (the new
           copy / the drafts list), so they're deliberately NOT intercepted. #}
      <div x-show="tool === 'actions'" x-cloak class="flex flex-wrap items-center gap-x-3 gap-y-1 p-2 text-xs">
        {# Duplicate this draft into a fresh project (deep-copies every chunk). #}
        <div class="relative" x-data="{ dup: false }" @click.outside="dup = false">
          <button @click="dup = !dup"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="duplicate this draft into a new project (a review copy)">⧉ duplicate ▾</button>
          <form x-show="dup" x-cloak method="post"
                action="/drafts/{{ ident }}/fork"
                class="absolute bottom-full right-0 z-40 mb-1 w-80 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <p class="text-[11px] text-slate-600">Deep-copies every paragraph + link into a <span class="font-semibold">new</span> draft under a fresh project. The original is untouched; the copy starts fully unreviewed.</p>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">New project name</label>
              <input name="project" required autocomplete="off" placeholder="e.g. nanobuds-review"
                     class="mt-0.5 w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none" />
              <p class="mt-0.5 text-[10px] text-slate-400">A fresh strategic project is created to own the copy (or pass <span class="font-mono">todo:N</span> for an existing draft-less one).</p>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Copy title <span class="font-normal text-slate-400">(optional)</span></label>
              <input name="title" autocomplete="off" placeholder="{{ ref.title }} (review copy)"
                     class="mt-0.5 w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none" />
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">duplicate →</button>
              <button type="button" @click="dup = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Delete the whole draft — type-the-name confirm; soft-delete. #}
        <div class="relative" x-data="{ del: false }" @click.outside="del = false">
          <button @click="del = !del"
                  class="text-rose-500 underline hover:text-rose-700">delete ▾</button>
          <form x-show="del" x-cloak method="post"
                action="/drafts/{{ ident }}/delete"
                @submit="if (!confirm('Delete this draft? It can be recovered by an admin, but disappears from the app.')) $event.preventDefault()"
                class="absolute bottom-full right-0 z-40 mb-1 w-72 space-y-1.5 rounded border border-rose-300 bg-white p-2 text-left shadow-lg">
            <p class="text-[11px] text-slate-600">Type the draft name
              <span class="font-semibold text-slate-800">{{ ref.title }}</span>
              to delete it (recoverable):</p>
            <input name="confirm" autocomplete="off" placeholder="draft name…"
                   class="w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-rose-400 focus:outline-none" />
            <div class="flex items-center gap-2">
              <button class="rounded bg-rose-600 px-2 py-0.5 text-[11px] text-white hover:bg-rose-700">delete draft</button>
              <button type="button" @click="del = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>

  {# nav state travels INSIDE #sd-content so a swap carries the fresh values #}
  <script type="application/json" id="sd-state">{{ {"order": view.order, "hits": (hits | map(attribute='node') | map(attribute='dc') | list), "focus": focus_dc, "q": q} | tojson }}</script>
</div>

<script>
// KaTeX render (parity with the classic /drafts reader, detail.html.j2).
// __renderMath renders one element; __sdRenderMath does the whole panel and is
// exposed on window so auto-render's onload can fire the initial pass. Both are
// no-ops until KaTeX's deferred scripts have loaded (renderMathInElement).
function __renderMath(el) {
  if (!window.renderMathInElement || !el) return;
  renderMathInElement(el, {
    delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}],
    throwOnError: false,
  });
}
window.__sdRenderMath = function () { __renderMath(document.getElementById('sd-content')); };

// Citation hover popovers load lazily via htmx AFTER the initial KaTeX pass, so
// render math in each popover fragment as it swaps in (a cited quote has $…$
// too). Same handler the classic reader uses; the swap target is .ref-popover.
document.body.addEventListener('htmx:afterSwap', function (e) {
  const t = (e.detail && e.detail.target) || e.target;
  if (t && t.classList && t.classList.contains('ref-popover')) __renderMath(t);
});

// No-reload navigation: every TOC/result/toggle link + the search form + the
// pin/tag/mark actions fetch the page and swap ONLY #sd-content (persistent
// listeners below stay bound; Alpine re-inits the swapped components). Nav-state
// (order/hits/focus/q) rides inside #sd-content and is re-read after each swap.
(function () {
  const IDENT = {{ ident | tojson }};
  let ST = readState();
  function readState() {
    try { return JSON.parse(document.getElementById('sd-state').textContent); }
    catch (e) { return { order: [], hits: [], focus: '', q: '' }; }
  }
  async function swapFrom(url) {
    try {
      const html = await (await fetch(url, { cache: 'no-store' })).text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.getElementById('sd-content');
      const cur = document.getElementById('sd-content');
      if (!fresh || !cur) { location.href = url; return; }
      // Hover-preview cards are teleported to <body> (shared linkify fix,
      // gripe 56806) — they live OUTSIDE #sd-content, so replacing its
      // innerHTML can't reap them. Alpine's own teleport cleanup removes a
      // clone when its source <template> is destroyed by that replace, but
      // drop any survivors defensively so a stale card can never linger
      // after navigating away from the para that opened it.
      document.querySelectorAll('body > .ref-popover').forEach((el) => el.remove());
      cur.innerHTML = fresh.innerHTML;
      if (window.Alpine && window.Alpine.initTree) window.Alpine.initTree(cur);
      ST = readState();
      afterSwap();
    } catch (e) { location.href = url; }
  }
  function afterSwap() {
    const el = document.getElementById('toc-' + ST.focus);
    if (el) el.scrollIntoView({ block: 'center' });
    const mid = document.getElementById('mid-focus');
    if (mid) mid.scrollIntoView({ block: 'center' });
    if (ST.q) highlightTerm(document.getElementById('sd-content'), ST.q);
    if (window.htmx) window.htmx.process(document.getElementById('sd-content'));
    // Re-render $…$ / $$…$$ math over the freshly-swapped panel. On the very
    // first DOMContentLoaded KaTeX's deferred scripts may not have loaded yet;
    // auto-render's onload (window.__sdRenderMath) covers that initial pass.
    __sdRenderMath();
  }
  async function navTo(dc) {
    const p = new URLSearchParams(location.search);
    p.set('focus', dc);
    const url = `/smartdraft/${IDENT}?` + p.toString();
    history.pushState({}, '', url);
    await swapFrom(url);
  }
  // expose a reload-free refresh for the action helpers (pin/tag/mark/save)
  window.__sdRefresh = () => swapFrom(location.href);
  const jump = navTo;
  const clearSearch = () => {
    const p = new URLSearchParams(location.search);
    p.set('q', '');
    const url = `/smartdraft/${IDENT}?` + p.toString();
    history.pushState({}, '', url);
    swapFrom(url);
  };
  // Highlight the query term wherever it shows (light blue) — a find-style mark.
  function highlightTerm(root, term) {
    if (!root || !term || term.length < 2) return;
    const re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(n) {
        const p = n.parentNode;
        if (!n.nodeValue.trim() || !p) return NodeFilter.FILTER_REJECT;
        // skip marks/scripts/inputs and links (don't disturb linkify internals)
        if (['MARK', 'SCRIPT', 'STYLE', 'TEXTAREA', 'BUTTON', 'A'].includes(p.tagName)) return NodeFilter.FILTER_REJECT;
        return re.test(n.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      },
    });
    const nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach((n) => {
      const span = document.createElement('span');
      span.innerHTML = n.nodeValue.replace(re, '<mark class="rounded bg-sky-200 text-inherit">$1</mark>');
      n.parentNode.replaceChild(span, n);
    });
  }
  window.addEventListener('DOMContentLoaded', afterSwap);
  window.addEventListener('popstate', () => swapFrom(location.href));
  // Delegate: any internal /smartdraft link (TOC rows, results, header toggles)
  // and the search form swap #sd-content instead of a full page navigation.
  const INT = 'a[href^="/smartdraft/' + IDENT + '?"]';
  document.addEventListener('click', (e) => {
    const a = e.target.closest ? e.target.closest('a') : null;
    if (!a || e.metaKey || e.ctrlKey) return;
    if (!a.closest('#sd-content')) return;   // header links (ids/debug) full-nav
    // Focus-nav rows carry a short data-dc (not a full URL — that bloated the
    // page ~90 bytes/row over ~2k rows); navTo preserves the current params.
    const dc = a.getAttribute('data-dc');
    if (dc) { e.preventDefault(); navTo(dc); return; }
    // Control links (signal/relevance/view/clear toggles) carry a full slink URL
    // with the changed param — swap to it in place.
    if (a.matches(INT)) {
      e.preventDefault();
      const href = a.getAttribute('href');
      history.pushState({}, '', href);
      swapFrom(href);
    }
  });
  document.addEventListener('submit', (e) => {
    const f = e.target;
    if (!f.matches) return;
    if (f.matches('form[action^="/smartdraft/' + IDENT + '"]')) {
      e.preventDefault();
      const url = f.getAttribute('action') + '?' + new URLSearchParams(new FormData(f)).toString();
      history.pushState({}, '', url);
      swapFrom(url);
      return;
    }
    // Figure add / clearance-edit forms (drafts/_figures.html.j2, gripe
    // 56668) — the SAME endpoints the classic /drafts reader posts to
    // (reused as-is, ADR 0034/0058), but their hardcoded redirect target is
    // the classic reader (`/drafts/{ident}#c-{handle}`). Intercept just
    // these two inside #sd-content and POST via fetch instead, then refresh
    // the panel in place. The "draw" endpoint (mint + open an SVG canvas,
    // `…/figure/{handle}/draw`) is deliberately NOT intercepted — like the
    // classic reader, it's meant to navigate away into /figure.
    const act = f.getAttribute('action') || '';
    const figBase = `/drafts/${IDENT}/figure`;
    const isFigAdd = act === figBase;
    const isFigPermission = act.startsWith(figBase + '/') && act.endsWith('/permission');
    if (f.closest('#sd-content') && (isFigAdd || isFigPermission)) {
      e.preventDefault();
      fetch(act, { method: 'POST', body: new FormData(f) })
        .then(() => window.__sdRefresh())
        .catch(() => window.alert('network error — figure not saved'));
      return;
    }
    // Tools-pane forms that edit in place / start a job. In the classic
    // reader each of these redirects back to `/drafts/{ident}` — a plain
    // submit here would bounce the writer OUT of smartdraft into classic, so
    // (like the figure forms above) POST via fetch and refresh in place. NOT
    // listed: fork + delete, which correctly navigate away (new copy / drafts
    // list). Respect a cancelled confirm — the auto-author toggle's @submit
    // may already have preventDefault()'d when the user declined.
    const inPlace = ['authors', 'workspace', 'authoring', 'export.pdf', 'remarkable'];
    if (f.closest('#sd-content') && inPlace.some((ep) => act === `/drafts/${IDENT}/${ep}`)) {
      if (e.defaultPrevented) return;
      e.preventDefault();
      fetch(act, { method: 'POST', body: new FormData(f) })
        .then(() => window.__sdRefresh())
        .catch(() => window.alert('network error — not saved'));
    }
  });
  // The hover-preview card escaping smartdraft's overflow-clipped panes is
  // now handled shared-side (gripe 56806, ``linkify._anchor_html`` teleports
  // ``.ref-popover`` to <body> and computes its own fixed coords) — no
  // per-page mitigation needed here any more.
  document.addEventListener('keydown', (e) => {
    const t = document.activeElement;
    const inField = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
    if (e.key === 'Escape' && ST.q) { e.preventDefault(); clearSearch(); return; }
    if (e.key === '/' && !inField) {   // focus the search box
      e.preventDefault();
      const box = document.querySelector('input[name="q"]');
      if (box) box.focus();
      return;
    }
    if (inField) return;
    if (e.key === 'p' || e.key === 'P') {   // toggle pin/unpin the focus
      e.preventDefault();
      fetch(`/drafts/${IDENT}/marks`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ op: 'eye', handles: [ST.focus] }),
      }).then(() => window.__sdRefresh());
      return;
    }
    // In search mode the arrows step through the RESULTS (not the outline).
    if (ST.hits && ST.hits.length) {
      let hi = ST.hits.indexOf(ST.focus);
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') hi = hi < 0 ? 0 : Math.min(ST.hits.length - 1, hi + 1);
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') hi = hi < 0 ? 0 : Math.max(0, hi - 1);
      else return;
      e.preventDefault(); jump(ST.hits[hi]); return;
    }
    const ORDER = ST.order || [];
    const i = ORDER.findIndex((o) => o[0] === ST.focus);
    if (i < 0) return;
    const depth = ORDER[i][1];
    let j = -1;
    if (e.key === 'ArrowDown') j = Math.min(ORDER.length - 1, i + 1);
    else if (e.key === 'ArrowUp') j = Math.max(0, i - 1);
    else if (e.key === 'ArrowRight' || (e.key === 'Tab' && !e.shiftKey)) {
      for (let k = i + 1; k < ORDER.length; k++) { if (ORDER[k][1] > depth) { j = k; break; } if (ORDER[k][1] < depth) break; }
    } else if (e.key === 'ArrowLeft' || (e.key === 'Tab' && e.shiftKey)) {
      for (let k = i - 1; k >= 0; k--) { if (ORDER[k][1] < depth) { j = k; break; } }
    } else return;
    if (j >= 0 && j !== i) { e.preventDefault(); jump(ORDER[j][0]); }
  });
})();

// The shared draftEdit/tableEditor components (drafts/_editors.html.j2,
// gripe 56746) save via fetch + a `draft:*` CustomEvent — the classic
// reader's virtual scroller listens and re-hydrates just the affected row;
// smartdraft has no such per-row machinery (each nav is a full-panel
// server render), so it just re-fetches + swaps the whole panel. Covers a
// text save/split/merge/delete/insert and a table save (all dispatch
// `draft:edited`).
['draft:edited', 'draft:split', 'draft:merged', 'draft:removed', 'draft:inserted']
  .forEach((ev) => window.addEventListener(ev, () => window.__sdRefresh()));

// Pin/unpin any chunk (a persistent context eye) — used by the focus header
// and the TOC rows. POSTs the shipped /marks toggle, then swaps in place.
function smartPin(dc) {
  fetch(`/drafts/{{ ident }}/marks`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op: 'eye', handles: [dc] }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
function smartClearPins() {
  fetch(`/drafts/{{ ident }}/marks`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op: 'clear' }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
// Chunk tags (the T search signal). Add/remove refresh so the chip + search reflect it.
function _chunkTag(dc, body) {
  fetch(`/smartdraft/{{ ident }}/chunk-tag`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(Object.assign({ handle: dc }, body)),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
function smartTagAdd(dc, tag) { if (tag && tag.trim()) _chunkTag(dc, { add: tag.trim() }); }
function smartTagRemove(dc, tag) { _chunkTag(dc, { remove: tag }); }
function smartTagInput(dc) {
  return {
    dc, v: '', items: [],
    async suggest() {
      const q = this.v.trim();
      if (q.length < 2) { this.items = []; return; }
      try {
        const r = await fetch(`/smartdraft/{{ ident }}/tag-suggest?q=` + encodeURIComponent(q));
        const d = await r.json();
        this.items = (d.tags || []).filter((t) => t !== this.v);
      } catch (e) { this.items = []; }
    },
    add() { const t = this.v.trim(); if (t) smartTagAdd(this.dc, t); },
  };
}

// The focus para's inline text/table editing is now the shared draftEdit /
// tableEditor Alpine components (drafts/_editors.html.j2, gripe 56746) —
// see the `draft:*` refresh listener above. `smartEdit` (the old
// plain-textarea editor) is retired.

function smartAsk(ident, focus) {
  return {
    ident, focus, text: '', model: 'opus', msg: '',
    async send() {
      if (!this.text.trim()) return;
      this.msg = 'sending…';
      try {
        // `anchor` = the current focus, so with nothing pinned the request still
        // works on the current para + its fisheye (server falls back to it).
        const r = await fetch(`/drafts/${this.ident}/request-ws`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: this.text, model: this.model, anchor: this.focus }),
        });
        const d = await r.json();
        this.msg = d.ok ? 'sent ✓' : ('error: ' + (d.error || ''));
        if (d.ok) this.text = '';
      } catch (e) { this.msg = 'network error'; }
    },
  };
}
</script>

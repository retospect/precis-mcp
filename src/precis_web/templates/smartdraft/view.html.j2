    nodes.forEach((n) => {
      const span = document.createElement('span');
      span.innerHTML = n.nodeValue.replace(re, '<mark class="rounded bg-sky-200 text-inherit">$1</mark>');
      n.parentNode.replaceChild(span, n);
    });
  }
  window.addEventListener('DOMContentLoaded', afterSwap);
  window.addEventListener('popstate', () => swapFrom(location.href));
  // Delegate: any internal /smartdraft link (TOC rows, results, header toggles)
  // and the search form swap #sd-content instead of a full page navigation.
  const INT = 'a[href^="/smartdraft/' + IDENT + '?"]';
  document.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey) return;
    const a = e.target.closest ? e.target.closest('a') : null;
    if (a && a.closest('#sd-content')) {
      // Focus-nav rows carry a short data-dc (not a full URL — that bloated the
      // page ~90 bytes/row over ~2k rows); navTo preserves the current params.
      const dc = a.getAttribute('data-dc');
      if (dc) { e.preventDefault(); navTo(dc); return; }
      // Control links (signal/relevance/view/clear toggles) carry a full slink
      // URL with the changed param — swap to it in place.
      if (a.matches(INT)) {
        e.preventDefault();
        const href = a.getAttribute('href');
        history.pushState({}, '', href);
        swapFrom(href);
        return;
      }
      // Any other in-panel anchor is a citation / cited-source / claim chip
      // (its own <a> with target="_blank") — let it behave normally.
      return;
    }
    // Neighbour-paragraph body: the doc/tail/head blocks are <div data-dc> (NOT
    // <a> — an <a> can't wrap the citation <a>s inside the linkified text, or
    // the parser auto-closes it at the first cite and splits the paragraph).
    // A click anywhere in one that isn't on an inner anchor moves the focus.
    const block = e.target.closest ? e.target.closest('[data-dc]') : null;
    if (block && block.closest('#sd-content')) {
      const dc = block.getAttribute('data-dc');
      if (dc) { e.preventDefault(); navTo(dc); }
    }
  });
  document.addEventListener('submit', (e) => {
    const f = e.target;
    if (!f.matches) return;
    if (f.matches('form[action^="/smartdraft/' + IDENT + '"]')) {
      e.preventDefault();
      const url = f.getAttribute('action') + '?' + new URLSearchParams(new FormData(f)).toString();
      history.pushState({}, '', url);
      swapFrom(url);
      return;
    }
    // Figure add / clearance-edit forms (drafts/_figures.html.j2, gripe
    // 56668) — the SAME endpoints the classic /drafts reader posts to
    // (reused as-is, ADR 0034/0058), but their hardcoded redirect target is
    // the classic reader (`/drafts/{ident}#c-{handle}`). Intercept just
    // these two inside #sd-content and POST via fetch instead, then refresh
    // the panel in place. The "draw" endpoint (mint + open an SVG canvas,
    // `…/figure/{handle}/draw`) is deliberately NOT intercepted — like the
    // classic reader, it's meant to navigate away into /figure.
    const act = f.getAttribute('action') || '';
    const figBase = `/drafts/${IDENT}/figure`;
    const isFigAdd = act === figBase;
    const isFigPermission = act.startsWith(figBase + '/') && act.endsWith('/permission');
    if (f.closest('#sd-content') && (isFigAdd || isFigPermission)) {
      e.preventDefault();
      fetch(act, { method: 'POST', body: new FormData(f) })
        .then(() => window.__sdRefresh())
        .catch(() => window.alert('network error — figure not saved'));
      return;
    }
    // Tools-pane forms that edit in place / start a job. In the classic
    // reader each of these redirects back to `/drafts/{ident}` — a plain
    // submit here would bounce the writer OUT of smartdraft into classic, so
    // (like the figure forms above) POST via fetch and refresh in place. NOT
    // listed: fork + delete, which correctly navigate away (new copy / drafts
    // list). Respect a cancelled confirm — the auto-author toggle's @submit
    // may already have preventDefault()'d when the user declined.
    const inPlace = ['authors', 'workspace', 'authoring', 'export.pdf', 'remarkable', 'review'];
    if (f.closest('#sd-content') && inPlace.some((ep) => act === `/drafts/${IDENT}/${ep}`)) {
      if (e.defaultPrevented) return;
      e.preventDefault();
      fetch(act, { method: 'POST', body: new FormData(f) })
        .then(() => window.__sdRefresh())
        .catch(() => window.alert('network error — not saved'));
    }
  });
  // The hover-preview card escaping smartdraft's overflow-clipped panes is
  // now handled shared-side (gripe 56806, ``linkify._anchor_html`` teleports
  // ``.ref-popover`` to <body> and computes its own fixed coords) — no
  // per-page mitigation needed here any more.
  // ── Spritz-style in-place reader (RSVP) ─────────────────────────────────
  // `R` walks the document word-by-word from the focus onward at a WPM rate,
  // highlighting each word IN PLACE (green box) with its optimal-recognition
  // point (the "pivot" letter) marked red, auto-scrolling to follow. No overlay
  // — it decorates the real rendered text (same TreeWalker idea as highlightTerm)
  // and grows the word stream as full-doc placeholders hydrate ahead of the
  // cursor. Controls while on: R pause/resume · Esc exit · +/- speed · ↑↓
  // paragraph · ←→ sentence · Space next paragraph. Exit re-fetches the panel,
  // which wipes the injected spans.
  const RSVP = { on: false, playing: false, wpm: 300, words: [], idx: 0,
                 cur: null, timer: null, stall: 0 };
  const _esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
  const _pivot = (n) => (n <= 1 ? 0 : n <= 5 ? 1 : n <= 9 ? 2 : n <= 13 ? 3 : 4);  // Spritz table
  function _orpHtml(w) {
    const p = _pivot(w.length);
    return _esc(w.slice(0, p)) + '<b class="rsvp-orp">' + _esc(w[p] || '') + '</b>' + _esc(w.slice(p + 1));
  }
  // Where a block's readable prose lives: the focus's display div, or the block itself.
  const _readEl = (el) => (el.id === 'mid-focus' ? (el.querySelector('.whitespace-pre-wrap') || el) : el);
  const _blockDc = (el) => (el.id === 'mid-focus' ? ST.focus : el.getAttribute('data-dc'));
  // The focus block + every full-text neighbour after it, in reading order.
  function _rsvpBlocks() {
    const mid = document.getElementById('mid-focus');
    if (!mid || !mid.parentElement) return [];
    const els = Array.from(mid.parentElement.querySelectorAll(':scope > #mid-focus, :scope > [data-dc]'));
    const s = els.indexOf(mid);
    return s < 0 ? els : els.slice(s);
  }
  // Wrap each word of a block in a <span> (skipping citation <a>s, math, controls),
  // pushing them onto RSVP.words. Idempotent per block (__rsvpTok guard).
  function _tokenize(el) {
    const target = _readEl(el);
    if (!target || target.__rsvpTok) return false;
    target.__rsvpTok = true;
    const dc = _blockDc(el);
    const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT, {
      acceptNode(n) {
        const p = n.parentNode;
        if (!p || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
        if (['A', 'BUTTON', 'INPUT', 'TEXTAREA', 'SCRIPT', 'STYLE', 'MARK'].includes(p.tagName)) return NodeFilter.FILTER_REJECT;
        if (p.closest && p.closest('.katex')) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      },
    });
    const nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
    let any = false;
    nodes.forEach((n) => {
      const frag = document.createDocumentFragment();
      n.nodeValue.split(/(\s+)/).forEach((part) => {
        if (!part) return;
        if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
        const sp = document.createElement('span');
        sp.className = 'rsvp-w'; sp.textContent = part;
        frag.appendChild(sp);
        RSVP.words.push({ span: sp, dc, sent: 0 });
        any = true;
      });
      n.parentNode.replaceChild(frag, n);
    });
    return any;
  }
  // Re-sort by DOM order (blocks can hydrate out of order) and re-number
  // sentences; keep RSVP.idx pointing just past the current word.
  function _resort() {
    RSVP.words.sort((a, b) =>
      (a.span.compareDocumentPosition(b.span) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1);
    let s = 0;
    RSVP.words.forEach((w) => { w.sent = s; if (/[.!?]["')\]]*$/.test(w.span.textContent)) s++; });
    if (RSVP.cur) { const i = RSVP.words.indexOf(RSVP.cur); if (i >= 0) RSVP.idx = i + 1; }
  }
  // Tokenize freshly-rendered forward blocks; if the next is still a lazy
  // placeholder, scroll it into view to trip the doc-hydrator and report back
  // so tick() waits for it.
  function _grow() {
    let added = false, sawPh = false;
    for (const el of _rsvpBlocks()) {
      if (el.hasAttribute && el.hasAttribute('data-ph')) { sawPh = true; el.scrollIntoView({ block: 'center' }); break; }

  }
  document.addEventListener('keydown', (e) => {
    const t = document.activeElement;
    const inField = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
    // The reader owns the keyboard while it's on (unless you're typing in a field).
    if (RSVP.on && !inField) { rsvpKey(e); return; }
    if (e.key === 'Escape' && ST.q) { e.preventDefault(); clearSearch(); return; }
    if (e.key === '/' && !inField) {   // focus the search box
      e.preventDefault();
      const box = document.querySelector('input[name="q"]');
      if (box) box.focus();
      return;
    }
    if (inField) return;
    if (e.key === 'r' || e.key === 'R') { e.preventDefault(); rsvpStart(); return; }   // start the reader
    // i / Enter → open the focus block's inline editor (Esc leaves it, via ProseMirror).
    if (e.key === 'i' || e.key === 'Enter') {
      // Enter must not double-fire on a deliberately focused link/button.
      if (e.key === 'Enter' && t && t !== document.body) return;
      const ed = window.__dEditors && window.__dEditors[ST.focusHandle];
      if (ed && !ed.editing) { e.preventDefault(); ed.startEdit(); return; }
      if (e.key === 'i') { e.preventDefault(); return; }   // no editable focus → swallow
    }
    if (e.key === 'p' || e.key === 'P') {   // toggle pin/unpin the focus
      e.preventDefault();
      fetch(`/drafts/${IDENT}/marks`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ op: 'eye', handles: [ST.focus] }),
      }).then(() => window.__sdRefresh());
      return;
    }
    // In search mode the arrows step through the RESULTS (not the outline).
    if (ST.hits && ST.hits.length) {
      let hi = ST.hits.indexOf(ST.focus);
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') hi = hi < 0 ? 0 : Math.min(ST.hits.length - 1, hi + 1);
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') hi = hi < 0 ? 0 : Math.max(0, hi - 1);
      else return;
      e.preventDefault(); jump(ST.hits[hi]); return;
    }
    const ORDER = ST.order || [];
    const i = ORDER.findIndex((o) => o[0] === ST.focus);
    if (i < 0) return;
    const depth = ORDER[i][1];
    let j = -1;
    if (e.key === 'ArrowDown') j = Math.min(ORDER.length - 1, i + 1);
    else if (e.key === 'ArrowUp') j = Math.max(0, i - 1);
    else if (e.key === 'ArrowRight' || (e.key === 'Tab' && !e.shiftKey)) {
      for (let k = i + 1; k < ORDER.length; k++) { if (ORDER[k][1] > depth) { j = k; break; } if (ORDER[k][1] < depth) break; }
    } else if (e.key === 'ArrowLeft' || (e.key === 'Tab' && e.shiftKey)) {
      for (let k = i - 1; k >= 0; k--) { if (ORDER[k][1] < depth) { j = k; break; } }
    } else return;
    if (j >= 0 && j !== i) { e.preventDefault(); jump(ORDER[j][0]); }
  });
})();

// The shared draftEdit/tableEditor components (drafts/_editors.html.j2,
// gripe 56746) save via fetch + a `draft:*` CustomEvent — the classic
// reader's virtual scroller listens and re-hydrates just the affected row;
// smartdraft has no such per-row machinery (each nav is a full-panel
// server render), so it just re-fetches + swaps the whole panel. Covers a
// text save/split/merge/delete/insert and a table save (all dispatch
// `draft:edited`).
['draft:edited', 'draft:split', 'draft:merged', 'draft:removed', 'draft:inserted']
  .forEach((ev) => window.addEventListener(ev, () => window.__sdRefresh()));

// Pin/unpin any chunk (a persistent context eye) — used by the focus header
// and the TOC rows. POSTs the shipped /marks toggle, then swaps in place.
function smartPin(dc) {
  fetch(`/drafts/{{ ident }}/marks`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op: 'eye', handles: [dc] }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
function smartClearPins() {
  fetch(`/drafts/{{ ident }}/marks`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op: 'clear' }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
// Human sign-off ✓ (migration-0086 ledger) — POSTs the shared /human-review
// JSON endpoint (reused as-is from the classic reader) then refreshes the
// panel so the ✓ re-renders its on/dirty state from the ledger.
function smartReview(dc) {
  fetch(`/drafts/{{ ident }}/human-review`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ dc }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
// Chunk tags (the T search signal). Add/remove refresh so the chip + search reflect it.
function _chunkTag(dc, body) {
  fetch(`/smartdraft/{{ ident }}/chunk-tag`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(Object.assign({ handle: dc }, body)),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
function smartTagAdd(dc, tag) { if (tag && tag.trim()) _chunkTag(dc, { add: tag.trim() }); }
function smartTagRemove(dc, tag) { _chunkTag(dc, { remove: tag }); }
function smartTagInput(dc) {
  return {
    dc, v: '', items: [],
    async suggest() {
      const q = this.v.trim();
      if (q.length < 2) { this.items = []; return; }
      try {
        const r = await fetch(`/smartdraft/{{ ident }}/tag-suggest?q=` + encodeURIComponent(q));
        const d = await r.json();
        this.items = (d.tags || []).filter((t) => t !== this.v);
      } catch (e) { this.items = []; }
    },
    add() { const t = this.v.trim(); if (t) smartTagAdd(this.dc, t); },
  };
}

// The focus para's inline text/table editing is now the shared draftEdit /
// tableEditor Alpine components (drafts/_editors.html.j2, gripe 56746) —
// see the `draft:*` refresh listener above. `smartEdit` (the old
// plain-textarea editor) is retired.

function smartAsk(ident, focus) {
  return {
    ident, focus, text: '', model: 'opus', msg: '',
    async send() {
      if (!this.text.trim()) return;
      this.msg = 'sending…';
      try {
        // `anchor` = the current focus, so with nothing pinned the request still
        // works on the current para + its fisheye (server falls back to it).
        const r = await fetch(`/drafts/${this.ident}/request-ws`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text: this.text, model: this.model, anchor: this.focus }),
        });
        const d = await r.json();
        this.msg = d.ok ? 'sent ✓' : ('error: ' + (d.error || ''));
        if (d.ok) this.text = '';
      } catch (e) { this.msg = 'network error'; }
    },
  };
}
</script>

  }
  function rsvpJumpPara(dir) {
    if (!RSVP.words.length) return;
    const i = _curIdx(), dc = RSVP.words[i].dc;
    if (dir > 0) {
      let j = i; while (j < RSVP.words.length && RSVP.words[j].dc === dc) j++;
      if (j >= RSVP.words.length) { _grow(); while (j < RSVP.words.length && RSVP.words[j].dc === dc) j++; }

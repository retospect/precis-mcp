  }
  function _decorate(sp) { sp.classList.add('rsvp-cur'); sp.dataset.w = sp.textContent; sp.innerHTML = _orpHtml(sp.textContent); }
  function _undecorate(sp) { sp.classList.remove('rsvp-cur'); if (sp.dataset.w != null) sp.textContent = sp.dataset.w; }
  function _scrollWord(sp) { const r = sp.getBoundingClientRect(); if (r.top < 100 || r.bottom > window.innerHeight - 100) sp.scrollIntoView({ block: 'center' }); }

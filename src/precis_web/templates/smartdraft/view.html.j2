  function rsvpJumpSent(dir) {
    if (!RSVP.words.length) return;
    const i = _curIdx(), s = RSVP.words[i].sent;
    if (dir > 0) { let j = i; while (j < RSVP.words.length && RSVP.words[j].sent === s) j++; _rsvpShow(Math.min(j, RSVP.words.length - 1)); }
    else { let j = i; while (j > 0 && RSVP.words[j].sent === s) j--; const ps = RSVP.words[j].sent; while (j > 0 && RSVP.words[j - 1].sent === ps) j--; _rsvpShow(j); }
  }
  function rsvpWpm(d) { RSVP.wpm = Math.max(100, Math.min(1000, RSVP.wpm + d)); _rsvpHud(); }
  function rsvpToggle() {
    if (RSVP.playing) { RSVP.playing = false; clearTimeout(RSVP.timer); RSVP.timer = null; _rsvpHud(); }

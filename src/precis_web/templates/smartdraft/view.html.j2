{% extends "base.html.j2" %}
{% block title %}{{ ref.title }} — smartdraft{% endblock %}
{% block content %}
{# The shared draftEdit/tableEditor Alpine components + ProseMirror mount
   (gripe 56746) — same macros the classic /drafts reader uses, so smartdraft
   gets the rich in-place editor (incl. `[`-citation autocomplete) and the
   table grid editor. #}
{% import "drafts/_editors.html.j2" as draft_editors %}
{# Shared figure media render + clearance badge + upload form (gripe 56668)
   — same drafts/_figures.html.j2 the classic /drafts reader uses, so a
   figure looks and behaves identically in both readers. #}
{% import "drafts/_figures.html.j2" as draft_figures %}
{# Shared full-document reading-block macro (also used by the /blocks lazy
   hydrate endpoint) so an on-scroll-hydrated block matches the initial render. #}
{% import "smartdraft/_block.html.j2" as sd_block %}
{# Structured LLM selector (tier × placement × reasoning × temperature) +
   live preview — the ask toolbar's model picker. #}
{% import "_llm_selector.html.j2" as llm_selector %}
{# One URL builder for the whole panel — every control overrides one param.
   Params are to_* so they don't shadow the render-context globals they
   default to (a macro can't see template-level {% set %} vars). #}
{% macro slink(to_focus=None, to_q=None, to_sig=None, to_view=None, to_rel=None, to_debug=None) -%}
/smartdraft/{{ ident }}?focus={{ to_focus if to_focus is not none else focus_dc }}&relevance={{ '1' if (to_rel if to_rel is not none else relevance) else '0' }}&q={{ (to_q if to_q is not none else q) | urlencode }}&sig={{ to_sig if to_sig is not none else active_sig }}&sview={{ to_view if to_view is not none else sview }}&debug={{ '1' if (to_debug if to_debug is not none else debug) else '0' }}
{%- endmacro %}
{% macro qs(dc) %}{{ slink(to_focus=dc) }}{% endmacro %}

{# The per-block review indicator + dropdown
   is now the shared ``sd_block.sd_review_widget`` macro
   (``smartdraft/_block.html.j2``, imported above as ``sd_block``) — it
   replaces both the old focus-only ✓ button and the heading-only
   ``review ▾`` menu (whose ``structural``/``deep_review`` vocabulary no
   longer matches the ledger's checker names), so the same widget renders
   identically on the focus, every full-document block, and a ``/blocks``
   hydration. The toolbar rollup badge below is this page's own macro (it
   isn't shared with the block partial). #}

{# Toolbar rollup badge (item 8) — ``N/M`` prose-chunks-reviewed, green
   "review-complete" once N == M > 0. Its dropdown: per-checker counts
   (``checker_counts``, derived from the SAME single status fetch the
   per-block indicators use — no extra query), the taproot hub-coverage +
   citation-lifecycle scoreboard (item 5a, ``hub_stats`` — reused, not
   reimplemented, from ``_hygiene_lines``'s / ``_citations_view``'s own
   computations), the deterministic document-shape stats (item 10,
   ``shape_stats``), and two actions: "run outstanding checks" (the
   incremental whole-draft fanout) and "run toc review" (the document-
   altitude lens). Per-heading rollup counts in the TOC pane are skipped —
   ``_section_chunk_id`` only gives the NEAREST heading, so a recursive
   nested-subtree total isn't derivable from the one status fetch without
   re-walking the tree per heading; not worth the extra pass for a
   secondary display. #}
{% macro sd_review_badge(ident, rollup, checker_counts, hub_stats, shape_stats) %}
{% set complete = rollup.total > 0 and rollup.done >= rollup.total %}
<div class="relative" x-data="{ open: false }" @click.outside="open = false">
  <button type="button" @click="open = !open"
          title="{{ rollup.done }}/{{ rollup.total }} prose blocks human-reviewed{% if complete %} — review-complete{% endif %}"
          class="sd-badge-rollup rounded border px-1.5 py-0.5 font-semibold{% if complete %} complete{% endif %}">{{ rollup.done }}/{{ rollup.total }}{% if complete %} ✓{% endif %}</button>
  <div x-show="open" x-cloak class="sd-review-menu absolute right-0 z-30 mt-1 w-80 rounded border border-slate-200 bg-white p-2 text-left shadow-lg">
    <div class="mb-1 font-semibold text-slate-600">Review — {{ rollup.done }}/{{ rollup.total }}{% if complete %} · review-complete{% endif %}</div>
    <table class="mb-2 w-full">
      {% for checker, c in checker_counts.items() %}
      <tr><td class="pr-2 text-slate-500">{{ checker }}</td><td class="pr-1">{{ c.current }} ✓</td><td class="pr-1">{{ c.stale }} ⚠</td><td>{{ c.never }} –</td></tr>
      {% endfor %}
    </table>
    <div class="mb-1 border-t border-slate-100 pt-1">
      <a href="/console?verb=get&args_text={{ ('kind=draft id=' ~ ident ~ ' view=citations') | urlencode }}"
         target="_blank" rel="noopener" class="text-sky-700 hover:underline">
        hub: {{ hub_stats.hub_grounded }}/{{ hub_stats.hub_total }} grounded · to-fetch {{ hub_stats.lifecycle.get('to-fetch', 0) }} ·
        to-re-ground {{ hub_stats.lifecycle.get('to-re-ground', 0) }} · to-promote {{ hub_stats.lifecycle.get('to-promote', 0) }} · done {{ hub_stats.lifecycle.get('done', 0) }}
      </a>
    </div>
    <div class="mb-1 border-t border-slate-100 pt-1 text-slate-500">
      {{ shape_stats.total_words }} words over {{ shape_stats.n_sections }} section(s){% if shape_stats.flagged %} — {{ shape_stats.flagged | length }} off target{% endif %}.
      <div class="italic text-slate-400">{{ shape_stats.scaffold_note }}</div>
    </div>
    <div class="flex items-center gap-3 border-t border-slate-100 pt-1">
      <button type="button" @click="open = false" onclick="sdReviewAllOutstanding()" class="text-sky-700 hover:underline">run outstanding checks</button>
      <button type="button" @click="open = false" onclick="sdReviewToc()" class="text-sky-700 hover:underline">run toc review</button>
    </div>
  </div>
</div>
{% endmacro %}

{# one kept-body / collapsed-run row under a heading section (the fisheye detail
   layer). q/focus_dc/debug are render-context globals a macro can see; hit_dcs
   is a template {% set %} so it must be passed in. #}
{% macro toc_body_row(row, hit_dcs) %}
{%- if row.collapsed_nodes -%}
  {% set first = row.collapsed_nodes[0] %}
  {% set _peek = row.collapsed_nodes[:8] | map(attribute='summary') | join('\n') %}
  <a href="?focus={{ first.dc }}" data-dc="{{ first.dc }}"
     title="{{ _peek }}{% if row.collapsed_nodes|length > 8 %}
… +{{ row.collapsed_nodes|length - 8 }} more{% endif %}"
     class="sd-collapse">⋯ {{ row.collapsed_nodes|length }} paras ⋯</a>
{%- else -%}
  {% set n = row.node %}
  <a id="toc-{{ n.dc }}" href="?focus={{ n.dc }}" data-dc="{{ n.dc }}"
     style="padding-left: {{ 0.4 + n.depth * 0.6 }}rem"
     class="sd-row{% if q and n.dc in hit_dcs %} sd-hit{% elif n.dc == focus_dc %} sd-focus{% elif row.shared %} sd-shared{% elif row.pressure >= 0.4 %} sd-hot{% endif %}">
    {%- if n.provenance %}<span class="sd-dot sd-dot-{{ n.provenance }}" title="{{ sd_block.prov_title(n.provenance) }}"></span>{% endif -%}
    <span class="sd-btext">{% if debug %}<span class="sd-dc">{{ n.dc }}</span> {% endif %}· {{ n.summary }}</span>
    <span class="sd-badge">{%- if row.shared %}<span title="shares a keyword with the focus">🔑</span>{% endif -%}{%- if n.pinned %}📌{% endif -%}{%- if n.locked %}🔒{% endif -%}</span>
  </a>
{%- endif -%}
{% endmacro %}

{# A run of consecutive glossary-term rows (``ChunkNode.is_term`), folded
   into one ``<details>`` — a draft glossary tail otherwise reads as an
   unbroken run of ordinary always-visible TOC rows. Styled with the same
   ``sd-sec``/``sd-sum``/``sd-tw``/``sd-htext`` idiom the heading-outline
   ``<details>`` above uses, so it reads as "one more foldable section", not
   a bespoke widget. Open only when the focus (or, with an active search, a
   hit) is one of the grouped terms — closed otherwise, since a long
   glossary run is exactly the kind of thing you want out of the way by
   default. #}
{% macro term_group(rows, hit_dcs) %}
{%- set ns = namespace(open=false) -%}
{%- for row in rows -%}
  {%- if row.node.dc == focus_dc or (q and row.node.dc in hit_dcs) -%}{% set ns.open = true %}{%- endif -%}
{%- endfor %}
<details {% if ns.open %}open{% endif %} class="sd-sec">
  <summary class="sd-sum">
    <span class="sd-tw">▸</span>
    <span class="sd-htext">Abbreviations ({{ rows | length }})</span>
  </summary>
  {% for row in rows %}{{ toc_body_row(row, hit_dcs) }}{% endfor %}
</details>
{%- endmacro %}

{# Renders one section's body rows, folding any consecutive run of term rows
   (see ``term_group`` above) into a single collapsible group instead of a
   sequence of ordinary rows — the wrapper both ``sec.body`` loop sites
   (heading sections and the pre-first-heading fallback) share. #}
{% macro toc_body_rows(rows, hit_dcs) %}
{%- set ns = namespace(run=[]) -%}
{%- for row in rows -%}
  {%- if row.node is not none and row.node.is_term -%}
    {%- set ns.run = ns.run + [row] -%}
  {%- else -%}
    {%- if ns.run -%}{{ term_group(ns.run, hit_dcs) }}{% set ns.run = [] %}{%- endif -%}
    {{ toc_body_row(row, hit_dcs) }}
  {%- endif -%}
{%- endfor -%}
{%- if ns.run -%}{{ term_group(ns.run, hit_dcs) }}{%- endif -%}
{% endmacro %}

<style>
  /* Named classes for the high-count outline/TOC rows — each replaces ~350
     chars of repeated Tailwind utilities, so a 1897-heading draft's response
     drops from megabytes of class attributes to a few named hooks. Colours are
     the Tailwind slate/sky/amber/emerald values these rows used verbatim. */
  details.sd-sec > summary.sd-sum { list-style: none; cursor: pointer; }
  details.sd-sec > summary.sd-sum::-webkit-details-marker { display: none; }
  .sd-sum, .sd-row { display: flex; align-items: flex-start; gap: .25rem;
    padding-top: .125rem; padding-bottom: .125rem; padding-right: .5rem; }
  .sd-sum:hover, .sd-row:hover { background: #f8fafc; }          /* slate-50 */
  .sd-focus { background: #fffbeb; box-shadow: inset 0 0 0 1px #fbbf24; } /* amber-50 + ring-400 */
  .sd-hit { background: #e0f2fe; }                               /* sky-100 */
  .sd-shared { background: #ecfdf5; }                            /* emerald-50 */
  .sd-hot { background: #f0f9ff; }                               /* sky-50 */
  .sd-tw { flex-shrink: 0; margin-top: .125rem; width: .5rem; font-size: 9px;
    color: #94a3b8; transition: transform .1s; }
  details.sd-sec[open] > summary.sd-sum .sd-tw { transform: rotate(90deg); }
  .sd-htext, .sd-btext { min-width: 0; flex: 1 1 0%; overflow: hidden;
    text-overflow: ellipsis; white-space: nowrap; }
  .sd-htext { font-weight: 600; color: #1e293b; }               /* slate-800 */
  .sd-htext:hover { color: #0369a1; }                           /* sky-700 */
  .sd-btext { color: #475569; }                                 /* slate-600 */
  .sd-collapse { display: block; padding: .125rem .5rem; color: #cbd5e1; }
  .sd-collapse:hover { background: #f8fafc; color: #64748b; }
  .sd-badge { flex-shrink: 0; font-size: 10px; }
  .sd-dc { font-family: ui-monospace, monospace; font-size: 9px; color: #0ea5e9; }
  /* Per-block review indicator — a
     4-state dot: grey = checks outstanding, hollow-blue = machine-green
     (awaiting human), emerald = human-approved, amber = human-approved but
     edited since. A trailing red "!" (::after) marks the deterministic
     citation-integrity flag (item 5c) — orthogonal to the ledger state, so
     it never overrides the dot's own colour. Claim-trust overlay
     (the trust-surfaces editor badges, same ::after slot), quietest→loudest:
     "Ⓐ" red for an abstract-only cite, "✍" calm slate for an author-vouched
     one (both the softer states an unacquirable-override folds to), "?"
     amber for unverified, "‼" red+bold for unsupported — ALL applicable
     overlay classes are added to a block (see _block.html.j2), and since
     only one ::after can render, source order here (not template logic)
     picks the winner when several apply:
     unsupported > integrity-fail > unverified > vouched > abstract,
     loudest-last. */
  .sd-review { cursor: pointer; }
  .sd-review-dot { line-height: 1; font-size: 13px; vertical-align: middle; }
  .sd-review-dot.empty { color: #cbd5e1; }    /* slate-300 */
  .sd-review-dot.machine { color: #38bdf8; }  /* sky-400 — hollow/machine-green */
  .sd-review-dot.human { color: #059669; }    /* emerald-600 */
  .sd-review-dot.dirty { color: #d97706; }    /* amber-600 */
  /* Softer-than-⚠ overlays, quietest first so a louder co-applied overlay
     (integrity/unsupported, further down) wins by source order. */
  .sd-review-dot.sd-trust-abstract::after { content: "Ⓐ"; color: #dc2626; }  /* abstract-only — red circled A (red per Reto; not bold, so it reads lighter than the ‼ contradiction mark) */
  .sd-review-dot.sd-trust-vouched::after { content: "✍"; color: #64748b; }  /* author-vouched — calm slate-500 */
  .sd-review-dot.sd-trust-unverified::after { content: "?"; color: #d97706; font-weight: 700; }  /* amber-600 */
  .sd-review-dot.sd-integrity::after { content: "!"; color: #dc2626; font-weight: 700; }
  .sd-review-dot.sd-trust-unsupported::after { content: "‼"; color: #dc2626; font-weight: 700; }
  .sd-review-menu { white-space: normal; }
  /* Toolbar rollup badge (item 8) — N/M, emerald "review-complete" at N=M>0. */
  .sd-badge-rollup { border: 1px solid #e2e8f0; color: #64748b; }         /* slate-200/500 */
  .sd-badge-rollup.complete { border-color: #6ee7b7; background: #ecfdf5; color: #047857; } /* emerald-300/50/700 */
  /* Spritz reader (RSVP, key: R): the current word gets a green box + a red
     ORP pivot letter, decorated in place over the real text; auto-scroll keeps
     it centred. #rsvp-hud is the fixed control-hint pill. */
  .rsvp-cur { background: #dcfce7; border-radius: 2px;
    box-shadow: inset 0 -0.18em 0 #22c55e; padding: 0 1px; }   /* emerald-100 + green-500 bar */
  .rsvp-orp { color: #dc2626; font-weight: 700; }              /* red-600 pivot */
  #rsvp-hud { position: fixed; left: 50%; bottom: 1rem; transform: translateX(-50%);
    z-index: 60; padding: .35rem .8rem; border-radius: 9999px; font-size: 11px;
    background: rgba(15, 23, 42, .92); color: #e2e8f0; white-space: nowrap;
    box-shadow: 0 4px 14px rgba(0, 0, 0, .25); pointer-events: none; }
  /* Per-paragraph grounding provenance (a corpus cite / a chased finding /
     nothing) — a subtle left border in the middle reading pane, a small
     dot in the left TOC. Colours: emerald/amber/rose, matching the
     existing sd-focus amber-400 idiom above. */
  .sd-prov-sourced { border-left: 3px solid #16a34a; }
  .sd-prov-pending { border-left: 3px solid #d97706; }
  .sd-prov-unsourced { border-left: 3px solid #dc2626; }
  .sd-dot { display: inline-block; width: .4rem; height: .4rem; flex-shrink: 0;
    border-radius: 9999px; margin: .25rem .1rem 0 0; }
  .sd-dot-sourced { background: #16a34a; }
  .sd-dot-pending { background: #d97706; }
  .sd-dot-unsourced { background: #dc2626; }
  /* Diamond ↔ Claims-rail sync:
     hovering either the prose ◆ or its rail chip highlights BOTH — every
     element sharing the same data-claim-head. sd-claim-flash is the
     one-shot "there it is" pulse a click's scroll-to-counterpart adds. */
  .sd-claim-hl { background: #ede9fe; box-shadow: inset 0 0 0 1px #a78bfa; border-radius: .2rem; } /* violet-100 + violet-400 ring */
  .sd-claim-flash { animation: sd-claim-pulse .9s ease-out; border-radius: .2rem; }
  @keyframes sd-claim-pulse {
    0% { background: #c4b5fd; }   /* violet-300 */
    100% { background: transparent; }
  }
</style>

{# KaTeX — same client-side $…$ / $$…$$ math render the classic /drafts reader
   used (since retired), so smartdraft renders LaTeX ($sp^3$, reactions) too.
   mhchem registers \ce{}/\pu{}; auto-render's onload fires the initial pass
   over #sd-content, and afterSwap() re-runs it after every no-reload nav. #}
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.css" />
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/katex.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/mhchem.min.js"></script>
<script defer src="https://cdn.jsdelivr.net/npm/katex@0.16.9/dist/contrib/auto-render.min.js"
  onload="window.__sdRenderMath && window.__sdRenderMath()"></script>

{# ProseMirror mount (window.__mountDraftPM) + the global draftEdit/
   tableEditor Alpine factories + their CSS — loaded ONCE here, OUTSIDE
   #sd-content, so a no-reload nav swap (swapFrom, below) never re-imports the
   ES module or redefines the globals; only the macro-rendered markup inside
   #sd-content is replaced + re-initialized via Alpine.initTree. #}
{% include "drafts/_editors.html.j2" %}

{# ── Document header — small by default, big on demand ──────────────────
     SMALL (default): the title plus a chip row of the few facts worth
     having while reading — genre, ⚑ concerns filed against the document,
     last-touched. Same one-line footprint the bare <h1> had.

     BIG (`open`): drops the full metadata panel — identity, every
     document-level edge, and the whole of the ref's `meta` — over the
     content. None of that had a surface here before: `_ref_view` used to
     flatten the ref to {id, title} and drop the rest, so e.g. an
     `audio_failed_at` sat invisible on every brief whose narration failed.

     Lives OUTSIDE `#sd-content` (like the h1 it replaces) because it is
     document-level and must survive the no-reload focus swap that repaints
     the panes. That also means the shared submit-intercept — which only
     watches `#sd-content` — does not see the rename form, so it is wired by
     hand in `sdHeader()` below. `open` persists in localStorage: some focus
     navigations are full page loads, and a panel that slammed shut on each
     one would be good for a single glance and nothing else. #}
<div class="mb-2" x-data="sdHeader()">

  <div class="flex items-center gap-2">
    <button @click="toggle()" class="shrink-0 text-slate-400 hover:text-slate-700"
            :title="open ? 'hide document metadata' : 'show document metadata'"
            x-text="open ? '▾' : '▸'">▸</button>

    {# Title — ✎ or double-click to rename in place. The box is seeded from
       the CURRENT h1 text, not the server-rendered value, so a second
       rename in the same session edits what's on screen. #}
    <h1 x-show="!editing" id="sd-title" class="min-w-0 truncate text-base font-semibold"
        @dblclick="startEdit()">{{ ref.title }}</h1>
    <button x-show="!editing" @click="startEdit()"
            class="shrink-0 text-[11px] text-slate-300 hover:text-sky-700"
            title="rename this draft (writes both the ref title and the document's title heading)">✎</button>
    <form x-show="editing" x-cloak @submit.prevent="save()" class="flex min-w-0 flex-1 items-center gap-1">
      <input x-ref="titleBox" x-model="draftTitle" @keydown.escape="editing = false"
             class="min-w-0 flex-1 rounded border border-sky-400 px-2 py-0.5 text-base font-semibold focus:outline-none">
      <button type="submit" class="shrink-0 rounded bg-sky-600 px-2 py-0.5 text-[11px] font-semibold text-white">save</button>
      <button type="button" @click="editing = false"
              class="shrink-0 text-[11px] text-slate-400 hover:text-slate-700">cancel</button>
    </form>
    <span x-show="err" x-cloak x-text="err" class="shrink-0 text-[11px] text-rose-600"></span>

    {# Only what's actually set — a bare draft still reads as one clean line. #}
    <div class="ml-1 flex shrink-0 items-center gap-2 text-[11px] text-slate-500">
      {% if cur_doctype %}<span class="rounded bg-slate-100 px-1.5 py-0.5">{{ cur_doctype }}</span>{% endif %}
      {% if concern_count %}
      <button @click="openTo()" class="rounded bg-amber-100 px-1.5 py-0.5 font-semibold text-amber-800 hover:bg-amber-200"
              title="findings filed against this document — open the metadata panel">⚑ {{ concern_count }}</button>
      {% endif %}
      {% if ref.updated_at %}
      <span title="last changed {{ ref.updated_at | abs_ts }}">{{ ref.updated_at | ago }}</span>
      {% endif %}
    </div>

    <div class="ml-auto flex shrink-0 items-center gap-3 text-[11px] text-slate-500">
      <span title="paragraph grounding: 🟢 sourced (cites a corpus paper/patent) · 🟡 pending (cites a finding — source still being chased) · 🔴 unsourced (no citation)">🟢 sourced · 🟡 pending · 🔴 unsourced</span>
      {{ sd_review_badge(ident, rollup, checker_counts, hub_stats, shape_stats) }}
      <a href="/nanopub?draft=dr{{ ref.id }}" class="hover:text-slate-800"
         title="the /nanopub workbench, scoped to the claim hubs this draft cites — review &amp; sign what's left">review claims</a>
      <a href="{{ slink(to_debug=(not debug)) }}" class="{% if debug %}text-sky-700{% else %}hover:text-slate-800{% endif %}" title="show chunk ids (debug)">ids</a>
    </div>
  </div>

  <div x-show="open" x-cloak class="mt-2 rounded border border-slate-200 bg-white p-3 text-xs">
    <div class="grid grid-cols-1 gap-x-6 gap-y-3 md:grid-cols-3">

      <div>
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Identity</div>
        <table class="w-full">
          <tr><td class="pr-2 align-top text-slate-500">handle</td>
              <td class="font-mono text-slate-700">{{ ref.slug or ref.id }}</td></tr>
          <tr><td class="pr-2 align-top text-slate-500">ref</td>
              <td class="font-mono text-slate-700">{{ ref.kind }}:{{ ref.id }}</td></tr>
          {% if ref.created_at %}
          <tr><td class="pr-2 align-top text-slate-500">created</td>
              <td class="text-slate-700" title="{{ ref.created_at | abs_ts }}">{{ ref.created_at | ago }}</td></tr>
          {% endif %}
          {% if ref.updated_at %}
          <tr><td class="pr-2 align-top text-slate-500">updated</td>
              <td class="text-slate-700" title="{{ ref.updated_at | abs_ts }}">{{ ref.updated_at | ago }}</td></tr>
          {% endif %}
        </table>
        {% if ref_tags %}
        <div class="mt-1 flex flex-wrap gap-1">
          {% for t in ref_tags %}
          <span class="rounded bg-slate-100 px-1 py-0.5 font-mono text-[10px] text-slate-600">{{ t }}</span>
          {% endfor %}
        </div>
        {% endif %}
      </div>

      {# Whole-document edges. Concerns lead (see `_REL_PRIORITY`) — a
         finding filed against the document is the one you'd act on. #}
      <div>
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Connections</div>
        {% if ref_conns %}
        <div class="space-y-1">
          {% for g in ref_conns %}
          <div class="{% if g.relation == 'raises-concern-about' %}rounded bg-amber-50 p-1{% endif %}">
            <span class="text-slate-500">{{ '←' if g.direction == 'in' else '→' }} {{ g.relation }}</span>
            <span class="text-slate-400">({{ g.total }})</span>
            {# Every edge is here; height is bounded by the box, so a briefing's
               24-paper bibliography scrolls instead of being truncated to a
               count. The odd max-height clips the last row mid-chip on purpose
               — a region that ends flush reads as ended. `tabindex` so it's
               scrollable without a mouse. #}
            <div class="mt-0.5 flex max-h-[4.5rem] flex-wrap gap-1 overflow-y-auto"
                 tabindex="0">
              {% for chip in g.chips %}{{ chip }}{% endfor %}
            </div>
          </div>
          {% endfor %}
        </div>
        {% else %}
        <div class="text-slate-400">No document-level links.</div>
        {% endif %}
      </div>

      {# Every key on the ref. An unknown key renders under its raw name
         (monospace) rather than being dropped — see `_doc_meta`. #}
      <div>
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Meta</div>
        {% if doc_meta %}
        <table class="w-full">
          {% for m in doc_meta %}
          <tr class="{% if m.warn %}text-amber-700{% endif %}">
            <td class="w-1/3 pr-2 align-top {% if m.raw %}font-mono text-[10px] {% endif %}text-slate-500">{{ m.label }}</td>
            <td class="align-top break-words {% if m.warn %}font-semibold{% else %}text-slate-700{% endif %}"
                title="{{ m.value }}">{{ m.value | truncate(160) }}</td>
          </tr>
          {% endfor %}
        </table>
        {% else %}
        <div class="text-slate-400">No metadata stamped.</div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script>
  function sdHeader() {
    return {
      // The draft's ident, rendered into THIS script. The nav script below
      // has its own `IDENT`, but it's a `const` inside that script's IIFE —
      // invisible out here. Reaching for it threw a ReferenceError inside
      // `save()`, and since `@submit.prevent` had already eaten the native
      // submit, the rename was a silent no-op (nothing saved, no message).
      ident: {{ ident | tojson }},
      // Persisted — the panel must not slam shut on every focus navigation.
      open: localStorage.getItem('sd:meta:open') === '1',
      editing: false,
      draftTitle: '',
      err: '',
      toggle() {
        this.open = !this.open;
        localStorage.setItem('sd:meta:open', this.open ? '1' : '0');
      },
      openTo() {
        if (!this.open) this.toggle();
      },
      startEdit() {
        this.err = '';
        this.draftTitle = (document.getElementById('sd-title') || {}).textContent || '';
        this.editing = true;
        this.$nextTick(() => this.$refs.titleBox && this.$refs.titleBox.select());
      },
      save() {
        const next = (this.draftTitle || '').trim();
        if (!next) { this.err = 'title required'; return; }
        const body = new FormData();
        body.append('title', next);
        fetch(`/drafts/${this.ident}/title`, { method: 'POST', body })
          // A refusal is not JSON: the auth gate answers text/plain (a
          // cross-site 403, a 401 from an expired login), so `r.json()`
          // alone would reject and the catch below would blame the
          // network. Read text, parse if it parses, report the status.
          .then((r) => r.text().then((t) => {
            let j = null;
            try { j = JSON.parse(t); } catch (e) { /* not JSON — see below */ }
            return { ok: r.ok, status: r.status, j: j || {} };
          }))
          .then(({ ok, status, j }) => {
            if (!ok || !j.ok) {
              this.err = j.error || `rename failed (HTTP ${status})`;
              return;
            }
            // Patch the h1 here — the header sits outside #sd-content, so
            // __sdRefresh will not repaint it. The title HEADING chunk did
            // change server-side, though, so the panes still need refreshing.
            const h1 = document.getElementById('sd-title');
            if (h1) h1.textContent = j.title;
            document.title = j.title;
            this.editing = false;
            this.err = '';
            if (window.__sdRefresh) window.__sdRefresh();
          })
          .catch(() => { this.err = 'network error'; });
      },
    };
  }
</script>

<div id="sd-content" class="grid grid-cols-1 items-start gap-3 lg:grid-cols-[28%_44%_28%]">

  {# ── LEFT: fisheye TOC nav (sticky sidebar; the middle flows so its
       hover-preview popovers aren't clipped by an overflow container) ── #}
  <div class="sticky top-2 self-start rounded border border-slate-200 bg-white">
    {# header: search + signal toggles + fisheye/full + results view #}
    <div class="space-y-1.5 border-b border-slate-100 p-2">
      <form method="get" action="/smartdraft/{{ ident }}">
        <input type="hidden" name="focus" value="{{ focus_dc }}">
        <input type="hidden" name="relevance" value="{{ '1' if relevance else '0' }}">
        <input type="hidden" name="sig" value="{{ active_sig }}">
        <input type="hidden" name="sview" value="{{ sview }}">
        <input name="q" value="{{ q }}" placeholder="search…" autocomplete="off"
               class="w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none">
      </form>
      <div class="flex items-center gap-1">
        {% for s in [('v','verbatim text'),('k','keywords'),('t','tags'),('s','semantic (embedding)')] %}
        {% set on = s[0] in active_sig %}
        {% set nsig = (active_sig|replace(s[0],'')) if on else (active_sig ~ s[0]) %}
        <a href="{{ slink(to_sig=nsig) }}" title="{{ s[1] }} — click to toggle"
           class="inline-flex h-6 w-6 items-center justify-center rounded-full border text-[11px] font-semibold
                  {% if on %}border-sky-500 bg-sky-600 text-white{% else %}border-slate-200 text-slate-300 hover:text-slate-500{% endif %}">{{ s[0]|upper }}</a>
        {% endfor %}
        <a href="{{ slink(to_rel=(not relevance)) }}" title="fisheye vs full document"
           class="ml-auto rounded border border-slate-200 px-1.5 py-0.5 text-[11px] {% if relevance %}bg-sky-600 text-white{% else %}text-slate-500{% endif %}">{{ '🔍' if relevance else '📄' }}</a>
      </div>
      {% if q %}
      <div class="flex items-center gap-2 text-[10px] text-slate-500">
        <span>{{ hits | length }} hit{{ 's' if hits | length != 1 }}</span>
        <a href="{{ slink(to_view='list') }}" class="{% if sview == 'list' %}font-semibold text-sky-700{% else %}hover:text-slate-700{% endif %}">list</a>
        <a href="{{ slink(to_view='toc') }}" class="{% if sview == 'toc' %}font-semibold text-sky-700{% else %}hover:text-slate-700{% endif %}">in-toc</a>
        <a href="{{ slink(to_q='') }}" class="ml-auto hover:text-rose-600">clear</a>
      </div>
      {% if sem_degraded and 's' in active_sig %}
      <div class="text-[10px] text-amber-600" title="the web embedder returned nothing — semantic search is unavailable right now">⚠ semantic unavailable (embedder warming?) — V/K/T only</div>
      {% endif %}
      {% endif %}
    </div>

    <div class="max-h-[calc(100vh-9rem)] overflow-auto py-1 text-xs">
      {% if q and sview == 'list' %}
      {# ── search results (ranked list) ── #}
      {% for h in hits %}
      {% set n = h.node %}
      <a href="?focus={{ n.dc }}" data-dc="{{ n.dc }}"
         class="flex items-center gap-1 px-2 py-1 hover:bg-sky-100 {% if n.dc == focus_dc %}bg-sky-100 ring-1 ring-inset ring-sky-400{% else %}bg-sky-50{% endif %}">
        {% for b in [('v', h.v, 'V', 'bg-sky-600'), ('k', h.k, 'K', 'bg-teal-600'), ('t', h.t, 'T', 'bg-amber-600')] %}
          {% if b[1] %}<span title="{{ b[0] }} match{{ '' if b[0] in active_sig else ' (off — not counted)' }}"
             class="inline-flex h-4 w-4 shrink-0 items-center justify-center rounded-full text-[9px] font-semibold text-white {% if b[0] in active_sig %}{{ b[3] }}{% else %}bg-slate-300{% endif %}">{{ b[2] }}</span>{% endif %}
        {% endfor %}
        {% if h.s_rank %}<span title="semantic rank #{{ h.s_rank }}{{ '' if 's' in active_sig else ' (off)' }}"
           class="inline-flex h-4 shrink-0 items-center justify-center rounded-full px-1 text-[9px] font-semibold text-white {% if 's' in active_sig %}bg-violet-600{% else %}bg-slate-300{% endif %}">S{{ h.s_rank }}</span>{% endif %}
        <span class="min-w-0 flex-1 truncate text-slate-600">{{ n.summary }}</span>
      </a>
      {% else %}
      <div class="px-2 py-3 text-slate-400">No matches.</div>
      {% endfor %}

      {% else %}
      {# ── fisheye TOC: foldable heading-outline tree (details/summary, no JS).
           The focus's section path (+ any hit's) ships open; the rest fold. ── #}
      {% set hit_dcs = hits | map(attribute='node') | map(attribute='dc') | list %}
      {% for sec in view.outline recursive %}
        {% if sec.heading %}
        <details {% if sec.open %}open{% endif %} class="sd-sec">
          <summary id="toc-{{ sec.heading.dc }}"
             style="padding-left: {{ 0.2 + sec.heading.depth * 0.6 }}rem"
             class="sd-sum{% if sec.heading.dc == focus_dc %} sd-focus{% elif q and sec.heading.dc in hit_dcs %} sd-hit{% endif %}">
            <span class="sd-tw">{% if sec.children or sec.body %}▸{% endif %}</span>
            <a data-dc="{{ sec.heading.dc }}" href="?focus={{ sec.heading.dc }}"
               class="sd-htext">{% if debug %}<span class="sd-dc">{{ sec.heading.dc }}</span> {% endif %}{{ sec.heading.summary }}</a>
            {%- if sec.heading.pinned %}<span class="sd-badge">📌</span>{% endif -%}
          </summary>
          {{ toc_body_rows(sec.body, hit_dcs) }}
          {% if sec.children %}{{ loop(sec.children) }}{% endif %}
        </details>
        {% else %}
          {{ toc_body_rows(sec.body, hit_dcs) }}
          {% if sec.children %}{{ loop(sec.children) }}{% endif %}
        {% endif %}
      {% else %}
        <div class="px-2 py-3 text-slate-400">No chunks yet.</div>
      {% endfor %}
      {% endif %}
    </div>
  </div>

  {# ── MIDDLE: the focus + its neighbourhood. NOT an overflow container —
       it flows with the page so linkify hover-preview popovers escape freely
       (an overflow-auto ancestor would clip them at the panel edge). ── #}
  <div class="rounded border border-slate-200 bg-white">
    <div class="border-b border-slate-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Focus</div>
    {# ``tex-scope`` (the opt-in KaTeX convention, base.html.j2) marks
       this as a prose container eligible for math rendering — the sanctioned
       overlap point with that slice; nothing else in this file changes. #}
    <div class="space-y-2 p-3 text-sm tex-scope">
      {% for m in view.middle %}
        {% set n = m.node %}
        {% set hd = 'font-semibold text-slate-900 text-base' if n.is_heading else '' %}
        {% if m.mode == 'full' and n.is_table %}
        {# Table focus: the ⊞ grid editor (shared draft_editors.html.j2,
           gripe 56746) instead of the plain-text editor — a table chunk isn't
           `n.editable` (there's no free-text edit path for it), but it always
           gets the structured grid. #}
        {% set _seed = n.table or {'header': ['Column 1', 'Column 2'], 'rows': [], 'caption': none} %}
        <div id="mid-focus" class="rounded border border-amber-200 bg-amber-50 p-2">
          <div class="mb-1 flex items-center gap-2 text-[10px] text-amber-700">
            <span>{{ sd_block.sd_dc_id(n.dc, cls='font-mono text-sky-500', trail='') }} {% if n.locked %}🔒{% endif %}</span>
            <div class="ml-auto flex items-center gap-2">
              {{ sd_block.sd_review_widget(n, review_by_dc.get(n.dc), ident) }}
              <button onclick="smartPin('{{ n.dc }}')"
                      class="{% if focus_pinned %}font-semibold text-amber-800{% else %}text-slate-400 hover:text-amber-700{% endif %}"
                      title="pin/unpin this para (key: p)">📌 {{ 'unpin' if focus_pinned else 'pin' }}</button>
            </div>
          </div>
          {% call draft_editors.draft_table_editor(ident, n.base58, n.sha, _seed) %}
          {% if n.table %}
          <div class="overflow-x-auto">
            {{ sd_block.sd_table(n.table, claims, abbrevs) }}
          </div>
          {% else %}
          <p class="whitespace-pre-wrap text-slate-800 {{ hd }}{% if n.provenance %} sd-prov-{{ n.provenance }}{% endif %}">{{ m.display | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs) }}</p>
          {% endif %}
          {% endcall %}
        </div>
        {% elif m.mode == 'full' and n.is_figure %}
        {# Figure focus: the shared medium-aware image render + clearance
           badge (drafts/_figures.html.j2, gripe 56668) — the SAME markup
           the classic /drafts reader uses, instead of the raw caption text
           smartdraft rendered before figures had their own render here.

           A figure's ``chunks.text`` IS its caption, so it gets the same
           ✎ inline text editor prose blocks get (``draft_edit`` → POST
           /drafts/{ident}/text → the ``edit`` verb, which rewrites the text
           in place and leaves the blob + ``meta.figure`` untouched) — before
           this, a caption was the one piece of draft prose with no edit path
           in either reader. ``editable=true`` is passed literally rather than
           via ``n.editable``: that property gates the *generic* free-text
           branch below, which a figure never reaches. ``block_keys=false``
           drops the Enter-split / Backspace-merge keys — both would operate
           on the chunk carrying the image.

           The ``draft_edit`` scope wraps ONLY the ``<figcaption>``, not the
           whole block: the macro hides everything it is handed
           (``x-show="!editing"``) and swaps the editor in, which for a
           paragraph is right — the rendered view and the thing being edited
           are the same text — but for a figure would black out the picture
           the caption describes the moment you clicked ✎, leaving you to
           write it blind. So the media, the clearance badge and the
           pin/review bar stay outside the scope and on screen; the ✎ trigger
           moves inside it (a button must sit in the Alpine scope whose
           ``startEdit()`` it calls), which also puts it next to the text it
           edits. #}
        <div id="mid-focus" class="rounded border border-amber-200 bg-amber-50 p-2">
          <div class="mb-1 flex items-center gap-2 text-[10px] text-amber-700">
            <span>{{ sd_block.sd_dc_id(n.dc, cls='font-mono text-sky-500', trail='') }} {% if n.locked %}🔒{% endif %}</span>
            <div class="ml-auto flex items-center gap-2">
              {{ sd_block.sd_review_widget(n, review_by_dc.get(n.dc), ident) }}
              <button onclick="smartPin('{{ n.dc }}')"
                      class="{% if focus_pinned %}font-semibold text-amber-800{% else %}text-slate-400 hover:text-amber-700{% endif %}"
                      title="pin/unpin this para (key: p)">📌 {{ 'unpin' if focus_pinned else 'pin' }}</button>
            </div>
          </div>
          <figure class="rounded-md border border-slate-200 bg-white p-2">
            {{ draft_figures.figure_media(ident, n.base58, n.figure_render, n.text) }}
            {# The editor lives INSIDE the <figcaption> (not around it) so the
               caption stays a direct child of <figure>, as the element
               requires — the macro's own wrapper <div> is flow content the
               figcaption accepts. #}
            <figcaption class="mt-1.5 text-sm text-slate-700">
              {% call draft_editors.draft_edit(ident, n.base58, n.sha, true, false, n.text, rows=4, block_keys=false) %}
              <span class="block whitespace-pre-wrap break-words">{{ m.display | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs) }}</span>
              <button @click="startEdit()" class="mt-0.5 text-[10px] text-slate-400 hover:text-sky-600"
                      title="edit this figure's caption (key: i)">✎ edit caption</button>
              {% endcall %}
            </figcaption>
            {{ draft_figures.clearance_badge(ident, n.base58, n.figure_origin, n.figure_cleared, n.figure_permission) }}
            {% if n.figure_has_data_package %}
            {{ draft_figures.figure_refresh_form(ident, n.base58) }}
            {% endif %}
          </figure>
        </div>
        {% elif m.mode == 'full' %}
        <div id="mid-focus" class="rounded border border-amber-200 bg-amber-50 p-2">
          {% call draft_editors.draft_edit(ident, n.base58, n.sha, n.editable, n.is_heading, n.text, rows=10) %}
          <div class="mb-1 flex items-center gap-2 text-[10px] text-amber-700">
            <span>{{ sd_block.sd_dc_id(n.dc, cls='font-mono text-sky-500', trail='') }} {% if n.locked %}🔒{% endif %}</span>
            <div class="ml-auto flex items-center gap-2">
              {{ sd_block.sd_review_widget(n, review_by_dc.get(n.dc), ident) }}
              <button onclick="smartPin('{{ n.dc }}')"
                      class="{% if focus_pinned %}font-semibold text-amber-800{% else %}text-slate-400 hover:text-amber-700{% endif %}"
                      title="pin/unpin this para (key: p)">📌 {{ 'unpin' if focus_pinned else 'pin' }}</button>
              {% if n.editable %}
              <button @click="startEdit()" class="text-slate-400 hover:text-slate-700">✎ edit</button>
              {% endif %}
            </div>
          </div>
          {# rendered view (with links) #}
          <div class="whitespace-pre-wrap text-slate-800 {{ hd }}{% if n.provenance %} sd-prov-{{ n.provenance }}{% endif %}">{{ m.display | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs) }}</div>
          {# tag row (the T search signal) — chips + type-ahead add #}
          <div class="mt-2 flex flex-wrap items-center gap-1 border-t border-amber-100 pt-1.5 text-[10px]">
            <span class="text-slate-400">🏷</span>
            {% for tag in n.tags %}
            <span class="inline-flex items-center gap-0.5 rounded bg-teal-100 px-1 text-teal-700">{{ tag }}<button onclick="smartTagRemove('{{ n.dc }}', {{ tag | tojson }})" class="hover:text-rose-600" title="remove tag">&times;</button></span>
            {% endfor %}
            <span class="relative" x-data="smartTagInput('{{ n.dc }}')">
              <input x-model="v" @input.debounce.200ms="suggest()" @keydown.enter.prevent="add()" @keydown.escape="items=[]"
                     placeholder="+tag" class="w-14 rounded border border-slate-200 px-1 py-0.5 focus:w-28 focus:border-teal-400 focus:outline-none">
              <div x-show="items.length" x-cloak class="absolute left-0 top-full z-50 mt-0.5 min-w-[6rem] rounded border border-slate-200 bg-white shadow-lg">
                <template x-for="s in items" :key="s"><button type="button" @click="v = s; add()" class="block w-full whitespace-nowrap px-1.5 py-0.5 text-left text-teal-700 hover:bg-teal-50" x-text="s"></button></template>
              </div>
            </span>
          </div>
          {% endcall %}
        </div>
        {% elif m.mode == 'doc' %}
        {# full-doc mode: a chunk in the server-rendered window around the focus,
           verbatim (see smartdraft/_block.html.j2 for why it's a <div>). #}
        {{ sd_block.sd_doc_block(n, m.display, claims, review_by_dc.get(n.dc), ident, abbrevs) }}
        {% elif m.mode == 'skel' %}
        {# full-doc lazy spacer: a distant chunk, sized by its height estimate
           and hydrated to a real doc block on scroll (IntersectionObserver →
           /smartdraft/{ident}/blocks). Keeps the initial full-doc page O(window)
           instead of O(N) on a 10k-chunk draft; its review indicator lands
           with the real content on hydration (item 4). #}
        <div data-dc="{{ n.dc }}" data-ph class="block rounded px-2 py-1" style="min-height: {{ m.est }}px"></div>
        {% elif m.mode in ('tail', 'head') %}
        {# ±1 neighbour: verbatim, truncated toward the focus (tail leads in,
           head flows out) — except a table chunk, which always renders in
           full (a table is already bounded, so there's no truncated form to
           show). <div> not <a> for the same nested-anchor reason as the
           doc-mode block above. #}
        {% set _is_tbl = n.is_table and n.table %}
        <div data-dc="{{ n.dc }}" class="block cursor-pointer{{ '' if _is_tbl else ' whitespace-pre-wrap' }} rounded px-2 py-1 text-slate-500 hover:bg-slate-50 {{ hd }}{% if n.provenance %} sd-prov-{{ n.provenance }}{% endif %}">{{ sd_block.sd_dc_id(n.dc) }}{% if review_by_dc.get(n.dc) %}{{ sd_block.sd_review_widget(n, review_by_dc.get(n.dc), ident) }} {% endif %}{% if _is_tbl %}{{ sd_block.sd_table(n.table, claims, abbrevs) }}{% else %}{{ m.display | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs) }}{% endif %}</div>
        {% else %}
        {# ±2 neighbour: one-line summary — the dc span sits inside this <a>, so
           sdCopyDc's stopPropagation/preventDefault (see sd_dc_id) matter here:
           without them a click on the id would also navigate the link. #}
        <a href="{{ qs(n.dc) }}" class="block truncate rounded px-2 py-0.5 text-slate-400 hover:bg-slate-50 {{ hd }}" title="{{ n.text[:400] }}">{{ sd_block.sd_dc_id(n.dc) }}· {{ m.display }}</a>
        {% endif %}
      {% else %}
        <div class="text-slate-400">Empty draft.</div>
      {% endfor %}
      {# "Relevant elsewhere" is not injected here — it broke the reading
         sequence. Distant-but-relevant chunks light up in the TOC (left) at
         their real location instead (sky tint), so the map carries relevance
         and the middle stays a clean read. #}
    </div>
  </div>

  {# ── RIGHT: docked Claim pane + collaboration — one sticky grid column.
       The claim pane (the claim-UX docked pane — a "4th column"
       without an actual grid change) sits ABOVE Collaborate: a persistent,
       scrollable panel, hidden until a prose ◆ or a Claims-rail chip is
       clicked (the delegated handler below, in the click listener). It loads
       the SAME ``/preview/claim/<head>`` fragment the hover popover uses, so
       the two surfaces never drift. Both panels are siblings inside ONE
       ``sticky`` wrapper (not each individually sticky) — the grid only
       expects a single child per column; a second top-level sticky div here
       would wrap onto a 4th, unstyled grid row instead of stacking in the
       right column. ── #}
  <div class="sticky top-2 self-start space-y-2">
    <div id="claim-pane" class="hidden rounded border border-violet-200 bg-violet-50">
      <div class="flex items-center justify-between border-b border-violet-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-violet-600">
        <span>Claim</span>
        <div class="flex items-center gap-2 normal-case tracking-normal">
          <a id="claim-pane-open" href="/claim/" target="_blank" rel="noopener"
             class="font-normal text-violet-600 hover:underline">open full page ↗</a>
          <button type="button" id="claim-pane-close" title="close"
                  class="font-normal text-violet-400 hover:text-violet-700">✕</button>
        </div>
      </div>
      <div id="claim-pane-body" class="max-h-72 overflow-y-auto p-2 text-xs tex-scope"></div>
    </div>

  <div class="rounded border border-slate-200 bg-white" x-data="smartAsk('{{ ident }}', '{{ focus_dc }}')"
       @llm-select="handleLlmSelect($event.detail)">
    <div class="border-b border-slate-100 px-2 py-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Collaborate</div>
    <div class="space-y-2 p-2 text-xs">
      {% if needs %}
      <div class="rounded border border-amber-200 bg-amber-50 p-1.5">
        <div class="mb-0.5 text-[10px] font-semibold uppercase tracking-wide text-amber-700">Needs · in-flight</div>
        {# Cap + scroll (not the sticky rail as a whole — that would clip the
           Tools pane's upward-opening Meta popovers, which aren't teleported). #}
        <div class="max-h-40 overflow-y-auto">
        {% for w in needs %}
        <div class="flex items-center gap-1 py-0.5 text-[10px]">
          {% if w.asks %}<span title="{{ w.asks | join('; ') }}">✋</span>{% endif %}
          <a href="/r/todo/{{ w.todo_id }}" target="_blank" rel="noopener" class="min-w-0 flex-1 truncate text-slate-700 hover:underline">{{ w.title }}</a>
          <span class="shrink-0 rounded px-1 {% if w.blocked %}bg-rose-100 text-rose-700{% else %}bg-slate-200 text-slate-600{% endif %}">{{ w.status }}</span>
        </div>
        {% endfor %}
        </div>
      </div>
      {% endif %}

      {# ── Cited sources (gripe 56635): the FOCUS block's paper citations,
           as hover-preview chips (precis_web.routes.smartdraft._cited_sources,
           reusing the classic /drafts reader's _ref_chips parser). Each chip
           opens the paper reader in a NEW TAB (popover_chip → linkify.
           _anchor_html carries target="_blank", no data-dc) so the writing
           surface stays put. Omitted when the focus cites nothing. #}
      {% if cited_sources %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Cited sources</div>
        <div class="flex max-h-32 flex-wrap gap-1 overflow-y-auto">
          {% for c in cited_sources %}{{ c }}{% endfor %}
        </div>
      </div>
      {% endif %}

      {# ── Links (gripe 178766): the FOCUS chunk's full connectivity — graph
           edges in AND out (precis_web.draft_links.chunk_links, split by
           `direction` off store.chunk_connections — the SAME data path the
           classic /drafts reader assembles from, just rendered here) plus
           any standalone anchored change-request ("flag it in the draft" —
           store.anchored_todos), which is invisible everywhere else: no
           project link, no job, so neither the fisheye ring nor the
           outline's "Work in progress" block ever shows it. Omitted
           entirely when the focus has no edges/flags. #}
      {% if links_out or links_in or flags %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Links</div>
        <div class="max-h-40 overflow-y-auto">
        {% if links_out %}
        <div class="mb-1 flex flex-wrap items-center gap-1">
          <span class="text-[10px] text-slate-400" title="this chunk links to →">out</span>
          {% for c in links_out %}{{ c }}{% endfor %}
        </div>
        {% endif %}
        {% if links_in %}
        <div class="mb-1 flex flex-wrap items-center gap-1">
          <span class="text-[10px] text-slate-400" title="← links to this chunk">in</span>
          {% for c in links_in %}{{ c }}{% endfor %}
        </div>
        {% endif %}
        {% if flags %}
        <div class="flex flex-wrap items-center gap-1">
          <span class="text-[10px] text-slate-400" title="anchored change-request todos">flags</span>
          {% for c in flags %}{{ c }}{% endfor %}
        </div>
        {% endif %}
        </div>
      </div>
      {% endif %}

      {# Taproot claim hubs cited in this window: the claim sentence + its
         print-visible (★) supporters, linking through to the /claim page. #}
      {% if claims_evidence %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Claims</div>
        <div class="flex max-h-40 flex-wrap gap-1 overflow-y-auto">
          {% for entry in claims_evidence %}
          {% set starred = (entry.originators + entry.corroborators) | selectattr('starred') | map(attribute='handle') | list %}
          <a href="/claim/{{ entry.head }}" data-claim-head="{{ entry.head }}"
             class="max-w-[16rem] truncate rounded bg-violet-50 px-1.5 py-0.5 text-[11px] text-violet-700 hover:bg-violet-100"
             title="{{ entry.claim }}">{{ entry.claim[:80] }}{% if entry.claim | length > 80 %}…{% endif %}{% if starred %} [{{ starred | join(', ') }}]{% endif %}</a>
          {% endfor %}
        </div>
      </div>
      {% endif %}

      <div class="flex items-center gap-2 text-slate-500">
        <span>Pinned: 📌 {{ eye_count }}</span>
        {% if eye_count %}<button onclick="smartClearPins()" class="text-[10px] text-slate-400 hover:text-rose-600">unpin all</button>
        {% else %}<span class="text-[10px] text-slate-400">nothing pinned — the ask works on the current para</span>{% endif %}
      </div>

      {# ── Figure add + clearance (gripe 56668 — ported from the classic
           /drafts reader; shared markup drafts/_figures.html.j2). Add
           inserts a new figure chunk right after the current focus (the
           same "insert after this block" semantics the classic per-row
           control uses); the upload form + any clearance edit below POST to
           the SAME /drafts/{ident}/figure… endpoints classic uses — the
           delegated `submit` listener below intercepts them so a successful
           save refreshes this panel in place instead of navigating to the
           classic reader (their redirect target). #}
      {% if view.focus %}
      <div class="rounded border border-slate-200 bg-slate-50 p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Figure</div>
        {{ draft_figures.figure_upload_form(ident, view.focus.base58) }}
      </div>
      {% endif %}
      {% set fig_nodes = view.nodes | selectattr('is_figure') | list %}
      {% if fig_nodes %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Figures · clearance</div>
        <div class="max-h-40 overflow-y-auto">
        {% for fn in fig_nodes %}
        <div class="flex items-center gap-1.5 py-0.5 text-[10px]">
          <a href="{{ qs(fn.dc) }}" data-dc="{{ fn.dc }}"
             class="min-w-0 flex-1 truncate text-slate-600 hover:text-sky-700"
             title="{{ fn.summary }}">{{ fn.summary }}</a>
          {{ draft_figures.clearance_badge(ident, fn.base58, fn.figure_origin, fn.figure_cleared, fn.figure_permission) }}
          {% if fn.figure_has_data_package %}
          {{ draft_figures.figure_refresh_form(ident, fn.base58) }}
          {% endif %}
        </div>
        {% endfor %}
        </div>
      </div>
      {% endif %}

      {# ── Term occurrences (gripe 56690): focusing a chunk_kind='term'
           leaf lists every other chunk mentioning it — short / long /
           abbrev / surface_forms — so the author jumps straight to a
           usage site. Computed server-side from the already-loaded node
           set (precis_web.smartdraft.term_occurrences), no DB scan. #}
      {% if view.focus and view.focus.is_term %}
      <div class="rounded border border-slate-200 bg-white p-1.5">
        <div class="mb-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Occurs in {{ term_occurrences | length }} place{{ 's' if term_occurrences | length != 1 else '' }}</div>
        {% if term_occurrences %}
        <div class="max-h-40 overflow-y-auto">
        {% for on in term_occurrences %}
        <a href="{{ qs(on.dc) }}" data-dc="{{ on.dc }}"
           class="block truncate rounded px-1 py-0.5 text-[10px] text-slate-600 hover:bg-slate-50 hover:text-sky-700"
           title="{{ on.summary }}">{{ on.summary }}</a>
        {% endfor %}
        </div>
        {% else %}
        <div class="text-[10px] text-slate-400">not yet used elsewhere in this draft</div>
        {% endif %}
      </div>
      {% endif %}

      <textarea x-model="text" rows="3" placeholder="Ask the LLM (works on the pinned context, or the current para if nothing is pinned)…"
                class="w-full rounded border border-slate-200 px-2 py-1"></textarea>
      <div class="flex flex-wrap items-center gap-2">
        {{ llm_selector.llm_selector(default_tier='big') }}
        <span class="text-slate-400" x-show="msg" x-text="msg"></span>
        <button @click="send()" :disabled="!text.trim()" class="ml-auto rounded bg-slate-800 px-2 py-1 text-white disabled:opacity-40">Send ▸</button>
      </div>
    </div>

    {# ── Tools pane (right-rail bottom) — export / doc-metadata / lifecycle
         controls ported from the classic /drafts reader (since retired).
         Tabbed (Export · Meta · Actions) so the resting footprint stays a
         tab-bar + one short row — the rail is a `sticky` element and a pane
         tall enough to exceed the viewport would strand its own bottom. Every
         dropdown opens UPWARD (`bottom-full`) for the same reason: there's no
         room below. All controls POST/GET the SAME shared /drafts/{ident}/…
         endpoints classic uses (nothing new server-side); the in-place ones
         (authors/genre/auto-author/export→project/reMarkable, which classic
         redirects back to its own reader) are intercepted in the submit
         handler below and refreshed in place — fork/delete correctly navigate
         away (new copy / drafts list). #}
    <div class="border-t border-slate-100" x-data="{ tool: 'export' }">
      <div class="flex items-center gap-1 border-b border-slate-100 px-2 py-1">
        <span class="mr-1 text-[10px] font-semibold uppercase tracking-wide text-slate-400">Tools</span>
        <template x-for="t in ['export', 'meta', 'actions']" :key="t">
          <button @click="tool = t"
                  class="rounded px-1.5 py-0.5 text-[11px] capitalize"
                  :class="tool === t ? 'bg-slate-700 text-white' : 'text-slate-500 hover:text-slate-800'"
                  x-text="t"></button>
        </template>
      </div>

      {# ── Export: docx/pdf downloads, PDF→project job, papers zip, reMarkable,
           + the retraction watch (backed by precis.export.retraction via
           the routes in precis_web/routes/drafts.py).
           `withSources` toggles the include-referenced-sources
           appendix (docx returns a zip; PDF a pdfpages appendix) — same
           semantics as classic. The retraction state is fetched read-only
           (no network) on pane load so the "N of M never checked" warning is
           visible before anyone presses "check retractions"; that button is
           the one thing here that DOES hit the network (Crossref, TTL-gated). #}
      <div x-show="tool === 'export'" x-cloak class="space-y-1.5 p-2 text-xs"
           x-data="{
             withSources: false,
             overrideRetraction: false,
             forceRecheck: false,
             retraction: null,
             retractionChecking: false,
             retractionError: null,
             // Feature C: which citation-health bucket's paper list is
             // currently expanded below the summary line (null = none; at
             // most one open at a time). Keys are the same JSON keys
             // ``_retraction_report_json`` ships (routes/drafts.py) —
             // ``papers`` (the full cited set) / ``missing_doi`` /
             // ``unchecked`` / ``doi_unvalidated``.
             expandedBucket: null,
             async loadRetraction() {
               try {
                 const r = await fetch('/drafts/{{ ident }}/retraction-status');
                 this.retraction = await r.json();
               } catch (e) { /* best-effort — export still works without this */ }
             },
             // The citation-health summary line, broken into segments —
             // same wording/order as the server's DraftRetractionReport.
             // summary() (precis.export.retraction), but four segments
             // (papers / missing_doi / unchecked / doi_unvalidated) are
             // click-toggles that expand their paper list below; the rest
             // (retracted / with-notices / DOI-invalid) stay plain text —
             // retracted already gets its own blocking box below, and the
             // others have no dedicated list in this pane.
             retractionSegments() {
               const r = this.retraction;
               if (!r) return [];
               const n = (key) => (r[key] || []).length;
               const mk = (key, label, clickable) => (
                 { key, label, n: n(key), clickable }
               );
               const bits = [
                 mk('retracted', 'retracted', false),
                 mk('soft', 'with notices', false),
                 mk('missing_doi', 'missing DOI', true),
                 mk('doi_invalid', 'DOI invalid', false),
                 mk('unchecked', 'never checked', true),
                 mk('doi_unvalidated', 'DOI never validated', true),
               ].filter((b) => b.n > 0);
               const segs = [
                 { key: 'papers', text: r.total + ' cited papers', clickable: true, prefix: '' },
               ];
               bits.forEach((b, i) => segs.push({
                 key: b.key, text: b.n + ' ' + b.label, clickable: b.clickable,
                 prefix: i === 0 ? ' — ' : ', ',
               }));
               if (!bits.length) {
                 segs.push({ key: null, text: 'all clean', clickable: false, prefix: ', ' });
               }
               return segs;
             },
             toggleBucket(key) {
               this.expandedBucket = this.expandedBucket === key ? null : key;
             },
             async checkRetraction() {
               this.retractionChecking = true;
               this.retractionError = null;
               try {
                 const body = new URLSearchParams();
                 if (this.forceRecheck) body.set('force', '1');
                 const r = await fetch('/drafts/{{ ident }}/retraction-check', { method: 'POST', body });
                 const data = await r.json();
                 if (data.ok === false) { this.retractionError = data.error || 'check failed'; }
                 else { this.retraction = data; }
               } catch (e) {
                 this.retractionError = String(e);
               } finally {
                 this.retractionChecking = false;
               }
             },
             docxQuery() {
               const p = new URLSearchParams();
               if (this.withSources) p.set('sources', '1');
               if (this.overrideRetraction) p.set('ignore_retractions', '1');
               const q = p.toString();
               return q ? '?' + q : '';
             }
           }"
           x-init="loadRetraction()">
        <label class="flex items-center gap-1 text-slate-500"
               title="include the referenced papers & datasheets in the export">
          <input type="checkbox" x-model="withSources" class="h-3 w-3"><span>+ sources</span>
        </label>

        {# Retraction watch: passive warning (read-only, no network) + the
           blocking notice + override once a cite is known-retracted. #}
        <template x-if="retraction && retraction.total > 0">
          <div class="space-y-1">
            {# Citation-health summary (item C) — same wording/order as the
               server's ``summary()``, but built client-side from the JSON
               so four buckets (papers / missing_doi / unchecked /
               doi_unvalidated) can be click-toggled open into their paper
               list just below, instead of being flat unreachable text. #}
            <p class="text-slate-400">
              <template x-for="seg in retractionSegments()" :key="seg.key + '.' + seg.text">
                <span>
                  <span x-text="seg.prefix"></span>
                  <span x-show="seg.clickable"
                        class="cursor-pointer underline decoration-dotted hover:decoration-solid"
                        :class="expandedBucket === seg.key ? 'text-sky-700' : ''"
                        :data-retraction-toggle="seg.key"
                        @click="toggleBucket(seg.key)"
                        x-text="seg.text"></span>
                  <span x-show="!seg.clickable" x-text="seg.text"></span>
                </span>
              </template>
            </p>
            <template x-if="expandedBucket">
              <div class="max-h-40 overflow-y-auto rounded border border-slate-200 bg-white p-1"
                   data-retraction-list>
                <template x-for="p in (retraction[expandedBucket] || [])" :key="p.ref_id">
                  <a :href="'/r/paper/' + p.slug" target="_blank" rel="noopener"
                     class="block truncate rounded px-1 py-0.5 text-[10px] text-slate-600 hover:bg-slate-50 hover:text-sky-700"
                     :title="p.title" x-text="p.title || p.slug"></a>
                </template>
              </div>
            </template>
            <template x-if="retraction.blocks_export">
              <div class="rounded border border-rose-200 bg-rose-50 px-2 py-1 text-rose-700">
                <p class="font-semibold">
                  ⚠ export blocked — retracted citation(s):
                  <span x-text="retraction.retracted.map(p => p.slug).join(', ')"></span>
                </p>
                <label class="mt-1 flex items-center gap-1">
                  <input type="checkbox" x-model="overrideRetraction" class="h-3 w-3">
                  <span>I've reviewed it — export anyway</span>
                </label>
              </div>
            </template>
            <template x-if="!retraction.blocks_export && retraction.unchecked.length > 0">
              <p class="text-amber-600">
                <span x-text="retraction.unchecked.length"></span> of
                <span x-text="retraction.total"></span> cited papers have never been
                checked for retraction —
                <a href="#" @click.prevent="checkRetraction()" class="underline">check now</a>.
              </p>
            </template>
          </div>
        </template>
        <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
          <button type="button" @click="checkRetraction()" :disabled="retractionChecking"
                  class="text-slate-500 underline hover:text-slate-800 disabled:opacity-50"
                  title="live-check every cited paper against Crossref for retraction/correction notices (TTL-gated)">
            <span x-text="retractionChecking ? 'checking…' : 'check retractions'"></span>
          </button>
          <label class="flex items-center gap-1 text-slate-400"
                 title="ignore the 30-day cache and re-check every cite now">
            <input type="checkbox" x-model="forceRecheck" class="h-3 w-3"><span>force</span>
          </label>
          <span x-show="retractionError" x-text="retractionError" class="text-rose-600"></span>
        </div>

        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
          <a :href="'/drafts/{{ ident }}/export.docx' + docxQuery()"
             class="text-slate-500 underline hover:text-slate-800"
             x-text="withSources ? 'download .docx+zip' : 'download .docx'">download .docx</a>
          <a :href="'/drafts/{{ ident }}/pdf' + (withSources ? '?sources=1' : '')"
             class="text-slate-500 underline hover:text-slate-800">download PDF</a>
          <form method="post" action="/drafts/{{ ident }}/export.pdf" class="inline">
            <input type="hidden" name="sources" :value="withSources ? '1' : ''">
            <input type="hidden" name="ignore_retractions" :value="overrideRetraction ? '1' : ''">
            <button type="submit" class="text-slate-500 underline hover:text-slate-800"
                    title="start a background job that persists the PDF into the project workspace">export →project</button>
          </form>
          <a href="/drafts/{{ ident }}/papers.zip"
             class="text-slate-500 underline hover:text-slate-800"
             title="zip the cited paper/datasheet PDFs + a manifest">download papers</a>
          {# Papers this draft cites but the corpus still lacks — the fetch
             worklist, opened in Drive's stub-acquisition surface pre-scoped to
             this draft (routes/drive.py cited_by facet). New tab so the writing
             surface stays put. #}
          <a href="/drive?cited_by={{ ident | urlencode }}" target="_blank" rel="noopener"
             class="text-slate-500 underline hover:text-slate-800"
             title="papers this draft cites but the corpus is missing — the fetch worklist">papers to fetch ▸</a>
          {% if remarkable_ready %}
          <form method="post" action="/drafts/{{ ident }}/remarkable" class="inline">
            <button type="submit" class="text-slate-500 underline hover:text-slate-800"
                    title="export in reMarkable mode (footnoted references) and send to the tablet">→ reMarkable</button>
          </form>
          {% endif %}
        </div>
      </div>

      {# ── Meta: byline, genre + project brief, auto-author toggle. The two
           editors are upward-opening popovers (no added rail height). #}
      <div x-show="tool === 'meta'" x-cloak class="flex flex-wrap items-center gap-x-3 gap-y-1 p-2 text-xs">
        {# Author byline editor — one author per line, "Name | Affiliation | ROR". #}
        <div class="relative" x-data="{ au: false }" @click.outside="au = false">
          <button @click="au = !au"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="edit the author byline + affiliations">authors ▾</button>
          <form x-show="au" x-cloak method="post"
                action="/drafts/{{ ident }}/authors"
                class="absolute bottom-full right-0 z-40 mb-1 w-96 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Authors — one per line</label>
              <textarea name="authors" rows="4"
                        placeholder="Doe, Jane | Massachusetts Institute of Technology | https://ror.org/042nb2s44&#10;Roe, John | Caltech&#10;Solo Author"
                        class="mt-0.5 w-full resize-y rounded border border-slate-200 px-2 py-1 font-mono text-xs leading-snug focus:border-sky-400 focus:outline-none">{{ author_lines }}</textarea>
              <p class="mt-0.5 text-[10px] text-slate-400"><span class="font-mono">Name | Affiliation | ROR</span> — affiliation + ROR optional; a shared ROR collapses to one numbered affiliation. Replaces the whole byline.</p>
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">save authors</button>
              <button type="button" @click="au = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Genre (document type) + project context (planner brief). #}
        <div class="relative" x-data="{ gen: false }" @click.outside="gen = false">
          <button @click="gen = !gen"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="set the document genre + project context">genre{% if cur_doctype %}: {{ cur_doctype }}{% endif %} ▾</button>
          <form x-show="gen" x-cloak method="post"
                action="/drafts/{{ ident }}/workspace"
                class="absolute bottom-full right-0 z-40 mb-1 w-80 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Genre (document type)</label>
              <select name="doctype"
                      class="mt-0.5 w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none">
                <option value="" {% if not cur_doctype %}selected{% endif %}>— none —</option>
                {% for d in doctypes %}
                <option value="{{ d.value }}" {% if cur_doctype == d.value %}selected{% endif %}>{{ d.label }}</option>
                {% endfor %}
              </select>
              <p class="mt-0.5 text-[10px] text-slate-400">paper / patent / report / review unlock the per-heading style picker.</p>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Project context (planner brief)</label>
              <textarea name="brief" rows="4"
                        placeholder="Standing guidance injected into every planner tick's ## Project context…"
                        class="mt-0.5 w-full resize-y rounded border border-slate-200 px-2 py-1 text-xs leading-snug focus:border-sky-400 focus:outline-none">{{ cur_brief }}</textarea>
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">save</button>
              <button type="button" @click="gen = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Voice/style — the standing writing register (meta.workspace.voice),
           always applied by the planner (## Voice & style), distinct from
           genre's project context (brief) and from the one-shot task (the
           project todo body). A separate popover so it posts alone (partial
           update — see routes/drafts.py::set_workspace) without touching
           genre/brief. #}
        <div class="relative" x-data="{ voi: false }" @click.outside="voi = false">
          <button @click="voi = !voi"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="set the standing voice/style applied to every planner tick">style ▾</button>
          <form x-show="voi" x-cloak method="post"
                action="/drafts/{{ ident }}/workspace"
                class="absolute bottom-full right-0 z-40 mb-1 w-80 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Voice / style</label>
              <p class="mt-0.5 text-[10px] text-slate-400">The standing writing register applied to every planner tick — separate from genre's project context above.</p>
              <textarea name="voice" rows="4"
                        placeholder="Voice / style applied to every planner tick — e.g. light-hearted, colloquial, occasional puns"
                        class="mt-0.5 w-full resize-y rounded border border-slate-200 px-2 py-1 text-xs leading-snug focus:border-sky-400 focus:outline-none">{{ cur_voice }}</textarea>
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">save</button>
              <button type="button" @click="voi = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Per-document auto-author toggle (3e). Turning ON confirms first
           (the grounded lenses will EDIT the draft). #}
        <form method="post" action="/drafts/{{ ident }}/authoring"
              @submit="if (!{{ 'true' if authoring_enabled else 'false' }} && !confirm('Turn ON auto-authoring? The cites/structure review lenses will EDIT this draft — adding grounded, cited prose where a real source supports it and flagging the rest. Every edit re-opens that paragraph for your human sign-off.')) $event.preventDefault()">
          <input type="hidden" name="enabled" value="{{ '0' if authoring_enabled else '1' }}" />
          <button class="underline {% if authoring_enabled %}text-amber-600 hover:text-amber-800{% else %}text-slate-500 hover:text-slate-800{% endif %}"
                  title="{% if authoring_enabled %}auto-author is ON — grounded lenses edit the draft; click to turn OFF{% else %}auto-author is OFF — review lenses only file findings; click to turn ON{% endif %}">✎ auto-author: {{ 'ON' if authoring_enabled else 'OFF' }}</button>
        </form>
      </div>

      {# ── Actions: duplicate (Phase-1 fork → new draft) and delete. Both are
           upward-opening popovers; both navigate away on success (the new
           copy / the drafts list), so they're deliberately NOT intercepted. #}
      <div x-show="tool === 'actions'" x-cloak class="flex flex-wrap items-center gap-x-3 gap-y-1 p-2 text-xs">
        {# Duplicate this draft into a fresh project (deep-copies every chunk). #}
        <div class="relative" x-data="{ dup: false }" @click.outside="dup = false">
          <button @click="dup = !dup"
                  class="text-slate-500 underline hover:text-slate-800"
                  title="duplicate this draft into a new project (a review copy)">⧉ duplicate ▾</button>
          <form x-show="dup" x-cloak method="post"
                action="/drafts/{{ ident }}/fork"
                class="absolute bottom-full right-0 z-40 mb-1 w-80 space-y-2 rounded border border-slate-200 bg-white p-3 text-left shadow-lg">
            <p class="text-[11px] text-slate-600">Deep-copies every paragraph + link into a <span class="font-semibold">new</span> draft under a fresh project. The original is untouched; the copy starts fully unreviewed.</p>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">New project name</label>
              <input name="project" required autocomplete="off" placeholder="e.g. nanobuds-review"
                     class="mt-0.5 w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none" />
              <p class="mt-0.5 text-[10px] text-slate-400">A fresh strategic project is created to own the copy (or pass <span class="font-mono">todo:N</span> for an existing draft-less one).</p>
            </div>
            <div>
              <label class="block text-[11px] font-semibold text-slate-600">Copy title <span class="font-normal text-slate-400">(optional)</span></label>
              <input name="title" autocomplete="off" placeholder="{{ ref.title }} (review copy)"
                     class="mt-0.5 w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-sky-400 focus:outline-none" />
            </div>
            <div class="flex items-center gap-2">
              <button class="rounded bg-sky-600 px-2 py-0.5 text-[11px] text-white hover:bg-sky-700">duplicate →</button>
              <button type="button" @click="dup = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
        {# Delete the whole draft — type-the-name confirm; soft-delete. #}
        <div class="relative" x-data="{ del: false }" @click.outside="del = false">
          <button @click="del = !del"
                  class="text-rose-500 underline hover:text-rose-700">delete ▾</button>
          <form x-show="del" x-cloak method="post"
                action="/drafts/{{ ident }}/delete"
                @submit="if (!confirm('Delete this draft? It can be recovered by an admin, but disappears from the app.')) $event.preventDefault()"
                class="absolute bottom-full right-0 z-40 mb-1 w-72 space-y-1.5 rounded border border-rose-300 bg-white p-2 text-left shadow-lg">
            <p class="text-[11px] text-slate-600">Type the draft name
              <span class="font-semibold text-slate-800">{{ ref.title }}</span>
              to delete it (recoverable):</p>
            <input name="confirm" autocomplete="off" placeholder="draft name…"
                   class="w-full rounded border border-slate-200 px-2 py-1 text-xs focus:border-rose-400 focus:outline-none" />
            <div class="flex items-center gap-2">
              <button class="rounded bg-rose-600 px-2 py-0.5 text-[11px] text-white hover:bg-rose-700">delete draft</button>
              <button type="button" @click="del = false" class="text-[10px] text-slate-400 hover:text-slate-600">cancel</button>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
  </div>

  {# nav state travels INSIDE #sd-content so a swap carries the fresh values.
     focusHandle (base58) lets the keyboard reach the focus block's inline
     editor via window.__dEditors (i / Enter → startEdit). #}
  <script type="application/json" id="sd-state">{{ {"order": view.order, "hits": (hits | map(attribute='node') | map(attribute='dc') | list), "focus": focus_dc, "focusHandle": (view.focus.base58 if view.focus else ""), "q": q} | tojson }}</script>
</div>

<script>
// KaTeX render (parity with the classic /drafts reader, since retired).
// __renderMath renders one element; __sdRenderMath does the whole panel and is
// exposed on window so auto-render's onload can fire the initial pass. Both are
// no-ops until KaTeX's deferred scripts have loaded (renderMathInElement).
function __renderMath(el) {
  if (!window.renderMathInElement || !el) return;
  renderMathInElement(el, {
    delimiters: [{left: '$$', right: '$$', display: true}, {left: '$', right: '$', display: false}],
    throwOnError: false,
  });
}
window.__sdRenderMath = function () { __renderMath(document.getElementById('sd-content')); };

// Citation hover popovers load lazily via htmx AFTER the initial KaTeX pass, so
// render math in each popover fragment as it swaps in (a cited quote has $…$
// too). Same handler the classic reader uses; the swap target is .ref-popover.
// The docked claim pane (#claim-pane-body) loads the same kind of fragment
// via htmx.ajax — same treatment, same math-bearing grounding quotes.
document.body.addEventListener('htmx:afterSwap', function (e) {
  const t = (e.detail && e.detail.target) || e.target;
  if (!t || !t.classList) return;
  if (t.classList.contains('ref-popover') || t.id === 'claim-pane-body') __renderMath(t);
});

// No-reload navigation: every TOC/result/toggle link + the search form + the
// pin/tag/mark actions fetch the page and swap ONLY #sd-content (persistent
// listeners below stay bound; Alpine re-inits the swapped components). Nav-state
// (order/hits/focus/q) rides inside #sd-content and is re-read after each swap.
(function () {
  // IIFE-scoped on purpose — nothing outside this script can read it. Code
  // in another <script> (e.g. `sdHeader()`) needs its own copy.
  const IDENT = {{ ident | tojson }};
  let ST = readState();
  function readState() {
    try { return JSON.parse(document.getElementById('sd-state').textContent); }
    catch (e) { return { order: [], hits: [], focus: '', q: '' }; }
  }
  async function swapFrom(url) {
    try {
      const html = await (await fetch(url, { cache: 'no-store' })).text();
      const doc = new DOMParser().parseFromString(html, 'text/html');
      const fresh = doc.getElementById('sd-content');
      const cur = document.getElementById('sd-content');
      if (!fresh || !cur) { location.href = url; return; }
      // Hover-preview cards are teleported to <body> (shared linkify fix,
      // gripe 56806) — they live OUTSIDE #sd-content, so replacing its
      // innerHTML can't reap them. Alpine's own teleport cleanup removes a
      // clone when its source <template> is destroyed by that replace, but
      // drop any survivors defensively so a stale card can never linger
      // after navigating away from the para that opened it.
      document.querySelectorAll('body > .ref-popover').forEach((el) => el.remove());
      cur.innerHTML = fresh.innerHTML;
      if (window.Alpine && window.Alpine.initTree) window.Alpine.initTree(cur);
      ST = readState();
      afterSwap();
    } catch (e) { location.href = url; }
  }
  function afterSwap() {
    const el = document.getElementById('toc-' + ST.focus);
    if (el) el.scrollIntoView({ block: 'center' });
    const mid = document.getElementById('mid-focus');
    if (mid) mid.scrollIntoView({ block: 'center' });
    if (ST.q) highlightTerm(document.getElementById('sd-content'), ST.q);
    if (window.htmx) window.htmx.process(document.getElementById('sd-content'));
    // Re-render $…$ / $$…$$ math over the freshly-swapped panel. On the very
    // first DOMContentLoaded KaTeX's deferred scripts may not have loaded yet;
    // auto-render's onload (window.__sdRenderMath) covers that initial pass.
    __sdRenderMath();
    installDocHydrator();   // full-doc (📄) lazy block hydration, if present
  }
  // ── Full-document lazy hydration ─────────────────────────────────────
  // In 📄 (relevance-off) mode only a window around the focus renders real
  // blocks; the rest are `data-ph` spacers (sized by a server estimate). An
  // IntersectionObserver hydrates a batch of near-viewport placeholders at a
  // time by fetching /blocks and swapping the real blocks in place, so a
  // 10k-chunk draft loads a screenful, not all N. Grow-only (no de-hydration)
  // — simple, and the win (cheap initial page) is already banked. Re-installed
  // by afterSwap() so it survives no-reload nav swaps; no-op when there are no
  // placeholders (fisheye mode).
  function installDocHydrator() {
    const cont = document.getElementById('sd-content');
    if (!cont || !cont.querySelector('[data-ph]')) {
      if (window.__sdDocObs) { window.__sdDocObs.disconnect(); window.__sdDocObs = null; }
      return;
    }
    if (window.__sdDocObs) window.__sdDocObs.disconnect();
    const pending = new Set();
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) hydrateSoon();
    }, { rootMargin: '1200px 0px' });
    window.__sdDocObs = io;
    cont.querySelectorAll('[data-ph]').forEach((el) => { pending.add(el); io.observe(el); });
    let scheduled = false;
    async function hydrateSoon() {
      if (scheduled) return;
      scheduled = true;
      await new Promise((r) => setTimeout(r, 30));
      scheduled = false;
      const vh = window.innerHeight;
      const batch = [];
      for (const el of pending) {
        const r = el.getBoundingClientRect();
        if (r.top < vh + 1500 && r.bottom > -1500) batch.push(el);
        if (batch.length >= 25) break;
      }
      if (!batch.length) return;
      // Claim this batch OUT of `pending` (and stop observing it) BEFORE the
      // await, so a scroll that fires the observer again mid-fetch can't
      // re-pick the same placeholders and duplicate the request; on failure
      // they're re-added below so a later scroll retries.
      batch.forEach((el) => { pending.delete(el); io.unobserve(el); });
      const dcs = batch.map((el) => el.getAttribute('data-dc'));
      try {
        const url = `/smartdraft/${IDENT}/blocks?dcs=` + encodeURIComponent(dcs.join(','));
        const html = await (await fetch(url, { cache: 'no-store' })).text();
        const doc = new DOMParser().parseFromString(html, 'text/html');
        const inserted = [];
        for (const el of batch) {
          const dc = el.getAttribute('data-dc');
          const fresh = doc.querySelector(`[data-dc="${CSS.escape(dc)}"]`);
          if (fresh) { const node = fresh.cloneNode(true); el.replaceWith(node); inserted.push(node); }
          else { el.removeAttribute('data-ph'); }   // unknown handle → drop the spacer
        }
        inserted.forEach((node) => {
          if (window.Alpine && window.Alpine.initTree) window.Alpine.initTree(node);
          if (window.htmx) window.htmx.process(node);
          __renderMath(node);
        });
      } catch (e) {
        // fetch failed — re-queue the batch (still in the DOM) so a later
        // scroll retries it instead of leaving permanent blank spacers.
        batch.forEach((el) => {
          if (el.isConnected && el.hasAttribute('data-ph')) { pending.add(el); io.observe(el); }
        });
        return;
      }
      if (pending.size) hydrateSoon();   // keep filling what's still in view
    }
    hydrateSoon();   // fill whatever is already on screen at install
  }
  async function navTo(dc) {
    const p = new URLSearchParams(location.search);
    p.set('focus', dc);
    const url = `/smartdraft/${IDENT}?` + p.toString();
    history.pushState({}, '', url);
    await swapFrom(url);
  }
  // expose a reload-free refresh for the action helpers (pin/tag/mark/save)
  window.__sdRefresh = () => swapFrom(location.href);
  const jump = navTo;
  const clearSearch = () => {
    const p = new URLSearchParams(location.search);
    p.set('q', '');
    const url = `/smartdraft/${IDENT}?` + p.toString();
    history.pushState({}, '', url);
    swapFrom(url);
  };
  // Highlight the query term wherever it shows (light blue) — a find-style mark.
  function highlightTerm(root, term) {
    if (!root || !term || term.length < 2) return;
    const re = new RegExp('(' + term.replace(/[.*+?^${}()|[\]\\]/g, '\\$&') + ')', 'gi');
    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode(n) {
        const p = n.parentNode;
        if (!n.nodeValue.trim() || !p) return NodeFilter.FILTER_REJECT;
        // skip marks/scripts/inputs and links (don't disturb linkify internals)
        if (['MARK', 'SCRIPT', 'STYLE', 'TEXTAREA', 'BUTTON', 'A'].includes(p.tagName)) return NodeFilter.FILTER_REJECT;
        return re.test(n.nodeValue) ? NodeFilter.FILTER_ACCEPT : NodeFilter.FILTER_REJECT;
      },
    });
    const nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
    nodes.forEach((n) => {
      const span = document.createElement('span');
      span.innerHTML = n.nodeValue.replace(re, '<mark class="rounded bg-sky-200 text-inherit">$1</mark>');
      n.parentNode.replaceChild(span, n);
    });
  }
  // ── Claim diamond ↔ Claims-rail sync + docked pane.
  // Every element sharing a `[fi123]` cite carries
  // `data-claim-head="fi123"` — the prose ◆ (linkify's `_render_claim_hub`)
  // AND its Claims-rail chip. Both hover-highlight the other; a plain click
  // on either loads the SAME `/preview/claim/<head>` fragment used by the
  // hover popover into the docked #claim-pane and scrolls/flashes the
  // counterpart element into view. One delegated listener pair (mouseover/
  // mouseout, which bubble — mouseenter/leave don't) on #sd-content, not one
  // per anchor, matching the rest of this reader's event-delegation idiom.
  // A *separate* claim window Reto has popped out (via the docked pane's
  // "open full page ↗"). While it's open, a ◆/rail-chip click retargets IT
  // instead of the in-page pane; once it's closed we fall back to the pane.
  // Page-scope (survives htmx #sd-content swaps; a full browser reload drops
  // it — re-pop-out to reconnect the same named window). See the delegate.
  let sdClaimWin = null;
  function claimHeadEls(head) {
    return document.querySelectorAll('[data-claim-head="' + CSS.escape(head) + '"]');
  }
  function claimPaneOpen(head) {
    const pane = document.getElementById('claim-pane');
    const body = document.getElementById('claim-pane-body');
    const openLink = document.getElementById('claim-pane-open');
    if (!pane || !body) return;
    pane.classList.remove('hidden');
    pane.dataset.head = head;
    if (openLink) openLink.setAttribute('href', '/claim/' + head);
    body.innerHTML = '<div class="p-2 text-slate-400">Loading…</div>';
    const url = '/preview/claim/' + head;
    if (window.htmx) {
      window.htmx.ajax('GET', url, { target: '#claim-pane-body', swap: 'innerHTML' });
    } else {
      fetch(url).then((r) => r.text()).then((html) => { body.innerHTML = html; });
    }
  }
  function claimPaneClose() {
    const pane = document.getElementById('claim-pane');
    if (!pane) return;
    pane.classList.add('hidden');
    delete pane.dataset.head;
  }
  // Scroll the FIRST counterpart element (excluding the one just clicked)
  // into view and flash it — clicking a rail chip finds the prose diamond
  // and vice versa. A brief class toggle (not the hover ring) so it reads
  // as a one-shot "there it is" rather than a sticky highlight.
  function claimFlashCounterpart(head, from) {
    const els = Array.from(claimHeadEls(head)).filter((el) => el !== from);
    const target = els[0];
    if (!target) return;
    target.scrollIntoView({ block: 'center', behavior: 'smooth' });
    target.classList.add('sd-claim-flash');
    setTimeout(() => target.classList.remove('sd-claim-flash'), 900);
  }
  (function installClaimHoverSync() {
    const cont = document.getElementById('sd-content');
    if (!cont) return;
    let hoverHead = null;
    function setHead(head) {
      if (hoverHead === head) return;
      if (hoverHead) claimHeadEls(hoverHead).forEach((el) => el.classList.remove('sd-claim-hl'));
      hoverHead = head;
      if (hoverHead) claimHeadEls(hoverHead).forEach((el) => el.classList.add('sd-claim-hl'));
    }
    cont.addEventListener('mouseover', (e) => {
      const el = e.target.closest ? e.target.closest('[data-claim-head]') : null;
      setHead(el ? el.getAttribute('data-claim-head') : null);
    });
    cont.addEventListener('mouseout', (e) => {
      const to = e.relatedTarget;
      if (to && to.closest && to.closest('[data-claim-head="' + hoverHead + '"]')) return;
      setHead(null);
    });
  })();
  window.addEventListener('DOMContentLoaded', afterSwap);
  window.addEventListener('popstate', () => swapFrom(location.href));
  // Delegate: any internal /smartdraft link (TOC rows, results, header toggles)
  // and the search form swap #sd-content instead of a full page navigation.
  const INT = 'a[href^="/smartdraft/' + IDENT + '?"]';
  document.addEventListener('click', (e) => {
    if (e.metaKey || e.ctrlKey) return;
    // The review indicator + its dropdown live INSIDE a data-dc block (doc/
    // tail/head mode) — without this guard a click on the button/menu items
    // would also bubble into the block-click branch below and navTo() away
    // from the very menu the click just opened.
    if (e.target.closest && e.target.closest('.sd-review, .sd-review-menu')) return;
    // Docked claim pane's own ✕ (see #claim-pane above the delegate helpers).
    if (e.target.closest && e.target.closest('#claim-pane-close')) {
      e.preventDefault();
      claimPaneClose();
      return;
    }
    // Docked pane's "open full page ↗" — graduate the pane to a *reusable*
    // separate window (named 'precis-claim') and remember its handle, so from
    // now on ◆/rail-chip clicks retarget THAT window instead of the pane.
    // Reusing the name means a browser reload's re-pop-out re-links the same
    // physical window rather than spawning a duplicate.
    const popOut = e.target.closest && e.target.closest('#claim-pane-open');
    if (popOut) {
      e.preventDefault();
      const head = (popOut.getAttribute('href') || '').replace('/claim/', '');
      if (head) {
        sdClaimWin = window.open('/claim/' + head, 'precis-claim');
        if (sdClaimWin) sdClaimWin.focus();
      }
      return;
    }
    // A plain (unmodified — metaKey/ctrlKey already returned above; a
    // middle-click never reaches 'click' at all) left-click on a prose ◆ or
    // a Claims-rail chip feeds the docked pane instead of opening a new tab
    // (the claim-UX docked pane); the anchor's own target="_blank" (or the
    // rail chip's plain href) still drives modified-click / right-click
    // "open in new tab", since those never preventDefault here.
    const claimEl = e.target.closest ? e.target.closest('[data-claim-head]') : null;
    if (claimEl && claimEl.closest('#sd-content')) {
      e.preventDefault();
      const head = claimEl.getAttribute('data-claim-head');
      // Conditional (Reto 2026-08-06): if a popped-out claim window is open,
      // change IT to the new claim; otherwise just update the in-page pane.
      if (sdClaimWin && !sdClaimWin.closed) {
        sdClaimWin.location.href = '/claim/' + head;
        sdClaimWin.focus();
      } else {
        claimPaneOpen(head);
      }
      claimFlashCounterpart(head, claimEl);
      return;
    }
    const a = e.target.closest ? e.target.closest('a') : null;
    if (a && a.closest('#sd-content')) {
      // Focus-nav rows carry a short data-dc (not a full URL — that bloated the
      // page ~90 bytes/row over ~2k rows); navTo preserves the current params.
      const dc = a.getAttribute('data-dc');
      if (dc) { e.preventDefault(); navTo(dc); return; }
      // Control links (signal/relevance/view/clear toggles) carry a full slink
      // URL with the changed param — swap to it in place.
      if (a.matches(INT)) {
        e.preventDefault();
        const href = a.getAttribute('href');
        history.pushState({}, '', href);
        swapFrom(href);
        return;
      }
      // Any other in-panel anchor is a citation / cited-source / claim chip
      // (its own <a> with target="_blank") — let it behave normally.
      return;
    }
    // Neighbour-paragraph body: the doc/tail/head blocks are <div data-dc> (NOT
    // <a> — an <a> can't wrap the citation <a>s inside the linkified text, or
    // the parser auto-closes it at the first cite and splits the paragraph).
    // A click anywhere in one that isn't on an inner anchor moves the focus.
    const block = e.target.closest ? e.target.closest('[data-dc]') : null;
    if (block && block.closest('#sd-content')) {
      const dc = block.getAttribute('data-dc');
      if (dc) { e.preventDefault(); navTo(dc); }
    }
  });
  document.addEventListener('submit', (e) => {
    const f = e.target;
    if (!f.matches) return;
    if (f.matches('form[action^="/smartdraft/' + IDENT + '"]')) {
      e.preventDefault();
      const url = f.getAttribute('action') + '?' + new URLSearchParams(new FormData(f)).toString();
      history.pushState({}, '', url);
      swapFrom(url);
      return;
    }
    // Figure add / clearance-edit / data-package refresh forms
    // (drafts/_figures.html.j2, gripe 56668) — the SAME endpoints the
    // classic /drafts reader posts to (reused as-is), but their hardcoded
    // redirect target is the classic reader (`/drafts/{ident}#c-{handle}`).
    // Intercept these inside #sd-content and POST via fetch instead, then
    // refresh the panel in place. The "draw" endpoint (mint + open an SVG
    // canvas, `…/figure/{handle}/draw`) is deliberately NOT intercepted —
    // like the classic reader, it's meant to navigate away into /figure.
    const act = f.getAttribute('action') || '';
    const figBase = `/drafts/${IDENT}/figure`;
    const isFigAdd = act === figBase;
    const isFigPermission = act.startsWith(figBase + '/') && act.endsWith('/permission');
    const isFigRefresh = act.startsWith(figBase + '/') && act.endsWith('/refresh');
    if (f.closest('#sd-content') && (isFigAdd || isFigPermission || isFigRefresh)) {
      e.preventDefault();
      fetch(act, { method: 'POST', body: new FormData(f) })
        .then(() => window.__sdRefresh())
        .catch(() => window.alert('network error — figure not saved'));
      return;
    }
    // Tools-pane forms that edit in place / start a job. In the classic
    // reader each of these redirects back to `/drafts/{ident}` — a plain
    // submit here would bounce the writer OUT of smartdraft into classic, so
    // (like the figure forms above) POST via fetch and refresh in place. NOT
    // listed: fork + delete, which correctly navigate away (new copy / drafts
    // list); also NOT listed any more: "review" — the review▾ menu (item 3)
    // now speaks JSON (`sdReviewRun`/`sdReviewAllOutstanding`/`sdReviewToc`
    // below), not a form post, since `/drafts/{ident}/review` now reads a
    // JSON body. Respect a cancelled confirm — the auto-author toggle's
    // @submit may already have preventDefault()'d when the user declined.
    const inPlace = ['authors', 'workspace', 'authoring', 'export.pdf', 'remarkable'];
    if (f.closest('#sd-content') && inPlace.some((ep) => act === `/drafts/${IDENT}/${ep}`)) {
      if (e.defaultPrevented) return;
      e.preventDefault();
      fetch(act, { method: 'POST', body: new FormData(f) })
        .then(() => window.__sdRefresh())
        .catch(() => window.alert('network error — not saved'));
    }
  });
  // The hover-preview card escaping smartdraft's overflow-clipped panes is
  // now handled shared-side (gripe 56806, ``linkify._anchor_html`` teleports
  // ``.ref-popover`` to <body> and computes its own fixed coords) — no
  // per-page mitigation needed here any more.
  // ── Spritz-style in-place reader (RSVP) ─────────────────────────────────
  // `R` walks the document word-by-word from the focus onward at a WPM rate,
  // highlighting each word IN PLACE (green box) with its optimal-recognition
  // point (the "pivot" letter) marked red, auto-scrolling to follow. No overlay
  // — it decorates the real rendered text (same TreeWalker idea as highlightTerm)
  // and grows the word stream as full-doc placeholders hydrate ahead of the
  // cursor. Controls while on: R pause/resume · Esc exit · +/- speed · ↑↓
  // paragraph · ←→ sentence · Space next paragraph. Exit re-fetches the panel,
  // which wipes the injected spans.
  const RSVP = { on: false, playing: false, wpm: 300, words: [], idx: 0,
                 cur: null, timer: null, stall: 0 };
  const _esc = (s) => s.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]));
  const _pivot = (n) => (n <= 1 ? 0 : n <= 5 ? 1 : n <= 9 ? 2 : n <= 13 ? 3 : 4);  // Spritz table
  function _orpHtml(w) {
    const p = _pivot(w.length);
    return _esc(w.slice(0, p)) + '<b class="rsvp-orp">' + _esc(w[p] || '') + '</b>' + _esc(w.slice(p + 1));
  }
  // Where a block's readable prose lives: the focus's display div, or the block itself.
  const _readEl = (el) => (el.id === 'mid-focus' ? (el.querySelector('.whitespace-pre-wrap') || el) : el);
  const _blockDc = (el) => (el.id === 'mid-focus' ? ST.focus : el.getAttribute('data-dc'));
  // The focus block + every full-text neighbour after it, in reading order.
  function _rsvpBlocks() {
    const mid = document.getElementById('mid-focus');
    if (!mid || !mid.parentElement) return [];
    const els = Array.from(mid.parentElement.querySelectorAll(':scope > #mid-focus, :scope > [data-dc]'));
    const s = els.indexOf(mid);
    return s < 0 ? els : els.slice(s);
  }
  // Wrap each word of a block in a <span> (skipping citation <a>s, math, controls),
  // pushing them onto RSVP.words. Idempotent per block (__rsvpTok guard).
  function _tokenize(el) {
    const target = _readEl(el);
    if (!target || target.__rsvpTok) return false;
    target.__rsvpTok = true;
    const dc = _blockDc(el);
    const walker = document.createTreeWalker(target, NodeFilter.SHOW_TEXT, {
      acceptNode(n) {
        const p = n.parentNode;
        if (!p || !n.nodeValue.trim()) return NodeFilter.FILTER_REJECT;
        if (['A', 'BUTTON', 'INPUT', 'TEXTAREA', 'SCRIPT', 'STYLE', 'MARK'].includes(p.tagName)) return NodeFilter.FILTER_REJECT;
        if (p.closest && p.closest('.katex')) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
      },
    });
    const nodes = []; while (walker.nextNode()) nodes.push(walker.currentNode);
    let any = false;
    nodes.forEach((n) => {
      const frag = document.createDocumentFragment();
      n.nodeValue.split(/(\s+)/).forEach((part) => {
        if (!part) return;
        if (/^\s+$/.test(part)) { frag.appendChild(document.createTextNode(part)); return; }
        const sp = document.createElement('span');
        sp.className = 'rsvp-w'; sp.textContent = part;
        frag.appendChild(sp);
        RSVP.words.push({ span: sp, dc, sent: 0 });
        any = true;
      });
      n.parentNode.replaceChild(frag, n);
    });
    return any;
  }
  // Re-sort by DOM order (blocks can hydrate out of order) and re-number
  // sentences; keep RSVP.idx pointing just past the current word.
  function _resort() {
    RSVP.words.sort((a, b) =>
      (a.span.compareDocumentPosition(b.span) & Node.DOCUMENT_POSITION_FOLLOWING) ? -1 : 1);
    let s = 0;
    RSVP.words.forEach((w) => { w.sent = s; if (/[.!?]["')\]]*$/.test(w.span.textContent)) s++; });
    if (RSVP.cur) { const i = RSVP.words.indexOf(RSVP.cur); if (i >= 0) RSVP.idx = i + 1; }
  }
  // Tokenize freshly-rendered forward blocks; if the next is still a lazy
  // placeholder, scroll it into view to trip the doc-hydrator and report back
  // so tick() waits for it.
  function _grow() {
    let added = false, sawPh = false;
    for (const el of _rsvpBlocks()) {
      if (el.hasAttribute && el.hasAttribute('data-ph')) { sawPh = true; el.scrollIntoView({ block: 'center' }); break; }
      if (_tokenize(el)) added = true;
    }
    if (added) _resort();
    return { added, sawPh };
  }
  function _decorate(sp) { sp.classList.add('rsvp-cur'); sp.dataset.w = sp.textContent; sp.innerHTML = _orpHtml(sp.textContent); }
  function _undecorate(sp) { sp.classList.remove('rsvp-cur'); if (sp.dataset.w != null) sp.textContent = sp.dataset.w; }
  function _scrollWord(sp) { const r = sp.getBoundingClientRect(); if (r.top < 100 || r.bottom > window.innerHeight - 100) sp.scrollIntoView({ block: 'center' }); }
  function rsvpTick() {
    RSVP.timer = null;
    if (!RSVP.on || !RSVP.playing) return;
    if (RSVP.idx >= RSVP.words.length) {
      const g = _grow();
      if (RSVP.idx >= RSVP.words.length) {
        if (g.sawPh && RSVP.stall++ < 25) { RSVP.timer = setTimeout(rsvpTick, 150); return; }
        RSVP.playing = false; _rsvpHud(); return;   // end of document — park on the last word
      }
    }
    RSVP.stall = 0;
    if (RSVP.cur) _undecorate(RSVP.cur.span);
    const w = RSVP.words[RSVP.idx];
    RSVP.cur = w; _decorate(w.span); _scrollWord(w.span);
    RSVP.idx++;
    RSVP.timer = setTimeout(rsvpTick, Math.round(60000 / RSVP.wpm));
  }
  const _curIdx = () => (RSVP.cur ? Math.max(0, RSVP.words.indexOf(RSVP.cur)) : 0);
  function _rsvpShow(j) {
    j = Math.max(0, Math.min(j, RSVP.words.length - 1));
    if (RSVP.cur) _undecorate(RSVP.cur.span);
    const w = RSVP.words[j]; RSVP.cur = w; _decorate(w.span); _scrollWord(w.span);
    RSVP.idx = j + 1; RSVP.stall = 0;
  }
  function rsvpJumpPara(dir) {
    if (!RSVP.words.length) return;
    const i = _curIdx(), dc = RSVP.words[i].dc;
    if (dir > 0) {
      let j = i; while (j < RSVP.words.length && RSVP.words[j].dc === dc) j++;
      if (j >= RSVP.words.length) { _grow(); while (j < RSVP.words.length && RSVP.words[j].dc === dc) j++; }
      _rsvpShow(Math.min(j, RSVP.words.length - 1));
    } else {
      let j = i; while (j > 0 && RSVP.words[j].dc === dc) j--;                       // last word of prev para
      const pdc = RSVP.words[j].dc; while (j > 0 && RSVP.words[j - 1].dc === pdc) j--;  // its first word
      _rsvpShow(j);
    }
  }
  function rsvpJumpSent(dir) {
    if (!RSVP.words.length) return;
    const i = _curIdx(), s = RSVP.words[i].sent;
    if (dir > 0) { let j = i; while (j < RSVP.words.length && RSVP.words[j].sent === s) j++; _rsvpShow(Math.min(j, RSVP.words.length - 1)); }
    else { let j = i; while (j > 0 && RSVP.words[j].sent === s) j--; const ps = RSVP.words[j].sent; while (j > 0 && RSVP.words[j - 1].sent === ps) j--; _rsvpShow(j); }
  }
  function rsvpWpm(d) { RSVP.wpm = Math.max(100, Math.min(1000, RSVP.wpm + d)); _rsvpHud(); }
  function rsvpToggle() {
    if (RSVP.playing) { RSVP.playing = false; clearTimeout(RSVP.timer); RSVP.timer = null; _rsvpHud(); }
    else { RSVP.playing = true; _rsvpHud(); rsvpTick(); }
  }
  function rsvpStart() {
    if (RSVP.on) return;
    RSVP.on = true; RSVP.playing = true; RSVP.idx = 0; RSVP.cur = null; RSVP.stall = 0; RSVP.words = [];
    _grow(); _resort();
    if (!RSVP.words.length) { RSVP.on = false; return; }
    _rsvpHud(); rsvpTick();
  }
  function rsvpExit() {
    clearTimeout(RSVP.timer); RSVP.timer = null;
    const dc = RSVP.cur ? RSVP.cur.dc : null;
    RSVP.on = false; RSVP.playing = false; RSVP.words = []; RSVP.cur = null; RSVP.idx = 0;
    const hud = document.getElementById('rsvp-hud'); if (hud) hud.remove();
    // Re-fetch the panel to wipe the injected word-spans and re-focus the para
    // we stopped on (navTo swaps #sd-content, so the spans vanish with it).
    if (dc) navTo(dc); else __sdRefresh();
  }
  function _rsvpHud() {
    let hud = document.getElementById('rsvp-hud');
    if (!hud) { hud = document.createElement('div'); hud.id = 'rsvp-hud'; document.body.appendChild(hud); }
    hud.textContent = (RSVP.playing ? '▶' : '⏸') + ' ' + RSVP.wpm + ' wpm  ·  R ' +
      (RSVP.playing ? 'pause' : 'play') + '  ·  Esc exit  ·  +/− speed  ·  ↑↓ ¶  ·  ←→ sentence';
  }
  function rsvpKey(e) {
    switch (e.key) {
      case 'r': case 'R': e.preventDefault(); rsvpToggle(); return true;
      case 'Escape': e.preventDefault(); rsvpExit(); return true;
      case '+': case '=': e.preventDefault(); rsvpWpm(25); return true;
      case '-': case '_': e.preventDefault(); rsvpWpm(-25); return true;
      case 'ArrowDown': e.preventDefault(); rsvpJumpPara(1); return true;
      case 'ArrowUp': e.preventDefault(); rsvpJumpPara(-1); return true;
      case 'ArrowRight': e.preventDefault(); rsvpJumpSent(1); return true;
      case 'ArrowLeft': e.preventDefault(); rsvpJumpSent(-1); return true;
      case ' ': e.preventDefault(); rsvpJumpPara(1); return true;   // Space → next ¶ (the "spacing out" catch-up)
      default: return false;
    }
  }
  document.addEventListener('keydown', (e) => {
    const t = document.activeElement;
    const inField = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
    // The reader owns the keyboard while it's on (unless you're typing in a field).
    if (RSVP.on && !inField) { rsvpKey(e); return; }
    if (e.key === 'Escape' && ST.q) { e.preventDefault(); clearSearch(); return; }
    if (e.key === '/' && !inField) {   // focus the search box
      e.preventDefault();
      const box = document.querySelector('input[name="q"]');
      if (box) box.focus();
      return;
    }
    if (inField) return;
    if (e.key === 'r' || e.key === 'R') { e.preventDefault(); rsvpStart(); return; }   // start the reader
    // i / Enter → open the focus block's inline editor (Esc leaves it, via ProseMirror).
    if (e.key === 'i' || e.key === 'Enter') {
      // Enter must not double-fire on a deliberately focused link/button.
      if (e.key === 'Enter' && t && t !== document.body) return;
      const ed = window.__dEditors && window.__dEditors[ST.focusHandle];
      if (ed && !ed.editing) { e.preventDefault(); ed.startEdit(); return; }
      if (e.key === 'i') { e.preventDefault(); return; }   // no editable focus → swallow
    }
    if (e.key === 'p' || e.key === 'P') {   // toggle pin/unpin the focus
      e.preventDefault();
      fetch(`/drafts/${IDENT}/marks`, {
        method: 'POST', headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ op: 'eye', handles: [ST.focus] }),
      }).then(() => window.__sdRefresh());
      return;
    }
    // In search mode the arrows step through the RESULTS (not the outline).
    if (ST.hits && ST.hits.length) {
      let hi = ST.hits.indexOf(ST.focus);
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') hi = hi < 0 ? 0 : Math.min(ST.hits.length - 1, hi + 1);
      else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') hi = hi < 0 ? 0 : Math.max(0, hi - 1);
      else return;
      e.preventDefault(); jump(ST.hits[hi]); return;
    }
    const ORDER = ST.order || [];
    const i = ORDER.findIndex((o) => o[0] === ST.focus);
    if (i < 0) return;
    const depth = ORDER[i][1];
    let j = -1;
    if (e.key === 'ArrowDown') j = Math.min(ORDER.length - 1, i + 1);
    else if (e.key === 'ArrowUp') j = Math.max(0, i - 1);
    else if (e.key === 'ArrowRight' || (e.key === 'Tab' && !e.shiftKey)) {
      for (let k = i + 1; k < ORDER.length; k++) { if (ORDER[k][1] > depth) { j = k; break; } if (ORDER[k][1] < depth) break; }
    } else if (e.key === 'ArrowLeft' || (e.key === 'Tab' && e.shiftKey)) {
      for (let k = i - 1; k >= 0; k--) { if (ORDER[k][1] < depth) { j = k; break; } }
    } else return;
    if (j >= 0 && j !== i) { e.preventDefault(); jump(ORDER[j][0]); }
  });
})();

// The shared draftEdit/tableEditor components (drafts/_editors.html.j2,
// gripe 56746) save via fetch + a `draft:*` CustomEvent — the classic
// reader's virtual scroller listens and re-hydrates just the affected row;
// smartdraft has no such per-row machinery (each nav is a full-panel
// server render), so it just re-fetches + swaps the whole panel. Covers a
// text save/split/merge/delete/insert and a table save (all dispatch
// `draft:edited`).
['draft:edited', 'draft:split', 'draft:merged', 'draft:removed', 'draft:inserted']
  .forEach((ev) => window.addEventListener(ev, () => window.__sdRefresh()));

// Pin/unpin any chunk (a persistent context eye) — used by the focus header
// and the TOC rows. POSTs the shipped /marks toggle, then swaps in place.
function smartPin(dc) {
  fetch(`/drafts/{{ ident }}/marks`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op: 'eye', handles: [dc] }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
function smartClearPins() {
  fetch(`/drafts/{{ ident }}/marks`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ op: 'clear' }),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
// Click-to-copy a chunk id (sd_block.sd_dc_id, _block.html.j2) — every id
// span/button across the reader (doc-mode blocks, tail/head neighbours, the
// ±2 summary line, the amber focus bar) shares this ONE inline-onclick
// helper, a plain top-level function (not inside an IIFE) so it is still
// callable from a block the /blocks hydration fragment injects later.
// stopPropagation/preventDefault are load-bearing: without them the click
// also bubbles into the block's delegated data-dc focus-nav handler, or (the
// ±2 summary line) follows the enclosing <a href>.
function sdCopyDc(event, dc) {
  event.stopPropagation();
  event.preventDefault();
  const el = event.currentTarget;
  const orig = el.textContent;
  navigator.clipboard.writeText(dc).then(() => {
    el.textContent = '✓ copied';
    setTimeout(() => { el.textContent = orig; }, 800);
  }).catch(() => {});
}
// ── Review status (indicator + dropdown + rollup) ──────────────────────
// Every action below just POSTs the shared JSON endpoint then refreshes the
// WHOLE panel (__sdRefresh, the same reload-free swap every other write path
// here uses) — the fresh server render recomputes every block's indicator +
// the toolbar badge straight from the ledger, so there's no separate
// client-side patch step to keep in sync with the route's own derivation.
function sdReviewHuman(dc) {
  fetch(`/drafts/{{ ident }}/human-review`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ dc }),
  }).then(() => window.__sdRefresh()).catch(() => window.alert('network error — not saved'));
}
function sdReviewRetract(dc) {
  fetch(`/drafts/{{ ident }}/review/retract`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ dc, checker: 'human' }),
  }).then(() => window.__sdRefresh()).catch(() => window.alert('network error — not saved'));
}
function sdReviewRun(dc, lens) {
  fetch(`/drafts/{{ ident }}/review`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ dc, lens }),
  }).then((r) => { if (!r.ok) window.alert('review run failed'); else window.__sdRefresh(); })
    .catch(() => window.alert('network error — review not started'));
}
function sdReviewAllOutstanding() {
  fetch(`/drafts/{{ ident }}/review`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify({ lens: 'all', only_dirty: true }),
  }).then(() => window.__sdRefresh()).catch(() => window.alert('network error — review not started'));
}
function sdReviewToc() {
  fetch(`/drafts/{{ ident }}/review`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    // Explicit click — force a re-run even if the toc row already looks
    // approved (only_dirty defaults true for whole-draft scope, which would
    // silently no-op an already-approved toc).
    body: JSON.stringify({ lens: 'toc', only_dirty: false }),
  }).then(() => window.__sdRefresh()).catch(() => window.alert('network error — review not started'));
}
// Convert to living cites (item 5b) — dry-run preview first, confirm, then
// apply. The apply POST bumps the rewritten chunk(s)' content_sha, so every
// checker's approval on them goes stale by construction; __sdRefresh picks
// that up the same as any other edit.
async function sdConvertCites(dc) {
  try {
    const r = await fetch(`/drafts/{{ ident }}/cites/convert`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dc, dry_run: true }),
    });
    const d = await r.json();
    if (!d.ok) { window.alert(d.error || 'preview failed'); return; }
    const groups = (d.chunks || []).reduce((n, c) => n + (c.groups ? c.groups.length : 0), 0);
    if (!groups) { window.alert('no living-cite conversions found here.'); return; }
    const preview = (d.chunks || [])
      .map((c) => `chunk ${c.chunk_id}: ${c.n_claims} claim(s), ${c.n_ungrounded} ungrounded`)
      .join('\n');
    if (!window.confirm(`Convert to living cites?\n\n${preview}\n\nApply now?`)) return;
    const r2 = await fetch(`/drafts/{{ ident }}/cites/convert`, {
      method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ dc, dry_run: false }),
    });
    const d2 = await r2.json();
    if (!d2.ok) { window.alert(d2.error || 'apply failed'); return; }
    window.__sdRefresh();
  } catch (e) { window.alert('network error'); }
}
// Chunk tags (the T search signal). Add/remove refresh so the chip + search reflect it.
function _chunkTag(dc, body) {
  fetch(`/smartdraft/{{ ident }}/chunk-tag`, {
    method: 'POST', headers: { 'Content-Type': 'application/json' },
    body: JSON.stringify(Object.assign({ handle: dc }, body)),
  }).then(() => window.__sdRefresh()).catch(() => {});
}
function smartTagAdd(dc, tag) { if (tag && tag.trim()) _chunkTag(dc, { add: tag.trim() }); }
function smartTagRemove(dc, tag) { _chunkTag(dc, { remove: tag }); }
function smartTagInput(dc) {
  return {
    dc, v: '', items: [],
    async suggest() {
      const q = this.v.trim();
      if (q.length < 2) { this.items = []; return; }
      try {
        const r = await fetch(`/smartdraft/{{ ident }}/tag-suggest?q=` + encodeURIComponent(q));
        const d = await r.json();
        this.items = (d.tags || []).filter((t) => t !== this.v);
      } catch (e) { this.items = []; }
    },
    add() { const t = this.v.trim(); if (t) smartTagAdd(this.dc, t); },
  };
}

// The focus para's inline text/table editing is now the shared draftEdit /
// tableEditor Alpine components (drafts/_editors.html.j2, gripe 56746) —
// see the `draft:*` refresh listener above. `smartEdit` (the old
// plain-textarea editor) is retired.

function smartAsk(ident, focus) {
  return {
    ident, focus, text: '', msg: '',
    // Structured selection from the shared llm-selector widget
    // (_llm_selector.html.j2), threaded up via its bubbling `llm-select`
    // event — the two Alpine scopes don't otherwise share state.
    llmSelect: { tier: 'big', placement: '', reasoning: '', temperature: '' },
    handleLlmSelect(sel) { this.llmSelect = sel; },
    async send() {
      if (!this.text.trim()) return;
      this.msg = 'sending…';
      try {
        // `anchor` = the current focus, so with nothing pinned the request still
        // works on the current para + its fisheye (server falls back to it).
        const r = await fetch(`/drafts/${this.ident}/request-ws`, {
          method: 'POST', headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            text: this.text, model: this.llmSelect.tier, anchor: this.focus,
            placement: this.llmSelect.placement, reasoning: this.llmSelect.reasoning,
            temperature: this.llmSelect.temperature,
          }),
        });
        const d = await r.json();
        this.msg = d.ok ? 'sent ✓' : ('error: ' + (d.error || ''));
        if (d.ok) this.text = '';
      } catch (e) { this.msg = 'network error'; }
    },
  };
}
</script>
{% endblock %}

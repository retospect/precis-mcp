  }
  const _curIdx = () => (RSVP.cur ? Math.max(0, RSVP.words.indexOf(RSVP.cur)) : 0);
  function _rsvpShow(j) {
    j = Math.max(0, Math.min(j, RSVP.words.length - 1));
    if (RSVP.cur) _undecorate(RSVP.cur.span);
    const w = RSVP.words[j]; RSVP.cur = w; _decorate(w.span); _scrollWord(w.span);

      case 'Escape': e.preventDefault(); rsvpExit(); return true;
      case '+': case '=': e.preventDefault(); rsvpWpm(25); return true;
      case '-': case '_': e.preventDefault(); rsvpWpm(-25); return true;
      case 'ArrowDown': e.preventDefault(); rsvpJumpPara(1); return true;
      case 'ArrowUp': e.preventDefault(); rsvpJumpPara(-1); return true;
      case 'ArrowRight': e.preventDefault(); rsvpJumpSent(1); return true;
      case 'ArrowLeft': e.preventDefault(); rsvpJumpSent(-1); return true;

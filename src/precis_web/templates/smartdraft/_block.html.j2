{# One full-document reading block (a non-focus chunk in 📄 mode). Shared by the
   initial page render (smartdraft/view.html.j2) AND the lazy-hydrate endpoint
   (/smartdraft/{ident}/blocks → smartdraft/_blocks.html.j2), so a placeholder
   swapped in on scroll is byte-identical to one rendered server-side.

   A <div> (NOT an <a>): the linkified body carries its own citation <a>
   anchors, and an <a> may not nest another — the HTML parser auto-closes the
   outer block <a> at the first citation, splitting the paragraph onto a new
   line. data-dc + cursor-pointer make the whole block a focus-nav click target
   via the delegated handler in view.html.j2 (which explicitly skips a click
   landing inside .sd-review/.sd-review-menu, below, so the indicator/dropdown
   don't also trigger a focus-nav). #}
{# Human-readable reason behind a grounding-provenance colour — used by the
   TOC dot (view.html.j2) hover, so hovering it answers "why is this red".
   The middle-pane block itself only shows the provenance as a left-border
   colour (``sd-prov-*``, set below) — no ``title`` — a whole-paragraph
   browser tooltip on every prose block was found superfluous and it fought
   the abbr hover popovers (linkify._highlight_abbrevs). #}
{# Shared figure media render + clearance badge — the SAME macros the focus
   branch (view.html.j2) and the classic reader use, so a figure block that
   hydrates on scroll shows its actual media, not just the caption text
   (gr496247). #}
{% import "drafts/_figures.html.j2" as draft_figures %}
{% macro prov_title(provenance) -%}
{%- if provenance == 'sourced' -%}sourced — cites a corpus paper/patent
{%- elif provenance == 'pending' -%}pending — cites a finding; the source is still being chased
{%- elif provenance == 'unsourced' -%}unsourced — this paragraph cites nothing; add a cite or run source-backfill
{%- else -%}{{ provenance }}{%- endif -%}
{%- endmacro %}

{# Read-only render of a table chunk's ``{header, rows, caption}`` payload —
   the SAME markup the focused table branch (view.html.j2) and the
   full-document/tail-head doc blocks (below) share, so a table reads
   identically whether it's the focus or just passing through. Deliberately
   emits ONLY table elements (table/caption/thead/tbody/tr/th/td) — no
   wrapping <div> — because every caller inlines this inside its own single
   ``<div data-dc>`` block; text/table blocks keep the one-``<div>`` shape
   (figure blocks are the documented exception — see ``sd_figure``), and
   ``_dc_block`` in test_smartdraft_reader.py slices a block by nesting
   depth so a nested <div> inside a FIGURE block stays readable. A caller
   that wants horizontal overflow scrolling puts it on
   THIS <table> itself (``block overflow-x-auto``) rather than wrapping. #}
{% macro sd_table(table, claims, abbrevs=none, pending_claims=none, refuted_claims=none, hypothesis_claims=none) -%}
<table class="w-full border-collapse text-sm">
  {% if table.caption %}
  <caption class="mb-1 text-left text-[13px] font-semibold text-fg-secondary">{{ table.caption | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}</caption>
  {% endif %}
  <thead><tr>
    {% for h in table.header %}
    <th class="border-b-2 border-line-strong px-2 py-1 text-left align-top font-semibold text-fg">{{ h | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}</th>
    {% endfor %}
  </tr></thead>
  <tbody>
    {% for row in table.rows %}
    <tr class="even:bg-surface-subtle">
      {% for cell in row %}
      <td class="border-b border-line-subtle px-2 py-1 align-top text-fg-secondary whitespace-pre-wrap break-words">{{ cell | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}</td>
      {% endfor %}
    </tr>
    {% endfor %}
  </tbody>
</table>
{%- endmacro %}

{# The clickable chunk-id idiom shared by every middle-pane block (the
   doc-mode block below, the tail/head neighbour and the ±2 summary line in
   view.html.j2, and the three amber-bar focus branches there): click →
   copy the dc handle to the clipboard (``sdCopyDc``, defined once in
   view.html.j2's script — a plain top-level function so it's still callable
   after the /blocks hydration fragment injects more of these). The helper
   itself does ``stopPropagation``/``preventDefault`` on the click, so this
   is safe to nest inside a ``<div data-dc>`` block's delegated focus-nav
   click handler OR inside an ``<a href>`` (the ±2 summary line) without
   triggering either. ``cls`` lets a caller match its surrounding size (the
   amber focus bar uses a plain, un-suffixed size); ``trail`` is trailing
   text (a space) kept INSIDE the span so callers that used to write
   ``{{ n.dc }} `` (id + literal space) render byte-identical markup. #}
{% macro sd_dc_id(dc, cls='font-mono text-[9px] text-info-soft', trail=' ') -%}
<span class="{{ cls }} cursor-pointer" title="click to copy" onclick="sdCopyDc(event, '{{ dc }}')">{{ dc }}{{ trail }}</span>
{%- endmacro %}

{# Machine-authored provenance chip (grounded-authoring reviewer, rung 3d):
   ``authored`` is the raw ``authored_by`` stamp (``'review:<lens>'``) from
   ``Store.drafts.authored_provenance`` — the SAME mark the retired classic
   reader rendered. The block's left stripe is the ``sd-authored`` CSS class
   on the block div (a box-shadow inset, deliberately NOT border-left — the
   grounding-provenance ``sd-prov-*`` border already owns that edge, and a
   block can carry both). A NEW authored chunk or a grounded EXTEND of an
   existing one starts unreviewed — approve it like any other edit. #}
{% macro sd_authored_chip(authored) -%}
{%- if authored -%}
<span class="inline-flex items-center rounded-sm bg-warning-muted px-1 font-mono text-[10px] text-warning-strong"
      title="machine-authored by the {{ authored.split(':')[-1] }} review lens — starts unreviewed; approve after checking">✎ authored ({{ authored.split(':')[-1] }})</span>
{%- endif -%}
{%- endmacro %}

{# Read-only figure block for doc mode (a non-focus figure scrolled into
   view — gr496247): the SAME ``figure_media`` + ``clearance_badge`` the
   focus branch (view.html.j2) renders, so a hydrated block's figure matches
   the focused one. The caption renders in ``<figcaption>`` with the same
   linkify pass prose blocks get. NB: unlike ``sd_table`` above, this CAN
   emit nested ``<div>`` markup (``figure_media``'s no-asset draw form and
   ``clearance_badge``'s popover/editor) — figure blocks are the documented
   exception to the one-``<div>``-per-block assumption; ``_dc_block`` in
   test_smartdraft_reader.py slices by nesting depth for exactly this
   reason. #}
{% macro sd_figure(n, display, claims, ident, abbrevs=none, pending_claims=none, refuted_claims=none, hypothesis_claims=none) -%}
<figure class="sd-fig-media rounded-md border border-line bg-surface p-2">
  {{ draft_figures.figure_media(ident, n.base58, n.figure_render, n.text) }}
  <figcaption class="mt-1.5 text-sm text-fg-secondary">
    {#- NB: no "block" on the inner span — 'class="block whitespace-pre-wrap'
       is the assertion signature of the retired block-level <a> bug
       (test_smartdraft_full_doc_cited_block_is_div_not_nested_anchor
       asserts it never appears on the page). -#}
    <span class="whitespace-pre-wrap break-words">{{ display | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}</span>
  </figcaption>
  {{ draft_figures.clearance_badge(ident, n.base58, n.figure_origin, n.figure_cleared, n.figure_permission) }}
  {% if n.figure_has_data_package %}{{ draft_figures.figure_refresh_form(ident, n.base58) }}{% endif %}
</figure>
{%- endmacro %}

{% macro sd_doc_block(n, display, claims, review, ident, abbrevs=none, pending_claims=none, refuted_claims=none, hypothesis_claims=none, authored=none) -%}
{%- set hd = 'font-semibold text-fg-strong text-base' if n.is_heading else '' -%}
{%- set prov = ' sd-prov-' ~ n.provenance if n.provenance else '' -%}
{%- set is_tbl = n.is_table and n.table -%}
{%- set is_fig = n.is_figure and n.figure_render -%}
<div data-dc="{{ n.dc }}" class="block cursor-pointer{{ '' if (is_tbl or is_fig) else ' whitespace-pre-wrap' }} rounded px-2 py-1 text-fg-secondary hover:bg-surface-subtle {{ hd }}{{ prov }}{{ ' sd-authored' if authored }}">{{ sd_dc_id(n.dc) }}{{ sd_authored_chip(authored) }}{% if review %}{{ sd_review_widget(n, review, ident) }} {% endif %}{% if is_tbl %}{{ sd_table(n.table, claims, abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}{% elif is_fig %}{{ sd_figure(n, display, claims, ident, abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}{% else %}{{ display | linkify_refs(markdown=True, compact=True, claims=claims, abbrevs=abbrevs, pending_claims=pending_claims, refuted_claims=refuted_claims, hypothesis_claims=hypothesis_claims) }}{% endif %}</div>
{%- endmacro %}

{# The per-block review indicator + dropdown
   — a 4-state dot (grey/empty · hollow-blue/machine-green ·
   green/human · amber/dirty, ``review.state``) whose title is the
   per-checker tooltip matrix (``review.tooltip``, precomputed server-side —
   ``precis_web.smartdraft.review_indicator``) plus a red integrity marker
   (``review.integrity_ok is false``, item 5c) plus a claim-trust overlay
   (``review.claim_trust``, the trust-surfaces editor badges
   — orthogonal to the dot's prose-review state: an amber ``?`` for an
   unverified-backed citation, a louder red ``‼`` for an unsupported one,
   ``sd-trust-unsupported``/``sd-trust-unverified`` in ``view.html.j2``;
   unsupported wins visually over a plain integrity ``!`` via CSS source
   order, not template logic). ``review`` is one entry of
   ``review_by_dc`` (``None`` → the block isn't reviewable, render nothing).
   Click opens a small action menu: mark/un-review, run one persona or all
   (a heading's "all" implicitly covers its subtree — the fanout's own
   scope rule), convert to living cites (dry-run preview → confirm apply),
   and — once a human row exists — a diff-since-approval deep link into the
   read-only console (``get(view='review-diff')``, not rebuilt here). #}
{% macro sd_review_widget(n, review, ident) %}
{%- if review is not none -%}
{% set hr = review.human %}
{#- NB: every element inside this widget is a <span>/<button>/<a> — deliberately
   NO <div> anywhere, even for the dropdown panel — because sd_doc_block (and the
   focus/tail/head blocks in view.html.j2) inline this widget inside their own
   single <div data-dc>, and keeping text/table blocks to one <div> preserves
   the readable-block slicing (``_dc_block`` is nesting-aware, but prose/table
   blocks stay div-free on purpose). -#}
{# Reuse the ledger matrix so inherited section checks and stale watermarks
   agree with the aggregate dot; these flags never start a review. #}
{% if n.is_prose or n.is_heading %}
<span class="sd-review sd-checker-strip inline-block text-xs" @click.stop
      title="Review checkers: F flow, C cites, S structure, A adversarial. Marks: ✓ reviewed and current, ~ reviewed but stale (block edited since), – never run. Hover a letter for that checker's detail.">
  {%- set labels = {'flow': 'F', 'cites': 'C', 'structure': 'S', 'adversarial': 'A'} -%}
  {%- set symbols = {'current': '✓', 'stale': '~', 'never': '–'} -%}
  {%- for row in review.matrix if row.checker in labels -%}
  <span data-review-checker="{{ row.checker }}" data-review-status="{{ row.status }}"
        title="{{ row.line }}" aria-label="{{ row.checker }}{% if row.via_section %} (via section){% endif %}: {{ 'unreviewed' if row.status == 'never' else row.status }}">{{ labels[row.checker] }}{{ symbols[row.status] }}</span>{{ ' ' if not loop.last else '' }}
  {%- endfor -%}
</span>
{% endif %}
<span class="relative inline-block" x-data="{ open: false }" @click.outside="open = false">
  <button type="button" @click="open = !open"
          title="{{ review.tooltip }}{% if not review.integrity_ok %}
⚠ integrity: an unresolved or unheld citation{% endif %}{% if review.claim_trust %}{% for h in review.claim_trust.heads %}
{% if h.label == 'unsupported' %}‼ UNSUPPORTED: [{{ h.head }}] — cited source does not back this claim{% elif h.label == 'abstract' %}Ⓐ abstract-only: [{{ h.head }}] — the abstract backs it; full text not read{% if h.note %} — {{ h.note }}{% endif %}{% elif h.label == 'vouched' %}✍ author-vouched: [{{ h.head }}] — source unobtainable; accepted on the author's word{% if h.note %} — {{ h.note }}{% endif %}{% else %}⚠ unverified claim: [{{ h.head }}] — {{ h.note }}{% endif %}{% endfor %}{% endif %}"
          class="sd-review sd-review-dot {{ review.state }}{% if not review.integrity_ok %} sd-integrity{% endif %}{% if review.claim_trust %} sd-trust-{{ review.claim_trust.label }}{% endif %}">●</button>
  <span x-show="open" x-cloak @click.stop class="sd-review-menu absolute left-0 z-30 mt-1 block w-48 rounded border border-line bg-surface text-left text-xs shadow-lg">
    <button type="button" @click="open = false" onclick="sdReviewHuman('{{ n.dc }}')" class="block w-full px-2 py-1 text-left hover:bg-surface-muted">✓ mark reviewed</button>
    {% if hr %}
    <button type="button" @click="open = false" onclick="sdReviewRetract('{{ n.dc }}')" class="block w-full px-2 py-1 text-left hover:bg-surface-muted">↩ un-review</button>
    {% endif %}
    {#- Run-persona buttons (item 2/3): flow/cites only mint on prose chunks,
       structure/adversarial only on headings (``review_fanout._personas_for_kind``)
       — a table/figure/term/equation block gets NO run-persona buttons at all
       (offering one would silently no-op the click), though the human
       ✓/un-review entries above/below stay available on ANY reviewable
       block by design. -#}
    {% set _persona_pair = ['structure', 'adversarial'] if n.is_heading else (['flow', 'cites'] if n.is_prose else []) %}
    {% for persona in _persona_pair %}
    <button type="button" @click="open = false" onclick="sdReviewRun('{{ n.dc }}', '{{ persona }}')" class="block w-full px-2 py-1 text-left hover:bg-surface-muted">▶ {{ persona }}</button>
    {% endfor %}
    {% if _persona_pair %}
    <button type="button" @click="open = false" onclick="sdReviewRun('{{ n.dc }}', 'all')" class="block w-full px-2 py-1 text-left hover:bg-surface-muted">▶ all{% if n.is_heading %} (subtree){% endif %}</button>
    {% endif %}
    <button type="button" @click="open = false" onclick="sdConvertCites('{{ n.dc }}')" class="block w-full px-2 py-1 text-left hover:bg-surface-muted">⇄ convert to living cites</button>
    {% if hr %}
    <a href="/console?verb=get&args_text={{ ('kind=draft id=' ~ n.dc ~ ' view=review-diff') | urlencode }}"
       target="_blank" rel="noopener" class="block px-2 py-1 hover:bg-surface-muted">↔ diff since approval</a>
    {% endif %}
  </span>
</span>
{%- endif -%}
{% endmacro %}

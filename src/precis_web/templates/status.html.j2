{% extends "base.html.j2" %}
{% block title %}System{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">System</h1>
<p class="text-sm text-fg-subtle mb-3">
  WS3 merged Status, Factory, and Budget into one page. <strong>Health</strong> is
  the read-only corpus/worker telemetry; <strong>Services</strong> edits what the
  factory runs (writes <code>service_config</code>); <strong>Budget</strong> edits
  the spend caps (writes <code>app_settings</code>).
</p>

{# ── sub-tab nav ──────────────────────────────────────────────── #}
<div class="mb-5 flex gap-1 text-sm border-b border-line">
  {% for key, label in [('health', 'Health'), ('services', 'Services'), ('models', 'Models'), ('budget', 'Budget'), ('now', 'Now'), ('setup', 'Setup')] %}
  <a href="/status?tab={{ key }}"
     class="px-3 py-1.5 -mb-px border-b-2 font-medium transition
       {% if tab == key %}border-success-solid text-success-strong{% else %}border-transparent text-fg-subtle hover:text-fg-secondary hover:border-line-strong{% endif %}">
    {{ label }}
  </a>
  {% endfor %}
  {# Not a ?tab= sub-tab: /work is its own page (td540843). #}
  <a href="/work"
     class="px-3 py-1.5 -mb-px border-b-2 font-medium transition border-transparent text-fg-subtle hover:text-fg-secondary hover:border-line-strong">
    Work
  </a>
</div>

{% if tab == 'health' %}
{% include "_status_health.html.j2" %}
{% elif tab == 'services' %}
{% include "_status_services.html.j2" %}
{% elif tab == 'models' %}
{% include "_status_models.html.j2" %}
{% elif tab == 'now' %}
{# Live worker-activity + job-lane + alert view — lazy-loaded (and then
   auto-refreshed) the same way the Health sub-tab's chunk-pipeline
   backlog panel is: an htmx shell here, the real content rendered by
   GET /status/now into ``_status_now.html.j2``. #}
<div hx-get="/status/now" hx-trigger="load, every 10s" hx-swap="innerHTML">
  <div class="rounded-lg border border-line bg-surface px-4 py-3 text-sm text-fg-faint flex items-center gap-2">
    <span class="inline-block w-3 h-3 rounded-full border-2 border-line-strong border-t-line-heavy animate-spin"></span>
    loading…
  </div>
</div>
{% elif tab == 'setup' %}
{% include "_status_setup.html.j2" %}
{% else %}
{% include "_status_budget.html.j2" %}
{% endif %}
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}System{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">System</h1>
<p class="text-sm text-slate-500 mb-3">
  WS3 merged Status, Factory, and Budget into one page. <strong>Health</strong> is
  the read-only corpus/worker telemetry; <strong>Services</strong> edits what the
  factory runs (writes <code>service_config</code>); <strong>Budget</strong> edits
  the spend caps (writes <code>app_settings</code>).
</p>

{# ── sub-tab nav ──────────────────────────────────────────────── #}
<div class="mb-5 flex gap-1 text-sm border-b border-slate-200">
  {% for key, label in [('health', 'Health'), ('services', 'Services'), ('models', 'Models'), ('budget', 'Budget'), ('now', 'Now')] %}
  <a href="/status?tab={{ key }}"
     class="px-3 py-1.5 -mb-px border-b-2 font-medium transition
       {% if tab == key %}border-emerald-500 text-emerald-700{% else %}border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300{% endif %}">
    {{ label }}
  </a>
  {% endfor %}
</div>

{% if tab == 'health' %}
{% include "_status_health.html.j2" %}
{% elif tab == 'services' %}
{% include "_status_services.html.j2" %}
{% elif tab == 'models' %}
{% include "_status_models.html.j2" %}
{% elif tab == 'now' %}
{# Live worker-activity + job-lane + alert view — lazy-loaded (and then
   auto-refreshed) the same way the Health sub-tab's chunk-pipeline
   backlog panel is: an htmx shell here, the real content rendered by
   GET /status/now into ``_status_now.html.j2``. #}
<div hx-get="/status/now" hx-trigger="load, every 10s" hx-swap="innerHTML">
  <div class="rounded-lg border border-slate-200 bg-white px-4 py-3 text-sm text-slate-400 flex items-center gap-2">
    <span class="inline-block w-3 h-3 rounded-full border-2 border-slate-300 border-t-slate-500 animate-spin"></span>
    loading…
  </div>
</div>
{% else %}
{% include "_status_budget.html.j2" %}
{% endif %}
{% endblock %}

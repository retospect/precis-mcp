{% extends "base.html.j2" %}
{% block title %}System{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">System</h1>
<p class="text-sm text-slate-500 mb-3">
  WS3 merged Status, Factory, and Budget into one page. <strong>Health</strong> is
  the read-only corpus/worker telemetry; <strong>Services</strong> edits what the
  factory runs (writes <code>service_config</code>); <strong>Budget</strong> edits
  the spend caps (writes <code>app_settings</code>).
</p>

{# ── sub-tab nav ──────────────────────────────────────────────── #}
<div class="mb-5 flex gap-1 text-sm border-b border-slate-200">
  {% for key, label in [('health', 'Health'), ('services', 'Services'), ('budget', 'Budget')] %}
  <a href="/status?tab={{ key }}"
     class="px-3 py-1.5 -mb-px border-b-2 font-medium transition
       {% if tab == key %}border-emerald-500 text-emerald-700{% else %}border-transparent text-slate-500 hover:text-slate-700 hover:border-slate-300{% endif %}">
    {{ label }}
  </a>
  {% endfor %}
</div>

{% if tab == 'health' %}
{% include "_status_health.html.j2" %}
{% elif tab == 'services' %}
{% include "_status_services.html.j2" %}
{% else %}
{% include "_status_budget.html.j2" %}
{% endif %}
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Nanopubs{% endblock %}
{# Full-bleed: the three panes should grow with the viewport. #}
{% block main_class %}px-3 py-3{% endblock %}
{% block content %}
<div class="space-y-3">
  {# One tooltip vocabulary for every state mention on the page (header
     strip + row badges) — hover explains where a claim sits on the
     candidate → reviewed → signed → anchored → published ladder and
     what moves it next. #}
  {% macro state_tip(key) -%}
    {%- if key == 'unminted' -%}
      Not minted — a free-form claim hub; nothing frozen, edit freely. Approve on its review page to enter the publish pipeline.
    {%- elif key == 'candidate' -%}
      Minted but unreviewed — nothing frozen yet. Next: approve freezes the exact claim sentence (candidate → reviewed).
    {%- elif key == 'reviewed' -%}
      Claim sentence frozen (approved title + sha). Next: a human Sign mints the artifact bytes (reviewed → signed).
    {%- elif key == 'signed' -%}
      Artifact bytes signed and immutable in the append-only proof store. Next: an OpenTimestamps batch anchors it (signed → anchored).
    {%- elif key == 'anchored' -%}
      Signed and OTS-anchored. Next: publish to the nanopub registry (anchored → published) — CLI-only and irreversible.
    {%- elif key == 'published' -%}
      Public and immutable — a change is a supersede or retract, never an edit.
    {%- elif key == 'blocked' -%}
      A live contradicts edge blocks minting and publication until the dispute is adjudicated — see the dispute panel on the review page.
    {%- endif -%}
  {%- endmacro %}

  <div class="flex items-baseline justify-between px-1">
    <h1 class="text-lg font-semibold">Nanopub claims</h1>
    <p class="text-xs text-slate-500">
      {{ n_nodes }} hub{{ 's' if n_nodes != 1 }}:
      {% for s, c in state_counts %}<span class="whitespace-nowrap cursor-help
        {%- if s in ('signed', 'anchored') %} text-sky-700
        {%- elif s == 'published' %} text-emerald-700
        {%- elif s == 'unminted' %} text-slate-400{% endif %}"
        title="{{ state_tip(s) }}">{{ c }} {{ s }}</span>{{ ' · ' if not loop.last }}{% endfor %}
      — click a claim to review it in the middle pane, a paper to read it
      on the right. Unpublished is a good terminal state, not a backlog to
      burn down.
    </p>
  </div>

  {% if draft_filter %}
  <div class="px-1">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 text-sky-800 text-xs px-2.5 py-1">
      draft {{ draft_filter.label }} — {{ draft_filter.n }} claim{{ 's' if draft_filter.n != 1 }}
      <a href="/nanopub" class="text-sky-600 hover:text-rose-600" title="clear the draft filter">✕</a>
    </span>
  </div>
  {% elif draft_notice %}
  <div class="px-1">
    <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
      {{ draft_notice }}. <a href="/nanopub" class="underline">clear</a>
    </p>
  </div>
  {% endif %}

  {% if stuck %}
  <div class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-800">
    ⚠ {{ stuck|length }} OTS batch{{ 'es' if stuck|length != 1 }} pending past
    threshold:
    {% for b in stuck %}
    <span class="font-mono">batch {{ b.id }} ({{ b.created_at.strftime('%Y-%m-%d') }})</span>{{ ", " if not loop.last }}
    {% endfor %}
    — calendar may have lost the commitment; re-stamp via
    <code>precis nanopub anchor --live</code>.
  </div>
  {% endif %}

  {% if disputed %}
  <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm text-rose-800">
    <span class="font-semibold">◆ Disputed — adjudicate first (oldest on top):</span>
    {% for r in disputed %}
    <a class="inline-block ml-2 hover:underline" target="np-review"
       href="/nanopub/fi{{ r.ref_id }}" data-src="/claim/fi{{ r.ref_id }}?embed=1"
       title="{{ r.title }}">
      <span class="font-mono">fi{{ r.ref_id }}</span>{% if r.disputed_since %}
      <span class="text-rose-500">(since {{ r.disputed_since.strftime('%Y-%m-%d') }})</span>{% endif %}</a>{{ " ·" if not loop.last }}
    {% endfor %}
  </div>
  {% endif %}

  {% macro state_badge(r) %}
  {% set key = 'blocked' if r.disputed else (r.state or 'unminted') %}
  <span class="font-mono text-xs px-1.5 py-0.5 rounded shrink-0 cursor-help
    {% if r.disputed %}bg-rose-100 text-rose-700
    {% elif r.state == 'published' %}bg-emerald-100 text-emerald-700
    {% elif r.state in ('signed', 'anchored') %}bg-sky-100 text-sky-700
    {% elif r.state %}bg-slate-200 text-slate-700
    {% else %}bg-slate-100 text-slate-400{% endif %}"
    title="{{ state_tip(key) }}{% if r.updated_at %} In this state since {{ r.updated_at.strftime('%Y-%m-%d %H:%M') }}Z.{% endif %}">
    {%- if r.disputed %}◆ blocked{% else %}{{ r.state or 'unminted' }}{% endif -%}
  </span>
  {# Minted rows also get a five-dot pipeline strip — the transition
     readout: filled dots = ladder rungs climbed, hover for the ladder
     and the last-transition time. #}
  {% if r.state %}
  {% set steps = ['candidate', 'reviewed', 'signed', 'anchored', 'published'] %}
  {% set idx = steps.index(r.state) if r.state in steps else -1 %}
  <span class="np-steps shrink-0 cursor-help"
        title="{{ steps|join(' → ') }} — at “{{ r.state }}”{% if r.updated_at %} since {{ r.updated_at.strftime('%Y-%m-%d %H:%M') }}Z{% endif %}">
    {%- for s in steps -%}
    <i class="np-dot{% if idx >= loop.index0 %} on{% endif %}{% if r.state == 'published' %} pub{% endif %}"></i>
    {%- endfor -%}
  </span>
  {% endif %}
  {% endmacro %}

  {% macro node(n) %}
  <li class="mt-1">
    <details {% if n.children %}open{% endif %} class="group">
      <summary class="tree-node flex items-center gap-2 cursor-pointer list-none rounded px-2 py-1 hover:bg-slate-100"
               data-pane="np-review" data-src="/claim/fi{{ n.row.ref_id }}?embed=1">
        {% if n.children or n.evidence %}
        <span class="tree-caret text-slate-400 text-xs w-3 group-open:rotate-90 transition-transform">▸</span>
        {% else %}
        <span class="w-3"></span>
        {% endif %}
        {{ state_badge(n.row) }}
        {% if n.relation %}
        <span class="text-xs text-slate-400 shrink-0 cursor-help"
              title="{% if n.relation == 'conjunct-of' %}Conjunct atom of the compound claim above — atoms mint and publish first; the compound cites their artifacts, not papers.{% else %}Refines the claim above — a narrower, sharper restatement.{% endif %}">{{ 'conjunct' if n.relation == 'conjunct-of' else n.relation }}</span>
        {% endif %}
        {# href = the workbench deep link (/nanopub/fi<id> — cmd-click /
           copy-link gets the full workbench, nav + tree included);
           data-src = what actually loads into the pane on a plain click. #}
        <a class="font-mono text-xs text-emerald-700 hover:underline shrink-0"
           target="np-review" href="/nanopub/fi{{ n.row.ref_id }}"
           data-src="/claim/fi{{ n.row.ref_id }}?embed=1">fi{{ n.row.ref_id }}</a>
        <span class="np-title text-sm leading-snug" title="{{ n.row.title }}">{{ n.row.title }}</span>
        {% if n.row.trusty_uri %}
        <span class="font-mono text-xs text-slate-400 shrink-0"
              title="{{ n.row.trusty_uri }}">{{ n.row.trusty_uri.rsplit('/', 1)[-1][:14] }}…</span>
        {% endif %}
        {% if n.row.drifted %}<span class="text-xs text-amber-600 shrink-0 cursor-help"
              title="The live hub title no longer matches the frozen approved sentence — signing is blocked; reopen and re-approve, or revert the edit.">drifted</span>{% endif %}
      </summary>
      {% if n.evidence or n.children %}
      <ul class="ml-6 border-l border-slate-200 pl-3">
        {% for e in n.evidence %}
        <li class="tree-node mt-0.5 flex items-center gap-2 rounded px-2 py-0.5 text-xs text-slate-500 cursor-pointer hover:bg-slate-100"
            {% if e.kind == 'finding' %}data-pane="np-review" data-src="/claim/fi{{ e.ref_id }}?embed=1"
            {% elif e.kind == 'paper' %}data-pane="np-paper" data-src="/papers/{{ e.ref_id }}?embed=1"{% endif %}>
          <span class="w-3"></span>
          <span class="font-mono px-1 rounded cursor-help
            {% if e.relation == 'contradicts' %}bg-rose-50 text-rose-600
            {% elif e.relation == 'establishes' %}bg-emerald-50 text-emerald-600
            {% else %}bg-slate-100 text-slate-500{% endif %}"
            title="{% if e.relation == 'contradicts' %}This source disputes the claim — publication is blocked until the dispute is adjudicated.{% elif e.relation == 'establishes' %}This source's passage directly asserts the claim — its primary grounding.{% elif e.relation == 'corroborates' %}This source's passage independently supports the claim.{% elif e.relation == 'derived-from' %}The claim was derived from this source, grounded through its pinned passage.{% else %}{{ e.relation }}{% endif %}">{{ e.relation }}</span>
          {% if e.kind == 'finding' %}
          <a class="truncate hover:underline" target="np-review"
             href="/nanopub/fi{{ e.ref_id }}" data-src="/claim/fi{{ e.ref_id }}?embed=1"
             title="{{ e.title }}">{{ e.title }}</a>
          {% elif e.kind == 'paper' %}
          <a class="truncate hover:underline" target="np-paper"
             href="/papers/{{ e.ref_id }}?embed=1" title="{{ e.title }}">{{ e.title }}</a>
          {% else %}
          <a class="truncate hover:underline" href="/refs/{{ e.kind }}/{{ e.ref_id }}"
             title="{{ e.title }}">{{ e.title }}</a>
          {% endif %}
          <span class="text-slate-400 shrink-0">{{ e.kind }}</span>
        </li>
        {% endfor %}
        {% for c in n.children %}{{ node(c) }}{% endfor %}
      </ul>
      {% endif %}
    </details>
  </li>
  {% endmacro %}

  <div id="np-panes" class="flex items-stretch" style="height: calc(100vh - 9rem); min-height: 480px;">
    <div id="pane-tree" class="overflow-y-auto min-w-0 pr-1" style="width: 34%">
      {% if roots %}
      <ul>
        {% for n in roots %}{{ node(n) }}{% endfor %}
      </ul>
      {% else %}
      <p class="text-sm text-slate-500">No claim hubs yet.</p>
      {% endif %}

      <details class="mt-4 text-sm">
        <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wide text-slate-400">
          OTS batches{% if batches %} ({{ batches|length }}){% endif %}
        </summary>
        {% if batches %}
        <table class="text-xs mt-2">
          <thead>
            <tr class="text-left uppercase tracking-wide text-slate-400 border-b border-slate-200">
              <th class="py-1.5 pr-4">Batch</th><th class="py-1.5 pr-4">Created</th>
              <th class="py-1.5 pr-4">Leaves</th><th class="py-1.5 pr-4">Proof</th>
              <th class="py-1.5 pr-4">Merkle root</th>
            </tr>
          </thead>
          <tbody>
            {% for b in batches %}
            <tr class="border-b border-slate-100">
              <td class="py-1 pr-4 font-mono">{{ b.id }}</td>
              <td class="py-1 pr-4">{{ b.created_at.strftime('%Y-%m-%d') }}</td>
              <td class="py-1 pr-4">{{ b.leaf_count }}</td>
              <td class="py-1 pr-4">
                <span class="{% if b.proof_state == 'upgraded' %}text-emerald-600{% elif b.proof_state == 'pending' %}text-amber-600{% else %}text-rose-600{% endif %}">
                  {{ b.proof_state or 'MISSING' }}
                </span>
              </td>
              <td class="py-1 pr-4 font-mono text-slate-400">{{ b.merkle_root[:24] }}…</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="text-xs text-slate-500 mt-2">No batches — the OTS sweep is dark
          (<code>PRECIS_OTS_ENABLED</code>) or nothing signed yet.</p>
        {% endif %}
      </details>
    </div>

    <div class="np-divider" data-pane="pane-tree"></div>

    <div id="pane-review" class="min-w-0" style="width: 36%">
      {# Placeholders are injected into the about:blank frames by the
         script below, NOT declared via srcdoc: Safari has dropped
         programmatic src navigation onto srcdoc-initialized frames
         (webkit.org/b/243385 class), and a dropped navigation looks
         like a dead click. #}
      <iframe name="np-review" id="np-review" title="claim review"
              class="w-full h-full rounded-lg border border-slate-200 bg-white"
              {% if preload_src %}src="{{ preload_src }}"{% endif %}
              data-placeholder="Click a claim on the left — its review page (state, evidence DAG, approve/sign action) loads here."></iframe>
    </div>

    <div class="np-divider" data-pane="pane-review"></div>

    <div id="pane-paper" class="min-w-0 flex-1">
      <iframe name="np-paper" id="np-paper" title="paper reader"
              class="w-full h-full rounded-lg border border-slate-200 bg-white"
              data-placeholder="Click an evidence paper — its reader loads here."></iframe>
    </div>
  </div>
</div>

<style>
  .tree-node.selected { background: #ecfdf5; }
  /* Two-line clamp instead of one-line truncate: at ~500px pane width a
     single line eats all but the first few words of a claim sentence
     (hover still shows the full title). overflow:hidden also zeroes the
     flex min-width, so the span shrinks instead of overflowing the row. */
  .np-title { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; }
  iframe.np-loading { opacity: .45; transition: opacity .15s; }
  .np-steps { line-height: 0; }
  .np-dot { display: inline-block; width: 5px; height: 5px; border-radius: 9999px; background: #cbd5e1; margin-right: 2px; }
  .np-dot.on { background: #0284c7; }
  .np-dot.on.pub { background: #059669; }
  .np-divider { width: 7px; flex: none; cursor: col-resize; border-radius: 4px; margin: 0 1px; }
  .np-divider:hover, .np-divider.dragging { background: #a7f3d0; }
</style>
<script>
  // Write the "click something" hints into the still-blank frames (see
  // the srcdoc-avoidance note on the iframes themselves). A frame the
  // server preloaded (the /nanopub/fi<id> deep link) is skipped — it is
  // already navigating to real content.
  const placeholder = f => {
    const d = f.contentDocument;
    if (!d || !d.body || d.body.firstChild) return;
    const p = d.createElement("p");
    p.style.cssText = "font: 13px system-ui; color: #94a3b8; padding: 1.5rem";
    p.textContent = f.dataset.placeholder;
    d.body.appendChild(p);
  };
  document.querySelectorAll("#np-panes iframe[data-placeholder]").forEach(f => {
    if (f.getAttribute("src")) return;
    placeholder(f);
  });

  // A pane a page vacated (base.html.j2's self-correcting placement sends
  // a claim that landed in the paper pane back to the review pane and
  // blanks the one it left) would otherwise read as a white void — give it
  // its hint back instead.
  document.querySelectorAll("#np-panes iframe[data-placeholder]").forEach(f => {
    f.addEventListener("load", () => {
      let blank = false;
      try { blank = f.contentWindow.location.href === "about:blank"; } catch { blank = false; }
      if (blank) placeholder(f);
    });
  });

  // One loader for every way a pane gets content. Dims the pane until its
  // load event so a slow claim page reads as "loading", not a dead click.
  const loadPane = (paneId, src, row) => {
    document.querySelectorAll(".tree-node.selected").forEach(x => x.classList.remove("selected"));
    if (row) row.classList.add("selected");
    const frame = document.getElementById(paneId);
    frame.classList.add("np-loading");
    frame.addEventListener("load", () => frame.classList.remove("np-loading"), { once: true });
    frame.src = src;
  };

  // Pane-targeted links (the fi<id> anchors, evidence links, the disputed
  // strip) drive the pane iframe directly instead of trusting the
  // browser's named-target resolution: Safari has intermittently dropped
  // link-target navigation onto srcdoc-initialized frames — the same
  // flakiness class the framed claim page's own interceptor documents —
  // and a miss looks like a dead click. target= stays on the anchors for
  // middle-click/cmd-click new-tab correctness (modified clicks fall
  // through to the browser untouched).
  document.addEventListener("click", ev => {
    const a = ev.target.closest('a[target="np-review"], a[target="np-paper"]');
    if (!a || ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
    ev.preventDefault();
    // data-src = the framed (?embed=1) pane URL; href stays the standalone
    // deep link so cmd-click / copy-link get the full workbench.
    loadPane(a.target, a.dataset.src || a.href, a.closest(".tree-node"));
  });

  // Deep-link sync: the browser URL mirrors whatever claim the review
  // pane shows (/nanopub/fi<id>), so reload / copy-link / share lands
  // back here with the same claim loaded — and the tree highlights it
  // even when the pane navigated itself (an fi-cite clicked inside).
  const reviewFrame = document.getElementById("np-review");
  reviewFrame.addEventListener("load", () => {
    let m = null;
    try { m = reviewFrame.contentWindow.location.pathname.match(/^\/claim\/fi(\d+)/); } catch {}
    if (!m) return;
    history.replaceState(null, "", "/nanopub/fi" + m[1]);
    document.querySelectorAll(".tree-node.selected").forEach(x => x.classList.remove("selected"));
    const row = document.querySelector('.tree-node[data-src^="/claim/fi' + m[1] + '?"]');
    if (row) row.classList.add("selected");
  });

  // Row click = load the row's target pane (bigger hit area than the
  // links).
  document.querySelectorAll(".tree-node").forEach(n => n.addEventListener("click", ev => {
    if (ev.target.closest("a")) return;                 // handled above / navigates
    if (!ev.target.closest(".tree-caret")) ev.preventDefault();  // only the caret folds
    if (!n.dataset.src) return;
    loadPane(n.dataset.pane, n.dataset.src, n);
  }));

  // Draggable dividers: each resizes the pane on its left; the last pane
  // flexes. Widths persist per pane in localStorage.
  document.querySelectorAll("#np-panes > [id^='pane-']").forEach(p => {
    const saved = localStorage.getItem("np-pane-" + p.id);
    if (saved && p.style.width) p.style.width = saved;
  });
  document.querySelectorAll(".np-divider").forEach(d => {
    d.addEventListener("pointerdown", ev => {
      const pane = document.getElementById(d.dataset.pane);
      const startX = ev.clientX, startW = pane.getBoundingClientRect().width;
      d.classList.add("dragging");
      d.setPointerCapture(ev.pointerId);
      // Iframes swallow pointermove — disable their hit-testing mid-drag.
      document.querySelectorAll("#np-panes iframe").forEach(f => f.style.pointerEvents = "none");
      const move = e => {
        const w = Math.max(160, startW + e.clientX - startX);
        pane.style.width = w + "px";
      };
      const up = () => {
        d.classList.remove("dragging");
        d.removeEventListener("pointermove", move);
        document.querySelectorAll("#np-panes iframe").forEach(f => f.style.pointerEvents = "");
        localStorage.setItem("np-pane-" + pane.id, pane.style.width);
      };
      d.addEventListener("pointermove", move);
      d.addEventListener("pointerup", up, { once: true });
    });
  });
</script>
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Nanopubs{% endblock %}
{# Full-bleed: the three panes should grow with the viewport. #}
{% block main_class %}px-3 py-3{% endblock %}
{% block content %}
<div class="space-y-3">
  {# One tooltip vocabulary for every state mention on the page (header
     strip + row badges) — hover explains where a claim sits on the
     candidate → reviewed → signed → anchored → published ladder and
     what moves it next. #}
  {% macro state_tip(key) -%}
    {%- if key == 'unminted' -%}
      Not minted — a free-form claim hub; nothing frozen, edit freely. Approve on its review page to enter the publish pipeline.
    {%- elif key == 'candidate' -%}
      Minted but unreviewed — nothing frozen yet. Next: approve freezes the exact claim sentence (candidate → reviewed).
    {%- elif key == 'reviewed' -%}
      Claim sentence frozen (approved title + sha). Next: a human Sign mints the artifact bytes (reviewed → signed).
    {%- elif key == 'signed' -%}
      Artifact bytes signed and immutable in the append-only proof store. Next: an OpenTimestamps batch anchors it (signed → anchored).
    {%- elif key == 'anchored' -%}
      Signed and OTS-anchored. Next: publish to the nanopub registry (anchored → published) — CLI-only and irreversible.
    {%- elif key == 'published' -%}
      Public and immutable — a change is a supersede or retract, never an edit.
    {%- elif key == 'blocked' -%}
      A live contradicts edge blocks minting and publication until the dispute is adjudicated — see the dispute panel on the review page.
    {%- endif -%}
  {%- endmacro %}

  <div class="flex items-baseline justify-between px-1">
    <h1 class="text-lg font-semibold">Nanopub claims</h1>
    <p class="text-xs text-slate-500">
      {{ n_nodes }} hub{{ 's' if n_nodes != 1 }}:
      {% for s, c in state_counts %}<span class="whitespace-nowrap cursor-help
        {%- if s in ('signed', 'anchored') %} text-sky-700
        {%- elif s == 'published' %} text-emerald-700
        {%- elif s == 'unminted' %} text-slate-400{% endif %}"
        title="{{ state_tip(s) }}">{{ c }} {{ s }}</span>{{ ' · ' if not loop.last }}{% endfor %}
      — click a claim to review it in the middle pane, a paper to read it
      on the right. Unpublished is a good terminal state, not a backlog to
      burn down.
    </p>
  </div>

  {% if draft_filter %}
  <div class="px-1">
    <span class="inline-flex items-center gap-1.5 rounded-full bg-sky-100 text-sky-800 text-xs px-2.5 py-1">
      draft {{ draft_filter.label }} — {{ draft_filter.n }} claim{{ 's' if draft_filter.n != 1 }}
      <a href="/nanopub" class="text-sky-600 hover:text-rose-600" title="clear the draft filter">✕</a>
    </span>
  </div>
  {% elif draft_notice %}
  <div class="px-1">
    <p class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-xs text-amber-800">
      {{ draft_notice }}. <a href="/nanopub" class="underline">clear</a>
    </p>
  </div>
  {% endif %}

  {% if stuck %}
  <div class="rounded-lg border border-amber-300 bg-amber-50 px-4 py-2 text-sm text-amber-800">
    ⚠ {{ stuck|length }} OTS batch{{ 'es' if stuck|length != 1 }} pending past
    threshold:
    {% for b in stuck %}
    <span class="font-mono">batch {{ b.id }} ({{ b.created_at.strftime('%Y-%m-%d') }})</span>{{ ", " if not loop.last }}
    {% endfor %}
    — calendar may have lost the commitment; re-stamp via
    <code>precis nanopub anchor --live</code>.
  </div>
  {% endif %}

  {% if disputed %}
  <div class="rounded-lg border border-rose-200 bg-rose-50 px-4 py-2 text-sm text-rose-800">
    <span class="font-semibold">◆ Contradicted — adjudicate first (oldest on top):</span>
    {% for r in disputed %}
    <a class="inline-block ml-2 hover:underline" data-pane="np-review"
       href="/nanopub/fi{{ r.ref_id }}" data-src="/claim/fi{{ r.ref_id }}"
       title="{{ r.title }}">
      <span class="font-mono">fi{{ r.ref_id }}</span>{% if r.disputed_since %}
      <span class="text-rose-500">(since {{ r.disputed_since.strftime('%Y-%m-%d') }})</span>{% endif %}</a>{{ " ·" if not loop.last }}
    {% endfor %}
  </div>
  {% endif %}

  {% macro state_badge(r) %}
  {% set key = 'blocked' if r.disputed else (r.state or 'unminted') %}
  <span class="font-mono text-xs px-1.5 py-0.5 rounded shrink-0 cursor-help
    {% if r.disputed %}bg-rose-100 text-rose-700
    {% elif r.state == 'published' %}bg-emerald-100 text-emerald-700
    {% elif r.state in ('signed', 'anchored') %}bg-sky-100 text-sky-700
    {% elif r.state %}bg-slate-200 text-slate-700
    {% else %}bg-slate-100 text-slate-400{% endif %}"
    title="{{ state_tip(key) }}{% if r.updated_at %} In this state since {{ r.updated_at.strftime('%Y-%m-%d %H:%M') }}Z.{% endif %}">
    {%- if r.disputed %}◆ blocked{% else %}{{ r.state or 'unminted' }}{% endif -%}
  </span>
  {# Minted rows also get a five-dot pipeline strip — the transition
     readout: filled dots = ladder rungs climbed, hover for the ladder
     and the last-transition time. #}
  {% if r.state %}
  {% set steps = ['candidate', 'reviewed', 'signed', 'anchored', 'published'] %}
  {% set idx = steps.index(r.state) if r.state in steps else -1 %}
  <span class="np-steps shrink-0 cursor-help"
        title="{{ steps|join(' → ') }} — at “{{ r.state }}”{% if r.updated_at %} since {{ r.updated_at.strftime('%Y-%m-%d %H:%M') }}Z{% endif %}">
    {%- for s in steps -%}
    <i class="np-dot{% if idx >= loop.index0 %} on{% endif %}{% if r.state == 'published' %} pub{% endif %}"></i>
    {%- endfor -%}
  </span>
  {% endif %}
  {% endmacro %}

  {% macro node(n) %}
  <li class="mt-1">
    <details {% if n.children %}open{% endif %} class="group">
      <summary class="tree-node flex items-center gap-2 cursor-pointer list-none rounded px-2 py-1 hover:bg-slate-100"
               data-pane="np-review" data-src="/claim/fi{{ n.row.ref_id }}">
        {% if n.children or n.evidence %}
        <span class="tree-caret text-slate-400 text-xs w-3 group-open:rotate-90 transition-transform">▸</span>
        {% else %}
        <span class="w-3"></span>
        {% endif %}
        {{ state_badge(n.row) }}
        {% if n.relation %}
        <span class="text-xs text-slate-400 shrink-0 cursor-help"
              title="{% if n.relation == 'conjunct-of' %}Conjunct atom of the compound claim above — atoms mint and publish first; the compound cites their artifacts, not papers.{% else %}Refines the claim above — a narrower, sharper restatement.{% endif %}">{{ 'conjunct' if n.relation == 'conjunct-of' else n.relation }}</span>
        {% endif %}
        {# href = the workbench deep link (/nanopub/fi<id> — cmd-click /
           copy-link gets the full workbench, nav + tree included);
           data-src = what actually gets swapped into the pane on a plain
           click. data-pane names the destination; there is no target= any
           more, because the panes are divs in this document rather than
           named frames (a named target is exactly what Safari drops). #}
        <a class="font-mono text-xs text-emerald-700 hover:underline shrink-0"
           data-pane="np-review" href="/nanopub/fi{{ n.row.ref_id }}"
           data-src="/claim/fi{{ n.row.ref_id }}">fi{{ n.row.ref_id }}</a>
        {# `tagline` (precis.workers.hub_tagline): the visible np-title
           text when the hub has a 3-6 word human handle set — full title
           stays in `title=` (hover). Absent → exactly the old render. #}
        <span class="np-title text-sm leading-snug" title="{{ n.row.title }}">{{ n.row.tagline or n.row.title }}</span>
        {% if n.row.trusty_uri %}
        <span class="font-mono text-xs text-slate-400 shrink-0"
              title="{{ n.row.trusty_uri }}">{{ n.row.trusty_uri.rsplit('/', 1)[-1][:14] }}…</span>
        {% endif %}
        {% if n.row.drifted %}<span class="text-xs text-amber-600 shrink-0 cursor-help"
              title="The live hub title no longer matches the frozen approved sentence — signing is blocked; reopen and re-approve, or revert the edit.">drifted</span>{% endif %}
      </summary>
      {% if n.evidence or n.children %}
      <ul class="ml-6 border-l border-slate-200 pl-3">
        {% for e in n.evidence %}
        <li class="tree-node mt-0.5 flex items-center gap-2 rounded px-2 py-0.5 text-xs text-slate-500 cursor-pointer hover:bg-slate-100"
            {% if e.kind == 'finding' %}data-pane="np-review" data-src="/claim/fi{{ e.ref_id }}"
            {% elif e.kind == 'paper' %}data-pane="np-paper" data-src="/papers/{{ e.ref_id }}"{% endif %}>
          <span class="w-3"></span>
          <span class="font-mono px-1 rounded cursor-help
            {% if e.relation == 'contradicts' %}bg-rose-50 text-rose-600
            {% elif e.relation == 'establishes' %}bg-emerald-50 text-emerald-600
            {% else %}bg-slate-100 text-slate-500{% endif %}"
            title="{% if e.relation == 'contradicts' %}This source disputes the claim — publication is blocked until the dispute is adjudicated.{% elif e.relation == 'establishes' %}This source's passage directly asserts the claim — its primary grounding.{% elif e.relation == 'corroborates' %}This source's passage independently supports the claim.{% elif e.relation == 'derived-from' %}The claim was derived from this source, grounded through its pinned passage.{% else %}{{ e.relation }}{% endif %}">{{ e.relation }}</span>
          {% if e.kind == 'finding' %}
          <a class="truncate hover:underline" data-pane="np-review"
             href="/nanopub/fi{{ e.ref_id }}" data-src="/claim/fi{{ e.ref_id }}"
             title="{{ e.title }}">{{ e.title }}</a>
          {% elif e.kind == 'paper' %}
          <a class="truncate hover:underline" data-pane="np-paper"
             href="/papers/{{ e.ref_id }}" title="{{ e.title }}">{{ e.title }}</a>
          {% else %}
          <a class="truncate hover:underline" href="/refs/{{ e.kind }}/{{ e.ref_id }}"
             title="{{ e.title }}">{{ e.title }}</a>
          {% endif %}
          <span class="text-slate-400 shrink-0">{{ e.kind }}</span>
        </li>
        {% endfor %}
        {% for c in n.children %}{{ node(c) }}{% endfor %}
      </ul>
      {% endif %}
    </details>
  </li>
  {% endmacro %}

  <div id="np-panes" class="flex items-stretch" style="height: calc(100vh - 9rem); min-height: 480px;">
    <div id="pane-tree" class="overflow-y-auto min-w-0 pr-1" style="width: 34%">
      {% if roots %}
      <ul>
        {% for n in roots %}{{ node(n) }}{% endfor %}
      </ul>
      {% else %}
      <p class="text-sm text-slate-500">No claim hubs yet.</p>
      {% endif %}

      <details class="mt-4 text-sm">
        <summary class="cursor-pointer text-xs font-semibold uppercase tracking-wide text-slate-400">
          OTS batches{% if batches %} ({{ batches|length }}){% endif %}
        </summary>
        {% if batches %}
        <table class="text-xs mt-2">
          <thead>
            <tr class="text-left uppercase tracking-wide text-slate-400 border-b border-slate-200">
              <th class="py-1.5 pr-4">Batch</th><th class="py-1.5 pr-4">Created</th>
              <th class="py-1.5 pr-4">Leaves</th><th class="py-1.5 pr-4">Proof</th>
              <th class="py-1.5 pr-4">Merkle root</th>
            </tr>
          </thead>
          <tbody>
            {% for b in batches %}
            <tr class="border-b border-slate-100">
              <td class="py-1 pr-4 font-mono">{{ b.id }}</td>
              <td class="py-1 pr-4">{{ b.created_at.strftime('%Y-%m-%d') }}</td>
              <td class="py-1 pr-4">{{ b.leaf_count }}</td>
              <td class="py-1 pr-4">
                <span class="{% if b.proof_state == 'upgraded' %}text-emerald-600{% elif b.proof_state == 'pending' %}text-amber-600{% else %}text-rose-600{% endif %}">
                  {{ b.proof_state or 'MISSING' }}
                </span>
              </td>
              <td class="py-1 pr-4 font-mono text-slate-400">{{ b.merkle_root[:24] }}…</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        {% else %}
        <p class="text-xs text-slate-500 mt-2">No batches — the OTS sweep is dark
          (<code>PRECIS_OTS_ENABLED</code>) or nothing signed yet.</p>
        {% endif %}
      </details>
    </div>

    <div class="np-divider" data-pane="pane-tree"></div>

    <div id="pane-review" class="min-w-0" style="width: 36%">
      {# Panes are DIVS, not iframes. Everything the workbench needs to do to
         a pane — navigate it, read what it shows, route a click out of it —
         had to cross a frame boundary before, and every mechanism for doing
         that (named targets, parent-document reach, the chrome-less query
         flag, Basic auth replay into a subframe) is one Safari drops or
         refuses. In one document a pane load is an innerHTML swap and a
         click is just a click. #}
      <div id="np-review" role="region" aria-label="claim review"
           class="w-full h-full overflow-y-auto rounded-lg border border-slate-200 bg-white p-4"
           {% if preload_src %}data-preload="{{ preload_src }}"{% endif %}
           data-placeholder="Click a claim on the left — its review page (state, evidence DAG, approve/sign action) loads here."></div>
    </div>

    <div class="np-divider" data-pane="pane-review"></div>

    <div id="pane-paper" class="min-w-0 flex-1">
      <div id="np-paper" role="region" aria-label="paper reader"
           class="w-full h-full overflow-hidden rounded-lg border border-slate-200 bg-white px-4"
           data-placeholder="Click an evidence paper — its reader loads here."></div>
    </div>
  </div>
</div>

<style>
  .tree-node.selected { background: #ecfdf5; }
  /* No clamp: a review row should show the whole claim sentence, not a
     truncated preview. min-width:0 keeps the flex-shrink behaviour the old
     overflow:hidden gave for free (a flex item's automatic minimum size is
     its content size otherwise, which would push the row wide instead of
     wrapping); overflow-wrap lets a long unbroken run still break. */
  .np-title { min-width: 0; overflow-wrap: break-word; }
  .np-loading { opacity: .45; transition: opacity .15s; }
  .np-hint { font: 13px system-ui; color: #94a3b8; padding: 1.5rem; }
  .np-steps { line-height: 0; }
  .np-dot { display: inline-block; width: 5px; height: 5px; border-radius: 9999px; background: #cbd5e1; margin-right: 2px; }
  .np-dot.on { background: #0284c7; }
  .np-dot.on.pub { background: #059669; }
  .np-divider { width: 7px; flex: none; cursor: col-resize; border-radius: 4px; margin: 0 1px; }
  .np-divider:hover, .np-divider.dragging { background: #a7f3d0; }
</style>
{# Loaded once for the whole workbench, not per swap: the paper fragment
   omits its own <script src> in pane mode (see _reader/reader.html.j2), so
   the ``paperDoc`` global is defined exactly once no matter how many papers
   the user opens. No `defer` — it must exist before Alpine walks a pane. #}
<script src="/static/paper-viewer.js"></script>
<script>
  // Panes are plain divs in THIS document, so a pane load is an innerHTML
  // swap. Everything below is same-document DOM work; nothing reaches
  // across a frame boundary, uses a named target, or threads a
  // chrome-less flag through the URL.

  const hint = pane => {
    pane.innerHTML = "";
    const p = document.createElement("p");
    p.className = "np-hint";
    p.textContent = pane.dataset.placeholder;
    pane.appendChild(p);
  };

  // Server-rendered markup dropped in by innerHTML is inert until Alpine
  // and htmx are told about it — the reader shell is one big x-data scope
  // and the claim body carries hx-get popovers. KaTeX needs the same
  // nudge: base.html.j2 typesets ``.tex-scope`` on DOMContentLoaded and on
  // ``htmx:afterSwap``, and a plain innerHTML assignment fires neither, so
  // a grounding quote's $…$ would sit here as raw TeX. (All three no-op if
  // the library is absent, matching paper-viewer.js::_loadRefs.)
  // An inline <script> inserted by innerHTML is inert — the HTML spec
  // refuses to execute it. A framed pane was a real document whose scripts
  // ran on load, so de-iframing silently killed the claim page's own
  // wiring (the evidence DAG's boxes stopped opening their detail card).
  // Re-create each script element so it runs; fragment scripts are
  // IIFE-wrapped, so re-running one on the next swap redeclares nothing.
  const runScripts = node => {
    node.querySelectorAll("script").forEach(old => {
      const s = document.createElement("script");
      for (const a of old.attributes) s.setAttribute(a.name, a.value);
      s.textContent = old.textContent;
      old.replaceWith(s);
    });
  };

  const afterSwap = node => {
    if (window.Alpine && window.Alpine.initTree) window.Alpine.initTree(node);
    if (window.htmx) window.htmx.process(node);
    if (window.renderTexScopes) window.renderTexScopes(node);
    // Last: the fragment's own scripts bind to a DOM the steps above have
    // finished processing.
    runScripts(node);
  };

  // One loader for every way a pane gets content. Dims the pane while the
  // request is in flight so a slow claim reads as "loading", not as a dead
  // click — the failure mode this whole refactor is chasing.
  const loadPane = (paneId, src, row) => {
    const pane = document.getElementById(paneId);
    if (!pane) return;
    if (row) {
      document.querySelectorAll(".tree-node.selected").forEach(x => x.classList.remove("selected"));
      row.classList.add("selected");
    }
    pane.classList.add("np-loading");
    // Hover-preview cards are x-teleport'd to <body>, so they sit OUTSIDE
    // the pane and an innerHTML replacement cannot reach them — without
    // this they accumulate as orphans pointing at unloaded content
    // (smartdraft's swapFrom reaps them for the same reason).
    document.querySelectorAll("body > .ref-popover").forEach(el => el.remove());
    return fetch(src, { headers: { "HX-Request": "true" }, credentials: "same-origin", cache: "no-store" })
      .then(r => r.text())
      .then(html => { pane.innerHTML = html; afterSwap(pane); })
      .catch(() => { pane.innerHTML = '<p class="np-hint">could not load — try again</p>'; })
      .finally(() => pane.classList.remove("np-loading"));
  };

  // Which pane a URL belongs in. Claims are reviewed, documents are read;
  // the permalink resolvers /c/<chunk> and /r/paper/<id> 303 onto a
  // document, so they are paper-bound too.
  const paneFor = (href, target) => {
    let u;
    try { u = new URL(href, location.href); } catch { return null; }
    if (u.host !== location.host) return null;
    if (target === "precis-paper" || u.pathname.startsWith("/papers/")
        || u.pathname.startsWith("/c/") || u.pathname.startsWith("/r/paper/")) return "np-paper";
    if (u.pathname.startsWith("/claim/")) return "np-review";
    return null;
  };

  const syncUrl = src => {
    const m = /^\/claim\/fi(\d+)/.exec(src);
    if (!m) return;
    history.pushState({ np: src }, "", "/nanopub/fi" + m[1]);
    document.querySelectorAll(".tree-node.selected").forEach(x => x.classList.remove("selected"));
    const row = document.querySelector('.tree-node[data-src="/claim/fi' + m[1] + '"]');
    if (row) row.classList.add("selected");
  };

  // ONE delegated click handler for the whole workbench: tree rows, the
  // pane-hinted anchors, and every link inside a loaded pane. Modified
  // clicks (cmd/ctrl/shift/middle) fall through to the browser untouched,
  // which is why the anchors keep a real href.
  document.addEventListener("click", ev => {
    if (ev.metaKey || ev.ctrlKey || ev.shiftKey || ev.altKey || ev.button !== 0) return;
    const a = ev.target.closest("a[href], a[data-src]");
    if (a) {
      // An explicit data-pane (tree + evidence links) wins; otherwise
      // classify by destination, but only for links inside a pane.
      let pane = a.dataset.pane || null;
      if (!pane && a.closest("#np-review, #np-paper")) pane = paneFor(a.href, a.target);
      if (!pane) {
        // A cross-host link inside a pane must leave the workbench rather
        // than navigate it away (publishers deny framing; we no longer
        // frame, but replacing the workbench with a paywall is worse).
        if (a.closest("#np-review, #np-paper") && a.host && a.host !== location.host) {
          a.target = "_blank"; a.rel = "noopener";
        }
        return;
      }
      const src = a.dataset.src || a.getAttribute("href");
      if (!src || src.startsWith("#")) return;
      ev.preventDefault();
      loadPane(pane, src, a.closest(".tree-node"));
      if (pane === "np-review") syncUrl(src);
      return;
    }
    // Row click = load the row's pane (a bigger hit area than the link).
    const n = ev.target.closest(".tree-node");
    if (!n || !n.dataset.src) return;
    if (!ev.target.closest(".tree-caret")) ev.preventDefault();  // only the caret folds
    loadPane(n.dataset.pane, n.dataset.src, n);
    if (n.dataset.pane === "np-review") syncUrl(n.dataset.src);
  }, true);  // capture: must claim the click before base.html.j2's
             // named-window opener, which skips defaultPrevented clicks.

  // Forms inside a pane (ask-a-follow-up, the unacquirable declaration,
  // approve/sign) used to post inside the iframe and get redirected back
  // into it. In one document an unintercepted submit would navigate the
  // whole workbench away, so post out-of-band and swap the reply — the
  // 303 lands on /claim/<head>, and HX-Request survives the redirect, so
  // what comes back is the fragment.
  document.addEventListener("submit", ev => {
    const form = ev.target.closest("form");
    if (!form) return;
    const pane = form.closest("#np-review, #np-paper");
    if (!pane) return;
    ev.preventDefault();
    const body = new FormData(form);
    if (ev.submitter && ev.submitter.name) body.append(ev.submitter.name, ev.submitter.value);
    pane.classList.add("np-loading");
    fetch(form.getAttribute("action") || location.href, {
      method: (form.getAttribute("method") || "POST").toUpperCase(),
      body: body,
      headers: { "HX-Request": "true" },
      credentials: "same-origin",
    })
      .then(r => r.text())
      .then(html => { pane.innerHTML = html; afterSwap(pane); })
      .catch(() => { pane.innerHTML = '<p class="np-hint">could not submit — try again</p>'; })
      .finally(() => pane.classList.remove("np-loading"));
  });

  // Back/forward across claims the user opened in the review pane.
  window.addEventListener("popstate", ev => {
    const src = (ev.state && ev.state.np) || null;
    const m = /^\/nanopub\/fi(\d+)/.exec(location.pathname);
    const target = src || (m ? "/claim/fi" + m[1] : null);
    const review = document.getElementById("np-review");
    if (!target) { if (review) hint(review); return; }
    loadPane("np-review", target, document.querySelector('.tree-node[data-src="' + target + '"]'));
  });

  // Initial state: a /nanopub/fi<id> deep link preloads its claim, the
  // bare index shows both hints.
  //
  // On DOMContentLoaded, not inline: Alpine and htmx are loaded with
  // `defer`, so at parse time neither exists yet and afterSwap would
  // silently no-op on the preloaded claim — leaving its popovers and any
  // x-data scope inert. Deferred scripts have run by DOMContentLoaded.
  document.addEventListener("DOMContentLoaded", () => {
    document.querySelectorAll("#np-panes [data-placeholder]").forEach(pane => {
      if (pane.dataset.preload) {
        loadPane(pane.id, pane.dataset.preload, document.querySelector('.tree-node[data-src="' + pane.dataset.preload + '"]'));
      } else {
        hint(pane);
      }
    });
  });

  // Draggable dividers: each resizes the pane on its left; the last pane
  // flexes. Widths persist per pane in localStorage.
  document.querySelectorAll("#np-panes > [id^='pane-']").forEach(p => {
    const saved = localStorage.getItem("np-pane-" + p.id);
    if (saved && p.style.width) p.style.width = saved;
  });
  document.querySelectorAll(".np-divider").forEach(d => {
    d.addEventListener("pointerdown", ev => {
      const pane = document.getElementById(d.dataset.pane);
      const startX = ev.clientX, startW = pane.getBoundingClientRect().width;
      d.classList.add("dragging");
      d.setPointerCapture(ev.pointerId);
      // Iframes swallow pointermove — disable their hit-testing mid-drag.
      document.querySelectorAll("#np-panes iframe").forEach(f => f.style.pointerEvents = "none");
      const move = e => {
        const w = Math.max(160, startW + e.clientX - startX);
        pane.style.width = w + "px";
      };
      const up = () => {
        d.classList.remove("dragging");
        d.removeEventListener("pointermove", move);
        document.querySelectorAll("#np-panes iframe").forEach(f => f.style.pointerEvents = "");
        localStorage.setItem("np-pane-" + pane.id, pane.style.width);
      };
      d.addEventListener("pointermove", move);
      d.addEventListener("pointerup", up, { once: true });
    });
  });
</script>
{% endblock %}

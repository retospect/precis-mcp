{% extends "base.html.j2" %}
{% block title %}Nanopub tree{% endblock %}
{% block content %}
<div class="max-w-7xl mx-auto px-4 py-6 space-y-6">
  <div class="flex items-baseline justify-between">
    <div>
      <h1 class="text-xl font-semibold">Nanopub claim tree</h1>
      <p class="text-sm text-slate-400 mt-1">
        Compounds nest their conjunct atoms, refined claims nest under what
        they refine; evidence sources hang as leaves. Click a row to inspect
        it on the right.
        {{ n_nodes }} hub{{ 's' if n_nodes != 1 }} in the forest.
      </p>
    </div>
    <a class="text-sm text-emerald-400 hover:underline" href="/nanopub">queue table →</a>
  </div>

  {% macro state_badge(r) %}
  <span class="font-mono text-xs px-1.5 py-0.5 rounded shrink-0
    {% if r.disputed %}bg-rose-900/60 text-rose-200
    {% elif r.state == 'published' %}bg-emerald-900/60 text-emerald-200
    {% elif r.state in ('signed', 'anchored') %}bg-sky-900/60 text-sky-200
    {% elif r.state %}bg-slate-700 text-slate-200
    {% else %}bg-slate-800 text-slate-500{% endif %}">
    {%- if r.disputed %}◆ blocked{% else %}{{ r.state or 'unminted' }}{% endif -%}
  </span>
  {% endmacro %}

  {% macro node(n) %}
  <li class="mt-1">
    <details {% if n.children %}open{% endif %} class="group">
      <summary class="tree-node flex items-center gap-2 cursor-pointer list-none rounded px-2 py-1 hover:bg-slate-800/40"
               data-np="h{{ n.row.ref_id }}">
        {% if n.children or n.evidence %}
        <span class="tree-caret text-slate-500 text-xs w-3 group-open:rotate-90 transition-transform">▸</span>
        {% else %}
        <span class="w-3"></span>
        {% endif %}
        {{ state_badge(n.row) }}
        {% if n.relation %}
        <span class="text-xs text-slate-500 shrink-0">{{ 'conjunct' if n.relation == 'conjunct-of' else n.relation }}</span>
        {% endif %}
        <a class="font-mono text-xs text-emerald-400 hover:underline shrink-0"
           href="/nanopub/fi{{ n.row.ref_id }}">fi{{ n.row.ref_id }}</a>
        <span class="text-sm truncate" title="{{ n.row.title }}">{{ n.row.title }}</span>
        {% if n.row.trusty_uri %}
        <span class="font-mono text-xs text-slate-500 shrink-0"
              title="{{ n.row.trusty_uri }}">{{ n.row.trusty_uri.rsplit('/', 1)[-1][:14] }}…</span>
        {% endif %}
        {% if n.row.drifted %}<span class="text-xs text-amber-400 shrink-0">drifted</span>{% endif %}
      </summary>
      {% if n.evidence or n.children %}
      <ul class="ml-6 border-l border-slate-800 pl-3">
        {% for e in n.evidence %}
        <li class="tree-node mt-0.5 flex items-center gap-2 rounded px-2 py-0.5 text-xs text-slate-400 cursor-pointer hover:bg-slate-800/40"
            data-np="e{{ e.kind }}-{{ e.ref_id }}-{{ e.relation }}">
          <span class="w-3"></span>
          <span class="font-mono px-1 rounded
            {% if e.relation == 'contradicts' %}bg-rose-900/40 text-rose-300
            {% elif e.relation == 'establishes' %}bg-emerald-900/40 text-emerald-300
            {% else %}bg-slate-800 text-slate-400{% endif %}">{{ e.relation }}</span>
          <a class="truncate hover:underline"
             href="{% if e.kind == 'finding' %}/nanopub/fi{{ e.ref_id }}{% elif e.kind == 'paper' %}/papers/{{ e.ref_id }}{% else %}/refs/{{ e.kind }}/{{ e.ref_id }}{% endif %}"
             title="{{ e.title }}">{{ e.title }}</a>
          <span class="text-slate-600 shrink-0">{{ e.kind }}</span>
        </li>
        {% endfor %}
        {% for c in n.children %}{{ node(c) }}{% endfor %}
      </ul>
      {% endif %}
    </details>
  </li>
  {% endmacro %}

  <div class="lg:grid lg:grid-cols-3 lg:gap-6">
    <div class="lg:col-span-2 min-w-0">
      {% if roots %}
      <ul>
        {% for n in roots %}{{ node(n) }}{% endfor %}
      </ul>
      {% else %}
      <p class="text-sm text-slate-500">No claim hubs yet.</p>
      {% endif %}
    </div>
    <div class="mt-6 lg:mt-0">
      <div id="np-detail"
           class="lg:sticky lg:top-4 rounded-md border border-slate-700 bg-slate-800/40 p-4 text-sm">
        <p class="text-slate-500 text-xs">Click a claim or evidence row to inspect it here.</p>
      </div>
    </div>
  </div>
</div>

<style>.tree-node.selected { background: rgba(51, 65, 85, 0.5); }</style>
<script>
  const NP_DETAIL = {{ detail | tojson }};
  const pane = document.getElementById("np-detail");
  function npEsc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  document.querySelectorAll(".tree-node").forEach(n => n.addEventListener("click", ev => {
    if (ev.target.closest("a")) return;                 // in-row links navigate
    if (!ev.target.closest(".tree-caret")) ev.preventDefault();  // only the caret folds
    document.querySelectorAll(".tree-node.selected").forEach(x => x.classList.remove("selected"));
    n.classList.add("selected");
    const d = NP_DETAIL[n.dataset.np];
    if (!d) return;
    pane.innerHTML =
      `<div class="text-[11px] uppercase tracking-wide text-slate-400">${npEsc(d.kind)}</div>` +
      `<h3 class="font-semibold mt-1">${npEsc(d.title)}</h3>` +
      `<table class="text-xs mt-2">` +
      d.fields.map(([k, v]) => `<tr><td class="text-slate-400 pr-3 py-0.5 align-top whitespace-nowrap">${npEsc(k)}</td><td class="break-all">${npEsc(v)}</td></tr>`).join("") +
      `</table>` +
      d.links.map(([t, u]) => `<a class="inline-block mt-2 mr-2 text-xs text-emerald-400 hover:underline" href="${npEsc(u)}">${npEsc(t)}</a>`).join("");
  }));
</script>
{% endblock %}

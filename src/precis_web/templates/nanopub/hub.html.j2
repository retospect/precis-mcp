{% extends "base.html.j2" %}
{% block title %}Nanopub fi{{ hub_id }}{% endblock %}
{% block content %}
<div class="max-w-7xl mx-auto px-4 py-6 space-y-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h1 class="text-lg font-semibold leading-snug max-w-3xl">{{ bundle.sentence }}</h1>
      <p class="text-xs text-slate-400 mt-1 font-mono">
        fi{{ hub_id }} · {{ bundle.artifact_type }} ·
        <a class="text-emerald-400 hover:underline" href="/claim/fi{{ hub_id }}">claim page</a> ·
        <a class="text-emerald-400 hover:underline" href="/nanopub">queue</a>
      </p>
    </div>
    <div class="text-right shrink-0">
      <span class="font-mono text-xs px-2 py-1 rounded
        {% if disputed %}bg-rose-900/60 text-rose-200
        {% elif state == 'published' %}bg-emerald-900/60 text-emerald-200
        {% else %}bg-slate-700 text-slate-200{% endif %}">
        {% if disputed %}◆ blocked (disputed){% else %}{{ state }}{% endif %}
      </span>
      {% if frozen %}
      <div class="text-[11px] text-slate-400 mt-1" title="frozen-ness ladder: reviewed freezes the string; signed/anchored freeze the artifact bytes (append-only, DB-trigger enforced); published is public forever">
        frozen: {{ frozen }}
      </div>
      {% endif %}
    </div>
  </div>

  {% if disputed %}
  <section class="rounded-md border border-rose-500/40 bg-rose-500/10 px-4 py-3 space-y-3">
    <h2 class="text-sm font-semibold text-rose-200">◆ Dispute — the actual conflict, side by side</h2>
    {% for d in disputes %}
    <div class="grid md:grid-cols-2 gap-3 text-sm">
      <div class="rounded bg-slate-800/60 p-3">
        <div class="text-[11px] uppercase tracking-wide text-slate-400 mb-1">this claim</div>
        <p>{{ (row.approved_title if row and row.approved_title else bundle.sentence) }}</p>
      </div>
      <div class="rounded bg-slate-800/60 p-3">
        <div class="text-[11px] uppercase tracking-wide text-rose-300 mb-1">
          contradicting passage — {{ d.paper_title }} (pc{{ d.paper_ref_id }})
        </div>
        {% if d.passage %}
        <blockquote class="italic text-slate-300">“{{ d.passage[:600] }}{% if d.passage|length > 600 %}…{% endif %}”</blockquote>
        {% else %}
        <p class="text-slate-400">No grounding passage pinned on the contradicts edge.</p>
        {% endif %}
        <div class="mt-2 flex gap-2 text-xs">
          {% if d.doi %}<a class="text-emerald-400 hover:underline" href="https://doi.org/{{ d.doi }}">DOI</a>{% endif %}
          <a class="text-emerald-400 hover:underline" href="/refs/{{ d.paper_ref_id }}">paper page</a>
          {% if not d.has_pdf %}
          <a class="text-amber-400 hover:underline" href="/papers-needed"
             title="the blocker is a missing primary — queue it for hand download">queue primary for acquisition</a>
          {% endif %}
        </div>
      </div>
    </div>
    {% endfor %}
    <p class="text-xs text-rose-200/80">No forward transition while the edge stands —
      visible internally, unpublishable externally.</p>
  </section>
  {% endif %}

  <div class="grid lg:grid-cols-5 gap-6">
    {# ── the DAG ── #}
    <div class="lg:col-span-3">
      <svg viewBox="0 0 {{ graph.width }} {{ graph.height }}" class="w-full h-auto"
           role="img" aria-label="claim DAG">
        <defs>
          <marker id="np-arr" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="7" markerHeight="7" orient="auto">
            <path d="M0,0 L8,4 L0,8 z" fill="#94a3b8" opacity=".7"/>
          </marker>
        </defs>
        {% for e in graph.edges %}
        <path d="M{{ e.x1 }},{{ e.y1 }} L{{ e.x2 }},{{ e.y2 }}"
              fill="none" marker-end="url(#np-arr)"
              stroke="{% if e.cls == 'contradicts' %}#f43f5e{% else %}#64748b{% endif %}"
              stroke-width="1.5"
              {% if e.cls in ('contradicts', 'merkle') %}stroke-dasharray="5 4"{% endif %}/>
        <text x="{{ (e.x1 + e.x2) // 2 + 6 }}" y="{{ (e.y1 + e.y2) // 2 }}"
              class="fill-slate-400" font-size="10">{{ e.label }}</text>
        {% endfor %}
        {% for n in graph.nodes %}
        <g class="np-node cursor-pointer" data-id="{{ n.id }}" transform="translate({{ n.x - 100 }},{{ n.y - 28 }})">
          <rect width="200" height="56" rx="8" fill="#1e293b"
                stroke="{% if 'contradicts' in n.cls or 'disputed' in n.cls %}#f43f5e{% elif 'paper' in n.cls %}#b7791f{% elif 'atom' in n.cls %}#63b3ed{% elif 'anchor' in n.cls %}#94a3b8{% else %}#4fd1a5{% endif %}"
                stroke-width="2" {% if 'anchor' in n.cls %}stroke-dasharray="5 3"{% endif %}/>
          {% if 'disputed' in n.cls %}<text x="184" y="16" font-size="12" fill="#f43f5e">◆</text>{% endif %}
          <text x="10" y="22" font-size="11" class="fill-slate-100">{{ n.label }}</text>
          <text x="10" y="42" font-size="10" class="fill-slate-400">{{ n.sub }}</text>
        </g>
        {% endfor %}
      </svg>
      <div id="np-detail" class="mt-3 rounded-md border border-slate-700 bg-slate-800/40 p-4 text-sm">
        <p class="text-slate-500 text-xs">Select a node.</p>
      </div>
    </div>

    {# ── side panel: the publish row, rendered ── #}
    <div class="lg:col-span-2 space-y-4">
      <section class="rounded-md border border-slate-700 p-4 space-y-2 text-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Publish row</h2>
        {% if row %}
        <table class="text-xs w-full">
          <tbody>
            <tr><td class="text-slate-400 pr-3 py-0.5 align-top">state</td><td class="font-mono">{{ row.state }}</td></tr>
            <tr><td class="text-slate-400 pr-3 py-0.5 align-top">approved</td><td>{{ row.approved_title or '—' }}</td></tr>
            <tr><td class="text-slate-400 pr-3 py-0.5 align-top">aida</td><td class="font-mono break-all">{{ row.aida_uri or '—' }}</td></tr>
            <tr><td class="text-slate-400 pr-3 py-0.5 align-top">trusty</td><td class="font-mono break-all">
              {% if row.trusty_uri %}<a class="text-emerald-400 hover:underline" href="/np/{{ row.trusty_uri.rsplit('/', 1)[-1] }}">{{ row.trusty_uri }}</a>{% else %}—{% endif %}
            </td></tr>
            <tr><td class="text-slate-400 pr-3 py-0.5">batch</td><td class="font-mono">{{ row.batch_id or '—' }}{% if proof_state %} · proof {{ proof_state }}{% endif %}</td></tr>
            {% if row.published_at %}
            <tr><td class="text-slate-400 pr-3 py-0.5">published</td><td>{{ row.published_at.strftime('%Y-%m-%d') }} → {{ row.registry_url }}</td></tr>
            {% endif %}
          </tbody>
        </table>
        {% else %}
        <p class="text-slate-400 text-xs">No publish row yet — approving freezes the exact
          claim string below and creates one.</p>
        {% endif %}
      </section>

      {# ── one action, labelled by the state's transition ── #}
      <section class="rounded-md border border-slate-700 p-4 space-y-3 text-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Action</h2>
        {% if action == 'approve' %}
        <form method="post" action="/nanopub/fi{{ hub_id }}/approve" class="space-y-2">
          <label class="block text-xs text-slate-400">Exact string to freeze (the signature covers this):</label>
          <textarea name="title" rows="3" class="w-full bg-slate-800 border border-slate-700 rounded p-2 text-sm">{{ bundle.sentence }}</textarea>
          <label class="block text-xs text-slate-400">Grounding payload (quote + snip per passage — what you attest):</label>
          <textarea name="payload" rows="12" class="w-full bg-slate-800 border border-slate-700 rounded p-2 font-mono text-xs">{{ suggested_payload }}</textarea>
          <button class="px-3 py-1.5 rounded bg-emerald-700 hover:bg-emerald-600 text-white text-sm">{{ action_label }}</button>
          <p class="text-[11px] text-slate-500">Every Layer-A mint gate runs now — the queue only holds strings that can mint.</p>
        </form>
        {% elif action == 'sign' %}
        <form method="post" action="/nanopub/fi{{ hub_id }}/sign" class="space-y-2">
          <label class="flex items-center gap-2 text-xs text-slate-300">
            <input type="checkbox" name="attest" value="1">
            sign with the <b>attesting</b> key (your human signature — this is what makes it publishable)
          </label>
          <button class="px-3 py-1.5 rounded bg-emerald-700 hover:bg-emerald-600 text-white text-sm">{{ action_label }}</button>
          <p class="text-[11px] text-slate-500">The sign button signs for real; unchecked = bot key (machine provenance only).</p>
        </form>
        <form method="post" action="/nanopub/fi{{ hub_id }}/reopen">
          <button class="px-3 py-1.5 rounded border border-slate-600 text-slate-300 hover:bg-slate-800 text-xs">Reopen (edit the string)</button>
        </form>
        {% elif action == 'reopen' %}
        <form method="post" action="/nanopub/fi{{ hub_id }}/reopen">
          <button class="px-3 py-1.5 rounded border border-slate-600 text-slate-300 hover:bg-slate-800 text-sm">{{ action_label }}</button>
        </form>
        <p class="text-[11px] text-slate-500">Waiting for the OTS sweep to anchor; reopening discards the pointer
          (the artifact row itself is append-only, forever).</p>
        {% elif action == 'publish-cli' %}
        <p class="text-xs text-slate-300">{{ action_label }}:</p>
        <pre class="bg-slate-800 rounded p-2 text-xs font-mono">precis nanopub publish fi{{ hub_id }} --live</pre>
        <p class="text-[11px] text-slate-500">Deliberately not a web button — the registry POST propagates
          across mirrors forever.</p>
        {% else %}
        <p class="text-xs text-slate-400">{{ action_label }}</p>
        {% endif %}
      </section>

      {# ── withheld edges + sign-off doors ── #}
      {% if withheld %}
      <section class="rounded-md border border-amber-500/40 p-4 space-y-3 text-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-amber-300">
          Withheld evidence edges ({{ withheld|length }})
        </h2>
        <p class="text-[11px] text-slate-400">Neither verified-by-refine nor signed off — each blocks
          publication until verified, or attested literally below (no mute button).</p>
        {% for w in withheld %}
        <form method="post" action="/nanopub/fi{{ hub_id }}/signoff/{{ w.link_id }}" class="flex items-center gap-2">
          <span class="text-xs grow truncate" title="{{ w.paper_title }}">
            {{ w.relation }} ← {{ w.paper_title }} <span class="font-mono text-slate-500">pc{{ w.paper_ref_id }}</span>
          </span>
          <input name="note" placeholder="why it's ok (required)"
                 class="bg-slate-800 border border-slate-700 rounded px-2 py-1 text-xs w-44">
          <button class="px-2 py-1 rounded border border-amber-500/50 text-amber-300 hover:bg-amber-500/10 text-xs whitespace-nowrap">sign off</button>
        </form>
        {% endfor %}
      </section>
      {% endif %}

      {# ── publish preflight ── #}
      {% if row %}
      <section class="rounded-md border border-slate-700 p-4 space-y-1 text-sm">
        <h2 class="text-xs font-semibold uppercase tracking-wide text-slate-400">Publish preflight</h2>
        {% if not preflight %}
        <p class="text-emerald-400 text-xs">clear to publish — every publish-time gate passes</p>
        {% else %}
        <ul class="space-y-1">
          {% for i in preflight %}
          <li class="text-xs {% if i.blocking %}text-rose-300{% else %}text-slate-400{% endif %}">
            {{ '✖' if i.blocking else '·' }} <span class="font-mono">[{{ i.check }}]</span> {{ i.message }}
          </li>
          {% endfor %}
        </ul>
        {% endif %}
      </section>
      {% endif %}
    </div>
  </div>
</div>

<script>
  const NP_DETAIL = {{ graph.detail | tojson }};
  const pane = document.getElementById("np-detail");
  function npEsc(s) {
    return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;").replace(/"/g, "&quot;");
  }
  document.querySelectorAll(".np-node").forEach(n => n.addEventListener("click", () => {
    const d = NP_DETAIL[n.dataset.id];
    if (!d) return;
    let h = `<div class="text-[11px] uppercase tracking-wide text-slate-400">${npEsc(d.kind)}</div>` +
            `<h3 class="font-semibold mt-1">${npEsc(d.title)}</h3>` +
            `<table class="text-xs mt-2">` +
            d.fields.map(([k, v]) => `<tr><td class="text-slate-400 pr-3 py-0.5 align-top whitespace-nowrap">${npEsc(k)}</td><td class="break-all">${npEsc(v)}</td></tr>`).join("") +
            `</table>` +
            d.links.map(([t, u]) => `<a class="inline-block mt-2 mr-2 text-xs text-emerald-400 hover:underline" href="${npEsc(u)}">${npEsc(t)}</a>`).join("");
    pane.innerHTML = h;
  }));
</script>
{% endblock %}

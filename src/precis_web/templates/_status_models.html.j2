{# Models sub-tab — the `llm` catalog as cards, split by where a model is
   *sourced*: Cloud (a provider bills per-token) vs Local (a fleet host serves
   it over llama-swap). Read-only; the catalog is minted + kept true by the
   llm_reconcile pass, so there's nothing to edit here — this is the "what can
   we call, at what cost, from where" view. #}
<p class="text-sm text-slate-500 mb-4">
  Every model in the <code>llm</code> catalog the router can dispatch to.
  <strong>Cloud</strong> rungs bill per-token through a provider;
  <strong>Local</strong> rungs are served on the fleet
  {% if serving_hosts %}(<span class="font-mono">{{ ', '.join(serving_hosts) }}</span>){% endif %}
  over llama-swap — free, but capped by each host's parallel slots. The live
  backend flip + per-service model picks live on the
  <a href="/status?tab=services" class="text-emerald-700 hover:underline">Services</a> tab.
</p>

{# ── macro: capability dots (1–5 ordinal per axis) ───────────── #}
{% macro caps(items) %}
  {% set labels = {'code': 'code', 'long-context-recall': 'ctx', 'tool-structured': 'tools', 'reasoning-convergence': 'reason', 'summarize-extract': 'extract'} %}
  <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2">
    {% for c in items %}
    <div class="flex items-center gap-1" title="{{ c.axis }}: {{ c.score }}/5">
      <span class="text-[10px] uppercase tracking-wide text-slate-400 w-11">{{ labels.get(c.axis, c.axis) }}</span>
      <span class="flex gap-0.5">
        {% for i in range(1, 6) %}
        <span class="w-1.5 h-1.5 rounded-full {% if i <= c.score %}bg-sky-500{% else %}bg-slate-200{% endif %}"></span>
        {% endfor %}
      </span>
    </div>
    {% endfor %}
  </div>
{% endmacro %}

{# ── Cloud rungs ─────────────────────────────────────────────── #}
<section class="mb-8">
  <div class="flex items-baseline gap-2 mb-3">
    <h2 class="text-sm font-semibold">Cloud</h2>
    <span class="text-xs text-slate-400">{{ cloud_cards | length }} model{{ '' if cloud_cards|length == 1 else 's' }} · billed per-token · $ per 1M in / out</span>
  </div>
  {% if not cloud_cards %}
  <p class="text-xs text-slate-500">No cloud cards in the catalog.</p>
  {% else %}
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for c in cloud_cards %}
    <div class="rounded-lg border border-slate-200 bg-white p-4 flex flex-col">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="font-mono font-semibold text-sm text-slate-800 truncate" title="{{ c.model_id }}">{{ c.model_id }}</div>
          <div class="text-[11px] text-slate-400">{{ c.provider }}</div>
        </div>
        {% if c.tier %}
        <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium
          {% if c.tier == 'cloud-super' %}bg-violet-50 text-violet-700
          {% elif c.tier == 'cloud-mid' %}bg-sky-50 text-sky-700
          {% else %}bg-slate-100 text-slate-600{% endif %}">{{ c.tier.replace('cloud-', '') }}</span>
        {% endif %}
      </div>

      <div class="mt-2 flex items-baseline gap-1">
        {% if c.price_in is not none or c.price_out is not none %}
        <span class="text-lg font-semibold text-slate-800 tabular-nums">${{ '%g' % c.price_in if c.price_in is not none else '?' }}</span>
        <span class="text-slate-400 text-xs">/</span>
        <span class="text-sm text-slate-500 tabular-nums">${{ '%g' % c.price_out if c.price_out is not none else '?' }}</span>
        <span class="text-[10px] text-slate-400 ml-0.5">per 1M</span>
        {% else %}
        <span class="text-xs text-slate-400">price —</span>
        {% endif %}
      </div>

      <div class="mt-1 flex flex-wrap gap-x-2 gap-y-0.5 text-[11px] text-slate-500">
        {% if c.window %}<span title="max input tokens">{{ '{:,}'.format(c.window) }} ctx</span>{% endif %}
        {% if c.transport %}<span class="font-mono text-slate-400">{{ c.transport }}</span>{% endif %}
        {% if c.quant %}<span class="font-mono text-slate-400">{{ c.quant }}</span>{% endif %}
      </div>

      {% if c.caps %}{{ caps(c.caps) }}{% endif %}
      {% if c.prose %}<p class="mt-2 text-[11px] leading-snug text-slate-500 line-clamp-3">{{ c.prose }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

{# ── Local rungs (fleet-served) ──────────────────────────────── #}
<section class="mb-6">
  <div class="flex items-baseline gap-2 mb-3">
    <h2 class="text-sm font-semibold">Local</h2>
    <span class="text-xs text-slate-400">{{ local_cards | length }} model{{ '' if local_cards|length == 1 else 's' }} · served on the fleet · free</span>
  </div>
  {% if not local_cards %}
  <p class="text-xs text-slate-500">No local cards in the catalog.</p>
  {% else %}
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for c in local_cards %}
    <div class="rounded-lg border border-slate-200 bg-white p-4 flex flex-col">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="font-mono font-semibold text-sm text-slate-800 truncate" title="{{ c.model_id }}">{{ c.model_id }}</div>
          {% if c.tier %}<div class="text-[11px] text-slate-400">{{ c.tier }}</div>{% endif %}
        </div>
        {% if c.hosts %}
        <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium bg-emerald-50 text-emerald-700">served</span>
        {% else %}
        <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium bg-amber-50 text-amber-700" title="a tier anchor — the router resolves it to whichever concrete model is live">anchor</span>
        {% endif %}
      </div>

      {% if c.hosts %}
      <div class="mt-2 flex flex-wrap gap-1">
        {% for h in c.hosts %}
        <span class="inline-flex items-center gap-1 rounded bg-slate-100 px-1.5 py-0.5 text-[11px] text-slate-700"
              title="{{ h.endpoint or '' }}{% if h.model %} · {{ h.model }}{% endif %}">
          <span class="font-mono">{{ h.host }}</span>
          {% if h.slots %}<span class="text-slate-400">×{{ h.slots }}</span>{% endif %}
        </span>
        {% endfor %}
      </div>
      {% else %}
      <p class="mt-2 text-[11px] text-slate-400">Tier anchor — resolves to a live served model at dispatch.</p>
      {% endif %}

      {% if c.prose %}<p class="mt-2 text-[11px] leading-snug text-slate-500 line-clamp-3">{{ c.prose }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

{# Models sub-tab — the `llm` catalog as cards, split by where a model is
   *sourced*: Cloud (a provider bills per-token) vs Local (a fleet host serves
   it over llama-swap). Read-only; the catalog is minted + kept true by the
   llm_reconcile pass, so there's nothing to edit here — this is the "what can
   we call, at what cost, from where" view. #}
<p class="text-sm text-fg-subtle mb-4">
  Every model in the <code>llm</code> catalog the router can dispatch to.
  <strong>Cloud</strong> rungs bill per-token through a provider;
  <strong>Local</strong> rungs are served on the fleet
  {% if serving_hosts %}(<span class="font-mono">{{ ', '.join(serving_hosts) }}</span>){% endif %}
  over llama-swap — free, but capped by each host's parallel slots. The live
  backend flip + per-service model picks live on the
  <a href="/status?tab=services" class="text-success-strong hover:underline">Services</a> tab.
</p>

{# ── Active routing — what each capability tier dispatches to *now* ──
   Derived from the SAME resolvers dispatch walks (resolve_chain /
   resolve_model), so it reflects live operator chains, not the static
   catalog below. rung-0 is what the router tries first; any further rungs
   are the failover order. #}
{% if active_routing %}
<section class="mb-8">
  <div class="flex items-baseline gap-2 mb-3">
    <h2 class="text-sm font-semibold">Active routing</h2>
    <span class="text-xs text-fg-faint">
      what each capability tier dispatches to right now · cloud backend
      <span class="font-mono">{{ active_backend }}</span>
    </span>
  </div>
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    {% for r in active_routing %}
    <div class="rounded-lg border border-line bg-surface p-4 flex flex-col">
      <div class="flex items-center justify-between gap-2">
        <span class="rounded px-1.5 py-0.5 text-[10px] font-semibold uppercase tracking-wide
          {% if r.tier == 'frontier' %}bg-accent-subtle text-accent-strong
          {% elif r.tier == 'big' %}bg-info-subtle text-info-strong
          {% elif r.tier == 'medium' %}bg-teal-subtle text-teal-strong
          {% else %}bg-surface-muted text-fg-muted{% endif %}">{{ r.tier }}</span>
        <span class="text-[10px] rounded px-1.5 py-0.5
          {% if r.source == 'operator chain' %}bg-warning-subtle text-warning-strong{% else %}bg-surface-subtle text-fg-faint{% endif %}"
          title="{% if r.source == 'operator chain' %}an operator llm.chain.{{ r.tier }} override is set{% else %}the compiled default chain (no operator override){% endif %}">{{ r.source }}</span>
      </div>
      <div class="mt-2 font-mono font-semibold text-sm text-fg truncate" title="{{ r.active_model }}">{{ r.active_model }}</div>
      <div class="text-[11px] {% if r.active_placement == 'cloud' %}text-warning{% else %}text-success{% endif %}">
        {{ r.active_placement }} · primary rung
      </div>
      {% if r.rungs | length > 1 %}
      <div class="mt-2 pt-2 border-t border-line-subtle text-[11px] text-fg-subtle">
        <div class="text-[10px] uppercase tracking-wide text-fg-faint mb-1">failover</div>
        {% for rung in r.rungs %}
        <div class="flex items-center gap-1 {% if not loop.first %}text-fg-faint{% endif %}">
          <span class="tabular-nums text-fg-ghost">{{ loop.index }}.</span>
          <span class="font-mono truncate" title="{{ rung.model }}">{{ rung.model }}</span>
          <span class="text-fg-ghost">·</span>
          <span>{{ rung.placement }}</span>
          <span class="text-fg-ghost font-mono">{{ rung.transport }}</span>
        </div>
        {% endfor %}
      </div>
      {% else %}
      <div class="mt-1 text-[11px] font-mono text-fg-faint">{{ r.rungs[0].transport if r.rungs else '—' }}</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
</section>
{% endif %}

{# ── macro: capability dots (1–5 ordinal per axis) ───────────── #}
{% macro caps(items) %}
  {% set labels = {'code': 'code', 'long-context-recall': 'ctx', 'tool-structured': 'tools', 'reasoning-convergence': 'reason', 'summarize-extract': 'extract'} %}
  <div class="flex flex-wrap gap-x-3 gap-y-1 mt-2">
    {% for c in items %}
    <div class="flex items-center gap-1" title="{{ c.axis }}: {{ c.score }}/5">
      <span class="text-[10px] uppercase tracking-wide text-fg-faint w-11">{{ labels.get(c.axis, c.axis) }}</span>
      <span class="flex gap-0.5">
        {% for i in range(1, 6) %}
        <span class="w-1.5 h-1.5 rounded-full {% if i <= c.score %}bg-info-solid-soft{% else %}bg-surface-emphasis{% endif %}"></span>
        {% endfor %}
      </span>
    </div>
    {% endfor %}
  </div>
{% endmacro %}

{# ── Cloud rungs ─────────────────────────────────────────────── #}
<section class="mb-8">
  <div class="flex items-baseline gap-2 mb-3">
    <h2 class="text-sm font-semibold">Cloud</h2>
    <span class="text-xs text-fg-faint">{{ cloud_cards | length }} model{{ '' if cloud_cards|length == 1 else 's' }} · billed per-token · $ per 1M in / out</span>
  </div>
  {% if not cloud_cards %}
  <p class="text-xs text-fg-subtle">No cloud cards in the catalog.</p>
  {% else %}
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for c in cloud_cards %}
    <div class="rounded-lg border border-line bg-surface p-4 flex flex-col">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="font-mono font-semibold text-sm text-fg truncate" title="{{ c.model_id }}">{{ c.model_id }}</div>
          <div class="text-[11px] text-fg-faint">{{ c.provider }}</div>
        </div>
        {% if c.tier %}
        <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium
          {% if c.tier == 'frontier' %}bg-accent-subtle text-accent-strong
          {% elif c.tier == 'big' %}bg-info-subtle text-info-strong
          {% else %}bg-surface-muted text-fg-muted{% endif %}">{{ c.tier }}</span>
        {% endif %}
      </div>

      <div class="mt-2 flex items-baseline gap-1">
        {% if c.price_in is not none or c.price_out is not none %}
        <span class="text-lg font-semibold text-fg tabular-nums">${{ '%g' % c.price_in if c.price_in is not none else '?' }}</span>
        <span class="text-fg-faint text-xs">/</span>
        <span class="text-sm text-fg-subtle tabular-nums">${{ '%g' % c.price_out if c.price_out is not none else '?' }}</span>
        <span class="text-[10px] text-fg-faint ml-0.5">per 1M</span>
        {% else %}
        <span class="text-xs text-fg-faint">price —</span>
        {% endif %}
      </div>

      <div class="mt-1 flex flex-wrap gap-x-2 gap-y-0.5 text-[11px] text-fg-subtle">
        {% if c.window %}<span title="max input tokens">{{ '{:,}'.format(c.window) }} ctx</span>{% endif %}
        {% if c.transport %}<span class="font-mono text-fg-faint">{{ c.transport }}</span>{% endif %}
        {% if c.quant %}<span class="font-mono text-fg-faint">{{ c.quant }}</span>{% endif %}
      </div>

      {% if c.caps %}{{ caps(c.caps) }}{% endif %}
      {% if c.prose %}<p class="mt-2 text-[11px] leading-snug text-fg-subtle line-clamp-3">{{ c.prose }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

{# ── Local rungs (fleet-served) ──────────────────────────────── #}
<section class="mb-6">
  <div class="flex items-baseline gap-2 mb-3">
    <h2 class="text-sm font-semibold">Local</h2>
    <span class="text-xs text-fg-faint">{{ local_cards | length }} model{{ '' if local_cards|length == 1 else 's' }} · served on the fleet · free</span>
  </div>
  {% if not local_cards %}
  <p class="text-xs text-fg-subtle">No local cards in the catalog.</p>
  {% else %}
  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
    {% for c in local_cards %}
    <div class="rounded-lg border border-line bg-surface p-4 flex flex-col">
      <div class="flex items-start justify-between gap-2">
        <div class="min-w-0">
          <div class="font-mono font-semibold text-sm text-fg truncate" title="{{ c.model_id }}">{{ c.model_id }}</div>
          {% if c.tier %}<div class="text-[11px] text-fg-faint">{{ c.tier }}</div>{% endif %}
        </div>
        {% if c.hosts %}
        <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium bg-success-subtle text-success-strong">served</span>
        {% else %}
        <span class="shrink-0 rounded px-1.5 py-0.5 text-[10px] font-medium bg-warning-subtle text-warning-strong" title="a tier anchor — the router resolves it to whichever concrete model is live">anchor</span>
        {% endif %}
      </div>

      {% if c.hosts %}
      <div class="mt-2 flex flex-wrap gap-1">
        {% for h in c.hosts %}
        <span class="inline-flex items-center gap-1 rounded bg-surface-muted px-1.5 py-0.5 text-[11px] text-fg-secondary"
              title="{{ h.endpoint or '' }}{% if h.model %} · {{ h.model }}{% endif %}">
          <span class="font-mono">{{ h.host }}</span>
          {% if h.slots %}<span class="text-fg-faint">×{{ h.slots }}</span>{% endif %}
        </span>
        {% endfor %}
      </div>
      {% else %}
      <p class="mt-2 text-[11px] text-fg-faint">Tier anchor — resolves to a live served model at dispatch.</p>
      {% endif %}

      {% if c.prose %}<p class="mt-2 text-[11px] leading-snug text-fg-subtle line-clamp-3">{{ c.prose }}</p>{% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

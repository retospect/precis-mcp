{% extends "base.html.j2" %}
{% block title %}Refs{% endblock %}
{% block content %}
<form method="get" action="/refs" class="mb-4 rounded-lg border border-line bg-surface p-3">
  <div class="flex items-center gap-2 mb-3">
    <input name="q" value="{{ q }}" placeholder="search title…"
           class="w-80 rounded-md border border-line-strong px-3 py-1.5 text-sm" />
    <button class="rounded-md bg-success-solid text-on-solid text-sm px-4 py-1.5">Search</button>
    {% if q or all_lit %}<a href="/refs" class="text-sm text-fg-subtle underline">clear</a>{% endif %}
    <span class="ml-auto text-xs text-fg-faint">{{ total }} ref{{ '' if total == 1 else 's' }} shown</span>
  </div>
  <fieldset>
    <legend class="text-xs uppercase tracking-wide text-fg-subtle mb-1">Include kinds</legend>
    <div class="flex flex-wrap gap-2">
      {% for k in all_browsable %}
      <label class="inline-flex items-center gap-1 text-xs px-2 py-1 rounded border
                    {% if k in selected %}border-info-strong bg-info-subtle text-info-deep
                    {% else %}border-line bg-surface-subtle text-fg-muted{% endif %}">
        <input type="checkbox" name="kinds" value="{{ k }}"
               {% if k in selected %}checked{% endif %}
               class="rounded border-line-strong" />
        <span class="font-mono">{{ k }}</span>
      </label>
      {% endfor %}
    </div>
    <div class="mt-2 flex items-center gap-3 text-xs text-fg-subtle">
      <label class="inline-flex items-center gap-1">
        <input type="checkbox" name="all" value="1" {% if all_lit %}checked{% endif %} />
        <span>all kinds (override checkboxes)</span>
      </label>
      <span class="text-fg-faint">default checked: {{ default_kinds | join(', ') }}</span>
    </div>
  </fieldset>
</form>

{% if not by_kind and not by_kind_md %}
<p class="text-sm text-fg-subtle">
  No refs match{% if q %} <code>{{ q }}</code>{% endif %}.
  {% if not q and selected %}Try broadening the kinds or check <strong>all kinds</strong>.{% endif %}
</p>
{% else %}
<div class="space-y-4">
  {# Handler-searched kinds (skill / tag) have no refs rows — their
     search verb returns markdown, rendered verbatim with ref handles
     linkified. #}
  {% for kind, md in by_kind_md.items() %}
  <section class="rounded-lg border border-line bg-surface overflow-hidden">
    <header class="flex items-center justify-between px-3 py-2 bg-surface-subtle border-b border-line">
      <h2 class="text-sm font-semibold text-fg-secondary">
        <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-surface-emphasis text-fg-secondary">{{ kind }}</span>
      </h2>
      <span class="text-xs text-fg-faint">search result</span>
    </header>
    <div class="px-3 py-2 text-sm text-fg-secondary whitespace-pre-wrap overflow-x-auto">{{ md | linkify_refs }}</div>
  </section>
  {% endfor %}
  {% for kind, rows in by_kind.items() %}
  <section class="rounded-lg border border-line bg-surface overflow-hidden">
    <header class="flex items-center justify-between px-3 py-2 bg-surface-subtle border-b border-line">
      <h2 class="text-sm font-semibold text-fg-secondary">
        <span class="text-xs font-mono px-1.5 py-0.5 rounded bg-surface-emphasis text-fg-secondary">{{ kind }}</span>
        <span class="ml-1 text-fg-subtle">{{ rows | length }}</span>
      </h2>
      <a href="/refs/{{ kind }}{% if q %}?q={{ q | urlencode }}{% endif %}"
         class="text-xs text-info-strong hover:underline">open {{ kind }} list →</a>
    </header>
    <ul class="divide-y divide-line-subtle">
      {% for ref in rows %}
      <li class="px-3 py-1.5 flex items-center gap-3 text-sm">
        <span class="text-xs text-fg-faint w-12 shrink-0">#{{ ref.id }}</span>
        <a href="{{ ref.url }}" class="flex-1 truncate hover:text-success-strong">
          {{ ref.display_title }}
        </a>
      </li>
      {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
{% endif %}
{% endblock %}

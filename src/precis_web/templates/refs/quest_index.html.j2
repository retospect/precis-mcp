{% extends "base.html.j2" %}
{% block title %}Quests{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-3">{{ kind_label }}</h1>

{% macro status_chip(status) %}
<span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium
  {% if status == 'active' %}bg-success-muted text-success-deep
  {% elif status == 'dormant' %}bg-warning-muted text-warning-deep
  {% else %}bg-surface-emphasis text-fg-secondary{% endif %}">
  STATUS:{{ status }}
</span>
{% endmacro %}

{% macro quest_row(node, depth) %}
<li class="px-4 py-2 flex items-start gap-3" style="padding-left: {{ 1 + depth * 1.5 }}rem;">
  <span class="font-mono text-xs text-fg-faint w-14 shrink-0 pt-0.5">qu{{ node.id }}</span>
  <a href="/refs/quest/{{ node.id }}"
     class="text-sm font-medium text-info-strong hover:underline flex-1 break-words">
    {{ node.headline }}
  </a>
  {{ status_chip(node.status) }}
  {% if node.prio is not none %}
  <span class="inline-flex items-center px-2 py-0.5 rounded-full text-xs font-medium bg-info-muted text-info-deep">
    PRIO:{{ node.prio }}
  </span>
  {% endif %}
  <span class="text-xs text-fg-faint w-32 shrink-0 text-right pt-0.5">{{ node.updated }}</span>
</li>
{% for child in node.children %}
{{ quest_row(child, depth + 1) }}
{% endfor %}
{% endmacro %}

{% if not forest %}
<p class="text-sm text-fg-subtle">No quests yet.</p>
{% else %}
<ul class="divide-y divide-line-subtle rounded-lg border border-line bg-surface">
  {% for root in forest %}
  {{ quest_row(root, 0) }}
  {% endfor %}
</ul>
{% endif %}
{% endblock %}

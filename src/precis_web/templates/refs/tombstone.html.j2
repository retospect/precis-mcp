{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% block title %}{{ kind_label }} deleted — #{{ ref.id }}{% endblock %}
{% block content %}
{{ drive_back(kind, kind_label) }}

<div class="mt-4 max-w-xl rounded-lg border border-amber-300 bg-amber-50 p-5">
  <div class="flex items-center gap-2 text-amber-800">
    <span class="text-lg">🪦</span>
    <h1 class="text-lg font-semibold">This {{ kind_label | lower }} was deleted</h1>
  </div>

  <p class="mt-2 text-sm text-slate-700">
    <span class="font-medium">{{ ref.title }}</span>
  </p>
  <p class="mt-1 text-sm text-slate-500">
    #{{ ref.id }}
    {% if ref.slug %}· <span class="font-mono break-all">{{ ref.slug }}</span>{% endif %}
    {% if ref.created %}· created {{ ref.created }}{% endif %}
    {% if ref.updated %}· deleted around {{ ref.updated }}{% endif %}
  </p>

  <p class="mt-3 text-sm text-slate-600">
    The reference still exists but is soft-deleted, so a link pointing here no
    longer resolves. Undelete restores it (body, links, and all) to a live ref.
  </p>

  <form method="post" action="/refs/{{ kind }}/{{ ref.id }}/undelete" class="mt-4">
    <button type="submit"
            class="rounded-md bg-emerald-600 px-3 py-1.5 text-sm font-medium text-white hover:bg-emerald-700">
      Undelete this {{ kind_label | lower }}
    </button>
  </form>
</div>
{% endblock %}

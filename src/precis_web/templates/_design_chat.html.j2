{# The design-chat panel (the design-workbench build, slice 3 (2026-09-18)),
   shared by /se/{slug} and /structure/{slug}. ``chat`` is
   ``precis_web.design_chat.panel_context``; ``rev``/``rev_current`` are
   the scrubber's numbers (the read-only note names them).

   Server-rendered, no polling: a turn is one blocking POST that 303s back
   here with ``?turn=N`` (block N gets the ring), ``?chat_error=`` or
   ``?chat_note=``. The only client JS is handle accumulation —
   ``window.designChatAddHandle(name)`` — which the viewers call on a
   block/atom click: it drops ``@name`` at the textarea caret and adds the
   name to the hidden ``handles`` field. Vendored assets only, no egress. #}
{% macro design_chat(chat, rev, rev_current) -%}
<div id="design-chat" class="mt-6">
  <h2 class="text-sm font-semibold text-fg-secondary mb-2">Design chat
    <span class="text-xs font-normal text-fg-faint">— click a {{ 'component instance' if chat.kind == 'pcb' else ('block' if chat.kind == 'se' else 'atom') }} to mention it, describe the change; {{ 'PCB changes always require explicit Apply' if chat.kind == 'pcb' else 'pure block ops apply as a revision, everything else proposes' }}</span>
  </h2>

  {% if chat.read_only %}
  <p id="design-chat-readonly" class="text-xs text-fg-subtle">Read-only — you are viewing revision {{ rev }} of {{ rev_current }}; chat on
    <a class="text-success-strong hover:underline" href="/{{ chat.kind }}/{{ chat.slug | urlencode }}#design-chat">the current revision</a>.</p>
  {% else %}

  {% if chat.chat_error %}
  <div id="design-chat-error" class="mb-2 rounded border border-danger bg-danger-subtle px-2 py-1 text-xs text-danger-deep">
    <span class="font-semibold">turn failed — nothing written:</span> {{ chat.chat_error }}
  </div>
  {% endif %}
  {% if chat.chat_note %}
  <div id="design-chat-note" class="mb-2 rounded border border-warning bg-warning-subtle px-2 py-1 text-xs text-warning-deep">
    <span class="font-semibold">no ops — nothing written:</span> {{ chat.chat_note }}
  </div>
  {% endif %}

  {# ── transcript, oldest → newest ── #}
  <div id="design-chat-transcript" class="space-y-2">
    {% if not chat.turns %}
    <p class="text-xs text-fg-faint">No turns yet.</p>
    {% endif %}
    {% for t in chat.turns %}
    <div id="chat-turn-{{ t.ord }}" data-turn="{{ t.handle }}"
         class="rounded-lg border bg-surface p-2 text-xs {% if t.ord == chat.chat_turn %}border-success-emphasis ring-1 ring-success{% else %}border-line{% endif %}">
      <div class="flex items-center gap-2 mb-1">
        <code class="text-[10px] text-fg-faint">~{{ t.ord }}</code>
        {% if t.handles %}<span class="text-[10px] text-fg-faint">@ {{ t.handles | join(', ') }}</span>{% endif %}
        {% if t.created %}<span class="ml-auto text-[10px] text-fg-faint">{{ t.created }}</span>{% endif %}
      </div>
      <div class="whitespace-pre-wrap"><span class="font-semibold text-fg-secondary">you:</span> {{ t.message }}</div>
      <div class="mt-1 whitespace-pre-wrap"><span class="font-semibold text-fg-secondary">model:</span> {{ t.rationale or '(no rationale)' }}</div>
      {% if t.ops %}
      <pre class="mt-1 max-h-32 overflow-auto rounded bg-surface-subtle p-1.5 font-mono text-[11px] text-fg-secondary whitespace-pre">{% for op in t.ops %}{{ op.json }}
{% endfor %}</pre>
      {% endif %}
      <div class="mt-1 text-fg-subtle">
        {% if t.revision %}
          {% if t.proposal %}proposal · {% endif %}applied as <a class="text-success-strong hover:underline" href="/{{ chat.kind }}/{{ chat.slug | urlencode }}?rev={{ t.revision }}">revision {{ t.revision }}</a>
        {% elif t.proposal %}
          proposal ·
          {% if t.valid %}<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-success-muted text-success-deep">valid</span>
          {% else %}<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-danger-muted text-danger-deep">invalid</span> {{ t.error }}{% endif %}
          {% if chat.pending and chat.pending.ord == t.ord %}<span class="text-fg-faint">— awaiting Apply below</span>{% endif %}
        {% elif t.rejected %}
          <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-danger-muted text-danger-deep">rejected</span> {{ t.error }} <span class="text-fg-faint">— nothing written to the design</span>
        {% elif t.noop %}
          <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-warning-muted text-warning-deep">no-op</span> <span class="text-fg-faint">cannot be expressed as ops — nothing written to the design</span>
        {% else %}
          {{ t.outcome }}
        {% endif %}
      </div>
      {% if t.repair %}
      <div class="mt-1 text-[10px] text-fg-faint">first attempt rejected: {{ t.repair }} — one repair round</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {# ── the pending proposal → human Apply ── #}
  {% if chat.pending %}
  <div id="design-chat-proposal" class="mt-3 rounded-lg border border-line bg-surface-subtle p-3">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-semibold text-fg-secondary">Proposed {{ chat.pending.ops | length }} op(s)</span>
      {% if chat.pending.valid %}
      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-success-muted text-success-deep">valid</span>
      {% else %}
      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-danger-muted text-danger-deep">invalid: {{ chat.pending.error }}</span>
      {% endif %}
      <code class="ml-auto text-[10px] text-fg-faint">{{ chat.pending.handle }}</code>
    </div>
    {% if chat.pending.rationale %}<p class="text-xs text-fg-subtle mb-2">{{ chat.pending.rationale }}</p>{% endif %}
    <div class="space-y-1">
      {% for op in chat.pending.ops %}
      <div class="sv-hl text-xs font-mono rounded px-2 py-1 border border-line bg-surface cursor-default hover:bg-warning-subtle"
           {% if op.atoms %}data-atoms="{{ op.atoms }}"{% endif %} data-desc="{{ op.json }}">{{ op.json }}</div>
      {% endfor %}
    </div>
    {% if chat.pending.valid %}
    <form method="post" action="{{ chat.chat_apply_url }}" class="mt-2 flex items-center gap-2">
      {% if chat.kind == 'pcb' %}
      <input type="hidden" name="shown" value="{{ chat.context.shown.snapshot }}">
      {% else %}<input type="hidden" name="ops" value="{{ chat.pending.ops_json }}">{% endif %}
      <input type="hidden" name="turn" value="{{ chat.pending.handle }}">
      <button class="rounded bg-success-solid text-on-solid text-xs px-3 py-1 hover:bg-success-solid-strong whitespace-nowrap">Apply as a new revision</button>
      <span class="text-[10px] text-fg-faint">{{ 'edits this design in place (version +1) — Fork stays a separate action' if chat.kind == 'structure' else 'writes one revision carrying this turn' }}</span>
    </form>
    {% else %}
    <p class="mt-2 text-[10px] text-fg-faint">Not applicable as proposed — ask for a correction in the next turn.</p>
    {% endif %}
  </div>
  {% endif %}

  {# ── the input ── #}
  <form id="design-chat-form" method="post" action="{{ chat.chat_url }}" class="mt-3">
    <textarea id="design-chat-message" name="message" rows="3" required
              placeholder="{{ 'e.g. lock the selected resistor, or propose moving it to x=10 mm' if chat.kind == 'pcb' else ('e.g. add a block @linker between @tube and @bud' if chat.kind == 'se' else 'e.g. put an O on top of @aPd1, then measure the Pd–O distance') }}"
              class="w-full rounded border border-line-strong px-2 py-1 text-sm"></textarea>
    <div class="mt-1 flex items-center gap-2">
      {% if chat.kind == 'pcb' %}<input type="hidden" id="pcb-chat-context" name="context" value="">{% endif %}
      <input type="hidden" id="design-chat-handles" name="handles" value="">
      <span id="design-chat-chips" class="flex flex-wrap gap-1 text-[10px] text-fg-subtle"></span>
      <button class="ml-auto rounded bg-solid-strong text-on-solid text-sm px-3 py-1 hover:bg-solid-strong whitespace-nowrap">Send ▸</button>
    </div>
    <p class="mt-1 text-[10px] text-fg-faint">One blocking turn (~30 s). The model returns typed ops only — {{ 'one selected instance move in mm/degrees, explicit Apply' if chat.kind == 'pcb' else 'never coordinates, never a tool call' }}.</p>
  </form>

  <script>
  (function () {
    const ta = document.getElementById('design-chat-message');
    const hidden = document.getElementById('design-chat-handles');
    const chips = document.getElementById('design-chat-chips');
    if (!ta || !hidden) { return; }
    const names = [];
    function renderChips() {
      if (!chips) { return; }
      chips.textContent = '';
      names.forEach((n) => {
        const chip = document.createElement('span');
        chip.className = 'rounded-full bg-surface-muted px-1.5 py-0.5';
        chip.textContent = '@' + n;
        chips.appendChild(chip);
      });
    }
    // Called by the viewers on a block/atom click: ``@name`` lands at the
    // caret (a trailing space so the next word is not glued on), the
    // name in the hidden field once.
    window.designChatAddHandle = function (name) {
      if (!name) { return; }
      const s = String(name);
      const start = ta.selectionStart != null ? ta.selectionStart : ta.value.length;
      const end = ta.selectionEnd != null ? ta.selectionEnd : start;
      const before = ta.value.slice(0, start);
      const pad = before.length && !/\s$/.test(before) ? ' ' : '';
      const insert = pad + '@' + s + ' ';
      ta.value = before + insert + ta.value.slice(end);
      const caret = start + insert.length;
      try { ta.setSelectionRange(caret, caret); } catch (e) { /* not focusable yet */ }
      if (names.indexOf(s) < 0) { names.push(s); }
      hidden.value = names.join(',');
      renderChips();
    };
    // Called by the 3D viewer's pick panel: a level's citable token
    // (``<se:UID#ATOM>``, ``<se:UID@3>``, …) lands at the caret as plain
    // text. Not a handle — handles are block names; a token resolves
    // through get(kind='se', view='pick', args={'token': …}).
    window.designChatAddToken = function (token) {
      if (!token) { return; }
      const start = ta.selectionStart != null ? ta.selectionStart : ta.value.length;
      const end = ta.selectionEnd != null ? ta.selectionEnd : start;
      const before = ta.value.slice(0, start);
      const pad = before.length && !/\s$/.test(before) ? ' ' : '';
      const insert = pad + String(token) + ' ';
      ta.value = before + insert + ta.value.slice(end);
      const caret = start + insert.length;
      try { ta.setSelectionRange(caret, caret); } catch (e) { /* not focusable yet */ }
    };
  })();
  </script>
  {% endif %}
</div>
{%- endmacro %}

{# The design-chat panel (the design-workbench build, slice 3 (2026-09-18)),
   shared by /se/{slug} and /structure/{slug}. ``chat`` is
   ``precis_web.design_chat.panel_context``; ``rev``/``rev_current`` are
   the scrubber's numbers (the read-only note names them).

   Server-rendered, no polling: a turn is one blocking POST that 303s back
   here with ``?turn=N`` (block N gets the ring), ``?chat_error=`` or
   ``?chat_note=``. The only client JS is handle accumulation —
   ``window.designChatAddHandle(name)`` — which the viewers call on a
   block/atom click: it drops ``@name`` at the textarea caret and adds the
   name to the hidden ``handles`` field. Vendored assets only, no egress. #}
{% macro design_chat(chat, rev, rev_current) -%}
<div id="design-chat" class="mt-6">
  <h2 class="text-sm font-semibold text-slate-700 mb-2">Design chat
    <span class="text-xs font-normal text-slate-400">— click a {{ 'block' if chat.kind == 'se' else 'atom' }} to mention it, describe the change; pure block ops apply as a revision, everything else proposes</span>
  </h2>

  {% if chat.read_only %}
  <p id="design-chat-readonly" class="text-xs text-slate-500">Read-only — you are viewing revision {{ rev }} of {{ rev_current }}; chat on
    <a class="text-emerald-700 hover:underline" href="/{{ chat.kind }}/{{ chat.slug | urlencode }}#design-chat">the current revision</a>.</p>
  {% else %}

  {% if chat.chat_error %}
  <div id="design-chat-error" class="mb-2 rounded border border-red-200 bg-red-50 px-2 py-1 text-xs text-red-800">
    <span class="font-semibold">turn failed — nothing written:</span> {{ chat.chat_error }}
  </div>
  {% endif %}
  {% if chat.chat_note %}
  <div id="design-chat-note" class="mb-2 rounded border border-amber-200 bg-amber-50 px-2 py-1 text-xs text-amber-800">
    <span class="font-semibold">no ops — nothing written:</span> {{ chat.chat_note }}
  </div>
  {% endif %}

  {# ── transcript, oldest → newest ── #}
  <div id="design-chat-transcript" class="space-y-2">
    {% if not chat.turns %}
    <p class="text-xs text-slate-400">No turns yet.</p>
    {% endif %}
    {% for t in chat.turns %}
    <div id="chat-turn-{{ t.ord }}" data-turn="{{ t.handle }}"
         class="rounded-lg border bg-white p-2 text-xs {% if t.ord == chat.chat_turn %}border-emerald-400 ring-1 ring-emerald-200{% else %}border-slate-200{% endif %}">
      <div class="flex items-center gap-2 mb-1">
        <code class="text-[10px] text-slate-400">~{{ t.ord }}</code>
        {% if t.handles %}<span class="text-[10px] text-slate-400">@ {{ t.handles | join(', ') }}</span>{% endif %}
        {% if t.created %}<span class="ml-auto text-[10px] text-slate-400">{{ t.created }}</span>{% endif %}
      </div>
      <div class="whitespace-pre-wrap"><span class="font-semibold text-slate-700">you:</span> {{ t.message }}</div>
      <div class="mt-1 whitespace-pre-wrap"><span class="font-semibold text-slate-700">model:</span> {{ t.rationale or '(no rationale)' }}</div>
      {% if t.ops %}
      <pre class="mt-1 max-h-32 overflow-auto rounded bg-slate-50 p-1.5 font-mono text-[11px] text-slate-700 whitespace-pre">{% for op in t.ops %}{{ op.json }}
{% endfor %}</pre>
      {% endif %}
      <div class="mt-1 text-slate-500">
        {% if t.revision %}
          {% if t.proposal %}proposal · {% endif %}applied as <a class="text-emerald-700 hover:underline" href="/{{ chat.kind }}/{{ chat.slug | urlencode }}?rev={{ t.revision }}">revision {{ t.revision }}</a>
        {% elif t.proposal %}
          proposal ·
          {% if t.valid %}<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">valid</span>
          {% else %}<span class="text-[10px] px-1.5 py-0.5 rounded-full bg-red-100 text-red-800">invalid</span> {{ t.error }}{% endif %}
          {% if chat.pending and chat.pending.ord == t.ord %}<span class="text-slate-400">— awaiting Apply below</span>{% endif %}
        {% elif t.rejected %}
          <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-red-100 text-red-800">rejected</span> {{ t.error }} <span class="text-slate-400">— nothing written to the design</span>
        {% elif t.noop %}
          <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800">no-op</span> <span class="text-slate-400">cannot be expressed as ops — nothing written to the design</span>
        {% else %}
          {{ t.outcome }}
        {% endif %}
      </div>
      {% if t.repair %}
      <div class="mt-1 text-[10px] text-slate-400">first attempt rejected: {{ t.repair }} — one repair round</div>
      {% endif %}
    </div>
    {% endfor %}
  </div>

  {# ── the pending proposal → human Apply ── #}
  {% if chat.pending %}
  <div id="design-chat-proposal" class="mt-3 rounded-lg border border-slate-200 bg-slate-50 p-3">
    <div class="flex items-center gap-2 mb-1">
      <span class="text-xs font-semibold text-slate-700">Proposed {{ chat.pending.ops | length }} op(s)</span>
      {% if chat.pending.valid %}
      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800">valid</span>
      {% else %}
      <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-red-100 text-red-800">invalid: {{ chat.pending.error }}</span>
      {% endif %}
      <code class="ml-auto text-[10px] text-slate-400">{{ chat.pending.handle }}</code>
    </div>
    {% if chat.pending.rationale %}<p class="text-xs text-slate-500 mb-2">{{ chat.pending.rationale }}</p>{% endif %}
    <div class="space-y-1">
      {% for op in chat.pending.ops %}
      <div class="sv-hl text-xs font-mono rounded px-2 py-1 border border-slate-200 bg-white cursor-default hover:bg-amber-50"
           {% if op.atoms %}data-atoms="{{ op.atoms }}"{% endif %} data-desc="{{ op.json }}">{{ op.json }}</div>
      {% endfor %}
    </div>
    {% if chat.pending.valid %}
    <form method="post" action="{{ chat.chat_apply_url }}" class="mt-2 flex items-center gap-2">
      <input type="hidden" name="ops" value="{{ chat.pending.ops_json }}">
      <input type="hidden" name="turn" value="{{ chat.pending.handle }}">
      <button class="rounded bg-emerald-600 text-white text-xs px-3 py-1 hover:bg-emerald-700 whitespace-nowrap">Apply as a new revision</button>
      <span class="text-[10px] text-slate-400">{{ 'edits this design in place (version +1) — Fork stays a separate action' if chat.kind == 'structure' else 'writes one revision carrying this turn' }}</span>
    </form>
    {% else %}
    <p class="mt-2 text-[10px] text-slate-400">Not applicable as proposed — ask for a correction in the next turn.</p>
    {% endif %}
  </div>
  {% endif %}

  {# ── the input ── #}
  <form id="design-chat-form" method="post" action="{{ chat.chat_url }}" class="mt-3">
    <textarea id="design-chat-message" name="message" rows="3" required
              placeholder="{{ 'e.g. add a block @linker between @tube and @bud' if chat.kind == 'se' else 'e.g. put an O on top of @aPd1, then measure the Pd–O distance' }}"
              class="w-full rounded border border-slate-300 px-2 py-1 text-sm"></textarea>
    <div class="mt-1 flex items-center gap-2">
      <input type="hidden" id="design-chat-handles" name="handles" value="">
      <span id="design-chat-chips" class="flex flex-wrap gap-1 text-[10px] text-slate-500"></span>
      <button class="ml-auto rounded bg-slate-800 text-white text-sm px-3 py-1 hover:bg-slate-900 whitespace-nowrap">Send ▸</button>
    </div>
    <p class="mt-1 text-[10px] text-slate-400">One blocking turn (~30 s). The model returns typed ops only — never coordinates, never a tool call.</p>
  </form>

  <script>
  (function () {
    const ta = document.getElementById('design-chat-message');
    const hidden = document.getElementById('design-chat-handles');
    const chips = document.getElementById('design-chat-chips');
    if (!ta || !hidden) { return; }
    const names = [];
    function renderChips() {
      if (!chips) { return; }
      chips.textContent = '';
      names.forEach((n) => {
        const chip = document.createElement('span');
        chip.className = 'rounded-full bg-slate-100 px-1.5 py-0.5';
        chip.textContent = '@' + n;
        chips.appendChild(chip);
      });
    }
    // Called by the viewers on a block/atom click: ``@name`` lands at the
    // caret (a trailing space so the next word is not glued on), the
    // name in the hidden field once.
    window.designChatAddHandle = function (name) {
      if (!name) { return; }
      const s = String(name);
      const start = ta.selectionStart != null ? ta.selectionStart : ta.value.length;
      const end = ta.selectionEnd != null ? ta.selectionEnd : start;
      const before = ta.value.slice(0, start);
      const pad = before.length && !/\s$/.test(before) ? ' ' : '';
      const insert = pad + '@' + s + ' ';
      ta.value = before + insert + ta.value.slice(end);
      const caret = start + insert.length;
      try { ta.setSelectionRange(caret, caret); } catch (e) { /* not focusable yet */ }
      if (names.indexOf(s) < 0) { names.push(s); }
      hidden.value = names.join(',');
      renderChips();
    };
  })();
  </script>
  {% endif %}
</div>
{%- endmacro %}

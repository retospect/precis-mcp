{% extends "base.html.j2" %}
{% from "_drive_back.html.j2" import drive_back %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
{# inline SVG fills the canvas box; declarative SMIL/CSS animation then plays #}
<style>#fig-canvas > svg { width: 100%; height: 100%; display: block; }</style>

<div class="mb-4 flex items-center gap-3">
  {{ drive_back('figure', 'Figures') }}
  <h1 class="text-lg font-semibold">{{ title }}</h1>
  <span class="text-xs text-fg-faint">{{ slug }} · canvas {{ vb_w }}×{{ vb_h }}</span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-2 gap-6">

  {# ── left: the canvas ── #}
  <div>
    <div class="relative rounded border border-line bg-surface overflow-hidden"
         style="aspect-ratio: {{ vb_w }} / {{ vb_h }};" data-tour="fig-canvas">
      {# the grid overlay — the shared coordinate frame (10% ticks) #}
      <div class="pointer-events-none absolute inset-0 z-10 opacity-40"
           style="background-image:
             linear-gradient(to right, #cbd5e1 1px, transparent 1px),
             linear-gradient(to bottom, #cbd5e1 1px, transparent 1px);
             background-size: 10% 10%;"></div>
      {# inline (not <img>) so browser-native animation plays; server-sanitized #}
      <div id="fig-canvas" class="absolute inset-0 z-0">{{ svg | safe }}</div>
    </div>
    <div class="mt-1 flex items-center gap-2 text-[11px] text-fg-faint">
      <span>viewBox {{ viewbox }}</span>
      <span class="ml-auto">grid = 10% of each axis</span>
    </div>
    <div id="fig-lints" class="mt-2 space-y-1 text-[11px]">
      {% for f in findings %}
      <div class="text-warning-strong">⚠ [{{ f.kind }}] {{ f.message }}</div>
      {% endfor %}
    </div>
    {# ── element → chunk bindings ── #}
    <div id="fig-bindings" class="mt-2 flex flex-wrap gap-1 text-[11px]{% if not bindings %} hidden{% endif %}">
      {% for b in bindings %}
      <span class="inline-flex items-center gap-1 rounded bg-info-subtle border border-info px-1.5 py-0.5 text-info-deep"
            title="{{ b.title }}">
        <span class="font-mono">{{ b.element }}</span>→<span class="font-mono">{{ b.handle }}</span>
      </span>
      {% endfor %}
    </div>
  </div>

  {# ── right: docs (two tabs) + chat ── #}
  <div class="flex flex-col gap-4">
    <div data-tour="fig-docs">
      <div class="flex items-center gap-1 mb-1">
        <button id="fig-tab-vocab" type="button"
                class="px-2 py-0.5 rounded text-xs font-semibold text-fg-secondary bg-surface-muted">Shared vocabulary</button>
        <button id="fig-tab-notes" type="button"
                class="px-2 py-0.5 rounded text-xs text-fg-subtle hover:bg-surface-subtle">Implementation notes</button>
        <span class="ml-auto text-[10px] text-fg-faint">vocab is for you · notes are the model's</span>
      </div>
      <pre id="fig-vocab" class="text-xs bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap max-h-40 overflow-y-auto">{{ vocab or '(empty — the model will describe what the drawing is)' }}</pre>
      <pre id="fig-notes" class="hidden text-xs bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap max-h-40 overflow-y-auto">{{ notes or "(empty — the model records ids / structure / conventions here)" }}</pre>
    </div>

    <div class="flex-1 min-h-0">
      <h2 class="text-xs font-semibold text-fg-subtle uppercase tracking-wide mb-1">Chat</h2>
      <div id="fig-chat" class="space-y-2 text-xs max-h-96 overflow-y-auto pr-1" data-tour="fig-chat">
        {% for t in turns %}
        <pre class="bg-surface-subtle border border-line rounded p-2 whitespace-pre-wrap">{{ t }}</pre>
        {% endfor %}
      </div>
    </div>

    <form id="fig-form" class="flex gap-2" data-slug="{{ slug }}" data-tour="fig-prompt">
      <input id="fig-msg" name="message" required autocomplete="off"
             placeholder="e.g. draw a round green face with two eyes…"
             class="flex-1 rounded border border-line-strong px-3 py-1.5 text-sm">
      <button id="fig-send" class="rounded bg-solid text-on-solid px-3 py-1.5 text-sm hover:bg-solid-soft">Send ▸</button>
    </form>
  </div>
</div>

{% endblock %}
{% block scripts %}
<script>
(function () {
  const form = document.getElementById('fig-form');
  const slug = form.getAttribute('data-slug');
  const chat = document.getElementById('fig-chat');
  const msg = document.getElementById('fig-msg');
  const send = document.getElementById('fig-send');
  const canvas = document.getElementById('fig-canvas');
  const vocab = document.getElementById('fig-vocab');
  const notes = document.getElementById('fig-notes');
  const lints = document.getElementById('fig-lints');
  const binds = document.getElementById('fig-bindings');
  const tabVocab = document.getElementById('fig-tab-vocab');
  const tabNotes = document.getElementById('fig-tab-notes');

  // ── the two doc tabs ──
  const ON = 'px-2 py-0.5 rounded text-xs font-semibold text-fg-secondary bg-surface-muted';
  const OFF = 'px-2 py-0.5 rounded text-xs text-fg-subtle hover:bg-surface-subtle';
  function showTab(which) {
    const v = which === 'vocab';
    vocab.classList.toggle('hidden', !v);
    notes.classList.toggle('hidden', v);
    tabVocab.className = v ? ON : OFF;
    tabNotes.className = v ? OFF : ON;
  }
  tabVocab.addEventListener('click', () => showTab('vocab'));
  tabNotes.addEventListener('click', () => showTab('notes'));

  function toBottom() { chat.scrollTop = chat.scrollHeight; }

  // textContent (never innerHTML) — model output is untrusted text.
  function bubble(text, cls) {
    const pre = document.createElement('pre');
    pre.className = 'border rounded p-2 whitespace-pre-wrap ' + cls;
    pre.textContent = text;
    chat.appendChild(pre);
    toBottom();
    return pre;
  }

  form.addEventListener('submit', function (e) {
    e.preventDefault();
    const text = msg.value.trim();
    if (!text) return;
    bubble('user: ' + text, 'bg-surface border-line');
    const pending = bubble('…thinking', 'bg-surface-subtle border-line text-fg-faint');
    msg.value = '';
    send.disabled = true;

    const body = new URLSearchParams();
    body.set('message', text);
    fetch('/figure/' + encodeURIComponent(slug) + '/turn', { method: 'POST', body })
      .then((r) => r.json())
      .then((d) => {
        if (d.error) { pending.textContent = 'error: ' + d.error; return; }
        pending.textContent = 'assistant: ' + (d.reply || '(no reply)');
        pending.className = 'border rounded p-2 whitespace-pre-wrap bg-surface-subtle border-line';
        if (d.changed && d.svg) {
          // Inline the server-sanitized SVG so SMIL/CSS animation plays.
          // innerHTML never executes <script>, and sanitize already stripped
          // handlers / external refs / css url() — sanitize is the trust boundary.
          canvas.innerHTML = d.svg;
        }
        // Reload the docs — they are the memory, and the model just revised them.
        if (typeof d.vocab === 'string' && d.vocab.trim()) vocab.textContent = d.vocab;
        if (typeof d.notes === 'string' && d.notes.trim()) notes.textContent = d.notes;
        lints.innerHTML = '';
        (d.findings || []).forEach((f) => {
          const div = document.createElement('div');
          div.className = 'text-warning-strong';
          div.textContent = '⚠ [' + f.kind + '] ' + f.message;
          lints.appendChild(div);
        });
        // Refresh the element→chunk binding chips.
        if (Array.isArray(d.bindings)) {
          binds.innerHTML = '';
          binds.classList.toggle('hidden', d.bindings.length === 0);
          d.bindings.forEach((b) => {
            const span = document.createElement('span');
            span.className = 'inline-flex items-center gap-1 rounded bg-info-subtle border border-info px-1.5 py-0.5 text-info-deep';
            span.title = b.title || '';
            const e = document.createElement('span'); e.className = 'font-mono'; e.textContent = b.element;
            const h = document.createElement('span'); h.className = 'font-mono'; h.textContent = b.handle;
            span.appendChild(e); span.append('→'); span.appendChild(h);
            binds.appendChild(span);
          });
        }
      })
      .catch((err) => { pending.textContent = 'request failed: ' + err; })
      .finally(() => { send.disabled = false; toBottom(); msg.focus(); });
  });

  toBottom();  // start scrolled to the latest turn, input ready
})();
</script>
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Alerts{% endblock %}
{% block content %}

{% set sev_badge = {
  'critical': 'bg-danger-muted text-danger-deep border-danger-strong',
  'warn': 'bg-warning-muted text-warning-deep border-warning-strong',
  'info': 'bg-info-muted text-info-deep border-info-strong'
} %}

<div class="flex items-center gap-3 mb-4">
  <h1 class="text-lg font-semibold">Alerts</h1>
  {# open vs resolved history toggle #}
  <div class="inline-flex rounded-md border border-line-strong overflow-hidden text-sm">
    <a href="/alerts"
       class="px-3 py-1 {% if state == 'open' %}bg-success-solid text-on-solid{% else %}bg-surface text-fg-muted hover:bg-surface-subtle{% endif %}">
      open
    </a>
    <a href="/alerts?state=resolved"
       class="px-3 py-1 {% if state == 'resolved' %}bg-success-solid text-on-solid{% else %}bg-surface text-fg-muted hover:bg-surface-subtle{% endif %}">
      resolved
    </a>
  </div>
  <span class="text-sm text-fg-subtle">{{ total }} {{ state }}</span>
</div>

{% if not groups %}
  {% if state == 'open' %}
  <div class="rounded-md border border-success-strong bg-success-subtle px-4 py-3 text-sm text-success-deep">
    ✓ All clear — no open alerts. Background passes (nursery &amp; friends)
    raise alerts here when they detect spin loops, orphaned todos, stalled
    recurrings, stale claims and the like.
  </div>
  {% else %}
  <p class="text-sm text-fg-subtle">No resolved alerts in the recent history.</p>
  {% endif %}
{% endif %}

{% for g in groups %}
<section class="mb-5">
  <h2 class="text-sm font-semibold text-fg-secondary mb-2 flex items-center gap-2">
    <span class="font-mono">{{ g.source }}</span>
    <span class="text-fg-faint font-normal">{{ g.count }}</span>
  </h2>
  <div class="overflow-hidden rounded-md border border-line">
    <table class="w-full text-sm">
      <tbody>
        {% for a in g.alerts %}
        <tr class="border-t border-line-subtle first:border-t-0 align-top{% if a.acked_until %} opacity-50{% endif %}">
          <td class="px-3 py-2 w-20">
            <span class="inline-block rounded border px-1.5 py-0.5 text-[11px] font-medium uppercase {{ sev_badge.get(a.severity, sev_badge['warn']) }}">
              {{ a.severity }}
            </span>
          </td>
          <td class="px-3 py-2">
            <div class="font-medium text-fg">
              <a href="/refs/alert/{{ a.ref_id }}" class="hover:underline">{{ a.title }}</a>
            </div>
            {% if a.detail %}
            <div class="text-fg-subtle mt-0.5">{{ a.detail }}</div>
            {% endif %}
            <div class="text-[12px] text-fg-faint mt-1 flex flex-wrap gap-x-3 gap-y-0.5">
              {% if a.subject_ref_id is not none %}
              <span>
                subject:
                {% if a.subject_kind %}
                <a href="/refs/{{ a.subject_kind }}/{{ a.subject_ref_id }}"
                   class="text-info-strong hover:underline font-mono">{{ a.subject_kind }}#{{ a.subject_ref_id }}</a>
                {% else %}
                <span class="font-mono">#{{ a.subject_ref_id }}</span>
                {% endif %}
              </span>
              {% endif %}
              {% if a.acked_until %}<span>acked until {{ a.acked_until[:16] }}Z</span>{% endif %}
              {% if a.seen_count > 1 %}<span>seen {{ a.seen_count }}×</span>{% endif %}
              <span>first {{ a.first_seen }}</span>
              <span>last {{ a.last_seen }}</span>
            </div>
          </td>
          {% if state == 'open' %}
          <td class="px-3 py-2 w-24 text-right">
            <form method="post" action="/alerts/{{ a.ref_id }}/{% if a.acked_until %}unack{% else %}ack{% endif %}" class="mb-1">
              <button type="submit"
                      title="{% if a.acked_until %}Clear the ack{% else %}Silence for 7 days — stays open, hidden from the badge and health checks{% endif %}"
                      class="rounded border border-line-strong bg-surface px-2 py-0.5 text-[12px] text-fg-muted hover:bg-surface-subtle hover:text-fg">
                {% if a.acked_until %}unack{% else %}ack 7d{% endif %}
              </button>
            </form>
            <form method="post" action="/alerts/{{ a.ref_id }}/resolve">
              <button type="submit"
                      title="Dismiss — marks resolved; re-raises if the condition persists"
                      class="rounded border border-line-strong bg-surface px-2 py-0.5 text-[12px] text-fg-muted hover:bg-surface-subtle hover:text-fg">
                dismiss
              </button>
            </form>
          </td>
          {% endif %}
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
</section>
{% endfor %}

{% endblock %}

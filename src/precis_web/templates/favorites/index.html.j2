{% extends "base.html.j2" %}
{% block title %}Favorites{% endblock %}
{% block content %}
<a href="/drive" class="text-xs text-fg-faint hover:text-fg-muted">&larr; Drive</a>

<div class="mt-2 mb-3">
  <h1 class="text-lg font-semibold">Favorites</h1>
  <p class="text-sm text-fg-subtle">
    Refs you hearted, newest first. Only you can see this list — it is
    keyed to your login, not shared.
  </p>
</div>

{% if rows %}
<ul class="divide-y divide-line-subtle rounded-lg border border-line bg-surface">
  {% for r in rows %}
  <li class="flex items-center gap-3 px-3 py-2">
    {# Everything listed is hearted — faved is always true here; the
       toggle's htmx swap re-renders the button as unfilled in place. #}
    {% set fav_kind, fav_id, faved = r.kind, r.ref_id, true %}
    {% include "_heart.html.j2" %}
    <span class="w-20 shrink-0 font-mono text-xs text-fg-subtle">{{ r.kind }}</span>
    {% if r.retired %}
      {# Tombstone: the ref is soft-deleted — the link lands on the
         generic detail route's tombstone view (undelete affordance),
         not the native reader or /graph, which would 404 on a miss. #}
      <a href="{{ r.reader_url }}" class="min-w-0 flex-1 truncate text-sm text-fg-faint line-through hover:underline"
         title="deleted — opens the tombstone page">{{ r.title | title_plain if r.title_is_md else r.title }}</a>
      <span class="shrink-0 rounded bg-warning-subtle px-1.5 py-0.5 text-[10px] font-medium text-warning-strong border border-warning">deleted</span>
    {% else %}
      {# Paper-family titles may carry publisher markup → md view rendered
         through render_markdown; other kinds' titles stay literal. #}
      <a href="{{ r.reader_url }}" class="min-w-0 flex-1 truncate text-sm text-info-strong hover:underline{% if r.title_is_md %} tex-scope{% endif %}">{% if r.title_is_md %}{{ r.title | title_md | render_markdown }}{% else %}{{ r.title }}{% endif %}</a>
      <a href="{{ r.graph_url }}" class="shrink-0 text-xs text-fg-faint hover:text-fg-muted hover:underline">graph</a>
    {% endif %}
    <span class="shrink-0 text-xs text-fg-faint" title="{{ r.updated_at }}">{{ r.updated_at | ago }}</span>
  </li>
  {% endfor %}
</ul>
{% else %}
<p class="rounded-lg border border-dashed border-line-strong bg-surface p-6 text-sm text-fg-subtle">
  Nothing hearted yet. The ♡ on a graph focus page or a ref/paper
  reader adds it here.
</p>
{% endif %}
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}Settings{% endblock %}
{% block content %}
<h1 class="text-lg font-semibold mb-1">Settings</h1>
<p class="text-sm text-fg-subtle mb-5 max-w-2xl">
  DB-resident config (<code>precis.settings</code>) — a saved row overrides
  the env var, which overrides the compiled default. Reflects
  <strong>db</strong>/<strong>env</strong>/<strong>default</strong> — which
  layer each key currently resolves from. "Clear" reverts to env/compiled.
</p>

{% if error %}
<div class="mb-5 rounded-lg border border-danger bg-danger-subtle px-4 py-2 text-sm text-danger-strong">
  {{ error }}
</div>
{% endif %}

<div class="rounded-lg border border-line bg-surface overflow-hidden">
  <table class="w-full text-sm">
    <thead class="bg-surface-subtle text-fg-subtle text-xs uppercase tracking-wide">
      <tr>
        <th class="text-left font-medium px-4 py-2">Key</th>
        <th class="text-left font-medium px-4 py-2">Value</th>
        <th class="text-left font-medium px-4 py-2">Layer</th>
        <th class="text-left font-medium px-4 py-2">Env var</th>
        <th class="text-left font-medium px-4 py-2 w-1/4">Set</th>
        <th class="px-4 py-2"></th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line-subtle">
      {% for r in rows %}
      <tr>
        <td class="px-4 py-2 align-middle">
          <span class="font-mono text-xs text-fg-secondary">{{ r.key }}</span>
          <div class="text-[10px] text-fg-faint max-w-xs">{{ r.doc }}</div>
        </td>
        <td class="px-4 py-2 align-middle font-mono text-xs text-fg-muted">
          {{ r.value if r.value is not none else '—' }}
        </td>
        <td class="px-4 py-2 align-middle">
          <span class="rounded px-1.5 py-0.5 text-[11px]
            {% if r.layer == 'db' %}bg-info-subtle text-info-strong
            {% elif r.layer == 'env' %}bg-warning-subtle text-warning-strong
            {% else %}bg-surface-muted text-fg-subtle{% endif %}">{{ r.layer }}</span>
          {% if r.layer == 'db' %}
          <div class="text-[10px] text-fg-ghost mt-1">
            {{ r.updated_at | ago if r.updated_at else '' }}
            {% if r.updated_by %}by {{ r.updated_by }}{% endif %}
          </div>
          {% endif %}
        </td>
        <td class="px-4 py-2 align-middle font-mono text-[11px] text-fg-faint">
          {{ r.env_var or '-' }}
        </td>
        <td class="px-4 py-2 align-middle">
          <form method="post" action="/settings/set" class="flex gap-2">
            <input type="hidden" name="key" value="{{ r.key }}" />
            <input type="text" name="value"
                   value="{{ r.value if r.value is not none else '' }}"
                   class="flex-1 rounded border border-line px-2 py-1 text-xs
                          font-mono focus:border-info-emphasis focus:outline-none" />
            <button type="submit"
                    class="rounded bg-info-solid text-on-solid text-xs px-3 py-1
                           hover:bg-info-solid-strong transition">Save</button>
          </form>
        </td>
        <td class="px-4 py-2 align-middle text-right">
          {% if r.layer == 'db' %}
          <form method="post" action="/settings/clear">
            <input type="hidden" name="key" value="{{ r.key }}" />
            <button type="submit"
                    class="text-xs text-fg-faint hover:text-danger transition">clear</button>
          </form>
          {% endif %}
        </td>
      </tr>
      {% else %}
      <tr><td colspan="6" class="px-4 py-6 text-center text-fg-faint">
        No registered settings keys.
      </td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endblock %}

{# Now sub-tab fragment — GET /status/now, htmx-polled every 10s.

   Centerpiece is the host activity strip: each worker process's CURRENT
   pass (or idle), straight from host_heartbeat.meta.activity
   (precis.workers.activity). Born of the 2026-08-09 fetch_oa
   monopolization postmortem — a long, log-silent pass otherwise looks
   identical to a dead worker short of `py-spy dump`. Below that, the
   kind='job' STATUS lanes (running / queued / recent-terminal) and
   active alerts round out "what is the cluster doing right now". #}

{# ── summary strip ───────────────────────────────────────────── #}
<div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-6">
  <div class="rounded-lg border border-line bg-surface p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint">Running</div>
    <div class="mt-1 text-2xl font-semibold">{{ jobs.running_count }}</div>
  </div>
  <div class="rounded-lg border border-line bg-surface p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint">Queued</div>
    <div class="mt-1 text-2xl font-semibold">{{ jobs.queued_count }}</div>
  </div>
  <div class="rounded-lg border {% if jobs.stalled_count %}border-warning-strong bg-warning-subtle{% else %}border-line bg-surface{% endif %} p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint">Stalled</div>
    <div class="mt-1 text-2xl font-semibold {% if jobs.stalled_count %}text-warning-strong{% endif %}">{{ jobs.stalled_count }}</div>
  </div>
  <div class="rounded-lg border {% if alerts.active %}border-danger-strong bg-danger-subtle{% else %}border-line bg-surface{% endif %} p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint">Active alerts</div>
    <div class="mt-1 text-2xl font-semibold {% if alerts.active %}text-danger-strong{% endif %}">{{ alerts.active|length }}</div>
  </div>
</div>

{# ── host activity — the centerpiece ─────────────────────────── #}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Worker activity</h2>
  {% if not now_hosts %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">
    No heartbeats yet.
  </p>
  {% else %}
  <div class="flex flex-wrap gap-2">
    {% for h in now_hosts %}
    <div class="rounded-lg border {% if h.stale %}border-line bg-surface-subtle{% else %}border-success bg-success-subtle{% endif %} px-3 py-2 text-xs min-w-[220px]">
      <div class="flex items-center gap-2">
        <span class="font-mono font-semibold text-fg">{{ h.host }}</span>
        {% if h.stale %}<span class="text-fg-faint">● stale</span>{% else %}<span class="text-success-strong">● live</span>{% endif %}
        <span class="text-fg-faint">{{ h.ago }}</span>
      </div>
      {% if not h.processes %}
      <div class="text-fg-faint mt-1">no activity reported</div>
      {% else %}
      <div class="mt-1 space-y-1">
        {% for p in h.processes %}
        <div class="rounded {% if p.idle %}bg-surface/70 border border-line{% else %}bg-info-muted border border-info-strong{% endif %} px-1.5 py-1">
          <div class="font-mono text-fg-secondary">{{ p.process }}</div>
          {% if p.idle %}
          <div class="text-fg-subtle">idle{% if p.last_pass %} · last <span class="font-mono">{{ p.last_pass }}</span> {{ p.finished_ago }}{% endif %}</div>
          {% else %}
          <div class="text-info-deep">
            <span class="font-mono font-semibold">{{ p.pass_name }}</span>
            <span class="text-info">· running {{ '%.1f'|format(p.running_minutes) }}m</span>
          </div>
          {% if p.detail %}
          <div class="text-fg-subtle truncate" title="{{ p.detail }}">{{ p.detail }}</div>
          {% endif %}
          {% endif %}
        </div>
        {% endfor %}
      </div>
      {% endif %}
    </div>
    {% endfor %}
  </div>
  {% endif %}
</section>

{# ── running jobs ─────────────────────────────────────────────── #}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Running jobs</h2>
  {% if not jobs.running %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">Nothing running.</p>
  {% else %}
  <div class="rounded-lg border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line-subtle">
        {% for j in jobs.running %}
        <tr class="hover:bg-surface-subtle {% if j.lease_expired %}bg-danger-subtle{% endif %}">
          <td class="px-4 py-2">
            <a class="text-fg-secondary hover:underline truncate" href="/refs/job/{{ j.ref_id }}">#{{ j.ref_id }} {{ j.title }}</a>
          </td>
          <td class="px-4 py-2 font-mono text-fg-subtle">{{ j.job_type or '—' }}</td>
          <td class="px-4 py-2 text-fg-subtle">{{ j.lease_host or '—' }}</td>
          <td class="px-4 py-2 {% if j.lease_expired %}text-danger-strong font-semibold{% else %}text-fg-subtle{% endif %}"
              {% if j.lease_until_title %}title="{{ j.lease_until_title }}"{% endif %}>
            {% if j.lease_expired %}lease expired {{ j.lease_relative }}{% elif j.lease_until %}lease expires {{ j.lease_relative }}{% else %}no lease{% endif %}
          </td>
          <td class="px-4 py-2 text-right text-fg-faint tabular-nums">since {{ j.since_ago }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

{# ── queued jobs ──────────────────────────────────────────────── #}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Queued jobs</h2>
  {% if not jobs.queued %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">Queue is empty.</p>
  {% else %}
  <div class="rounded-lg border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line-subtle">
        {% for j in jobs.queued %}
        <tr class="hover:bg-surface-subtle {% if j.stalled %}bg-warning-subtle{% endif %}">
          <td class="px-4 py-2">
            <a class="text-fg-secondary hover:underline truncate" href="/refs/job/{{ j.ref_id }}">#{{ j.ref_id }} {{ j.title }}</a>
          </td>
          <td class="px-4 py-2 font-mono text-fg-subtle">{{ j.job_type or '—' }}</td>
          <td class="px-4 py-2 text-right {% if j.stalled %}text-warning-strong font-semibold{% else %}text-fg-faint{% endif %} tabular-nums">
            {% if j.stalled %}stalled · {% endif %}queued {{ j.age_ago }}
          </td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

{# ── recent terminal ──────────────────────────────────────────── #}
<section class="mb-6">
  <h2 class="text-sm font-semibold mb-2">Recent terminal
    <span class="font-normal text-xs text-fg-faint">(last {{ jobs.terminal|length }})</span>
  </h2>
  {% if not jobs.terminal %}
  <p class="text-xs text-fg-subtle rounded-lg border border-line bg-surface px-4 py-3">No terminal jobs yet.</p>
  {% else %}
  <div class="rounded-lg border border-line bg-surface overflow-hidden">
    <table class="w-full text-sm">
      <tbody class="divide-y divide-line-subtle">
        {% for j in jobs.terminal %}
        <tr class="hover:bg-surface-subtle">
          <td class="px-4 py-2">
            <a class="text-fg-secondary hover:underline truncate" href="/refs/job/{{ j.ref_id }}">#{{ j.ref_id }} {{ j.title }}</a>
          </td>
          <td class="px-4 py-2 font-mono {% if j.status == 'failed' %}text-danger-strong{% elif j.status == 'cancelled' %}text-fg-subtle{% else %}text-success-strong{% endif %}">{{ j.status }}</td>
          <td class="px-4 py-2 text-right text-fg-faint tabular-nums">{{ j.when_ago }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}
</section>

{# ── alerts ───────────────────────────────────────────────────── #}
<section>
  <h2 class="text-sm font-semibold mb-2">Alerts</h2>
  {% if not alerts.active and not alerts.recent %}
  <div class="rounded-lg border border-success bg-success-subtle p-3 text-sm text-success-strong">
    <span class="inline-block w-2 h-2 rounded-full mr-1 align-middle bg-success-solid-soft"></span>
    No alerts.
  </div>
  {% else %}
  <ul class="rounded-lg border border-line bg-surface divide-y divide-line-subtle">
    {% for a in alerts.active %}
    <li class="px-4 py-2 text-xs flex items-center gap-2 bg-danger-subtle">
      <span class="inline-block w-2 h-2 rounded-full bg-danger-solid-soft"></span>
      <a class="text-fg-secondary hover:underline truncate" href="/refs/alert/{{ a.ref_id }}">#{{ a.ref_id }} {{ a.title }}</a>
      <span class="ml-auto text-fg-faint">{{ a.when }}</span>
    </li>
    {% endfor %}
    {% for a in alerts.recent %}
    <li class="px-4 py-2 text-xs flex items-center gap-2 text-fg-faint">
      <span class="inline-block w-2 h-2 rounded-full bg-surface-strong"></span>
      <a class="text-fg-subtle hover:underline truncate" href="/refs/alert/{{ a.ref_id }}">#{{ a.ref_id }} {{ a.title }}</a>
      <span class="ml-auto">resolved {{ a.when }}</span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
</section>

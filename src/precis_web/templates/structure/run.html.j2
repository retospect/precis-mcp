{# One compute run, in words.

   The run-cube card on /structure/{slug} is a glance: rung, numbers, settled
   or not. This page is the answer to "…and what does that actually mean?" —
   what the rung computes, what each number may and may not be compared to,
   how the relax converged, and where the numbers came from. The machine
   identity (cache key / structure sha) is real but is not what a reader came
   for, so it sits folded at the bottom. #}
{% extends "base.html.j2" %}
{% block title %}r{{ run.id }} · {{ title }}{% endblock %}
{% block content %}

<div class="mb-4">
  <div class="flex items-center gap-3 flex-wrap">
    <a href="/structure/{{ slug }}" class="text-xs text-slate-400 hover:text-slate-600">← {{ title }}</a>
    <h1 class="text-lg font-semibold">Run r{{ run.id }}</h1>
    <span class="text-xs text-slate-400">{{ slug }} · {{ run.created }}</span>
  </div>
</div>

<div class="max-w-3xl space-y-4">

  {# ── what ran ── #}
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="text-sm font-semibold px-2 py-0.5 rounded bg-slate-100 text-slate-700">{{ run.fidelity }} relax</span>
      <span class="text-xs text-slate-500">{{ run.rung_label }}</span>
      {% if run.model %}<span class="text-xs text-slate-400" title="{{ metric_help.model }}">{{ run.model }}</span>{% endif %}
      {% if run.status == 'succeeded' %}
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-emerald-100 text-emerald-800 border border-emerald-200"
              title="{{ metric_help.status }}">succeeded</span>
      {% elif run.status == 'running' %}
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-sky-100 text-sky-800 border border-sky-200"
              title="{{ metric_help.status }}">running</span>
      {% else %}
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-red-100 text-red-800 border border-red-200"
              title="{{ metric_help.status }}">{{ run.status }}</span>
      {% endif %}
      {% if run.cached %}
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-indigo-100 text-indigo-800 border border-indigo-200"
              title="{{ metric_help.cached }}">⚡ reused, no compute</span>
      {% endif %}
      {% if run.provenance == 'external' %}
        <span class="text-[10px] px-1.5 py-0.5 rounded-full bg-amber-100 text-amber-800 border border-amber-200"
              title="{{ metric_help.external }}">imported</span>
      {% endif %}
    </div>

    <p class="mt-3 text-sm text-slate-700">{{ run.rung_help }}</p>
    <p class="mt-2 text-sm text-slate-600">{{ run.origin }}</p>
    <p class="mt-2 text-xs text-slate-500">{{ run_kind_blurb }}</p>

    <div class="mt-3 pt-3 border-t border-slate-100 text-xs text-slate-500 flex flex-wrap items-center gap-x-4 gap-y-1">
      <span title="{{ metric_help.on_version }}">ran on design
        <a class="text-emerald-700 hover:underline" href="/structure/{{ slug }}">v{{ run.on_version }}</a></span>
      {% if run.rung_where %}<span>{{ run.rung_where }}</span>{% endif %}
      {% if run.job_id %}
      <span>dispatched as
        <a class="text-emerald-700 hover:underline" href="/refs/job/{{ run.job_id }}">job #{{ run.job_id }}</a>
        {% if run.job_status %}<span class="text-slate-400">({{ run.job_status }})</span>{% endif %}
        <span class="text-slate-400">— its log has the raw backend output</span></span>
      {% endif %}
    </div>
  </div>

  {# ── what it found ── #}
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-slate-700 mb-3">What it found</h2>
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
      <div>
        <div class="text-[10px] text-slate-400 uppercase tracking-wide">Energy</div>
        <div class="tabular-nums font-medium">{{ '%.4f'|format(run.energy) if run.energy is not none else '—' }}<span class="text-[10px] text-slate-400"> eV</span></div>
        <p class="mt-1 text-[11px] text-slate-500 leading-snug">{{ metric_help.energy }}</p>
      </div>
      <div>
        <div class="text-[10px] text-slate-400 uppercase tracking-wide">Max force</div>
        <div class="tabular-nums font-medium">{{ '%.4f'|format(run.max_force) if run.max_force is not none else '—' }}<span class="text-[10px] text-slate-400"> eV/Å</span></div>
        <p class="mt-1 text-[11px] text-slate-500 leading-snug">{{ metric_help.max_force }}</p>
      </div>
      <div>
        <div class="text-[10px] text-slate-400 uppercase tracking-wide">Steps</div>
        <div class="tabular-nums font-medium">{{ run.n_steps }}</div>
        <p class="mt-1 text-[11px] text-slate-500 leading-snug">{{ metric_help.steps }}</p>
      </div>
    </div>

    <p class="mt-3 text-sm">
      {% if run.converged %}
        <span class="text-emerald-700 font-medium">Settled.</span>
      {% else %}
        <span class="text-amber-700 font-medium">Did not settle.</span>
      {% endif %}
      <span class="text-slate-600">{{ metric_help.converged }}</span>
    </p>

    {% if run.max_disp %}
    <p class="mt-2 text-xs text-slate-500">The furthest any single atom travelled during the run:
      <span class="tabular-nums">{{ '%.3f'|format(run.max_disp) }} Å</span>.</p>
    {% endif %}
  </div>

  {# ── the convergence curve — the force per optimiser step ── #}
  {% if run.curve_svg %}
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-slate-700">How it settled
      <span class="text-xs font-normal text-slate-400">— largest force on any atom, step by step</span>
    </h2>
    <svg class="mt-3 w-full" viewBox="0 0 {{ curve_w }} {{ curve_h }}" preserveAspectRatio="none"
         style="height: 64px;" role="img"
         aria-label="convergence curve: max force per step, {{ '%.3f'|format(run.curve[0]) }} to {{ '%.3f'|format(run.curve[-1]) }} eV/Å">
      <polyline points="{{ run.curve_svg }}" fill="none" stroke="#0284c7" stroke-width="1.5"
                vector-effect="non-scaling-stroke" />
    </svg>
    <div class="mt-1 flex justify-between text-[11px] text-slate-500 tabular-nums">
      <span>step 1 · {{ '%.3f'|format(run.curve[0]) }} eV/Å</span>
      <span>step {{ run.curve | length }} · {{ '%.3f'|format(run.curve[-1]) }} eV/Å</span>
    </div>
    <p class="mt-2 text-[11px] text-slate-500">A curve that falls and flattens is a relax that found its
      minimum; one still descending at the last step ran out of steps, not out of forces.</p>
  </div>
  {% endif %}

  {# ── what it left behind ── #}
  <div class="rounded-lg border border-slate-200 bg-white p-4">
    <h2 class="text-sm font-semibold text-slate-700 mb-2">What it left behind</h2>
    <ul class="text-sm text-slate-600 space-y-1">
      <li>
        {% if run.has_geometry %}
          Relaxed geometry stored —
          <a class="text-emerald-700 hover:underline" href="/structure/{{ slug }}?run={{ run.id }}#mol">show these atoms in the cell viewer</a>.
        {% else %}
          No relaxed geometry stored for this run — the numbers were recorded without a geometry write-back.
        {% endif %}
      </li>
      <li>
        {% if run.has_forces %}
          Per-atom forces stored, so the strain on individual atoms can be read back.
        {% else %}
          No per-atom forces stored for this run.
        {% endif %}
      </li>
    </ul>
    {% if quest_context and quest_context.pathways %}
    <p class="mt-3 text-xs text-slate-500">Reaction barriers for this design are computed separately —
      {% for pw in quest_context.pathways %}<a class="text-emerald-700 hover:underline" href="/refs/pathway/{{ pw.ref_id }}">pathway #{{ pw.ref_id }}</a>{% if not loop.last %}, {% endif %}{% endfor %}.</p>
    {% endif %}
  </div>

  {# ── machine identity, folded: real, but not what a reader came for ── #}
  {% if run.cache_key or run.structure_sha or run.params or run.method %}
  <details class="rounded-lg border border-slate-200 bg-white">
    <summary class="cursor-pointer px-4 py-2 text-xs font-semibold text-slate-600">
      Technical details <span class="font-normal text-slate-400">— identity hashes and raw settings</span>
    </summary>
    <div class="px-4 pb-3 space-y-2 text-xs">
      {% if run.cache_key %}
      <div>
        <div class="text-slate-500" title="{{ metric_help.cache_key }}">cache key</div>
        <code class="font-mono text-[11px] text-slate-600 break-all select-all">{{ run.cache_key }}</code>
      </div>
      {% endif %}
      {% if run.structure_sha %}
      <div>
        <div class="text-slate-500" title="{{ metric_help.structure_sha }}">structure sha</div>
        <code class="font-mono text-[11px] text-slate-600 break-all select-all">{{ run.structure_sha }}</code>
      </div>
      {% endif %}
      {% if run.params %}
      <div>
        <div class="text-slate-500">settings the backend ran with</div>
        <pre class="font-mono text-[11px] text-slate-600 whitespace-pre-wrap break-all">{{ run.params | tojson(indent=2) }}</pre>
      </div>
      {% endif %}
      {% if run.method %}
      <div>
        <div class="text-slate-500">source method fingerprint (imported rows)</div>
        <pre class="font-mono text-[11px] text-slate-600 whitespace-pre-wrap break-all">{{ run.method | tojson(indent=2) }}</pre>
      </div>
      {% endif %}
    </div>
  </details>
  {% endif %}

</div>
{% endblock %}

{% extends "base.html.j2" %}
{% block title %}{{ title }}{% endblock %}
{% block content %}
<div class="rounded-lg border border-danger bg-danger-subtle p-6">
  <h1 class="text-lg font-semibold text-danger-deep">{{ title }} ({{ status }})</h1>
  <pre class="mt-3 whitespace-pre-wrap text-sm text-danger-strong">{{ detail }}</pre>
  {% if suggestions %}
  <p class="mt-3 text-sm text-fg-secondary">Did you mean:</p>
  <ul class="mt-1 space-y-1 text-sm">
    {% for s in suggestions %}
    <li><a class="font-mono text-success-strong hover:underline" href="{{ s.href }}">{{ s.label }}</a>{% if s.title %} <span class="text-fg-subtle">— {{ s.title }}</span>{% endif %}</li>
    {% endfor %}
  </ul>
  {% endif %}
  <a href="/" class="mt-4 inline-block text-sm text-danger-strong underline">back to start</a>
</div>
{% endblock %}

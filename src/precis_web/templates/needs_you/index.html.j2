{% extends "base.html.j2" %}
{% block title %}Needs you{% endblock %}
{% block content %}
<div class="flex items-baseline justify-between mb-4" data-tour="needs-you-queue">
  <h1 class="text-lg font-semibold">Needs you</h1>
  <span class="text-sm text-fg-subtle">
    {{ total }} ask{{ '' if total == 1 else 's' }} ·
    {{ triage_total }} to triage
  </span>
</div>

{% if not groups and not triage %}
<p class="text-sm text-fg-subtle">
  Nothing's waiting on you — no open
  <span class="font-mono">ask-user</span> todos, and no papers flagged <span class="font-mono">needs-triage</span>.
</p>
{% endif %}

{# ── Asks ───────────────────────────────────────────────────────── #}
{% if groups %}
<section class="mb-8">
  <h2 class="text-xs font-semibold uppercase tracking-wide text-fg-faint mb-3">
    Asks <span class="text-fg-ghost">— by class, then quest; answer to unlock the planner</span>
  </h2>
  {% with next_path = "/needs-you" %}{% include "asks/_groups.html.j2" %}{% endwith %}
</section>
{% endif %}

{# ── Needs triage ───────────────────────────────────────────────── #}
{% if triage %}
<section>
  <div class="flex items-baseline justify-between mb-3">
    <h2 class="text-xs font-semibold uppercase tracking-wide text-fg-faint">
      Needs triage <span class="text-fg-ghost">— papers with junk metadata to fix</span>
    </h2>
    <a href="/papers/triage" class="text-xs text-success-strong hover:underline">
      View all {{ triage_total }} &rarr;
    </a>
  </div>
  <ul class="divide-y divide-line-subtle rounded-lg border border-line bg-surface">
    {% for s in triage %}
    <li class="flex items-baseline gap-3 px-4 py-2">
      <span class="text-xs text-fg-faint w-12 shrink-0 font-mono">#{{ s.id }}</span>
      <a href="/papers/{{ s.id }}?triage=1" class="min-w-0 flex-1 text-sm text-fg hover:text-success-strong break-words">
        {{ s.title }}
      </a>
      {% if s.year %}<span class="text-xs text-fg-faint shrink-0">{{ s.year }}</span>{% endif %}
    </li>
    {% endfor %}
  </ul>
  {% if triage_more %}
  <p class="mt-2 text-xs text-fg-faint">
    + {{ triage_more }} more on the
    <a href="/papers/triage" class="text-success-strong hover:underline">Triage</a> page.
  </p>
  {% endif %}
</section>
{% endif %}
{% endblock %}

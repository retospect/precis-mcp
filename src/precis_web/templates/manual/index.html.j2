{% extends "base.html.j2" %}
{% block title %}Manual{% endblock %}
{% block content %}

<div class="mb-5">
  <h1 class="text-lg font-semibold">Manual</h1>
  <p class="text-sm text-fg-subtle">How to do the things this system is for.</p>
</div>

{% if chapters %}
<ol class="space-y-2 max-w-3xl">
  {% for c in chapters %}
  <li class="rounded-lg border border-line bg-surface p-4 hover:border-line-strong">
    <a href="/manual/{{ c.slug }}" class="block">
      <div class="flex items-baseline gap-2">
        <span class="text-xs font-semibold text-fg-faint">{{ c.number }}</span>
        <span class="font-medium text-fg">{{ c.title }}</span>
      </div>
      {% if c.blurb %}
      <p class="mt-1 text-sm text-fg-muted">{{ c.blurb }}</p>
      {% endif %}
    </a>
  </li>
  {% endfor %}
</ol>
{% else %}
<p class="text-sm text-fg-subtle">No chapters found.</p>
{% endif %}

{% endblock %}

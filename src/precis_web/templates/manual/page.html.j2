{% extends "base.html.j2" %}
{% block title %}{{ chapter.title }} — Manual{% endblock %}
{% block content %}

{# Rendered-markdown styling. The prebuilt tailwind.css carries no
   typography plugin and the markdown output has no classes to hang
   utilities on, so the chapter body is styled here, scoped to .manual. #}
<style>
  .manual h2 { font-size: 1rem; font-weight: 600; color: rgb(var(--text-fg)); margin: 1.75rem 0 .5rem; }
  .manual h3 { font-size: .875rem; font-weight: 600; color: rgb(var(--text-fg-secondary)); margin: 1.25rem 0 .35rem; }
  .manual p, .manual li { font-size: .875rem; line-height: 1.65; color: rgb(var(--text-fg-secondary)); }
  .manual p { margin: .6rem 0; }
  .manual ul, .manual ol { margin: .6rem 0 .6rem 1.25rem; }
  .manual ul { list-style: disc; }
  .manual ol { list-style: decimal; }
  .manual li { margin: .25rem 0; }
  .manual strong { font-weight: 600; color: rgb(var(--text-fg-strong)); }
  .manual code { font-size: .8125rem; background: rgb(var(--bg-surface-muted)); border-radius: .25rem; padding: .05rem .3rem; }
  .manual pre { background: rgb(var(--bg-surface-subtle)); border: 1px solid rgb(var(--border-line)); border-radius: .375rem;
                padding: .75rem 1rem; margin: .75rem 0; overflow-x: auto; }
  .manual pre code { background: none; padding: 0; font-size: .8125rem; line-height: 1.5; }
  .manual blockquote { border-left: 3px solid rgb(var(--border-line-strong)); background: rgb(var(--bg-surface-subtle)); margin: 1rem 0;
                       padding: .5rem .9rem; border-radius: 0 .25rem .25rem 0; }
  .manual blockquote p { margin: .3rem 0; color: rgb(var(--text-fg-muted)); }
  .manual table { width: 100%; margin: .9rem 0; border-collapse: collapse; font-size: .8125rem; }
  .manual th { text-align: left; font-weight: 600; color: rgb(var(--text-fg-muted)); background: rgb(var(--bg-surface-subtle));
               border: 1px solid rgb(var(--border-line)); padding: .35rem .6rem; }
  .manual td { border: 1px solid rgb(var(--border-line)); padding: .35rem .6rem; color: rgb(var(--text-fg-secondary)); vertical-align: top; }
  .manual a { color: rgb(var(--text-info-strong)); text-decoration: underline; text-underline-offset: 2px; }
</style>

<div class="flex gap-6 items-start">

  {# ── Chapter rail ─────────────────────────────────────────────── #}
  <nav class="hidden lg:block w-56 shrink-0 sticky top-4">
    <a href="/manual" class="block text-xs font-semibold text-fg-faint hover:text-fg-muted mb-2">Manual</a>
    <ol class="space-y-0.5">
      {% for c in chapters %}
      <li>
        <a href="/manual/{{ c.slug }}"
           class="block rounded px-2 py-1 text-xs leading-snug transition
                  {% if c.slug == chapter.slug %}bg-surface-emphasis font-medium text-fg-strong
                  {% else %}text-fg-subtle hover:bg-surface-muted hover:text-fg{% endif %}">
          {{ c.number }}. {{ c.title }}
        </a>
      </li>
      {% endfor %}
    </ol>
  </nav>

  {# ── Chapter body ─────────────────────────────────────────────── #}
  <article class="min-w-0 max-w-3xl flex-1">
    <div class="mb-4">
      <a href="/manual" class="lg:hidden text-xs text-fg-faint hover:text-fg-muted">← Manual</a>
      <div class="flex items-center gap-3">
        <h1 class="text-lg font-semibold text-fg-strong">{{ chapter.title }}</h1>
        {# Only when the manifest's route is a concrete URL: a route with an
           {id} placeholder (e.g. /smartdraft/{id}) has no real page for a
           manual chapter — which carries no draft/paper of its own — to
           link to, so it's left off rather than shipping a link that 404s
           on the literal placeholder text. #}
        {% if tour and '{id}' not in tour.route %}
        <a href="{{ tour.route }}?tour={{ chapter.slug }}"
           class="text-xs font-medium text-info hover:text-info-deep hover:underline">
          Take the tour →
        </a>
        {% endif %}
      </div>
    </div>

    <div class="manual rounded-lg border border-line bg-surface px-5 py-4">
      {{ body | safe }}
    </div>

    <div class="mt-4 flex items-center gap-3 text-sm">
      {% if prev %}
      <a href="/manual/{{ prev.slug }}" class="text-fg-muted hover:text-fg-strong">← {{ prev.title }}</a>
      {% endif %}
      {% if next %}
      <a href="/manual/{{ next.slug }}" class="ml-auto text-fg-muted hover:text-fg-strong">{{ next.title }} →</a>
      {% endif %}
    </div>
  </article>
</div>

{% endblock %}

{% extends "base.html.j2" %}
{% block title %}{{ chapter.title }} — Manual{% endblock %}
{% block content %}

{# Rendered-markdown styling. The prebuilt tailwind.css carries no
   typography plugin and the markdown output has no classes to hang
   utilities on, so the chapter body is styled here, scoped to .manual. #}
<style>
  .manual h2 { font-size: 1rem; font-weight: 600; color: #1e293b; margin: 1.75rem 0 .5rem; }
  .manual h3 { font-size: .875rem; font-weight: 600; color: #334155; margin: 1.25rem 0 .35rem; }
  .manual p, .manual li { font-size: .875rem; line-height: 1.65; color: #334155; }
  .manual p { margin: .6rem 0; }
  .manual ul, .manual ol { margin: .6rem 0 .6rem 1.25rem; }
  .manual ul { list-style: disc; }
  .manual ol { list-style: decimal; }
  .manual li { margin: .25rem 0; }
  .manual strong { font-weight: 600; color: #0f172a; }
  .manual code { font-size: .8125rem; background: #f1f5f9; border-radius: .25rem; padding: .05rem .3rem; }
  .manual pre { background: #f8fafc; border: 1px solid #e2e8f0; border-radius: .375rem;
                padding: .75rem 1rem; margin: .75rem 0; overflow-x: auto; }
  .manual pre code { background: none; padding: 0; font-size: .8125rem; line-height: 1.5; }
  .manual blockquote { border-left: 3px solid #cbd5e1; background: #f8fafc; margin: 1rem 0;
                       padding: .5rem .9rem; border-radius: 0 .25rem .25rem 0; }
  .manual blockquote p { margin: .3rem 0; color: #475569; }
  .manual table { width: 100%; margin: .9rem 0; border-collapse: collapse; font-size: .8125rem; }
  .manual th { text-align: left; font-weight: 600; color: #475569; background: #f8fafc;
               border: 1px solid #e2e8f0; padding: .35rem .6rem; }
  .manual td { border: 1px solid #e2e8f0; padding: .35rem .6rem; color: #334155; vertical-align: top; }
  .manual a { color: #0369a1; text-decoration: underline; text-underline-offset: 2px; }
</style>

<div class="flex gap-6 items-start">

  {# ── Chapter rail ─────────────────────────────────────────────── #}
  <nav class="hidden lg:block w-56 shrink-0 sticky top-4">
    <a href="/manual" class="block text-xs font-semibold text-slate-400 hover:text-slate-600 mb-2">Manual</a>
    <ol class="space-y-0.5">
      {% for c in chapters %}
      <li>
        <a href="/manual/{{ c.slug }}"
           class="block rounded px-2 py-1 text-xs leading-snug transition
                  {% if c.slug == chapter.slug %}bg-slate-200 font-medium text-slate-900
                  {% else %}text-slate-500 hover:bg-slate-100 hover:text-slate-800{% endif %}">
          {{ c.number }}. {{ c.title }}
        </a>
      </li>
      {% endfor %}
    </ol>
  </nav>

  {# ── Chapter body ─────────────────────────────────────────────── #}
  <article class="min-w-0 max-w-3xl flex-1">
    <div class="mb-4">
      <a href="/manual" class="lg:hidden text-xs text-slate-400 hover:text-slate-600">← Manual</a>
      <h1 class="text-lg font-semibold text-slate-900">{{ chapter.title }}</h1>
    </div>

    <div class="manual rounded-lg border border-slate-200 bg-white px-5 py-4">
      {{ body | safe }}
    </div>

    <div class="mt-4 flex items-center gap-3 text-sm">
      {% if prev %}
      <a href="/manual/{{ prev.slug }}" class="text-slate-600 hover:text-slate-900">← {{ prev.title }}</a>
      {% endif %}
      {% if next %}
      <a href="/manual/{{ next.slug }}" class="ml-auto text-slate-600 hover:text-slate-900">{{ next.title }} →</a>
      {% endif %}
    </div>
  </article>
</div>

{% endblock %}

{# Budget sub-tab — the retired ``/budget`` page: the spend tote, the
   claude-OAuth quota lane (with the live-pause banner from
   quota.evaluate + a resume-now override), and the cap editor. #}
<p class="text-sm text-fg-subtle mb-5 max-w-2xl">
  Two rails, by what a call actually spends. <strong>Real dollars</strong> —
  OpenRouter/OSS LLMs and paid fetches — meter against the caps below. The
  <strong>claude subscription</strong> (the <code>claude -p</code> OAuth lane)
  spends rate-limit <em>quota</em>, not money, so it is gated on the quota
  snapshot, not a dollar figure. Only free local work is never gated; everything
  auto-clears as its window rolls off.
</p>

{% if resume_active %}
<div class="mb-5 rounded-lg border border-warning bg-warning-subtle px-4 py-2 text-sm text-warning-deep flex items-center justify-between gap-3">
  <span>Resume override <strong>active</strong> until
    {{ resume_until | until if resume_until else '—' }} — soft trips
    are bypassed (a hard Anthropic rejection still fails).</span>
  <form method="post" action="/budget/resume/clear">
    <button class="text-xs text-warning-strong underline hover:text-danger">cancel</button>
  </form>
</div>
{% endif %}

{% if budget.get('tripped') %}
<div class="mb-5 rounded-lg border border-danger bg-danger-subtle px-4 py-2 text-sm text-danger-strong">
  A dollar cap is reached — paid work (real-money transports) is paused until spend rolls off the window.
</div>
{% endif %}

{% if quota and quota.paused %}
<div class="mb-5 rounded-lg border border-danger bg-danger-subtle px-4 py-2 text-sm text-danger-strong">
  {{ quota.pause_reason }}
</div>
{% elif quota and quota.taper_level %}
<div class="mb-5 rounded-lg border border-warning bg-warning-subtle px-4 py-2 text-sm text-warning-strong">
  Quota taper: {{ quota.taper_reason }} &mdash; {% if quota.taper_level >= 2 %}MEDIUM, BIG and FRONTIER{% else %}BIG and FRONTIER{% endif %} not admitted for background work (per-class detail below).
</div>
{% endif %}
{% if budget.get('degraded') %}
<div class="mb-5 rounded-lg border border-line bg-surface px-4 py-2 text-sm text-fg-muted">
  Degraded routing (24h) &mdash; calls re-asked on a smaller or local tier because the requested tier paused:
  {% for d in budget.degraded %}<span class="font-mono text-xs">{{ d.label }}</span> &times;{{ d.calls }}{% if not loop.last %}, {% endif %}{% endfor %}
</div>
{% endif %}
{% if quota and quota.taper_no_signal %}
<div class="mb-5 rounded-lg border border-line bg-surface-subtle px-4 py-2 text-xs text-fg-subtle">
  taper: no signal &mdash; the quota snapshot reports no used percentage or warning status, so tiers are not being tapered (failing open).
</div>
{% endif %}

{% if budget.get('windows') %}
<div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
  {% for w in budget.windows %}
  <div class="rounded-lg border border-line bg-surface p-4">
    <div class="flex items-baseline justify-between">
      <div class="text-xs uppercase tracking-wide text-fg-faint">{{ w.label }}</div>
      <div class="text-sm text-fg-subtle">
        <span class="font-semibold text-fg-secondary">${{ '%.2f'|format(w.spent) }}</span>
        / ${{ '%.2f'|format(w.cap) }}
      </div>
    </div>
    <div class="mt-2 h-2 w-full rounded-full bg-surface-muted overflow-hidden">
      <div class="h-2 rounded-full
        {% if w.state == 'red' %}bg-danger-solid-soft{% elif w.state == 'amber' %}bg-warning-solid-soft{% else %}bg-success-solid-soft{% endif %}"
        style="width: {{ w.pct }}%"></div>
    </div>
  </div>
  {% endfor %}
</div>
{% else %}
<p class="text-sm text-fg-subtle mb-6">
  No spend meter available — the budget module needs a store bound (it's dark by
  construction). Caps below still persist for when it is.
</p>
{% endif %}

<div class="rounded-lg border border-line bg-surface p-4 max-w-2xl mb-6">
  <div class="flex items-baseline justify-between mb-3">
    <div class="text-xs uppercase tracking-wide text-fg-faint">Claude subscription (OAuth quota)</div>
    <div class="text-[11px] text-fg-faint">
      {% if quota and quota.ts %}snapshot {{ quota.ts.strftime('%m-%d %H:%M UTC') }}{% else %}no snapshot{% endif %}
    </div>
  </div>
  {% if quota and quota.windows %}
  <ul class="text-sm divide-y divide-line-subtle">
    {% for w in quota.windows %}
    <li class="py-1 flex items-center justify-between gap-2">
      <span class="font-mono text-fg-muted">{{ w.name }}</span>
      <span class="flex items-center gap-2 shrink-0">
        {% if w.used is not none %}<span class="text-fg-subtle">{{ '%.0f'|format(w.used) }}%</span>{% endif %}
        <span class="rounded px-1.5 py-0.5 text-[11px]
          {% if w.status in ('allowed','allowed_warning','ok') %}bg-success-subtle text-success-strong
          {% elif w.status in ('rejected','blocked','exhausted') %}bg-danger-subtle text-danger-strong
          {% else %}bg-surface-muted text-fg-subtle{% endif %}">{{ w.status }}</span>
        {% if w.resets_at %}<span class="text-[11px] text-fg-faint">resets {{ w.resets_at | until }}</span>{% endif %}
      </span>
    </li>
    {% endfor %}
  </ul>
  {% else %}
  <p class="text-sm text-fg-faint">No quota snapshot yet — the <code>quota_check</code> pass writes one on the agent worker.</p>
  {% endif %}
  <div class="flex items-center gap-2 pt-3 mt-2 border-t border-line-subtle">
    <form method="post" action="/budget/resume" class="flex items-center gap-2">
      <button type="submit"
              class="rounded bg-warning-solid text-on-solid text-xs px-3 py-1 hover:bg-warning-solid-strong transition">
        Resume paid work now
      </button>
      <input type="number" step="0.5" min="0.25" name="hours" placeholder="{{ 5 }}"
             class="w-16 rounded border border-line px-2 py-1 text-xs font-mono
                    focus:border-warning-emphasis focus:outline-none" />
      <span class="text-[11px] text-fg-faint">hours (default 5)</span>
    </form>
  </div>
  <p class="text-[11px] text-fg-faint mt-2">
    Lifts a <em>soft</em> pause (dollar cap or a <code>used_percentage</code> ceiling) so the
    factory resumes without waiting for the window. A genuine Anthropic rate-limit rejection
    can't be overridden — those calls will 429 until the window resets.
  </p>
</div>

{% if quota and quota.outcomes %}
<div class="rounded-lg border border-line bg-surface p-4 max-w-2xl mb-6">
  <div class="text-xs uppercase tracking-wide text-fg-faint mb-3">Paid LLM calls by work class (24h)</div>
  <table class="text-sm w-full">
    <thead>
      <tr class="text-[11px] text-fg-faint text-left">
        <th class="font-normal py-1">class</th>
        <th class="font-normal py-1">tapered now</th>
        <th class="font-normal py-1 text-right">served</th>
        <th class="font-normal py-1 text-right">degraded</th>
        <th class="font-normal py-1 text-right">paused</th>
      </tr>
    </thead>
    <tbody class="divide-y divide-line-subtle">
      {% for row in quota.outcomes %}
      <tr>
        <td class="py-1 font-mono text-fg-muted">{{ row.work_class }}</td>
        <td class="py-1 text-[11px] text-fg-subtle">{{ row.blocked or '—' }}</td>
        <td class="py-1 text-right">{{ row.served }}</td>
        <td class="py-1 text-right {% if row.degraded %}text-warning-strong{% endif %}">{{ row.degraded }}</td>
        <td class="py-1 text-right {% if row.paused %}text-danger-strong{% endif %}">{{ row.paused }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
  <p class="text-[11px] text-fg-faint mt-2">
    Counted per budget-gate decision: a degraded call also shows once as paused (the refused
    tier) and once as served (the smaller tier). Interactive work is never tapered, only parked
    when the window is exhausted.
  </p>
</div>
{% endif %}

<div class="rounded-lg border border-line bg-surface p-4 max-w-lg mb-6">
  <div class="text-xs uppercase tracking-wide text-fg-faint mb-3">Caps (real-money transports)</div>
  <form method="post" action="/budget/set" class="space-y-3">
    <div class="flex items-center gap-3">
      <label class="w-28 text-sm text-fg-muted">Hourly ($)</label>
      <input type="number" step="0.01" min="0" name="hourly_usd"
             value="{% if hourly_cap is not none %}{{ '%.2f'|format(hourly_cap) }}{% endif %}"
             class="flex-1 rounded border border-line px-2 py-1 text-sm font-mono
                    focus:border-info-emphasis focus:outline-none" />
      <span class="text-[10px] {% if hourly_custom %}text-info-soft{% else %}text-fg-ghost{% endif %} w-16">
        {{ 'custom' if hourly_custom else 'env default' }}
      </span>
    </div>
    <div class="flex items-center gap-3">
      <label class="w-28 text-sm text-fg-muted">24h ($)</label>
      <input type="number" step="0.01" min="0" name="daily_usd"
             value="{% if daily_cap is not none %}{{ '%.2f'|format(daily_cap) }}{% endif %}"
             class="flex-1 rounded border border-line px-2 py-1 text-sm font-mono
                    focus:border-info-emphasis focus:outline-none" />
      <span class="text-[10px] {% if daily_custom %}text-info-soft{% else %}text-fg-ghost{% endif %} w-16">
        {{ 'custom' if daily_custom else 'env default' }}
      </span>
    </div>
    <div class="flex items-center gap-2 pt-1">
      <button type="submit"
              class="rounded bg-info-solid text-on-solid text-xs px-3 py-1 hover:bg-info-solid-strong transition">Save caps</button>
      {% if hourly_custom %}
      <button type="submit" formaction="/budget/reset" name="key" value="budget.hourly_usd"
              class="text-xs text-fg-faint hover:text-danger transition">reset hourly</button>
      {% endif %}
      {% if daily_custom %}
      <button type="submit" formaction="/budget/reset" name="key" value="budget.daily_usd"
              class="text-xs text-fg-faint hover:text-danger transition">reset 24h</button>
      {% endif %}
    </div>
  </form>
  <p class="text-[11px] text-fg-faint mt-3">
    A saved value overrides the <code>PRECIS_BUDGET_*</code> env default in the DB;
    reset reverts to it.
  </p>
</div>

<div class="rounded-lg border border-line bg-surface p-4 max-w-lg mb-6">
  <div class="text-xs uppercase tracking-wide text-fg-faint mb-3">Dream cadence</div>
  <p class="text-sm text-fg-subtle mb-3">
    The dream pass (<code>claude -p</code>, opus) fires every 15 min on its own
    launchd timer, unchanged. This knob makes a fire no-op if fewer than this
    many minutes have passed since the last real dream — raise it to cut cost
    without a redeploy.
  </p>
  <form method="post" action="/budget/dream-interval/set" class="space-y-3">
    <div class="flex items-center gap-3">
      <label class="w-28 text-sm text-fg-muted">Min interval (min)</label>
      <input type="number" step="1" min="1" name="min_interval_minutes"
             value="{{ '%.0f'|format(dream_min_interval_minutes) }}"
             class="flex-1 rounded border border-line px-2 py-1 text-sm font-mono
                    focus:border-info-emphasis focus:outline-none" />
      <span class="text-[10px] {% if dream_interval_custom %}text-info-soft{% else %}text-fg-ghost{% endif %} w-16">
        {{ 'custom' if dream_interval_custom else 'default (15)' }}
      </span>
    </div>
    <div class="flex items-center gap-2 pt-1">
      <button type="submit"
              class="rounded bg-info-solid text-on-solid text-xs px-3 py-1 hover:bg-info-solid-strong transition">Save</button>
      {% if dream_interval_custom %}
      <button type="submit" formaction="/budget/dream-interval/reset"
              class="text-xs text-fg-faint hover:text-danger transition">reset</button>
      {% endif %}
    </div>
  </form>
  <p class="text-[11px] text-fg-faint mt-3">
    Last real dream:
    {% if dream_last_real_run_at %}{{ dream_last_real_run_at.strftime('%m-%d %H:%M UTC') }}{% else %}never (or a fresh DB){% endif %}.
    A saved value overrides <code>PRECIS_DREAM_MIN_INTERVAL_MINUTES</code> in the DB;
    reset reverts to it (and, absent that, the 15-min compiled default —
    byte-identical to today's cadence).
  </p>
</div>

<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
  <div class="rounded-lg border border-line bg-surface p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint mb-1">By model (24h)</div>
    <ul class="text-sm divide-y divide-line-subtle">
      {% for m in budget.get('by_model', []) %}
      <li class="py-1 flex justify-between gap-2">
        <span class="font-mono text-fg-muted truncate">{{ m.label }}</span>
        <span class="text-fg-subtle shrink-0">{{ m.calls }} · ${{ '%.4f'|format(m.cost) }}</span>
      </li>
      {% else %}
      <li class="py-1 text-fg-faint">no priced calls in the last 24h</li>
      {% endfor %}
    </ul>
  </div>
  <div class="rounded-lg border border-line bg-surface p-4">
    <div class="text-xs uppercase tracking-wide text-fg-faint mb-1">By source (24h)</div>
    <ul class="text-sm divide-y divide-line-subtle">
      {% for s in budget.get('by_source', []) %}
      <li class="py-1 flex justify-between gap-2">
        <span class="font-mono text-fg-muted truncate">{{ s.label }}</span>
        <span class="text-fg-subtle shrink-0">{{ s.calls }} · ${{ '%.4f'|format(s.cost) }}</span>
      </li>
      {% else %}
      <li class="py-1 text-fg-faint">no priced spend in the last 24h</li>
      {% endfor %}
    </ul>
  </div>
</div>

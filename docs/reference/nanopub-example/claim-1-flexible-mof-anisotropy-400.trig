# Claim 1 — flexible MOFs: elastic anisotropy up to 400:1
# Grounded verbatim in the abstract of Ortiz et al., PRL 109, 195502 (2012).
# PLACEHOLDER markers: content-hash URI segment + signature bytes (publish-time).

@prefix np:     <http://www.nanopub.org/nschema#> .
@prefix npx:    <http://purl.org/nanopub/x/> .
@prefix prov:   <http://www.w3.org/ns/prov#> .
@prefix dct:    <http://purl.org/dc/terms/> .
@prefix rdfs:   <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:    <http://www.w3.org/2001/XMLSchema#> .
@prefix precis: <https://precis.retostamm.com/vocab#> .
@prefix agent:  <https://precis.retostamm.com/id/> .
@prefix this:   <https://precis.retostamm.com/np/sha256-PLACEHOLDER-1> .
@prefix sub:    <https://precis.retostamm.com/np/sha256-PLACEHOLDER-1#> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion       sub:assertion ;
    np:hasProvenance      sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  sub:claim a precis:AtomicClaim ;
    rdfs:label "Flexible metal-organic frameworks can exhibit elastic anisotropy ratios up to 400:1 between their most rigid and weakest directions."@en ;
    precis:material "flexible metal-organic frameworks: MIL-53(Al), MIL-53(Ga), MIL-47, DMOF-1" ;
    precis:method   "ab initio calculation of elastic constant tensors" ;
    precis:quantity "400:1" .
}

sub:provenance {
  sub:assertion
    prov:wasDerivedFrom <https://doi.org/10.1103/PhysRevLett.109.195502> ;
    precis:evidenceRole precis:corroborates ;
    precis:sourceQuote  """Tensorial analysis of the elastic constants reveal a highly anisotropic elastic behavior, some deformation directions exhibiting very low Young's modulus and shear modulus. This anisotropy can reach a 400:1 ratio between the most rigid and weakest directions, in stark contrast with the case of non-flexible MOFs such as MOF-5 and ZIF-8."""@en ;
    precis:searchSnip   "anisotropy 400 ratio rigid weakest directions" ;
    precis:sourcePdfSha256 "cf2cf2561f321e9c166d61810b0d2fc390b823f47aea3a1c535c490bf3ff3469" .

  <https://doi.org/10.1103/PhysRevLett.109.195502>
    dct:title "Anisotropic Elastic Properties of Flexible Metal-Organic Frameworks: How Soft are Soft Porous Crystals?" ;
    rdfs:seeAlso <https://arxiv.org/abs/1209.6378> .
}

sub:pubinfo {
  this: dct:created "2026-08-14T12:00:00Z"^^xsd:dateTime ;
    dct:creator agent:precis ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    precis:mintedFromHub <https://precis.retostamm.com/ref/fi176435> ;
    precis:otsProof <https://precis.retostamm.com/ots/2026-08-14/proof> .

  agent:precis a prov:SoftwareAgent ;
    rdfs:label "precis (non-attesting bot identity)" .

  sub:sig npx:hasSignatureTarget this: ;
    npx:hasAlgorithm "RSA" ;
    npx:hasPublicKey "PLACEHOLDER-BOT-PUBKEY" ;
    npx:hasSignature "PLACEHOLDER-SIGNATURE" ;
    npx:signedBy agent:precis .
}

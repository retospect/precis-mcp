<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/host-ops/pin-prod-follow-install for the user who owns
     the prod checkout. Placeholders: @LABEL@ @REPO@ @PROD_CHECKOUT@ @LOG@. -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>@LABEL@</string>
  <key>ProgramArguments</key>
  <array>
    <string>@REPO@/scripts/host-ops/pin-prod-follow</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PROD_CHECKOUT</key>
    <string>@PROD_CHECKOUT@</string>
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>RunAtLoad</key>
  <true/>
  <key>StartInterval</key>
  <integer>60</integer>
  <key>StandardOutPath</key>
  <string>@LOG@</string>
  <key>StandardErrorPath</key>
  <string>@LOG@</string>
</dict>
</plist>

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
{# {{ ansible_managed }} #}
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.asa.slack</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/asa/venv/bin/asa-slack</string>
  </array>

  <key>UserName</key>
  <string>hermes</string>

  <key>WorkingDirectory</key>
  <string>/Users/hermes/claudebot</string>

  <key>EnvironmentVariables</key>
  <dict>
    {# Shared bridge env — one source for both chat daemons; the whys live
       on the keys in roles/asa_common/defaults/main.yml. #}
{% for env_key, env_value in asa_common_env.items() %}
    <key>{{ env_key }}</key>
    <string>{{ env_value }}</string>
{% endfor %}
    {# ASA_SLACK_BOT_TOKEN / ASA_SLACK_APP_TOKEN are NOT set here — asa-slack
       resolves each from the precis DB vault (ADR 0055) via
       load_slack_tokens' env→vault→file order, revealing over the shared
       PRECIS_DATABASE_URL. See roles/asa_slack/README.md for the one-time
       vault seed. #}
    <key>ASA_SLACK_CONFIG</key>
    <string>/Users/hermes/.asa/slack.yaml</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>

  {# Jetsam protection — same lever as asa_bot (see its plist for the
     2026-07-13 incident this guards against). #}
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>/Users/hermes/.asa/asa-slack.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/hermes/.asa/asa-slack.log</string>
</dict>
</plist>

# {{ ansible_managed }}
# precis watch — watches NAS inbox + spawns Marker subprocesses to ingest
# PDFs. Linux-only systemd unit (the GPU node, where CUDA does most of the work).
#
# --polling is still passed because the NAS is an NFS mount; inotify isn't
# reliable across NFS. Same args as the macOS LaunchDaemon — see
# templates/precis-watch.plist.j2 for the full rationale.

[Unit]
Description=precis-mcp inbox watcher (Marker + precis_add)
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy

WorkingDirectory=/tmp

Environment=PATH={{ precis_watch_venv }}/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/precis
# §L (gr171431 §1): this unit's HOME diverges from the pgpass role's
# Linux deploy home (/home/deploy), so a password-free PRECIS_DATABASE_URL
# below would otherwise miss ~deploy/.pgpass (libpq resolves it off $HOME).
# Point PGPASSFILE at the pgpass role's actual file directly instead of
# changing HOME (which other code may depend on for caches/config).
Environment=PGPASSFILE=/home/deploy/.pgpass
Environment=PRECIS_DATABASE_URL={{ precis_watch_dsn }}
Environment=HF_HOME={{ precis_worker_hf_home | default('/var/lib/precis/hf-cache') }}
# Shared API keys (Semantic Scholar, Unpaywall, Elsevier, …) — same
# block precis_worker carries. The ingest pipeline enriches metadata via
# the S2 graph API; without SEMANTIC_SCHOLAR_API_KEY the watcher hits S2's
# anonymous limit and gets 429-throttled on every paper.
{% for env_key, env_val in precis_shared_env.items() %}
Environment={{ env_key }}={{ env_val }}
{% endfor %}

# Cap the surya-ocr-2 OCR footprint on GPU nodes. marker-pdf 2.0 / surya-2
# docker-run `vllm/vllm-openai` for OCR; its default
# --gpu-memory-utilization=0.85 grabbed ~103 GiB of the GPU node's 121 GiB
# unified pool and OOM-locked the box (kernel global-OOM + NVRM exhaustion,
# gripe 171249). 0.25 ≈ 30 GiB — above surya's own ~24 GiB baseline, far below
# catastrophe. SURYA_INFERENCE_PORT pins the server so it's a reused
# singleton (deterministic container name `surya-vllm-<port>`) instead of
# one unbounded container per worker process. Both are read by surya's
# pydantic Settings verbatim (no env prefix) and reach the OCR subprocess
# via `os.environ.copy()` in `precis watch`. Inert on non-GPU/non-docker
# hosts (surya only uses the vllm backend when CUDA+docker are present).
Environment=VLLM_GPU_MEMORY_UTILIZATION={{ surya_vllm_gpu_mem_util | default('0.25') }}
Environment=SURYA_INFERENCE_PORT={{ surya_inference_port | default('8912') }}

# Reclaim any orphaned surya vLLM container from a prior hard-kill before a
# fresh watch cycle: surya registers its docker cleanup via atexit, which is
# skipped on SIGKILL/OOM, so a `-d --rm` container can survive its parent.
# Leading '-' makes it non-fatal when docker or the container is absent.
ExecStartPre=-/usr/bin/env docker rm -f surya-vllm-{{ surya_inference_port | default('8912') }}

ExecStart={{ precis_watch_venv }}/bin/precis watch \
  --polling \
  --debounce {{ precis_watch_debounce }} \
  --user {{ precis_watch_user }} \
  --corpus-dir {{ precis_watch_corpus }} \
  --subprocess-batch-size {{ precis_watch_subprocess_batch }} \
  --subprocess-concurrency {{ precis_watch_subprocess_concurrency }} \
  {{ precis_watch_dir }}

Restart=always
RestartSec=30
StandardOutput=append:/var/log/precis-watch.log
StandardError=append:/var/log/precis-watch.log
# De-prioritize heavy compute so it can't starve interactive/system work
# (e.g. sshd). CPUAffinity is omitted on hosts that don't reserve cores.
Nice={{ precis_compute_nice | default(10) }}
{% if precis_compute_cpuaffinity | default('') %}CPUAffinity={{ precis_compute_cpuaffinity }}{% endif %}

[Install]
WantedBy=multi-user.target

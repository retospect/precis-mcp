# {{ ansible_managed }}
# Read by precis-worker via a systemd drop-in EnvironmentFile. Enables the
# `pathway` kind (precis_pathway + autocatpath[mace]) on this worker and pins compute here.
#
# PRECIS_AUTOCATPATH_ENABLED flips the plugin on (the handler InitErrors and hides
# the kind when unset). PRECIS_NODE lets the target_node claim gate run a
# autocatpath_explore job locally on this node (same value roles/dft sets; harmless
# if both drop-ins are present).
PRECIS_AUTOCATPATH_ENABLED=1
PRECIS_NODE={{ autocatpath_node }}
# PRECIS_AUTOCATPATH_ROUTE_NODE pins the dispatcher's target_node + engages the real
# ML backend (routed → config backend on CUDA; unset → EMT demo, junk barriers —
# quest/compute.py:dispatch_autocatpath). Was a runtime-only worker drop-in that
# didn't survive redeploys (the autocatpath ssh_node redeploy-survival bug); folded
# here for durability so it's regenerated every deploy.
PRECIS_AUTOCATPATH_ROUTE_NODE={{ (precis_capabilities.autocatpath | default([autocatpath_node])) | join(',') }}

# {{ ansible_managed }}
# precis worker — pulls chunk_embeddings / chunk_summaries batches from
# the postgres queue. Multiple nodes run identical units; postgres
# row-level locking arbitrates work.

[Unit]
Description=precis-mcp derived-artifact worker (embed + summarize)
After=network-online.target autossh@{{ postgres_host }}.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy

WorkingDirectory=/tmp

Environment=PATH={{ precis_worker_venv }}/bin:/usr/local/bin:/usr/bin:/bin
Environment=HOME=/var/lib/precis
# §L (gr171431 §1): this unit's HOME diverges from the pgpass role's
# Linux deploy home (/home/deploy), so a password-free PRECIS_DATABASE_URL
# below would otherwise miss ~deploy/.pgpass (libpq resolves it off $HOME).
# Point PGPASSFILE at the pgpass role's actual file directly instead of
# changing HOME (which other code may depend on for caches/config).
Environment=PGPASSFILE=/home/deploy/.pgpass
Environment=PRECIS_DATABASE_URL={{ precis_worker_dsn }}
Environment=HF_HOME={{ precis_worker_hf_home }}
Environment=PRECIS_PROCESS=precis-worker
Environment=PRECIS_SOURCE=precis-worker
Environment=PRECIS_STRUCTURE_PREFLIGHT=1
# struct_relax mint target — workers mint relax jobs too (quest ticks
# dispatch structure builds through the handlers). Topology-derived so a
# node retirement can't leave a stale literal (2026-08-29 GPU-node retirement).
# Unset ⇒ the handler refuses to mint, loudly. On the DFT node itself the
# dft role's EnvironmentFile drop-in sets the same value (drop-ins win),
# so the two always agree.
{% if (precis_capabilities.dft | default([])) | length > 0 %}
Environment=PRECIS_DFT_NODE={{ precis_capabilities.dft | first }}
{% endif %}
# §F cycle b: the ExecStart --embedder/--embedder-url flags below only
# reach cli/worker.py's OWN embedder resolution (the standing `embed`
# pass, now manual-only). capability_probe._probe_embedder and
# embed_batch's resolve_embedder both read PrecisConfig via
# load_config() — i.e. the ENV, not argv — so without these two the
# probe never advertises the `embedder` resource_slots row and a
# resolve with no explicit override falls back to PrecisConfig's
# "mock" default instead of this host's configured backend. Same
# values as the ExecStart flags; mirrors asa_bot's/asa_slack's units.
Environment=PRECIS_EMBEDDER={{ precis_worker_embedder }}
Environment=PRECIS_EMBEDDER_URL={{ precis_worker_embedder_url }}
# Nanopub network passes (daily host-agnostic cadences: nanopub_mirror
# registry delta sync + ots_sweep calendar anchoring). Default ON
# cluster-wide — the cadence lease is a fleet singleton with no
# eligibility check, so per-host enablement would starve the pass most
# days. precis_worker_nanopub_{mirror,ots} are the kill switches.
{% if precis_worker_nanopub_mirror | default(true) %}
Environment=PRECIS_MIRROR_ENABLED=1
{% endif %}
{% if precis_worker_nanopub_ots | default(true) %}
Environment=PRECIS_OTS_ENABLED=1
{% endif %}
Environment=PRECIS_MAX_TICKS={{ precis_max_ticks | default(25) }}
Environment=PRECIS_MAX_TODO_USD={{ precis_max_todo_usd | default(5.0) }}
Environment=PRECIS_MAX_TREE_USD={{ precis_max_tree_usd | default(10.0) }}
Environment=PRECIS_DAILY_COST_CEILING={{ precis_daily_cost_ceiling | default(50.0) }}
# Operator hold switch: comma-separated job_types the claim path skips
# (queued rows wait; in-flight rows finish). Empty = nothing held.
Environment=PRECIS_SUSPENDED_JOB_TYPES={{ precis_suspended_job_types | default('') }}
# CPU-limit passthrough for containerized jobs this worker spawns
# (docker run inherits cpuset/shares from the environment).
Environment=PRECIS_JOB_CPUSET={{ precis_job_cpuset | default('') }}
Environment=PRECIS_JOB_CPU_SHARES={{ precis_job_cpu_shares | default('') }}
# job_claude_docker (sandbox_run executor) run-control moved to
# service_config (§L control cutover) — the `precis service seed` task
# mirrors this host's agent_sandbox_hosts membership into a row the first
# time this lands. No more PRECIS_SANDBOX_ENABLED here.

# Shared API keys — see inventory/group_vars/all/precis_env.yml. Identity
# keys (email/API-key contacts) are vault-overridden via precis_identity_env
# (gr204873).
{% for env_key, env_val in (precis_shared_env | combine(precis_identity_env | default({}))).items() %}
Environment={{ env_key }}={{ env_val }}
{% endfor %}

# surya-ocr-2 memory cap — insurance for any marker/OCR path a job spawns
# here (the primary OCR path is precis-watch). Keeps the vLLM container
# bounded and pinned to the same reused singleton port as the watcher, so a
# worker-spawned OCR can't grab the GPU node's whole 121 GiB unified pool
# (gripe 171249). Inert on non-GPU/non-docker hosts.
Environment=VLLM_GPU_MEMORY_UTILIZATION={{ surya_vllm_gpu_mem_util | default('0.25') }}
Environment=SURYA_INFERENCE_PORT={{ surya_inference_port | default('8912') }}

ExecStart={{ precis_worker_venv }}/bin/precis worker \
  --profile system \
  --batch-size {{ precis_worker_batch_size }} \
  --idle-seconds {{ precis_worker_idle_seconds }} \
  --embedder {{ precis_worker_embedder }} \
  --embedder-url {{ precis_worker_embedder_url }} \
  --summarizer-model {{ precis_worker_summarizer }}

Restart=always
RestartSec=30
StandardOutput=append:/var/log/precis-worker.log
StandardError=append:/var/log/precis-worker.log

[Install]
WantedBy=multi-user.target

<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
{# {{ ansible_managed }} — precis worker daemon.

  Runs `precis worker` continuously, claiming chunk_embeddings and
  chunk_summaries batches from the postgres queue (via the local
  pgbouncer tunnel). All cluster nodes run an identical copy; postgres
  row-level locking arbitrates which node gets which batch.

  PRECIS_DATABASE_URL points at the local SSH tunnel (laid down by
  ssh_tunnels role) so the connection survives postgres-host reboots cleanly —
  pgbouncer reconnects automatically and the worker's psycopg pool
  picks back up. No retry logic needed in the daemon itself.
#}
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.precis.worker</string>

  {# bash wrapper makes /bin/bash the TCC "responsible process". bash is
     FDA-granted cluster-wide via tcc_profile; python inherits the grant
     across exec. Means we never need a per-venv-python FDA toggle. #}
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec {{ precis_worker_venv }}/bin/precis worker --profile system --batch-size {{ precis_worker_batch_size }} --idle-seconds {{ precis_worker_idle_seconds }} --embedder {{ precis_worker_embedder }} --embedder-url {{ precis_worker_embedder_url }} --summarizer-model {{ precis_worker_summarizer }}</string>
  </array>

  <key>UserName</key>
  <string>deploy</string>

  {# /tmp avoids the same getcwd() EPERM trap that bit extract_watch:
     macOS launchd daemons can't getcwd() inside NFS-mounted dirs. #}
  <key>WorkingDirectory</key>
  <string>/tmp</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/deploy</string>
    <key>PATH</key>
    <string>{{ precis_worker_venv }}/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PRECIS_DATABASE_URL</key>
    <string>{{ precis_worker_dsn }}</string>
    <key>HF_HOME</key>
    <string>{{ precis_worker_hf_home }}</string>
    {# Tier-0 structure preflight gate (structure/preflight.py) — flipped ON
       cluster-wide 2026-08-07 after landing dark. #}
    <key>PRECIS_STRUCTURE_PREFLIGHT</key>
    <string>1</string>
    {# PRECIS_PROCESS tags every row written to worker_logs so
       `precis logs --process precis-worker` filters cleanly across
       the cluster. PRECIS_SOURCE serves the existing audit role
       (level-gradient guard, ref_events.source). #}
    <key>PRECIS_PROCESS</key>
    <string>precis-worker</string>
    <key>PRECIS_SOURCE</key>
    <string>precis-worker</string>
    {# §F cycle b: the CLI args above (--embedder / --embedder-url) only
       reach cli/worker.py's OWN embedder resolution (the standing
       `embed` pass, now manual-only). `capability_probe._probe_embedder`
       and embed_batch's `resolve_embedder` both read PrecisConfig via
       load_config() — i.e. the ENV, not argv — so without these two the
       probe never advertises the `embedder` resource_slots row (no URL
       to check) and a resolve with no explicit override falls back to
       PrecisConfig's "mock" default (not this host's configured
       backend). Same values as the CLI flags above; mirrors asa_bot's/
       asa_slack's plists, which already export both for their own
       embedded precis MCP subprocess. #}
    <key>PRECIS_EMBEDDER</key>
    <string>{{ precis_worker_embedder }}</string>
    <key>PRECIS_EMBEDDER_URL</key>
    <string>{{ precis_worker_embedder_url }}</string>
    {# Planner-coroutine guardrails. Read by the dispatch pass when
       it gates each candidate parent — the dispatch pass runs in the
       system profile (here), even though the job execution happens
       on the agent profile (the gateway).

       These are the ONLY brakes on planner spend, so set all four
       explicitly: a cap left out of this block silently runs at its
       code default, which no host can tune and nobody reading the
       deploy can see. MAX_TICKS was 10000 — not "room to converge"
       but the cap switched off, and since it is the FIRST check it
       took the other three out of the fast path entirely. Real todos
       converged in 5-13 ticks; the two runaways reached 50 and 62.
       25 leaves genuine decomposition room and still trips a spin
       long before the dollar caps notice. Override in host_vars. #}
    <key>PRECIS_MAX_TICKS</key>
    <string>{{ precis_max_ticks | default(25) }}</string>
    <key>PRECIS_MAX_TODO_USD</key>
    <string>{{ precis_max_todo_usd | default(5.0) }}</string>
    <key>PRECIS_MAX_TREE_USD</key>
    <string>{{ precis_max_tree_usd | default(10.0) }}</string>
    <key>PRECIS_DAILY_COST_CEILING</key>
    <string>{{ precis_daily_cost_ceiling | default(50.0) }}</string>
    {# CPU-shares passthrough for containerized jobs this worker spawns
       (docker run --cpu-shares). Soft weight only — no core fencing on
       the Macs (PRECIS_JOB_CPUSET is set on the Linux/systemd node only). #}
    <key>PRECIS_JOB_CPU_SHARES</key>
    <string>{{ precis_job_cpu_shares | default('') }}</string>
    {# llm_summarize / classify / llm_reconcile / job_claude_docker
       (sandbox) run-control moved to `service_config` (§L control cutover)
       — the `precis service seed` task above mirrors this host's PRE-cutover
       flag state into a row the first time this lands, so behaviour doesn't
       change on this deploy; flip any of them live via
       `precis service prio <host> <service> <n>` or the /categorizers
       console from here on, no redeploy. PRECIS_SUMMARIZE_CONCURRENCY /
       PRECIS_SUMMARIZE_TIMEOUT are CONFIG, not a gate — kept unconditional
       so a `service prio` on/off flip doesn't also need a redeploy to pick
       up the tuning. Fills the 80B's --parallel slots from this one worker. #}
    <key>PRECIS_SUMMARIZE_CONCURRENCY</key>
    <string>{{ precis_worker_summarize_concurrency | default(3) }}</string>
    <key>PRECIS_SUMMARIZE_TIMEOUT</key>
    <string>{{ precis_worker_summarize_timeout | default(120) }}</string>
    {# taproot chase forward-bridge (ADR 0073 / Phase-3 W1) — a sub-feature
       INSIDE the always-registered `chase` pass, not its own service_config
       service, so it stays a plain env gate (§L only retires whole-pass
       PRECIS_*_ENABLED boot gates). Default OFF everywhere; enabled per-host
       (the gateway) because it needs the LLM verifier verdict
       (PRECIS_CHASE_LLM turns the verifier on for ALL chase passes on this
       host, capped by PRECIS_DAILY_COST_CEILING) plus the remote embedder —
       both of which only resolve on the gateway. When a finding establishes
       via the verifier, chase mints/attaches a TAPROOT:claim hub + evidence
       edge (set_by='chase'), populating the claim graph as a complement to
       the manual `precis taproot mint` on-ramp. Watch: links WHERE
       set_by='chase'. #}
    {% if precis_worker_taproot_chase | default(false) %}
    <key>PRECIS_TAPROOT_CHASE_ENABLED</key>
    <string>1</string>
    <key>PRECIS_CHASE_LLM</key>
    <string>1</string>
    {% endif %}
    {# markup-first ingest leg (devin) — a sub-feature INSIDE the always-on
       `fetch` pass (workers/fetch_oa.py), not its own service_config
       service, so (like PRECIS_TAPROOT_CHASE_ENABLED above) it stays a
       plain env gate. Default OFF; enabled on the single OA-fetch host (the
       gateway) so the flag only bites where the fetch pass actually runs. #}
    {% if precis_worker_fetch_markup | default(false) %}
    <key>PRECIS_FETCH_MARKUP</key>
    <string>1</string>
    {% endif %}
    {# Shared API keys — Perplexity, EPO OPS, patent raw cache.
       See inventory/group_vars/all/precis_env.yml. Even though the
       system worker rotation today (embed/summarize/chunk_keywords/
       fetch/auto_check/schedule/nursery/dispatch/sweeper) doesn't
       call out to Perplexity, future passes might, and the cost of
       carrying unused env vars is negligible. #}
    {% for env_key, env_val in precis_shared_env.items() %}
    {% if not (env_key == 'PRECIS_SUMMARIZE_MODEL' and precis_local_llm_model_override is defined) %}
    <key>{{ env_key }}</key>
    <string>{{ env_val }}</string>
    {% endif %}
    {% endfor %}
    {# Host-local served_by bypass (Track 2): point Tier.LOCAL_SMALL straight
       at this host's real llama-swap model id, so router.local_serving's
       resource_slots gate actually matches and the call is served locally.
       An alias name here (e.g. "qwen") never matches resource_slots' real-id
       keys, so dispatch would silently fall through instead of resolving to a
       local slot — see docs/design/local-model-router-integration.md. #}
    {% if precis_local_llm_model_override is defined %}
    <key>PRECIS_SUMMARIZE_MODEL</key>
    <string>{{ precis_local_llm_model_override }}</string>
    {% endif %}
    {# Real llama-swap config path — advertise_local_llm reads --parallel here
       for accurate resource_slots capacity; the code default
       (/etc/llama-swap/config.yaml) doesn't exist on the Mac hosts. #}
    {% if precis_local_serve_config is defined %}
    <key>PRECIS_LOCAL_SERVE_CONFIG</key>
    <string>{{ precis_local_serve_config }}</string>
    {% endif %}
  </dict>

  <key>RunAtLoad</key>
  <true/>

  {# Restart unconditionally — worker is meant to run forever. ThrottleInterval
     stops a crash loop from chewing CPU. #}
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  {# Jetsam protection — mirrors precis_worker_agent. The gateway co-hosts
     local llama.cpp inference servers that wire down the bulk of RAM;
     a large Marker ingest on top spikes pressure, and macOS jetsam then
     culls low-band background LaunchDaemons ("inefficient"). On
     2026-07-05 that crash-looped this worker ~8x in 20 min until launchd
     hit ThrottleInterval and *booted it out of the system domain* — so
     KeepAlive couldn't revive it and it stayed dead ~40 min, halting
     fetch_oa (pinned to the gateway) plus this node's embed/summarize/
     dispatch passes until a manual `launchctl bootstrap`. ProcessType
     Interactive raises the jetsam band toward the foreground tier so the
     worker is culled last, not first (and disables App-Nap throttling);
     cheap for a ~100 MB process. Harmless on the non-pressured nodes. #}
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>/var/log/precis-worker.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/precis-worker.log</string>
</dict>
</plist>

#!/bin/sh
# {{ ansible_managed }}
# Embedder health-kicker (gripe 51394 pt2). Probes /readyz; after
# $FAIL_THRESHOLD consecutive failures restarts the embedder via
# $RESTART_CMD, then resets the counter. pt1 made /readyz truthfully 503
# on a wedge; KeepAlive / Restart=always only cover process exit, so a
# wedged-but-alive embedder needs this external kick. Never exits nonzero
# (a periodic job that errored would just noise the logs); the restart is
# best-effort.
#
# Escalation (embedder-wedge-hardening.md §3): a restart alone can't fix a
# load path that depends on a remote service (the HF-Hub-dial-hangs-
# forever wedge) — it just restarts into the SAME hang, silently, forever
# (the 2026-08-08→10 embedder-node incident: restarts at 03:06Z and 09:13Z, both
# into the identical hang). This script can't know a kick "worked" until
# the NEXT tick's probe, so it tracks RESTART CYCLES across ticks in a
# second statefile: every restart this script issues is one cycle; a
# cycle streak only clears when /readyz next reports healthy. From the
# 3rd consecutive cycle onward it logs a distinctive escalation line —
# still via the normal launchd/systemd + StandardOutPath log, no separate
# alert channel — so a human (or nursery's embed-lane-stalled detector,
# §4) can tell "still kicking" apart from "kicking uselessly forever".
# DECIDED (embedder-wedge-hardening.md): keeps kicking regardless — a
# later kick may still succeed; escalation adds visibility, not a halt.
set -u
URL="${PRECIS_EMBEDDER_WATCHDOG_URL}"
THRESHOLD="${PRECIS_EMBEDDER_WATCHDOG_FAIL_THRESHOLD}"
STATEFILE="${PRECIS_EMBEDDER_WATCHDOG_STATEFILE}"
RESTART_CMD="${PRECIS_EMBEDDER_WATCHDOG_RESTART_CMD}"
TIMEOUT="${PRECIS_EMBEDDER_WATCHDOG_CURL_TIMEOUT:-5}"
# Derived, not a separate templated var — keeps this an entirely
# self-contained script-level change (no role/plist/service plumbing).
CYCLE_STATEFILE="${STATEFILE}.cycles"
ESCALATE_AT_CYCLE=3
ts() { date -u +%Y-%m-%dT%H:%M:%SZ; }

if curl -sf --max-time "$TIMEOUT" "$URL" >/dev/null 2>&1; then
  # healthy — clear any accumulated failures AND the restart-cycle streak
  [ -f "$STATEFILE" ] && rm -f "$STATEFILE"
  [ -f "$CYCLE_STATEFILE" ] && rm -f "$CYCLE_STATEFILE"
  exit 0
fi

fails=0
[ -f "$STATEFILE" ] && fails=$(cat "$STATEFILE" 2>/dev/null || echo 0)
case "$fails" in '' | *[!0-9]*) fails=0 ;; esac
fails=$((fails + 1))

if [ "$fails" -ge "$THRESHOLD" ]; then
  # Cycle statefile is one line: "<cycle_count> <first_failure_ts>".
  # Bump the count; preserve the first-failure timestamp across ticks
  # (it marks when THIS unresolved outage started, not this restart).
  cycle=0
  first_failure=""
  if [ -f "$CYCLE_STATEFILE" ]; then
    cycle=$(awk '{print $1}' "$CYCLE_STATEFILE" 2>/dev/null)
    first_failure=$(awk '{print $2}' "$CYCLE_STATEFILE" 2>/dev/null)
  fi
  case "$cycle" in '' | *[!0-9]*) cycle=0 ;; esac
  [ -z "$first_failure" ] && first_failure="$(ts)"
  cycle=$((cycle + 1))
  echo "$cycle $first_failure" >"$CYCLE_STATEFILE"

  echo "$(ts) precis-embedder-watchdog: /readyz failed ${fails}x (>= ${THRESHOLD}) — restarting embedder (restart cycle ${cycle}, first failure ${first_failure}): ${RESTART_CMD}"
  if [ "$cycle" -ge "$ESCALATE_AT_CYCLE" ]; then
    echo "$(ts) precis-embedder-watchdog: ESCALATION — ${cycle} consecutive restart cycles since ${first_failure} and /readyz still hasn't recovered; a restart-based kick is not clearing this condition (embedder-wedge-hardening.md §3) — still kicking, but this needs a human look"
  fi
  rm -f "$STATEFILE"
  sh -c "$RESTART_CMD" || echo "$(ts) precis-embedder-watchdog: restart command FAILED"
else
  echo "$fails" >"$STATEFILE"
  echo "$(ts) precis-embedder-watchdog: /readyz failed ${fails}x (< ${THRESHOLD}) — waiting"
fi
exit 0

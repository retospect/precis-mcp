# {{ ansible_managed }} — generic precis service_unit (§15h).
# Rendered from the abstract service_unit_* spec (roles/service_unit/defaults).
# Post-collapse the thin timers fold into the worker's §15i scheduler, so the
# systemd side renders long-running daemons only (keepalive).

[Unit]
Description={{ service_unit_description }}
After=network-online.target
Wants=network-online.target
{% if service_unit_start_limit_interval_sec %}
StartLimitIntervalSec={{ service_unit_start_limit_interval_sec }}
{% endif %}
{% if service_unit_start_limit_burst %}
StartLimitBurst={{ service_unit_start_limit_burst }}
{% endif %}

[Service]
Type=simple
User={{ service_unit_run_as }}
Group={{ service_unit_run_as }}

WorkingDirectory={{ service_unit_working_dir }}

{# TZ=UTC fleet-wide (00a-timezone.yml is the host-level pin; this keeps the
   daemon UTC even if the host zone drifts). A caller-supplied TZ wins. #}
{% for env_key, env_val in ({'TZ': 'UTC'} | combine(service_unit_env)).items() %}
Environment={{ env_key }}={{ env_val }}
{% endfor %}
{% for env_file in service_unit_env_files %}
EnvironmentFile=-{{ env_file }}
{% endfor %}

{% for pre_cmd in service_unit_exec_start_pre %}
ExecStartPre={{ pre_cmd }}
{% endfor %}
ExecStart={{ service_unit_exec }}
{% if service_unit_timeout_start_sec %}
TimeoutStartSec={{ service_unit_timeout_start_sec }}
{% endif %}
{% if service_unit_timeout_stop_sec %}
TimeoutStopSec={{ service_unit_timeout_stop_sec }}
{% endif %}

Restart=always
RestartSec={{ service_unit_throttle_seconds }}
StandardOutput=append:{{ service_unit_log }}
StandardError=append:{{ service_unit_log }}

[Install]
WantedBy=multi-user.target

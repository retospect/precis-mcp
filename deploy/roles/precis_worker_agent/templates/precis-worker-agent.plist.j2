<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
{# {{ ansible_managed }} #}
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.precis.worker-agent</string>

  {# bash wrapper makes /bin/bash the TCC "responsible process". Same
     pattern as precis_worker. #}
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>-c</string>
    <string>exec {{ precis_worker_agent_venv }}/bin/precis worker --profile agent --batch-size {{ precis_worker_agent_batch_size }} --idle-seconds {{ precis_worker_agent_idle_seconds }}</string>
  </array>

  {# Factory Phase-2 slice 2B: runs as `deploy` (was hermes). deploy owns
     the colima docker socket (0600) the §13 container executor needs, plus
     its own OAuth (CLAUDE_CODE_OAUTH_TOKEN, revealed from the DB vault
     by ensure_oauth_token — the ~deploy/.claude_oauth_token file this
     used to read is retired and purged by redeploy step 0a2) and its own
     ~/.claude/mcp.json (this role renders it from the shared asa_bot
     template). plan_tick uses --permission-mode bypassPermissions so no
     ~/.claude/settings.json dependency. §A: dream is no longer its own
     hermes plist — it rides the `dream_agent` scheduler cadence INSIDE
     this daemon (host-pinned to the gateway); the PRECIS_DREAM_* env
     below is what makes this agent-profile process (not the
     system-profile one) the eligible claimant. #}
  <key>UserName</key>
  <string>deploy</string>

  <key>WorkingDirectory</key>
  <string>/Users/deploy</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>HOME</key>
    <string>/Users/deploy</string>
    {# gr208726: pin libpq's password file — don't rely on ~-resolution
       (getpwuid via the directory service can transiently fail under load,
       surfacing as fe_sendauth in short-lived CLI subprocess spawns). #}
    <key>PGPASSFILE</key>
    <string>/Users/deploy/.pgpass</string>
    <key>PATH</key>
    <string>{{ precis_worker_agent_venv }}/bin:/opt/homebrew/bin:/Library/TeX/texbin:/usr/local/bin:/usr/bin:/bin</string>
    <key>PRECIS_DATABASE_URL</key>
    <string>{{ precis_worker_agent_dsn }}</string>
    <key>PRECIS_MCP_CONFIG</key>
    <string>{{ precis_worker_agent_mcp_config }}</string>
    <key>PRECIS_SOURCE</key>
    <string>precis-worker-agent</string>
    {# PRECIS_PROCESS tags every row in worker_logs so
       `precis logs --process precis-worker-agent` filters cleanly. #}
    <key>PRECIS_PROCESS</key>
    <string>precis-worker-agent</string>
    {# Embedder plumbing (gr185401): the agent profile's embedder
       consumers (taproot chase verify, anything via load_config())
       read the ENV — without these they fall back to PrecisConfig's
       "mock" default / an in-process bge-m3 this venv can't load.
       Mirrors the precis_worker role's §F-b env block. #}
    <key>PRECIS_EMBEDDER</key>
    <string>{{ precis_worker_agent_embedder }}</string>
    <key>PRECIS_EMBEDDER_URL</key>
    <string>{{ precis_worker_agent_embedder_url }}</string>
    {# Gate envs — set to "1" to enable the corresponding review
       pass. Clearing any of these mutes the pass without
       uninstalling. #}
    <key>PRECIS_STRUCTURAL_REVIEW</key>
    <string>1</string>
    <key>PRECIS_DEEP_REVIEW</key>
    <string>1</string>
    <key>PRECIS_STRUCTURE_PREFLIGHT</key>
    <string>1</string>
    {% if inventory_hostname in groups['gateway'] %}
    {# §A: the `dream_agent` scheduler cadence is host-pinned to the gateway
       (workers/scheduler.py); this is what makes THIS agent-profile process
       the eligible claimant (a system-profile worker on the same host has
       neither var set, so it can never win the lease — see the cadence's
       `eligible` gate, workers/dream_agent.py::eligible). Same env shape
       dream-pass.sh used to export before its LaunchDaemon was retired. The
       SOUL file is copied to a deploy-readable path by this role's tasks
       (operator persona lives at /Users/hermes/.asa/SOUL.md; deploy can't
       read hermes's home dir). #}
    <key>PRECIS_DREAM_AGENT</key>
    <string>1</string>
    <key>PRECIS_DREAM_SOUL_PATH</key>
    <string>{{ precis_dream_soul_path | default('/opt/asa/etc/SOUL.md') }}</string>
    {% endif %}
    {% if inventory_hostname in groups['precis_anki_sync'] %}
    {# §A: the `anki_sync` scheduler cadence is host-pinned to the gateway too
       (same reasoning as dream above) — same PRECIS_ANKI_* block the retired
       com.precis.anki-sync plist used to carry. #}
    <key>PRECIS_ANKI_ENABLED</key>
    <string>1</string>
    <key>PRECIS_ANKI_USER</key>
    <string>{{ vault_anki_user | default(anki_user | default('')) }}</string>
    <key>PRECIS_ANKI_PASSWORD</key>
    <string>{{ vault_anki_password | default('') }}</string>
    <key>PRECIS_ANKI_MIRROR_DIR</key>
    <string>{{ anki_mirror_dir | default('/opt/mcps/anki-mirror') }}</string>
    <key>PRECIS_ANKI_DECK</key>
    <string>{{ anki_deck | default('Precis') }}</string>
    {% if anki_sync_fix | default(false) %}
    <key>PRECIS_ANKI_FIX_ENABLED</key>
    <string>1</string>
    {% endif %}
    {% if anki_sync_project | default(true) %}
    <key>PRECIS_ANKI_PROJECT_ENABLED</key>
    <string>1</string>
    {% endif %}
    {% endif %}
    {% if precis_worker_agent_load_ceiling %}
    <key>PRECIS_LOAD_CEILING</key>
    <string>{{ precis_worker_agent_load_ceiling }}</string>
    {% endif %}
    {# Planner-coroutine guardrails — must mirror the system-profile
       plist, which is where the dispatch pass actually reads them.
       Set all four explicitly; an omitted cap runs at an untunable,
       invisible code default. MAX_TICKS was 10000, i.e. off, so the
       first and cheapest check never fired: two todos reached 50 and
       62 ticks unremarked while real ones converged in 5-13. #}
    <key>PRECIS_MAX_TICKS</key>
    <string>{{ precis_max_ticks | default(25) }}</string>
    <key>PRECIS_MAX_TODO_USD</key>
    <string>{{ precis_max_todo_usd | default(5.0) }}</string>
    <key>PRECIS_MAX_TREE_USD</key>
    <string>{{ precis_max_tree_usd | default(10.0) }}</string>
    <key>PRECIS_DAILY_COST_CEILING</key>
    <string>{{ precis_daily_cost_ceiling | default(50.0) }}</string>
    {# CPU-shares passthrough for containerized jobs this worker spawns
       (docker run --cpu-shares). Soft weight only — no core fencing on
       the Macs (PRECIS_JOB_CPUSET is set on the Linux/systemd node only). #}
    <key>PRECIS_JOB_CPU_SHARES</key>
    <string>{{ precis_job_cpu_shares | default('') }}</string>
    {# Autonomous quest loop (rung 4d, agent-profile only). The allocator
       pass mints frontier ticks + structure-relax compute; the weekly
       budget caps its spend (distinct from the global $/day breaker).
       Compute relax rides the existing the GPU node DFT lane.
       GATED OFF by default: the loop's frontier ticks are PAID calls, so
       it only does useful work when the global budget breaker
       (PRECIS_BUDGET_DAILY_USD) has headroom — otherwise every tick
       claims, hits the tripped breaker, fails, and re-claims in a
       ~0.5s spin. Flip `precis_quest_loop_enabled: true` in
       the gateway's host_vars once the daily cap is raised.
       §L control cutover: kept (NOT stripped like the precis_worker role's
       PRECIS_*_ENABLED flags) — `precis quest run` and quest/loop.py /
       allocator.py's own default_on fallback read this directly,
       independent of the worker pass. The worker pass itself now ALSO gets
       a `service_config` row (the seed task above, tasks/main.yml) so a
       console operator can flip that one pass without a redeploy even
       though this env still governs the wider feature. #}
    <key>PRECIS_QUEST_LOOP_ENABLED</key>
    <string>{{ '1' if precis_quest_loop_enabled | default(false) else '0' }}</string>
    {# gr162594: the fair-share meter counts characters, not dollars — the
       quest lane runs on cloud-small/claude_p, which never reports a $ cost.
       Default ~= one week's observed quest_tick volume (120 calls x ~18.6K
       chars), so a reactivated loop at today's cadence stays under cap. #}
    <key>PRECIS_QUEST_WEEKLY_CHARS</key>
    <string>{{ precis_quest_weekly_chars | default(2000000) }}</string>
    {# Catalyst-quest barrier lane. dispatch_autocatpath runs HERE (quest ticks
       are claude_inproc, agent-profile only) and reads this env to pin the
       minted `autocatpath_explore` job at the GPU node; unset → it force-EMTs
       and the job never reaches the GPU node's MACE. Mirrors the precis-web plist,
       which sets the same var for the pathway-kind MCP surface. #}
    {% if inventory_hostname in (precis_capabilities.autocatpath_plugin | default([])) %}
    {# Without ENABLED the worker's PathwayHandler InitErrors on every dispatch
       load ("pathway kind is off") — the web plist sets it, the worker must
       too; same autocatpath_plugin gate. #}
    <key>PRECIS_AUTOCATPATH_ENABLED</key>
    <string>1</string>
    {% endif %}
    {% if (precis_capabilities.autocatpath | default([])) | length > 0 %}
    <key>PRECIS_AUTOCATPATH_ROUTE_NODE</key>
    <string>{{ precis_capabilities.autocatpath | first }}</string>
    {% endif %}
    {# diagram_propose autonomous drawer — agentic path (claude_inproc). #}
    <key>PRECIS_DIAGRAM_AGENTIC</key>
    <string>1</string>
    {# card_forge morning pass — `act` applies the retire/rework ladder
       (default `report` = observe-only). Composes here (claude_inproc). #}
    <key>PRECIS_CARD_FORGE_AUTONOMY</key>
    <string>{{ precis_card_forge_autonomy | default('act') }}</string>
    {# §13 container executor — CAPABLE but OFF (slice 2B). The docker CLI
       (homebrew) talks to deploy's colima VM where the precis-agent image
       is loaded (Track 1). Setting PRECIS_AGENT_CONTAINER=1 (slice 2C, via
       host_vars once plan_tick is verified under the deploy run-as) makes
       call_claude_agent passes (reviews/diagram) run in a throwaway
       container. plan_tick/fix_gripe use separate seams — unaffected. #}
    <key>PRECIS_CONTAINER_BIN</key>
    <string>{{ precis_worker_agent_container_bin }}</string>
    <key>PRECIS_AGENT_IMAGE</key>
    <string>{{ precis_agent_image }}</string>
    {% if precis_agent_container_enabled | default(false) %}
    <key>PRECIS_AGENT_CONTAINER</key>
    <string>1</string>
    {% endif %}
    {# Shared API keys — Perplexity, EPO OPS, patent raw cache.
       See inventory/group_vars/all/precis_env.yml. Same block in
       every precis-* daemon so capability parity is automatic. Identity
       keys (email/API-key contacts) are vault-overridden via
       precis_identity_env (gr204873). #}
    {% for env_key, env_val in (precis_shared_env | combine(precis_identity_env | default({}))).items() %}
    {% if not (env_key == 'PRECIS_SUMMARIZE_MODEL' and precis_local_llm_model_override is defined) %}
    <key>{{ env_key }}</key>
    <string>{{ env_val }}</string>
    {% endif %}
    {% endfor %}
    {# Host-local served_by bypass (Track 2) — mirrors
       precis-worker.plist.j2; see that template for the full rationale. #}
    {% if precis_local_llm_model_override is defined %}
    <key>PRECIS_SUMMARIZE_MODEL</key>
    <string>{{ precis_local_llm_model_override }}</string>
    {% endif %}
    {% if precis_local_serve_config is defined %}
    <key>PRECIS_LOCAL_SERVE_CONFIG</key>
    <string>{{ precis_local_serve_config }}</string>
    {% endif %}
  </dict>

  <key>RunAtLoad</key>
  <true/>

  {# Long-running daemon. KeepAlive=true so launchd restarts on
     crash; ThrottleInterval prevents a crash-loop from chewing
     CPU. Matches precis_worker. #}
  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>30</integer>

  {# Jetsam protection. This node co-hosts local llama.cpp inference
     servers that wire down the bulk of RAM (~70G+ resident, most of
     the machine's memory shows as wired). Under that pressure macOS
     terminates low-band background LaunchDaemons for "efficiency"
     (`launchctl print` reports `immediate reason = inefficient`) —
     and this worker, though tiny (~100 MB RSS), was being culled
     ~200x/day. Each kill that lands mid-tick orphans a claimed
     `plan_tick` (STATUS:running with no live runner) → the sweeper
     fails it `swept:claim-orphaned` → the parent todo child-fails and
     never converges. This host is the ONLY place plan_tick runs, so
     the worker must outlive the memory pressure. ProcessType
     Interactive raises its jetsam band toward the foreground tier so
     it is culled last, not first, and disables App-Nap-style timer
     throttling. The lightweight footprint makes the elevation cheap. #}
  <key>ProcessType</key>
  <string>Interactive</string>

  <key>StandardOutPath</key>
  <string>/var/log/precis-worker-agent.log</string>
  <key>StandardErrorPath</key>
  <string>/var/log/precis-worker-agent.log</string>
</dict>
</plist>

# {{ ansible_managed }}
[Unit]
Description=SGLang OpenAI-compatible server ({{ sglang_served_model_names | first }})
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Clear any stale container from a crash; "-" ignores "no such container".
ExecStartPre=-/usr/bin/{{ sglang_container_cmd }} rm -f {{ sglang_service_name }}
ExecStart=/usr/bin/{{ sglang_container_cmd }} run --rm --name {{ sglang_service_name }} \
    --gpus all --ipc=host --network host \
    -e PYTHONUNBUFFERED=1 \
    -v {{ sglang_model_dir }}:/model:ro \
{% if sglang_tiktoken_dir | length > 0 %}
    -v {{ sglang_tiktoken_dir }}:/tiktoken:ro \
    -e TIKTOKEN_ENCODINGS_BASE=/tiktoken \
{% endif %}
{% for k, v in (sglang_env | default({})).items() %}
    -e {{ k }}={{ v }} \
{% endfor %}
    {{ sglang_image }} \
    python3 -m sglang.launch_server \
    --model-path /model \
    --served-model-name {{ sglang_served_model_names | join(' ') }} \
    --host {{ sglang_bind_addr }} \
    --port {{ sglang_port }} \
    --mem-fraction-static {{ sglang_mem_fraction_static }} \
    --context-length {{ sglang_context_length }} \
    --kv-cache-dtype {{ sglang_kv_cache_dtype }} \
    --max-running-requests {{ sglang_max_running_requests }} \
    --load-format {{ sglang_load_format }} \
    --model-loader-extra-config '{{ sglang_loader_extra_config | to_json }}' \
{% if sglang_drop_cache_after_load %}
    --weight-loader-drop-cache-after-load \
{% endif %}
{% if sglang_reasoning_parser | length > 0 %}
    --reasoning-parser {{ sglang_reasoning_parser }} \
{% endif %}
{% if sglang_tool_call_parser | length > 0 %}
    --tool-call-parser {{ sglang_tool_call_parser }}{% for a in sglang_extra_args %} \
    {{ a }}{% endfor %}
{% else %}{% for a in sglang_extra_args %} \
    {{ a }}{% endfor %}
{% endif %}

ExecStop=/usr/bin/{{ sglang_container_cmd }} stop {{ sglang_service_name }}
Restart=on-failure
RestartSec=15
# Weight load + engine init take a few minutes; do not let systemd's start
# timeout kill it.
TimeoutStartSec=0
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target

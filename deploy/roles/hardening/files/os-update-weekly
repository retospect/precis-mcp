#!/usr/bin/env bash
# Weekly unattended OS update with a guarded reboot (gr491172; Reto ruling
# 2026-10-16). Runs from os-update-weekly.timer inside the 03:00-04:20Z
# no-deploy window. apt-get update + upgrade always run; the reboot happens
# only when all hold:
#   * the reboot-required marker exists;
#   * host-busy reports 0 (no autocatpath seed, no non-service container);
#   * `precis service reserved` confirms no live service_config reserve;
#   * every active serving engine (OS_UPDATE_SERVING_UNITS, default
#     "vllm sglang") is enabled, so it starts again on boot, and stops
#     cleanly (`timeout 300 systemctl stop`).
# Anything else logs "reboot deferred" and leaves the marker for the next
# scripts/host-ops/os-update (an unreadable reserve counts as set); a unit that
# was stopped for a deferred reboot is started again. The engines are stopped
# before `shutdown` so they exit cleanly, and the enabled units start on boot;
# scripts/host-ops/os-update relies on the same (vllm enabled, starts on boot,
# health-checked after). If `shutdown` itself fails the stopped units are
# started again and the script exits 1. An EXIT/TERM/INT trap does that
# restart, so a systemd timeout kill between stop and shutdown restores them too.
set -euo pipefail
MARKER="${OS_UPDATE_REBOOT_MARKER:-/var/run/reboot-required}"
HOST_BUSY="${OS_UPDATE_HOST_BUSY:-/usr/local/sbin/host-busy}"
PRECIS="${OS_UPDATE_PRECIS:-/opt/precis/venv/bin/precis}"
SERVING_UNITS="${OS_UPDATE_SERVING_UNITS:-vllm sglang}"
STOPPED=()
log() { echo "os-update-weekly: $*"; }

restart_stopped() {
  local unit
  for unit in ${STOPPED[@]+"${STOPPED[@]}"}; do
    systemctl start "$unit" || log "could not start $unit again"
  done
}

# Trap body: restore the engines once, then leave (a bare TERM/INT trap would
# otherwise return into the script and carry on to shutdown).
on_exit() {
  local rc=$?
  trap - EXIT TERM INT
  restart_stopped
  exit "$rc"
}

reserve_clear() {
  local envs dsn host out
  envs=$(systemctl show precis-worker -p Environment --value 2>/dev/null || true)
  dsn=$(tr ' ' '\n' <<<"$envs" | sed -n 's/^PRECIS_DATABASE_URL=//p')
  host=$(tr ' ' '\n' <<<"$envs" | sed -n 's/^PRECIS_HOST_NAME=//p')
  if [[ -z "$dsn" || ! -x "$PRECIS" ]]; then
    log "reserve unreadable (no precis-worker DSN or precis CLI)"
    return 1
  fi
  local -a envv=(PGPASSFILE=/home/deploy/.pgpass)
  if [[ -n "$host" ]]; then envv+=("PRECIS_HOST_NAME=$host"); fi
  if ! out=$(sudo -u deploy -H env "${envv[@]}" \
      "$PRECIS" service reserved --database-url "$dsn" 2>&1); then
    log "reserve set or unreadable: ${out:-no output}"
    return 1
  fi
  [[ "$out" == "reserve: none on "* ]] || { log "reserve unreadable: $out"; return 1; }
}

export DEBIAN_FRONTEND=noninteractive
APT=(apt-get -qq -o DPkg::Lock::Timeout=600
     -o Dpkg::Options::=--force-confdef -o Dpkg::Options::=--force-confold)
log "apt-get update + upgrade"
if ! "${APT[@]}" update || ! "${APT[@]}" -y upgrade; then
  log "apt failed; no reboot"
  exit 1
fi

if [[ ! -e "$MARKER" ]]; then
  log "no reboot required"
  exit 0
fi
busy=$("$HOST_BUSY" || true)
if [[ "$busy" != 0 ]]; then
  log "reboot deferred: host busy (${busy:-unknown} compute process(es)/container(s))"
  exit 0
fi
if ! reserve_clear; then
  log "reboot deferred: service_config reserve"
  exit 0
fi

read -ra serving <<<"$SERVING_UNITS"
active=()
for unit in ${serving[@]+"${serving[@]}"}; do
  systemctl is-active --quiet "$unit" || continue
  if ! systemctl is-enabled --quiet "$unit"; then
    log "reboot deferred: $unit is active but not enabled; a reboot would not bring it back"
    exit 0
  fi
  active+=("$unit")
done
for unit in ${active[@]+"${active[@]}"}; do
  log "stopping $unit before the reboot"
  STOPPED+=("$unit")
  # Any exit from here to a successful shutdown (stop failure, SIGTERM from
  # TimeoutStartSec, set -e) restarts the units; the failure paths just exit.
  trap on_exit EXIT
  trap 'exit 143' TERM INT
  if ! timeout 300 systemctl stop "$unit" || systemctl is-active --quiet "$unit"; then
    log "reboot deferred: could not stop $unit"
    exit 0
  fi
done

log "rebooting: $MARKER present, host idle, no reserve"
if ! shutdown -r now "weekly OS update"; then
  log "shutdown failed"
  exit 1
fi
# shutdown accepted: leave the engines stopped for a clean exit.
trap - EXIT TERM INT

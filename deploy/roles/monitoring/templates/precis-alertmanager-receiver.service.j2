# {{ ansible_managed }}
{# systemd Environment= takes the quoted-assignment form: the word is split
   on whitespace and its double quotes are stripped, so an unquoted JSON value
   reaches the process cut at the first space (gr764103). Inside the quotes
   backslash -> \\, " -> \" and % -> %% (specifier), backslash first. #}
{% macro systemd_env(key, val) -%}
Environment="{{ key }}={{ val | string | trim | replace('\\', '\\\\') | replace('"', '\\"') | replace('%', '%%') }}"
{%- endmacro %}
# Alertmanager webhook -> ops channel (queue_ops_message -> asa_bot).
# Loopback-only and unauthenticated by design; the CLI refuses a routable bind.

[Unit]
Description=precis Alertmanager webhook receiver
After=network-online.target prometheus-alertmanager.service
Wants=network-online.target

[Service]
Type=simple
User={{ monitoring_receiver_user }}
Group={{ monitoring_receiver_user }}
WorkingDirectory=/tmp
{{ systemd_env('PATH', (monitoring_receiver_venv) ~ '/bin:/usr/local/bin:/usr/bin:/bin') }}
{{ systemd_env('PGPASSFILE', monitoring_receiver_pgpass) }}
{{ systemd_env('PRECIS_DATABASE_URL', monitoring_receiver_dsn) }}
# PRECIS_OPS_ALERT_TARGET rides in the shared env; without it the receiver
# answers 503 and Alertmanager keeps retrying, so a missing target is loud.
{% for env_key, env_val in (precis_shared_env | default({}) | combine(precis_identity_env | default({}))).items() %}
{{ systemd_env(env_key, env_val) }}
{% endfor %}

ExecStart={{ monitoring_receiver_venv }}/bin/precis alertmanager-receiver \
  --host {{ monitoring_receiver_host }} --port {{ monitoring_receiver_port }}

Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target

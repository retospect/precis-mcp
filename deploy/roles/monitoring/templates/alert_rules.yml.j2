# {{ ansible_managed }}
groups:
  - name: cluster_alerts
    rules:
      - alert: NodeDown
        expr: up == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}{{ $labels.instance }}{% endraw %} is down"

      # Warn at 85% (was 90%) with a shorter window so the node has headroom
      # before a volume fills — gripe 191008 (the data node hit 100% and
      # DiskFull stalled all prod writes). The precis-native disk_check pass is
      # the primary, operator-visible watch where a precis worker runs; this
      # Prometheus rule is the infra-level backstop. The DB node runs no
      # precis worker, so these two rules are the only disk watch on its
      # volume (gripe 738880: it sat at 88% with the nightly dump peaking near
      # 96% and nothing named it). DiskNearlyFull is the critical tier at 93%,
      # the same line as disk_check's critical threshold.
      # Network and pseudo filesystems are excluded: NFS and the like repeat
      # the server's volume on every client (the exporting node still reports
      # its own), and the macOS helper volumes under /System/Volumes share one
      # APFS container, so the container alerts as / and /System/Volumes/Data,
      # not once per volume. tmpfs, ramfs and generic fuse (fuseblk,
      # fuse.mergerfs) stay watched: they can be real disks or fill RAM. The
      # summary names the mountpoint and what is free. Below 7% free both rules
      # fire; alertmanager.yml.j2 inhibits the warning while the critical is up.
{% set local_fs = '{fstype!~"nfs.*|cifs|smbfs|afpfs|autofs|devfs|devtmpfs|overlay|squashfs|fuse.sshfs", mountpoint!~"/System/Volumes/(VM|Preboot|Update|xarts|iSCPreboot|Hardware)(/.*)?"}' %}
      - alert: HighDiskUsage
        expr: node_filesystem_avail_bytes{{ local_fs }} / node_filesystem_size_bytes{{ local_fs }} < 0.15
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Disk usage above 85% on {{ $labels.instance }} {{ $labels.mountpoint }} ({{ $value | humanizePercentage }} free){% endraw %}"

      - alert: DiskNearlyFull
        expr: node_filesystem_avail_bytes{{ local_fs }} / node_filesystem_size_bytes{{ local_fs }} < 0.07
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}Disk usage above 93% on {{ $labels.instance }} {{ $labels.mountpoint }} ({{ $value | humanizePercentage }} free){% endraw %}"

      - alert: HighMemoryUsage
        expr: (1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)) > 0.9
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Memory usage above 90% on {{ $labels.instance }}{% endraw %}"

      - alert: DeployOverlayDirty
        expr: precis_deploy_overlay_status == 1
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Tracked changes in git_deploy_helper on {{ $labels.instance }}. See cluster-overlay-sync.{% endraw %}"

      - alert: DeployOverlayCheckFailed
        expr: >-
          precis_deploy_overlay_status == -1
          or on(instance) time() - node_textfile_mtime_seconds{file=~"(.*/)?deploy_overlay[.]prom"} > 900
          or on(instance) (up{job="node", deploy_overlay_expected="true"} == 1
            unless on(instance) precis_deploy_overlay_status)
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}Deploy overlay check failed, is stale, or is missing on {{ $labels.instance }}.{% endraw %}"

      # The colima VM's /var/lib/docker is a separate disk inside the VM that
      # host node_exporter cannot see (98% -> ENOSPC on every gate, 2026-10-03).
      # Fed by the colima-docker-fs textfile collector (node_exporter role).
      - alert: ColimaDockerDiskHigh
        expr: precis_colima_docker_fs_used_bytes / precis_colima_docker_fs_size_bytes > 0.85
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}colima /var/lib/docker above 85% on {{ $labels.instance }}{% endraw %}"

      - alert: ColimaDockerDiskMetricDown
        expr: precis_colima_docker_fs_up == 0
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}colima VM unreachable or metric probe timing out on {{ $labels.instance }}{% endraw %}"

      # The .prom file keeps its last `up 1` if the launchd job is unloaded or
      # dies, so staleness of the file itself is the only signal. (No
      # absent(precis_colima_docker_fs_up) rule: the node scrape job carries only
      # per-host instance addresses, no label marking which hosts run colima, so
      # absent() cannot be scoped without firing on every host that has none.)
      - alert: ColimaDockerDiskMetricStale
        expr: time() - node_textfile_mtime_seconds{file=~".*colima_docker_fs.prom"} > 900
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}colima docker-fs metric file not refreshed for 15m on {{ $labels.instance }}{% endraw %}"
{% if 'monitoring' in (group_names | default([])) %}
      # The Linux monitoring node probes the NAS marker hourly; a failed
      # backup, missing marker, dead probe, or missing collector all alert.
      - alert: NASResticHeartbeatOld
        expr: time() - precis_nas_restic_last_ok_timestamp_seconds > 691200
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}NAS restic backup last succeeded over 8 days ago on {{ $labels.instance }}{% endraw %}"

      - alert: NASResticHeartbeatMetricStale
        expr: time() - node_textfile_mtime_seconds{file=~".*nas_restic.prom"} > 7200
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}NAS restic heartbeat probe has stopped on {{ $labels.instance }}{% endraw %}"

      - alert: NASResticHeartbeatMetricAbsent
        expr: up{job="node", instance="{{ ansible_host }}:9100"} == 1 unless on(instance) precis_nas_restic_last_ok_timestamp_seconds
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "NAS restic heartbeat metric is missing on the monitoring node"
{% if monitoring_nas_hostkey | bool %}
      # The hourly probe emits precis_nas_hostkey_match per pinned key type
      # (gr513894 — a TOS update regenerated the keys and broke every ssh
      # path). It emits only when the keyscan succeeds: an unreachable NAS
      # goes stale, never reads as a mismatch.
      - alert: NASHostKeyMismatch
        expr: precis_nas_hostkey_match == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}NAS SSH {{ $labels.keytype }} host key differs from the pinned fingerprint (TOS update or MITM) — run scripts/host-ops/nas-hostkey-check{% endraw %}"

      - alert: NASHostKeyMetricStale
        expr: time() - node_textfile_mtime_seconds{file=~".*nas_hostkey.prom"} > 7200
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "{% raw %}NAS host-key probe has stopped on {{ $labels.instance }}{% endraw %}"

      - alert: NASHostKeyMetricAbsent
        expr: up{job="node", instance="{{ ansible_host }}:9100"} == 1 unless on(instance) precis_nas_hostkey_match
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "NAS host-key metric is missing on the monitoring node"
{% endif %}
{% endif %}
{% if monitoring_db_exporters | bool %}
      - alert: PostgresDown
        expr: pg_up == 0
        for: 2m
        labels:
          severity: critical
        annotations:
          summary: "PostgreSQL is down on the data node"
{% endif %}
      # Mount health, two failure shapes per mount (2026-09-30: /mnt/cluster hung
      # on every client for days, nothing alerted):
      #  - full/empty: avail == 0 (the *FullOrEmpty rules; statfs still answers).
      #  - hung/erroring: node_exporter's statfs times out on a stuck NFS mount,
      #    flags it node_filesystem_device_error == 1 and drops the avail series
      #    -- so a `== 0` rule is blind to it. The *Hung rules read device_error;
      #    the *Absent rules catch the avail series vanishing outright (an
      #    `absent()` would drop the instance label, hence the per-instance join).
      # Absence is restricted to the instances that should have the mount:
      # /mnt/cluster = explicit nfs_mount_hosts, restricted to non-server clients;
      # macOS servers expose this path as a symlink, not a filesystem. Both
      # shares mount lazily, so absent series on idle clients are normal.
      # Only opt in hosts that keep a mount busy (NAS: nas_mount_hosts);
      # no explicit group means no absence rule. Hung/full rules remain active.
      - alert: NFSMountFullOrEmpty
        expr: node_filesystem_avail_bytes{mountpoint="/mnt/cluster"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}NFS mount /mnt/cluster has 0 bytes available (full, or unmounted and empty) on {{ $labels.instance }}{% endraw %}"

      - alert: NFSMountHung
        expr: node_filesystem_device_error{mountpoint="/mnt/cluster"} == 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}NFS mount /mnt/cluster is hung or erroring (statfs fails, not missing) on {{ $labels.instance }}{% endraw %}"
{% set cluster_hosts = groups['nfs_mount_hosts'] | default([]) | select('in', groups['nfs_clients'] | default([])) | reject('in', groups['nfs_servers'] | default([])) | unique | list %}
{% if cluster_hosts %}

      - alert: NFSMountAbsent
        expr: up{job="node", instance=~"{% for h in cluster_hosts %}{{ hostvars[h]['ansible_host'] | replace('.', '[.]') }}:9100{{ '|' if not loop.last }}{% endfor %}"} == 1 unless on(instance) node_filesystem_avail_bytes{mountpoint="/mnt/cluster"}
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}Node {{ $labels.instance }} is up but reports no /mnt/cluster filesystem (hung mount or never mounted){% endraw %}"
{% endif %}

      - alert: NASMountFullOrEmpty
        expr: node_filesystem_avail_bytes{mountpoint="/mnt/archive/botshome"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}NAS mount /mnt/archive/botshome has 0 bytes available (full, or unmounted and empty) on {{ $labels.instance }}{% endraw %}"

      - alert: NASMountHung
        expr: node_filesystem_device_error{mountpoint="/mnt/archive/botshome"} == 1
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}NAS mount /mnt/archive/botshome is hung or erroring (statfs fails, not missing) on {{ $labels.instance }}{% endraw %}"
{% set nas_hosts = groups['nas_mount_hosts'] | default([]) %}
{% if nas_hosts %}

      - alert: NASMountAbsent
        expr: up{job="node", instance=~"{% for h in nas_hosts %}{{ hostvars[h]['ansible_host'] | replace('.', '[.]') }}:9100{{ '|' if not loop.last }}{% endfor %}"} == 1 unless on(instance) node_filesystem_avail_bytes{mountpoint="/mnt/archive/botshome"}
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "{% raw %}Node {{ $labels.instance }} is up but reports no /mnt/archive/botshome filesystem (hung mount or never mounted){% endraw %}"
{% endif %}

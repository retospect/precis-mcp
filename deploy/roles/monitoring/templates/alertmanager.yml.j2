# {{ ansible_managed }}
# One route, one receiver: every alert goes to the precis receiver, which
# queues it to the ops channel. Severity routing would add nothing until a
# second sink exists.
route:
  receiver: precis
  group_by: [{{ monitoring_alertmanager_group_by | join(', ') }}]
  group_wait: {{ monitoring_alertmanager_group_wait }}
  group_interval: {{ monitoring_alertmanager_group_interval }}
  repeat_interval: {{ monitoring_alertmanager_repeat_interval }}

# Below 7% free both disk rules fire; the critical one says it all (gr738880).
# Legacy source_match/target_match: the Alertmanager comes from the distro
# package, unpinned, and source_matchers needs 0.22+. Still accepted by newer
# releases; amtool check-config validates it at deploy time.
inhibit_rules:
  - source_match:
      alertname: DiskNearlyFull
    target_match:
      alertname: HighDiskUsage
    equal: [instance, mountpoint]

receivers:
  - name: precis
    webhook_configs:
      - url: http://{{ monitoring_receiver_host }}:{{ monitoring_receiver_port }}/alerts
        send_resolved: true

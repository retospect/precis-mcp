# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - alert_rules.yml
{% if monitoring_alertmanager_enabled | bool %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:{{ monitoring_alertmanager_port }}']
{% endif %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  - job_name: node
    static_configs:
      - targets:
{% for host in groups['all'] %}
          - '{{ hostvars[host]["ansible_host"] }}:9100'
{% endfor %}

  - job_name: postgres
    static_configs:
      - targets: ['{{ hostvars[postgres_host]["ansible_host"] }}:9187']

  - job_name: pgbouncer
    static_configs:
      - targets: ['{{ hostvars[postgres_host]["ansible_host"] }}:9127']

# {{ ansible_managed }}
global:
  scrape_interval: 15s
  evaluation_interval: 15s

rule_files:
  - alert_rules.yml
{% if monitoring_alertmanager_enabled | bool %}

alerting:
  alertmanagers:
    - static_configs:
        - targets: ['127.0.0.1:{{ monitoring_alertmanager_port }}']
{% endif %}

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ['localhost:9090']

  # One static_config per node so each target carries `host`, its inventory
  # name: the instance label is a bare address, which tells the person reading
  # an alert nothing (gr738880). The alertmanager receiver prints the label.
  # Rules that join on(instance) or match instance=~ are unaffected by it.
  - job_name: node
    static_configs:
{% for host in groups['all'] %}
      - targets: ['{{ hostvars[host]["ansible_host"] }}:9100']
        labels:
          host: '{{ host }}'
{% if host in (groups['gateway'] | default([])) %}
          deploy_overlay_expected: 'true'
{% endif %}
{% endfor %}
{% if monitoring_db_exporters | bool %}
  - job_name: postgres
    static_configs:
      - targets: ['{{ hostvars[postgres_host]["ansible_host"] }}:9187']

  - job_name: pgbouncer
    static_configs:
      - targets: ['{{ hostvars[postgres_host]["ansible_host"] }}:9127']
{%- endif %}

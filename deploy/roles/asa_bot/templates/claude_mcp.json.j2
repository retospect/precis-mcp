{
  "_comment": "Managed by Ansible role asa_bot. Edits will be overwritten.",
  "_note_one_mcp_to_rule_them_all": "acatome-quest, arxiv, wolfravant, tubescribe, gripe all rolled into precis kinds. Every API key the rolled-in tools used now lives on the precis MCP env below. If feynman is still a separate MCP we'll add it back, but unsure as of 2026-06-12.",
  "mcpServers": {
    "precis": {
      "command": "/opt/asa/venv/bin/precis",
      "args": ["serve"],
      "env": {
        {# §L (gr171431 §1): password-free — this file is rendered for both
           hermes (asa_bot) and deploy (precis_worker_agent's in-proc
           planner), and the pgpass role now drops a .pgpass for both.

           The legacy ACATOME_PG_* block that used to sit here is GONE (2026-08-07):
           it carried `vault_pg_agent_rw_pass` in cleartext, and nothing in precis
           ever read those vars (`git log -S` over `src/` finds no reader, ever) —
           acatome-meta's own config.py is the only consumer, and it is configured
           by the asa_slack / extract_watch roles, not this file. So the rendered
           ~/.claude/mcp.json on every agent host now contains NO credential at
           all: `serve` authenticates as agent_rw via ~/.pgpass (0600). Don't
           reintroduce an inline password here — put the secret in .pgpass. #}
        "PRECIS_DATABASE_URL": "postgresql://agent_rw@{{ hostvars[postgres_host]['ansible_host'] }}:{{ pgbouncer_port }}/precis_prod",
        {# gr196677: pin libpq's password file explicitly — the spawned
           `precis serve` sees ONLY this env block (no HOME), so ~-resolution
           of .pgpass is ambiguous per spawn. Each render site sets
           claude_mcp_pgpass_file to its run-as user's .pgpass. #}
        "PGPASSFILE": "{{ claude_mcp_pgpass_file }}",
        {# contact emails are DB-resident settings (contact.polite_email /
           contact.crossref_mailto) since 2026-08-22 — and the UNPAYWALL_EMAIL/
           CROSSREF_MAILTO names that sat here matched no registered env var
           anyway (registry reads PRECIS_-prefixed names): dead weight. #}
        "PRECIS_PATENT_RAW_ROOT": "{{ precis_patent_raw_root | default('') }}",
        "PRECIS_ROOT": "{{ precis_root | default('') }}",
        "PRECIS_PYTHON_ROOTS": "{{ precis_python_roots | default('') }}",
        "PRECIS_STARTUP_SKILLS": "{{ precis_startup_skills | default('') }}",
{# Claude Code gives a stdio MCP server ONLY this env block, NOT the parent
   `claude -p` env — so a per-run var must be an explicit ${VAR} pass-through
   or it never reaches `serve`. This carries the run's agentlog id so writes
   (draft/memory/websearch) attribute back via touch_from_env (a `touched`
   link). `:-` ⇒ empty when not a tick; agentlog.current_from_env treats empty
   as unset (no-op), so it's safe for asa / non-tick runs. #}
        "PRECIS_CURRENT_AGENTLOG": "${PRECIS_CURRENT_AGENTLOG:-}"
      }
    }
  }
}

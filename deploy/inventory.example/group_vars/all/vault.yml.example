---
# Copy to `deploy/inventory/group_vars/all/vault.yml` and encrypt with:
#   ansible-vault encrypt vault.yml
# The encrypted file (with its ansible-vault header) lives ONLY in the local
# overlay — it is gitignored and never committed to this public repo.
#
# SCOPE: deploy-time infra secrets ONLY — values ansible must have before the
# app can run (DB passwords, TLS material, network join keys) plus the few
# identity/contact values roles render into daemon plists. Application
# credentials (LLM/API keys, service tokens, device credentials) live in the
# DB secrets vault instead (`vault.secrets`, ADR 0055) — set them with
# `precis secret set NAME --prompt` or the /secrets web editor; they
# propagate to running daemons within the 60 s secrets-cache TTL, no deploy.
# Keeping an app credential here too creates a second, silently-stale copy
# that a later playbook run can clobber a rotation with — don't.

# Postgres passwords
vault_pg_cluster_pass: "CHANGEME"
vault_pg_agent_rw_pass: "CHANGEME"
vault_pg_agent_ro_pass: "CHANGEME"
vault_pg_pgboss_pass: "CHANGEME"
vault_pg_prometheus_pass: "CHANGEME"
vault_pg_admin_pass: "CHANGEME"

# Tailscale
vault_tailscale_authkey: "tskey-auth-CHANGEME"

# Nginx TLS
vault_nginx_ssl_cert: |
  -----BEGIN CERTIFICATE-----
  ...
  -----END CERTIFICATE-----
vault_nginx_ssl_key: |
  -----BEGIN PRIVATE KEY-----
  ...
  -----END PRIVATE KEY-----

# Identity/contact env (gr204873) — routed to precis_identity_env
# (deploy/group_vars/all.yml), which overrides the operator overlay's
# plaintext precis_shared_env entries wherever set. Unset here → the
# overlay's precis_shared_env value (if any) still wins, so these are
# optional for a working deploy. CROSSREF_MAILTO defaults to
# vault_unpaywall_email unless vault_crossref_mailto is also set.
vault_unpaywall_email: "CHANGEME"  # Unpaywall/CrossRef contact email
vault_semantic_scholar_api_key: "CHANGEME"  # Semantic Scholar (S2) API key
vault_anki_user: "CHANGEME"  # AnkiWeb login email
vault_edgar_user_agent: "CHANGEME"  # SEC EDGAR User-Agent string incl. contact email

# Backblaze B2 (offsite backup)
vault_b2_application_key_id: "CHANGEME"
vault_b2_application_key: "CHANGEME"
vault_b2_bucket_name: "cluster-backups"

# Discord bridge (asa-bot)
vault_discord_guild_id: 0

# Everything else — ANTHROPIC_API_KEY, Perplexity, Kagi, Wolfram, EPO OPS,
# ORCID, Elsevier, Wiley, CORE, OpenAlex, Discord/Slack bot tokens, email
# account passwords, Outlook OAuth, REMARKABLE_RMAPI_CONFIG, … — goes in the
# DB vault: `precis secret set NAME --prompt`.
